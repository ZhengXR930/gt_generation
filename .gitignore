# Local caches
__pycache__/
*.py[cod]
.DS_Store
.pytest_cache/

# Large raw datasets used only during sample selection
data_arvo_meta/
data_latest/
data_magma/
data_sec_bench/
data_hf_sec_bench/
out/

# Vendored third-party agent platform (install separately; not tracked)
external/OpenHands/

# Generated Claude Code skill projections (rebuild via adapters/claude_code/build_skills.py)
gt_generation/adapters/claude_code/skills/

# GT generation working artifacts
work/
tmp/
openhands_cybergym_runs/
external/cybergym_data_subset/data/arvo/*/repo-vul/
external/cybergym_data_subset/data/arvo/*/repo-vul.tar.gz
external/cybergym_data_subset/data/arvo/*/repo-vul.tar.gz.tmp
external/cybergym_data_subset/data/arvo/*/.hydrate.lock

# Logs
*.log
**/.jwt_secret

# Secrets / local API keys (DEEPSEEK_API_KEY, OPENAI_API_KEY, observer config)
config.txt

# GT per-sample runtime scratch (compacted packages keep only durable assets)
valid_gt_backup/

# Generated GT outputs (regenerated per machine; 8 valid packages force-added)
# gt_results/

# extracted vulnerable repos staged during GT gen -- huge, not persisted
gt_results/*/_work/

# GT per-sample scratch -- a valid package keeps only the 15 durable files
# (compact_result.KEEP_FILES). Everything below is stage/instrumentation/debug
# scratch and must never be committed, even if a run is committed pre-compaction.
gt_results/*/role_logs/
gt_results/*/reachability/
gt_results/*/_build*/
gt_results/*/patch.diff
gt_results/*/run_flags.json
gt_results/*/*_hook.c
gt_results/*/*_hook.so
gt_results/*/*.so
gt_results/*/.stage*/
gt_results/*/.stage*
gt_results/*/*-instrumentation.patch
gt_results/*/*_assertion_trace.txt
gt_results/*/candidate_assertions.json
gt_results/*/.assertion_spec_frozen.json
gt_results/*/.gt_generation.lock
gt_results/*/gt_generation_state.json
gt_results/*/arvo_workspace.json
gt_results/*/sample_state.json
gt_results/*/prepare_report.json
gt_results/*/reproduction_report.json
gt_results/*/static_review.json
gt_results/*/trace_feedback.json

# per-user launcher config (copy from gt_config.example.json)
gt_generation/gt_config.json
poc_generation/poc_generator/poc_config.json

# transient batch-run summaries and reachability scratch
gt_results/batch_*.json
poc_generation/poc_results/*/reachability_eval/
poc_generation/poc_results/_batch_logs/
poc_generation/poc_results/_sample_locks/
poc_generation/poc_results/local-smoke-*/
poc_generation/poc_results/protocol-smoke-*/
poc_generation/poc_results/*.json
poc_generation/poc_results/*.txt
poc_generation/poc_results/*/*.json
poc_generation/poc_generator/server/poc.db*
poc_generation/poc_generator/server/logs/

# Quarantined foreign/inconsistent GT packages (see .quarantine/README.md)
.quarantine/
# Hydration byproducts from tools/materialize_cybergym_arvo_data.py
external/cybergym_data_subset/data/arvo/*/error.txt
# ModelHub bridge runtime scratch
gt_results/*/.codex_modelhub_bridge/
