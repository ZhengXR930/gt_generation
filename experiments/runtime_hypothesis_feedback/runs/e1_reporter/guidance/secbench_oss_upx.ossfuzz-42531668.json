      "observe": []
    },
    "root": {
      "claim": "The recovery logic derives a candidate b_info location inside the local peek buffer from a found offset without ensuring the full b_info-sized region remains within that buffer.",
      "where": [
        {
          "file": "src/p_lx_elf.cpp",
          "function": "PackLinuxElf64::unpack",
          "point": "call:find_le32"
        }
      ],
      "observe": [
        {
          "name": "the remaining byte count from that candidate offset to the end of the local peek buffer",
          "why": "after boff is found, the code assigns bp = (b_info *)(void *)&peek_arr[boff] and performs b_info field reads without any check that the referenced b_info region fits within peek_arr",
          "expect": "lt",
          "operand": "the size of b_info"
        }
      ]
    },
    "propagation": {
      "claim": "That unchecked candidate location is immediately consumed as a b_info pointer for 4-byte field reads from the stack buffer.",
      "where": [
        {
          "file": "src/p_lx_elf.cpp",
          "function": "PackLinuxElf64::unpack",
          "point": "call:get_le32"
        }
      ],
