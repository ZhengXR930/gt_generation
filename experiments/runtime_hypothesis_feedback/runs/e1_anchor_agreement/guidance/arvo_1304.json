    "admission": {
      "claim": "A PKCS#12 object accepted by the parser is handed to the simple-parse routine for extraction of key, certificate, and CRL outputs.",
      "where": [
        {
          "file": "lib/x509/pkcs12.c",
          "function": "gnutls_pkcs12_simple_parse",
          "point": "entry"
        }
      ],
      "observe": []
    },
    "root": {
      "claim": "During error cleanup after a CRL object has been created and then deinitialized on import failure, the same caller-visible CRL handle remains non-null and is eligible for deinitialization again.",
      "where": [
        {
          "file": "lib/x509/pkcs12.c",
          "function": "gnutls_pkcs12_simple_parse",
          "point": "call:gnutls_x509_crl_deinit"
        }
      ],
      "observe": []
    },
    "propagation": {
      "claim": "Later cleanup in the same function consumes that stale non-null CRL handle and deinitializes it again because it was not cleared after the earlier deinitialization.",
      "where": [
        {
          "file": "lib/x509/pkcs12.c",
          "function": "gnutls_pkcs12_simple_parse",
          "point": "call:gnutls_x509_crl_deinit"
        }
      ],
      "observe": [],
      "mode": "distinct"
    },
    "target": {
      "claim": "A double deinitialization occurs when cleanup invokes the CRL destructor on the same logical object for a second time.",
      "where": [
        {
          "file": "lib/x509/pkcs12.c",
          "function": "gnutls_pkcs12_simple_parse",
          "point": "call:gnutls_x509_crl_deinit"
