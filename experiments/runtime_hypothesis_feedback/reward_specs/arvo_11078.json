  "reward_map": {
    "admission": {
      "claim": "The fuzzer entry point reads the input buffer, constructs a RawImage, and instantiates VC5Decompressor, whose constructor invokes parseVC5 to process the VC-5 tag stream.",
      "anchors": [
        {
          "file": "src-vul/librawspeed/fuzz/librawspeed/decompressors/VC5Decompressor.cpp",
          "function": "LLVMFuzzerTestOneInput"
        },
        {
          "file": "src-vul/librawspeed/src/librawspeed/decompressors/VC5Decompressor.cpp",
          "function": "VC5Decompressor"
        }
      ],
      "observation": "The fuzzer input is parsed into a RawImage and a VC5Decompressor is constructed, entering parseVC5 with the attacker-controlled tag stream."
    },
    "root": {
      "claim": "The mVC5 struct members iSubband, lowpassPrecision, and quantization lack default initializers, so they hold indeterminate values when a LargeCodeblock tag is processed before the corresponding SubbandNumber, LowpassPrecision, or Quantization tags set them.",
      "anchors": [
        {
          "file": "src-vul/librawspeed/src/librawspeed/decompressors/VC5Decompressor.h",
          "function": "VC5Decompressor"
        }
      ],
      "observation": "mVC5.iSubband, mVC5.lowpassPrecision, and mVC5.quantization are uninitialized when parseVC5 encounters a LargeCodeblock tag without prior SubbandNumber/LowpassPrecision/Quantization tags."
    },
    "propagation": {
      "claim": "parseLargeCodeblock reads the uninitialized mVC5.iSubband to index into subband_wavelet_index and subband_band_index arrays, and passes uninitialized mVC5.lowpassPrecision/mVC5.quantization into band constructors.",
      "anchors": [
        {
          "file": "src-vul/librawspeed/src/librawspeed/decompressors/VC5Decompressor.cpp",
          "function": "parseLargeCodeblock"
        }
      ],
      "observation": "The uninitialized mVC5.iSubband value is used as an array index, and uninitialized lowpassPrecision/quantization values are consumed by LowPassBand/HighPassBand construction.",
      "mode": "distinct"
    },
    "target": {
      "claim": "MSAN reports a Use-of-uninitialized-value when parseLargeCodeblock reads the indeterminate mVC5.iSubband (or lowpassPrecision/quantization) value.",
      "anchors": [
        {
          "file": "src-vul/librawspeed/src/librawspeed/decompressors/VC5Decompressor.cpp",
          "function": "parseLargeCodeblock"
        }
      ],
      "observation": "authoritative runtime oracle: MSAN flags use of uninitialized value in parseLargeCodeblock during VC5Decompressor"
    }
  },
