      "claim": "The fuzzer writes attacker-controlled bytes to a file and invokes verify_signatures/verify_files, which open the file and route it through proc_signature_packets into do_proc_packets for packet parsing.",
      "anchors": [
        {
          "file": "src-vul/fuzz_verify.c",
          "function": "LLVMFuzzerTestOneInput"
        },
        {
          "file": "src-vul/gnupg/g10/verify.c",
          "function": "verify_signatures"
        },
        {
          "file": "src-vul/gnupg/g10/verify.c",
          "function": "verify_files"
        },
        {
          "file": "src-vul/gnupg/g10/mainproc.c",
          "function": "proc_signature_packets"
        }
      ],
      "observation": "Input bytes are written to the fuzz file and parsed as OpenPGP packets in verify mode."
    },
    "root": {
      "claim": "In proc_plaintext, free_packet(pkt, NULL) frees the PKT_plaintext structure via free_plaintext/xfree(pt), leaving the local pointer pt dangling while the function continues to use it.",
      "anchors": [
        {
          "file": "src-vul/gnupg/g10/mainproc.c",
          "function": "proc_plaintext"
        },
        {
          "file": "src-vul/gnupg/g10/free-packet.c",
          "function": "free_packet"
        },
        {
          "file": "src-vul/gnupg/g10/free-packet.c",
          "function": "free_plaintext"
        }
      ],
      "observation": "The plaintext packet object is deallocated while a live pointer to it remains in scope."
    },
    "propagation": {
      "claim": "After the free, proc_plaintext reads pt->mode, pt->namelen, pt->name, and pt->timestamp to build the extrahash buffer, dereferencing the freed plaintext structure.",
      "anchors": [
        {
          "file": "src-vul/gnupg/g10/mainproc.c",
          "function": "proc_plaintext"
        }
      ],
      "observation": "Freed plaintext fields are read to construct the CTRLPKT_PLAINTEXT_MARK control packet data.",
      "mode": "collapsed_with_target"
    },
    "target": {
      "claim": "ASAN reports a heap-use-after-free READ 4 at proc_plaintext, reading the freed pt->namelen (int) field while building the extrahash buffer.",
      "anchors": [
        {
          "file": "src-vul/gnupg/g10/mainproc.c",
          "function": "proc_plaintext"
        }
      ],
      "observation": "Authoritative runtime oracle: ASAN heap-use-after-free READ 4 in proc_plaintext."
    }
  },
