  "reward_map": {
    "admission": {
      "claim": "The fuzz target feeds raw bytes into blosc2_schunk_from_buffer, which constructs an in-memory frame whose cframe pointer aliases the input buffer.",
      "anchors": [
        {
          "file": "src-vul/c-blosc2/tests/fuzz/fuzz_decompress_frame.c",
          "function": "LLVMFuzzerTestOneInput"
        },
        {
          "file": "src-vul/c-blosc2/blosc/schunk.c",
          "function": "blosc2_schunk_from_buffer"
        },
        {
          "file": "src-vul/c-blosc2/blosc/frame.c",
          "function": "frame_from_cframe"
        }
      ],
      "observation": "A blosc2_schunk is created with frame->cframe pointing directly into the fuzz input buffer (copy=false), and schunk->nchunks > 0."
    },
    "root": {
      "claim": "In frame_get_lazychunk, the in-memory frame path sets *chunk to a pointer into the middle of frame->cframe while *needs_free remains false, and an error (invalid chunk header or out-of-bounds) sets rc < 0.",
      "anchors": [
        {
          "file": "src-vul/c-blosc2/blosc/frame.c",
          "function": "frame_get_lazychunk"
        }
      ],
      "observation": "frame->cframe != NULL, *chunk = frame->cframe + header_len + offset, *needs_free == false, and rc < 0 due to blosc2_cbuffer_sizes failure or boundary check."
    },
    "propagation": {
      "claim": "The error-handling block at the end of frame_get_lazychunk tests the needs_free pointer (always non-NULL) instead of the *needs_free value, so it proceeds to free even when the chunk is an interior pointer into the frame buffer.",
      "anchors": [
        {
          "file": "src-vul/c-blosc2/blosc/frame.c",
          "function": "frame_get_lazychunk"
        }
      ],
      "observation": "The condition 'if (needs_free)' evaluates true because needs_free is a non-NULL bool* parameter, regardless of the value *needs_free.",
      "mode": "distinct"
    },
    "target": {
      "claim": "free(*chunk) is invoked on a pointer into the middle of the heap-allocated frame->cframe buffer, which was not returned by malloc, triggering ASAN invalid-free.",
      "anchors": [
        {
          "file": "src-vul/c-blosc2/blosc/frame.c",
          "function": "frame_get_lazychunk"
        }
      ],
      "observation": "ASAN reports 'Invalid-free' at frame_get_lazychunk, with the freed address being an interior pointer of the heap allocation backing the fuzz input."
    }
  },
