    "admission": {
      "claim": "The hash function is invoked with a zero-length buffer through the public API, where the length parameter is zero and the buffer pointer may be non-null or null.",
      "anchors": [
        {
          "file": "src-vul/aflplusplus/src/afl-performance.c",
          "function": "hash64"
        },
        {
          "file": "src-vul/aflplusplus/src/afl-performance.c",
          "function": "hash32"
        }
      ],
      "observation": "A caller passes a buffer with length 0 to hash64 or hash32, which forwards to XXH64 with length 0."
    },
    "root": {
      "claim": "XXH64 receives a zero-length input and enters its length-based dispatch, selecting the branch for lengths less than 32 bytes without performing any buffer reads.",
      "anchors": [
        {
          "file": "src-vul/aflplusplus/include/xxhash.h",
          "function": "XXH64"
        }
      ],
      "observation": "The length parameter is 0, so XXH64's internal logic treats the input as an empty buffer and proceeds to compute the hash from the seed and length only."
    },
    "propagation": {
      "claim": "The zero-length input is directly consumed by the XXH64 computation, which performs no memory access on the buffer and returns a hash value without crashing.",
      "anchors": [
        {
          "file": "src-vul/aflplusplus/include/xxhash.h",
          "function": "XXH64"
        }
      ],
      "observation": "The hash computation completes without dereferencing the buffer pointer, and the returned hash is used by the caller.",
      "mode": "collapsed_with_target"
    },
    "target": {
      "claim": "The authoritative issue-relevant runtime violation occurs.",
      "anchors": [],
      "observation": "authoritative runtime oracle"
    }
