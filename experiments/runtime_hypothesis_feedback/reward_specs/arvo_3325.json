  "reward_map": {
    "admission": {
      "claim": "The raw sancov coverage file is parsed, extracting basic-block addresses from the mapped data buffer.",
      "anchors": [
        {
          "file": "src-vul/honggfuzz/sancov.c",
          "function": "sancov_sanCovParseRaw"
        }
      ],
      "observation": "bbAddr is read from the raw coverage data buffer and passed to the map lookup."
    },
    "root": {
      "claim": "A relative address relAddr is computed as the 32-bit difference between the BB address and the map base, without validation against the bitmap capacity.",
      "anchors": [
        {
          "file": "src-vul/honggfuzz/sancov.c",
          "function": "sancov_sanCovParseRaw"
        }
      ],
      "observation": "relAddr = (uint32_t)(bbAddr - mapsBuf[bestFit].base) can exceed the bitmap capacity _HF_SANCOV_BITMAP_SIZE."
    },
    "propagation": {
      "claim": "sancov_queryBitmap returns false for an out-of-range relAddr, causing sancov_setBitmap to be invoked with the same unvalidated index.",
      "anchors": [
        {
          "file": "src-vul/honggfuzz/sancov.c",
          "function": "sancov_queryBitmap"
        },
        {
          "file": "src-vul/honggfuzz/sancov.c",
          "function": "sancov_setBitmap"
        }
      ],
      "observation": "When relAddr > capacity, queryBitmap returns false and setBitmap is called with the same out-of-range index.",
      "mode": "distinct"
    },
    "target": {
      "claim": "sancov_setBitmap performs an out-of-bounds array access on pChunks because the bounds check only logs an error without preventing the access.",
      "anchors": [
        {
          "file": "src-vul/honggfuzz/sancov.c",
          "function": "sancov_setBitmap"
        }
      ],
      "observation": "pChunks[index / 32] is written with index >= capacity, exceeding the allocated nChunks array bounds."
    }
  },
