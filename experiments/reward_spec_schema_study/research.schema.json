{
  "type": "object",
  "additionalProperties": false,
  "required": ["admission", "root", "target"],
  "properties": {
    "admission": {"$ref": "#/$defs/contract"},
    "root": {"$ref": "#/$defs/contract"},
    "target": {"$ref": "#/$defs/contract"}
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract", "events", "predicate", "observability",
        "confidence", "limitations"
      ],
      "properties": {
        "contract": {"type": "string"},
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/event"}
        },
        "predicate": {"type": "string"},
        "observability": {
          "type": "string",
          "enum": ["direct", "derived", "proxy", "unresolved"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "capture"],
      "properties": {
        "id": {"type": "string"},
        "at": {"type": "string"},
        "capture": {
          "type": "array",
          "items": {"$ref": "#/$defs/capture"}
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expression"],
      "properties": {
        "name": {"type": "string"},
        "expression": {"type": "string"}
      }
    }
  }
}
