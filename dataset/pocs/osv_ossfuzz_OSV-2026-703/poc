const ab = new ArrayBuffer(4, { maxByteLength: 1024 });
const ta = new Int32Array(ab);

const obj = {
    valueOf() {
        console.log("Resizing array buffer...");
        ab.resize(1024);
        return 1;
    }
};

try {
    Atomics.add(ta, 0, obj);
    console.log("Atomics.add completed without crash.");
} catch (e) {
    console.log("Caught exception: " + e);
}
