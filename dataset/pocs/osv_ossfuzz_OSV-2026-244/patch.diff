From 7546da6a56db2c028f820e628269570b14383f11 Mon Sep 17 00:00:00 2001
From: Harish Mahendrakar <hmahendrakar@google.com>
Date: Sat, 14 Feb 2026 13:23:19 -0800
Subject: [PATCH] hevc_dec_fuzzer: Remove RGBA_8888

Remove last remaining references to RGBA_8888 in decoder path.
---
 fuzzer/hevc_dec_fuzzer.cpp | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/fuzzer/hevc_dec_fuzzer.cpp b/fuzzer/hevc_dec_fuzzer.cpp
index 679eb590..3c55b1ed 100644
--- a/fuzzer/hevc_dec_fuzzer.cpp
+++ b/fuzzer/hevc_dec_fuzzer.cpp
@@ -38,7 +38,7 @@
 #define ivd_api_function ihevcd_cxa_api_function
 const IV_COLOR_FORMAT_T supportedColorFormats[] = {
     IV_YUV_420P,   IV_YUV_420SP_UV, IV_YUV_420SP_VU,
-    IV_GRAY, IV_RGBA_8888};
+    IV_GRAY};
 
 const uint32_t enableYuvFormatBitFields[] = {0, 1, 2, 3};
 
@@ -225,10 +225,6 @@ void Codec::allocFrame() {
       sizes[0] = mWidth * mHeight;
       num_bufs = 1;
       break;
-    case IV_RGBA_8888:
-      sizes[0] = mWidth * mHeight * 4;
-      num_bufs = 1;
-      break;
     case IV_YUV_420P:
       [[fallthrough]];
     default:
