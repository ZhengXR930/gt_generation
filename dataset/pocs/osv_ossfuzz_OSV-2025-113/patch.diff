From c90280f310aa8f9fd0442128244a8672bdfdb80e Mon Sep 17 00:00:00 2001
From: Bart Van Assche <bvanassche@acm.org>
Date: Wed, 12 Feb 2025 15:45:58 -0800
Subject: [PATCH] libsnmp: Fix an out-of-bounds access in snmp_log_options()

Fixes: https://issues.oss-fuzz.com/issues/395921931
---
 snmplib/snmp_logging.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/snmplib/snmp_logging.c b/snmplib/snmp_logging.c
index 37c9bbc1a3..781b62bd5f 100644
--- a/snmplib/snmp_logging.c
+++ b/snmplib/snmp_logging.c
@@ -353,7 +353,7 @@ snmp_log_options(char *optarg, int argc, char *const *argv)
      * Finally, handle ".... -Lx value ...." syntax
      *   (*without* surrounding quotes)
      */
-    if ((!*optarg) && (NULL != argv)) {
+    if (!*optarg && argv && optind < argc) {
         /*
          * We've run off the end of the argument
          *  so move on to the next.
