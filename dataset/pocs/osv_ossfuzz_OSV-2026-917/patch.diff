From c6a7a286853093d3915baea9def8f8646ff7b942 Mon Sep 17 00:00:00 2001
From: 100894 <gargy.dhiman@ittiam.com>
Date: Mon, 22 Jun 2026 18:19:42 +0530
Subject: [PATCH] Fix : Overflow in i_out_bytes in
 ixheaace_write_audio_preroll_data

---
 encoder/drc_src/impd_drc_gain_calculator.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/encoder/drc_src/impd_drc_gain_calculator.c b/encoder/drc_src/impd_drc_gain_calculator.c
index 799c27da..229a7c0d 100644
--- a/encoder/drc_src/impd_drc_gain_calculator.c
+++ b/encoder/drc_src/impd_drc_gain_calculator.c
@@ -235,16 +235,16 @@ IA_ERRORCODE impd_drc_td_drc_gain_calc_init(ia_drc_gain_enc_struct *pstr_drc_gai
   pstr_chan_param = &pstr_drc_compand->str_channel_param;
 
   if (pstr_chan_param->attack < 1.0 / pstr_drc_gain_enc->sample_rate) {
-    // Decreasing the upper limit of alphaAttack from 1 -> 1 - EPSILON to avoid DRC payload overflow.
-    pstr_chan_param->attack = 1.0 - FLT_EPSILON;
+    // Decreasing the upper limit of alphaAttack from 1 -> 1 - 1/EPSILON to avoid DRC payload overflow.
+    pstr_chan_param->attack = 1.0 - exp(-1);
   } else {
     pstr_chan_param->attack =
         1.0 - exp(-1.0 / (pstr_drc_gain_enc->sample_rate * pstr_chan_param->attack));
   }
 
   if (pstr_chan_param->decay < 1.0 / pstr_drc_gain_enc->sample_rate) {
-    // Decreasing the upper limit of alphaDecay from 1 -> 1 - EPSILON to avoid DRC payload overflow.
-    pstr_chan_param->decay = 1.0 - FLT_EPSILON;
+    // Decreasing the upper limit of alphaDecay from 1 -> 1 - 1/EPSILON to avoid DRC payload overflow.
+    pstr_chan_param->decay = 1.0 - exp(-1);
   } else {
     pstr_chan_param->decay =
         1.0 - exp(-1.0 / (pstr_drc_gain_enc->sample_rate * pstr_chan_param->decay));
