From 4b066d6e8f340bc92f935a6d2161872413e4a460 Mon Sep 17 00:00:00 2001
From: Pavel Rojtberg <rojtberg@gmail.com>
Date: Thu, 25 Jun 2026 18:07:21 +0200
Subject: [PATCH] Main: MeshSerializer - ensure the vertex declaration is
 complete

after it is checked when reading the buffer
---
 OgreMain/src/OgreMeshSerializerImpl.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/OgreMain/src/OgreMeshSerializerImpl.cpp b/OgreMain/src/OgreMeshSerializerImpl.cpp
index 787c14aff0b..8f370861cb5 100644
--- a/OgreMain/src/OgreMeshSerializerImpl.cpp
+++ b/OgreMain/src/OgreMeshSerializerImpl.cpp
@@ -710,6 +710,9 @@ namespace Ogre {
         // unsigned short index;    // index of the semantic
         readShorts(stream, &index, 1);
 
+        if (dest->vertexBufferBinding->isBufferBound(source))
+            OGRE_EXCEPT(Exception::ERR_INVALID_STATE, "Cannot add vertex element after reading buffer");
+
         dest->vertexDeclaration->addElement(source, offset, vType, vSemantic, index);
 
         if (vType == _DETAIL_SWAP_RB)
