Subject: [PATCH] Avoid uninitialized memory access

As reported by https://issues.oss-fuzz.com/510360595
---
 src/mcos.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/mcos.c b/src/mcos.c
index b971c90d..6999b9b6 100644
--- a/src/mcos.c
+++ b/src/mcos.c
@@ -69,6 +69,8 @@ ParseOpaqueMetadata(const mat_uint32_t *meta, size_t meta_nvals, matvar_t *matva
         mat_uint32_t d;
         for ( d = 0; d < ndims; d++ ) {
             matvar->dims[d] = meta[dim_start + d];
+        }
+        for ( d = 0; d < ndims; d++ ) {
             if ( Mul(&total_objs, total_objs, meta[dim_start + d]) ) {
                 total_objs = 0;
                 break;
