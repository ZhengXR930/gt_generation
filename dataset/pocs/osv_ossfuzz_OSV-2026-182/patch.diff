From a4cd148a2a4f49fa9ec26058b1e33cce24d57dc3 Mon Sep 17 00:00:00 2001
From: "Gary E. Miller" <gem@rellim.com>
Date: Mon, 2 Feb 2026 15:23:13 -0800
Subject: [PATCH] libgps/json.c: Work around bug in microjson.

Issue filed upstream.
Avoid reading unitialized memory:

https://issues.oss-fuzz.com/issues/479922669

A checp shot for the fuzzer to deep link a library after input
sanitization.
---
 libgps/json.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/libgps/json.c b/libgps/json.c
index 1c9dfe3fb..f2c396d10 100644
--- a/libgps/json.c
+++ b/libgps/json.c
@@ -211,6 +211,7 @@ static int json_internal_read_object(const char *cp,
     if (NULL != end) {
         *end = NULL;    // give it a well-defined value on parse failure
     }
+    memset(valbuf, 0, sizeof(valbuf));
 
     // stuff fields with defaults in case they're omitted in the JSON input
     for (cursor = attrs; cursor->attribute != NULL; cursor++)
