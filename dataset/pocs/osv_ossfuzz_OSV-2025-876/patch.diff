From 5ab7cd628bf79f37a413715f5688ec82bf5cca13 Mon Sep 17 00:00:00 2001
From: Bart Van Assche <bvanassche@acm.org>
Date: Thu, 6 Nov 2025 08:27:52 -0800
Subject: [PATCH] snmptrapd: Fix a buffer overflow triggered by an empty
 enterprise OID

Fixes: https://issues.oss-fuzz.com/u/1/issues/457106694

See also commit ce1c9d4455a4 ("snmptrapd: Fix a buffer overflow triggered
by an empty enterprise OID").
---
 apps/snmptrapd_handlers.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/apps/snmptrapd_handlers.c b/apps/snmptrapd_handlers.c
index 48cf74241c..f1a3b65477 100644
--- a/apps/snmptrapd_handlers.c
+++ b/apps/snmptrapd_handlers.c
@@ -1115,7 +1115,7 @@ snmp_input(int op, netsnmp_session *session,
             if (pdu->trap_type == SNMP_TRAP_ENTERPRISESPECIFIC) {
                 trapOidLen = pdu->enterprise_length;
                 memcpy(trapOid, pdu->enterprise, sizeof(oid) * trapOidLen);
-                if (trapOidLen >= 0 && trapOid[trapOidLen - 1] != 0) {
+                if (trapOidLen >= 1 && trapOid[trapOidLen - 1] != 0) {
                     trapOid[trapOidLen++] = 0;
                 }
                 trapOid[trapOidLen++] = pdu->specific_type;
