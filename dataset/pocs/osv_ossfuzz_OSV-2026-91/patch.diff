From 3eb879acf4ce1efb4750688e864af172d34a4e0a Mon Sep 17 00:00:00 2001
From: DRC <information@libjpeg-turbo.org>
Date: Sun, 18 Jan 2026 09:19:20 -0500
Subject: [PATCH] Build/Windows: Fix error if CMAKE_INSTALL_PREFIX is empty

Configuring a build with an empty CMAKE_INSTALL_PREFIX is not
recommended in the general case, because it can lead to unexpected
behavior (such as installing files into the root directory.)  However,
such a configuration can be used as a hack to generate a Windows
installer package with no default installation directory.

Closes #853
---
 cmakescripts/BuildPackages.cmake | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cmakescripts/BuildPackages.cmake b/cmakescripts/BuildPackages.cmake
index 55ec3acc5..a4d2e9947 100644
--- a/cmakescripts/BuildPackages.cmake
+++ b/cmakescripts/BuildPackages.cmake
@@ -96,7 +96,7 @@ else()
   set(INST_DEFS ${INST_DEFS} "-DBUILDDIR=")
 endif()
 
-string(REGEX REPLACE "/" "\\\\" INST_DIR ${CMAKE_INSTALL_PREFIX})
+string(REGEX REPLACE "/" "\\\\" INST_DIR "${CMAKE_INSTALL_PREFIX}")
 
 configure_file(release/installer.nsi.in installer.nsi @ONLY)
 # TODO: It would be nice to eventually switch to CPack and eliminate this mess,
