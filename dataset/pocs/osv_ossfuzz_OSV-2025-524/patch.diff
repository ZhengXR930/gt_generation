From 20d2b404af65edc5d66ee6f11a59f930ea3d1b88 Mon Sep 17 00:00:00 2001
From: Fabrice Bellard <fabrice@bellard.org>
Date: Wed, 27 Aug 2025 16:06:44 +0200
Subject: [PATCH] qjsc: handle C name conflicts between scripts and modules
 (#432)

---
 qjsc.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/qjsc.c b/qjsc.c
index 49aa44985..e55ca61ce 100644
--- a/qjsc.c
+++ b/qjsc.c
@@ -362,6 +362,9 @@ static void compile_file(JSContext *ctx, FILE *fo,
         pstrcpy(c_name, sizeof(c_name), c_name1);
     } else {
         get_c_name(c_name, sizeof(c_name), filename);
+        if (namelist_find(&cname_list, c_name)) {
+            find_unique_cname(c_name, sizeof(c_name));
+        }
     }
     output_object_code(ctx, fo, obj, c_name, CNAME_TYPE_SCRIPT);
     JS_FreeValue(ctx, obj);
