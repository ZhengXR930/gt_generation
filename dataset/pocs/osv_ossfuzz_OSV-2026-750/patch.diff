 {
     byte type = (byte)MQTT_PACKET_TYPE_GET(type_flags);
@@ -2213,18 +2270,25 @@ int MqttDecode_Subscribe(byte *rx_buf, int rx_buf_len, MqttSubscribe *subscribe)
         while (rx_payload < rx_end) {
