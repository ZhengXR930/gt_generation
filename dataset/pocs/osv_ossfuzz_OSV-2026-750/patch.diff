+    ASSERT_TRUE(rc > 0);
+    ASSERT_EQ(MQTT_CONNECT_PROTOCOL_LEVEL_5, dec.protocol_level);
+    ASSERT_NULL(dec.username);
+    ASSERT_NOT_NULL(dec.password);
+    ASSERT_EQ(0, XMEMCMP(dec.password, "secret", 6));
+    MqttProps_Free(dec.props);
+}
 #endif /* WOLFMQTT_V5 */
 #endif /* WOLFMQTT_BROKER */
 
