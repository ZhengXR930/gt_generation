+        0x10, 0x0E,
+        0x00, 0x04, 'M', 'Q', 'T', 'T',
+        0x05,
+        0x00,
+        0x00, 0x3C,
+        0x00,
+        0x00, 0x01, 'K'
+    };
+
+    install_mock_net(&net);
