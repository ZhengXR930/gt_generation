From f88afe44754abda59a151d4b547b41a6e6b90f2c Mon Sep 17 00:00:00 2001
From: Grok Compression <support@grokcompression.com>
Date: Mon, 23 Feb 2026 23:08:21 -0500
Subject: [PATCH] tidy

---
 src/lib/codec/formats/ImageFormat.cpp | 3 +--
 src/lib/core/t2/PacketParser.cpp      | 2 +-
 2 files changed, 2 insertions(+), 3 deletions(-)

diff --git a/src/lib/codec/formats/ImageFormat.cpp b/src/lib/codec/formats/ImageFormat.cpp
index 46fac90ec..52b24970d 100644
--- a/src/lib/codec/formats/ImageFormat.cpp
+++ b/src/lib/codec/formats/ImageFormat.cpp
@@ -215,8 +215,7 @@ void ImageFormat::createMeta(grk_image* img)
  */
 bool ImageFormat::allComponentsSanityCheck(grk_image* image, bool checkEqualPrecision)
 {
-  assert(image);
-  if(image->decompress_num_comps == 0)
+  if(!image || image->decompress_num_comps == 0)
     return false;
   if(image_->precision)
     checkEqualPrecision = false;
diff --git a/src/lib/core/t2/PacketParser.cpp b/src/lib/core/t2/PacketParser.cpp
index 399a80f6d..c9f4cd904 100644
--- a/src/lib/core/t2/PacketParser.cpp
+++ b/src/lib/core/t2/PacketParser.cpp
@@ -186,7 +186,7 @@ uint32_t PacketParser::readHeader(void)
             if(value != incl->getUninitializedValue() && value != layno_)
             {
               grklog.warn("Tile number: %u", tileIndex_ + 1);
-              std::string msg = "Corrupt inclusion tag tree found when decoding packet header.";
+              std::string msg = "Corrupt inclusion tag tree found when decoding packet header.\n";
               grklog.warn("%s", msg.c_str());
               throw t1::CorruptPacketHeaderException();
             }
