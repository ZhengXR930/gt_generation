[PARSER]
    Name valid
    Format regex
    Regex ^(?<key>.*)$
    Time_Key key
    Time_Format %Y-%m-%dT%H:%M:%S.%L
    Time_Keep On

[PARSER]
    Name broken
    Format regex
    Regex ^(?<time>.*)$
    Time_Key time
    Time_Format %Y-%m-%dT%H:%M:%S.%L
    Time_Offset +25:99
    Decode_Field_As json log
