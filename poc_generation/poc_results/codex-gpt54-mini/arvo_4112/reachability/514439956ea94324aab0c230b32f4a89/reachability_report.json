    {
      "file": "libyara/grammar.c",
      "function": "yydestruct",
      "line": null,
      "code": "yr_free(((*yyvaluep).c_string));",
      "note": "Root cause. The `_IDENTIFIER_` destructor frees the token-owned string but does not clear the `YYSTYPE` slot afterwards. The dangling pointer remains in the union and is later reinterpreted as a `_REGEXP_` `sized_string` pointer. The fix changes this destructor (and the analogous token destructors) to assign the field to `NULL` immediately after `yr_free`.",
      "kind": "root_cause_function"
    },
