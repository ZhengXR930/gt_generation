global
    maxconn 1

defaults
    mode http
    timeout connect 1s
    timeout client 1s
    timeout server 1s

frontend ft
    bind :0
    # malformed directive intended to reach vulnerable config parser path
    tcp-request inspect-delay 1s
    http-request set-var(txn.foo) %[req.hdr(XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX)]
