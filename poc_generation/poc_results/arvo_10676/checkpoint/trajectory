n   247\t           const UA_UInt32 requestId, const UA_ByteString *msg) {\n   248\t    UA_LOCK_ASSERT(&server->serviceMutex);\n   249\t\n   250\t    if(channel->state != UA_SECURECHANNELSTATE_ACK_SENT &&\n   251\t       channel->state != UA_SECURECHANNELSTATE_OPEN)\n   252\t        return UA_STATUSCODE_BADINTERNALERROR;\n   253\t    /* Decode the request */\n   254\t    UA_NodeId requestType;\n   255\t    UA_OpenSecureChannelRequest openSecureChannelRequest;\n   256\t    size_t offset = 0;\n   257\t    UA_StatusCode retval = UA_NodeId_decodeBinary(msg, &offset, &requestType);\n   258\t    if(retval != UA_STATUSCODE_GOOD) {\n   259\t        UA_NodeId_clear(&requestType);\n   260\t        UA_LOG_WARNING_CHANNEL(server->config.logging, channel,\n   261\t                               \"Could not decode the NodeId. \"\n   262\t                               \"Closing the SecureChannel.\");\n   263\t        UA_SecureChannel_shutdown(channel, UA_SHUTDOWNREASON_REJECT);\n   264\t        return retval;\n   265\t    }\n   266\t    retval = UA_decodeBinaryInternal(msg, &offset, &openSecureChannelRequest,\n   267\t                                     &UA_TYPES[UA_TYPES_OPENSECURECHANNELREQUEST], NULL);\n   268\t\n   269\t    /* Error occurred */\n   270\t    const UA_NodeId *opnRequestId =\n   271\t        &UA_TYPES[UA_TYPES_OPENSECURECHANNELREQUEST].binaryEncodingId;\n   272\t    if(retval != UA_STATUSCODE_GOOD || !UA_NodeId_equal(&requestType, opnRequestId)) {\n   273\t        UA_NodeId_clear(&requestType);\n   274\t        UA_OpenSecureChannelRequest_clear(&openSecureChannelRequest);\n   275\t        UA_LOG_WARNING_CHANNEL(server->config.logging, channel,\n   276\t                               \"Could not decode the OPN message. \"\n   277\t                               \"Closing the SecureChannel.\");\n   278\t        UA_SecureChannel_shutdown(channel, UA_SHUTDOWNREASON_REJECT);\n   279\t        return retval;\n   280\t    }\n   281\t    UA_NodeId_clear(&requestType);\n