UA_ServiceFault response;\n   133\t    UA_ServiceFault_init(&response);\n   134\t    UA_ResponseHeader *responseHeader = &response.responseHeader;\n   135\t    responseHeader->requestHandle = requestHandle;\n   136\t    responseHeader->timestamp = el->dateTime_now(el);\n   137\t    responseHeader->serviceResult = statusCode;\n   138\t\n   139\t    UA_LOG_DEBUG(channel->securityPolicy->logger, UA_LOGCATEGORY_SERVER,\n   140\t                 \"Sending response for RequestId %u with ServiceResult %s\",\n   141\t                 (unsigned)requestId, UA_StatusCode_name(statusCode));\n   142\t\n   143\t    /* Send error message. Message type is MSG and not ERR, since we are on a\n   144\t     * SecureChannel! */\n   145\t    return UA_SecureChannel_sendMSG(channel, requestId, &response,\n   146\t                                    &UA_TYPES[UA_TYPES_SERVICEFAULT]);\n   147\t}\n   148\t\n   149\t/* This is not an ERR message, the connection is not closed afterwards */\n   150\tstatic UA_StatusCode\n   151\tdecodeHeaderSendServiceFault(UA_Server *server, UA_SecureChannel *channel,\n   152\t                             const UA_ByteString *msg, size_t offset,\n   153\t                             const UA_DataType *responseType, UA_UInt32 requestId,\n   154\t                             UA_StatusCode error) {\n   155\t    UA_RequestHeader requestHeader;\n   156\t    UA_StatusCode retval =\n   157\t        UA_decodeBinaryInternal(msg, &offset, &requestHeader,\n   158\t                                &UA_TYPES[UA_TYPES_REQUESTHEADER], NULL);\n   159\t    if(retval != UA_STATUSCODE_GOOD)\n   160\t        return retval;\n   161\t    retval = sendServiceFault(server, channel, requestId,\n   162\t                              requestHeader.requestHandle, error);\n   163\t    UA_RequestHeader_clear(&requestHeader);\n   164\t    return retval;\n   165\t}\n   166\t\n   167\t/*************************/\n   168\t/* Process Message Types */\n   169\t/*************************/\n   170\