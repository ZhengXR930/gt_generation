       gnutls_x509_crt_fmt_t format, unsigned int flags)\n   208\t{\n   209\t        int result = 0, need_free = 0;\n   210\t        gnutls_datum_t _data;\n   211\t        char error_str[ASN1_MAX_ERROR_DESCRIPTION_SIZE];\n   212\t\n   213\t        _data.data = data->data;\n   214\t        _data.size = data->size;\n   215\t\n   216\t        if (pkcs12 == NULL) {\n   217\t                gnutls_assert();\n   218\t                return GNUTLS_E_INVALID_REQUEST;\n   219\t        }\n   220\t\n   221\t        /* If the PKCS12 is in PEM format then decode it\n   222\t         */\n   223\t        if (format == GNUTLS_X509_FMT_PEM) {\n   224\t                result =\n   225\t                    _gnutls_fbase64_decode(PEM_PKCS12, data->data,\n   226\t                                           data->size, &_data);\n   227\t\n   228\t                if (result < 0) {\n   229\t                        gnutls_assert();\n   230\t                        return result;\n   231\t                }\n   232\t\n   233\t                need_free = 1;\n   234\t        }\n   235\t\n   236\t        if (pkcs12->expanded) {\n   237\t                result = pkcs12_reinit(pkcs12);\n   238\t                if (result < 0) {\n   239\t                        gnutls_assert();\n   240\t                        goto cleanup;\n   241\t                }\n   242\t        }\n   243\t        pkcs12->expanded = 1;\n   244\t\n   245\t        result =\n   246\t            asn1_der_decoding(&pkcs12->pkcs12, _data.data, _data.size,\n   247\t                              error_str);\n   248\t        if (result != ASN1_SUCCESS) {\n   249\t                result = _gnutls_asn2err(result);\n   250\t                _gnutls_debug_log(\"DER error: %s\\n\", error_str);\n   251\t                gnutls_assert();\n   252\t                goto cleanup;\n   253\t        }\n   254\t\n   255\t        if (need_free)\n   256\t                _gnutls_free_datum(&_data);\n   257\t\n   258\t        return 0;\n   259\t\n   260\t      cleanup:\n   261\t        if (need_free)\n   262\t                _gnutls_free_datum(&_data);\n   263\t        return result;\n   264\t}\n   265\t\n   266\t\n   267\t/**\n   268\t * gnutls_pkcs12_export:\n   269\t * @pkcs12: A pkcs12 type\n   270\t * @format: the format of output params. One of PEM or DER.\n   271\t * @output_data: will contain a structure PEM or DER encoded\n   272\t * @output_data_size: holds the size of output_data (and will be\n   273\t *   replaced by the actual size of parameters)\n   274\t *\n   275\t * This function will export the pkcs12 structure to DER or PEM format.\n   276\t *\n   277\t * If the buffer provided is not long enough to hold the output, then\n   278\t * *output_data_size will be updated and GNUTLS_E_SHORT_MEMORY_BUFFER\n   279\t * will be returned.\n   280\t *\n   281\t * If the structure is PEM encoded, it will have a header\n   282\t * of \"BEGIN PKCS12\".\n   283\t *\n   284\t * Returns: In case of failure a negative error code will be\n   285\t *   returned, and 0 on success.\n   286\t **/\n   287\tint\n   288\tgnutls_pkcs12_export(gnutls_pkcs12_t pkcs12,\n   289\t                     gnutls_x509_crt_fmt_t format, void *output_data,\n   290\t                     size_t * output_data_size)\n   291\t{\n   292\t        if (pkcs12 == NULL) {\n   293\t                gnutls_assert();\n   294\t                return GNUTLS_E_INVALID_REQUEST;\n   295\t        }\n   296\t\n   297\t        return _gnutls_x509_export_int(pkcs12->pkcs12, format, PEM_PKCS12,\n   298\t                                       output_data, output_data_size);\n   299\t}\n   300\t\n   301\t/**\n   302\t * gnutls_pkcs12_export2:\n   303\t * @pkcs12: A pkcs12 type\n   304\t * @format: the format of output params. One of PEM or DER.\n   305\t * @out: will contain a structure PEM or DER encoded\n   306\t *\n   307\t * This function will export the pkcs12 structure to DER or PEM format.\n   308\t *\n   309\t * The output buffer is allocated using gnutls_malloc().\n   310\t *\n   311\t * If the structure is PEM encoded, it will have a header\n   312\t * of \"BEGIN PKCS12\".\n   313\t *\n   314\t * Returns: In case of failure a negative error code will be\n   315\t *   returned, and 0 on success.\n   316\t *\n   317\t * Since: 3.1.3\n   318\t **/\n   319\tint\n   320\tgnutls_pkcs12_export2(gnutls_pkcs12_t pkcs12,\n   321\t                      gnutls_x509_crt_fmt_t format, gnutls_datum_t * out)\n   322\t{\n   323\t        if (pkcs12 == NULL) {\n   324\t                gnutls_assert();\n   325\t                return GNUTLS_E_INVALID_REQUEST;\n   326\t        }\n   327\t\n   328\t        return _gnutls_x509_export_int2(pkcs12->pkcs12, format, PEM_PKCS12,\n   329\t                                        out);\n   330\t}\n   331\t\n   332\tstatic int oid2bag(const char *oid)\n   333\t{\n   334\t        if (strcmp(oid, BAG_PKCS8_KEY) == 0)\n   335\t                return GNUTLS_BAG_PKCS8_KEY;\n   336\t        if (strcmp(oid, BAG_PKCS8_ENCRYPTED_KEY) == 0)\n   337\t                return GNUTLS_BAG_PKCS8_ENCRYPTED_KEY;\n   338\t        if (strcmp(oid, BAG_CERTIFICATE) == 0)\n   339\t                return GNUTLS_BAG_CERTIFICATE;\n   340\t        if (strcmp(oid, BAG_CRL) == 0)\n   341\t                return GNUTLS_BAG_CRL;\n   342\t        if (strcmp(oid, BAG_SECRET) == 0)\n   343\t                return GNUTLS_BAG_SECRET;\n   344\t\n   345\t        return GNUTLS_BAG_UNKNOWN;\n   346\t}\n   347\t\n   348\tstatic const char *bag_to_oid(int bag)\n   349\t{\n   350\t        switch (bag) {\n   351\t        case GNUTLS_BAG_PKCS8_KEY:\n   352\t                return BAG_PKCS8_KEY;\n   353\t        case GNUTLS_BAG_PKCS8_ENCRYPTED_KEY:\n   354\t                return BAG_PKCS8_ENCRYPTED_KEY;\n   355\t        case GNUTLS_BAG_CERTIFICATE:\n   356\t                return BAG_CERTIFICATE;\n   357\t        case GNUTLS_BAG_CRL:\n   358\t                return BAG_CRL;\n   359\t        case GNUTLS_BAG_SECRET:\n   360\t                return BAG_SECRET;\n   361\t        }\n   362\t        return NULL;\n   363\t}\n   364\t\n   365\t/* Decodes the SafeContents, and puts the output in\n   366\t * the given bag. \n   367\t */\n   368\tint\n   369\t_pkcs12_decode_safe_contents(const gnutls_datum_t * content,\n   370\t                             gnutls_pkcs12_bag_t bag)\n   371\t{\n   372\t        char oid[MAX_OID_SIZE], root[MAX_NAME_SIZE];\n   373\t        ASN1_TYPE c2 = ASN1_TYPE_EMPTY;\n   374\t        int len, result;\n   375\t        int bag_type;\n   376\t        gnutls_datum_t attr_val;\n   377\t        gnutls_datum_t t;\n   378\t        int count = 0, attributes, j;\n   379\t        unsigned i;\n   380\t\n   381\t        /* Step 1. Extract the SEQUENCE.\n   382\t         */\n   383\t\n   384\t        if ((result = asn1_create_element\n   385\t             (_gnutls_get_pkix(), \"PKIX1.pkcs-12-SafeContents\",\n   386\t              &c2)) != ASN1_SUCCESS) {\n   387\t                gnutls_assert();\n   388\t                result = _gnutls_asn2err(result);\n   389\t                goto cleanup;\n   390\t        }\n   391\t\n   392\t        result =\n   393\t            asn1_der_decoding(&c2, content->data, content->size, NULL);\n   394\t        if (result != ASN1_SUCCESS) {\n   395\t                gnutls_assert();\n   396\t                result = _gnutls_asn2err(result);\n   397\t                goto cleanup;\n   398\t        }\n   399\t\n   400\t        /* Count the number of bags\n   401\t         */\n   402\t        result = asn1_number_of_elements(c2, \"\", &count);\n   403\t        if (result != ASN1_SUCCESS) {\n   404\t                gnutls_assert();\n   405\t                result = _gnutls_asn2err(result);\n   406\t                goto cleanup;\n   407\t        }\n   408\t\n   409\t        bag->bag_elements = MIN(MAX_BAG_ELEMENTS, count);\n   410\t\n   411\t        for (i = 0; i < bag->bag_elements; i++) {\n   412\t\n   413\t                snprintf(root, sizeof(root), \"?%u.bagId\", i + 1);\n   414\t\n   415\t                len = sizeof(oid);\n   416\t                result = asn1_read_value(c2, root, oid, &len);\n   417\t                if (result != ASN1_SUCCESS) {\n   418\t                        gnutls_assert();\n   419\t                        result = _gnutls_asn2err(result);\n   420\t                        goto cleanup;\n   421\t                }\n   422\t\n   423\t                /* Read the Bag type\n   424\t                 */\n   425\t                bag_type = oid2bag(oid);\n   426\t\n   427\t                if (bag_type < 0) {\n   428\t                        gnutls_assert();\n   429\t                        goto cleanup;\n   430\t                }\n   431\t\n   432\t                /* Read the Bag Value\n   433\t                 */\n   434\t\n   435\t                snprintf(root, sizeof(root), \"?%u.bagValue\", i + 1);\n   436\t\n   437\t                result =\n   438\t                    _gnutls_x509_read_value(c2, root,\n   439\t                                            &bag->element[i].data);\n   440\t                if (result < 0) {\n   441\t                        gnutls_assert();\n   442\t                        goto cleanup;\n   443\t                }\n   444\t\n   445\t                if (bag_type == GNUTLS_BAG_CERTIFICATE\n   446\t                    || bag_type == GNUTLS_BAG_CRL\n   447\t                    || bag_type == GNUTLS_BAG_SECRET) {\n   448\t                        gnutls_datum_t tmp = bag->element[i].data;\n   449\t\n   450\t                        result =\n   451\t                            _pkcs12_decode_crt_bag(bag_type, &tmp,\n   452\t                                                   &bag->element[i].data);\n   453\t                        if (result < 0) {\n   454\t                                gnutls_assert();\n   455\t                                goto cleanup;\n   456\t                        }\n   457\t\n   458\t                        _gnutls_free_datum(&tmp);\n   459\t                }\n   460\t\n   461\t                /* read the bag attributes\n   462\t                 */\n   463\t                snprintf(root, sizeof(root), \"?%u.bagAttributes\", i + 1);\n   464\t\n   465\t                result = asn1_number_of_elements(c2, root, &attributes);\n   466\t                if (result != ASN1_SUCCESS\n   467\t                    && result != ASN1_ELEMENT_NOT_FOUND) {\n   468\t                        gnutls_assert();\n   469\t                        result = _gnutls_asn2err(result);\n   470\t                        goto cleanup;\n   471\t                }\n   472\t\n   473\t                if (attributes < 0)\n   474\t                        attributes = 1;\n   475\t\n   476\t                if (result != ASN1_ELEMENT_NOT_FOUND)\n   477\t                        for (j = 0; j < attributes; j++) {\n   478\t\n   479\t                                snprintf(root, sizeof(root),\n   480\t                                         \"?%u.bagAttributes.?%u\", i + 1,\n   481\t                                         j + 1);\n   482\t\n   483\t                                result =\n   484\t                                    _gnutls_x509_decode_and_read_attribute\n   485\t                                    (c2, root, oid, sizeof(oid), &attr_val,\n   486\t                                     1, 0);\n   487\t\n   488\t                                if (result < 0) {\n   489\t                                        gnutls_assert();\n   490\t                                        continue;       /* continue in case we find some known attributes */\n   491\t                                }\n   492\t\n   493\t                                if (strcmp(oid, KEY_ID_OID) == 0) {\n   494\t                                        result =\n   495\t                                            _gnutls_x509_decode_string\n   496\t                                            (ASN1_ETYPE_OCTET_STRING,\n   497\t                                             attr_val.data, attr_val.size,\n   498\t                                             &t, 1);\n   499\t\n   500\t                                        _gnutls_free_datum(&attr_val);\n   501\t                                        if (result < 0) {\n   502\t                                                gnutls_assert();\n   503\t                                                _gnutls_debug_log\n   504\t                                                    (\"Error decoding PKCS12 Bag Attribute OID '%s'\\n\",\n   505\t                                                     oid);\n   506\t                                                continue;\n   507\t                                        }\n   508\t\n   509\t                                        _gnutls_free_datum(&bag->element[i].local_key_id);\n   510\t                                        bag->element[i].local_key_id.data = t.data;\n   511\t                                        bag->element[i].local_key_id.size = t.size;\n   512\t                                } else if (strcmp(oid, FRIENDLY_NAME_OID) == 0 && bag->element[i].friendly_name == NULL) {\n   513\t                                        result =\n   514\t                                            _gnutls_x509_decode_string\n   515\t                                            (ASN1_ETYPE_BMP_STRING,\n   516\t                                             attr_val.data, attr_val.size,\n   517\t                                             &t, 1);\n   518\t\n   519\t                                        _gnutls_free_datum(&attr_val);\n   520\t                                        if (result < 0) {\n   521\t                                                gnutls_assert();\n   522\t                                                _gnutls_debug_log\n   523\t                                                    (\"Error decoding PKCS12 Bag Attribute OID '%s'\\n\",\n   524\t                                                     oid);\n   525\t                                                continue;\n   526\t                                        }\n   527\t\n   528\t                                        gnutls_free(bag->element[i].friendly_name);\n   529\t                                        bag->element[i].friendly_name = (char *) t.data;\n   530\t                                } else {\n   531\t                                        _gnutls_free_datum(&attr_val);\n   532\t                                        _gnutls_debug_log\n   533\t                                            (\"Unknown PKCS12 Bag Attribute OID '%s'\\n\",\n   534\t                                             oid);\n   535\t                                }\n   536\t                        }\n   537\t\n   538\t\n   539\t                bag->element[i].type = bag_type;\n   540\t\n   541\t        }\n   542\t\n   543\t        result = 0;\n   544\t\n   545\t      cleanup:\n   546\t        if (c2)\n   547\t                asn1_delete_structure(&c2);\n   548\t        return result;\n   549\t\n   550\t}\n   551\t\n   552\t\n   553\tstatic int\n   554\t_parse_safe_contents(ASN1_TYPE sc, const char *sc_name,\n   555\t                     gnutls_pkcs12_bag_t bag)\n   556\t{\n   557\t        gnutls_datum_t content = { NULL, 0 };\n   558\t        int result;\n   559\t\n   560\t        /* Step 1. Extract the content.\n   561\t         */\n   562\t\n   563\t        result =\n   564\t            _gnutls_x509_read_string(sc, sc_name, &content,\n   565\t                                     ASN1_ETYPE_OCTET_STRING, 1);\n   566\t        if (result < 0) {\n   567\t                gnutls_assert();\n   568\t                goto cleanup;\n   569\t        }\n   570\t\n   571\t        result = _pkcs12_decode_safe_contents(&content, bag);\n   572\t        if (result < 0) {\n   573\t                gnutls_assert();\n   574\t                goto cleanup;\n   575\t        }\n   576\t\n   577\t        _gnutls_free_datum(&content);\n   578\t\n   579\t        return 0;\n   580\t\n   581\