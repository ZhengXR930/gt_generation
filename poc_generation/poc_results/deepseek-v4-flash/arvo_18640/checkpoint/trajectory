 <unistd.h>\n    43\t#endif\n    44\t\n    45\t#ifdef ENABLE_OPENSSL\n    46\t#include <openssl/sha.h>\n    47\t#endif /* ENABLE_OPENSSL */\n    48\t\n    49\t#include \"internal.h\"\n    50\t#include \"simpletlv.h\"\n    51\t#include \"cardctl.h\"\n    52\t#ifdef ENABLE_ZLIB\n    53\t#include \"compression.h\"\n    54\t#endif\n    55\t#include \"iso7816.h\"\n    56\t#include \"card-cac-common.h\"\n    57\t\n    58\t/*\n    59\t *  CAC hardware and APDU constants\n    60\t */\n    61\t#define CAC_INS_GET_CERTIFICATE       0x36  /* CAC1 command to read a certificate */\n    62\t\n    63\t/*\n    64\t * OLD cac read certificate, only use with CAC-1 card.\n    65\t */\n    66\tstatic int cac_cac1_get_certificate(sc_card_t *card, u8 **out_buf, size_t *out_len)\n    67\t{\n    68\t        u8 buf[CAC_MAX_SIZE];\n    69\t        u8 *out_ptr;\n    70\t        size_t size = 0;\n    71\t        size_t left = 0;\n    72\t        size_t len, next_len;\n    73\t        sc_apdu_t apdu;\n    74\t        int r = SC_SUCCESS;\n    75\t        SC_FUNC_CALLED(card->ctx, SC_LOG_DEBUG_VERBOSE);\n    76\t        /* get the size */\n    77\t        size = left = *out_buf ? *out_len : sizeof(buf);\n    78\t        out_ptr = *out_buf ? *out_buf : buf;\n    79\t        sc_format_apdu(card, &apdu, SC_APDU_CASE_2_SHORT, CAC_INS_GET_CERTIFICATE, 0, 0 );\n    80\t        next_len = MIN(left, 100);\n    81\t        for (; left > 0; left -= len, out_ptr += len) {\n    82\t                len = next_len;\n    83\t                apdu.resp = out_ptr;\n    84\t                apdu.le = len;\n    85\t                apdu.resplen = left;\n    86\t                r = sc_transmit_apdu(card, &apdu);\n    87\t                if (r < 0) {\n    88\t                        break;\n    89\t                }\n    90\t                if (apdu.resplen == 0) {\n    91\t                        r = SC_ERROR_INTERNAL;\n    92\t                        break;\n    93\t                }\n    94\t                /* in the old CAC-1, 0x63 means 'more data' in addition to 'pin failed' */\n    95\t                if (apdu.sw1 != 0x63 || apdu.sw2 < 1)  {\n    96\t                        /* we've either finished reading, or hit an error, break */\n    97\t                        r = sc_check_sw(card, apdu.sw1, apdu.sw2);\n    98\t                        left -= len;\n    99\t                        break;\n   100\t                }\n   101\t                next_len = MIN(left, apdu.sw2);\n   102\t        }\n   103\t        if (r < 0) {\n   104\t                SC_FUNC_RETURN(card->ctx, SC_LOG_DEBUG_VERBOSE, r);\n   105\t        }\n   106\t        r = size - left;\n   107\t        if (*out_buf == NULL) {\n   108\t                *out_buf = malloc(r);\n   109\t                if (*out_buf == NULL) {\n   110\t                        SC_FUNC_RETURN(card->ctx, SC_LOG_DEBUG_VERBOSE,\n   111\t                                SC_ERROR_OUT_OF_MEMORY);\n   112\t                }\n   113\t                memcpy(*out_buf, buf, r);\n   114\t        }\n   115\t        *out_len = r;\n   116\t        SC_FUNC_RETURN(card->ctx, SC_LOG_DEBUG_VERBOSE, r);\n   117\t}\n   118\t\n   119\t/*\n   120\t * Callers of this may be expecting a certificate,\n   121\t * select file will have saved the object type for us\n   122\t * as well as set that we want the cert from the object.\n   123\t */\n   124\tstatic int cac_read_binary(sc_card_t *card, unsigned int idx,\n   125\t                unsigned char *buf, size_t count, unsigned long flags)\n   126\t{\n   127\t        cac_private_data_t * priv = CAC_DATA(card);\n   128\t        int r = 0;\n   129\t        u8 *val = NULL;\n   130\t        u8 *cert_ptr;\n   131\t        size_t val_len;\n   132\t        size_t len, cert_len;\n   133\t        u8 cert_type;\n   134\t\n   135\t        SC_FUNC_CALLED(card->ctx, SC_LOG_DEBUG_VERBOSE);\n   136\t\n   137\t        /* if we didn't return it all last time, return the remainder */\n   138\t        if (priv->cached) {\n   139\t                sc_log(card->ctx, \n   140\t                        \"returning cached value idx=%d count=%\"SC_FORMAT_LEN_SIZE_T\"u\",\n   141\t                        idx, count);\n   142\t                if (idx > priv->cache_buf_len) {\n   143\t                        LOG_FUNC_RETURN(card->ctx, SC_ERROR_FILE_END_REACHED);\n   144\t                }\n   145\t                len = MIN(count, priv->cache_buf_len-idx);\n   146\t                memcpy(buf, &priv->cache_buf[idx], len);\n   147\t                LOG_FUNC_RETURN(card->ctx, len);\n   148\t        }\n   149\t\n   150\t        sc_log(card->ctx, \n   151\t                \"clearing cache idx=%d count=%\"SC_FORMAT_LEN_SIZE_T\"u\",\n   152\t                idx, count);\n   153\t        free(priv->cache_buf);\n   154\t        priv->cache_buf = NULL;\n   155\t        priv->cache_buf_len = 0;\n   156\t\n   157\t        r = cac_cac1_get_certificate(card, &val, &val_len);\n   158\t        if (r < 0)\n   159\t                goto done;\n   160\t        if (val_len < 1) {\n   161\t                r = SC_ERROR_INVALID_DATA;\n   162\t                goto done;\n   163\t        }\n   164\t\n   165\t        cert_type = val[0];\n   166\t        cert_ptr = val + 1;\n   167\t        cert_len = val_len - 1;\n   168\t\n   169\t        /* if the info byte is 1, then the cert is compressed, decompress it */\n   170\t        if ((cert_type & 0x3) == 1) {\n   171\t#ifdef ENABLE_ZLIB\n   172\t                r = sc_decompress_alloc(&priv->cache_buf, &priv->cache_buf_len,\n   173\t                        cert_ptr, cert_len, COMPRESSION_AUTO);\n   174\t#else\n   175\t                sc_log(card->ctx, \"CAC compression not supported, no zlib\");\n   176\t                r = SC_ERROR_NOT_SUPPORTED;\n   177\t#endif\n   178\t                if (r)\n   179\t                        goto done;\n   180\t        } else if (cert_len > 0) {\n   181\t                priv->cache_buf = malloc(cert_len);\n   182\t                if (priv->cache_buf == NULL) {\n   183\t                        r = SC_ERROR_OUT_OF_MEMORY;\n   184\t                        goto done;\n   185\t                }\n   186\t                priv->cache_buf_len = cert_len;\n   187\t                memcpy(priv->cache_buf, cert_ptr, cert_len);\n   188\t        }\n   189\t\n   190\t        /* OK we've read the data, now copy the required portion out to the callers buffer */\n   191\t        priv->cached = 1;\n   192\t        len = MIN(count, priv->cache_buf_len-idx);\n   193\t        if (len && priv->cache_buf)\n   194\t                memcpy(buf, &priv->cache_buf[idx], len);\n   195\t        r = len;\n   196\tdone:\n   197\t        if (val)\n   198\t                free(val);\n   199\t        LOG_FUNC_RETURN(card->ctx, r);\n   200\t}\n   201\t\n   202\t/*\n   203\t * CAC cards use SC_PATH_SELECT_OBJECT_ID rather than SC_PATH_SELECT_FILE_ID. In order to use more\n   204\t * of the PKCS #15 structure, we call the selection SC_PATH_SELECT_FILE_ID, but we set p1 to 2 instead\n   205\t * of 0. Also cac1 does not do any FCI, but it doesn't understand not selecting it. It returns invalid INS\n   206\t * if it doesn't like anything about the select, so we always 'request' FCI for CAC1\n   207\t *\n   208\t * The rest is just copied from iso7816_select_file\n   209\t */\n   210\tstatic int cac_select_file_by_type(sc_card_t *card, const sc_path_t *in_path, sc_file_t **file_out)\n   211\t{\n   212\t        struct sc_context *ctx;\n   213\t        struct sc_apdu apdu;\n   214\t        unsigned char buf[SC_MAX_APDU_BUFFER_SIZE];\n   215\t        unsigned char pathbuf[SC_MAX_PATH_SIZE], *path = pathbuf;\n   216\t        int r, pathlen, pathtype;\n   217\t        struct sc_file *file = NULL;\n   218\t        cac_private_data_t * priv = CAC_DATA(card);\n   219\t\n   220\t        assert(card != NULL && in_path != NULL);\n   221\t        ctx = card->ctx;\n   222\t\n   223\t        SC_FUNC_CALLED(ctx, SC_LOG_DEBUG_VERBOSE);\n   224\t\n   225\t        memcpy(path, in_path->value, in_path->len);\n   226\t        pathlen = in_path->len;\n   227\t        pathtype = in_path->type;\n   228\t\n   229\t        sc_debug(card->ctx, SC_LOG_DEBUG_VERBOSE,\n   230\t                \"path=%s, path->value=%s path->type=%d (%x)\",\n   231\t                sc_print_path(in_path),\n   232\t                sc_dump_hex(in_path->value, in_path->len),\n   233\t                in_path->type, in_path->type);\n   234\t        sc_debug(card->ctx, SC_LOG_DEBUG_VERBOSE, \"file_out=%p index=%d count=%d\\n\",\n   235\t                file_out, in_path->index, in_path->count);\n   236\t\n   237\t        /* Sigh, iso7816_select_file expects paths to keys to have specific\n   238\t         * formats. There is no override. We have to add some bytes to the\n   239\t         * path to make it happy.\n   240\t         * We only need to do this for private keys.\n   241\t         */\n   242\t        if ((pathlen > 2) && (pathlen <= 4) && memcmp(path, \"\\x3F\\x00\", 2) == 0) {\n   243\t                path += 2;\n   244\t                pathlen -= 2;\n   245\t        }\n   246\t\n   247\t\n   248\t        /* CAC has multiple different type of objects that aren't PKCS #15. When we read\n   249\t         * them we need convert them to something PKCS #15 would understand. Find the object\n   250\t         * and object type here:\n   251\t         */\n   252\t        if (priv) { /* don't record anything if we haven't been initialized yet */\n   253\t                /* forget any old cached values */\n   254\t                if (priv->cache_buf) {\n   255\t                        free(priv->cache_buf);\n   256\t                        priv->cache_buf = NULL;\n   257\t                }\n   258\t                priv->cache_buf_len = 0;\n   259\t                priv->cached = 0;\n   260\t        }\n   261\t\n   262\t        if (in_path->aid.len) {\n   263\t                if (!pathlen) {\n   264\t                        memcpy(path, in_path->aid.value, in_path->aid.len);\n   265\t                        pathlen = in_path->aid.len;\n   266\t                        pathtype = SC_PATH_TYPE_DF_NAME;\n   267\t                } else {\n   268\t                        /* First, select the application */\n   269\t                        sc_debug(card->ctx, SC_LOG_DEBUG_VERBOSE,\"select application\" );\n   270\t                        sc_format_apdu(card, &apdu, SC_APDU_CASE_3_SHORT, 0xA4, 4, 0);\n   271\t                        apdu.data = in_path->aid.value;\n   272\t                        apdu.datalen = in_path->aid.len;\n   273\t                        apdu.lc = in_path->aid.len;\n   274\t\n   275\t                        r = sc_transmit_apdu(card, &apdu);\n   276\t                        LOG_TEST_RET(ctx, r, \"APDU transmit failed\");\n   277\t                        r = sc_check_sw(card, apdu.sw1, apdu.sw2);\n   278\t                        if (r)\n   279\t                                LOG_FUNC_RETURN(ctx, r);\n   280\t\n   281\t                }\n   282\t        }\n   283\t\n   284\t        sc_format_apdu(card, &apdu, SC_APDU_CASE_4_SHORT, 0xA4, 0, 0);\n   285\t\n   286\t        switch (pathtype) {\n   287\t        /* ideally we would had SC_PATH_TYPE_OBJECT_ID and add code to the iso7816 select.\n   288\t         * Unfortunately we'd also need to update the caching code as well. For now just\n   289\t         * use FILE_ID and change p1 here */\n   290\t        case SC_PATH_TYPE_FILE_ID:\n   291\t                apdu.p1 = 2;\n   292\t                if (pathlen != 2)\n   293\t                        return SC_ERROR_INVALID_ARGUMENTS;\n   294\t                break;\n   295\t        case SC_PATH_TYPE_DF_NAME:\n   296\t                apdu.p1 = 4;\n   297\t                break;\n   298\t        default:\n   299\t                LOG_FUNC_RETURN(ctx, SC_ERROR_INVALID_ARGUMENTS);\n   300\t        }\n   301\t        apdu.lc = pathlen;\n   302\t        apdu.data = path;\n   303\t        apdu.datalen = pathlen;\n   304\t        apdu.resp = buf;\n   305\t        apdu.resplen = sizeof(buf);\n   306\t        apdu.le = sc_get_max_recv_size(card) < 256 ? sc_get_max_recv_size(card) : 256;\n   307\t        apdu.p2 = 0x00;\n   308\t\n   309\t        r = sc_transmit_apdu(card, &apdu);\n   310\t        LOG_TEST_RET(ctx, r, \"APDU transmit failed\");\n   311\t\n   312\t        if (file_out == NULL) {\n   313\t                /* For some cards 'SELECT' can be only with request to return FCI/FCP. */\n   314\t                r = sc_check_sw(card, apdu.sw1, apdu.sw2);\n   315\t                if (apdu.sw1 == 0x6A && apdu.sw2 == 0x86)   {\n   316\t                        apdu.p2 = 0x00;\n   317\t                        apdu.resplen = sizeof(buf);\n   318\t                        if (sc_transmit_apdu(card, &apdu) == SC_SUCCESS)\n   319\t                                r = sc_check_sw(card, apdu.sw1, apdu.sw2);\n   320\t                }\n   321\t                if (apdu.sw1 == 0x61)\n   322\t                        LOG_FUNC_RETURN(ctx, SC_SUCCESS);\n   323\t                LOG_FUNC_RETURN(ctx, r);\n   324\t        }\n   325\t\n   326\t        r = sc_check_sw(card, apdu.sw1, apdu.sw2);\n   327\t        if (r)\n   328\t                LOG_FUNC_RETURN(ctx, r);\n   329\t\n   330\t        /* CAC cards never return FCI, fake one */\n   331\t        file = sc_file_new();\n   332\t        if (file == NULL)\n   333\t                        LOG_FUNC_RETURN(ctx, SC_ERROR_OUT_OF_MEMORY);\n   334\t        file->path = *in_path;\n   335\t        file->size = CAC_MAX_SIZE; /* we don't know how big, just give a large size until we can read the file */\n   336\t\n   337\t        *file_out = file;\n   338\t        LOG_FUNC_RETURN(ctx, SC_SUCCESS);\n   339\t\n   340\t}\n   341\t\n   342\tstatic int cac_select_file(sc_card_t *card, const sc_path_t *in_path, sc_file_t **file_out)\n   343\t{\n   344\t        return cac_select_file_by_type(card, in_path, file_out);\n   345\t}\n   346\t\n   347\tstatic int cac_finish(sc_card_t *card)\n   348\t{\n   349\t        cac_private_data_t * priv = CAC_DATA(card);\n   350\t\n   351\t        SC_FUNC_CALLED(card->ctx, SC_LOG_DEBUG_VERBOSE);\n   352\t        if (priv) {\n   353\t                cac_free_private_data(priv);\n   354\t        }\n   355\t        return SC_SUCCESS;\n   356\t}\n   357\t\n   358\t\n   359\t/* select a CAC pki applet by index */\n   360\tstatic int cac_select_pki_applet(sc_card_t *card, int index)\n   361\t{\n   362\t        sc_path_t applet_path = cac_cac_pki_obj.path;\n   363\t        applet_path.aid.value[applet_path.aid.len-1] = index;\n   364\t        return cac_select_file_by_type(card, &applet_path, NULL);\n   365\t}\n   366\t\n   367\t/*\n   368\t *  Find the first existing CAC applet. If none found, then this isn't a CAC\n   369\t */\n   370\tstatic int cac_find_first_pki_applet(sc_card_t *card, int *index_out)\n   371\t{\n   372\t        int r, i;\n   373\t\n   374\t        for (i = 0; i < MAX_CAC_SLOTS; i++) {\n   375\t                r = cac_select_pki_applet(card, i);\n   376\t                if (r == SC_SUCCESS) {\n   377\t                        u8 data[2];\n   378\t                        sc_apdu_t apdu;\n   379\t\n   380\t                        /* Try to read first two bytes of the buffer to\n   381\t                         * make sure it is not just malfunctioning card\n   382\t                         */\n   383\t                        sc_format_apdu(card, &apdu, SC_APDU_CASE_2,\n   384\t                                CAC_INS_GET_CERTIFICATE, 0x00, 0x00);\n   385\t                        apdu.le = 0x02;\n   386\t                        apdu.resplen = 2;\n   387\t                        apdu.resp = data;\n   388\t                        r = sc_transmit_apdu(card, &apdu);\n   389\t                        /* SW1 = 0x63 means more data in CAC1 */\n   390\t                        if (r == SC_SUCCESS && apdu.sw1 != 0x63)\n   391\t                                continue;\n   392\t\n   393\t                      