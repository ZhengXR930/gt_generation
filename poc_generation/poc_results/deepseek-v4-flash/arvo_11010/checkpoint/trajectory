ass_table_offset + len(class_table)\n    state_array = struct.pack('>H', 0)  # state 0, class 0 -> entry 0\n    \n    # Entry array: 1 entry\n    # Entry<EntryData>: newState (2), flags (2), data.markIndex (2), data.currentIndex (2) = 8 bytes\n    entry_array_offset = state_array_offset + len(state_array)\n    entry_array = struct.pack('>H', 0)  # newState = 0\n    entry_array += struct.pack('>H', 0x8000)  # flags = SetMark\n    entry_array += struct.pack('>H', 0)  # markIndex = 0\n    entry_array += struct.pack('>H', 0xFFFF)  # currentIndex = 0xFFFF (none)\n    \n    # substitutionTables target: UnsizedOffsetListOf<Lookup<GlyphID>, HBUINT32>\n    # This is an array of OffsetTo<Lookup<GlyphID>, HBUINT32>\n    # We need 1 entry with offset 0 (null)\n    subs_target_offset = entry_array_offset + len(entry_array)\n    subs_target = struct.pack('>I', 0)  # null offset -> returns Null(Lookup<GlyphID>)\n    \n    # Now fill in the offsets\n    # classTable offset is relative to StateTable start (cs[0])\n    cs[4:8] = struct.pack('>I', class_table_offset)\n    cs[8:12] = struct.pack('>I', state_array_offset)\n    cs[12:16] = struct.pack('>I', entry_array_offset)\n    cs[16:20] = struct.pack('>I', subs_target_offset)\n    \n    # Assemble the ContextualSubtable\n    cs_data = bytes(cs) + class_table + state_array + entry_array + subs_target\n    \n    # Now build the ChainSubtable\n    # ChainSubtable: length (4), coverage (4), subFeatureFlags (4), table (variable)\n    # coverage: bit 0-7 = type (2 = Contextual), bit 8-14 = reserved, bit 15 = vertical\n    coverage = 2  # type = ContextualSubtable\n    cst_length = 12 + len(cs_data)  # 12 bytes header + cs_data\n    \n    cst = struct.pack('>I', cst_length)\n    cst += struct.pack('>I', coverage)\n    cst += struct.pack('>I', 0)  # subFeatureFlags\n    cst += cs_data\n    \n    # Build the Chain\n    # Chain: defaultFlags (4), chainLength (4), nFeatureEntries (4), nSubtables (4), features[], subtables[]\n    # features: ea