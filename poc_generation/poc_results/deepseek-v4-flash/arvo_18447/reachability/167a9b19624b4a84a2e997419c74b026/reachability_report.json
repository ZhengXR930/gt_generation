      "function": "config_init_data",
      "line": 732,
      "code": "config->parser = (struct parser) {\n        .state = parse_config,\n        .lexer = {\n            .state = lex_config,\n            .pos = data,\n            .start = data,\n            .end = (char *)data + len,\n            .cur_line = 1,\n        }\n    };",
