    cleanup:\n   261\t        if (need_free)\n   262\t                _gnutls_free_datum(&_data);\n   263\t        return result;\n   264\t}\n   265\t\n   266\t\n   267\t/**\n   268\t * gnutls_pkcs12_export:\n   269\t * @pkcs12: A pkcs12 type\n   270\t * @format: the format of output params. One of PEM or DER.\n   271\t * @output_data: will contain a structure PEM or DER encoded\n   272\t * @output_data_size: holds the size of output_data (and will be\n   273\t *   replaced by the actual size of parameters)\n   274\t *\n   275\t * This function will export the pkcs12 structure to DER or PEM format.\n   276\t *\n   277\t * If the buffer provided is not long enough to hold the output, then\n   278\t * *output_data_size will be updated and GNUTLS_E_SHORT_MEMORY_BUFFER\n   279\t * will be returned.\n   280\t *\n   281\t * If the structure is PEM encoded, it will have a header\n   282\t * of \"BEGIN PKCS12\".\n   283\t *\n   284\t * Returns: In case of failure a negative error code will be\n   285\t *   returned, and 0 on success.\n   286\t **/\n   287\tint\n   288\tgnutls_pkcs12_export(gnutls_pkcs12_t pkcs12,\n   289\t                     gnutls_x509_crt_fmt_t format, void *output_data,\n   290\t                     size_t * output_data_size)\n   291\t{\n   292\t        if (pkcs12 == NULL) {\n   293\t                gnutls_assert();\n   294\t                return GNUTLS_E_INVALID_REQUEST;\n   295\t        }\n   296\t\n   297\t        return _gnutls_x509_export_int(pkcs12->pkcs12, format, PEM_PKCS12,\n   298\t                                       output_data, output_data_size);\n   299\t}\n   300\t\n   301\t/**\n   302\t * gnutls_pkcs12_export2:\n   303\t * @pkcs12: A pkcs12 type\n   304\t * @format: the format of output params. One of PEM or DER.\n   305\t * @out: will contain a structure PEM or DER encoded\n   306\t *\n   307\t * This function will export the pkcs12 structure to DER or PEM format.\n   308\t *\n   309\t * The output buffer is allocated using gnutls_ma