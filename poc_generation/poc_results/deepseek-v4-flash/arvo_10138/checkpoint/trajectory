 is returned, otherwise a\n   154\t *   negative error value.\n   155\t **/\n   156\tint gnutls_pkcs12_init(gnutls_pkcs12_t * pkcs12)\n   157\t{\n   158\t        *pkcs12 = gnutls_calloc(1, sizeof(gnutls_pkcs12_int));\n   159\t\n   160\t        if (*pkcs12) {\n   161\t                int result = pkcs12_reinit(*pkcs12);\n   162\t                if (result < 0) {\n   163\t                        gnutls_assert();\n   164\t                        gnutls_free(*pkcs12);\n   165\t                        return result;\n   166\t                }\n   167\t                return 0;       /* success */\n   168\t        }\n   169\t        return GNUTLS_E_MEMORY_ERROR;\n   170\t}\n   171\t\n   172\t/**\n   173\t * gnutls_pkcs12_deinit:\n   174\t * @pkcs12: The type to be initialized\n   175\t *\n   176\t * This function will deinitialize a PKCS12 type.\n   177\t **/\n   178\tvoid gnutls_pkcs12_deinit(gnutls_pkcs12_t pkcs12)\n   179\t{\n   180\t        if (!pkcs12)\n   181\t                return;\n   182\t\n   183\t        if (pkcs12->pkcs12)\n   184\t                asn1_delete_structure(&pkcs12->pkcs12);\n   185\t\n   186\t        gnutls_free(pkcs12);\n   187\t}\n   188\t\n   189\t/**\n   190\t * gnutls_pkcs12_import:\n   191\t * @pkcs12: The data to store the parsed PKCS12.\n   192\t * @data: The DER or PEM encoded PKCS12.\n   193\t * @format: One of DER or PEM\n   194\t * @flags: an ORed sequence of gnutls_privkey_pkcs8_flags\n   195\t *\n   196\t * This function will convert the given DER or PEM encoded PKCS12\n   197\t * to the native gnutls_pkcs12_t format. The output will be stored in 'pkcs12'.\n   198\t *\n   199\t * If the PKCS12 is PEM encoded it should have a header of \"PKCS12\".\n   200\t *\n   201\t * Returns: On success, %GNUTLS_E_SUCCESS (0) is returned, otherwise a\n   202\t *   negative error value.\n   203\t **/\n   204\tint\n   205\tgnutls_pkcs12_import(gnutls_pkcs12_t pkcs12,\n   206\t                     const gnutls_datum_t * data,\n   207\t              