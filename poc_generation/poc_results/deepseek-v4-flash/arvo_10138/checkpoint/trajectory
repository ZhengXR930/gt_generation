rn BAG_SECRET;\n   361\t        }\n   362\t        return NULL;\n   363\t}\n   364\t\n   365\t/* Decodes the SafeContents, and puts the output in\n   366\t * the given bag. \n   367\t */\n   368\tint\n   369\t_pkcs12_decode_safe_contents(const gnutls_datum_t * content,\n   370\t                             gnutls_pkcs12_bag_t bag)\n   371\t{\n   372\t        char oid[MAX_OID_SIZE], root[MAX_NAME_SIZE];\n   373\t        ASN1_TYPE c2 = ASN1_TYPE_EMPTY;\n   374\t        int len, result;\n   375\t        int bag_type;\n   376\t        gnutls_datum_t attr_val;\n   377\t        gnutls_datum_t t;\n   378\t        int count = 0, attributes, j;\n   379\t        unsigned i;\n   380\t\n   381\t        /* Step 1. Extract the SEQUENCE.\n   382\t         */\n   383\t\n   384\t        if ((result = asn1_create_element\n   385\t             (_gnutls_get_pkix(), \"PKIX1.pkcs-12-SafeContents\",\n   386\t              &c2)) != ASN1_SUCCESS) {\n   387\t                gnutls_assert();\n   388\t                result = _gnutls_asn2err(result);\n   389\t                goto cleanup;\n   390\t        }\n   391\t\n   392\t        result =\n   393\t            asn1_der_decoding(&c2, content->data, content->size, NULL);\n   394\t        if (result != ASN1_SUCCESS) {\n   395\t                gnutls_assert();\n   396\t                result = _gnutls_asn2err(result);\n   397\t                goto cleanup;\n   398\t        }\n   399\t\n   400\t        /* Count the number of bags\n   401\t         */\n   402\t        result = asn1_number_of_elements(c2, \"\", &count);\n   403\t        if (result != ASN1_SUCCESS) {\n   404\t                gnutls_assert();\n   405\t                result = _gnutls_asn2err(result);\n   406\t                goto cleanup;\n   407\t        }\n   408\t\n   409\t        bag->bag_elements = MIN(MAX_BAG_ELEMENTS, count);\n   410\t\n   411\t        for (i = 0; i < bag->bag_elements; i++) {\n   412\t\n   413\t                snprintf(root, sizeof(root), \"?%u.bagId\", i + 1);\n   414\t\n   415\t                len = sizeof(oid);\n   416\t                result = asn1_read_value(c2, root, oid, &len);\n   417\t                if (result != ASN1_SUCCESS) {\n   418\t                        gnutls_assert();\n   419\t                        result = _gnutls_asn2err(result);\n   420\t                        goto cleanup;\n   421\t                }\n   422\t\n   423\t                /* Read the Bag type\n   424\t                 */\n   425\t                bag_type = oid2bag(oid);\n   426\t\n   427\t                if (bag_type < 0) {\n   428\t                        gnutls_assert();\n   429\t                        goto cleanup;\n   430\t                }\n   431\t\n   432\t                /* Read the Bag Value\n   433\t                 */\n   434\t\n   435\t                snprintf(root, sizeof(root), \"?%u.bagValue\", i + 1);\n   436\t\n   437\t                result =\n   438\t                    _gnutls_x509_read_value(c2, root,\n   439\t                                            &bag->element[i].data);\n   440\t                if (result < 0) {\n   441\t                        gnutls_assert();\n   442\t                        goto cleanup;\n   443\t                }\n   444\t\n   445\t                if (bag_type == GNUTLS_BAG_CERTIFICATE\n   446\t                    || bag_type == GNUTLS_BAG_CRL\n   447\t                    || bag_type == GNUTLS_BAG_SECRET) {\n   448\t                        gnutls_datum_t tmp = bag->element[i].data;\n   449\t\n   450\t                        result =\n   451\t                            _pkcs12_decode_crt_bag(bag_type, &tmp,\n   452\t                                                   &bag->element[i].data);\n   453\t                        if (result < 0) {\n   454\t                                gnutls_assert();\n   455\t                                goto cleanup;\n   456\t                        }\n   457\t\n   458\t                        _gnutls_free_datum(&tmp);\n   459\t                }\n 