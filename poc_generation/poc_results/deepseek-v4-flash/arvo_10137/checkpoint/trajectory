        return NULL;\n   158\t}\n   159\t\n   160\tconst char *_gnutls_ldap_string_to_oid(const char *str, unsigned str_len)\n   161\t{\n   162\t        unsigned int i = 0;\n   163\t\n   164\t        do {\n   165\t                if ((_oid2str[i].ldap_desc != NULL) &&\n   166\t                    (str_len == _oid2str[i].ldap_desc_size) &&\n   167\t                    (strncasecmp(_oid2str[i].ldap_desc, str, str_len) ==\n   168\t                     0))\n   169\t                        return _oid2str[i].oid;\n   170\t                i++;\n   171\t        }\n   172\t        while (_oid2str[i].oid != NULL);\n   173\t\n   174\t        return NULL;\n   175\t}\n   176\t\n   177\t/* Escapes a string following the rules from RFC4514.\n   178\t */\n   179\tstatic int str_escape(const gnutls_datum_t * str, gnutls_datum_t * escaped)\n   180\t{\n   181\t        unsigned int j, i;\n   182\t        uint8_t *buffer = NULL;\n   183\t        int ret;\n   184\t\n   185\t        if (str == NULL)\n   186\t                return gnutls_assert_val(GNUTLS_E_INVALID_REQUEST);\n   187\t\n   188\t        /* the string will be at most twice the original */\n   189\t        buffer = gnutls_malloc(str->size * 2 + 2);\n   190\t        if (buffer == NULL)\n   191\t                return gnutls_assert_val(GNUTLS_E_MEMORY_ERROR);\n   192\t\n   193\t        for (i = j = 0; i < str->size; i++) {\n   194\t                if (str->data[i] == 0) {\n   195\t                        /* this is handled earlier */\n   196\t                        ret = gnutls_assert_val(GNUTLS_E_ASN1_DER_ERROR);\n   197\t                        goto cleanup;\n   198\t                }\n   199\t\n   200\t                if (str->data[i] == ',' || str->data[i] == '+'\n   201\t                    || str->data[i] == '\"' || str->data[i] == '\\\\'\n   202\t                    || str->data[i] == '<' || str->data[i] == '>'\n   203\t                    || str->data[i] == ';' || str->data[i] == 0)\n   204\t                        buffer[j++] = '\\\\';\n   205\t                else if (i == 0 && str->data[i] == '#')\n   206\t                        buffer[j++] = '\\\\';\n   207\t                else if (i == 0 && str->data[i] == ' ')\n   208\t                        buffer[j++] = '\\\\';\n   209\t                else if (i == (str->size - 1) && str->data[i] == ' ')\n   210\t                        buffer[j++] = '\\\\';\n   211\t\n   212\t                buffer[j++] = str->data[i];\n   213\t        }\n   214\t\n   215\t        /* null terminate the string */\n   216\t        buffer[j] = 0;\n   217\t        escaped->data = buffer;\n   218\t        escaped->size = j;\n   219\t\n   220\t        return 0;\n   221\t      cleanup:\n   222\t        gnutls_free(buffer);\n   223\t        return ret;\n   224\t}\n   225\t\n   226\t/**\n   227\t * gnutls_x509_dn_oid_known:\n   228\t * @oid: holds an Object Identifier in a null terminated string\n   229\t *\n   230\t * This function will inform about known DN OIDs. This is useful since\n   231\t * functions like gnutls_x509_crt_set_dn_by_oid() use the information\n   232\t * on known OIDs to properly encode their input. Object Identifiers\n   233\t * that are not known are not encoded by these functions, and their\n   234\t * input is stored directly into the ASN.1 structure. In that case of\n   235\t * unknown OIDs, you have the responsibility of DER encoding your\n   236\t * data.\n   237\t *\n   238\t * Returns: 1 on known OIDs and 0 otherwise.\n   239\t **/\n   240\tint gnutls_x509_dn_oid_known(const char *oid)\n   241\t{\n   242\t        unsigned int i = 0;\n   243\t        unsigned len = strlen(oid);\n   244\t\n   245\t        do {\n   246\t                if (len == _oid2str[i].oid_size &&\n   247\t                        strcmp(_oid2str[i].oid, oid) == 0)\n   248\t                        return 1;\n   249\t                i++;\n   250\t        }\n   251\t        while (_oid2str[i].oid != NULL);\n   252\t\n   253\t        return 0;\n   254\t}\n   255\t\n   256\t/**\n   257\t * gnutls_x509_dn_oid_name:\n   258\t * @oid: holds an Object Identifier in a null terminated string\n   259\t * @flags: 0 or GNUTLS_X509_DN_OID_*\n   260\t *\n   261\t * This function will return the name of a known DN OID. If\n   262\t * %GNUTLS_X509_DN_OID_RETURN_OID is specified this function\n   263\t * will return the given OID if no descriptive name has been\n   264\t * found.\n   265\t *\n   266\t * Returns: A null terminated string or NULL otherwise.\n   267\t *\n   268\t * Since: 3.0\n   269\t **/\n   270\tconst char *gnutls_x509_dn_oid_name(const char *oid, unsigned int flags)\n   271\t{\n   272\t        unsigned int i = 0;\n   273\t        unsigned len = strlen(oid);\n   274\t\n   275\t        do {\n   276\t                if ((_oid2str[i].oid_size == len) && \n   277\t                        strcmp(_oid2str[i].oid, oid) == 0 && _oid2str[i].ldap_desc != NULL)\n   278\t                        return _oid2str[i].ldap_desc;\n   279\t                i++;\n   280\t        }\n   281\t        while (_oid2str[i].oid != NULL);\n   282\t\n   283\t        if (flags & GNUTLS_X509_DN_OID_RETURN_OID)\n   284\t                return oid;\n   285\t        else\n   286\t                return NULL;\n   287\t}\n   288\t\n   289\tstatic int\n   290\tmake_printable_string(unsigned etype, const gnutls_datum_t * input,\n   291\t                      gnutls_datum_t * out)\n   292\t{\n   293\t        int printable = 0;\n   294\t        int ret;\n   295\t\n   296\t        /* empty input strings result to a null string */\n   297\t        if (input->data == NULL || input->size == 0) {\n   298\t                out->data = gnutls_calloc(1, 1);\n   299\t                if (out->data == NULL)\n   300\t                        return gnutls_assert_val(GNUTLS_E_MEMORY_ERROR);\n   301\t                out->size = 0;\n   302\t                return 0;\n   303\t        }\n   304\t\n   305\t        if (etype == ASN1_ETYPE_BMP_STRING) {\n   306\t                ret = _gnutls_ucs2_to_utf8(input->data, input->size, out, 1);\n   307\t                if (ret < 0) {\n   308\t                        /* could not convert. Handle it as non-printable */\n   309\t                        printable = 0;\n   310\t                } else\n   311\t                        printable = 1;\n   312\t        } else if (etype == ASN1_ETYPE_TELETEX_STRING) {\n   313\t                /* HACK: if the teletex string contains only ascii\n   314\t                 * characters then treat it as printable.\n   315\t                 */\n   316\t                if (_gnutls_str_is_print((char*)input->data, input->size)) {\n   317\t                        out->data = gnutls_malloc(input->size + 1);\n   318\t                        if (out->data == NULL)\n   319\t                                return\n   320\t                                    gnutls_assert_val\n   321\t                                    (GNUTLS_E_MEMORY_ERROR);\n   322\t\n   323\t                        memcpy(out->data, input->data, input->size);\n   324\t                        out->size = input->size;\n   325\t\n   326\t                        out->data[out->size] = 0;\n   327\t\n   328\t                        printable = 1;\n   329\t                }\n   330\t        } else if (etype != ASN1_ETYPE_UNIVERSAL_STRING)        /* supported but not printable */\n   331\t                return GNUTLS_E_INVALID_REQUEST;\n   332\t\n   333\t        if (printable == 0) {   /* need to allocate out */\n   334\t                ret = data2hex(input->data, input->size, out);\n   335\t                if (ret < 0) {\n   336\t                        gnutls_assert();\n   337\t                        return ret;\n   338\t                }\n   339\t        }\n   340\t\n   341\t        return 0;\n   342\t}\n   343\t\n   344\tstatic int\n   345\tdecode_complex_string(const struct oid_to_string *oentry, void *value,\n   346\t                      int value_size, gnutls_datum_t * out)\n   347\t{\n   348\t        ch