 if (strcmp(str, \"bmpString\") == 0)\n   393\t                etype = ASN1_ETYPE_BMP_STRING;\n   394\t        else if (strcmp(str, \"universalString\") == 0)\n   395\t                etype = ASN1_ETYPE_UNIVERSAL_STRING;\n   396\t        else\n   397\t                etype = ASN1_ETYPE_INVALID;\n   398\t\n   399\t        _gnutls_str_cpy(tmpname, sizeof(tmpname), str);\n   400\t\n   401\t        result = _gnutls_x509_read_value(tmpasn, tmpname, &td);\n   402\t        asn1_delete_structure(&tmpasn);\n   403\t        if (result < 0)\n   404\t                return gnutls_assert_val(result);\n   405\t\n   406\t        if (etype != ASN1_ETYPE_INVALID) {\n   407\t                result = make_printable_string(etype, &td, out);\n   408\t\n   409\t                _gnutls_free_datum(&td);\n   410\t\n   411\t                if (result < 0)\n   412\t                        return gnutls_assert_val(result);\n   413\t        } else {\n   414\t                out->data = td.data;\n   415\t                out->size = td.size;\n   416\t                /* _gnutls_x509_read_value always null terminates */\n   417\t        }\n   418\t\n   419\t        assert(out->data != NULL);\n   420\t\n   421\t        /* Refuse to deal with strings containing NULs. */\n   422\t        if (strlen((void *) out->data) != (size_t) out->size) {\n   423\t                _gnutls_free_datum(out);\n   424\t                return gnutls_assert_val(GNUTLS_E_ASN1_EMBEDDED_NULL_IN_STRING);\n   425\t        }\n   426\t\n   427\t        return 0;\n   428\t}\n   429\t\n   430\t\n   431\t/* This function will convert an attribute value, specified by the OID,\n   432\t * to a string. The result will be a null terminated string.\n   433\t *\n   434\t * res may be null. This will just return the res_size, needed to\n   435\t * hold the string.\n   436\t */\n   437\tint\n   438\t_gnutls_x509_dn_to_string(const char *oid, void *value,\n   439\t                          int value_size, gnutls_datum_t * str)\n   440\t{\n 