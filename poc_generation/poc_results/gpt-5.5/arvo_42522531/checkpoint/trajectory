     *p++ = (uint8_t)flags; /* Set flags for attribute */\n   319      }                          /* end if */\n   320      else\n   321          *p++ = 0; /* Reserved, for version <2 */\n   322\n   323      /*\n   324       * Encode the lengths of the various parts of the attribute message. The\n   325       * encoded lengths are exact but we pad each part except the data to be a\n   326       * multiple of eight bytes (in the first version).\n   327       */\n   328      name_len = HDstrlen(attr->shared->name) + 1;\n   329      UINT16ENCODE(p, name_len);\n   330      UINT16ENCODE(p, attr->shared->dt_size);\n   331      UINT16ENCODE(p, attr->shared->ds_size);\n   332\n   333      /* The character encoding for the attribute's name, in later versions */\n   334      if (attr->shared->version >= H5O_ATTR_VERSION_3)\n   335          *p++ = (uint8_t)attr->shared->encoding;\n   336\n   337      /* Write the name including null terminator */\n   338      H5MM_memcpy(p, attr->shared->name, name_len);\n   339      if (attr->shared->version < H5O_ATTR_VERSION_2) {\n   340          /* Pad to the correct number of bytes */\n   341          HDmemset(p + name_len, 0, H5O_ALIGN_OLD(name_len) - name_len);\n   342          p += H5O_ALIGN_OLD(name_len);\n   343      } /* end if */\n   344      else\n   345          p += name_len;\n   346\n   347      /* encode the attribute datatype */\n   348      if ((H5O_MSG_DTYPE->encode)(f, FALSE, p, attr->shared->dt) < 0)\n   349          HGOTO_ERROR(H5E_ATTR, H5E_CANTENCODE, FAIL, \"can't encode attribute datatype\")\n   350\n   351      if (attr->shared->version < H5O_ATTR_VERSION_2) {\n   352          HDmemset(p + attr->shared->dt_size, 0, H5O_ALIGN_OLD(attr->shared->dt_size) - attr->shared->dt_size);\n   353          p += H5O_ALIGN_OLD(attr->shared->dt_size);\n   354      } /* end if */\n   355      else\n   356          p += attr->shared->dt_size;\n   357\n   358      /* encode the attribute dataspace */\n   359      if ((H5O_MSG_SDSPACE-