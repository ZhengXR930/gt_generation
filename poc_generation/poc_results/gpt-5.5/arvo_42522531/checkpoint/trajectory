    "content": "b16ec83d4b 2023-03-02 11:17:49 -0600 Check for overflow when calculating on-disk attribute data size (#2459)\ncommit b16ec83d4bd79f9ffaad85de16056419f3532887\nAuthor: Egbert Eich <eich@suse.com>\nDate:   Thu Mar 2 18:17:49 2023 +0100\n\n    Check for overflow when calculating on-disk attribute data size (#2459)\n\n    * Remove duplicate code\n\n    Signed-off-by: Egbert Eich <eich@suse.com>\n\n    * Add test case for CVE-2021-37501\n\n    Bogus sizes in this test case causes the on-disk data size\n    calculation in H5O__attr_decode() to overflow so that the\n    calculated size becomes 0. This causes the read to overflow\n    and h5dump to segfault.\n    This test case was crafted, the test file was not directly\n    generated by HDF5.\n    Test case from:\n    https://github.com/ST4RF4LL/Something_Found/blob/main/HDF5_v1.13.0_h5dump_heap_overflow.md\n\ndiff --git a/src/H5Oattr.c b/src/H5Oattr.c\nindex 638686587d..e431cd2e62 100644\n--- a/src/H5Oattr.c\n+++ b/src/H5Oattr.c\n@@ -221,10 +221,6 @@ H5O__attr_decode(H5F_t *f, H5O_t *open_oh, unsigned H5_ATTR_UNUSED mesg_flags, u\n     else\n         p += attr->shared->ds_size;\n\n-    /* Get the datatype's size */\n-    if (0 == (dt_size = H5T_get_size(attr->shared->dt)))\n-        HGOTO_ERROR(H5E_ATTR, H5E_CANTGET, NULL, \"unable to get datatype size\")\n-\n     /* Get the datatype & dataspace sizes */\n     if (0 == (dt_size = H5T_get_size(attr->shared->dt)))\n         HGOTO_ERROR(H5E_ATTR, H5E_CANTGET, NULL, \"unable to get datatype size\")\n@@ -234,6 +230,9 @@ H5O__attr_decode(H5F_t *f, H5O_t *open_oh, unsigned H5_ATTR_UNUSED mesg_flags, u\n\n     /* Compute the size of the data */\n     H5_CHECKED_ASSIGN(attr->shared->data_size, size_t, ds_size * (hsize_t)dt_size, hsize_t);\n+    /* Check if multiplication has overflown */\n+    if ((attr->shared->data_size / dt_size) != ds_size)\n+        HGOTO_ERROR(H5E_RESOURCE, H5E_OVERFLOW, NULL, \"data size exceeds addressable range\")\n\n     /* Go get the data */\n     if (attr->shared->data_size) {\n   200      if (NULL == (attr->shared->ds = H5FL_CALLOC(H5S_t)))\n   201          HGOTO_ERROR(H5E_RESOURCE, H5E_NOSPACE, NULL, \"memory allocation failed\")\n   202\n   203      /* Decode attribute's dataspace extent */\n   204      if ((extent = (H5S_extent_t *)(H5O_MSG_SDSPACE->decode)(\n   205               f, open_oh, ((flags & H5O_ATTR_FLAG_SPACE_SHARED) ? H5O_MSG_FLAG_SHARED : 0), ioflags,\n   206               attr->shared->ds_size, p)) == NULL)\n   207          HGOTO_ERROR(H5E_ATTR, H5E_CANTDECODE, NULL, \"can't decode attribute dataspace\")\n   208\n   209      /* Copy the extent information to the dataspace */\n   210      H5MM_memcpy(&(attr->shared->ds->extent), extent, sizeof(H5S_extent_t));\n   211\n   212      /* Release temporary extent information */\n   213      extent = H5FL_FREE(H5S_extent_t, extent);\n   214\n   215      /* Default to entire dataspace being selected */\n   216      if (H5S_select_all(attr->shared->ds, FALSE) < 0)\n   217          HGOTO_ERROR(H5E_DATASPACE, H5E_CANTSET, NULL, \"unable to set all selection\")\n   218\n   219      if (attr->shared->version < H5O_ATTR_VERSION_2)\n   220          p += H5O_ALIGN_OLD(attr->shared->ds_size);\n   221      else\n   222          p += attr->shared->ds_size;\n   223\n   224      /* Get the datatype's size */\n   225      if (0 == (dt_size = H5T_get_size(attr->shared->dt)))\n   226          HGOTO_ERROR(H5E_ATTR, H5E_CANTGET, NULL, \"unable to get datatype size\")\n   227\n   228      /* Get the datatype & dataspace sizes */\n   229      if (0 == (dt_size = H5T_get_size(attr->shared->dt)))\n   230          HGOTO_ERROR(H5E_ATTR, H5E_CANTGET, NULL, \"unable to get datatype size\")\n   231      if ((sds_size = H5S_GET_EXTENT_NPOINTS(attr->shared->ds)) < 0)\n   232          HGOTO_ERROR(H5E_ATTR, H5E_CANTGET, NULL, \"unable to get dataspace size\")\n   233      ds_size = (hsize_t)sds_size;\n   234\n   235      /* Compute the size of the data */\n   236      H5_CHECKED_ASSIGN(attr->shared->data_size, size_t, ds_size * (hsize_t)dt_size, hsize_t);\n   237\n   238      /* Go get the data */\n   239      if (attr->shared->data_size) {\n   240          /* Ensure that data size doesn't exceed buffer size, in case of\n   241             it's being corrupted in the file */\n   242          if (attr->shared->data_size > p_size)\n   243              HGOTO_ERROR(H5E_RESOURCE, H5E_OVERFLOW, NULL, \"data size exceeds buffer size\")\n   244\n   245          if (NULL == (attr->shared->data = H5FL_BLK_MALLOC(attr_buf, attr->shared->data_size)))\n   246              HGOTO_ERROR(H5E_RESOURCE, H5E_NOSPACE, NULL, \"memory allocation failed\")\n   247          H5MM_memcpy(attr->shared->data, p, attr->shared->data_size);\n   248      } /* end if */\n   249\n   250      /* Increment the reference count for this object header message in cache(compact\n   251         storage) or for the object from dense storage. */\n   252      attr->shared->nrefs++;\n   253\n   254      /* Set return value */\n   255      ret_value = attr;\n   256\n   257  done:\n   258      if (NULL == ret_value)\n   259          if (attr) {\n   260              /* Free any dynamically allocated items */\n   261              if (attr->shared)\n   262                  if (H5A__shared_free(attr) < 0)\n   263                      HDONE_ERROR(H5E_ATTR, H5E_CANTRELEASE, NULL, \"can't release attribute info\")\n   264\n   265              attr = H5FL_FREE(H5A_t, attr);\n   266          } /* end if */\n   267\n   268      FUNC_LEAVE_NOAPI(ret_value)\n   269  } /* end H5O__attr_decode() */\n   270\n   271  /*--------------------------------------------------------------------------\n   272   NAME\n   273      H5O__attr_encode\n   274   PURPOSE\n   275      Encode a simple attribute message\n   276   USAGE\n   277      herr_t H5O__attr_encode(f, p, mesg)\n   278          H5F_t *f;         IN: pointer to the HDF5 file struct\n   279          const uint8 *p;         IN: the raw infor