r url invalid: %.*s\",\n   218                         (int)discoveryUrl->length, discoveryUrl->data);\n   219          return;\n   220      }\n   221\n   222      if(!isOnline) {\n   223          UA_StatusCode removeRetval =\n   224                  UA_Discovery_removeRecord(server, serverName, &hostname,\n   225                                            port, updateTxt);\n   226          if(removeRetval != UA_STATUSCODE_GOOD)\n   227              UA_LOG_WARNING(server->config.logger, UA_LOGCATEGORY_SERVER,\n   228                             \"Could not remove mDNS record for hostname %.*s.\",\n   229                             (int)serverName->length, serverName->data);\n   230          return;\n   231      }\n   232\n   233      UA_String *capabilities = NULL;\n   234      size_t capabilitiesSize = 0;\n   235      if(mdnsConfig) {\n   236          capabilities = mdnsConfig->serverCapabilities;\n   237          capabilitiesSize = mdnsConfig->serverCapabilitiesSize;\n   238      }\n   239\n   240      UA_StatusCode addRetval =\n   241          UA_Discovery_addRecord(server, serverName, &hostname,\n   242                                 port, &path, UA_DISCOVERY_TCP, updateTxt,\n   243                                 capabilities, &capabilitiesSize);\n   244      if(addRetval != UA_STATUSCODE_GOOD)\n   245          UA_LOG_WARNING(server->config.logger, UA_LOGCATEGORY_SERVER,\n   246                         \"Could not add mDNS record for hostname %.*s.\",\n   247                         (int)serverName->length, serverName->data);\n   248  }\n   249\n   250  void\n   251  UA_Server_setServerOnNetworkCallback(UA_Server *server,\n   252                                       UA_Server_serverOnNetworkCallback cb,\n   253                                       void* data) {\n   254      server->serverOnNetworkCallback = cb;\n   255      server->serverOnNetworkCallbackData = data;\n   256  }\n   257\n   258  static void\n   259  socket_mdns_set_nonblocking(int sockfd) {\