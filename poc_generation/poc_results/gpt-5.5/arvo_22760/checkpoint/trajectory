    thresh      estimated pixel threshold for crossing\n   661   *                           white <--> black; typ. ~120\n   662   * \\param[out]   pwidth      [optional] best decoding window width, in pixels\n   663   * \\param[out]   pnac        [optional] number of transitions in each window\n   664   * \\param[in]    debugflag   use 1 to generate debug output\n   665   * \\return  nad   numa of barcode widths in encoded integer units,\n   666   *                or NULL on error\n   667   *\n   668   * <pre>\n   669   * Notes:\n   670   *      (1) The widths are alternating black/white, starting with black\n   671   *          and ending with black.\n   672   *      (2) The optional best decoding window width is the width of the window\n   673   *          that is used to make a decision about whether a transition occurs.\n   674   *          It is approximately the average width in pixels of the narrowest\n   675   *          white and black bars (i.e., those corresponding to unit width).\n   676   *      (3) The optional return signal %nac is a sequence of 0s, 1s,\n   677   *          and perhaps a few 2s, giving the number of crossings in each window.\n   678   *          On the occasion where there is a '2', it is interpreted as\n   679   *          as ending two runs: the previous one and another one that has length 1.\n   680   * </pre>\n   681   */\n   682  NUMA *\n   683  pixExtractBarcodeWidths2(PIX        *pixs,\n   684                           l_float32   thresh,\n   685                           l_float32  *pwidth,\n   686                           NUMA      **pnac,\n   687                           l_int32     debugflag)\n   688  {\n   689  NUMA  *nacp, *nad;\n   690\n   691      PROCNAME(\"pixExtractBarcodeWidths2\");\n   692\n   693      if (!pixs || pixGetDepth(pixs) != 8)\n   694          return (NUMA *)ERROR_PTR(\"pixs undefined or not 8 bpp\", procName, NULL);\n   695\n   696          /* Get the best estimate of the crossings, in pixel units */\n   697      nacp = pixExtractBarcodeCrossings(pixs, thresh, debugflag);\n   698\n   699          /* Quantize the crossings to get actual windowed data */\n   700      nad = numaQuantizeCrossingsByWindow(nacp, 2.0, pwidth, NULL, pnac, debugflag);\n   701\n   702      numaDestroy(&nacp);\n   703      return nad;\n   704  }\n   705\n   706\n   707  /*!\n   708   * \\brief   pixExtractBarcodeCrossings()\n   709   *\n   710   * \\param[in]    pixs        input image; 8 bpp\n   711   * \\param[in]    thresh      estimated pixel threshold for crossing\n   712   *                           white <--> black; typ. ~120\n   713   * \\param[in]    debugflag   use 1 to generate debug output\n   714   * \\return  numa   of crossings, in pixel units, or NULL on error\n   715   */\n   716  NUMA *\n   717  pixExtractBarcodeCrossings(PIX       *pixs,\n   718                             l_float32  thresh,\n   719                             l_int32    debugflag)\n   720  {\n   721  l_int32    w;\n   722  l_float32  bestthresh;\n   723  GPLOT     *gplot;\n   724  NUMA      *nas, *nax, *nay, *nad;\n   725\n   726      PROCNAME(\"pixExtractBarcodeCrossings\");\n   727\n   728      if (!pixs || pixGetDepth(pixs) != 8)\n   729          return (NUMA *)ERROR_PTR(\"pixs undefined or not 8 bpp\", procName, NULL);\n   730\n   731          /* Scan pixels horizontally and average results */\n   732      nas = pixAverageRasterScans(pixs, 51);\n   733\n   734          /* Interpolate to get 4x the number of values */\n   735      w = pixGetWidth(pixs);\n   736      numaInterpolateEqxInterval(0.0, 1.0, nas, L_QUADRATIC_INTERP, 0.0,\n   737                                 (l_float32)(w - 1), 4 * w + 1, &nax, &nay);\n   738\n   739      if (debugflag) {\n   740          lept_mkdir(\"lept/barcode\");\n   741          gplot = gplotCreate(\"/tmp/lept/barcode/signal\", GPLOT_PNG,\n   742                              \"Pixel values\", \"dist in pixels\", \"value\");\n   743          gplotAddPlot(gplot, nax, nay, GPLOT_LINES, \"plot 1\");\n   744          gplotMakeOutput(gplot);\n   745          gplotDestroy(&gplot);\n   746      }\n   747\n   748          /* Locate the crossings.  Run multiple times with different\n   749           * thresholds, and choose a threshold in the center of the\n   750           * run of thresholds that all give the maximum number of crossings. */\n   751      numaSelectCrossingThreshold(nax, nay, thresh, &bestthresh);\n   752\n   753          /* Get the crossings with the best threshold. */\n   754      nad = numaCrossingsByThreshold(nax, nay, bestthresh);\n   755\n   756      numaDestroy(&nas);\n   757      numaDestroy(&nax);\n   758      numaDestroy(&nay);\n   759      return nad;\n   760  }\n   761\n   762\n   763  /*------------------------------------------------------------------------*\n   764   *                         Average adjacent rasters                       *\n   765   *------------------------------------------------------------------------*/\n   766  /*!\n   767   * \\brief   pixAverageRasterScans()\n   768   *\n   769   * \\param[in]    pixs     input image; 8 bpp\n   770   * \\param[in]    nscans   number of adjacent scans, about the center vertically\n   771   * \\return  numa of average pixel values across image, or NULL on error\n   772   */\n   773  static NUMA *\n   774  pixAverageRasterScans(PIX     *pixs,\n   775                        l_int32  nscans)\n   776  {\n   777  l_int32     w, h, first, last, i, j, wpl, val;\n   778  l_uint32   *line, *data;\n   779  l_float32  *array;\n   780  NUMA       *nad;\n   781\n   782      PROCNAME(\"pixAverageRasterScans\");\n   783\n   784      if (!pixs || pixGetDepth(pixs) != 8)\n   785          return (NUMA *)ERROR_PTR(\"pixs undefined or not 8 bpp\", procName, NULL);\n   786\n   787      pixGetDimensions(pixs, &w, &h, NULL);\n   788      if (nscans <= h) {\n   789          first = 0;\n   790          last = h - 1;\n   791          nscans = h;\n   792      } else {\n   793          first = (h - nscans) / 2;\n   794          last = first + nscans - 1;\n   795      }\n   796\n   797      nad = numaCreate(w);\n   798      numaSetCount(nad, w);\n   799      array = numaGetFArray(nad, L_NOCOPY);\n   800      wpl = pixGetWpl(pixs);\n   801      data = pixGetData(pixs);\n   802      for (j = 0; j < w; j++) {\n   803          for (i = first; i <= last; i++) {\n   804              line = data + i * wpl;\n   805              val = GET_DATA_BYTE(line, j);\n   806              array[j] += val;\n   807          }\n   808          array[j] = array[j] / (l_float32)nscans;\n   809      }\n   810\n   811      return nad;\n   812  }\n   813\n   814\n   815  /*------------------------------------------------------------------------*\n   816   *                   Signal processing for barcode widths                 *\n   817   *------------------------------------------------------------------------*/\n   818  /*!\n   819   * \\brief   numaQuantizeCrossingsByWidth()\n   820   *\n   130   * \\param[in]    pixs        any depth\n   131   * \\param[in]    format      L_BF_ANY, L_BF_CODEI2OF5, L_BF_CODE93, ...\n   132   * \\param[in]    method      L_USE_WIDTHS, L_USE_WINDOWS\n   133   * \\param[out]   psaw        [optional] sarray of bar widths\n   134   * \\param[in]    debugflag   use 1 to generate debug output\n   135   * \\return  sarray text of barcodes, or NULL if none found or on error\n   136   */\n   137  SARRAY *\n   138  pixProcessBarcodes(PIX      *pixs,\n   139                     l_int32   format,\n   140                     l_int32   method,\n   141                     SARRAY  **psaw,\n   142                     l_int32   debugflag)\n   143  {\n   144  PIX     *pixg;\n   145  PIXA    *pixa;\n   146  SARRAY  *sad;\n   147\n   148      PROCNAME(\"pixProcessBarcodes\");\n   149\n   150      if (psaw) *psaw = NULL;\n   151      if (!pixs)\n   152          return (SARRAY *)ERROR_PTR(\"pixs not defined\", procName, NULL);\n   153      if (format != L_BF_ANY && !barcodeFormatIsSupported(format))\n   154          return (SARRAY *)ERROR_PTR(\"unsupported format\", procName, NULL);\n   155      if (method != L_USE_WIDTHS && method != L_USE_WINDOWS)\n   156          return (SARRAY *)ERROR_PTR(\"invalid method\", procName, NULL);\n   157\n   158          /* Get an 8 bpp image, no cmap */\n   159      if (pixGetDepth(pixs) == 8 && !pixGetColormap(pixs))\n   160          pixg = pixClone(pixs);\n   161      else\n   162          pixg = pixConvertTo8(pixs, 0);\n   163\n   164      if ((pixa = pixExtractBarcodes(pixg, debugflag)) == NULL) {\n   165          pixDestroy(&pixg);\n   166          return (SARRAY *)ERROR_PTR(\"no barcode(s) found\", procName, NULL);\n   167      }\n   168\n   169      sad = pixReadBarcodes(pixa, format, method, psaw, debugflag);\n   170\n   171      pixDestroy(&pixg);\n   172      pixaDestroy(&pixa);\n   173      return sad;\n   174  }\n   175\n   176\n   177  /*!\n   178   * \\brief   pixExtractBarcodes()\n   179   *\n   180   * \\param[in]    pixs        8 bpp, no colormap\n   181   * \\param[in]    debugflag   use 1 to generate debug output\n   182   * \\return  pixa  deskewed and cropped barcodes, or NULL if none found\n   183   *                or on error\n   184   */\n   185  PIXA *\n   186  pixExtractBarcodes(PIX     *pixs,\n   187                     l_int32  debugflag)\n   188  {\n   189  l_int32    i, n;\n   190  l_float32  angle, conf;\n   191  BOX       *box;\n   192  BOXA      *boxa;\n   193  PIX       *pixb, *pixm, *pixt;\n   194  PIXA      *pixa;\n   195\n   196      PROCNAME(\"pixExtractBarcodes\");\n   197\n   198      if (!pixs || pixGetDepth(pixs) != 8 || pixGetColormap(pixs))\n   199          return (PIXA *)ERROR_PTR(\"pixs undefined or not 8 bpp\", procName, NULL);\n   200\n   201          /* Locate them; use small threshold for edges. */\n   202      boxa = pixLocateBarcodes(pixs, 20, &pixb, &pixm);\n   203      n = boxaGetCount(boxa);\n   204      L_INFO(\"%d possible barcode(s) found\\n\", procName, n);\n   205      if (n == 0) {\n   206          boxaDestroy(&boxa);\n   207          pixDestroy(&pixb);\n   208          pixDestroy(&pixm);\n   209          return NULL;\n   210      }\n   211\n   212      if (debugflag) {\n   213          boxaWriteStderr(boxa);\n   214          pixDisplay(pixb, 100, 100);\n   215          pixDisplay(pixm, 800, 100);\n   216      }\n   217\n   218          /* Deskew each barcode individually */\n   219      pixa = pixaCreate(n);\n   220      for (i = 0; i < n; i++) {\n   221          box = boxaGetBox(boxa, i, L_CLONE);\n   222          pixt = pixDeskewBarcode(pixs, pixb, box, 15, 20, &angle, &conf);\n   223          L_INFO(\"angle = %6.2f, conf = %6.2f\\n\", procName, angle, conf);\n   224          if (conf > 5.0) {\n   225              pixaAddPix(pixa, pixt, L_INSERT);\n   226              pixaAddBox(pixa, box, L_INSERT);\n   227          } else {\n   228              pixDestroy(&pixt);\n   229              boxDestroy(&box);\n   230          }\n   231      }\n   232\n   233  #if  DEBUG_DESKEW\n   234      pixt = pixaDisplayTiledInRows(pixa, 8, 1000, 1.0, 0, 30, 2);\n   235      pixWrite(\"junkpixt\", pixt, IFF_PNG);\n   236      pixDestroy(&pixt);\n   237  #endif  /* DEBUG_DESKEW */\n   238\n   239      pixDestroy(&pixb);\n   240      pixDestroy(&pixm);\n   241      boxaDestroy(&boxa);\n   242      return pixa;\n   243  }\n   244\n   245\n   246  /*!\n   247   * \\brief   pixReadBarcodes()\n   248   *\n   249   * \\param[in]    pixa        of 8 bpp deskewed and cropped barcodes\n   250   * \\param[in]    format      L_BF_ANY, L_BF_CODEI2OF5, L_BF_CODE93, ...\n   251   * \\param[in]    method      L_USE_WIDTHS, L_USE_WINDOWS;\n   252   * \\param[out]   psaw        [optional] sarray of bar widths\n   253   * \\param[in]    debugflag   use 1 to generate debug output\n   254   * \\return  sa   sarray of widths, one string for each barcode found,\n   255   *               or NULL on error\n   256   