          barcode orientation.\n   444   *      (2) If there is skew, the mask will not cover the barcode corners.\n   445   * </pre>\n   446   */\n   447  static PIX *\n   448  pixGenerateBarcodeMask(PIX     *pixs,\n   449                         l_int32  maxspace,\n   450                         l_int32  nwidth,\n   451                         l_int32  nheight)\n   452  {\n   453  PIX  *pixt1, *pixt2, *pixd;\n   454\n   455      PROCNAME(\"pixGenerateBarcodeMask\");\n   456\n   457      if (!pixs || pixGetDepth(pixs) != 1)\n   458          return (PIX *)ERROR_PTR(\"pixs not defined\", procName, NULL);\n   459\n   460          /* Identify horizontal barcodes */\n   461      pixt1 = pixCloseBrick(NULL, pixs, maxspace + 1, 1);\n   462      pixt2 = pixOpenBrick(NULL, pixs, maxspace + 1, 1);\n   463      pixXor(pixt2, pixt2, pixt1);\n   464      pixOpenBrick(pixt2, pixt2, nwidth, nheight);\n   465      pixDestroy(&pixt1);\n   466\n   467          /* Identify vertical barcodes */\n   468      pixt1 = pixCloseBrick(NULL, pixs, 1, maxspace + 1);\n   469      pixd = pixOpenBrick(NULL, pixs, 1, maxspace + 1);\n   470      pixXor(pixd, pixd, pixt1);\n   471      pixOpenBrick(pixd, pixd, nheight, nwidth);\n   472      pixDestroy(&pixt1);\n   473\n   474          /* Combine to get all barcodes */\n   475      pixOr(pixd, pixd, pixt2);\n   476      pixDestroy(&pixt2);\n   477\n   478      return pixd;\n   479  }\n   480\n   481\n   482  /*------------------------------------------------------------------------*\n   483   *                        Extract and deskew barcode                      *\n   484   *------------------------------------------------------------------------*/\n   485  /*!\n   486   * \\brief   pixDeskewBarcode()\n   487   *\n   488   * \\param[in]    pixs        input image; 8 bpp\n   489   * \\param[in]    pixb        binarized edge-filtered input image\n   490   * \\param[in]    box         identified region containing barcode\n   491   * \\param[in]    margin      of extra pixels around box to extract\n   492   * \\param[in]    threshold   for binarization; ~20\n   493   * \\param[out]   pangle      [optional] in degrees, clockwise is positive\n   494   * \\param[out]   pconf       [optional] confidence\n   495   * \\return  pixd   deskewed barcode, or NULL on error\n   496   *\n   497   * <pre>\n   498   * Notes:\n   499   *     (1) The (optional) angle returned is the angle in degrees (cw positive)\n   500   *         necessary to rotate the image so that it is deskewed.\n   501   * </pre>\n   502   */\n   503  PIX *\n   504  pixDeskewBarcode(PIX        *pixs,\n   505                   PIX        *pixb,\n   506                   BOX        *box,\n   507                   l_int32     margin,\n   508                   l_int32     threshold,\n   509                   l_float32  *pangle,\n   510                   l_float32  *pconf)\n   511  {\n   512  l_int32    x, y, w, h, n;\n   513  l_float32  angle, angle1, angle2, conf, conf1, conf2, score1, score2, deg2rad;\n   514  BOX       *boxe, *boxt;\n   515  BOXA      *boxa, *boxat;\n   516  PIX       *pixt1, *pixt2, *pixt3, *pixt4, *pixt5, *pixt6, *pixd;\n   517\n   518      PROCNAME(\"pixDeskewBarcode\");\n   519\n   520      if (!pixs || pixGetDepth(pixs) != 8)\n   521          return (PIX *)ERROR_PTR(\"pixs undefined or not 8 bpp\", procName, NULL);\n   522      if (!pixb || pixGetDepth(pixb) != 1)\n   523          return (PIX *)ERROR_PTR(\"pixb undefined or not 1 bpp\", procName, NULL);\n   524      if (!box)\n   525          return (PIX *)ERROR_PTR(\"box not defined or 1 bpp\", procName, NULL);\n   526\n   527          /* Clip out */\n   528      deg2rad = 3.1415926535 / 180.;\n   529      boxGetGeometry(box, &x, &y, &w, &h);\n   530      boxe = boxCreate(x - 25, y - 25, w + 51, h + 51);\n   531      pixt1 = pixClipRectangle(pixb, boxe, NULL);\n   532      pixt2 = pixClipRectangle(pixs, boxe, NULL);\n   533      boxDestroy(&boxe);\n   534\n   535          /* Deskew,