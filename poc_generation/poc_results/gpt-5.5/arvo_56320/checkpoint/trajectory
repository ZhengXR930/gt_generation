ex to be assigned to this face\n   152      unsigned int iMaterial;\n   153\n   154      //! Index of the face. It is not specified whether it is\n   155      //! a requirement of the file format that all faces are\n   156      //! written in sequential order, so we have to expect this case\n   157      unsigned int iFace;\n   158  };\n   159\n   160  // ---------------------------------------------------------------------------\n   161  /** Helper structure to represent an ASE file bone */\n   162  struct Bone {\n   163      //! Constructor\n   164      Bone() = delete;\n   165\n   166      //! Construction from an existing name\n   167      explicit Bone(const std::string &name) :\n   168              mName(name) {\n   169          // empty\n   170      }\n   171\n   172      //! Name of the bone\n   173      std::string mName;\n   174  };\n   175\n   176  // ---------------------------------------------------------------------------\n   177  /** Helper structure to represent an ASE file bone vertex */\n   178  struct BoneVertex {\n   179      //! Bone and corresponding vertex weight.\n   180      //! -1 for unrequired bones ....\n   181      std::vector<std::pair<int, float>> mBoneWeights;\n   182  };\n   183\n   184  // ---------------------------------------------------------------------------\n   185  /** Helper structure to represent an ASE file animation */\n   186  struct Animation {\n   187      enum Type {\n   188          TRACK = 0x0,\n   189          BEZIER = 0x1,\n   190          TCB = 0x2\n   191      } mRotationType,\n   192              mScalingType, mPositionType;\n   193\n   194      Animation() AI_NO_EXCEPT\n   195              : mRotationType(TRACK),\n   196                mScalingType(TRACK),\n   197                mPositionType(TRACK) {\n   198          // empty\n   199      }\n   200\n   201      //! List of track rotation keyframes\n   202      std::vector<aiQuatKey> akeyRotations;\n   203\n   204      //! List of track position keyframes\n 