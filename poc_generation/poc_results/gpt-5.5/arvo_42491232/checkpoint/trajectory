ilters[i];\n   584      }\n   585    }\n   586    return BLOSC_NOFILTER;\n   587  }\n   588\n   589\n   590  int last_filter(const uint8_t* filters, char cmode) {\n   591    int last_index = -1;\n   592    for (int i = BLOSC2_MAX_FILTERS - 1; i >= 0; i--) {\n   593      if (!do_nothing(filters[i], cmode))  {\n   594        last_index = i;\n   595      }\n   596    }\n   597    return last_index;\n   598  }\n   599\n   600\n   601  uint8_t* pipeline_c(struct thread_context* thread_context, const int32_t bsize,\n   602                      const uint8_t* src, const int32_t offset,\n   603                      uint8_t* dest, uint8_t* tmp, uint8_t* tmp2) {\n   604    blosc2_context* context = thread_context->parent_context;\n   605    uint8_t* _src = (uint8_t*)src + offset;\n   606    uint8_t* _tmp = tmp;\n   607    uint8_t* _dest = dest;\n   608    int32_t typesize = context->typesize;\n   609    uint8_t* filters = context->filters;\n   610    uint8_t* filters_meta = context->filters_meta;\n   611    bool memcpyed = context->header_flags & (uint8_t)BLOSC_MEMCPYED;\n   612\n   613    /* Prefilter function */\n   614    if (context->prefilter != NULL) {\n   615      // Create new prefilter parameters for this block (must be private for each thread)\n   616      blosc2_prefilter_params pparams;\n   617      memcpy(&pparams, context->pparams, sizeof(pparams));\n   618      pparams.out = _dest;\n   619      pparams.out_size = (size_t)bsize;\n   620      pparams.out_typesize = typesize;\n   621      pparams.out_offset = offset;\n   622      pparams.tid = thread_context->tid;\n   623      pparams.ttmp = thread_context->tmp;\n   624      pparams.ttmp_nbytes = thread_context->tmp_nbytes;\n   625      pparams.ctx = context;\n   626\n   627      if (context->prefilter(&pparams) != 0) {\n   628        BLOSC_TRACE_ERROR(\"Execution of prefilter function failed\");\n   629        return NULL;\n   630      }\n   631\n   632      if (memcpyed) {\n   633        // No more filters are required\n   634        return _dest;\n   635      }\n   636      // Cycle buffers\n   637      _src = _dest;\n   638      _dest = _tmp;\n   639      _tmp = _src;\n   640    }\n   641\n   642    /* Process the filter pipeline */\n   643    for (int i = 0; i < BLOSC2_MAX_FILTERS; i++) {\n   644      switch (filters[i]) {\n   645        case BLOSC_SHUFFLE:\n   646          for (int j = 0; j <= filters_meta[i]; j++) {\n   647            shuffle(typesize, bsize, _src, _dest);\n   648            // Cycle filters when required\n   649            if (j < filters_meta[i]) {\n   650              _src = _dest;\n   651              _dest = _tmp;\n   652              _tmp = _src;\n   653            }\n   654          }\n   655          break;\n   656        case BLOSC_BITSHUFFLE:\n   657          bitshuffle(typesize, bsize, _src, _dest, tmp2);\n   658          break;\n   659        case BLOSC_DELTA:\n   660          delta_encoder(src, offset, bsize, typesize, _src, _dest);\n   661          break;\n   662        case BLOSC_TRUNC_PREC:\n   663          truncate_precision(filters_meta[i], typesize, bsize, _src, _dest);\n   664          break;\n   665        default:\n   666          if (filters[i] != BLOSC_NOFILTER) {\n   667            BLOSC_TRACE_ERROR(\"Filter %d not handled during compression\\n\", filters[i]);\n   668            return NULL;\n   669          }\n   670      }\n   671      // Cycle buffers when required\n   672      if (filters[i] != BLOSC_NOFILTER) {\n   673        _src = _dest;\n   674        _dest = _tmp;\n   675        _tmp = _src;\n   676      }\n   677    }\n   678    return _src;\n   679  }\n   680\n   681\n   682  // Optimized version for detecting runs.  It compares 8 bytes values wherever possible.\n   683  static bool get_run(const uint8_t* ip, const uint8_t* ip_bound) {\n   684    uint8_t x = *ip;\n   685    int64_t value, value2;\n   686    /* Broadcast the value for every byte in a 64-bit register */\n   687    memset(&value, x, 8);\n   688    while (ip < (ip_bound - 8)) {\n   689  #if defined(BLOSC_STRICT_ALIGN)\n   690      memcpy(&value2, ip, 8);\n   691  #else\n   692      value2 = *(int64_t*)ip;\n   693  #endif\n   694      if (value != value2) {\n   695        // Values differ.  We don't have a run.\n   696        return false;\n   697      }\n   698      else {\n   699        ip += 8;\n   700      }\n   701    }\n   702    /* Look into the remainder */\n   703    while ((ip < ip_bound) && (*ip == x)) ip++;\n   704    return ip == ip_bound ? true : false;\n   705  }\n   706\n   707\n   708  /* Shuffle & compress a single block */\n   709  static int blosc_c(struct thread_context* thread_context, int32_t bsize,\n   710                     int32_t leftoverblock, int32_t ntbytes, int32_t destsize,\n   711                     const uint8_t* src, const int32_t offset, uint8_t* dest,\n   712                     uint8_t* tmp, uint8_t* tmp2) {\n   713    blosc2_context* context = thread_context->parent_context;\n   714    int dont_split = (context->header_flags & 0x10) >> 4;\n   715    int dict_training = context->use_dict && context->dict_cdict == NULL;\n   716    int32_t j, neblock, nstreams;\n   717    int32_t cbytes;                   /* number of compressed bytes in split */\n   718    int32_t ctbytes = 0;              /* number of compressed bytes in block */\n   719    int64_t maxout;\n   720    int32_t typesize = context->typesize;\n   721    const char* compname;\n   722    int accel;\n   723    const uint8_t* _src;\n   724    uint8_t *_tmp = tmp, *_tmp2 = tmp2;\n   725    uint8_t *_tmp3 = thread_context->tmp4;\n   726    int last_filter_index = last_filter(context->filters, 'c');\n   727    bool memcpyed = context->header_flags & (uint8_t)BLOSC_MEMCPYED;\n   728\n   729    if (last_filter_index >= 0 || context->prefilter != NULL) {\n   730      /* Apply the filter pipeline just for the prefilter */\n   731      if (memcpyed && context->prefilter != NULL) {\n   732        // We only need the prefilter output\n   733        _src = pipeline_c(thread_context, bsize, src, offset, dest, _tmp2, _tmp3);\n   734\n   735        if (_src == NULL) {\n   736          return -9;  // signals a problem with the filter pipeline\n   737        }\n   738        return bsize;\n   739      }\n   740      /* Apply regular filter pipeline */\n   741      _src = pipeline_c(thread_context, bsize, src, offset, _tmp, _tmp2, _tmp3);\n   742\n   743      if (_src == NULL) {\n   744        return -9;  // signals a problem with the filter pipeline\n   745      }\n   746    } else {\n   747      _src = src + offset;\n   748    }\n   749\n   750    assert(context->clevel > 0);\n   751\n   752    /* Calculate acceleration for different compressors */\n   753    accel = get_accel(context);\n   754\n   755    /* The number of compressed data streams for this block */\n   756    if (!dont_split && !leftoverblock && !dict_training) {\n   757      nstreams = (int32_t)typesize;\n   758    }\n   759    else {\n   760      nstreams = 1;\n   761    }\n   762    neblock = bsize / nstreams;\n   763    for (j = 0; j < nstreams; j++) {\n   764      if (!dict_training) {\n   765        dest += sizeof(int32_t);\n   766        ntbytes += sizeof(int32_t);\n   767        ctbytes += sizeof(int32_t);\n   768\n   769        // See whether we have a run here\n   770        const uint8_t* ip = (uint8_t*)_src + j * neblock;\n   771        const uint8_t* ipbound = (uint8_t*)_src + (j + 1) * neblock;\n   772        if (get_run(ip, ipbound)) {\n   773          // A run\n   774          int32_t value = _src[j * neblock];\n   775          if (ntbytes > destsize) {\n   776            /* Not enough space to write out compressed block size */\n   777            return -1;\n   778          }\n   779          // Encode the repeated byte in the first (LSB) byte of the length of the split.\n   780          _sw32(dest - 4, -value);    // write the value in two's complement\n   781          if (value > 0) {\n   782            // Mark the encoding as a run-length (== 0 is always a 0's run)\n   783            ntbytes += 1;\n   784            ctbytes += 1;\n   785            if (ntbytes > destsize) {\n   786              /* Not enough space to write out compressed block size */\n   787              return -1;\n   788            }\n   789            // Set MSB bit (sign) to 1 (not really necessary here, but for demonstration purposes)\n   790            // dest[-1] |= 0x80;\n   791            dest[0] = 0x1;   // set run-length bit (0) in token\n   792            dest += 1;\n   793          }\n   794          continue;\n   795        }\n   796      }\n   797\n   798      maxout = neblock;\n   799    #if defined(HAVE_SNAPPY)\n   800      if (context->compcode == BLOSC_SNAPPY) {\n   801        maxout = (int32_t)snappy_max_compressed_length((size_t)neblock);\n   802      }\n   803    #endif /*  HAVE_SNAPPY */\n   804      if (ntbytes + maxout > destsize) {\n   805        /* avoid buffer * overrun */\n   806        maxout = (int64_t)destsize - (int64_t)ntbytes;\n   807        if (maxout <= 0) {\n   808          return 0;                  /* non-compressible block */\n   809        }\n   810      }\n   811      if (dict_training) {\n   812        // We are in the build dict state, so don't compress\n   813        // TODO: copy only a percentage for sampling\n   814        memcpy(dest, _src + j * neblock, (unsigned int)neblock);\n   815        cbytes = (int32_t)neblock;\n   816      }\n   817      else if (context->compcode == BLOSC_BLOSCLZ) {\n   818        cbytes = blosclz_compress(context->clevel, _src + j * neblock,\n   819                                  (int)neblock, dest, (int)maxout);\n   820      }\n   821    #if defined(HAVE_LZ4)\n   822      else if (context->compcode == BLOSC_LZ4) {\n   823        void *hash_table = NULL;\n   824      #ifdef HAVE_IPP\n   825        hash_table = (void*)thread_context->lz4_hash_table;\n   826      #endif\n   827        cbytes = lz4_wrap_compress((char*)_src + j * neblock, (size_t)neblock,\n   828                                   (char*)dest, (size_t)maxout, accel, hash_table);\n   829      }\n   830      else if (context->compcode == BLOSC_LZ4HC) {\n   831        cbytes = lz4hc_wrap_compress((char*)_src + j * neblock, (size_t)neblock,\n   832                                     (char*)dest, (size_t)maxout, context->clevel);\n   833      }\n   834    #endif /* HAVE_LZ4 */\n   835    #if defined(HAVE_LIZARD)\n   836      else if (context->compcode == BLOSC_LIZARD) {\n   837        cbytes = lizard_wrap_compress((char*)_src + j * neblock, (size_t)neblock,\n   838                                      (char*)dest, (size_t)maxout, accel);\n   839      }\n   840    #endif /* HAVE_LIZARD */\n   841    #if defined(HAVE_SNAPPY)\n   842      else if (context->compcode == BLOSC_SNAPPY) {\n   843        cbytes = snappy_wrap_compress((char*)_src + j * neblock, (size_t)neblock,\n   844                                      (char*)dest, (size_t)maxout);\n   845      }\n   846    #endif /* HAVE_SNAPPY */\n   847    #if defined(HAVE_ZLIB)\n   848      else if (context->compcode == BLOSC_ZLIB) {\n   849        cbytes = zlib_wrap_compress((char*)_src + j * neblock, (size_t)neblock,\n   850                                    (char*)dest, (size_t)maxout, context->clevel);\n   851      }\n   852    #endif /* HAVE_ZLIB */\n   853    #if defined(HAVE_ZSTD)\n   854      else if (context->compcode == BLOSC_ZSTD) {\n   855        cbytes = zstd_wrap_compress(thread_context,\n   856                                    (char*)_src + j * neblock, (size_t)neblock,\n   857                                    (char*)dest, (size_t)maxout, context->clevel);\n   858      }\n   859    #endif /* HAVE_ZSTD */\n   860\n   861      else {\n   862        blosc_compcode_to_compname(context->compcode, &compname);\n   863        BLOSC_TRACE_ERROR(\"Blosc has not been compiled with '%s' compression support.\"\n   864                          \"Please use one having it.\", compname);\n   865        return -5;    /* signals no compression support */\n   866      }\n   867\n   868      if (cbytes > maxout) {\n   869        /* Buffer overrun caused by compression (should never happen) */\n   870        return -1;\n   871      }\n   872      if (cbytes < 0) {\n   873        /* cbytes should never be negative */\n   874        return -2;\n   875      }\n   876      if (!dict_training) {\n   877        if (cbytes == 0 || cbytes == neblock) {\n   878          /* The compressor has been unable to compress data at all. */\n   879          /* Before doing the copy, check that we are not running into a\n   880             buffer overflow. */\n   881          if ((ntbytes + neblock) > destsize) {\n   882            return 0;    /* Non-compressible data */\n   883          }\n   884          memcpy(dest, _src + j * neblock, (unsigned int)neblock);\n   885          cbytes = neblock;\n   886        }\n   887        _sw32(dest - 4, cbytes);\n   888      }\n   889      dest += cbytes;\n   890      ntbytes += cbytes;\n   891      ctbytes += cbytes;\n   892    }  /* Closes j < nstreams */\n   893\n   894    //printf(\"c%d\", ctbytes);\n   895    return ctbytes;\n   896  }\n   897\n   898\n   899  /* Process the filter pipeline (decompression mode) */\n   900  int pipeline_d(blosc2_context* context, const int32_t bsize, uint8_t* dest,\n   900  int pipeline_d(blosc2_context* context, const int32_t bsize, uint8_t* dest,\n   901                 const int32_t offset, uint8_t* src, uint8_t* tmp,\n   902                 uint8_t* tmp2, int last_filter_index) {\n   903    int32_t typesize = context->typesize;\n   904    uint8_t* filters = context->filters;\n   905    uint8_t* filters_meta = context->filters_meta;\n   906    uint8_t* _src = src;\n   907    uint8_t* _dest = tmp;\n   908    uint8_t* _tmp = tmp2;\n   909    int errcode = 0;\n   910\n   911    for (int i = BLOSC2_MAX_FILTERS - 1; i >= 0; i--) {\n   912      // Delta filter requires the whole chunk ready\n   913      int last_copy_filter = (last_filter_index == i) || (next_filter(filters, i, 'd') == BLOSC_DELTA);\n   914      if (last_copy_filter) {\n   915        _dest = dest + offset;\n   916      }\n   917      switch (filters[i]) {\n   918        case BLOSC_SHUFFLE:\n   919          for (int j = 0; j <= filters_meta[i]; j++) {\n   920            unshuffle(typesize, bsize, _src, _dest);\n   921            // Cycle filters when required\n   922            if (j < filters_meta[i]) {\n   923              _src = _dest;\n   924              _dest = _tmp;\n   925              _tmp = _src;\n   926            }\n   927            // Check whether we have to copy the intermediate _dest buffer to final destination\n   928            if (last_copy_filter && (filters_meta[i] % 2) == 1 && j == filters_meta[i]) {\n   929              memcpy(dest + offset, _dest, (unsigned int)bsize);\n   930            }\n   931          }\n   932          break;\n   933        case BLOSC_BITSHUFFLE:\n   934          bitunshuffle(typesize, bsize, _src, _dest, _tmp, context->src[BLOSC2_CHUNK_VERSION]);\n   935          break;\n   936        case BLOSC_DELTA:\n   937          if (context->nthreads == 1) {\n   938            /* Serial mode */\n   939            delta_decoder(dest, offset, bsize, typesize, _dest);\n   940          } else {\n   941            /* Force the thread in charge of the block 0 to go first */\n   942            pthread_mutex_lock(&context->delta_mutex);\n   943            if (context->dref_not_init) {\n   944              if (offset != 0) {\n   945                pthread_cond_wait(&context->delta_cv, &context->delta_mutex);\n   946              } else {\n   947                delta_decoder(dest, offset, bsize, typesize, _dest);\n   948                context->dref_not_init = 0;\n   949                pthread_cond_broadcast(&context->delta_cv);\n   950              }\n   951            }\n   952            pthread_mutex_unlock(&context->delta_mutex);\n   953          