    },
    {
      "file": "src/server/ua_securechannel_manager.c",
      "function": "removeSecureChannel",
      "line": null,
      "code": "UA_WorkQueue_enqueueDelayed(&cm->server->workQueue, &entry->cleanupCallback)",
      "note": "Defers ALL channel cleanup — including setting channel state to CLOSED, detaching the connection, and unlinking sessions — to a delayed callback. The fix calls UA_SecureChannel_close() immediately here (which sets state=CLOSED, detaches connection, unlinks sessions) and defers only UA_SecureChannel_deleteMembers(). Without the synchronous close, the work queue inherits a dangling callback whose host allocation (channel_entry) is freed during shutdown processing and then re-read.",
      "kind": "root_cause_function"
    },
    {
      "file": "src/server/ua_securechannel_manager.c",
      "function": "removeSecureChannel",
