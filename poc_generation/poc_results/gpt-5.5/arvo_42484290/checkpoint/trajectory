onnect is not received yet */\n   405      break; /* loop */\n   406    default:\n   407\n   408      if(result & CURL_CSELECT_IN2) {\n   409        infof(data, \"Ready to accept data connection from server\\n\");\n   410        *received = TRUE;\n   411      }\n   412      else if(result & CURL_CSELECT_IN) {\n   413        infof(data, \"Ctrl conn has data while waiting for data conn\\n\");\n   414        (void)Curl_GetFTPResponse(&nread, conn, &ftpcode);\n   415\n   416        if(ftpcode/100 > 3)\n   417          return CURLE_FTP_ACCEPT_FAILED;\n   418\n   419        return CURLE_WEIRD_SERVER_REPLY;\n   420      }\n   421\n   422      break;\n   423    } /* switch() */\n   424\n   425    return CURLE_OK;\n   426  }\n   427\n   428\n   429  /***********************************************************************\n   430   *\n   431   * InitiateTransfer()\n   432   *\n   433   * After connection from server is accepted this function is called to\n   434   * setup transfer parameters and initiate the data transfer.\n   435   *\n   436   */\n   437  static CURLcode InitiateTransfer(struct connectdata *conn)\n   438  {\n   439    struct Curl_easy *data = conn->data;\n   440    CURLcode result = CURLE_OK;\n   441\n   442    if(conn->bits.ftp_use_data_ssl) {\n   443      /* since we only have a plaintext TCP connection here, we must now\n   444       * do the TLS stuff */\n   445      infof(data, \"Doing the SSL/TLS handshake on the data stream\\n\");\n   446      result = Curl_ssl_connect(conn, SECONDARYSOCKET);\n   447      if(result)\n   448        return result;\n   449    }\n   450\n   451    if(conn->proto.ftpc.state_saved == FTP_STOR) {\n   452      /* When we know we're uploading a specified file, we can get the file\n   453         size prior to the actual upload. */\n   454      Curl_pgrsSetUploadSize(data, data->state.infilesize);\n   455\n   456      /* set the SO_SNDBUF for the secondary socket for those who need it */\n   457      Curl_sndbufset(conn->sock[S