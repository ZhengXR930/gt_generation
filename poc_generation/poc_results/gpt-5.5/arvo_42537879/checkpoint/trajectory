             break;\n   574  #ifdef ZODIAC_ENABLE\n   575          case 0xff:      // lattin1 smal y with diaeresis\n   576              lexer->state = ZODIAC_LEADER_1;\n   577              break;\n   578  #endif  // ZODIAC_ENABLE\n   579          default:\n   580              if (ISGPS_SYNC == (isgpsstat = rtcm2_decode(lexer, c))) {\n   581                  lexer->state = RTCM2_SYNC_STATE;\n   582              } else if (ISGPS_MESSAGE == isgpsstat) {\n   583                  lexer->state = RTCM2_RECOGNIZED;\n   584              }\n   585              break;\n   586          }\n   587          break;\n   588      case COMMENT_BODY:\n   589          if ('\\n' == c) {\n   590              lexer->state = COMMENT_RECOGNIZED;\n   591          } else if (!isprint(c)) {\n   592              return character_pushback(lexer, GROUND_STATE);\n   593          }\n   594          break;\n   595      case NMEA_DOLLAR:\n   596          // We have the leading $\n   597          switch (c) {\n   598          case 'A':\n   599              /* $A (SiRF Ack), $AI (Mobile Class A or B AIS Station?), or\n   600               * $AP (autopliot) */\n   601              lexer->state = NMEA_LEAD_A;\n   602              break;\n   603          case 'B':           // $BD\n   604              lexer->state = BEIDOU_LEAD_1;\n   605              break;\n   606          case 'E':           // $E, ECDIS\n   607              // codacy thinks this is impossible\n   608              lexer->state = ECDIS_LEAD_1;\n   609              break;\n   610          case 'G':           // $GP, $GN, $GY, etc.\n   611              lexer->state = NMEA_PUB_LEAD;\n   612              break;\n   613          case 'H':           // $H, Heading/compass. gyro\n   614              lexer->state = HEADCOMP_LEAD_1;\n   615              break;\n   616          case 'I':           // $I, Seatalk\n   617              lexer->state = SEATALK_LEAD_1;\n   618              break;\n   619          case 'P':           // $P, vendor sentence\n   620              lexer->state = NMEA_VENDOR_LEAD;\n   620              lexer->state = NMEA_VENDOR_LEAD;\n   621              break;\n   622          case 'Q':          // $QZ\n   623              lexer->state = QZSS_LEAD_1;\n   624              break;\n   625          case 'S':          // $S\n   626              // $SD, $SN, $ST\n   627              lexer->state = SOUNDER_LEAD_1;\n   628              break;\n   629          case 'T':           // $T, Turn indicator\n   630              lexer->state = TURN_LEAD_1;\n   631              break;\n   632          case 'W':           // $W, Weather instrument\n   633              lexer->state = WEATHER_LEAD_1;\n   634              break;\n   635          case 'Y':           // $Y\n   636              lexer->state = TRANSDUCER_LEAD_1;\n   637              break;\n   638          default:\n   639              (void)character_pushback(lexer, GROUND_STATE);\n   640              break;\n   641          }\n   642          break;\n   643      case NMEA_PUB_LEAD:\n   644          /*\n   645           * $GP == GPS, $GL = GLONASS only, $GN = mixed GPS and GLONASS,\n   646           * according to NMEA (IEIC 61162-1) DRAFT 02/06/2009.\n   647           * We have a log from China with a BeiDou device using $GB\n   648           * rather than $BD.\n   649           *\n   650           * Unicore uses the non-standard $GY for IMU data.\n   651           */\n   652          if ('A' == c ||      // $GA, Galileo only\n   653              'B' == c ||      // $GB, BeiDou only\n   654              'L' == c ||      // $GL, GLONASS only\n   655              'N' == c ||      // $GN, mixed\n   656              'P' == c ||      // $GP, GPS\n   657              'Y' == c) {      // $GY, Gyro  (IMU)\n   658              lexer->state = NMEA_LEADER_END;\n   659          } else {\n   660              (void)character_pushback(lexer, GROUND_STATE);\n   661          }\n   662          break;\n   663      case NMEA_VENDOR_LEAD:\n   664          if (