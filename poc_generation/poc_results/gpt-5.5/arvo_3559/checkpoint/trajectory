ADDMAX = 0x20\n\nwith open(sys.argv[1], \"r+b\") as f:\n  map = mmap.mmap(f.fileno(), 0)\n  for index, char in enumerate(map):\n    if ord(char) < CAP:\n      map[index] = chr(ord(char) + randint(0, RANDADDMAX))\n  map.close()\n--- repo-vul/src-vul/honggfuzz/examples/externalfuzzers/o20.sh\n#!/bin/sh\necho \"running $@\"\ncat $1 | sed -e s/o/0/g > /tmp/f\nmv /tmp/f $1\n--- repo-vul/src-vul/honggfuzz/examples/externalfuzzers/rangeFuzz.py\n#!/usr/bin/env python\n\nimport mmap\nimport os\nfrom random import randint\nimport sys\n\nRANGE_START = 0x1b30\nRANGE_END   = 0x1b50\nMIN_BYTES_TO_FLIP = 1\nMAX_BYTES_TO_FLIP = 5\n\nwith open(sys.argv[1], \"r+b\") as f:\n  mapped = mmap.mmap(f.fileno(), 0)\n\n  bytes_to_flip = randint(MIN_BYTES_TO_FLIP, MAX_BYTES_TO_FLIP)\n  bytes_flipped = 0\n\n  while bytes_flipped < bytes_to_flip:\n    byte_pos = randint(RANGE_START, RANGE_END)\n    byte_new = chr(randint(0, 255))\n    mapped[byte_pos] = byte_new\n    bytes_flipped += 1\n\n  mapped.close()\n--- repo-vul/src-vul/honggfuzz/examples/libjpeg/persistent-jpeg.c\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n#include <fcntl.h>\n#include <setjmp.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <sys/stat.h>\n#include <sys/types.h>\n#include <unistd.h>\n\n#include <libhfuzz.h>\n\n#include \"cderror.h\"\n#include \"jpeglib.h\"\n\nstruct jpeg_decompress_struct cinfo;\nint null_fd = -1;\n\nstruct jpegErrorManager {\n    struct jpeg_error_mgr pub;\n    jmp_buf setjmp_buffer;\n};\n\nstruct jpegErrorManager jerr;\n\nvoid jpegErrorExit(j_common_ptr cinfo)\n{\n    struct jpegErrorManager* myerr = (struct jpegErrorManager*)cinfo->err;\n    longjmp(myerr->setjmp_buffer, 1);\n}\n\nstatic const char* const cdjpeg_message_table[] = {\n#include \"cderror.h\"\n    NULL\n};\n\nint LLVMFuzzerInitialize(int* argc, char*** argv)\n{\n    null_fd = open(\"/dev/null\", O_WRONLY);\n\n    cinfo.err = jpeg_std_error(&jerr.pub);\n    jerr.pub.error_exit = jpegErrorExit;\n\n    jerr.pub.ad