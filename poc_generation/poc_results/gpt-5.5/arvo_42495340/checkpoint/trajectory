    "content": "236  // ------------------------------------------------------------------------------------------------\n   237  // Creates the meshes for the given node.\n   238  void XFileImporter::CreateMeshes( aiScene* pScene, aiNode* pNode, const std::vector<XFile::Mesh*>& pMeshes) {\n   239      if (pMeshes.empty()) {\n   240          return;\n   241      }\n   242\n   243      // create a mesh for each mesh-material combination in the source node\n   244      std::vector<aiMesh*> meshes;\n   245      for( unsigned int a = 0; a < pMeshes.size(); ++a ) {\n   246          XFile::Mesh* sourceMesh = pMeshes[a];\n   247          if ( nullptr == sourceMesh ) {\n   248              continue;\n   249          }\n   250\n   251          // first convert its materials so that we can find them with their index afterwards\n   252          ConvertMaterials( pScene, sourceMesh->mMaterials);\n   253\n   254          unsigned int numMaterials = std::max( (unsigned int)sourceMesh->mMaterials.size(), 1u);\n   255          for( unsigned int b = 0; b < numMaterials; ++b ) {\n   256              // collect the faces belonging to this material\n   257              std::vector<unsigned int> faces;\n   258              unsigned int numVertices = 0;\n   259              if( !sourceMesh->mFaceMaterials.empty() ) {\n   260                  // if there is a per-face material defined, select the faces with the corresponding material\n   261                  for( unsigned int c = 0; c < sourceMesh->mFaceMaterials.size(); ++c ) {\n   262                      if( sourceMesh->mFaceMaterials[c] == b) {\n   263                          faces.push_back( c);\n   264                          numVertices += (unsigned int)sourceMesh->mPosFaces[c].mIndices.size();\n   265                      }\n   266                  }\n   267              } else {\n   268                  // if there is no per-face material, place everything into one mesh\n   269                  for( unsigned int c = 0; c < sourceMesh->mPosFaces.size(); ++c ) {\n   270                      faces.push_back( c);\n   271                      numVertices += (unsigned int)sourceMesh->mPosFaces[c].mIndices.size();\n   272                  }\n   273              }\n   274\n   275              // no faces/vertices using this material? strange...\n   276              if ( numVertices == 0 ) {\n   277                  continue;\n   278              }\n   279\n   280              // create a submesh using this material\n   281              aiMesh* mesh = new aiMesh;\n   282              meshes.push_back( mesh);\n   283\n   284              // find the material in the scene's material list. Either own material\n   285              // or referenced material, it should already have a valid index\n   286              if( !sourceMesh->mFaceMaterials.empty() ) {\n   287                  mesh->mMaterialIndex = static_cast<unsigned int>(sourceMesh->mMaterials[b].sceneIndex);\n   288              } else {\n   289                  mesh->mMaterialIndex = 0;\n   290              }\n   291\n   292              // Create properly sized data arrays in the mesh. We store unique vertices per face,\n   293              // as specified\n   294              mesh->mNumVertices = numVertices;\n   295              mesh->mVertices = new aiVector3D[numVertices];\n   296              mesh->mNumFaces = (unsigned int)faces.size();\n   297              mesh->mFaces = new aiFace[mesh->mNumFaces];\n   298\n   299              // name\n   300              mesh->mName.Set(sourceMesh->mName);\n   301\n   302              // normals?\n   303              if ( sourceMesh->mNormals.size() > 0 ) {\n   304                  mesh->mNormals = new aiVector3D[ numVertices ];\n   305              }\n   306              // texture coords\n   307              for( unsigned int c = 0; c < AI_MAX_NUMBER_OF_TEXTURECOORDS; ++c ) {\n   308                  if ( !sourceMesh->mTexCoords[ c ].empty() ) {\n   309                      mesh->mTextureCoords[ c ] = new aiVector3D[ numVertices ];\n   310                  }\n   311              }\n   312              // vertex colors\n   313              for( unsigned int c = 0; c < AI_MAX_NUMBER_OF_COLOR_SETS; ++c ) {\n   314                  if ( !sourceMesh->mColors[ c ].empty() ) {\n   315                      mesh->mColors[ c ] = new aiColor4D[ numVertices ];\n   316                  }\n   317              }\n   318\n   319              // now collect the vertex data of all data streams present in the imported mesh\n   320              unsigned int newIndex( 0 );\n   321              std::vector<unsigned int> orgPoints; // from which original point each new vertex stems\n   322              orgPoints.resize( numVertices, 0);\n   323\n   324              for( unsigned int c = 0; c < faces.size(); ++c ) {\n   325                  unsigned int f = faces[c]; // index of the source face\n   326                  const XFile::Face& pf = sourceMesh->mPosFaces[f]; // position source face\n   327\n   328                  // create face. either triangle or triangle fan depending on the index count\n   329                  aiFace& df = mesh->mFaces[c]; // destination face\n   330                  df.mNumIndices = (unsigned int)pf.mIndices.size();\n   331                  df.mIndices = new unsigned int[ df.mNumIndices];\n   332\n   333                  // collect vertex data for indices of this face\n   334                  for( unsigned int d = 0; d < df.mNumIndices; ++d ) {\n   335                      df.mIndices[ d ] = newIndex;\n   336                      const unsigned int newIdx( pf.mIndices[ d ] );\n   337                      if ( newIdx > sourceMesh->mPositions.size() ) {\n   338                          continue;\n   339                      }\n   340\n   341                      orgPoints[newIndex] = pf.mIndices[d];\n   342\n   343                      // Position\n   344                      mesh->mVertices[newIndex] = sourceMesh->mPositions[pf.mIndices[d]];\n   345                      // Normal, if present\n   346                      if ( mesh->HasNormals() ) {\n   347                          if ( sourceMesh->mNormFaces[ f ].mIndices.size() > d ) {\n   348                              const size_t idx( sourceMesh->mNormFaces[ f ].mIndices[ d ] );\n   349                              mesh->mNormals[ newIndex ] = sourceMesh->mNormals[ idx ];\n   350                          }\n   351                      }\n   352\n   353                      // texture coord sets\n   354                      for( unsigned int e = 0; e < AI_MAX_NUMBER_OF_TEXTURECOORDS; ++e ) {\n   355                          if( mesh->HasTextureCoords( e)) {\n   356                              aiVector2D tex = sourceMesh->mTexCoords[e][pf.mIndices[d]];\n   357                              mesh->mTextureCoords[e][newIndex] = aiVector3D( tex.x, 1.0f - tex.y, 0.0f);\n   358                          }\n   359                      }\n   360                      // vertex color sets\n   361                      for ( unsigned int e = 0; e < AI_MAX_NUMBER_OF_COLOR_SETS; ++e ) {\n   362                          if ( mesh->HasVertexColors( e ) ) {\n   363                              mesh->mColors[ e ][ newIndex ] = sourceMesh->mColors[ e ][ pf.mIndices[ d ] ];\n   364                          }\n   365                      }\n   366\n   367                      newIndex++;\n   368                  }\n   369              }\n   370\n   371              // there should be as much new vertices as we calculated before\n   372              ai_assert( newIndex == numVertices);\n   373\n   374              // convert all bones of the source mesh which influence vertices in this newly created mesh\n   375              const std::vector<XFile::Bone>& bones = sourceMesh->mBones;\n   376              std::vector<aiBone*> newBones;\n   377              for( unsigned int c = 0; c < bones.size(); ++c ) {\n   378                  const XFile::Bone& obone = bones[c];\n   379                  // set up a vertex-linear array of the weights for quick searching if a bone influences a vertex\n   380                  std::vector<ai_real> oldWeights( sourceMesh->mPositions.size(), 0.0);\n   381                  for ( unsigned int d = 0; d < obone.mWeights.size(); ++d ) {\n   382                      oldWeights[ obone.mWeights[ d ].mVertex ] = obone.mWeights[ d ].mWeight;\n   383                  }\n   384\n   385                  // collect all vertex weights that influence a vertex in the new mesh\n   386                  std::vector<aiVertexWeight> newWeights;\n   387                  newWeights.reserve( numVertices);\n   388                  for( unsigned int d = 0; d < orgPoints.size(); ++d ) {\n   389                      // does the new vertex stem from an old vertex which was influenced by this bone?\n   390                      ai_real w = oldWeights[orgPoints[d]];\n   391                      if ( w > 0.0 ) {\n   392                          newWeights.push_back( aiVertexWeight( d, w ) );\n   393                      }\n   394                  }\n   395\n   396                  // if the bone has no weights in the newly created mesh, ignore it\n   397                  if ( newWeights.empty() ) {\n   398                      continue;\n   399                  }\n   400\n   401                  // create\n   402                  aiBone* nbone = new aiBone;\n   403                  newBones.push_back( nbone);\n   404                  // copy name and matrix\n   405                  nbone->mName.Set( obone.mName);\n   406                  nbone->mOffsetMatrix = obone.mOffsetMatrix;\n   407                  nbone->mNumWeights = (unsigned int)newWeights.size();\n   408                  nbone->mWeights = new aiVertexWeight[nbone->mNumWeights];\n   409                  for ( unsigned int d = 0; d < newWeights.size(); ++d ) {\n   410                      nbone->mWeights[ d ] = newWeights[ d ];\n   411                  }\n   412              }\n   413\n   414              // store the bones in the mesh\n   415              mesh->mNumBones = (unsigned int)newBones.size();\n   416              if( !newBones.empty()) {\n   417                  mesh->mBones = new aiBone*[mesh->mNumBones];\n   418                  std::copy( newBones.begin(), newBones.end(), mesh->mBones);\n   419              }\n   420          }\n   421      }\n   422\n   423      // reallocate scene mesh array to be large enough\n   424      aiMesh** prevArray = pScene->mMeshes;\n   425      pScene->mMeshes = new aiMesh*[pScene->mNumMeshes + meshes.size()];\n   426      if( prevArray) {\n   427          memcpy( pScene->mMeshes, prevArray, pScene->mNumMeshes * sizeof( aiMesh*));\n   428          delete [] prevArray;\n   429      }\n   430\n   431      // allocate mesh index array in the node\n   432      pNode->mNumMeshes = (unsigned int)meshes.size();\n   433      pNode->mMeshes = new unsigned int[pNode->mNumMeshes];\n   434\n   435      // store all meshes in the mesh library of the scene and store their indices in the node\n   436      for( unsigned int a = 0; a < meshes.size(); a++) {\n   437          pScene->mMeshes[pScene->mNumMeshes] = meshes[a];\n   438          pNode->mMeshes[a] = pScene->mNumMeshes;\n   439          pScene->mNumMeshes++;\n   440      }\n   441  }\n   442\n   443  // ------------------------------------------------------------------------------------------------\n   444  // Converts the animations from the given imported data and creates them in the scene.\n   445  void XFileImporter::CreateAnimations( aiScene* pScene, const XFile::Scene* pData) {\n   446      std::vector<aiAnimation*> newAnims;\n   447\n   448      for( unsigned int a = 0; a < pData->mAnims.size(); ++a ) {\n   449          const XFile::Animation* anim = pData->mAnims[a];\n   450          // some exporters mock me with empty animation tags.\n   451          if ( anim->mAnims.empty() ) {\n   452              continue;\n   453          }\n   454\n   455          // create a new animation to hold the data\n   456          aiAnimation* nanim = new aiAnimation;\n   457          newAnims.push_back( nanim);\n   458          nanim->mName.Set( anim->mName);\n   459          // duration will be determined by the maximum length\n   460          nanim->mDuration = 0;\n   461          nanim->mTicksPerSecond = pData->mAnimTicksPerSecond;\n   462          nanim->mNumChannels = (unsigned int)anim->mAnims.size();\n   463          nanim->mChannels = new aiNodeAnim*[nanim->mNumChannels];\n   464\n   465          for( unsigned int b = 0; b < anim->mAnims.size(); ++b ) {\n   466              const XFile::AnimBone* bone = anim->mAnims[b];\n   467              aiNodeAnim* nbone = new aiNodeAnim;\n   468              nbone->mNodeName.Set( bone->mBoneName);\n   469              nanim->mChannels[b] = nbone;\n   470\n   471              // key-frames are given as combined transformation matrix keys\n   472              if( !bone->mTrafoKeys.empty() )\n   473              {\n   474                  nbone->mNumPositionKeys = (unsigned int)bone->mTrafoKeys.size();\n   475                  nbone->mPositionKeys = new aiVectorKey[nbone->mNumPositionKeys];\n   476                  nbone->mNumRotationKeys = (unsigned int)bone->mTrafoKeys.size();\n   477                  nbone->mRotationKeys = new aiQuatKey[nbone->mNumRotationKeys];\n   478                  nbone->mNumScalingKeys = (unsigned int)bone->mTrafoKeys.size();\n   479                  nbone->mScalingKeys = new aiVectorKey[nbone->mNumScalingKeys];\n   480\n   481                  for( unsigned int c = 0; c < bone->mTrafoKeys.size(); ++c)  {\n   482                      // deconstruct each matrix into separate position, rotation and scaling\n   483                      double time = bone->mTrafoKeys[c].mTime;\n   484                      aiMatrix4x4 trafo = bone->mTrafoKeys[c].mMatrix;\n   485\n   486                      // extract position\n   487                      aiVector3D pos( trafo.a4, trafo.b4, trafo.c4);\n   488\n   489                      nbone->mPositionKeys[c].mTime = time;\n   490                      nbone->mPositionKeys[c].mValue = pos;\n   491\n   492                      // extract scaling\n   493                      aiVector3D scale;\n   494                      scale.x = aiVector3D( trafo.a1, trafo.b1, trafo.c1).Length();\n   495                      scale.y = aiVector3D( trafo.a2, trafo.b2, trafo.c2).Length();\n   496                      scale.z = aiVector3D( trafo.a3, trafo.b3, trafo.c3).Length();\n   497                      nbone->mScalingKeys[c].mTime = time;\n   498                      nbone->mScalingKeys[c].mValue = scale;\n   499\n   500                      // reconstruct rotation matrix without scaling\n   501                      aiMatrix3x3 rotmat(\n   502                          trafo.a1 / scale.x, trafo.a2 / scale.y, trafo.a3 / scale.z,\n   503                          trafo.b1 / scale.x, trafo.b2 / scale.y, trafo.b3 / scale.z,\n   504                          trafo.c1 / scale.x, trafo.c2 / scale.y, trafo.c3 / scale.z);\n   505\n   506                      // and convert it into a quaternion\n   507                      nbone->mRotationKeys[c].mTime = time;\n   508                      nbone->mRotationKeys[c].mValue = aiQuaternion( rotmat);\n   509                  }\n   510\n   511                  // longest lasting key sequence determines duration\n   512                  nanim->mDuration = std::max( nanim->mDuration, bone->mTrafoKeys.back().mTime);\n   513              } else {\n   514                  // separate key sequences for position, rotation, scaling\n   515                  nbone->mNumPositionKeys = (unsigned int)bone->mPosKeys.size();\n   516                  if (nbone->mNumPositionKeys != 0) {\n   517                      nbone->mPositionKeys = new aiVectorKey[nbone->mNumPositionKeys];\n   518                      for( unsigned int c = 0; c < nbone->mNumPositionKeys; ++c ) {\n   519                          aiVector3D pos = bone->mPosKeys[c].mValue;\n   520\n   521                          nbone->mPositionKeys[c].mTime = bone->mPosKeys[c].mTime;\n   522                          nbone->mPositionKeys[c].mValue = pos;\n   523                      }\n   524                  }\n   525\n   526                  // rotation\n   527                  nbone->mNumRotationKeys = (unsigned int)bone->mRotKeys.size();\n   528                  if (nbone->mNumRotationKeys != 0) {\n   529                      nbone->mRotationKeys = new aiQuatKey[nbone->mNumRotationKeys];\n   530                      for( unsigned int c = 0; c < nbone->mNumRotationKeys; ++c ) {\n   531                          aiMatrix3x3 rotmat = bone->mRotKeys[c].mValue.GetMatrix();\n   532\n   533                          nbone->mRotationKeys[c].mTime = bone->mRotKeys[c].mTime;\n   534                          nbone->mRotationKeys[c].mValue = aiQuaternion( rotmat);\n   535                          nbone->mRotationKeys[c].mValue.w *= -1.0f; // needs quat inversion\n   536                      }\n   537                  }\n   538\n   539                  // scaling\n   540                  nbone->mNumScalingKeys = (unsigned int)bone->mScaleKeys.size();\n   541                  if (nbone->mNumScalingKeys != 0) {\n   542                      nbone->mScalingKeys = new aiVectorKey[nbone->mNumScalingKeys];\n   543                      for( unsigned int c = 0; c < nbone->mNumScalingKeys; c++)\n   544                          nbone->mScalingKeys[c] = bone->mScaleKeys[c];\n   545                  }\n   546\n   547                  // longest lasting key sequence determines duration\n   548                  if( bone->mPosKeys.size() > 0)\n   549                      nanim->mDuration = std::max( nanim->mDuration, bone->mPosKeys.back().mTime);\n   550                  if( bone->mRotKeys.size() > 0)\n   551                      nanim->mDuration = std::max( nanim->mDuration, bone->mRotKeys.back().mTime);\n   552                  if( bone->mScaleKeys.size() > 0)\n   553                      nanim->mDuration = std::max( nanim->mDuration, bone->mScaleKeys.back().mTime);\n   554              }\n   555          }\n   556      }\n   557\n   558      // store all converted animations in the scene\n   559      if( newAnims.size() > 0)\n   560      {\n   561          pScene->mNumAnimations = (unsigned int)newAnims.size();\n   562          pScene->mAnimations = new aiAnimation* [pScene->mNumAnimations];\n   563          for( unsigned int a = 0; a < newAnims.size(); a++)\n   564              pScene->mAnimations[a] = newAnims[a];\n   565      }\n   566  }\n   567\n   568  // ------------------------------------------------------------------------------------------------\n   569  // Converts all materials in the given array and stores them in the scene's material list.\n   570  void XFileImporter::ConvertMaterials( aiScene* pScene, std::vector<XFile::Material>& pMaterials)\n   571  {\n   572      // count the non-referrer materials in the array\n   573      unsigned int numNewMaterials( 0 );\n   574      for ( unsigned int a = 0; a < pMaterials.size(); ++a ) {\n   575          if ( !pMaterials[ a ].mIsReference ) {\n   576              ++numNewMaterials;\n   577          }\n   578      }\n   579\n   580      // resize the scene's material list to offer enough space for the new materials\n   581      if( numNewMaterials > 0 ) {\n   582          aiMaterial** prevMats = pScene->mMaterials;\n   583          pScene->mMaterials = new aiMaterial*[pScene->mNumMaterials + numNewMaterials];\n   584          if( nullptr != prevMats)  {\n   585              ::memcpy( pScene->mMaterials, prevMats, pScene->mNumMaterials * sizeof( aiMaterial*));\n   586              delete [] prevMats;\n   587          }\n   588      }\n   589\n   590      // convert all the materials given in the array\n   591      for( unsigned int a = 0; a < pMaterials.size(); ++a ) {\n   592          XFile::Material& oldMat = pMaterials[a];\n   593          if( oldMat.mIsReference) {\n   594              // find the material it refers to by name, and store its index\n   595              for( size_t b = 0; b < pScene->mNumMaterials; ++b ) {\n   596                  aiString name;\n   597                  pScene->mMaterials[b]->Get( AI_MATKEY_NAME, name);\n   598                  if( strcmp( name.C_Str(), oldMat.mName.data()) == 0 ) {\n   599                      oldMat.sceneIndex = a;\n   600                      break;\n   601                  }\n   602              }\n   603\n   604              if( oldMat.sceneIndex == SIZE_MAX ) {\n   605                  ASSIMP_LOG_WARN_F( \"Could not resolve global material reference \\\"\", oldMat.mName, \"\\\"\" );\n   606                  oldMat.sceneIndex = 0;\n   607              }\n   608\n   609              continue;\n   610          }\n   611\n   612          aiMaterial* mat = new aiMaterial;\n   613          aiString name;\n   614          name.Set( oldMat.mName);\n   615          mat->AddProperty( &name, AI_MATKEY_NAME);\n   616\n   617          // Shading model: hard-coded to PHONG, there is no such information in an XFile\n   618          // FIX (aramis): If the specular exponent is 0, use gouraud shading. This is a bugfix\n   619          // for some models in the SDK (e.g. good old tiny.x)\n   620          int shadeMode = (int)oldMat.mSpecularExponent == 0.0f\n   330              break;\n   331\n   332          if (s.length() == 0)\n   333              ThrowException(\"Unexpected end of file reached while parsing template definition\");\n   334      }\n   335  }\n   336\n   337  // ------------------------------------------------------------------------------------------------\n   338  void XFileParser::ParseDataObjectFrame(Node *pParent) {\n   339      // A coordinate frame, or \"frame of reference.\" The Frame template\n   340      // is open and can contain any object. The Direct3D extensions (D3DX)\n   341      // mesh-loading functions recognize Mesh, FrameTransformMatrix, and\n   342      // Frame template instances as child objects when loading a Frame\n   343      // instance.\n   344      std::string name;\n   345      readHeadOfDataObject(&name);\n   346\n   347      // create a named node and place it at its parent, if given\n   348      Node *node = new Node(pParent);\n   349      node->mName = name;\n   350      if (pParent) {\n   351          pParent->mChildren.push_back(node);\n   352      } else {\n   353          // there might be multiple root nodes\n   354          if (mScene->mRootNode != nullptr) {\n   355              // place a dummy root if not there\n   356              if (mScene->mRootNode->mName != \"$dummy_root\") {\n   357                  Node *exroot = mScene->mRootNode;\n   358                  mScene->mRootNode = new Node(nullptr);\n   359                  mScene->mRootNode->mName = \"$dummy_root\";\n   360                  mScene->mRootNode->mChildren.push_back(exroot);\n   361                  exroot->mParent = mScene->mRootNode;\n   362              }\n   363              // put the new node as its child instead\n   364              mScene->mRootNode->mChildren.push_back(node);\n   365              node->mParent = mScene->mRootNode;\n   366          } else {\n   367              // it's the first node imported. place it as root\n   368              mScene->mRootNode = node;\n   369          }\n   370      }\n   371\n   372      // Now inside a frame.\n   373      // read tokens until closing brace is reached.\n   374      bool running = true;\n   375      while (running) {\n   376          std::string objectName = GetNextToken();\n   377          if (objectName.size() == 0)\n   378              ThrowException(\"Unexpected end of file reached while parsing frame\");\n   379\n   380          if (objectName == \"}\")\n   381              break; // frame finished\n   382          else if (objectName == \"Frame\")\n   383              ParseDataObjectFrame(node); // child frame\