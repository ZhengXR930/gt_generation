    "content": "commit 72140ebf411604ff127acb86ca43791dbf952a46\nAuthor: Jonas Wagner <jbw@google.com>\nDate:   Wed May 2 17:25:53 2018 +0200\n\n    Fix buffer-overread in char_link.\n\n    This bug was detected by the Google Autofuzz project.\n---\n src/document.c | 2 +-\n 1 file changed, 1 insertion(+), 1 deletion(-)\n\ndiff --git a/src/document.c b/src/document.c\nindex 3206cd6..9a491ad 100644\n--- a/src/document.c\n+++ b/src/document.c\n@@ -1371,7 +1371,7 @@ static size_t\n char_link(hoedown_buffer *ob, hoedown_document *doc, uint8_t *data, size_t offset, size_t size)\n {\n        int is_img = (offset && data[-1] == '!' && !is_escaped(data - offset, offset - 1));\n-       int is_footnote = (doc->ext_flags & HOEDOWN_EXT_FOOTNOTES && data[1] == '^');\n+       int is_footnote = (doc->ext_flags & HOEDOWN_EXT_FOOTNOTES && size > 1 && data[1] == '^');\n        size_t i = 1, txt_e, link_b = 0, link_e = 0, title_b = 0, title_e = 0;\n        hoedown_buffer *content = NULL;\n        hoedown_buffer *link = NULL;\ncommit ae8d32b4b24af09efc80794ba6e68c64093dde73\nAuthor: Jonas Wagner <jbw@google.com>\nDate:   Wed May 2 17:29:29 2018 +0200\n\n    Fix buffer-overread when checking for task lists.\n\n    The direct cause of the bug is that Hoedown does not check size\n    correctly when it tries to parse a loose task list. This leads to\n    problems when parsing tasks inside definition lists, where the\n    assumption that content is wrapped in <p> tags does not always hold.\n\n    We fix both the direct cause of the bug and add a check to ensure that\n    we do not aim to parse tasks in definition lists.\n\n    This bug was detected by the Google Autofuzz project.\n---\n src/html.c | 33 ++++++++++++++++++---------------\n 1 file changed, 18 insertions(+), 15 deletions(-)\n\ndiff --git a/src/html.c b/src/html.c\nindex 37b15ca..bac089c 100644\n--- a/src/html.c\n+++ b/src/html.c\n@@ -498,6 +498,7 @@ rndr_listitem(hoedown_buffer *ob, const hoedown_buffer *content, const hoedown_b\n                hoedown_html_renderer_state *state = data->opaque;\n                size_t prefix = 0;\n                size_t size = content->size;\n+               int is_li_tag = 0;\n                while (size && content->data[size - 1] == '\\n')\n                        size--;\n\n@@ -507,6 +508,7 @@ rndr_listitem(hoedown_buffer *ob, const hoedown_buffer *content, const hoedown_b\n                        HOEDOWN_BUFPUTSL(ob, \"<dt\");\n                } else {\n                        HOEDOWN_BUFPUTSL(ob, \"<li\");\n+                       is_li_tag = 1;\n                }\n\n                if (attr && attr->size) {\n@@ -514,24 +516,25 @@ rndr_listitem(hoedown_buffer *ob, const hoedown_buffer *content, const hoedown_b\n                }\n                hoedown_buffer_putc(ob, '>');\n\n-               if (USE_TASK_LIST(state) && size >= 3) {\n+               if (USE_TASK_LIST(state) && is_li_tag && size >= 3) {\n+                       /* Block list items are wrapped in <p> tags. Output the opening tag now,\n+                        * then check for a task list. */\n                        if (*flags & HOEDOWN_LI_BLOCK) {\n                                prefix = 3;\n-                       }\n-                       if (strncmp((char *)content->data + prefix, \"[ ]\", 3) == 0) {\n-                               hoedown_buffer_put(ob, content->data, prefix);\n-                               HOEDOWN_BUFPUTSL(ob, \"<input type=\\\"checkbox\\\"\");\n-                               hoedown_buffer_puts(ob, USE_XHTML(state) ? \"/>\" : \">\");\n-                               prefix += 3;\n-                               *flags |= HOEDOWN_LI_TASK;\n-                       } else if (strncasecmp((char *)content->data + prefix, \"[x]\", 3) == 0) {\n                                hoedown_buffer_put(ob, content->data, prefix);\n-                               HOEDOWN_BUFPUTSL(ob, \"<input checked=\\\"\\\" type=\\\"checkbox\\\"\");\n-                               hoedown_buffer_puts(ob, USE_XHTML(state) ? \"/>\" : \">\");\n-                               prefix += 3;\n-                               *flags |= HOEDOWN_LI_TASK;\n-                       } else {\n-                               prefix = 0;\n+                       }\n+                       if (size >= prefix + 3) {\n+                               if (strncmp((char *)content->data + prefix, \"[ ]\", 3) == 0) {\n+                                       HOEDOWN_BUFPUTSL(ob, \"<input type=\\\"checkbox\\\"\");\n+                                       hoedown_buffer_puts(ob, USE_XHTML(state) ? \"/>\" : \">\");\n+                                       prefix += 3;\n+                                       *flags |= HOEDOWN_LI_TASK;\n+                               } else if (strncasecmp((char *)content->data + prefix, \"[x]\", 3) == 0) {\n+                                       HOEDOWN_BUFPUTSL(ob, \"<input checked=\\\"\\\" type=\\\"checkbox\\\"\");\n+                                       hoedown_buffer_puts(ob, USE_XHTML(state) ? \"/>\" : \">\");\n+                                       prefix += 3;\n+                                       *flags |= HOEDOWN_LI_TASK;\n+                               }\n                        }\n                }\n\ncommit 70de13e19e6672a03165fc87a45f30ae60b4da3a\nAuthor: Eric Nguyen <neric@google.com>\nDate:   Mon Feb 13 11:59:31 2017 -0800\n\n    Fix potential buffer overflow in attributes parsing.\n\n    The size is now checked to make sure the data is not accessed at a\n    potentially unsafe index.\n---\n src/document.c | 6 ++++++\n 1 file changed, 6 insertions(+)\n\ndiff --git a/src/document.c b/src/document.c\nindex a9ab569..97d5147 100644\n--- a/src/document.c\n+++ b/src/document.c\n@@ -609,6 +609,9 @@ static size_t parse_inline_attributes(uint8_t *data, size_t size, struct hoedown\n {\n        size_t attr_start, i = 0;\n\n+       if (size < 1)\n+               return 0;\n+\n        if (data[i] == '{' && (!attr_activation || (i + 1 < size && data[i + 1] == attr_activation))) {\n                attr_start = i + 1;\n                /* skip an extra character to skip over the activation character if any */\n@@ -639,6 +642,9 @@ static size_t parse_attributes(uint8_t *data, size_t size, struct hoedown_buffer\n {\n        size_t i, len, begin = 0, end = 0;\n\n+       if (size < 1)\n+               return 0;\n+\n        i = size;\n        while (i && data[i-1] == '\\n') {\n                i--;\ncommit c8b35f50be2e2d0f23860a8b7b64c9c3e16645f6\nAuthor: Eric Nguyen <neric@google.com>\nDate:   Tue Jan 17 10:07:52 2017 -0800\n\n    Fix a buffer overflow issue where the size was mistakenly much larger\n    than it should be.\n\n    prefix_dli was feeding in 'size - 1' instead of 'size - i' to one of its\n    functions.\n---\n src/document.c | 2 +-\n 1 file changed, 1 insertion(+), 1 deletion(-)\n\ndiff --git a/src/document.c b/src/document.c\nindex 287634e..1806e38 100644\n--- a/src/document.c\n+++ b/src/document.c\n@@ -2017,7 +2017,7 @@ prefix_dli(hoedown_document *doc, uint8_t *data, size_t size)\n\n                /* if anything special is found while parsing the definition term part,\n                 * then return so that the main loop can deal with it */\n-               if (!is_paragraph(doc, data + i, size - 1)) {\n+               if (!is_paragraph(doc, data + i, size - i)) {\n                        break;\n                }",
