   return (PIX *)ERROR_PTR(\"pixs not defined\", procName, NULL);\n   776      if (pixGetDepth(pixs) != 32)\n   777          return (PIX *)ERROR_PTR(\"pixs not 32 bpp\", procName, NULL);\n   778      if (rwt < 0.0 || gwt < 0.0 || bwt < 0.0)\n   779          return (PIX *)ERROR_PTR(\"weights not all >= 0.0\", procName, NULL);\n   780\n   781          /* Make sure the sum of weights is 1.0; otherwise, you can get\n   782           * overflow in the gray value. */\n   783      if (rwt == 0.0 && gwt == 0.0 && bwt == 0.0) {\n   784          rwt = L_RED_WEIGHT;\n   785          gwt = L_GREEN_WEIGHT;\n   786          bwt = L_BLUE_WEIGHT;\n   787      }\n   788      sum = rwt + gwt + bwt;\n   789      if (L_ABS(sum - 1.0) > 0.0001) {  /* maintain ratios with sum == 1.0 */\n   790          L_WARNING(\"weights don't sum to 1; maintaining ratios\\n\", procName);\n   791          rwt = rwt / sum;\n   792          gwt = gwt / sum;\n--\n   994      PROCNAME(\"pixConvertRGBToGraySatBoost\");\n   995\n   996      if (!pixs)\n   997          return (PIX *)ERROR_PTR(\"pixs not defined\", procName, NULL);\n   998      pixGetDimensions(pixs, &w, &h, &d);\n   999      if (d != 32 && !pixGetColormap(pixs))\n  1000          return (PIX *)ERROR_PTR(\"pixs not cmapped or rgb\", procName, NULL);\n  1001      if (refval < 1 || refval > 255)\n  1002          return (PIX *)ERROR_PTR(\"refval not in [1 ... 255]\", procName, NULL);\n  1003\n  1004      pixt = pixRemoveColormap(pixs, REMOVE_CMAP_TO_FULL_COLOR);\n  1005      pixd = pixCreate(w, h, 8);\n  1006      pixCopyResolution(pixd, pixs);\n  1007      pixCopyInputFormat(pixd, pixs);\n  1008      wplt = pixGetWpl(pixt);\n  1009      datat = pixGetData(pixt);\n  1010      wpld = pixGetWpl(pixd);\n  1011      datad = pixGetData(pixd);\n  1012      invmax = (l_float32 *)LEPT_CALLOC(256, sizeof(l_float32));\n  1013      ratio = (l_float32 *)LEPT_CALLOC(256, sizeof(l_float32));\n  1014      for (i = 1; i < 256; i++) {  /* i == 0  --> delta = sval =