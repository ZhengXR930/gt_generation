neral()\n   259   *\n   260   * \\param[in]    pixs      any depth, with or without colormap\n   261   * \\param[in]    type      REMOVE_CMAP_TO_BINARY,\n   262   *                         REMOVE_CMAP_TO_GRAYSCALE,\n   263   *                         REMOVE_CMAP_TO_FULL_COLOR,\n   264   *                         REMOVE_CMAP_WITH_ALPHA,\n   265   *                         REMOVE_CMAP_BASED_ON_SRC\n   266   * \\param[in]    ifnocmap  L_CLONE, L_COPY\n   267   * \\return  pixd always a new pix; without colormap, or NULL on error\n   268   *\n   269   * <pre>\n   270   * Notes:\n   271   *      (1) Convenience function that allows choice between returning\n   272   *          a clone or a copy if pixs does not have a colormap.\n   273   *      (2) See pixRemoveColormap().\n   274   * </pre>\n   275   */\n   276  PIX *\n   277  pixRemoveColormapGeneral(PIX     *pixs,\n   278                           l_int32  type,\n   279                           l_int32  ifnocmap)\n   280  {\n   281      PROCNAME(\"pixRemoveColormapGeneral\");\n   282\n   283      if (!pixs)\n   284          return (PIX *)ERROR_PTR(\"pixs not defined\", procName, NULL);\n   285      if (ifnocmap != L_CLONE && ifnocmap != L_COPY)\n   286          return (PIX *)ERROR_PTR(\"invalid value for ifnocmap\", procName, NULL);\n   287\n   288      if (pixGetColormap(pixs))\n   289          return pixRemoveColormap(pixs, type);\n   290\n   291      if (ifnocmap == L_CLONE)\n   292          return pixClone(pixs);\n   293      else\n   294          return pixCopy(NULL, pixs);\n   295  }\n   296\n   297\n   298  /*!\n   299   * \\brief   pixRemoveColormap()\n   300   *\n   301   * \\param[in]    pixs   see restrictions below\n   302   * \\param[in]    type   REMOVE_CMAP_TO_BINARY,\n   303   *                      REMOVE_CMAP_TO_GRAYSCALE,\n   304   *                      REMOVE_CMAP_TO_FULL_COLOR,\n   305   *                      REMOVE_CMAP_WITH_ALPHA,\n   306   *                      REMOVE_CMAP_BASED_ON_SRC\n   307   * \\return  pixd without colormap, or NULL on error\n   308   *\n   309   * <pre>\n   310   * Notes:\n   311   *      (1) If pixs does not have a colormap, a clone is returned.\n   312   *      (2) Otherwise, the input pixs is restricted to 1, 2, 4 or 8 bpp.\n   313   *      (3) Use REMOVE_CMAP_TO_BINARY only on 1 bpp pix.\n   314   *      (4) For grayscale conversion from RGB, use a weighted average\n   315   *          of RGB values, and always return an 8 bpp pix, regardless\n   316   *          of whether the input pixs depth is 2, 4 or 8 bpp.\n   317   *      (5) REMOVE_CMAP_TO_FULL_COLOR ignores the alpha component and\n   318   *          returns a 32 bpp pix with spp == 3 and the alpha bytes are 0.\n   319   *      (6) For REMOVE_CMAP_BASED_ON_SRC, if there is no color, this\n   320   *          returns either a 1 bpp or 8 bpp grayscale pix.\n   321   *          If there is color, this returns a 32 bpp pix, with either:\n   322   *           * 3 spp, if the alpha values are all 255 (opaque), or\n   323   *           * 4 spp (preserving the alpha), if any alpha values are not 255.\n   324   * </pre>\n   325   */\n   326  PIX *\n   327  pixRemoveColormap(PIX     *pixs,\n   328                    l_int32  type)\n   329  {\n   330  l_int32    sval, rval, gval, bval, val0, val1;\n   331  l_int32    i, j, k, w, h, d, wpls, wpld, ncolors, nalloc, count;\n   332  l_int32    opaque, colorfound, blackwhite;\n   333  l_int32   *rmap, *gmap, *bmap, *amap;\n   334  l_uint32  *datas, *lines, *datad, *lined, *lut, *graymap;\n   335  l_uint32   sword, dword;\n   336  PIXCMAP   *cmap;\n   337  PIX       *pixd;\n   338\n   339      PROCNAME(\"pixRemoveColormap\");\n   340\n   341      if (!pixs)\n   342          return (PIX *)ERROR_PTR(\"pixs not defined\", procName, NULL);\n   343      if ((cmap = pixGetColormap(pixs)) == NULL)\n   344          return pixClone(pixs);\n   345      if (type != REMOVE_CMAP_TO_BINARY &&\n   346          type != REMOVE_CMAP_TO_GRAYSCALE &&\n   347          type != REMOVE_CMAP_TO_FULL_COLOR &&\n   348          type != REMOVE_CMAP_WITH_ALPHA &&\n   349          type != REMOVE_CMAP_BASED_ON_SRC) {\n   350          L_WARNING(\"Invalid type; converting based on src\\n\", procName);\n   351          type = REMOVE_CMAP_BASED_ON_SRC;\n   352      }\n   353      pixGetDimensions(pixs, &w, &h, &d);\n   354      if (d != 1 && d != 2 && d != 4 && d != 8)\n   355          return (PIX *)ERROR_PTR(\"pixs must be {1,2,4,8} bpp\", procName, NULL);\n   356\n   357      ncolors = pixcmapGetCount(cmap);\n   358      nalloc = 1 << d;  /* allocate for max size in case of pixel corruption */\n   359      if (ncolors > nalloc)\n   360          return (PIX *)ERROR_PTR(\"too many colors for pixel depth\",\n   361                                  procName, NULL);\n   362\n   363      if (pixcmapToArrays(cmap, &rmap, &gmap, &bmap, &amap))\n   364          return (PIX *)ERROR_PTR(\"colormap arrays not made\", procName, NULL);\n   365\n   366      if (d != 1 && type == REMOVE_CMAP_TO_BINARY) {\n   367          L_WARNING(\"not 1 bpp; can't remove cmap to binary\\n\", procName);\n   368          type = REMOVE_CMAP_BASED_ON_SRC;\n   369      }\n   370\n   371          /* Select output type depending on colormap content */\n   372      if (type == REMOVE_CMAP_BASED_ON_SRC) {\n   373          pixcmapIsOpaque(cmap, &opaque);\n   374          pixcmapHasColor(cmap, &colorfound);\n   375          pixcmapIsBlackAndWhite(cmap, &blackwhite);\n   376          if (!opaque) {  /* save the alpha */\n   377              type = REMOVE_CMAP_WITH_ALPHA;\n   378          } else if (colorfound) {\n   379              type = REMOVE_CMAP_TO_FULL_COLOR;\n   380          } else {  /* opaque and no color */\n   381              if (d == 1 && blackwhite)  /* can binarize without loss */\n   382                  type = REMOVE_CMAP_TO_BINARY;\n   383              else\n   384                  type = REMOVE_CMAP_TO_GRAYSCALE;\n   385          }\n   386      }\n   387\n   388      datas = pixGetData(pixs);\n   389      wpls = pixGetWpl(pixs);\n   390      if (type == REMOVE_CMAP_TO_BINARY) {\n   391          if ((pixd = pixCopy(NULL, pixs)) == NULL) {\n   392              L_ERROR(\"pixd not made\\n\", procName);\n   393              goto cleanup_arrays;\n   394          }\n   395          pixcmapGetColor(cmap, 0, &rval, &gval, &bval);\n   396          val0 = rval + gval + bval;\n   397          pixcmapGetColor(cmap, 1, &rval, &gval, &bval);\n   398          val1 = rval + gval + bval;\n   399          if (val0 < val1)  /* photometrically inverted from standard */\n   400              pixInvert(pixd, pixd);\n   401          pixDestroyColormap(pixd);\n   402      } else if (type == REMOVE_CMAP_TO_GRAYSCALE) {\n   403          if ((pixd = pixCreate(w, h, 8)) == NULL) {\n   404              L_ERROR(\"pixd not made\\n\", procName);\n   405              goto cleanup_arrays;\n   406          }\n   407          pixCopyResolution(pixd, pixs);\n   408          pixCopyInputFormat(pixd, pixs);\n   409          datad = pixGetData(pixd);\n   410          wpld = pixGetWpl(pixd);\n   411          graymap = (l_uint32 *)LEPT_CALLOC(nalloc, sizeof(l_uint32));\n   412          for (i = 0; i < ncolors; i++) {\n   413              graymap[i] = (l_uint32)(L_RED_WEIGHT * rmap[i] +\n   414                                      L_GREEN_WEIGHT * gmap[i] +\n   415                                      L_BLUE_WEIGHT * bmap[i] + 0.5);\n   416          }\n   417          for (i = 0; i < h; i++) {\n   418              lines = datas + i * wpls;\n   419              lined = datad + i * wpld;\n   420              switch (d)   /* depth test above; no default permitted */\n   421              {\n   422                  case 8:\n   423                          /* Unrolled 4x */\n   424                      for (j = 0, count = 0; j + 3 < w; j += 4, count++) {\n   425                          sword = lines[count];\n   426                          dword = (graymap[(sword >> 24) & 0xff] << 24) |\n   427                              (graymap[(sword >> 16) & 0xff] << 16) |\n   428                              (graymap[(sword >> 8) & 0xff] << 8) |\n   429                              graymap[sword & 0xff];\n   430                          lined[count] = dword;\n   431                      }\n   432                          /* Cleanup partial word */\n   433                      for (; j < w; j++) {\n   434                          sval = GET_DATA_BYTE(lines, j);\n   435                          gval = graymap[sval];\n   436                          SET_DATA_BYTE(lined, j, gval);\n   437                      }\n   438  #if DEBUG_UNROLLING\n   439  #define CHECK_VALUE(a, b, c) if (GET_DATA_BYTE(a, b) != c) { \\\n   440      lept_stderr(\"Error: mismatch at %d, %d vs %d\\n\", \\\n   441                  j, GET_DATA_BYTE(a, b), c); }\n   442                      for (j = 0; j < w; j++) {\n   443                          sval = GET_DATA_BYTE(lines, j);\n   444                          gval = graymap[sval];\n   445                          CHECK_VALUE(lined, j, gval);\n   446                      }\n   447  #endif\n   448                      break;\n   449                  case 4:\n   450                          /* Unrolled 8x */\n   451                      for (j = 0, count = 0; j + 7 < w; j += 8, count++) {\n   452                          sword = lines[count];\n   453                          dword = (graymap[(sword >> 28) & 0xf] << 24) |\n   454                              (graymap[(sword >> 24) & 0xf] << 16) |\n   455                              (graymap[(sword >> 20) & 0xf] << 8) |\n   456                              graymap[(sword >> 16) & 0xf];\n   457                          lined[2 * count] = dword;\n   458                          dword = (graymap[(sword >> 12) & 0xf] << 24) |\n   459                              (graymap[(sword >> 8) & 0xf] << 16) |\n--\n   662      if (!pixs || pixGetDepth(pixs) != 8)\n   663          return (PIX *)ERROR_PTR(\"pixs undefined or not 8 bpp\", procName, NULL);\n   664\n   665          /* Eliminate the easy cases */\n   666      pixNumColors(pixs, 1, &ncolors);\n   667      cmap = pixGetColormap(pixs);\n   668      if (cmap) {\n   669          if (pixcmapGetCount(cmap) == ncolors)  /* irreducible */\n   670              return pixCopy(NULL, pixs);\n   671          else\n   672              pix1 = pixRemoveColormap(pixs, REMOVE_CMAP_TO_GRAYSCALE);\n   673      } else {\n   674          if (ncolors == 256) {\n   675              pix1 = pixCopy(NULL, pixs);\n   676              pixAddGrayColormap8(pix1);\n   677              return pix1;\n   678          }\n   679          pix1 = pixClone(pixs);\n   680      }\n   681\n   682          /* Find the gray levels and make a reverse map */\n   683      pixGetDimensions(pix1, &w, &h, NULL);\n   684      data1 = pixGetData(pix1);\n   685      wpl1 = pixGetWpl(pix1);\n   686      inta = (l_int32 *)LEPT_CALLOC(256, sizeof(l_int32));\n   687      for (i = 0; i < h; i++) {\n   688          line1 = data1 + i * wpl1;\n   689          for (j = 0; j < w; j++) {\n   690              val = GET_DATA_BYTE(line1, j);\n   691              inta[val] = 1;\n   692          }\n   693      }\n   694      cmap = pixcmapCreate(8);\n   695      revmap = (l_int32 *)LEPT_CALLOC(256, sizeof(l_int32));\n   696      for (i = 0, index = 0; i < 256; i++) {\n   697          if (inta[i]) {\n   698              pixcmapAddColor(cmap, i, i, i);\n   699              revmap[i] = index++;\n   700          }\n   701      }\n   702\n   703          /* Set all pixels in pixd to the colormap index */\n   704      pixd = pixCreateTemplate(pix1);\n   705      pixSetColormap(pixd, cmap);\n   706      pixCopyInputFormat(pixd, pixs);\n   707      pixCopyResolution(pixd, pixs);\n   708      datad = pixGetData(pixd);\n   709      wpld = pixGetWpl(pixd);\n   710      for (i = 0; i < h; i++) {\n   711          line1 = data1 + i * wpl1;\n   712          lined