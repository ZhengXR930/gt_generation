val2;\n  2532      val[3] = val3;\n  2533      for (index = 0; index < 256; index++) {\n  2534          tab[index] = (val[(index >> 6) & 3] << 24) |\n  2535                       (val[(index >> 4) & 3] << 16) |\n  2536                       (val[(index >> 2) & 3] << 8) | val[index & 3];\n  2537      }\n  2538\n  2539      nbytes = (w + 3) / 4;\n  2540      for (i = 0; i < h; i++) {\n  2541          lines = datas + i * wpls;\n  2542          lined = datad + i * wpld;\n  2543          for (j = 0; j < nbytes; j++) {\n  2544              byte = GET_DATA_BYTE(lines, j);\n  2545              lined[j] = tab[byte];\n  2546          }\n  2547      }\n  2548\n  2549      LEPT_FREE(tab);\n  2550      return pixd;\n  2551  }\n  2552\n  2553\n  2554  /*!\n  2555   * \\brief   pixConvert4To8()\n  2556   *\n  2557   * \\param[in]    pixs      4 bpp\n  2558   * \\param[in]    cmapflag  TRUE if pixd is to have a colormap; FALSE otherwise\n  2559   * \\return  pixd 8 bpp, or NULL on error\n  2560   *\n  2561   * <pre>\n  2562   * Notes:\n  2563   *      ~ If cmapflag is TRUE:\n  2564   *          ~ pixd is made with a colormap.\n  2565   *          ~ If pixs has a colormap, it is copied and the colormap\n  2566   *            index values are placed in pixd.\n  2567   *          ~ If pixs does not have a colormap, a colormap with linear\n  2568   *            trc is built and the pixel values in pixs are placed in\n  2569   *            pixd as colormap index values.\n  2570   *      ~ If cmapflag is FALSE:\n  2571   *          ~ pixd is made without a colormap.\n  2572   *          ~ If pixs has a colormap, it is removed and the values stored\n  2573   *            in pixd are from the colormap (converted to gray).\n  2574   *          ~ If pixs does not have a colormap, the pixel values in pixs\n  2575   *            are used, with shift replication, to populate pixd.\n  2576   * </pre>\n  2577   */\n  2578  PIX *\n  2579  pixConvert4To8(PIX     *pixs,\n  2580                 l_int32  cmapflag)\n  2581  {\n  2582  l_int32    w, h, i, j, wpls, wpld, byte, qbit;\n  2583  l_uint32  *datas, *datad, *lines, *lined;\n  2584  PIX       *pixd;\n  2585  PIXCMAP   *cmaps, *cmapd;\n  2586\n  2587      PROCNAME(\"pixConvert4To8\");\n  2588\n  2589      if (!pixs)\n  2590          return (PIX *)ERROR_PTR(\"pixs not defined\", procName, NULL);\n  2591      if (pixGetDepth(pixs) != 4)\n  2592          return (PIX *)ERROR_PTR(\"pixs not 4 bpp\", procName, NULL);\n  2593\n  2594      cmaps = pixGetColormap(pixs);\n  2595      if (cmaps && cmapflag == FALSE)\n  2596          return pixRemoveColormap(pixs, REMOVE_CMAP_TO_GRAYSCALE);\n  2597\n  2598      pixGetDimensions(pixs, &w, &h, NULL);\n  2599      if ((pixd = pixCreate(w, h, 8)) == NULL)\n  2600          return (PIX *)ERROR_PTR(\"pixd not made\", procName, NULL);\n  2601      pixCopyResolution(pixd, pixs);\n  2602      pixCopyInputFormat(pixd, pixs);\n  2603      datas = pixGetData(pixs);\n  2604      wpls = pixGetWpl(pixs);\n  2605      datad = pixGetData(pixd);\n  2606      wpld = pixGetWpl(pixd);\n  2607\n  2608      if (cmapflag == TRUE) {  /* pixd will have a colormap */\n  2609          if (cmaps) {  /* use the existing colormap from pixs */\n  2610              cmapd = pixcmapConvertTo8(cmaps);\n  2611          } else {  /* make a colormap with a linear trc */\n  2612              cmapd = pixcmapCreate(8);\n  2613              for (i = 0; i < 16; i++)\n  2614                  pixcmapAddColor(cmapd, 17 * i, 17 * i, 17 * i);\n  2615          }\n  2616          pixSetColormap(pixd, cmapd);\n  2617          for (i = 0; i < h; i++) {\n  2618              lines = datas + i * wpls;\n  2619              lined = datad + i * wpld;\n  2620              for (j = 0; j < w; j++) {\n  2621                  qbit = GET_DATA_QBIT(lines, j);\n  2622                  SET_DATA_BYTE(lined, j, qbit);\n  2623              }\n  2624          }\n  2625          return pixd;\n  2626      }\n  2627\n  2628          /* Last case: no colormap in either pixs or pixd.\n  2629           * Replicate the qbit value into 8 bits. */\n  2630      for (i = 0; i < h; i++) {\n  2631          lines = datas + i * wpls;\n  2632          lined = datad + i * wpld;\n  2633          for (j = 0; j < w; j++) {\n  2634              qbit = GET_DATA_QBIT(lines, j);\n  2635              byte = (qbit << 4) | qbit;\n  2636              SET_DATA_BYTE(lined, j, byte);\n  2637          }\n  2638      }\n  2639      return pixd;\n  2640  }\n  2641\n  2642\n  2643\n  2644  /*---------------------------------------------------------------------------*\n  2645   *               Unpacking conversion from 8 bpp to 16 bpp                   *\n  2646   *---------------------------------------------------------------------------*/\n  2647  /*!\n  2648   * \\brief   pixConvert8To16()\n  2649   *\n  2650   * \\param[in]    pixs       8 bpp; colormap removed to gray\n  2651   * \\param[in]    leftshift  number of bits: 0 is no shift;\n  2652   *                          8 replicates in MSB and LSB of dest\n  2653   * \\return  pixd 16 bpp, or NULL on error\n  2654   *\n  2655   * <pre>\n  2656   * Notes:\n  2657   *      (1) For left shift of 8, the 8 bit value is replicated in both\n  2658   *          the MSB and the LSB of the pixels in pixd.  That way, we get\n  2659   *          proportional mapping, with a correct map from 8 bpp white\n  2660   *          (0xff) to 16 bpp white (0xffff).\n  2661   * </pre>\n  2662   */\n  2663  PIX *\n  2664  pixConvert8To16(PIX     *pixs,\n  2665                  l_int32  leftshift)\n  2666  {\n  2667  l_int32    i, j, w, h, d, wplt, wpld, val;\n  2668  l_uint32  *datat, *datad, *linet, *lined;\n  2669  PIX       *pixt, *pixd;\n  2670\n  2671      PROCNAME(\"pixConvert8To16\");\n  2672\n  2673      if (!pixs)\n  2674          return (PIX *)ERROR_PTR(\"pixs not defined\", procName, NULL);\n  2675      pixGetDimensions(pixs, &w, &h, &d);\n  2676      if (d != 8)\n  2677          return (PIX *)ERROR_PTR(\"pixs not 8 bpp\", procName, NULL);\n  2678      if (leftshift < 0 || leftshift > 8)\n  2679          return (PIX *)ERROR_PTR(\"leftshift not in [0 ... 8]\", procName, NULL);\n  2680\n  2681      if (pixGetColormap(pixs) != NULL)\n  2682          pixt = pixRemoveColormap(pixs, REMOVE_CMAP_TO_GRAYSCALE);\n  2683      else\n  2684          pixt = pixClone(pixs);\n  2685\n  2686      pixd = pixCreate(w, h, 16);\n  2687      pixCopyResolution(pixd, pixs);\n  2688      pixCopyInputFormat(pixd, pixs);\n  2689      datat = pixGetData(pixt);\n  2690      datad = pixGetData(pixd);\n  2691      wplt = pixGetWpl(pixt);\n  2692      wpld = pixGetWpl(pixd);\n  2693      for (i = 0; i < h; i++) {\n  2694          linet = datat + i * wplt;\n  2695          lined = datad + i * wpld;\n  2696          for (j = 0; j < w; j++) {\n  2697              val = GET_DATA_BYTE(linet, j);\n  2698              if (leftshift == 8)\n  2699                  val = val | (val << leftshift);\n  2700              else\n  2701                  val <<= leftshift;\n  2702              SET_DATA_TWO_BYTES(lined, j, val);\n  2703          }\n  2704      }\n  2705\n  2706      pixDestroy(&pixt);\n  2707      return pixd;\n  2708  }\n  2709\n  2710\n  2711  /*---------------------------------------------------------------------------*\n  2712   *                     Top-level conversion to 2 bpp                         *\n  2713   *---------------------------------------------------------------------------*/\n  2714  /*!\n  2715   * \\brief   pixConvertTo2()\n  2716   *\n  2717   * \\param[in]    pixs   1, 2, 4, 8, 32 bpp; colormap OK but will be removed\n  2718   * \\return  pixd   2 bpp, or NULL on error\n  2719   *\n  2720   * <pre>\n  2721   * Notes:\n  2722   *      (1) This is a top-level function, with simple default values\n  2723   *          used in pixConvertTo8() if unpacking is necessary.\n  2724   *      (2) Any existing colormap is removed; the result is always gray.\n  2725   *      (3) If the input image has 2 bpp and no colormap, the operation is\n  2726   *          lossless and a copy is returned.\n  2727   * </pre>\n  2728   */\n  2729  PIX *\n  2730  pixConvertTo2(PIX  *pixs)\n  2731  {\n  2732  l_int32  d;\n  2733  PIX     *pix1, *pix2, *pix3, *pixd;\n  2734\n  2735      PROCNAME(\"pixConvertTo2\");\n  2736\n  2737      if (!pixs)\n  2738          return (PIX *)ERROR_PTR(\"pixs not defined\", procName, NULL);\n  2739      d = pixGetDepth(pixs);\n  2740      if (d != 1 && d != 2 && d != 4 && d != 8 && d != 32)\n  2741          return (PIX *)ERROR_PTR(\"depth not {1,2,4,8,32}\", procName, NULL);\n  2742\n  2743      if (pixGetColormap(pixs) != NULL) {\n  2744          pix1 = pixRemoveColormap(pixs, REMOVE_CMAP_TO_GRAYSCALE);\n  2745          d = pixGetDepth(pix1);\n  2746      } else {\n  2747          pix1 = pixCopy(NULL, pixs);\n  2748      }\n  2749      if (d == 32)\n  2750          pix2 = pixConvertTo8(pix1, FALSE);\n  2751      else\n  2752          pix2 = pixClone(pix1);\n  2753      pixDestroy(&pix1);\n  2754      if (d == 1) {\n  2755          pixd = pixConvert1To2(NULL, pix2, 3, 0);\n  2756      } else if (d == 2) {\n  2757          pixd = pixClone(pix2);\n  2758      } else if (d == 4) {\n  2759          pix3 = pixConvert4To8(pix2, FALSE);  /* unpack to 8 */\n  2760          pixd = pixConvert8To2(pix3);\n  2761          pixDestroy(&pix3);\n  2762      } else {  /* d == 8 */\n  2763          pixd = pixConvert8To2(pix2);\n  2764      }\n  2765      pixDestroy(&pix2);\n  2766      return pixd;\n  2767  }\n  2768\n  2769\n  2770  /*!\n  2771   * \\brief   pixConvert8To2()\n  2772   *\n  2773   * \\param[in]     pix     8 bpp; colormap OK\n  2774   * \\return  pixd  2 bpp, or NULL on error\n  2775   *\n  2776   * <pre>\n  2777   * Notes:\n  2778   *      (1) Any existing colormap is removed to gray.\n  2779   * </pre>\n  2780   */\n  2781  PIX *\n  2782  pixConvert8To2(PIX  *pix)\n  2783  {\n  2784  l_int32    i, j, w, h, wpls, wpld;\n  2785  l_uint32   word;\n  2786  l_uint32  *datas, *lines, *datad, *lined;\n  2787  PIX       *pixs, *pixd;\n  2788\n  2789      PROCNAME(\"pixConvert8To2\");\n  2790\n  2791      if (!pix || pixGetDepth(pix) != 8)\n  2792          return (PIX *)ERROR_PTR(\"pix undefined or not 8 bpp\", procName, NULL);\n  2793\n  2794      if (pixGetColormap(pix) != NULL)\n  2795          pixs = pixRemoveColormap(pix, REMOVE_CMAP_TO_GRAYSCALE);\n  2796      else\n  2797          pixs = pixClone(pix);\n  2798      pixGetDimensions(pixs, &w, &h, NULL);\n  2799      datas = pixGetData(pixs);\n  2800      wpls = pixGetWpl(pixs);\n  2801      pixd = pixCreate(w, h, 2);\n  2802      datad = pixGetData(pixd);\n  2803      wpld = pixGetWpl(pixd);\n  2804      for (i = 0; i < h; i++) {\n  2805          lines = datas + i * wpls;\n  2806          lined = datad + i * wpld;\n  2807          for (j = 0; j < wpls; j++) {  /* march through 4 pixels at a time */\n  2808              word = lines[j] & 0xc0c0c0c0;  /* top 2 bits of each byte */\n  2809              word = (word >> 24) | ((word & 0xff0000) >> 18) |\n  2810                     ((word & 0xff00) >> 12) | ((word & 0xff) >> 6);\n  2811              SET_DATA_BYTE(lined, j, word);  /* only LS byte is filled */\n  2812          }\n  2813      }\n  2814      pixDestroy(&pixs);\n  2815      return pixd;\n  2816  }\n  2817\n  2818\n  2819  /*---------------------------------------------------------------------------*\n  2820   *                     Top-level conversion to 4 bpp                         *\n  2821   *---------------------------------------------------------------------------*/\n  2822  /*!\n  2823   * \\brief   pixConvertTo4()\n  2824   *\n  2825   * \\param[in]    pixs   1, 2, 4, 8, 32 bpp; colormap OK but will be removed\n  2826   * \\return  pixd   4 bpp, or NULL on error\n  2827   *\n  2828   * <pre>\n  2829   * Notes:\n  2830   *      (1) This is a top-level function, with simple default values\n  2831   *          used in pixConvertTo8() if unpacking is necessary.\n  2832   *      (2) Any existing colormap is removed; the result is always gray.\n  2833   *      (3) If the input image has 4 bpp and no colormap, the operation is\n  2834   *          lossless and a copy is returned.\n  2835   * </pre>\n  2836   */\n  2837  PIX *\n  2838  pixConvertTo4(PIX  *pixs)\n  2839  {\n  2840  l_int32  d;\n  2841  PIX     *pix1, *pix2, *pix3, *pixd;\n  2842\n  2843      PROCNAME(\"pixConvertTo4\");\n  2844\n  2845      if (!pixs)\n  2846          return (PIX *)ERROR_PTR(\"pixs not defined\", procName, NULL);\n  2847      d = pixGetDepth(pixs);\n  2848      if (d != 1 && d != 2 && d != 4 && d != 8 && d != 32)\n  2849          return (PIX *)ERROR_PTR(\"depth not {1,2,4,8,32}\", procName, NULL);\n  2850\n  2851      if (pixGetColormap(pixs) != NULL) {\n  2852          pix1 = pixRemoveColormap(pixs, REMOVE_CMAP_TO_GRAYSCALE);\n  2853          d = pixGetDepth(pix1);\n  2854      } else {\n  2855          pix1 = pixCopy(NULL, pixs);\n  2856      }\n  2857      if (d == 32)\n  2858          pix2 = pixConvertTo8(pix1, FALSE);\n  2859      else\n  2860          pix2 = pixClone(pix1);\n  2861      pixDestroy(&pix1);\n  2862      if (d == 1) {\n  2863          pixd = pixConvert1To4(NULL, pix2, 15, 0);\n  2864      } else if (d == 2) {\n  2865          pix3 = pixConvert2To8(pix2, 0, 0x55, 0xaa, 0xff, FALSE);\n  2866          pixd = pixConvert8To4(pix3);\n  2867          pixDestroy(&pix3);\n  2868      } else if (d == 4) {\n  2869          pixd = pixClone(pix2);\n  2870      } else {  /* d == 8 */\n  2871          pixd = pixConvert8To4(pix2);\n  2872      }\n  2873      pixDestroy(&pix2);\n  2874      return pixd;\n  2875  }\n  2876\n  2877\n  2878  /*!\n  2879   * \\brief   pixConvert8To4()\n  2880   *\n  2881   * \\param[in]     pix     8 bpp; colormap OK\n  2882   * \\return  pixd  4 bpp, or NULL on error\n  2883   *\n  2884   * <pre>\n  2885   * Notes:\n  2886   *      (1) Any existing colormap is removed to gray.\n  2887   * </pre>\n  2888   */\n  2889  PIX *\n  2890  pixConvert8To4(PIX  *pix)\n  2891  {\n  2892  l_int32    i, j, w, h, wpls, wpld, val;\n  2893  l_uint32  *datas, *lines, *datad, *lined;\n  2894  PIX       *pixs, *pixd;\n  2895\n  2896      PROCNAME(\"pixConvert8To4\");\n  2897\n  2898      if (!pix || pixGetDepth(pix) != 8)\n  2899          return (PIX *)ERROR_PTR(\"pix undefined or not 8 bpp\", procName, NULL);\n  2900\n  2901      if (pixGetColormap(pix) != NULL)\n  2902          pixs = pixRemoveColormap(pix, REMOVE_CMAP_TO_GRAYSCALE);\n  2903      else\n  2904          pixs = pixClone(pix);\n  2905      pixGetDimensions(pixs, &w, &h, NULL);\n  2906      datas = pixGetData(pixs);\n  2907      wpls = pixGetWpl(pixs);\n  2908      pixd = pixCreate(w, h, 4);\n  2909      datad = pixGetData(pixd);\n  2910      wpld = pixGetWpl(pixd);\n  2911      for (i = 0; i < h; i++) {\n  2912          lines = datas + i * wpls;\n  2913          lined = datad + i * wpld;\n  2914          for (j = 0; j < w; j++) {\n  2915              val = GET_DATA_BYTE(lines, j);\n  2916              val = val >> 4;  /* take top 4 bits */\n  2917              SET_DATA_QBIT(lined, j, val);\n  2918          }\n  2919      }\n  2920      pixDestroy(&pixs);\n  2921      return pixd;\n  2922  }\n  2923\n  2924\n  2925  /*---------------------------------------------------------------------------*\n  2926   *                     Top-level conversion to 1 bpp                         *\n  2927   *---------------------------------------------------------------------------*/\n  2928  /*!\n  2929   * \\brief   pixConvertTo1Adaptive()\n  2930   *\n  2931   * \\param[in]    pixs       1, 2, 4, 8, 16 or 32 bpp\n  2932   * \\return  pixd 1 bpp, or NULL on error\n  2933   *\n  2934   * <pre>\n  2935   * Notes:\n  2936   *      (1) This is a top-level function, that uses default values for\n  2937   *          adaptive thresholding, if necessary.  Otherwise, it is the same as\n  2938   *          pixConvertTo1(), which uses a global threshold for binarization.\n  2939   * </pre>\n  2940   */\n  2941  PIX *\n  2942  pixConvertTo1Adaptive(PIX     *pixs)\n  2943  {\n  2944  l_int32   d, color0, color1, rval, gval, bval;\n  2945  PIX      *pix1, *pix2, *pixd;\n  2946  PIXCMAP  *cmap;\n  2947\n  2948      PROCNAME(\"pixConvertTo1Adaptive\");\n  2949\n  2950      if (!pixs)\n  2951          return (PIX *)ERROR_PTR(\"pixs not defined\", procName, NULL);\n  2952      d = pixGetDepth(pixs);\n  2953      if (d != 1 && d != 2 && d != 4 && d != 8 && d != 16 && d != 32)\n  2954          return (PIX *)ERROR_PTR(\"depth not {1,2,4,8,16,32}\", procName, NULL);\n  2955\n  2956      cmap = pixGetColormap(pixs);\n  2957      if (d == 1) {\n  2958          if (!cmap) {\n  2959              return pixCopy(NULL, pixs);\n  2960          } else {  /* strip the colormap off, and invert if reasonable\n  2961                     for standard binary photometry.  */\n  2962              pixcmapGetColor(cmap, 0, &rval, &gval, &bval);\n  2963              color0 = rval + gval + bval;\n  2964              pixcmapGetColor(cmap, 1, &rval, &gval, &bval);\n  2965              color1 = rval + gval + bval;\n  2966              pixd = pixCopy(NULL, pixs);\n  2967              pixDestroyColormap(pixd);\n  2968              if (color1 > color0)\n  2969                  pixInvert(pixd, pixd);\n  2970              return pixd;\n  2971          }\n  2972      }\n  2973\n  2974          /* For all other depths, use 8 bpp as an intermediary */\n  2975      pix1 = pixConvertTo8(pixs, FALSE);\n  2976      pix2 = pixBackgroundNormSimple(pix1, NULL, NULL);\n  2977      pixd = pixThresholdToBinary(pix2, 180);\n  2978      pixDestroy(&pix1);\n  2979      pixDestroy(&pix2);\n  2980      return pixd;\n  2981  }\n  2982\n  2983\n  2984  /*!\n  2985   * \\brief   pixConvertTo1()\n  2986   *\n  2987   * \\param[in]    pixs       1, 2, 4, 8, 16 or 32 bpp\n  2988   * \\param[in]    threshold  for final binarization