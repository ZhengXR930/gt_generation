ugh for link */\n 382     if (NULL == (link_ptr = H5WB_actual(wb, link_size)))\n 383         HGOTO_ERROR(H5E_SYM, H5E_NOSPACE, FAIL, \"can't get actual buffer\")\n 384 \n 385     /* Create serialized form of link */\n 386     if (H5O_msg_encode(f, H5O_LINK_ID, FALSE, (unsigned char *)link_ptr, lnk) < 0)\n 387         HGOTO_ERROR(H5E_SYM, H5E_CANTENCODE, FAIL, \"can't encode link\")\n 388 \n 389     /* Open the fractal heap */\n 390     if (NULL == (fheap = H5HF_open(f, linfo->fheap_addr)))\n 391         HGOTO_ERROR(H5E_SYM, H5E_CANTOPENOBJ, FAIL, \"unable to open fractal heap\")\n 392 \n 393     /* Insert the serialized link into the fractal heap */\n 394     if (H5HF_insert(fheap, link_size, link_ptr, udata.id) < 0)\n 395         HGOTO_ERROR(H5E_SYM, H5E_CANTINSERT, FAIL, \"unable to insert link into fractal heap\")\n 396 \n 397     /* Open the name index v2 B-tree */\n 398     if (NULL == (bt2_name = H5B2_open(f, linfo->name_bt2_addr, NULL)))\n 399         HGOTO_ERROR(H5E_SYM, H5E_CANTOPENOBJ, FAIL, \"unable to open v2 B-tree for name index\")\n 400 \n 401     /* Create the callback information for v2 B-tree record insertion */\n 402     udata.common.f             = f;\n 403     udata.common.fheap         = fheap;\n 404     udata.common.name          = lnk->name;\n 405     udata.common.name_hash     = H5_checksum_lookup3(lnk->name, HDstrlen(lnk->name), 0);\n 406     udata.common.corder        = lnk->corder;\n 407     udata.common.found_op      = NULL;\n 408     udata.common.found_op_data = NULL;\n 409     /* udata.id already set in H5HF_insert() call */\n 410 \n 411     /* Insert link into 'name' tracking v2 B-tree */\n 412     if (H5B2_insert(bt2_name, &udata) < 0)\n 413         HGOTO_ERROR(H5E_SYM, H5E_CANTINSERT, FAIL, \"unable to insert record into v2 B-tree\")\n 414 \n 415     /* Check if we should create a creation order index v2 B-tree record */\n 416     if (linfo->index_corder) {\n 417         /* Open the creation order index v2 B-tree */\n 418         HD