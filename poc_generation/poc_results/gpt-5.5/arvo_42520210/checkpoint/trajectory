\\n        /* Store the fill value as the last entry in cd_values[]                                             \\\n         * Store byte by byte from least significant byte to most significant byte                           \\\n         * Plenty of space left for the fill value (from index 8 to 19)                                      \\\n         * H5O_pline_encode will byte-swap each individual cd value, but we still                            \\\n         * need to swap the cd values as a whole if we are on a BE machine.  Note                            \\\n         * that we need to make sure to put the data only in the lowest 4 bytes of                           \\\n         * each, if sizeof(unsigned) > 4.                                                                    \\\n         */                                                                                                  \\\n        if (H5T_native_order_g == H5T_ORDER_LE) {                                                            \\\n            _fv_p = (char *)&(fill_val);                                                                     \\\n            /* Copy 4 bytes at a time to each cd value */                                                    \\\n            do {                                                                                             \\\n                if (_size_rem < 4) {                                                                         \\\n                    /* Amount left to copy is smaller than a cd_value, adjust copy                           \\\n                     * size and initialize cd_value as it will not be fully                                  \\\n                     * overwritten */                                                                        \\\n                    _copy_size = _size_rem;                                                                  \\\n                    _cd_value  = (uint32_t)0;                               