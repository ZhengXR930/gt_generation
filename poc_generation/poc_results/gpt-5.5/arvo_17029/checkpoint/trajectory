       }\n        }\n        else\n        {\n            for(j = 0; j < u4_num_st_curr_before; j++)\n            {\n                ASSERT((ai4_poc_st_curr_before[j] & (u4_max_poc_lsb - 1)) != ai4_poc_lt_curr[i]);\n            }\n            for(j = 0; j < u4_num_st_curr_after; j++)\n     1  *  Parse Slice Header\n     2  * slice_header_syntax()\n     3  *\n     4  * @par Description:\n     5  *  Parse Slice Header as per  Section: 7.3.8\n     6  *\n     7  * @param[in] ps_codec\n     8  *  Pointer to codec context\n     9  *\n    10  * @returns  Error code from IHEVCD_ERROR_T\n    11  *\n    12  * @remarks\n    13  *\n    14  *\n    15  *******************************************************************************\n    16  */\n    17\n    18  IHEVCD_ERROR_T ihevcd_parse_slice_header(codec_t *ps_codec,\n    19                                           nal_header_t *ps_nal)\n    20  {\n    21      IHEVCD_ERROR_T ret = (IHEVCD_ERROR_T)IHEVCD_SUCCESS;\n    22      UWORD32 value;\n    23      WORD32 i4_value;\n    24      WORD32 i, j;\n    25      WORD32 sps_id;\n    26\n    27      pps_t *ps_pps;\n    28      sps_t *ps_sps;\n    29      slice_header_t *ps_slice_hdr;\n    30      WORD32 disable_deblocking_filter_flag;\n    31      bitstrm_t *ps_bitstrm = &ps_codec->s_parse.s_bitstrm;\n    32      WORD32 idr_pic_flag;\n    33      WORD32 pps_id;\n    34      WORD32 first_slice_in_pic_flag;\n    35      WORD32 no_output_of_prior_pics_flag = 0;\n    36      WORD8 i1_nal_unit_type = ps_nal->i1_nal_unit_type;\n    37      WORD32 num_poc_total_curr = 0;\n    38      UWORD32 slice_address;\n    39      WORD32 prev_slice_incomplete_flag = 0;\n    40\n    41      if(ps_codec->i4_slice_error == 1)\n    42          return ret;\n    43\n    44      idr_pic_flag = (NAL_IDR_W_LP == i1_nal_unit_type) ||\n    45                      (NAL_IDR_N_LP == i1_nal_unit_type);\n    46\n    47\n    48      BITS_PARSE(\"first_slice_in_pic_flag\", first_slice_in_pic_flag, ps_bitstrm, 1);\n    49