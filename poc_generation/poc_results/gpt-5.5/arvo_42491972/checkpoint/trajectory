    "content": "commit 077cf7021b27644d9995382ec2224109663bd5a6\nAuthor: daviesrob <rmd+git@sanger.ac.uk>\nDate:   Mon Sep 23 15:33:59 2024 +0100\n\n    Fix possible 1 byte underflow in find_file_extension() (#1840)\n\n    When checking for another delimiter before .gz or .bgz, the\n    pointer into the string was decremented without checking to\n    see if was at the start.  This could lead to a one byte read\n    before the start of the string when copying out the delimiter.\n\n    Credit to OSS_Fuzz\n    Fixes oss-fuzz id 71740\n\ndiff --git a/hts_internal.h b/hts_internal.h\nindex 52f29e6c..c07df8ab 100644\n--- a/hts_internal.h\n+++ b/hts_internal.h\n@@ -129,7 +129,7 @@ static inline int find_file_extension(const char *fn, char ext_out[static HTS_MA\n     if (!fn) return -1;\n     if (!delim) delim = fn + strlen(fn);\n     for (ext = delim; ext > fn && *ext != '.' && *ext != '/'; --ext) {}\n-    if (*ext == '.' &&\n+    if (*ext == '.' && ext > fn &&\n         ((delim - ext == 3 && ext[1] == 'g' && ext[2] == 'z') || // permit .sam.gz as a valid file extension\n         (delim - ext == 4 && ext[1] == 'b' && ext[2] == 'g' && ext[3] == 'z'))) // permit .vcf.bgz as a valid file extension\n     {\ngrep: ./sam.o: binary file matches\n./sam.c:4326:        if (find_file_extension(fn, extension) < 0) return -1;\n./sam.c:4359:        if (find_file_extension(fn, extension) < 0) {\ngrep: ./libhts.a: binary file matches\n./vcf.c:2962:        if (find_file_extension(fn, extension) < 0) return -1;\ngrep: ./vcf.o: binary file matches\n./hts_internal.h:130:static inline int find_file_extension(const char *fn, char ext_out[static HTS_MAX_EXT_LEN])\n   120   *\n   121   * This is needed when multi-threading and writing indices on the fly.\n   122   * At the point of writing a record we know the virtual offset for start\n   123   * and end, but that end virtual offset may be the end of the current\n   124   * block.  In standard indexing our end virtual offset becomes the start\n   125   * of the next block.  Thus to ensure bit for bit compatibility we\n   126   * detect this boundary case and fix it up here.\n   127   */\n   128  void bgzf_idx_amend_last(BGZF *fp, hts_idx_t *hidx, uint64_t offset);\n   129\n   130  static inline int find_file_extension(const char *fn, char ext_out[static HTS_MAX_EXT_LEN])\n   131  {\n   132      const char *delim = fn ? strstr(fn, HTS_IDX_DELIM) : NULL, *ext;\n   133      if (!fn) return -1;\n   134      if (!delim) delim = fn + strlen(fn);\n   135      for (ext = delim; ext > fn && *ext != '.' && *ext != '/'; --ext) {}\n   136      if (*ext == '.' &&\n   137          ((delim - ext == 3 && ext[1] == 'g' && ext[2] == 'z') || // permit .sam.gz as a valid file extension\n   138          (delim - ext == 4 && ext[1] == 'b' && ext[2] == 'g' && ext[3] == 'z'))) // permit .vcf.bgz as a valid file extension\n   139      {\n   140          for (ext--; ext > fn && *ext != '.' && *ext != '/'; --ext) {}\n   141      }\n   142      if (*ext != '.' || delim - ext > HTS_MAX_EXT_LEN || delim - ext < 4) return -1;\n   143      memcpy(ext_out, ext + 1, delim - ext - 1);\n   144      ext_out[delim - ext - 1] = '\\0';\n   145      return 0;\n   146  }\n   147\n   148  #ifdef __cplusplus\n   149  }\n   150  #endif\n   151\n   152  #endif",
