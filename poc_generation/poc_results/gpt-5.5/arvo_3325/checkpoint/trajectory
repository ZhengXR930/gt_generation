          rhealpixVertsJit[11][0] = -M_PI - EPS;\n   214          rhealpixVertsJit[11][1] = -M_FORTPI - EPS;\n   215\n   216          return pnpoly((int)sizeof(rhealpixVertsJit)/\n   217                        sizeof(rhealpixVertsJit[0]), rhealpixVertsJit, x, y);\n   218      }\n   219  }\n   220\n   221\n   222  /**\n   223   * Return the authalic latitude of latitude alpha (if inverse=0) or\n   224   * return the approximate latitude of authalic latitude alpha (if inverse=1).\n   225   * P contains the relevant ellipsoid parameters.\n   226   **/\n   227  static double auth_lat(PJ *P, double alpha, int inverse) {\n   228      struct pj_opaque *Q = P->opaque;\n   229      if (inverse == 0) {\n   230          /* Authalic latitude. */\n   231          double q = pj_qsfn(sin(alpha), P->e, 1.0 - P->es);\n   232          double qp = Q->qp;\n   233          double ratio = q/qp;\n   234\n   235          if (fabs(ratio) > 1) {\n   236              /* Rounding error. */\n   237              ratio = pj_sign(ratio);\n   238          }\n   239          return asin(ratio);\n   240      } else {\n   241          /* Approximation to inverse authalic latitude. */\n   242          return pj_authlat(alpha, Q->apa);\n   243      }\n   244  }\n   245\n   246\n   247  /**\n   248   * Return the HEALPix projection of the longitude-latitude point lp on\n   249   * the unit sphere.\n   250  **/\n   251  static XY healpix_sphere(LP lp) {\n   252      double lam = lp.lam;\n   253      double phi = lp.phi;\n   254      double phi0 = asin(2.0/3.0);\n   255      XY xy;\n   256\n   257      /* equatorial region */\n   258      if ( fabs(phi) <= phi0) {\n   259          xy.x = lam;\n   260          xy.y = 3*M_PI/8*sin(phi);\n   261      } else {\n   262          double lamc;\n   263          double sigma = sqrt(3*(1 - fabs(sin(phi))));\n   264          double cn = floor(2*lam / M_PI + 2);\n   265          if (cn >= 4) {\n   266              cn = 3;\n   267          }\n   268          lamc = -3*M_FORTPI + M_HALFPI*cn;\n   269          xy.x = lamc + (lam - lamc)*sigma;\n   270          xy.y = pj_sign(phi)*M_FORTPI*(2 - sigma);\n   271      }\n   272      return xy;\n   273  }\n   274\n   275\n   276  /**\n   277   * Return the inverse of healpix_sphere().\n   278  **/\n   279  static LP healpix_sphere_inverse(XY xy) {\n   280      LP lp;\n   281      double x = xy.x;\n   282      double y = xy.y;\n   283      double y0 = M_FORTPI;\n   284\n   285      /* Equatorial region. */\n   286      if (fabs(y) <= y0) {\n   287          lp.lam = x;\n   288          lp.phi = asin(8*y/(3*M_PI));\n   289      } else if (fabs(y) < M_HALFPI) {\n   290          double cn = floor(2*x/M_PI + 2);\n   291          double xc, tau;\n   292          if (cn >= 4) {\n   293              cn = 3;\n   294          }\n   295          xc = -3*M_FORTPI + M_HALFPI*cn;\n   296          tau = 2.0 - 4*fabs(y)/M_PI;\n   297          lp.lam = xc + (x - xc)/tau;\n   298          lp.phi = pj_sign(y)*asin(1.0 - pow(tau, 2)/3.0);\n   299      } else {\n   300          lp.lam = -M_PI;\n   301          lp.phi = pj_sign(y)*M_HALFPI;\n   302      }\n   303      return (lp);\n   304  }\n   305\n   306\n   307  /**\n   308   * Return the vector sum a + b, where a and b are 2-dimensional vectors.\n   309   * @param ret holds a + b.\n   310   **/\n   311  static void vector_add(double a[2], double b[2], double *ret) {\n   312      int i;\n   313      for(i = 0; i < 2; i++) {\n   314          ret[i] = a[i] + b[i];\n   315      }\n   316  }\n   317\n   318\n   319  /**\n   320   * Return the vector difference a - b, where a and b are 2-dimensional vectors.\n   321   * @param ret holds a - b.\n   322   **/\n   323  static void vector_sub(double a[2], double b[2], double*ret) {\n   324      int i;\n   325      for(i = 0; i < 2; i++) {\n   326          ret[i] = a[i] - b[i];\n   327      }\n   328  }\n   329\n   330\n   331  /**\n   332   * Return the 2 x 1 matrix product a*b, where a is a 2 x 2 matrix and\n   33