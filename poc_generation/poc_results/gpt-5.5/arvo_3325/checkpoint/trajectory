 426              } else if (y >= x + M_FORTPI - EPS && y < -x - 5*M_FORTPI - EPS) {\n   427                  capmap.cn = (south_square + 3) % 4;\n   428              } else {\n   429                  capmap.cn = south_square;\n   430              }\n   431          }\n   432      }\n   433      return capmap;\n   434  }\n   435\n   436\n   437  /**\n   438   * Rearrange point (x, y) in the HEALPix projection by\n   439   * combining the polar caps into two polar squares.\n   440   * Put the north polar square in position north_square and\n   441   * the south polar square in position south_square.\n   442   * If inverse=1, then uncombine the polar caps.\n   443   * @param north_square integer between 0 and 3.\n   444   * @param south_square integer between 0 and 3.\n   445   **/\n   446  static XY combine_caps(double x, double y, int north_square, int south_square,\n   447                         int inverse) {\n   448      XY xy;\n   449      double v[2];\n   450      double c[2];\n   451      double vector[2];\n   452      double v_min_c[2];\n   453      double ret_dot[2];\n   454      double (*tmpRot)[2];\n   455      int pole = 0;\n   456\n   457      CapMap capmap = get_cap(x, y, north_square, south_square, inverse);\n   458      if (capmap.region == equatorial) {\n   459          xy.x = capmap.x;\n   460          xy.y = capmap.y;\n   461          return xy;\n   462      }\n   463\n   464      v[0] = x; v[1] = y;\n   465      c[0] = capmap.x; c[1] = capmap.y;\n   466\n   467      if (inverse == 0) {\n   468          /* Rotate (x, y) about its polar cap tip and then translate it to\n   469             north_square or south_square. */\n   470\n   471          if (capmap.region == north) {\n   472              pole = north_square;\n   473              tmpRot = rot[get_rotate_index(capmap.cn - pole)];\n   474          } else {\n   475              pole = south_square;\n   476              tmpRot = rot[get_rotate_index(-1*(capmap.cn - pole))];\n   477          }\n 