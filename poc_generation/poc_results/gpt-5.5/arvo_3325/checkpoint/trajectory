*/\n   538      if (in_image(xy.x, xy.y, 0, 0, 0) == 0) {\n   539          lp.lam = HUGE_VAL;\n   540          lp.phi = HUGE_VAL;\n   541          pj_ctx_set_errno(P->ctx, -15);\n   542          return lp;\n   543      }\n   544      lp = healpix_sphere_inverse(xy);\n   545      lp.phi = auth_lat(P, lp.phi, 1);\n   546      return lp;\n   547  }\n   548\n   549\n   550  static XY s_rhealpix_forward(LP lp, PJ *P) { /* sphere */\n   551      struct pj_opaque *Q = P->opaque;\n   552\n   553      XY xy = healpix_sphere(lp);\n   554      return combine_caps(xy.x, xy.y, Q->north_square, Q->south_square, 0);\n   555  }\n   556\n   557\n   558  static XY e_rhealpix_forward(LP lp, PJ *P) { /* ellipsoid */\n   559      struct pj_opaque *Q = P->opaque;\n   560      XY xy;\n   561      lp.phi = auth_lat(P, lp.phi, 0);\n   562      xy = healpix_sphere(lp);\n   563      return combine_caps(xy.x, xy.y, Q->north_square, Q->south_square, 0);\n   564  }\n   565\n   566\n   567  static LP s_rhealpix_inverse(XY xy, PJ *P) { /* sphere */\n   568      struct pj_opaque *Q = P->opaque;\n   569\n   570      /* Check whether (x, y) lies in the rHEALPix image. */\n   571      if (in_image(xy.x, xy.y, 1, Q->north_square, Q->south_square) == 0) {\n   572          LP lp;\n   573          lp.lam = HUGE_VAL;\n   574          lp.phi = HUGE_VAL;\n   575          pj_ctx_set_errno(P->ctx, -15);\n   576          return lp;\n   577      }\n   578      xy = combine_caps(xy.x, xy.y, Q->north_square, Q->south_square, 1);\n   579      return healpix_sphere_inverse(xy);\n   580  }\n   581\n   582\n   583  static LP e_rhealpix_inverse(XY xy, PJ *P) { /* ellipsoid */\n   584      struct pj_opaque *Q = P->opaque;\n   585      LP lp = {0.0,0.0};\n   586\n   587      /* Check whether (x, y) lies in the rHEALPix image. */\n   588      if (in_image(xy.x, xy.y, 1, Q->north_square, Q->south_square) == 0) {\n   589          lp.lam = HUGE_VAL;\n   590          lp.phi = HUGE_VAL;\n   591          pj_ctx_set_errno(P->ctx