 accept whatever is being handed to them.\n   156\n   157      The P->left and P->right elements indicate isomorphism.\n   158\n   159      For classic proj style projections, they both have the\n   160      value PJ_IO_UNITS_CLASSIC (default initialization), indicating\n   161      that the forward driver expects angular input coordinates, and\n   162      provides linear output coordinates.\n   163\n   164      Newer projections may set P->left and P->right to either\n   165      PJ_IO_UNITS_METERS, PJ_IO_UNITS_RADIANS or PJ_IO_UNITS_ANY,\n   166      to indicate their I/O style.\n   167\n   168      For the forward driver, left indicates input coordinate\n   169      type, while right indicates output coordinate type.\n   170\n   171      For the inverse driver, left indicates output coordinate\n   172      type, while right indicates input coordinate type.\n   173\n   174  *********************************************************************/\n   175\n   176\n   177\n   178\n   179  static PJ_OBS pipeline_forward_obs (PJ_OBS point, PJ *P) {\n   180      int i, first_step, last_step;\n   181\n   182      first_step = 1;\n   183      last_step  = P->opaque->steps + 1;\n   184\n   185      for (i = first_step;  i != last_step;  i++) {\n   186          proj_log_trace (P, \"In[%2.2d]: %20.15g %20.15g %20.15g - %20.20s\",\n   187              i-first_step, point.coo.xyz.x, point.coo.xyz.y, point.coo.xyz.z,\n   188              P->opaque->pipeline[i]->descr\n   189          );\n   190\n   191          if (P->opaque->omit_forward[i])\n   192              continue;\n   193          if (P->opaque->reverse_step[i])\n   194              point = proj_trans_obs (P->opaque->pipeline[i], PJ_INV, point);\n   195          else\n   196              point = proj_trans_obs (P->opaque->pipeline[i], PJ_FWD, point);\n   197          if (P->opaque->depth < PIPELINE_STACK_SIZE)\n   198              P->opaque->stack[P->opaque->depth++] = point;\n   199      }\n   200      proj_log_trace (P, \"Out[ ]: %20.15g %20.15g %20.15g\", point.coo.xyz.x, point.coo.xyz.y, point.coo.xyz.z);\n   201\n   202      P->opaque->depth = 0;    /* Clear the stack */\n   203      return point;\n   204  }\n   205\n   206\n   207  static PJ_OBS pipeline_reverse_obs (PJ_OBS point, PJ *P) {\n   208      int i, first_step, last_step;\n   209\n   210      first_step = P->opaque->steps;\n   211      last_step  =  0;\n   212      for (i = first_step;  i != last_step;  i--) {\n   213          proj_log_trace (P, \"In[%2.2d]: %20.15g %20.15g %20.15g - %.4f %.4f\",\n   214              i - 1, point.coo.xyz.x, point.coo.xyz.y, point.coo.xyz.z,\n   215              P->opaque->pipeline[i]->a, P->opaque->pipeline[i]->rf\n   216          );\n   217          if (P->opaque->omit_inverse[i])\n   218              continue;\n   219          if (P->opaque->reverse_step[i])\n   220              point = proj_trans_obs (P->opaque->pipeline[i], PJ_FWD, point);\n   221          else\n   222              point = proj_trans_obs (P->opaque->pipeline[i], PJ_INV, point);\n   223          if (P->opaque->depth < PIPELINE_STACK_SIZE)\n   224              P->opaque->stack[P->opaque->depth++] = point;\n   225      }\n   226      proj_log_trace (P, \"Out[ ]: %20.15g %20.15g %20.15g\", point.coo.xyz.x, point.coo.xyz.y, point.coo.xyz.z);\n   227\n   228      P->opaque->depth = 0;    /* Clear the stack */\n   229      return point;\n   230  }\n   231\n   232\n   233  /* Delegate the work to pipeline_forward_obs() */\n   234  static XYZ pipeline_forward_3d (LPZ lpz, PJ *P) {\n   235      PJ_OBS point = proj_obs_null;\n   236      point.coo.lpz = lpz;\n   237      point = pipeline_forward_obs (point, P);\n   238      return point.coo.xyz;\n   239  }\n   240\n   241  /* Delegate the work to pipeline_reverse_obs() */\n   242  static LPZ pipeline_reverse_3d (XYZ xyz, PJ *P) {\n   243      PJ_OBS point = proj_obs_null;\n   244      point.coo.xyz = xyz;\n   245      point = pipeline_reverse_obs (point, P);\n   246      return point.coo.lpz;\n   247  }\n   248\n   249  static XY pipeline_forward (LP lp, PJ *P) {\n   250      PJ_OBS point = proj_obs_null;\n   251      point.coo.lp = lp;\n   252      point = pipeline_forward_obs (point, P);\n   253      return point.coo.xy;\n   254  }\n   255\n   256  static LP pipeline_reverse (XY xy, PJ *P) {\n   257      PJ_OBS point = proj_obs_null;\n   258      point.coo.xy = xy;\n   259      point = pipeline_reverse_obs (point, P);\n   260      return point.coo.lp;\nsrc/pj_internal.c:68:PJ_OBS pj_fwdobs (PJ_OBS obs, PJ *P) {\nsrc/pj_internal.c:69:    if (0!=P->fwdobs) {\nsrc/pj_internal.c:70:        obs  =  P->fwdobs (obs, P);\nsrc/pj_internal.c:86:PJ_OBS pj_invobs (PJ_OBS obs, PJ *P) {\nsrc/pj_internal.c:87:    if (0!=P->invobs) {\nsrc/pj_internal.c:88:        obs  =  P->invobs (obs, P);\nsrc/pj_internal.c:108:    if (0!=P->fwdobs) {\nsrc/pj_internal.c:111:        obs  =  P->fwdobs (obs, P);\nsrc/pj_internal.c:130:    if (0!=P->invobs) {\nsrc/pj_internal.c:133:        obs  =  P->invobs (obs, P);\nsrc/PJ_pipeline.c:361:    P->fwdobs =  pipeline_forward_obs;\nsrc/PJ_pipeline.c:362:    P->invobs =  pipeline_reverse_obs;\nsrc/pj_obs_api.c:110:                u  =  pj_fwdobs (o, P);\nsrc/pj_obs_api.c:111:                o  =  pj_invobs (u, P);\nsrc/pj_obs_api.c:114:                u  =  pj_invobs (o, P);\nsrc/pj_obs_api.c:115:                o  =  pj_fwdobs (u, P);\nsrc/pj_obs_api.c:134:            return pj_fwdobs (obs, P);\nsrc/pj_obs_api.c:136:            return  pj_invobs (obs, P);\nsrc/pj_obs_api.c:615:    info.has_inverse = (P->inv != 0 || P->inv3d != 0 || P->invobs != 0);\nsrc/projects.h:249:    PJ_OBS (*fwdobs)(PJ_OBS, PJ *);\nsrc/projects.h:250:    PJ_OBS (*invobs)(PJ_OBS, PJ *);\nsrc/proj_internal.h:78:PJ_OBS pj_fwdobs (PJ_OBS obs, PJ *P);\nsrc/proj_internal.h:79:PJ_OBS pj_invobs (PJ_OBS obs, PJ *P);\nsrc/PJ_vgridshift.c:92:    P->fwdobs = forward_obs;\nsrc/PJ_vgridshift.c:93:    P->invobs = reverse_obs;\nsrc/PJ_helmert.c:490:    P->fwdob