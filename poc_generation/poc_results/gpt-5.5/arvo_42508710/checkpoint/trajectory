    "content": "commit a92f3c847f445800e631a43bc2ab5894fedbc841\nAuthor: Cherma Rajan A <cherma.rajan@ittiam.com>\nDate:   Thu Feb 17 20:14:47 2022 +0530\n\n    Avoid abs_sum_level computation conditionally\n\n    abs_sum_level is needed to decide the job scheduling order of\n    pack bitstream multi-threading. The computation can be avoided\n    when MT is disabled or multiple tiles are not used. This change\n    could avoid additional overhead due to computation of\n    abs_sum_level.\n\n    Speed data for RT preset.\n         Instruction Count\n    cpu    Reduction(%)\n     7       0.189\n     8       0.236\n     9       0.434\n    10       0.474\n\n    Change-Id: Id83f97b023f6e5275d1bfd59b889bcfb99dee067\n---\n av1/encoder/bitstream.c   |  7 ++++---\n av1/encoder/encodeframe.c |  2 ++\n av1/encoder/encoder.h     |  5 +++++\n av1/encoder/encodetxb.c   | 15 ++++++++++++---\n 4 files changed, 23 insertions(+), 6 deletions(-)\n\ndiff --git a/av1/encoder/bitstream.c b/av1/encoder/bitstream.c\nindex 91e03d752b..4ac60d5ae9 100644\n--- a/av1/encoder/bitstream.c\n+++ b/av1/encoder/bitstream.c\n@@ -3940,8 +3940,8 @@ static void write_tile_obu_size(AV1_COMP *const cpi, uint8_t *const dst,\n // number of required number of workers based on setup time overhead and job\n // dispatch time overhead for given tiles and available workers.\n int calc_pack_bs_mt_workers(const TileDataEnc *tile_data, int num_tiles,\n-                            int avail_workers) {\n-  if (AOMMIN(avail_workers, num_tiles) <= 1) return 1;\n+                            int avail_workers, bool pack_bs_mt_enabled) {\n+  if (!pack_bs_mt_enabled) return 1;\n\n   uint64_t frame_abs_sum_level = 0;\n\n@@ -3981,7 +3981,8 @@ static INLINE uint32_t pack_tiles_in_tg_obus(\n   const int num_tiles = tile_rows * tile_cols;\n\n   const int num_workers = calc_pack_bs_mt_workers(\n-      cpi->tile_data, num_tiles, cpi->mt_info.num_mod_workers[MOD_PACK_BS]);\n+      cpi->tile_data, num_tiles, cpi->mt_info.num_mod_workers[MOD_PACK_BS],\n+      cpi->mt_info.pack_bs_mt_enabled);\n\n   if (num_workers > 1) {\n     av1_write_tile_obu_mt(cpi, dst, &total_size, saved_wb, obu_extension_header,\ndiff --git a/av1/encoder/encodeframe.c b/av1/encoder/encodeframe.c\nindex 7794a20ab9..46f623e473 100644\n--- a/av1/encoder/encodeframe.c\n+++ b/av1/encoder/encodeframe.c\n@@ -1577,6 +1577,8 @@ static AOM_INLINE void encode_frame_internal(AV1_COMP *cpi) {\n   enc_row_mt->sync_read_ptr = av1_row_mt_sync_read_dummy;\n   enc_row_mt->sync_write_ptr = av1_row_mt_sync_write_dummy;\n   mt_info->row_mt_enabled = 0;\n+  mt_info->pack_bs_mt_enabled = AOMMIN(mt_info->num_mod_workers[MOD_PACK_BS],\n+                                       cm->tiles.cols * cm->tiles.rows) > 1;\n\n   if (oxcf->row_mt && (mt_info->num_workers > 1)) {\n     mt_info->row_mt_enabled = 1;\ndiff --git a/av1/encoder/encoder.h b/av1/encoder/encoder.h\nindex e1752628dc..b8a8dee11c 100644\n--- a/av1/encoder/encoder.h\n+++ b/av1/encoder/encoder.h\n@@ -1618,6 +1618,11 @@ typedef struct MultiThreadInfo {\n    */\n   bool row_mt_enabled;\n\n+  /*!\n+   * When set, indicates that multi-threading for bitstream packing is enabled.\n+   */\n+  bool pack_bs_mt_enabled;\n+\n   /*!\n    * Encoder row multi-threading data.\n    */\ndiff --git a/av1/encoder/encodetxb.c b/av1/encoder/encodetxb.c\nindex 1e570591ea..4510070ff9 100644\n--- a/av1/encoder/encodetxb.c\n+++ b/av1/encoder/encodetxb.c\n@@ -629,7 +629,10 @@ void av1_update_and_record_txb_context(int plane, int block, int blk_row,\n       const int coeff_ctx = coeff_contexts[pos];\n       const tran_low_t v = qcoeff[pos];\n       const tran_low_t level = abs(v);\n-      td->abs_sum_level += level;\n+      /* abs_sum_level is needed to decide the job scheduling order of\n+       * pack bitstream multi-threading. This data is not needed if\n+       * multi-threading is disabled. */\n+      if (cpi->mt_info.pack_bs_mt_enabled) td->abs_sum_level += level;\n\n       if (allow_update_cdf) {\n         if