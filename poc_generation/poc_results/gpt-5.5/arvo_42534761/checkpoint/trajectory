  432                                                              \"too many roles\");\n   433                                          return FALSE;\n   434                                  }\n   435                                  entity->roles[entity_role_cnt++] = role;\n   436                          }\n   437                  } else {\n   438                          g_debug(\"unhandled tag %s from %s\",\n   439                                  fu_coswid_tag_to_string(tag_id),\n   440                                  fu_coswid_tag_to_string(FU_COSWID_TAG_ENTITY));\n   441                  }\n   442          }\n   443\n   444          /* success */\n   445          g_ptr_array_add(priv->entities, g_steal_pointer(&entity));\n   446          return TRUE;\n   447  }\n   448  #endif\n   449\n   450  static gboolean\n   451  fu_coswid_firmware_parse(FuFirmware *firmware,\n   452                           GInputStream *stream,\n   453                           gsize offset,\n   454                           FwupdInstallFlags flags,\n   455                           GError **error)\n   456  {\n   457  #ifdef HAVE_CBOR\n   458          FuCoswidFirmware *self = FU_COSWID_FIRMWARE(firmware);\n   459          FuCoswidFirmwarePrivate *priv = GET_PRIVATE(self);\n   460          struct cbor_load_result result = {0x0};\n   461          struct cbor_pair *pairs = NULL;\n   462          g_autoptr(cbor_item_t) item = NULL;\n   463          g_autoptr(GBytes) fw = NULL;\n   464\n   465          fw = fu_input_stream_read_bytes(stream, offset, G_MAXSIZE, error);\n   466          if (fw == NULL)\n   467                  return FALSE;\n   468          item = cbor_load(g_bytes_get_data(fw, NULL), g_bytes_get_size(fw), &result);\n   469          if (item == NULL) {\n   470                  g_set_error(error,\n   471                              FWUPD_ERROR,\n   472                              FWUPD_ERROR_NOT_SUPPORTED,\n   473                              \"failed to parse CBOR at offset 0x%x: 0x%x\",\n   474                              (guint)result.error.position,\n   475                              result.error.code);\n   476                  return FALSE;\n   477          }\n   478          fu_firmware_set_size(firmware, result.read);\n   479\n   480          /* pretty-print the result */\n   481          if (g_getenv(\"FWUPD_CBOR_VERBOSE\") != NULL) {\n   482                  cbor_describe(item, stdout);\n   483                  fflush(stdout);\n   484          }\n   485\n   486          /* sanity check */\n   487          if (!cbor_isa_map(item)) {\n   488                  g_set_error_literal(error,\n   489                                      FWUPD_ERROR,\n   490                                      FWUPD_ERROR_INVALID_DATA,\n   491                                      \"root item is not a map\");\n   492                  return FALSE;\n   493          }\n   494\n   495          /* parse out anything interesting */\n   496          pairs = cbor_map_handle(item);\n   497          for (gsize i = 0; i < cbor_map_size(item); i++) {\n   498                  FuCoswidTag tag_id = cbor_get_uint8(pairs[i].key);\n   499\n   500                  /* identity can be specified as a string or in binary */\n   501                  if (tag_id == FU_COSWID_TAG_TAG_ID) {\n   502                          g_autofree gchar *str = NULL;\n   503                          if (cbor_isa_string(pairs[i].value)) {\n   504                                  str = fu_coswid_firmware_strndup(pairs[i].value);\n   505                          } else if (cbor_isa_bytestring(pairs[i].value) &&\n   506                                     cbor_bytestring_length(pairs[i].value) == 16) {\n   507                                  str = fwupd_guid_to_string(\n   508                                      (const fwupd_guid_t *)cbor_bytestring_handle(pairs[i].value),\n   509                                      FWUPD_GUID_FLAG_NONE);\n   510                          }\n   511                          if (str != NULL)\n   512                                  fu_firmware_set_id(firmware, str);\n   513                  } else if (tag_id == FU_COSWID_TAG_SOFTWARE_NAME) {\n   514                          priv->product = fu_coswid_firmware_strndup(pairs[i].value);\n   515                  } else if (tag_id == FU_COSWID_TAG_SOFTWARE_VERSION) {\n   516                          g_autofree gchar *str = fu_coswid_firmware_strndup(pairs[i].value);\n   517                          fu_firmware_set_version(firmware, str);\n   518                  } else if (tag_id == FU_COSWID_TAG_VERSION_SCHEME) {\n   519                          priv->version_scheme = cbor_get_uint16(pairs[i].value);\n   520                  } else if (tag_id == FU_COSWID_TAG_SOFTWARE_META) {\n   521                          if (!fu_coswid_firmware_parse_one_or_many(self,\n   522                                                                    pairs[i].value,\n   523                                                                    fu_coswid_firmware_parse_meta,\n   524                                                                    NULL, /* user_data */\n   525                                                                    error))\n   526                                  return FALSE;\n   527                  } else if (tag_id == FU_COSWID_TAG_LINK) {\n   528                          if (!fu_coswid_firmware_parse_one_or_many(self,\n   529                                                                    pairs[i].value,\n   530                                                                    fu_coswid_firmware_parse_link,\n   531                                                                    NULL, /* user_data */\n   532                                                                    error))\n   533                                  return FALSE;\n   534                  } else if (tag_id == FU_COSWID_TAG_PAYLOAD) {\n   535                          if (!fu_coswid_firmware_parse_one_or_many(self,\n   536                                                                    pairs[i].value,\n   537                                                                    fu_coswid_firmware_parse_payload,\n   538                                                                    NULL, /* user_data */\n   539                                                                    error))\n   540                                  return FALSE;\n   541                  } else if (tag_id == FU_COSWID_TAG_ENTITY) {\n   542                          if (!fu_coswid_firmware_parse_one_or_many(self,\n   543                                                                    pairs[i].value,\n   544                                                                    fu_coswid_firmware_parse_entity,\n   545                                                                    NULL, /* user_data */\n   546                                                                    error))\n   547                                  return FALSE;\n   548                  } else {\n   549                          g_debug(\"unhandled tag %s from root\", fu_coswid_tag_to_string(tag_id));\n   550                  }\n   551          }\n   552\n   553          /* device not supported */\n   554          if (fu_firmware_get_id(firmware) == NULL && fu_firmware_get_version(firmware) == NULL &&\n   555              priv->product == NULL && priv->entities->len == 0 && priv->links->len == 0) {\n   556                  g_set_error_literal(error,\n   557                                      FWUPD_ERROR,\n   558                                      FWUPD_ERROR_NOT_SUPPORTED,\n   559                                      \"not enough SBoM data\");\n   560                  return FALSE;\n   561          }\n   562\n   563          /* success */\n   564          return TRUE;\n   565  #else\n   566          g_set_error_literal(error,\n   567                              FWUPD_ERROR,\n   568                              FWUPD_ERROR_NOT_SUPPORTED,\n   569                              \"not compiled with CBOR support\");\n   570          return FALSE;\n   571  #endif\n   572  }\n   573\n   574  static gchar *\n   575  fu_coswid_firmware_get_checksum(FuFirmware *firmware, GChecksumType csum_kind, GError **error)\n   576  {\n   577          FuCoswidFirmware *self = FU_COSWID_FIRMWARE(firmware);\n   578          FuCoswidFirmwarePrivate *priv = GET_PRIVATE(self);\n   579          FuCoswidHashAlg alg_id = FU_COSWID_HASH_ALG_UNKNOWN;\n   580          struct {\n   581                  GChecksumType kind;\n   582                  FuCoswidHashAlg alg_id;\n   583          } csum_kinds[] = {{G_CHECKSUM_SHA256, FU_COSWID_HASH_ALG_SHA256},\n   584                            {G_CHECKSUM_SHA384, FU_COSWID_HASH_ALG_SHA384},\n   585                            {G_CHECKSUM_SHA512, FU_COSWID_HASH_ALG_SHA512},\n   586                            {0, FU_COSWID_HASH_ALG_UNKNOWN}};\n   587\n   588          /* convert to FuCoswidHashAlg */\n   589          for (guint i = 0; csum_kinds[i].kind != 0; i++) {\n   590                  if (csum_kinds[i].kind == csum_kind) {\n   591                          alg_id = csum_kinds[i].alg_id;\n   592                          break;\n   593                  }\n   594          }\n   595          if (alg_id == FU_COSWID_HASH_ALG_UNKNOWN) {\n   596                  g_set_error(error,\n   597                              FWUPD_ERROR,\n   598                              FWUPD_ERROR_NOT_SUPPORTED,\n   599                              \"cannot convert %s\",\n   600                              fwupd_checksum_type_to_string_display(csum_kind));\n   601                  return NULL;\n   602          }\n   603\n   604          /* find the correct hash kind */\n   605          for (guint i = 0; i < priv->payloads->len; i++) {\n   606                  FuCoswidFirmwarePayload *payload = g_ptr_array_index(priv->payloads, i);\n   607                  for (guint j = 0; j < payload->hashes->len; j++) {\n   608                          FuCoswidFirmwareHash *hash = g_ptr_array_index(payload->hashes, j);\n   609                          if (hash->alg_id == alg_id)\n   610                                  return fu_byte_array_to_string(hash->value);\n   611                  }\n   612          }\n   613          g_set_error(error,\n   614                      FWUPD_ERROR,\n   615                      FWUPD_ERROR_NOT_SUPPORTED,\n   616                      \"no hash kind %s\",\n   617                      fwupd_checksum_type_to_string_display(csum_kind));\n   618          return NULL;\n   619  }\n   620\n   621  #ifdef HAVE_CBOR\n   622  static void\n   623  fu_coswid_firmware_write_tag_string(cbor_item_t *root, FuCoswidTag tag, const gchar *item)\n   624  {\n   625          g_autoptr(cbor_item_t) key = cbor_build_uint8(tag);\n   626          g_autoptr(cbor_item_t) val = cbor_build_string(item);\n   627          if (!cbor_map_add(root, (struct cbor_pair){.key = key, .value = val}))\n   628                  g_critical(\"failed to push to indefinite map\");\n   629  }\n   630\n   631  static void\n   632  fu_coswid_firmware_write_tag_bytestring(cbor_item_t *root,\n   633                                          FuCoswidTag tag,\n   634                                          const guint8 *buf,\n   635                                          gsize bufsz)\n   636  {\n   637          g_autoptr(cbor_item_t) key = cbor_build_uint8(tag);\n   638          g_autoptr(cbor_item_t) val = cbor_build_bytestring((cbor_data)buf, bufsz);\n   639          if (!cbor_map_add(root, (struct cbor_pair){.key = key, .value = val}))\n   640                  g_critical(\"failed to push to indefinite map\");\n   641  }\n   642\n   643  static void\n   644  fu_coswid_firmware_write_tag_bool(cbor_item_t *root, FuCoswidTag tag, gboolean item)\n   645  {\n   646          g_autoptr(cbor_item_t) key = cbor_build_uint8(tag);\n   647          g_autoptr(cbor_item_t) val = cbor_build_bool(item);\n   648          if (!cbor_map_add(root, (struct cbor_pair){.key = key, .value = val}))\n   649                  g_critical(\"failed to push to indefinite map\");\n   650  }\n   651\n   652  static void\n   653  fu_coswid_firmware_write_tag_uint16(cbor_item_t *root, FuCoswidTag tag, guint16 item)\n   654  {\n   655          g_autoptr(cbor_item_t) key = cbor_build_uint8(tag);\n   656          g_autoptr(cbor_item_t) val = cbor_build_uint16(item);\n   657          if (!cbor_map_add(root, (struct cbor_pair){.key = key, .value = val}))\n   658                  g_critical(\"failed to push to indefinite map\");\n   659  }\n   660\n   661  static void\n   662  fu_coswid_firmware_write_tag_uint64(cbor_item_t *root, FuCoswidTag tag, guint64 item)\n   663  {\n   664          g_autoptr(cbor_item_t) key = cbor_build_uint8(tag);\n   665          g_autoptr(cbor_item_t) val = cbor_build_uint64(item);\n   666          if (!cbor_map_add(root, (struct cbor_pair){.key = key, .value = val}))\n   667                  g_critical(\"failed to push to indefinite map\");\n   668  }\n   669\n   670  static void\n   671  fu_coswid_firmware_write_tag_int8(cbor_item_t *root, FuCoswidTag tag, gint8 item)\n   672  {\n   673          g_autoptr(cbor_item_t) key = cbor_build_uint8(tag);\n   674          g_autoptr(cbor_item_t) val = cbor_new_int8();\n   675          if (item >= 0) {\n   676                  cbor_set_uint8(val, item);\n   677          } else {\n   678                  cbor_set_uint8(val, 0xFF - item);\n   679                  cbor_mark_negint(val);\n   680          }\n   681          if (!cbor_map_add(root, (struct cbor_pair){.key = key, .value = val}))\n   682                  g_critical(\"failed to push to indefinite map\");\n   683  }\n   684\n   685  static void\n   686  fu_coswid_firmware_write_tag_item(cbor_item_t *root, FuCoswidTag tag, cbor_item_t *item)\n   687  {\n   688          g_autoptr(cbor_item_t) key = cbor_build_uint8(tag);\n   689          if (!cbor_map_add(root, (struct cbor_pair){.key = key, .value = item}))\n   690                  g_critical(\"failed to push to indefinite map\");\n   691  }\n   692\n   693  static void\n   694  fu_coswid_firmware_write_hash(cbor_item_t *root, FuCoswidFirmwareHash *hash)\n   695  {\n   696          g_autoptr(cbor_item_t) item_hash = cbor_new_definite_array(2);\n   697          g_autoptr(cbor_item_t) item_hash_alg_id = cbor_build_uint8(hash->alg_id);\n   698          g_autoptr(cbor_item_t) item_hash_value =\n   699              cbor_build_bytestring(hash->value->data, hash->value->len);\n   700          if (!cbor_array_push(item_hash, item_hash_alg_id))\n   701                  g_critical(\"failed to push to definite array\");\n   702          if (!cbor_array_push(item_hash, item_hash_value))\n   703                  g_critical(\"failed to push to definite array\");\n   704          if (!cbor_array_push(root, item_hash))\n   705                  g_critical(\"failed to push to indefinite array\");\n   706  }\n   707\n   708  static void\n   709  fu_coswid_firmware_write_payload(cbor_item_t *root, FuCoswidFirmwarePayload *payload)\n   710  {\n   711          g_autoptr(cbor_item_t) item_payload = cbor_new_indefinite_map();\n   712          g_autoptr(cbor_item_t) item_file = cbor_new_indefinite_map();\n   713          if (payload->name != NULL) {\n   714                  fu_coswid_firmware_write_tag_string(item_file,\n   715                                                      FU_COSWID_TAG_FS_NAME,\n   716                                                      payload->name);\n   717          }\n   718          if (payload->size != 0) {\n   719                  fu_coswid_firmware_write_tag_uint64(item_file, FU_COSWID_TAG_SIZE, payload->size);\n   720          }\n   721          if (payload->hashes->len > 0) {\n   722                  g_autoptr(cbor_item_t) item_hashes = cbor_new_indefinite_array();\n   723                  for (guint j = 0; j < payload->hashes->len; j++) {\n   724                          FuCoswidFirmwareHash *hash = g_ptr_array_index(payload->hashes, j);\n   725                          fu_coswid_firmware_write_hash(item_hashes, hash);\n   726                  }\n   727                  fu_coswid_firmware_write_tag_item(item_file, FU_COSWID_TAG_HASH, item_hashes);\n   728          }\n   729          fu_coswid_firmware_write_tag_item(item_payload, FU_COSWID_TAG_FILE, item_file);\n   730          if (!cbor_array_push(root, item_payload))\n   731                  g_critical(\"failed to push to indefinite array\");\n   732  }\n   733  #endif\n   734\n   735  static GByteArray *\n   736  fu_coswid_firmware_write(FuFirmware *firmware, GError **error)\n   737  {\n   738  #ifdef HAVE_CBOR\n   739          FuCoswidFirmware *self = FU_COSWID_FIRMWARE(firmware);\n   740          FuCoswidFirmwarePrivate *priv = GET_PRIVATE(self);\n   741          gsize buflen;\n   742          gsize bufsz = 0;\n   743          g_autofree guchar *buf = NULL;\n   744          g_autoptr(cbor_item_t) root = cbor_new_indefinite_map();\n   745          g_autoptr(cbor_item_t) item_meta = cbor_new_indefinite_map();\n   746\n   747          /* preallocate the map structure */\n   748          fu_coswid_firmware_write_tag_string(root, FU_COSWID_TAG_LANG, \"en-US\");\n   749          if (fu_firmware_get_id(firmware) != NULL) {\n   750                  fwupd_guid_t uuid = {0};\n   751                  if (fwupd_guid_from_string(fu_firmware_get_id(firmware),\n   752                                             &uuid,\n   753                                             FWUPD_GUID_FLAG_NONE,\n   754                                             NULL)) {\n   755                          fu_coswid_firmware_write_tag_bytestring(root,\n   756                                                                  FU_COSWID_TAG_TAG_ID,\n   757                                                                  (const guint8 *)&uuid,\n   758                                            