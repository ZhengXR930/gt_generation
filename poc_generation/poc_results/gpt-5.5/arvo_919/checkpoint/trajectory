    "content": "===src/prep.cc===\n     1  // Copyright (c) 2009-2017 The OTS Authors. All rights reserved.\n     2  // Use of this source code is governed by a BSD-style license that can be\n     3  // found in the LICENSE file.\n     4\n     5  #include \"prep.h\"\n     6\n     7  // prep - Control Value Program\n     8  // http://www.microsoft.com/typography/otspec/prep.htm\n     9\n    10  namespace ots {\n    11\n    12  bool OpenTypePREP::Parse(const uint8_t *data, size_t length) {\n    13    Buffer table(data, length);\n    14\n    15    if (length >= 128 * 1024u) {\n    16      return Error(\"table length %ld > 120K\", length);  // almost all prep tables are less than 9k bytes.\n    17    }\n    18\n    19    if (!table.Skip(length)) {\n    20      return Error(\"Failed to read table of length %ld\", length);\n    21    }\n    22\n    23    this->m_data = data;\n    24    this->m_length = length;\n    25    return true;\n    26  }\n    27\n    28  bool OpenTypePREP::Serialize(OTSStream *out) {\n    29    if (!out->Write(this->m_data, this->m_length)) {\n    30      return Error(\"Failed to write table length\");\n    31    }\n    32\n    33    return true;\n    34  }\n    35\n    36  bool OpenTypePREP::ShouldSerialize() {\n    37    return Table::ShouldSerialize() &&\n    38           // this table is not for CFF fonts.\n    39           GetFont()->GetTable(OTS_TAG_GLYF) != NULL;\n    40  }\n    41\n    42  }  // namespace ots\n===src/cvt.cc===\n     1  // Copyright (c) 2009-2017 The OTS Authors. All rights reserved.\n     2  // Use of this source code is governed by a BSD-style license that can be\n     3  // found in the LICENSE file.\n     4\n     5  #include \"cvt.h\"\n     6\n     7  // cvt - Control Value Table\n     8  // http://www.microsoft.com/typography/otspec/cvt.htm\n     9\n    10  namespace ots {\n    11\n    12  bool OpenTypeCVT::Parse(const uint8_t *data, size_t length) {\n    13    Buffer table(data, length);\n    14\n    15    if (length >= 128 * 1024u) {\n    16      return Error(\"Length (%d) > 120K\");  // almost all cvt tables are less than 4k bytes.\n    17    }\n    18\n    19    if (length % 2 != 0) {\n    20      return Error(\"Uneven cvt length (%d)\", length);\n    21    }\n    22\n    23    if (!table.Skip(length)) {\n    24      return Error(\"Length too high\");\n    25    }\n    26\n    27    this->data = data;\n    28    this->length = length;\n    29    return true;\n    30  }\n    31\n    32  bool OpenTypeCVT::Serialize(OTSStream *out) {\n    33    if (!out->Write(this->data, this->length)) {\n    34      return Error(\"Failed to write cvt table\");\n    35    }\n    36\n    37    return true;\n    38  }\n    39\n    40  bool OpenTypeCVT::ShouldSerialize() {\n    41    return Table::ShouldSerialize() &&\n    42           // this table is not for CFF fonts.\n    43           GetFont()->GetTable(OTS_TAG_GLYF) != NULL;\n    44  }\n    45\n    46  }  // namespace ots\n===src/fpgm.cc===\n     1  // Copyright (c) 2009-2017 The OTS Authors. All rights reserved.\n     2  // Use of this source code is governed by a BSD-style license that can be\n     3  // found in the LICENSE file.\n     4\n     5  #include \"fpgm.h\"\n     6\n     7  // fpgm - Font Program\n     8  // http://www.microsoft.com/typography/otspec/fpgm.htm\n     9\n    10  namespace ots {\n    11\n    12  bool OpenTypeFPGM::Parse(const uint8_t *data, size_t length) {\n    13    Buffer table(data, length);\n    14\n    15    if (length >= 128 * 1024u) {\n    16      return Error(\"length (%ld) > 120\", length);  // almost all fpgm tables are less than 5k bytes.\n    17    }\n    18\n    19    if (!table.Skip(length)) {\n    20      return Error(\"Bad fpgm length\");\n    21    }\n    22\n    23    this->data = data;\n    24    this->length = length;\n    25    return true;\n    26  }\n    27\n    28  bool OpenTypeFPGM::Serialize(OTSStream *out) {\n    29    if (!out->Write(this->data, this->length)) {\n    30      return Error(\"Failed to write fpgm table\");\n    31    }\n    32\n    33    return true;\n    34  }\n    35\n    36  bool OpenTypeFPGM::ShouldSerialize() {\n    37    return Table::ShouldSerialize() &&\n    38           // this table is not for CFF fonts.\n    39           GetFont()->GetTable(OTS_TAG_GLYF) != NULL;\n    40  }\n    41\n    42  }  // namespace ots\n===src/gdef.cc===\n     1  // Copyright (c) 2011-2017 The OTS Authors. All rights reserved.\n     2  // Use of this source code is governed by a BSD-style license that can be\n     3  // found in the LICENSE file.\n     4\n     5  #include \"gdef.h\"\n     6\n     7  #include <limits>\n     8  #include <vector>\n     9\n    10  #include \"gpos.h\"\n    11  #include \"gsub.h\"\n    12  #include \"layout.h\"\n    13  #include \"maxp.h\"\n    14\n    15  // GDEF - The Glyph Definition Table\n    16  // http://www.microsoft.com/typography/otspec/gdef.htm\n    17\n    18  namespace {\n    19\n    20  // The maximum class value in class definition tables.\n    21  const uint16_t kMaxClassDefValue = 0xFFFF;\n    22  // The maximum class value in the glyph class definision table.\n    23  const uint16_t kMaxGlyphClassDefValue = 4;\n    24  // The maximum format number of caret value tables.\n    25  // We don't support format 3 for now. See the comment in\n    26  // ParseLigCaretListTable() for the reason.\n    27  const uint16_t kMaxCaretValueFormat = 2;\n    28\n    29  }  // namespace\n    30\n    31  namespace ots {\n    32\n    33  bool OpenTypeGDEF::ParseAttachListTable(const uint8_t *data, size_t length) {\n    34    ots::Buffer subtable(data, length);\n    35\n    36    uint16_t offset_coverage = 0;\n    37    uint16_t glyph_count = 0;\n    38    if (!subtable.ReadU16(&offset_coverage) ||\n    39        !subtable.ReadU16(&glyph_count)) {\n    40      return Error(\"Failed to read gdef header\");\n    41    }\n    42    const unsigned attach_points_end =\n    43        2 * static_cast<unsigned>(glyph_count) + 4;\n    44    if (attach_points_end > std::numeric_limits<uint16_t>::max()) {\n    45      return Error(\"Bad glyph count in gdef\");\n    46    }\n    47    if (offset_coverage == 0 || offset_coverage >= length ||\n    48        offset_coverage < attach_points_end) {\n    49      return Error(\"Bad coverage offset %d\", offset_coverage);\n    50    }\n    51    if (glyph_count > this->m_num_glyphs) {\n    52      return Error(\"Bad glyph count %u\", glyph_count);\n    53    }\n    54\n    55    std::vector<uint16_t> attach_points;\n    56    attach_points.resize(glyph_count);\n    57    for (unsigned i = 0; i < glyph_count; ++i) {\n    58      if (!subtable.ReadU16(&attach_points[i])) {\n    59        return Error(\"Can't read attachment point %d\", i);\n    60      }\n    61      if (attach_points[i] >= length ||\n    62          attach_points[i] < attach_points_end) {\n    63        return Error(\"Bad attachment point %d of %d\", i, attach_points[i]);\n    64      }\n    65    }\n    66\n    67    // Parse coverage table\n    68    if (!ots::ParseCoverageTable(GetFont(), data + offset_coverage,\n    69                                 length - offset_coverage, this->m_num_glyphs)) {\n    70      return Error(\"Bad coverage table\");\n    71    }\n    72\n    73    // Parse attach point table\n    74    for (unsigned i = 0; i < attach_points.size(); ++i) {\n    75      subtable.set_offset(attach_points[i]);\n    76      uint16_t point_count = 0;\n    77      if (!subtable.ReadU16(&point_count)) {\n    78        return Error(\"Can't read point count %d\", i);\n    79      }\n    80      if (point_count == 0) {\n    81        return Error(\"zero point count %d\", i);\n    82      }\n    83      uint16_t last_point_index = 0;\n    84      uint16_t point_index = 0;\n    85      for (unsigned j = 0; j < point_count; ++j) {\n    86        if (!subtable.ReadU16(&point_index)) {\n    87          return Error(\"Can't read point index %d in point %d\", j, i);\n    88        }\n    89        // Contour point indeces are in increasing numerical order\n    90        if (last_point_index != 0 && last_point_index >= point_index) {\n    91          return Error(\"bad contour indeces: %u >= %u\",\n    92                      last_point_index, point_index);\n    93        }\n    94        last_point_index = point_index;\n    95      }\n    96    }\n    97    return true;\n    98  }\n    99\n   100  bool OpenTypeGDEF::ParseLigCaretListTable(const uint8_t *data, size_t length) {\n   101    ots::Buffer subtable(data, length);\n   102    uint16_t offset_coverage = 0;\n   103    uint16_t lig_glyph_count = 0;\n   104    if (!subtable.ReadU16(&offset_coverage) ||\n   105        !subtable.ReadU16(&lig_glyph_count)) {\n   106      return Error(\"Can't read caret structure\");\n   107    }\n   108    const unsigned lig_glyphs_end =\n   109        2 * static_cast<unsigned>(lig_glyph_count) + 4;\n   110    if (lig_glyphs_end > std::numeric_limits<uint16_t>::max()) {\n   111      return Error(\"Bad caret structure\");\n   112    }\n   113    if (offset_coverage == 0 || offset_coverage >= length ||\n   114        offset_coverage < lig_glyphs_end) {\n   115      return Error(\"Bad caret coverate offset %d\", offset_coverage);\n   116    }\n   117    if (lig_glyph_count > this->m_num_glyphs) {\n   118      return Error(\"bad ligature glyph count: %u\", lig_glyph_count);\n   119    }\n   120\n===src/gpos.cc===\n     1  // Copyright (c) 2011-2017 The OTS Authors. All rights reserved.\n     2  // Use of this source code is governed by a BSD-style license that can be\n     3  // found in the LICENSE file.\n     4\n     5  #include \"gpos.h\"\n     6\n     7  #include <limits>\n     8  #include <vector>\n     9\n    10  #include \"layout.h\"\n    11  #include \"maxp.h\"\n    12\n    13  // GPOS - The Glyph Positioning Table\n    14  // http://www.microsoft.com/typography/otspec/gpos.htm\n    15\n    16  #define TABLE_NAME \"GPOS\"\n    17\n    18  namespace {\n    19\n    