    "content": "commit c613fd4df033b75cbc1fd8e839b292d338d3e530\nAuthor: Wan-Teh Chang <wtc@google.com>\nDate:   Thu Sep 6 12:31:17 2018 -0700\n\n    Zero frame buffers on sequence header change.\n\n    This improves the commit d63da28bf141d7025b6d9038e042befb6419fa65, which\n    zeros the frame buffer every time aom_realloc_frame_buffer() is called.\n    We only need to zero the unused internal frame buffers (which are\n    waiting to be reused) after a sequence header change.\n\n    Add the reproducer test cases for oss-fuzz:10061 and oss-fuzz:10227 to\n    InvalidFileTest.\n\n    Tested:\n    ./test_libaom --gtest_filter=*InvalidFileTest*\n\n    BUG=oss-fuzz:10061\n    BUG=oss-fuzz:10227\n\n    Change-Id: Idc24eb0e057268935efacd8cdeb89afee8d40eba\n\ndiff --git a/test/invalid_file_test.cc b/test/invalid_file_test.cc\nindex b550f05cb8..5b4f5a6c3d 100644\n--- a/test/invalid_file_test.cc\n+++ b/test/invalid_file_test.cc\n@@ -111,7 +111,9 @@ const DecodeParam kAV1InvalidFileTests[] = {\n   { 4, \"invalid-oss-fuzz-9463.ivf\" },\n   { 1, \"invalid-oss-fuzz-9482.ivf\" },\n   { 1, \"invalid-oss-fuzz-9720.ivf\" },\n+  { 1, \"invalid-oss-fuzz-10061.ivf\" },\n   { 1, \"invalid-oss-fuzz-10117-mc-buf-use-highbd.ivf\" },\n+  { 1, \"invalid-oss-fuzz-10227.ivf\" },\n };\n\n AV1_INSTANTIATE_TEST_CASE(InvalidFileTest,\ndiff --git a/test/test-data.sha1 b/test/test-data.sha1\nindex 569a5cc4fc..0f8e116457 100644\n--- a/test/test-data.sha1\n+++ b/test/test-data.sha1\n@@ -2,8 +2,12 @@ d5dfb0151c9051f8c85999255645d7a23916d3c0 *hantro_collage_w352h288.yuv\n b87815bf86020c592ccc7a846ba2e28ec8043902 *hantro_odd.yuv\n 26b7f64399b84db4b4c9c915d743ec5c2619d4b9 *invalid-bug-1814.ivf\n d3964f9dad9f60363c81b688324d95b4ec7c8038 *invalid-bug-1814.ivf.res\n+fa06784f23751d8c37be94160fb821e855199af4 *invalid-oss-fuzz-10061.ivf\n+b055f06b9a95aaa5697fa26497b592a47843a7c8 *invalid-oss-fuzz-10061.ivf.res\n c9e06c4c7fb7d69fd635a1f606a5e478d60e99cf *invalid-oss-fuzz-10117-mc-buf-use-highbd.ivf\n 88e18e61bd2