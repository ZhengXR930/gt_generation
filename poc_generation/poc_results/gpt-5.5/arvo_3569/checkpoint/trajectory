  22  ** EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF\n    23  ** MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    24  ** IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY\n    25  ** CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    26  ** TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\n    27  ** SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    28  */\n    29\n    30  #define PJ_LIB__\n    31  #include <errno.h>\n    32  #include <proj.h>\n    33  #include \"projects.h\"\n    34\n    35  struct pj_opaque {\n    36      double h;\n    37      double radius_p;\n    38      double radius_p2;\n    39      double radius_p_inv2;\n    40      double radius_g;\n    41      double radius_g_1;\n    42      double C;\n    43      char *sweep_axis;\n    44      int flip_axis;\n    45  };\n    46\n    47  PROJ_HEAD(geos, \"Geostationary Satellite View\") \"\\n\\tAzi, Sph&Ell\\n\\th=\";\n    48\n    49\n    50  static XY s_forward (LP lp, PJ *P) {           /* Spheroidal, forward */\n    51      XY xy = {0.0,0.0};\n    52      struct pj_opaque *Q = P->opaque;\n    53      double Vx, Vy, Vz, tmp;\n    54\n    55      /* Calculation of the three components of the vector from satellite to\n    56      ** position on earth surface (lon,lat).*/\n    57      tmp = cos(lp.phi);\n    58      Vx = cos (lp.lam) * tmp;\n    59      Vy = sin (lp.lam) * tmp;\n    60      Vz = sin (lp.phi);\n    61\n    62      /* Check visibility*/\n    63\n    64\n    65      /* Calculation based on view angles from satellite.*/\n    66      tmp = Q->radius_g - Vx;\n    67\n    68      if(Q->flip_axis) {\n    69          xy.x = Q->radius_g_1 * atan(Vy / hypot(Vz, tmp));\n    70          xy.y = Q->radius_g_1 * atan(Vz / tmp);\n    71      } else {\n    72          xy.x = Q->radius_g_1 * atan(Vy / tmp);\n    73          xy.y = Q->radius_g_1 * atan(Vz / hypot(Vy, tmp));\n    74      }\n    75\n    76      return xy;\n    77  }\n    78\n    79\n    80  static XY e_forward (LP lp, PJ *P) {          /* Ellipsoidal, forward */\n    81      XY xy = {0.0,0.0};\n    82      struct pj_opaque *Q = P->opaque;\n    83      double r, Vx, Vy, Vz, tmp;\n    84\n    85      /* Calculation of geocentric latitude. */\n    86      lp.phi = atan (Q->radius_p2 * tan (lp.phi));\n    87\n    88      /* Calculation of the three components of the vector from satellite to\n    89      ** position on earth surface (lon,lat).*/\n    90      r = (Q->radius_p) / hypot(Q->radius_p * cos (lp.phi), sin (lp.phi));\n    91      Vx = r * cos (lp.lam) * cos (lp.phi);\n    92      Vy = r * sin (lp.lam) * cos (lp.phi);\n    93      Vz = r * sin (lp.phi);\n    94\n    95      /* Check visibility. */\n    96      if (((Q->radius_g - Vx) * Vx - Vy * Vy - Vz * Vz * Q->radius_p_inv2) < 0.) {\n    97          proj_errno_set(P, PJD_ERR_TOLERANCE_CONDITION);\n    98          return xy;\n    99      }\n   100\n   101      /* Calculation based on view angles from satellite. */\n   102      tmp = Q->radius_g - Vx;\n   103\n   104      if(Q->flip_axis) {\n   105          xy.x = Q->radius_g_1 * atan (Vy / hypot (Vz, tmp));\n   106          xy.y = Q->radius_g_1 * atan (Vz / tmp);\n   107      } else {\n   108          xy.x = Q->radius_g_1 * atan (Vy / tmp);\n   109          xy.y = Q->radius_g_1 * atan (Vz / hypot (Vy, tmp));\n   110      }\n   111\n   112      return xy;\n   113  }\n   114\n   115\n   116  static LP s_inverse (XY xy, PJ *P) {           /* Spheroidal, inverse */\n   117      LP lp = {0.0,0.0};\n   118      struct pj_opaque *Q = P->opaque;\n   119      double Vx, Vy, Vz, a, b, det, k;\n   120\n   121      /* Setting three components of vector from satellite to position.*/\n   122      Vx = -1.0;\n   123      if(Q->flip_axis) {\n   124          Vz = tan (xy.y / (Q->radius_g - 1.0));\n   125          Vy = tan (xy.x / (Q->radius_g - 1.0)) * sqrt (1.0 + Vz * Vz);\n   126      } else {\n   127          Vy = tan (xy.x / (Q->radius_g - 1.0));\n   128          Vz = tan (xy.y / (Q->radius_g - 1.0)) * sqrt (1.0 + Vy * Vy);\n   129      }\n   130\n   131      /* Calculation of terms in cubic equation and determinant.*/\n   132      a = Vy * Vy + Vz * Vz + Vx * Vx;\n   133      b = 2 * Q->radius_g * Vx;\n   134      if ((det = (b * b) - 4 * a * Q->C) < 0.) {\n   135          proj_errno_set(P, PJD_ERR_TOLERANCE_CONDITION);\n   136          return lp;\n   137      }\n   138\n   139      /* Calculation of three components of vector from satellite to position.*/\n   140      k  = (-b - sqrt(det)) / (2 * a);\n   141      Vx = Q->radius_g + k * Vx;\n   142      Vy *= k;\n   143      Vz *= k;\n   144\n   145      /* Calculation of longitude and latitude.*/\n   146      lp.lam = atan2 (Vy, Vx);\n   147      lp.phi = atan (Vz * cos (lp.lam) / Vx);\n   148\n   149      return lp;\n   150  }\n   151\n   152\n   153  static LP e_inverse (XY xy, PJ *P) {          /* Ellipsoidal, inverse */\n   154      LP lp = {0.0,0.0};\n   155      struct pj_opaque *Q = P->opaque;\n   156      double Vx, Vy, Vz, a, b, det, k;\n   157\n   158      /* Setting three components of vector from satellite to position.*/\n   159      Vx = -1.0;\n   160\n   161      if(Q->flip_axis) {\n   162          Vz = tan (xy.y / Q->radius_g_1);\n   163          Vy = tan (xy.x / Q->radius_g_1) * hypot(1.0, Vz);\n   164      } else {\n   165          Vy = tan (xy.x / Q->radius_g_1);\n   166          Vz = tan (xy.y / Q->radius_g_1) * hypot(1.0, Vy);\n   167      }\n   168\n   169      /* Calculation of terms in cubic equation and determinant.*/\n   170      a = Vz / Q->radius_p;\n   171      a   = Vy * Vy + a * a + Vx * Vx;\n   172      b   = 2 * Q->radius_g * Vx;\n   173      if ((det = (b * b) - 4 * a * Q->C) < 0.) {\n   174          proj_errno_set(P, PJD_ERR_TOLERANCE_CONDITION);\n   175          return lp;\n   176      }\n   177\n   178      /* Calculation of three components of vector from satellite to position.*/\n   179      k  = (-b - sqrt(det)) / (2. * a);\n   180      Vx = Q->radius_g + k * Vx;\n   181      Vy *= k;\n   182      Vz *= k;\n   183\n   184      /* Calculation of longitude and latitude.*/\n   185      lp.lam = atan2 (Vy, Vx);\n   186      lp.phi = atan (Vz * cos (lp.lam) / Vx);\n   187      lp.phi = atan (Q->radius_p_inv2 * tan (lp.phi));\n   188\n   189      return lp;\n   190  }\n   191\n   192\n   193  PJ *PROJECTION(geos) {\n   194      struct pj_opaque *Q = pj_calloc (1, sizeof (struct pj_opaque));\n   195      if (0==Q)\n   196          return pj_default_destructor (P, ENOMEM);\n   197      P->opaque = Q;\n   198\n   199      if ((Q->h = pj_param(P->ctx, P->params, \"dh\").f) <= 0.)\n   200          pj_default_destructor (P, PJD_ERR_H_LESS_THAN_ZERO);\n   201\n   202      if (P->phi0 != 0.0)\n   203          pj_default_destructor (P, PJD_ERR_UNKNOWN_PRIME_MERIDIAN);\n   204\n   205      Q->sweep_axis = pj_param(P->ctx, P->params, \"ssweep\").s;\n   206      if (Q->sweep_axis == NULL)\n   207        Q->flip_axis = 0;\n   208      else {\n   209          if (Q->sweep_axis[1] != '\\0' || (Q->sweep_axis[0] != 'x' && Q->sweep_axis[0] != 'y'))\n   210              pj_default_destructor (P, PJD_ERR_INVALID_SWEEP_AXIS);\n   211\n   212          if (Q->sweep_axis[0] == 'x')\n   213            Q->flip_axis = 1;\n   214          else\n   215            Q->flip_axis = 0;\n   216      }\n   217\n   218      Q->radius_g_1 = Q->h / P->a;\n   219      Q->radius_g = 1. + Q->radius_g_1;\n   220      Q->C  = Q->radius_g * Q->radius_g - 1.0;\n     1  /******************************************************************************\n     2   * Project:  PROJ.4\n     3   * Purpose:  Initialize projection object from string definition.  Includes\n     4   *           pj_init(), pj_init_plus() and pj_free() function.\n     5   * Author:   Gerald Evenden, Frank Warmerdam <warmerdam@pobox.com>\n     6   *\n     7   ******************************************************************************\n     8   * Copyright (c) 1995, Gerald Evenden\n     9   * Copyright (c) 2002, Frank Warmerdam <warmerdam@pobox.com>\n    10   *\n    11   * Permission is hereby granted, free of charge, to any person obtaining a\n    12   * copy of this software and associated documentation files (the \"Software\"),\n    13   * to deal in the Software without restriction, including without limitation\n    14   * the rights to use, copy, modify, merge, publish, distribute, sublicense,\n    15   * and/or sell copies of the Software, and to permit persons to whom the\n    16   * Software is furnished to do so, subject to the following conditions:\n    17   *\n    18   * The above copyright notice and this permission notice shall be included\n    19   * in all copies or substantial portions of the Software.\n    20   *\n    21   * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS\n    22   * OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n    23   * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL\n    24   * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n    25   * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING\n    26   * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER\n    27   * DEALINGS IN THE SOFTWARE.\n    28   *****************************************************************************/\n    29\n    30  #define PJ_LIB__\n    31  #include <projects.h>\n    32  #include <geodesic.h>\n    33  #include <stdio.h>\n    34  #include <string.h>\n    35  #include <errno.h>\n    36  #include <ctype.h>\n    37\n    38  /* Maximum size of files using the \"escape carriage return\" feature */\n    39  #define MAX_CR_ESCAPE 65537\n    40  typedef struct {\n    41      projCtx ctx;\n    42      PAFile fid;\n    43      char buffer[MAX_CR_ESCAPE];\n    44      int buffer_filled;\n    45      int at_eof;\n    46  } pj_read_state;\n    47\n    48  /************************************************************************/\n    49  /*                            fill_buffer()                             */\n    50  /************************************************************************/\n    51\n    52  static const char *fill_buffer(pj_read_state *state, const char *last_char)\n    53  {\n    54      size_t bytes_read;\n    55      size_t char_remaining, char_requested;\n    56      char   *r, *w;\n    57\n    58  /* -------------------------------------------------------------------- */\n    59  /*      Don't bother trying to read more if we are at eof, or if the    */\n    60  /*      buffer is still over half full.                                 */\n    61  /* -------------------------------------------------------------------- */\n    62      if (last_char == NULL)\n    63          last_char = state->buffer;\n    64\n    65      if (state->at_eof)\n    66          return last_char;\n    67\n    68      char_remaining = state->buffer_filled - (last_char - state->buffer);\n    69      if (char_remaining >= sizeof(state->buffer) / 2)\n    70          return last_char;\n    71\n    72  /* -------------------------------------------------------------------- */\n    73  /*      Move the existing data to the start of the buffer.              */\n    74  /* -------------------------------------------------------------------- */\n    75      memmove(state->buffer, last_char, char_remaining);\n    76      state->buffer_filled = (int)char_remaining;\n    77      last_char = state->buffer;\n    78\n    79  /* -------------------------------------------------------------------- */\n    80  /*      Refill.                                                         */\n    81  /* -------------------------------------------------------------------- */\n    82      char_requested = sizeof(state->buffer) - state->buffer_filled - 1;\n    83      bytes_read = pj_ctx_fread( state->ctx, state->buffer + state->buffer_filled,\n    84                                 1, char_requested, state->fid );\n    85      if (bytes_read < char_requested)\n    86      {\n    87          state->at_eof = 1;\n    88          state->buffer[state->buffer_filled + bytes_read] = '\\0';\n    89      }\n    90\n    91  /* -------------------------------------------------------------------- */\n    92  /*      Line continuations: skip whitespace after escaped newlines      */\n    93  /* -------------------------------------------------------------------- */\n    94      r = state->buffer;\n    95      w = state->buffer;\n    96      while (*r) {\n    97          /* Escaped newline? */\n    98          while ((r[0]=='\\\\')  &&  ((r[1]=='\\n') || (r[1]=='\\r'))) {\n    99              r += 2;\n   100              while (isspace (*r))\n   101                  r++;\n   102              /* we also skip comments immediately after an escaped newline */\n   103              while (*r=='#') {\n   104                  while( *r && (*r != '\\n') )\n   105                      r++;\n   106                  while (isspace (*r))\n   107                      r++;\n   108                  /* Reaching end of buffer while skipping continuation comment is currently an error */\n   109                  if (0==*r) {\n   110                      pj_ctx_set_errno (state->ctx, -2);\n   111                      pj_log (state->ctx, PJ_LOG_ERROR, \"init file too big\");\n   112                      return 0;\n   113                  }\n   114              }\n   115          }\n   116          *w++ = *r++;\n   117      }\n   118      *w = 0;\n   119      state->buffer_filled += (int)(bytes_read - (r-w));\n   120\n   121      return last_char;\n   122  }\n   123\n   124  /************************************************************************/\n   125  /*                              get_opt()                               */\n   126  /************************************************************************/\n   127  static paralist *\n   128  get_opt(projCtx ctx, paralist **start, PAFile fid, char *name, paralist *next,\n   129          int *found_def) {\n   130      pj_read_state *state = (pj_read_state*) calloc(1,sizeof(pj_read_state));\n   131      char sword[MAX_CR_ESCAPE];\n   132      char *pipeline;\n   133      int len;\n   134      int in_target = 0;\n   135      const char *next_char = NULL;\n   136      state->fid = fid;\n   137      state->ctx = ctx;\n   138      next_char = fill_buffer(state, NULL);\n   139      if(found_def)\n   140          *found_def = 0;\n   141\n   142      len = (int)strlen(name);\n   143      *sword = 't';\n   144\n   145      if (0==next_char)\n   146          return 0;\n   147\n   148      /* loop till we find our target keyword */\n   149      while (*next_char)\n   150      {\n   151          next_char = fill_buffer(state, next_char);\n   152\n   153          /* Skip white space. */\n   154          while( isspace(*next_char) )\n   155              next_char++;\n   156\n   157          next_char = fill_buffer(state, next_char);\n   158          if (0==next_char)\n   159              return 0;\n   160\n   161          /* for comments, skip past end of line. */\n   162          if( *next_char == '#' )\n   163          {\n   164              while( *next_char && *next_char != '\\n' )\n   165                  next_char++;\n   166\n   167              next_char = fill_buffer(state, next_char);\n   168              if (0==next_char)\n   169                  return 0;\n   170              if (*next_char == '\\n')\n   171                  next_char++;\n   172              if (*next_char == '\\r')\n   173                  next_char++;\n   174\n   175          }\n   176\n   177          /* Is this our target? */\n   178          else if( *next_char == '<' )\n   179          {\n   180              /* terminate processing target on the next block definition */\n   181              if (in_target)\n   182                  break;\n   183\n   184   