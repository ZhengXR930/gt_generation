    {
      "file": "lib/misc/upng-gzip.c",
      "function": "huffman_tree_create_lengths",
      "line": null,
      "code": "unsigned int tree1d[MAX_SYMBOLS], blcount[MAX_BIT_LENGTH],\n\t     nextcode[MAX_BIT_LENGTH + 1];",
      "note": "Incorrect stack extent. `blcount` is declared with `MAX_BIT_LENGTH == 15`, so it has only 15 elements, but the helper later uses caller-supplied code lengths as direct indices and the literal/length tree built in this witness legitimately reaches the value 15. The fix enlarges `blcount` and adds an explicit `bitlen[bits] >= LWS_ARRAY_SIZE(blcount)` check before incrementing it.",
      "kind": "root_cause_function"
    },
