 50    struct driver_context_t\n    51    {\n    52      static const bool in_place = true;\n    53      enum Flags\n    54      {\n    55        MarkFirst         = 0x8000,       /* If set, make the current glyph the first\n    56                                           * glyph to be rearranged. */\n    57        DontAdvance       = 0x4000,       /* If set, don't advance to the next glyph\n    58                                           * before going to the new state. This means\n    59                                           * that the glyph index doesn't change, even\n    60                                           * if the glyph at that index has changed. */\n    61        MarkLast          = 0x2000,       /* If set, make the current glyph the last\n    62                                           * glyph to be rearranged. */\n    63        Reserved          = 0x1FF0,       /* These bits are reserved and should be set to 0. */\n    64        Verb              = 0x000F,       /* The type of rearrangement specified. */\n    65      };\n    66\n    67      inline driver_context_t (const RearrangementSubtable *table) :\n    68          ret (false),\n    69          start (0), end (0) {}\n    70\n    71      inline bool is_actionable (StateTableDriver<EntryData> *driver,\n    72                                 const Entry<EntryData> *entry)\n    73      {\n    74        return (entry->flags & Verb) && start < end;\n    75      }\n    76      inline bool transition (StateTableDriver<EntryData> *driver,\n    77                              const Entry<EntryData> *entry)\n    78      {\n    79        hb_buffer_t *buffer = driver->buffer;\n    80        unsigned int flags = entry->flags;\n    81\n    82        if (flags & MarkFirst)\n    83          start = buffer->idx;\n    84\n    85        if (flags & MarkLast)\n    86          end = MIN (buffer->idx + 1, buffer->len);\n    87\n    88        if ((flags & Verb) && start < end)\n    89        {\n    90          /* The following map has two nibbles, for start-side\n    91           * and end-side. Values of 0,1,2 mean move that many\n    92           * to the other side. Value of 3 means move 2 and\n    93           * flip them. */\n    94          const unsigned char map[16] =\n    95          {\n    96            0x00, /* 0    no change */\n    97            0x10, /* 1    Ax => xA */\n    98            0x01, /* 2    xD => Dx */\n    99            0x11, /* 3    AxD => DxA */\n   100            0x20, /* 4    ABx => xAB */\n   101            0x30, /* 5    ABx => xBA */\n   102            0x02, /* 6    xCD => CDx */\n   103            0x03, /* 7    xCD => DCx */\n   104            0x12, /* 8    AxCD => CDxA */\n   105            0x13, /* 9    AxCD => DCxA */\n   106            0x21, /* 10   ABxD => DxAB */\n   107            0x31, /* 11   ABxD => DxBA */\n   108            0x22, /* 12   ABxCD => CDxAB */\n   109            0x32, /* 13   ABxCD => CDxBA */\n   110            0x23, /* 14   ABxCD => DCxAB */\n   111            0x33, /* 15   ABxCD => DCxBA */\n   112          };\n   113\n   114          unsigned int m = map[flags & Verb];\n   115          unsigned int l = MIN<unsigned int> (2, m >> 4);\n   116          unsigned int r = MIN<unsigned int> (2, m & 0x0F);\n   117          bool reverse_l = 3 == (m >> 4);\n   118          bool reverse_r = 3 == (m & 0x0F);\n   119\n   120          if (end - start >= l + r)\n   121          {\n   122            buffer->merge_clusters (start, MIN (buffer->idx + 1, buffer->len));\n   123            buffer->merge_clusters (start, end);\n   124\n   125            hb_glyph_info_t *info = buffer->info;\n   126            hb_glyph_info_t buf[4];\n   127\n   128            memcpy (buf, info + start, l * sizeof (buf[0]));\n   129            memcpy (buf + 2, info + end - r, r * sizeof (buf[0]));\n   130\n   131            if (l != r)\n   132              memmove (info + start + r, info + start + l, (end - start - l - r) * sizeof (buf[0]));\n   133\n   134            memcpy (info + start, buf + 2, r * sizeof (buf[0]));\n   135            memcpy (info + end - l, buf, l * sizeof (buf[0]));\n   136            if (reverse_l)\n   137            {\n   138              buf[0] = info[end - 1];\n   139              info[end - 1] = info[end - 2];\n   140              info[end - 2] = buf[0];\n   141            }\n   142            if (reverse_r)\n   143            {\n   144              buf[0] = info[start];\n   145              info[start] = info[start + 1];\n   146              info[start + 1] = buf[0];\n   147            }\n   148          }\n   149        }\n   150\n   151        return true;\n   152      }\n   153\n   154      public:\n   155      bool ret;\n   156      private:\n   157      unsigned int start;\n   158      unsigned int end;\n   159    };\n   160\n   161    inline bool apply (hb_aat_apply_context_t *c) const\n   162    {\n   163      TRACE_APPLY (this);\n   164\n   165      driver_context_t dc (this);\n   166\n   167      StateTableDriver<void> driver (machine, c->buffer, c->face);\n   168      driver.drive (&dc);\n   169\n   170      return_trace (dc.ret);\n   171    }\n   172\n   173    inline bool sanitize (hb_sanitize_context_t *c) const\n   174    {\n   175      TRACE_SANITIZE (this);\n   176      return_trace (machine.sanitize (c));\n   177    }\n   178\n   179    protected:\n   180    StateTable<EntryData> machine;\n   522  struct InsertionSubtable\n   523  {\n   524    struct EntryData\n   525    {\n   526      HBUINT16    currentInsertIndex;     /* Zero-based index into the insertion glyph table.\n   527                                           * The number of glyphs to be inserted is contained\n   528                                           * in the currentInsertCount field in the flags.\n   529                                           * A value of 0xFFFF indicates no insertion is to\n   530                                           * be done. */\n   531      HBUINT16    markedInsertIndex;      /* Zero-based index into the insertion glyph table.\n   532                                           * The number of glyphs to be inserted is contained\n   533                                           * in the markedInsertCount field in the flags.\n   534                                           * A value of 0xFFFF indicates no insertion is to\n   535                                           * be done. */\n   536      public:\n   537      DEFINE_SIZE_STATIC (4);\n   538    };\n   539\n   540    struct driver_context_t\n   541    {\n   542      static const bool in_place = false;\n   543      enum Flags\n   544      {\n   545        SetMark           = 0x8000,       /* If set, mark the current glyph. */\n   546        DontAdvance       = 0x4000,       /* If set, don't advance to the next glyph before\n   547                                           * going to the new state.  This does not mean\n   548                                           * that the glyph pointed to is the same one as\n   549                                           * before. If you've made insertions immediately\n   550                                           * downstream of the current glyph, the next glyph\n   551                                           * processed would in fact be the first one\n   552                                           * inserted. */\n   553        CurrentIsKashidaLike= 0x2000,     /* If set, and the currentInsertList is nonzero,\n   554                                           * then the specified glyph list will be inserted\n   555                                           * as a kashida-like insertion, either before or\n   556                                           * after the current glyph (depending on the state\n   557                                           * of the currentInsertBefore flag). If clear, and\n   558                                           * the currentInsertList is nonzero, then the\n   559                                           * specified glyph list will be inserted as a\n   560                                           * split-vowel-like insertion, either before or\n   561                                           * after the current glyph (depending on the state\n   562                                           * of the currentInsertBefore flag). */\n   563        MarkedIsKashidaLike= 0x1000,      /* If set, and the markedInsertList is nonzero,\n   564                                           * then the specified glyph list will be inserted\n   565                                           * as a kashida-like insertion, either before or\n   566                                           * after the marked glyph (depending on the state\n   567                                           * of the markedInsertBefore flag). If clear, and\n   568                                           * the markedInsertList is nonzero, then the\n   569                                           * specified glyph list will be inserted as a\n   570                                           * split-vowel-like insertion, either before or\n   571                                           * after the marked glyph (depending on the state\n   572                                           * of the markedInsertBefore flag). */\n   573        CurrentInsertBefore= 0x0800,      /* If set, specifies that insertions are to be made\n   574                                           * to the left of the current glyph. If clear,\n   575                                           * they're made to the right of the current glyph. */\n   576        MarkedInsertBefore= 0x0400,       /* If set, specifies that insertions are to be\n   577                                           * made to the left of the marked glyph. If clear,\n   578                                           * they're made to the right of the marked glyph. */\n   579        CurrentInsertCount= 0x3E0,        /* This 5-bit field is treated as a count of the\n   580                                           * number of glyphs to insert at the current\n   581                                           * position. Since zero means no insertions, the\n   582                                           * largest number of insertions at any given\n   583                                           * current location is 31 glyphs. */\n   584        MarkedInsertCount= 0x001F,        /* This 5-bit field is treated as a count of the\n   585                                           * number of glyphs to insert at the marked\n   586                                           * position. Since zero means no insertions, the\n   587                                           * largest number of insertions at any given\n   588                                           * marked location is 31 glyphs. */\n   589      };\n   590\n   591      inline driver_context_t (const InsertionSubtable *table,\n   592                               hb_aat_apply_context_t *c_) :\n   593          ret (false),\n   594          c (c_),\n   595          mark_set (false),\n   596          mark (0),\n   597          insertionAction (table+table->insertionAction) {}\n   598\n   599      inline bool is_actionable (StateTableDriver<EntryData> *driver,\n   600                                 const Entry<EntryData> *entry)\n   601      {\n   602        return (entry->flags & (CurrentInsertCount | MarkedInsertCount)) &&\n   603               (entry->data.currentInsertIndex != 0xFFFF ||entry->data.markedInsertIndex != 0xFFFF);\n   604      }\n   605      inline bool transition (StateTableDriver<EntryData> *driver,\n   606                              const Entry<EntryData> *entry)\n   607      {\n   608        hb_buffer_t *buffer = driver->buffer;\n   609        unsigned int flags = entry->flags;\n   610\n   611        if (entry->data.markedInsertIndex != 0xFFFF && mark_set)\n   612        {\n   613          unsigned int count = (flags & MarkedInsertCount);\n   614          unsigned int start = entry->data.markedInsertIndex;\n   615          const GlyphID *glyphs = &insertionAction[start];\n   616          if (unlikely (!c->sanitizer.check_array (glyphs, count))) return false;\n   617\n   618          bool before = flags & MarkedInsertBefore;\n   619\n   620          unsigned int end = buffer->out_len;\n   621          buffer->move_to (mark);\n   622\n   623          if (!before)\n   624            buffer->copy_glyph ();\n   625          /* TODO We ignore KashidaLike setting. */\n   626          for (unsigned int i = 0; i < count; i++)\n   627            buffer->output_glyph (glyphs[i]);\n   628          if (!before)\n   629            buffer->skip_glyph ();\n   630\n   631          buffer->move_to (end + count);\n   632\n   633          buffer->unsafe_to_break_from_outbuffer (mark, MIN (buffer->idx + 1, buffer->len));\n   634        }\n   635\n   636        if (entry->data.currentInsertIndex != 0xFFFF)\n   637        {\n   638          unsigned int count = (flags & CurrentInsertCount) >> 5;\n   639          unsigned int start = entry->data.currentInsertIndex;\n   640          const GlyphID *glyphs = &insertionAction[start];\n   641          if (unlikely (!c->sanitizer.check_array (glyphs, count))) return false;\n   642\n   643          bool before = flags & CurrentInsertBefore;\n   644\n   645          unsigned int end = buffer->out_len;\n   646\n   647          if (!before)\n   648            buffer->copy_glyph ();\n   649          /* TODO We ignore KashidaLike setting. */\n   650          for (unsigned int i = 0; i < count; i++)\n   651            buffer->output_glyph (glyphs[i]);\n   652          if (!before)\n   653            buffer->skip_glyph ();\n   654\n   655          /* Humm. Not sure where to move to.  There's this wording under\n   656           * DontAdvance flag:\n   657           *\n   658           * \"If set, don't update the glyph index before going to the new state.\n   659           * This does not mean that the glyph pointed to is the same one as\n   660           * before. If you've made insertions immediately downstream of the\n   661           * current glyph, the next glyph processed would in fact be the first\n   662           * one inserted.\"\n   663           *\n   664           * This suggests that if DontAdvance is NOT set, we should move to\n   665           * end+count.  If it *was*, then move to end, such that newly inserted\n   666           * glyphs are now visible.\n   667           */\n   668          buffer->move_to ((flags & DontAdvance) ? end : end + count);\n   669        }\n   670\n   671        if (flags & SetMark)\n   672        {\n   673          mark_set = true;\n   674          mark = buffer->out_len;\n   675        }\n   676\n   677        return true;\n   678      }\n   679\n   680      public:\n   681      bool ret;\n   682      private:\n   683      hb_aat_apply_context_t *c;\n   684      bool mark_set;\n   685      unsigned int mark;\n   686      const UnsizedArrayOf<GlyphID> &insertionAction;\n   687    };\n   688\n   689    inline bool apply (hb_aat_apply_context_t *c) const\n   690    {\n   691      TRACE_APPLY (this);\n   692\n   693      driver_context_t dc (this, c);\n   694\n   695      StateTableDriver<EntryData> driver (machine, c->buffer, c->face);\n   696      driver.drive (&dc);\n   697\n   698      return_trace (dc.ret);\n   699    }\n   700\n   701    inline bool sanitize (hb_sanitize_context_t *c) const\n   702    {\n   703      TRACE_SANITIZE (this);\n   704      /* The rest of array sanitizations are done at run-time. */\n   705      return_trace (c->check_struct (this) && machine.sanitize (c) &&\n   706                    insertionAction);\n   707    }\n   708\n   709    protected:\n   710    StateTable<EntryData>\n   711                  machine;\n   712    LOffsetTo<UnsizedArrayOf<GlyphID>, false>\n   713                  insertionAction;        /* Byte offset from stateHeader to the start of\n   714                                           * the insertion glyph table. */\n   715    public:\n   716    DEFINE_SIZE_STATIC (20);\n   717  };\n   718\n   719\n   720  struct Feature\n   721  {\n   722    inline bool sanitize (hb_sanitize_context_t *c) const\n   723    {\n   724      TRACE_SANITIZE (this);\n   725      return_trace (c->check_struct (this));\n   726    }\n   727\n   728    public:\n   729    HBUINT16      featureType;    /* The type of feature. */\n   730    HBUINT16      featureSetting; /* The feature's setting (aka selector). */\n   731    HBUINT32      enableFlags;    /* Flags for the settings that this feature\n   732                                   * and setting enables. */\n   733    HBUINT32      disableFlags;   /* Complement of flags for the settings that this\n   734                                   * feature and setting disable. */\n   735\n   736    public:\n   737    DEFINE_SIZE_STATIC (12);\n   738  };\n   739\n   740\n   741  struct ChainSubtable\n   742  {\n   743    friend struct Chain;\n   744\n   745    inline unsigned int get_size (void) const { return length; }\n   746    inline unsigned int get_type (void) const { return coverage & SubtableType; }\n   747\n   748    enum Coverage\n   749    {\n   750      Vertical            = 0x80000000,   /* If set, this subtable will only be applied\n   751                                           * to vertical text. If clear, this subtable\n   752                                           * will only be applied to horizontal text. */\n   753      Descending          = 0x40000000,   /* If set, this subtable will process glyphs\n   754                                           * in descending order. If clear, it will\n   755                                           * process the glyphs in ascending order. */\n   756      AllDirections       = 0x20000000,   /* If set, this subtable will be applied to\n   757                                           * both horizontal and vertical text (i.e.\n   758                                           * the state of bit 0x80000000 is ignored). */\n   759      Logical             = 0x10000000,   /* If set, this subtable will process glyphs\n   760                                           * in logical order (or reverse logical order,\n   760                                           * in logical order (or reverse logical order,\n   761                                           * depending on the value of bit 0x80000000). */\n   762      Reserved            = 0x0FFFFF00,   /* Reserved, set to zero. */\n   763      SubtableType        = 0x000000FF,   /* Subtable type; see following table. */\n   764    };\n   765    enum Type\n   766    {\n   767      Rearrangement       = 0,\n   768      Contextual          = 1,\n   769      Ligature            = 2,\n   770      Noncontextual       = 4,\n   771      Insertion           = 5\n   772    };\n   773\n   774    template <typename context_t>\n   775    inline typename context_t::return_t dispatch (context_t *c) const\n   776    {\n   777      unsigned int subtable_type = get_type ();\n   778      TRACE_DISPATCH (this, subtable_type);\n   779      switch (subtable_type) {\n   780      case Rearrangement:         return_trace (c->dispatch (u.rearrangement));\n   781      case Contextual:            return_trace (c->dispatch (u.contextual));\n   782      case Ligature:              return_trace (c->dispatch (u.ligature));\n   783      case Noncontextual:         return_trace (c->dispatch (u.noncontextual));\n   784      case Insertion:             return_trace (c->dispatch (u.insertion));\n   785      default:                    return_trace (c->default_return_value ());\n   786      }\n   787    }\n   788\n   789    inline bool sanitize (hb_sanitize_context_t *c) const\n   790    {\n   791      TRACE_SANITIZE (this);\n   792      if (!length.sanitize (c) ||\n   793          length < min_size ||\n   794          !c->check_range (this, length))\n   795        return_trace (false);\n   796\n   797      return_trace (dispatch (c));\n   798    }\n   799\n   800    protected:\n   801    HBUINT32      length;         /* Total subtable length, including this header. */\n   802    HBUINT32      coverage;       /* Coverage flags and subtable type. */\n   803    HBUINT32      subFeatureFlags;/* The 32-bit mask identifying which subtable this is. */\n   804    union {\n   805    RearrangementSubtable         rearrangement;\n   806    ContextualSubtable            contextual;\n   807    LigatureSubtable              ligature;\n   808    NoncontextualSubtable         noncontextual;\n   809    InsertionSubtable             insertion;\n   810    } u;\n   811    public:\n   812    DEFINE_SIZE_MIN (12);\n   813  };\n   814\n   815  struct Chain\n   816  {\n   817    inline void apply (hb_aat_apply_context_t *c) const\n   818    {\n   819      uint32_t flags = defaultFlags;\n   820      {\n   821        /* Compute applicable flags.  TODO Should move this to planning\n   822         * stage and take user-requested features into account. */\n   823        unsigned int count = featureCount;\n   824        for (unsigned i = 0; i < count; i++)\n   825        {\n   826          const Feature &feature = featureZ[i];\n   827          if (false) /* XXX Check if feature enabled... */\n   828          {\n   829            flags &= feature.disableFlags;\n   830            flags |= feature.enableFlags;\n   831          }\n   832        }\n   833      }\n   834\n   835      const ChainSubtable *subtable = &StructAtOffset<ChainSubtable> (&featureZ, featureZ[0].static_size * featureCount);\n   836      unsigned int count = subtableCount;\n   837      for (unsigned int i = 0; i < count; i++)\n   838      {\n   839        bool reverse;\n   840\n   841        if (!(subtable->subFeatureFlags & flags))\n   842          goto skip;\n   843\n   844        if (!(subtable->coverage & ChainSubtable::AllDirections) &&\n   845            HB_DIRECTION_IS_VERTICAL (c->buffer->props.direction) !=\n 