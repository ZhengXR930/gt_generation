      return body_size + 4 * offsets;\n   648\n   649    return body_size + 8 * offsets;\n   650  }\n   651\n   652  struct Offsets\n   653  {\n   654    gsize     data_size;\n   655\n   656    guchar   *array;\n   657    gsize     length;\n   658    guint     offset_size;\n   659\n   660    gboolean  is_normal;\n   661  };\n   662\n   663  static gsize\n   664  gvs_offsets_get_offset_n (struct Offsets *offsets,\n   665                            gsize           n)\n   666  {\n   667    return gvs_read_unaligned_le (\n   668        offsets->array + (offsets->offset_size * n), offsets->offset_size);\n   669  }\n   670\n   671  static struct Offsets\n   672  gvs_variable_sized_array_get_frame_offsets (GVariantSerialised value)\n   673  {\n   674    struct Offsets out = { 0, };\n   675    gsize offsets_array_size;\n   676    gsize last_end;\n   677\n   678    if (value.size == 0)\n   679      {\n   680        out.is_normal = TRUE;\n   681        return out;\n   682      }\n   683\n   684    out.offset_size = gvs_get_offset_size (value.size);\n   685    last_end = gvs_read_unaligned_le (value.data + value.size - out.offset_size,\n   686                                      out.offset_size);\n   687\n   688    if (last_end > value.size)\n   689      return out;  /* offsets not normal */\n   690\n   691    offsets_array_size = value.size - last_end;\n   692\n   693    if (offsets_array_size % out.offset_size)\n   694      return out;  /* offsets not normal */\n   695\n   696    out.data_size = last_end;\n   697    out.array = value.data + last_end;\n   698    out.length = offsets_array_size / out.offset_size;\n   699\n   700    if (out.length > 0 && gvs_calculate_total_size (last_end, out.length) != value.size)\n   700    if (out.length > 0 && gvs_calculate_total_size (last_end, out.length) != value.size)\n   701      return out;  /* offset size not minimal */\n   702\n   703    out.is_normal = TRUE;\n   704\n   705    return out;\n   706  }\n   707\n   708  static gsize\n   709  gvs_variable_sized_array_n_children (GVariantSerialised value)\n   710  {\n   711    return gvs_variable_sized_array_get_frame_offsets (value).length;\n   712  }\n   713\n   714  /* Find the index of the first out-of-order element in @data, assuming that\n   715   * @data is an array of elements of given @type, starting at index @start and\n   716   * containing a further @len-@start elements. */\n   717  #define DEFINE_FIND_UNORDERED(type) \\\n   718    static gsize \\\n   719    find_unordered_##type (const guint8 *data, gsize start, gsize len) \\\n   720    { \\\n   721      gsize off; \\\n   722      type current, previous; \\\n   723      \\\n   724      memcpy (&previous, data + start * sizeof (current), sizeof (current)); \\\n   725      for (off = (start + 1) * sizeof (current); off < len * sizeof (current); off += sizeof (current)) \\\n   726        { \\\n   727          memcpy (&current, data + off, sizeof (current)); \\\n   728          if (current < previous) \\\n   729            break; \\\n   730          previous = current; \\\n   731        } \\\n   732      return off / sizeof (current) - 1; \\\n   733    }\n   734\n   735  DEFINE_FIND_UNORDERED (guint8);\n   736  DEFINE_FIND_UNORDERED (guint16);\n   737  DEFINE_FIND_UNORDERED (guint32);\n   738  DEFINE_FIND_UNORDERED (guint64);\n   739\n   740  static GVariantSerialised\n   741  gvs_variable_sized_array_get_child (GVariantSerialised value,\n   742                                      gsize              index_)\n   743  {\n   744    GVariantSerialised child = { 0, };\n   745\n   746    struct Offsets offsets = gvs_variable_sized_array_get_frame_offsets (value);\n   747\n   748    gsize start;\n   749    gsize end;\n   750\n   751    child.type_info = g_variant_type_info_element (value.type_info);\n   752    g_variant_type_info_ref (child.type_info);\n   753    child.depth = value.depth + 1;\n   754\n   755    /* If the requested @index_ is beyond the set of indices whose framing offsets\n   756     * have been checked, check the remaining offsets to see whether they’re\n   757     * normal (in order, no overlapping array elements).\n   758     *\n   759     * Don’t bother checking if the highest known-good offset is lower than the\n   760     * highest checked offset, as that means there’s an invalid element at that\n   761     * index, so there’s no need to check further. */\n   762    if (index_ > value.checked_offsets_up_to &&\n   763        value.ordered_offsets_up_to == value.checked_offsets_up_to)\n   764      {\n   765        switch (offsets.offset_size)\n   766          {\n   767          case 1:\n   768            {\n   769              value.ordered_offsets_up_to = find_unordered_guint8 (\n   770                  offsets.array, value.checked_offsets_up_to, index_ + 1);\n   771              break;\n   772            }\n   773          case 2:\n   774            {\n   775              value.ordered_offsets_up_to = find_unordered_guint16 (\n   776                  offsets.array, value.checked_offsets_up_to, index_ + 1);\n   777              break;\n   778            }\n   779          case 4:\n   780            {\n   781              value.ordered_offsets_up_to = find_unordered_guint32 (\n   782                  offsets.array, value.checked_offsets_up_to, index_ + 1);\n   783              break;\n   784            }\n   785          case 8:\n   786            {\n   787              value.ordered_offsets_up_to = find_unordered_guint64 (\n   788                  offsets.array, value.checked_offsets_up_to, index_ + 1);\n   789              break;\n   790            }\n   791          default:\n   792            /* gvs_get_offset_size() only returns maximum 8 */\n   793            g_assert_not_reached ();\n   794          }\n   795\n   796        value.checked_offsets_up_to = index_;\n   797      }\n   798\n   799    if (index_ > value.ordered_offsets_up_to)\n   800      {\n   801        /* Offsets are invalid somewhere, so return an empty child. */\n   802        return child;\n   803      }\n   804\n   805    if (index_ > 0)\n   806      {\n   807        guint alignment;\n   808\n   809        start = gvs_offsets_get_offset_n (&offsets, index_ - 1);\n   810\n   811        g_variant_type_info_query (child.type_info, &alignment, NULL);\n   812        start += (-start) & alignment;\n   813      }\n   814    else\n   815      start = 0;\n   816\n   817    end = gvs_offsets_get_offset_n (&offsets, index_);\n   818\n   819    if (start < end && end <= value.size && end <= offsets.data_size)\n   820      {\n   821        child.data = value.data + start;\n   822        child.size = end - start;\n   823      }\n   824\n   825    return child;\n   826  }\n   827\n   828  static gsize\n   829  gvs_variable_sized_array_needed_size (GVariantTypeInfo         *type_info,\n   830                                        GVariantSerialisedFiller  gvs_filler,\n   831                                        const gpointer           *children,\n   832                                        gsize                     n_children)\n   833  {\n   834    guint alignment;\n   835    gsize offset;\n   836    gsize i;\n   837\n   838    g_variant_type_info_query (type_info, &alignment, NULL);\n   839    offset = 0;\n   840\n   841    for (i = 0; i < n_children; i++)\n   842      {\n   843        GVariantSerialised child = { 0, };\n   844\n   845        offset += (-offset) & alignment;\n   846        gvs_filler (&child, children[i]);\n   847        offset += child.size;\n   848      }\n   849\n   850    return gvs_calculate_total_size (offset, n_children);\n   851  }\n   852\n   853  static void\n   854  gvs_variable_sized_array_serialise (GVariantSerialised        value,\n   855                                      GVariantSerialisedFiller  gvs_filler,\n   856                                      const gpointer           *children,\n   857                                      gsize                     n_children)\n   858  {\n   859    guc