bs(input) */\n   539    /* This code assumes we are on a two's complement machine */\n   540    temp2 += temp3;\n   541\n   542    /* Find the number of bits needed for the magnitude of the coefficient */\n   543    nbits = JPEG_NBITS(temp);\n   544\n   545    /* Emit the Huffman-coded symbol for the number of bits */\n   546    code = dctbl->ehufco[nbits];\n   547    size = dctbl->ehufsi[nbits];\n   548    EMIT_BITS(code, size)\n   549\n   550    /* Mask off any extra bits in code */\n   551    temp2 &= (((JLONG)1) << nbits) - 1;\n   552\n   553    /* Emit that number of bits of the value, if positive, */\n   554    /* or the complement of its magnitude, if negative. */\n   555    EMIT_BITS(temp2, nbits)\n   556\n   557    /* Encode the AC coefficients per section F.1.2.2 */\n   558\n   559    r = 0;                        /* r = run length of zeros */\n   560\n   561  /* Manually unroll the k loop to eliminate the counter variable.  This\n   562   * improves performance greatly on systems with a limited number of\n   563   * registers (such as x86.)\n   564   */\n   565  #define kloop(jpeg_natural_order_of_k) { \\\n   566    if ((temp = block[jpeg_natural_order_of_k]) == 0) { \\\n   567      r++; \\\n   568    } else { \\\n   569      temp2 = temp; \\\n   570      /* Branch-less absolute value, bitwise complement, etc., same as above */ \\\n   571      temp3 = temp >> (CHAR_BIT * sizeof(int) - 1); \\\n   572      temp ^= temp3; \\\n   573      temp -= temp3; \\\n   574      temp2 += temp3; \\\n   575      nbits = JPEG_NBITS_NONZERO(temp); \\\n   576      /* if run length > 15, must emit special run-length-16 codes (0xF0) */ \\\n   577      while (r > 15) { \\\n   578        EMIT_BITS(code_0xf0, size_0xf0) \\\n   579        r -= 16; \\\n   580      } \\\n   581      /* Emit Huffman symbol for run length / number of bits */ \\\n   582      temp3 = (r << 4) + nbits; \\\n   583      code = actbl->ehufco[temp3]; \\\n   584      size = actbl->ehufsi[temp3]; \\\n   585      EMIT_CODE(code, size) \\\n   586      r = 0; \\\n   587    } \\\n   588  }\n   589\n   590    /* One iteration for each value in jpeg_natural_order[] */\n   591    kloop(1);   kloop(8);   kloop(16);  kloop(9);   kloop(2);   kloop(3);\n   592    kloop(10);  kloop(17);  kloop(24);  kloop(32);  kloop(25);  kloop(18);\n   593    kloop(11);  kloop(4);   kloop(5);   kloop(12);  kloop(19);  kloop(26);\n   594    kloop(33);  kloop(40);  kloop(48);  kloop(41);  kloop(34);  kloop(27);\n   595    kloop(20);  kloop(13);  kloop(6);   kloop(7);   kloop(14);  kloop(21);\n   596    kloop(28);  kloop(35);  kloop(42);  kloop(49);  kloop(56);  kloop(57);\n   597    kloop(50);  kloop(43);  kloop(36);  kloop(29);  kloop(22);  kloop(15);\n   598    kloop(23);  kloop(30);  kloop(37);  kloop(44);  kloop(51);  kloop(58);\n   599    kloop(59);  kloop(52);  kloop(45);  kloop(38);  kloop(31);  kloop(39);\n   600    kloop(46);  kloop(53);  kloop(60);  kloop(61);  kloop(54);  kloop(47);\n   601    kloop(55);  kloop(62);  kloop(63);\n   602\n   603    /* If the last coef(s) were zero, emit an end-of-block code */\n   604    if (r > 0) {\n   605      code = actbl->ehufco[0];\n   606      size = actbl->ehufsi[0];\n   607      EMIT_BITS(code, size)\n   608    }\n   609\n   610    state->cur.put_buffer = put_buffer;\n   611    state->cur.put_bits = put_bits;\n   612    STORE_BUFFER()\n   613\n   614    return TRUE;\n   615  }\n   616\n   617\n   618  /*\n   619   * Emit a restart marker & resynchronize predictions.\n   620   */\n   621\n   622  LOCAL(boolean)\n   623  emit_restart(working_state *state, int restart_num)\n   624  {\n   625    int ci;\n   626\n   627    if (!flush_bits(state))\n   628      return FALSE;\n   629\n   630    emit_byte(state, 0xFF, return FALSE);\n   631    emit_byte(state, JPEG_RST0 + restart_num, return FALSE);\n   632\n   633    /* Re-initialize DC predictions to 0 */\n   634    for (ci = 0; ci < state->cinfo->comps_in_scan; ci++)\n   635      state->cur.last_dc_val[