              if (Al > 0 && pred >= (1 << Al))\n   563                pred = (1 << Al) - 1;\n   564            } else {\n   565              pred = (int)(((Q20 << 7) - num) / (Q20 << 8));\n   566              if (Al > 0 && pred >= (1 << Al))\n   567                pred = (1 << Al) - 1;\n   568              pred = -pred;\n   569            }\n   570            workspace[16] = (JCOEF)pred;\n   571          }\n   572          /* AC11 */\n   573          if ((Al = coef_bits[4]) != 0 && workspace[9] == 0) {\n   574            num = 5 * Q00 * (DC1 - DC3 - DC7 + DC9);\n   575            if (num >= 0) {\n   576              pred = (int)(((Q11 << 7) + num) / (Q11 << 8));\n   577              if (Al > 0 && pred >= (1 << Al))\n   578                pred = (1 << Al) - 1;\n   579            } else {\n   580              pred = (int)(((Q11 << 7) - num) / (Q11 << 8));\n   581              if (Al > 0 && pred >= (1 << Al))\n   582                pred = (1 << Al) - 1;\n   583              pred = -pred;\n   584            }\n   585            workspace[9] = (JCOEF)pred;\n   586          }\n   587          /* AC02 */\n   588          if ((Al = coef_bits[5]) != 0 && workspace[2] == 0) {\n   589            num = 9 * Q00 * (DC4 + DC6 - 2 * DC5);\n   590            if (num >= 0) {\n   591              pred = (int)(((Q02 << 7) + num) / (Q02 << 8));\n   592              if (Al > 0 && pred >= (1 << Al))\n   593                pred = (1 << Al) - 1;\n   594            } else {\n   595              pred = (int)(((Q02 << 7) - num) / (Q02 << 8));\n   596              if (Al > 0 && pred >= (1 << Al))\n   597                pred = (1 << Al) - 1;\n   598              pred = -pred;\n   599            }\n   600            workspace[2] = (JCOEF)pred;\n   601          }\n   602          /* OK, do the IDCT */\n   603          (*inverse_DCT) (cinfo, compptr, (JCOEFPTR)workspace, output_ptr,\n   604                          output_col);\n   605          /* Advance for next column */\n   606          DC1 = D