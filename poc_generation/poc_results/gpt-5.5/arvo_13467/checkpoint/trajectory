 in front of a number\n   278  static bool need_zero_prefix(uint64_t imm)\n   279  {\n   280          // find the first hex letter representing imm\n   281          while(imm >= 0x10)\n   282                  imm >>= 4;\n   283\n   284          if (imm < 0xa)\n   285                  return false;\n   286          else    // this need 0 prefix\n   287                  return true;\n   288  }\n   289\n   290  static void printImm(MCInst *MI, SStream *O, int64_t imm, bool positive)\n   291  {\n   292          if (positive) {\n   293                  // always print this number in positive form\n   294                  if (MI->csh->syntax == CS_OPT_SYNTAX_MASM) {\n   295                          if (imm < 0) {\n   296                                  if (MI->op1_size) {\n   297                                          switch(MI->op1_size) {\n   298                                                  default:\n   299                                                          break;\n   300                                                  case 1:\n   301                                                          imm &= 0xff;\n   302                                                          break;\n   303                                                  case 2:\n   304                                                          imm &= 0xffff;\n   305                                                          break;\n   306                                                  case 4:\n   307                                                          imm &= 0xffffffff;\n   308                                                          break;\n   309                                          }\n   310                                  }\n   311\n   312                                  if (imm == 0x8000000000000000LL)  // imm == -imm\n   313                                          SStream_concat0(O, \"8000000000000000h\");\n   314                                  else if (need_zero_prefix(imm))\n   315                                          SStream_concat(O, \"0%\"PRIx64\"h\", imm);\n   316                                  else\n   317                                          SStream_concat(O, \"%\"PRIx64\"h\", imm);\n   318                          } else {\n   319                                  if (imm > HEX_THRESHOLD) {\n   320                                          if (need_zero_prefix(imm))\n   321                                                  SStream_concat(O, \"0%\"PRIx64\"h\", imm);\n   322                                          else\n   323                                                  SStream_concat(O, \"%\"PRIx64\"h\", imm);\n   324                                  } else\n   325                                          SStream_concat(O, \"%\"PRIu64, imm);\n   326                          }\n   327                  } else {        // Intel syntax\n   328                          if (imm < 0) {\n   329                                  if (MI->op1_size) {\n   330                                          switch(MI->op1_size) {\n   331                                                  default:\n   332                                                          break;\n   333                                                  case 1:\n   334                                                          imm &= 0xff;\n   335                                                          break;\n   336                                                  case 2:\n   337                                                          imm &= 0xffff;\n   338                                                          break;\n   339                                                  case 4:\n   340                                                          imm &= 0xffffffff;\n   341                                                          break;\n   342                                          }\n   343                                  }\n   344\n   345                                  SStream_concat(O, \"0x%\"PRIx64, imm);\n   346                          } else {\n   347                                  if (imm > HEX_THRESHOLD)\n   348                                          SStream_concat(O, \"0x%\"PRIx64, imm);\n   349                                  else\n   350                                          SStream_concat(O, \"%\"PRIu64, imm);\n   351                          }\n   352                  }\n   353          } else {\n   354                  if (MI->csh->syntax == CS_OPT_SYNTAX_MASM) {\n   355                          if (imm < 0) {\n   356                                  if (imm == 0x8000000000000000LL)  // imm == -imm\n   357                                          SStream_concat0(O, \"8000000000000000h\");\n   358                                  else if (imm < -HEX_THRESHOLD) {\n   359                                          if (need_zero_prefix(imm))\n   360                                                  SStream_concat(O, \"-0%\"PRIx64\"h\", -imm);\n   361                                          else\n   362                                                  SStream_concat(O, \"-%\"PRIx64\"h\", -imm);\n   363                                  } else\n   364                                          SStream_concat(O, \"-%\"PRIu64, -imm);\n   365                          } else {\n   366                                  if (imm > HEX_THRESHOLD) {\n   367                                          if (need_zero_prefix(imm))\n   368                                                  SStream_concat(O, \"0%\"PRIx64\"h\", imm);\n   369                                          else\n   370                                                  SStream_concat(O, \"%\"PRIx64\"h\", imm);\n   371                                  } else\n   372                                          SStream_concat(O, \"%\"PRIu64, imm);\n   373                          }\n   374                  } else {        // Intel syntax\n   375                          if (imm < 0) {\n   376                                  if (imm == 0x8000000000000000LL)  // imm == -imm\n   377                                          SStream_concat0(O, \"0x8000000000000000\");\n   378                                  else if (imm < -HEX_THRESHOLD)\n   379                                          SStream_concat(O, \"-0x%\"PRIx64, -imm);\n   380                                  else\n   381                                          SStream_concat(O, \"-%\"PRIu64, -imm);\n   382\n   383                          } else {\n   384                                  if (imm > HEX_THRESHOLD)\n   385                                          SStream_concat(O, \"0x%\"PRIx64, imm);\n   386                                  else\n   387                                          SStream_concat(O, \"%\"PRIu64, imm);\n   388                          }\n   389                  }\n   390          }\n   391  }\n   392\n   393  // local printOperand, without updating public operands\n   394  static void _printOperand(MCInst *MI, unsigned OpNo, SStream *O)\n   395  {\n   396          MCOperand *Op  = MCInst_getOperand(MI, OpNo);\n   397          if (MCOperand_isReg(Op)) {\n   398                  printRegName(O, MCOperand_getReg(Op));\n   399          } else if (MCOperand_isImm(Op)) {\n   400                  int64_t imm = MCOperand_getImm(Op);\n   401                  printImm(MI, O, imm, MI->csh->imm_unsigned);\n   402          }\n   403  }\n   404\n   405  #ifndef CAPSTONE_DIET\n   406  // copy & normalize access info\n   407  static void get_op_access(cs_struct *h, unsigned int id, uint8_t *access, uint64_t *eflags)\n   408  {\n   409  #ifndef CAPSTONE_DIET\n   410          uint8_t i;\n   411          uint8_t *arr = X86_get_op_access(h, id, eflags);\n   412\n   413          if (!arr) {\n   414                  access[0] = 0;\n   415                  return;\n   416          }\n   417\n   418          // copy to access but zero out CS_AC_IGNORE\n   419          for(i = 0; arr[i]; i++) {\n   420                  if (arr[i] != CS_AC_IGNORE)\n   421                          access[i] = arr[i];\n   422                  else\n   423                          access[i] = 0;\n   424          }\n   425\n   426          // mark the end of array\n   427          access[i] = 0;\n   428  #endif\n   429  }\n   430  #endif\n   431\n   432  static void printSrcIdx(MCInst *MI, unsigned Op, SStream *O)\n   433  {\n   434          MCOperand *SegReg;\n   435          int reg;\n   436\n   437          if (MI->csh->detail) {\n   438  #ifndef CAPSTONE_DIET\n   439                  uint8_t access[6];\n   440  #endif\n   441\n   442                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].type = X86_OP_MEM;\n   443                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].size = MI->x86opsize;\n   444                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.segment = X86_REG_INVALID;\n   445                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.base = X86_REG_INVALID;\n   446                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.index = X86_REG_INVALID;\n   447                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.scale = 1;\n   448                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.disp = 0;\n   449\n   450  #ifndef CAPSTONE_DIET\n   451                  get_op_access(MI->csh, MCInst_getOpcode(MI), access, &MI->flat_insn->detail->x86.eflags);\n   452                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].access = access[MI->flat_insn->detail->x86.op_count];\n   453  #endif\n   454          }\n   455\n   456          SegReg = MCInst_getOperand(MI, Op + 1);\n   457          reg = MCOperand_getReg(SegReg);\n   458\n   459          // If this has a segment register, print it.\n   460          if (reg) {\n   461                  _printOperand(MI, Op + 1, O);\n   462                  if (MI->csh->detail) {\n   463                          MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.segment = X86_register_map(reg);\n   464                  }\n   465                  SStream_concat0(O, \":\");\n   466          }\n   467\n   468          SStream_concat0(O, \"[\");\n   469          set_mem_access(MI, true);\n   470          printOperand(MI, Op, O);\n   471          SStream_concat0(O, \"]\");\n   472          set_mem_access(MI, false);\n   473  }\n   474\n   475  static void printDstIdx(MCInst *MI, unsigned Op, SStream *O)\n   476  {\n   477          if (MI->csh->detail) {\n   478  #ifndef CAPSTONE_DIET\n   479                  uint8_t access[6];\n   480  #endif\n   481\n   482                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].type = X86_OP_MEM;\n   483                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].size = MI->x86opsize;\n   484                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.segment = X86_REG_INVALID;\n   485                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.base = X86_REG_INVALID;\n   486                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.index = X86_REG_INVALID;\n   487                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.scale = 1;\n   488                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.disp = 0;\n   489\n   490  #ifndef CAPSTONE_DIET\n   491                  get_op_access(MI->csh, MCInst_getOpcode(MI), access, &MI->flat_insn->detail->x86.eflags);\n   492                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].access = access[MI->flat_insn->detail->x86.op_count];\n   493  #endif\n   494          }\n   495\n   496          // DI accesses are always ES-based on non-64bit mode\n   497          if (MI->csh->mode != CS_MODE_64) {\n   498                  SStream_concat(O, \"es:[\");\n   499                  if (MI->csh->detail) {\n   500                          MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.segment = X86_REG_ES;\n   501                  }\n   502          } else\n   503                  SStream_concat(O, \"[\");\n   504\n   505          set_mem_access(MI, true);\n   506          printOperand(MI, Op, O);\n   507          SStream_concat0(O, \"]\");\n   508          set_mem_access(MI, false);\n   509  }\n   510\n   511  static void printSrcIdx8(MCInst *MI, unsigned OpNo, SStream *O)\n   512  {\n   513          SStream_concat0(O, \"byte ptr \");\n   514          MI->x86opsize = 1;\n   515          printSrcIdx(MI, OpNo, O);\n   516  }\n   517\n   518  static void printSrcIdx16(MCInst *MI, unsigned OpNo, SStream *O)\n   519  {\n   520          SStream_concat0(O, \"word ptr \");\n   521          MI->x86opsize = 2;\n   522          printSrcIdx(MI, OpNo, O);\n   523  }\n   524\n   525  static void printSrcIdx32(MCInst *MI, unsigned OpNo, SStream *O)\n   526  {\n   527          SStream_concat0(O, \"dword ptr \");\n   528          MI->x86opsize = 4;\n   529          printSrcIdx(MI, OpNo, O);\n   530  }\n   531\n   532  static void printSrcIdx64(MCInst *MI, unsigned OpNo, SStream *O)\n   533  {\n   534          SStream_concat0(O, \"qword ptr \");\n   535          MI->x86opsize = 8;\n   536          printSrcIdx(MI, OpNo, O);\n   537  }\n   538\n   539  static void printDstIdx8(MCInst *MI, unsigned OpNo, SStream *O)\n   540  {\n   541          SStream_concat0(O, \"byte ptr \");\n   542          MI->x86opsize = 1;\n   543          printDstIdx(MI, OpNo, O);\n   544  }\n   545\n   546  static void printDstIdx16(MCInst *MI, unsigned OpNo, SStream *O)\n   547  {\n   548          SStream_concat0(O, \"word ptr \");\n   549          MI->x86opsize = 2;\n   550          printDstIdx(MI, OpNo, O);\n   551  }\n   552\n   553  static void printDstIdx32(MCInst *MI, unsigned OpNo, SStream *O)\n   554  {\n   555          SStream_concat0(O, \"dword ptr \");\n   556          MI->x86opsize = 4;\n   557          printDstIdx(MI, OpNo, O);\n   558  }\n   559\n   560  static void printDstIdx64(MCInst *MI, unsigned OpNo, SStream *O)\n   561  {\n   562          SStream_concat0(O, \"qword ptr \");\n   563          MI->x86opsize = 8;\n   564          printDstIdx(MI, OpNo, O);\n   565  }\n   566\n   567  static void printMemOffset(MCInst *MI, unsigned Op, SStream *O)\n   568  {\n   569          MCOperand *DispSpec = MCInst_getOperand(MI, Op);\n   570          MCOperand *SegReg = MCInst_getOperand(MI, Op + 1);\n   571          int reg;\n   572\n   573          if (MI->csh->detail) {\n   574  #ifndef CAPSTONE_DIET\n   575                  uint8_t access[6];\n   576  #endif\n   577\n   578                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].type = X86_OP_MEM;\n   579                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].size = MI->x86opsize;\n   580                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.segment = X86_REG_INVALID;\n   581                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.base = X86_REG_INVALID;\n   582                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.index = X86_REG_INVALID;\n   583                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.scale = 1;\n   584                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.disp = 0;\n   585\n   586  #ifndef CAPSTONE_DIET\n   587                  get_op_access(MI->csh, MCInst_getOpcode(MI), access, &MI->flat_insn->detail->x86.eflags);\n   588                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].access = access[MI->flat_insn->detail->x86.op_count];\n   589  #endif\n   590          }\n   591\n   592          // If this has a segment register, print it.\n   593          reg = MCOperand_getReg(SegReg);\n   594          if (reg) {\n   595                  _printOperand(MI, Op + 1, O);\n   596                  SStream_concat0(O, \":\");\n   597                  if (MI->csh->detail) {\n   598                          MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.segment = X86_register_map(reg);\n   599                  }\n   600          }\n   601\n   602          SStream_concat0(O, \"[\");\n   603\n   604          if (MCOperand_isImm(DispSpec)) {\n   605                  int64_t imm = MCOperand_getImm(DispSpec);\n   606                  if (MI->csh->detail)\n   607                          MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].mem.disp = imm;\n   608\n   609                  if (imm < 0)\n   610                          printImm(MI, O, arch_masks[MI->csh->mode] & imm, true);\n   611                  else\n   612                          printImm(MI, O, imm, true);\n   613          }\n   614\n   615          SStream_concat0(O, \"]\");\n   616\n   617          if (MI->csh->detail)\n   618                  MI->flat_insn->detail->x86.op_count++;\n   619\n   620          if (MI->op1_size == 0)\n   621                  MI->op1_size = MI->x86opsize;\n   622  }\n   623\n   624  static void printU8Imm(MCInst *MI, unsigned Op, SStream *O)\n   625  {\n   626          uint8_t val = MCOperand_getImm(MCInst_getOperand(MI, Op)) & 0xff;\n   627\n   628          printImm(MI, O, val, true);\n   629\n   630          if (MI->csh->detail) {\n   631  #ifndef CAPSTONE_DIET\n   632                  uint8_t access[6];\n   633  #endif\n   634\n   635                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].type = X86_OP_IMM;\n   636                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].imm = val;\n   637                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].size = 1;\n   638\n   639  #ifndef CAPSTONE_DIET\n   640                  get_op_access(MI->csh, MCInst_getOpcode(MI), access, &MI->flat_insn->detail->x86.eflags);\n   641                  MI->flat_insn->detail->x86.operands[MI->flat_insn->detail->x86.op_count].access = access[MI->flat_insn->detail->x86.op_count];\n   642  #endif\n   643\n   644                  MI->flat_insn->detail->x86.op_count++;\n   645          }\n   646  }\n   647\n   648  static void printMemOffs8(MCInst *MI, unsigned OpNo, SStream *O)\n   649  {\n   650          SStream_concat0(O, \"byte ptr \");\n   651          MI->x86opsize = 1;\n   652          printMemOffset(MI, OpNo, O);\n   653  }\n   654\n   655  static void printMemOffs16(MCInst *MI, unsigned OpNo, SStream *O)\n   656  {\n   657          SStream_concat0(O, \"word ptr \");\n   658          MI->x86opsize = 2;\n   659          printMemOffset(MI, OpNo, O);\n   660  }\n   661\n   662  static void printMemOffs32(MCInst *MI, unsigned OpNo, SStream *O)\n   663  {\n   664          SStream_concat0(O, \"dword ptr \");\n   665          MI->x86opsize = 4;\n   666          printMemOffset(MI, OpNo, O);\n   667  }\n   668\n   669  static void printMemOffs64(MCInst *MI, unsigned OpNo, SStream *O)\n   670  {\n   671          SStream_concat0(O, \"qword ptr \");\n   672          MI->x86opsize = 8;\n   673          printMemOffset(MI, OpNo, O);\n   674  }\n   675\n   676  #ifndef CAPSTONE_DIET\n   677  static char *printAliasInstr(MCInst *MI, SStream *OS);\n   678  #endif\n   679  static void printInstruction(MCInst *MI, SStream *O);\n   680\n   681  void X86_Intel_printInst(MCInst *MI, SStream *O, void *Info)\n   682  {\n   683  #ifndef CAPSTONE_DIET\n   684          char *mnem;\n   685  #endif\n   686          x86_reg reg, reg2;\n   687          enum cs_ac_type access1, access2;\n   688\n   689          // perhaps this instruction does not need printer\n   690          if (MI->assembly[0]) {\n   691                  strncpy(O->buffer, MI->assembly, sizeof(O->buffer));\n   692                  return;\n   693          }\n   694\n   695  #ifndef CAPSTONE_DIET\n   696          // Try to print any aliases first.\n   697          mnem = printAliasInstr(MI, O);\n   698          if (mnem)\n   699                  cs_mem_free(mnem);\n   700          else\n   701  #endif\n   702          {\n   703                  X86_lockrep(MI, O);\n   704                  printInstruction(MI, O);\n   705          }\n   706\n   707          reg = X86_insn_reg_intel(MCInst_getOpcode(MI), &access1);\n   708          if (MI->csh->detail) {\n   709  #ifndef CAPSTONE_DIET\n   710                  uint8_t access[6] = {0};\n   711  #endif\n   712\n   713                  // first op can be embedded in the asm by llvm.\n   714                  // so we have to add the missing register as the first operand\n   715                  if (reg) {\n   716                          // shift all the ops right to leave 1st slot for this new register op\n   717                          memmove(&(MI->flat_insn->detail->x86.operands[1]), &(MI->flat_insn->detail->x86.operands[0]),\n   718                                          sizeof(MI->flat_insn->detail->x86.operands[0]) * (ARR_SIZE(MI->flat_insn->detail->x86.operands) - 1));\n   719                          MI->flat_insn->detail->x86.operands[0].type = X86_OP_REG;\n   720                          MI->flat_insn->detail->x86.operands[0].reg = reg;\n   721                          MI->flat_insn->detail->x86.operands[0].size = MI->csh->regsize_map[reg];\n   722                          MI->flat_insn->detail->x86.operands[0].access = access1;\n   723                          MI->flat_insn->detail->x86.op_count++;\n   724                  } else {\n   725                          if (X86_insn_reg_intel2(MCInst_getOpcode(MI), &reg, &access1, &reg2, &access2)) {\n   726                                  MI->flat_insn->detail->x86.operands[0].type = X86_OP_REG;\n   727                                  MI->flat_insn->detail->x86.operands[0].reg = reg;\n   728                                  MI->flat_insn->detail->x86.operands[0].size = MI->csh->regsize_map[reg];\n   729                                  MI->flat_insn->detail->x86.operands[0].access = access1;\n   730                                  MI->flat_insn->detail->x86.operands[1].type = X86_OP_REG;\n   731                                  MI->flat_insn->detail->x86.operands[1].reg = reg2;\n   732                                  MI->flat_insn->detail->x86.operands[1].size = MI->csh->regsize_map[reg2];\n   733                                  MI->flat_insn->detail->x86.operands[1].access = access2;\n   734                                  MI->flat_insn->detail->x86.op_count = 2;\n   735                          }\n   736                  }\n   737\n   738  #ifndef CAPSTONE_DIET\n   739                  get_op_access(MI->csh, MCInst_getOpcode(MI), access, &MI->flat_insn->detail->x86.eflags);\n   740                  MI->flat_insn->detail->x86.operands[0].access = access[0];\n   741                  MI->flat_insn->detail->x86.operands[1].access = access[1];\n   742  #endif\n   743          }\n   744\n   745          if (MI->op1_size == 0 && reg)\n   746                  MI->op1_size = MI->csh->regsize_map[reg];\n   747  }\n   748\n   749  /// printPCRelImm - This is used to print an immediate value that ends up\n   750  /// being encoded as a pc-relative value.\n   751  static void printPCRelImm(MCInst *MI, unsigned OpNo, SStream *O)\n   752  {\n   753          MCOperand *Op = MCInst_getOperand(MI, OpNo);\n   754          if (MCOperand_isImm(Op)) {\n   755                  int64_t imm = MCOperand_getImm(Op) + MI->flat_insn->size + MI->address;\n   756                  uint8_t opsize = X86_immediate_size(MI->