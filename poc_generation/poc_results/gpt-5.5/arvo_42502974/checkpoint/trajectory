en, NULL, NULL, NULL) < 0) {\n   297                  fr_strerror_printf(\"Problems to decode %s using fr_struct_from_network()\", attr_tacacs_packet->name);\n   298                  return -1;\n   299          }\n   300\n   301          /*\n   302           *      3.6. Encryption\n   303           *\n   304           *      Packets are encrypted if the unencrypted flag is clear.\n   305           */\n   306          if ((pkt->hdr.flags & FR_TAC_PLUS_UNENCRYPTED_FLAG) == 0) {\n   307                  size_t length;\n   308\n   309                  if (!secret || secret_len < 1) {\n   310                          fr_strerror_const(\"Packet is encrypted, but no secret is set.\");\n   311                          return -1;\n   312                  }\n   313\n   314                  length = ntohl(pkt->hdr.length);\n   315\n   316                  /*\n   317                   *      We need that to decrypt the body content.\n   318                   */\n   319                  decrypted = talloc_memdup(ctx, buffer, buffer_len);\n   320                  if (!decrypted) {\n   321                          fr_strerror_const(\"Out of Memory\");\n   322                          return -1;\n   323                  }\n   324\n   325                  pkt = (fr_tacacs_packet_t const *) decrypted;\n   326                  end = decrypted + buffer_len;\n   327\n   328                  if (fr_tacacs_body_xor(pkt, decrypted + sizeof(pkt->hdr), length, secret, secret_len) < 0) {\n   329                  fail:\n   330                          talloc_free(decrypted);\n   331                          return -1;\n   332                  }\n   333\n   334                  FR_PROTO_HEX_DUMP(decrypted, buffer_len, \"fr_tacacs_packet_t (unencrypted)\");\n   335          }\n   336\n   337          switch (pkt->hdr.type) {\n   338          case FR_TAC_PLUS_AUTHEN:\n   339                  if (packet_is_authen_start_request(pkt)) {\n   340                          uint8_t want;\n   341\n   342 