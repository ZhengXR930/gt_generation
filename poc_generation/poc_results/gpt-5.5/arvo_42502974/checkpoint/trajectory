     *dl_loader;\n    44\n    45  static fr_dict_t                *dict = NULL;\n    46  static fr_dict_gctx_t const     *dict_gctx = NULL;\n    47\n    48  int LLVMFuzzerInitialize(int *argc, char ***argv);\n    49  int LLVMFuzzerTestOneInput(const uint8_t *buf, size_t len);\n    50\n    51  static void exitHandler(void)\n    52  {\n    53          fr_dict_free(&dict, __FILE__);\n    54\n    55          if (fr_dict_global_ctx_free(dict_gctx) < 0) fr_perror(\"fuzzer\");\n    56\n    57          if (dl && dl->handle) {\n    58                  dlclose(dl->handle);\n    59                  dl->handle = NULL;\n    60          }\n    61          talloc_free(dl_loader);\n    62  }\n    63\n    64  int LLVMFuzzerInitialize(int *argc, char ***argv)\n    65  {\n    66          char const              *lib_dir  = getenv(\"FR_LIBRARY_PATH\");\n    67          char const              *proto    = getenv(\"FR_LIBRARY_FUZZ_PROTOCOL\");\n    68          char const              *dict_dir = getenv(\"FR_DICTIONARY_DIR\");\n    69          char                    buffer[1024];\n    70\n    71          if (!argc || !argv || !*argv) return -1; /* shut up clang scan */\n    72\n    73          /*\n    74           *      Setup atexit handlers to free any thread local\n    75           *      memory on exit\n    76           */\n    77          fr_atexit_global_setup();\n    78\n    79          /*\n    80           *      Initialise the error stack _before_ we run any\n    81           *      tests so there's no chance of the memory\n    82           *      appearing as a leak the first time an error\n    83           *      is generated.\n    84           */\n    85          fr_strerror_const(\"fuzz\"); /* allocate the pools */\n    86          fr_strerror_clear(); /* clears the message, leaves the pools */\n    87\n    88          /*\n    89           *      Setup our own internal atexit handler\n    90           */\n    91          if (atexit(exitHandler)) {\n    92                  fr_perror(\"fuzzer: Failed to register exit handler: %s\", fr_syserror(errno));\n    93                  fr_exit_now(EXIT_FAILURE);\n    94          }\n    95\n    96          /*\n    97           *      Get the name from the binary name of fuzzer_foo\n    98           */\n    99          if (!proto) {\n   100                  proto = strrchr((*argv)[0], '_');\n   101                  if (proto) proto++;\n   102          }\n   103\n   104          /*\n   105           *      Look for -D dir\n   106           *\n   107           *      If found, nuke it from the argument list.\n   108           */\n   109          if (!dict_dir) {\n   110                  int i, j;\n   111\n   112                  for (i = 0; i < *argc - 1; i++) {\n   113                          char *p = (*argv)[i];\n   114\n   115                          if ((p[0] == '-') && (p[1] == 'D')) {\n   116                                  dict_dir = (*argv)[i + 1];\n   117\n   118                                  for (j = i + 2; j < *argc; i++, j++) {\n   119                                          (*argv)[i] = (*argv)[j];\n   120                                  }\n   121\n   122                                  *argc -= 2;\n   123                                  break;\n   124                          }\n   125                  }\n   126          }\n   127\n   128          if (!dict_dir) dict_dir = DICTDIR;\n   129\n   130          /*\n   131           *      When jobs=N is specified the fuzzer spawns worker processes via\n   132           *      a shell. We have removed any -D dictdir argument that were\n   133           *      supplied, so we pass it to our children via the environment.\n   134           */\n   135          if (setenv(\"FR_DICTIONARY_DIR\", dict_dir, 1)) {\n   136                  fprintf(stderr, \"Failed to set FR_DICTIONARY_DIR env variable\\n\");\n   137                  fr_exit_now(EXIT_FAILURE);\n   138          }\n   139\n   140          dict_gctx = fr_dict_global_ctx_init(NUL