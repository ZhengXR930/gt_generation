23          /*\n   224           *      Note that we don't set a limit on max_attributes here.\n   225           *      That MUST be set and checked in the underlying\n   226           *      transport, via a call to ???\n   227           */\n   228          fr_dcursor_init(&cursor, &request->request_pairs);\n   229          if (fr_tacacs_decode(request->request_ctx, request->packet->data, request->packet->data_len,\n   230                               NULL, client->secret, talloc_array_length(client->secret) - 1,\n   231                               &cursor) < 0) {\n   232                  RPEDEBUG(\"Failed decoding packet\");\n   233                  return -1;\n   234          }\n   235\n   236          /*\n   237           *      Set the rest of the fields.\n   238           */\n   239          request->client = UNCONST(RADCLIENT *, client);\n   240\n   241          request->packet->socket = address->socket;\n   242          fr_socket_addr_swap(&request->reply->socket, &address->socket);\n   243\n   244          REQUEST_VERIFY(request);\n   245\n   246          /*\n   247           *      If we're defining a dynamic client, this packet is\n   248           *      fake.  We don't have a secret, so we mash all of the\n   249           *      encrypted attributes to sane (i.e. non-hurtful)\n   250           *      values.\n   251           */\n   252          if (!client->active) {\n   253                  fr_pair_t *vp;\n   254\n   255                  fr_assert(client->dynamic);\n   256\n   257                  for (vp = fr_pair_list_head(&request->request_pairs);\n   258                       vp != NULL;\n   259                       vp = fr_pair_list_next(&request->request_pairs, vp)) {\n   260                          if (!vp->da->flags.subtype) {\n   261                                  switch (vp->da->type) {\n   262                                  default:\n   263                                          break;\n   264\n   265                                  case FR_TYPE_UINT32:\n   266                                          vp->vp_uint32 = 0;\n   267                                          break;\n   268\n   269                                  case FR_TYPE_IPV4_ADDR:\n   270                                          vp->vp_ipv4addr = INADDR_ANY;\n   271                                          break;\n   272\n   273                                  case FR_TYPE_OCTETS:\n   274                                          fr_pair_value_memdup(vp, (uint8_t const *) \"\", 1, true);\n   275                                          break;\n   276\n   277                                  case FR_TYPE_STRING:\n   278                                          fr_pair_value_strdup(vp, \"\");\n   279                                          break;\n   280                                  }\n   281                          }\n   282                  }\n   283          }\n   284\n   285          if (RDEBUG_ENABLED) {\n   286                  fr_pair_t *vp;\n   287\n   288                  RDEBUG(\"Received %s ID %i from %pV:%i to %pV:%i length %zu via socket %s\",\n   289                         fr_tacacs_packet_codes[request->packet->code],\n   290                         request->packet->id,\n   291                         fr_box_ipaddr(request->packet->socket.inet.src_ipaddr),\n   292                         request->packet->socket.inet.src_port,\n   293                         fr_box_ipaddr(request->packet->socket.inet.dst_ipaddr),\n   294                         request->packet->socket.inet.dst_port,\n   295                         request->packet->data_len,\n   296                         request->async->listen->name);\n   297\n   298                  log_request_pair_list(L_DBG_LVL_1, request, NULL, &request->request_pairs, NULL);\n   299\n   300                  /*\n   301                   *      Maybe the shared secret is wrong?\n   302                   */\n   303                  if (client->active &&\n   304      