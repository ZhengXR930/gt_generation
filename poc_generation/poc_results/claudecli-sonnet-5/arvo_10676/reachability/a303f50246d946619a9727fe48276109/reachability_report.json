    {
      "file": "src/server/ua_session.c",
      "function": "UA_Session_deleteMembersCleanup",
      "line": null,
      "code": "UA_Session_deleteSubscription(server, session, sub->subscriptionId);",
      "note": "Delayed session cleanup still tears down attached subscriptions from inside `UA_Session_deleteMembersCleanup`. In the saved witness this runs for the second, subscribed session callback `C2`, and `UA_Session_deleteSubscription` inserts `sub->delayedFreePointers` onto the same delayed-callback queue that `UA_WorkQueue_manuallyProcessDelayed` is already draining. The fix moves subscription and queued publish-response cleanup out of `UA_Session_deleteMembersCleanup` and performs it earlier in `removeSession` before the session itself is scheduled as delayed work.",
      "kind": "root_cause_function"
    },
