import "math"
import "pe"
import "elf"

rule test_many_modules {
    condition:
        math.entropy(0, 100) > 0 or
        math.entropy(100, 200) > 0 or
        math.entropy(200, 300) > 0 or
        math.entropy(300, 400) > 0 or
        math.entropy(400, 500) > 0 or
        math.entropy(500, 600) > 0 or
        math.entropy(600, 700) > 0 or
        math.entropy(700, 800) > 0 or
        math.entropy(800, 900) > 0 or
        math.entropy(900, 1000) > 0
}
