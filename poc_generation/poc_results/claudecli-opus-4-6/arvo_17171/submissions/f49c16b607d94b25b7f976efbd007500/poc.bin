<?xml version="1.0"?>
<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:crypto="http://exslt.org/crypto" version="1.0" extension-element-prefixes="crypto">
<xsl:output method="text"/>
<xsl:template match="/"><xsl:value-of select="crypto:rc4_decrypt('A','fffefdfcfbfaf9f8f7f6f5f4f3f2f1f0')"/></xsl:template>
</xsl:stylesheet>
