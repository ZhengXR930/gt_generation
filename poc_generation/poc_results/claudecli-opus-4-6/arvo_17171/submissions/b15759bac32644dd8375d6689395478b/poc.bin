<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:crypto="http://exslt.org/crypto" version="1.0" extension-element-prefixes="crypto">
<xsl:output omit-xml-declaration="yes"/>
<xsl:template match="/">
<r><xsl:value-of select="crypto:rc4_decrypt('A','fffefdfcfbfaf9f8f7f6f5f4f3f2f1f0')"/></r>
</xsl:template>
</xsl:stylesheet>
