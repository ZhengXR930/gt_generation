-- Tail call between vararg and non-vararg functions with many params
local function target(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p)
  return a
end

local function relay(...)
  return target(...)
end

local function starter(n, ...)
  if n <= 0 then
    return relay(...)
  end
  return starter(n - 1, n, ...)
end

starter(50)
