[{"step":1,"file":"description.txt","function":"<global>","line":1,"var":"fuzzed CIL policy text","code":"OSS-Fuzz reproducer for secilc-fuzzer","note":"Attacker-controlled policy text is parsed by the SELinux CIL frontend."},{"step":2,"file":"src-vul/selinux/libsepol/cil/src/cil_build_ast.c","function":"__cil_build_ast_node_helper","line":6613,"var":"parse_tree","code":"rc = cil_tree_walk(parse_tree, __cil_build_ast_node_helper, __cil_build_ast_first_child_helper, __cil_build_ast_last_child_helper, &extra_args);","note":"The parser walks the attacker-controlled tree and builds AST nodes for each CIL construct."},{"step":3,"file":"src-vul/selinux/libsepol/cil/src/cil_verify.c","function":"__cil_pre_verify_helper","line":1853,"var":"node->flavor == CIL_CLASSPERMISSION","code":"case CIL_CLASSPERMISSION: rc = __cil_verify_classpermission(node); break;","note":"During pre-verification, classpermission nodes are dispatched to the recursive class-permission verifier."},{"step":4,"file":"src-vul/selinux/libsepol/cil/src/cil_verify.c","function":"__cil_verify_classpermission","line":1792,"var":"cp->classperms","code":"return __cil_verify_classperms(cp->classperms, &cp->datum, NULL, &cp->datum, CIL_CLASSPERMISSION, 0, 2);","note":"The verifier starts recursion from the current classpermission's classperms list with a small initial recursion budget."},{"step":5,"file":"src-vul/selinux/libsepol/cil/src/cil_verify.c","function":"__cil_verify_classperms","line":1746,"var":"cmp->classperms","code":"rc = __cil_verify_classperms(cmp->classperms, orig, &cp->class->datum, &cmp->datum, CIL_MAP_PERM, steps, limit);","note":"Nested map permissions are followed recursively, propagating attacker-controlled references through classperms lists."},{"step":6,"file":"src-vul/selinux/libsepol/cil/src/cil_verify.c","function":"__cil_verify_classperms","line":1730,"var":"classperms","code":"if (classperms == NULL) { ... cil_tree_log(NODE(cur), CIL_ERR, \"Classpermission %s does not have a classpermissionset\", cur->name); }","note":"The recursive verifier dereferences the current symbol-table datum and its name while checking for missing classpermissionsets."},{"step":7,"file":"src-vul/selinux/libsepol/cil/src/cil_tree.c","function":"cil_tree_log","line":112,"var":"path resolution for NODE(cur)","code":"path = cil_tree_get_cil_path(node);","note":"Error reporting walks parent links from the current node to recover source information for the crashing datum."},{"step":8,"file":"src-vul/selinux/libsepol/cil/src/cil_tree.c","function":"cil_tree_get_next_path","line":43,"var":"node->parent chain","code":"node = node->parent;","note":"The source-path helper climbs the tree using parent pointers until it finds a source-info node or parse-tree metadata."},{"step":9,"file":"src-vul/selinux/libsepol/cil/src/cil_tree.c","function":"cil_tree_get_next_path","line":52,"var":"node->cl_head->next->next->next","code":"if (!node->cl_head || !node->cl_head->next || !node->cl_head->next->next || !node->cl_head->next->next->next) { goto exit; }","note":"The helper assumes a well-formed source-info chain and dereferences multiple next pointers while recovering the path."},{"step":10,"file":"src-vul/selinux/libsepol/cil/src/cil_tree.c","function":"cil_tree_get_next_path","line":57,"var":"*path","code":"*path = node->cl_head->next->next->next->data;","note":"A malformed or unexpected tree shape can make this source-info recovery read through invalid memory, producing the ASAN heap-buffer-overflow read."}]
