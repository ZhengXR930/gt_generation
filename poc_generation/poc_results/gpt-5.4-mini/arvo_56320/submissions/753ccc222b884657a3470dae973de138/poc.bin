*3DSMAX_ASCIIEXPORT 200
*COMMENT "trigger ASE importer"
*SCENE {
}
*MATERIAL_LIST {
  *MATERIAL_COUNT 1
  *MATERIAL 0 {
    *MATERIAL_NAME "root"
    *NUMSUBMTLS 1
    *SUBMATERIAL 0 {
      *MATERIAL_NAME "sub"
    }
  }
}
*GEOMOBJECT {
  *NODE_NAME "mesh"
  *MESH {
    *TIMEVALUE 0
    *MESH_NUMVERTEX 3
    *MESH_NUMFACES 1
    *MESH_NUMTVERTEX 3
    *MESH_VERTEX_LIST {
      *MESH_VERTEX 0 0.0 0.0 0.0
      *MESH_VERTEX 1 1.0 0.0 0.0
      *MESH_VERTEX 2 0.0 1.0 0.0
    }
    *MESH_TVERTLIST {
      *MESH_TVERT 0 0.0 0.0 0.0
      *MESH_TVERT 1 1.0 0.0 0.0
      *MESH_TVERT 2 0.0 1.0 0.0
    }
    *MESH_FACE_LIST {
      *MESH_FACE 0: A: 0 B: 1 C: 2 AB: 0 BC: 0 CA: 0 *MESH_SMOOTHING 1 *MESH_MTLID 0
    }
    *MESH_TFACELIST {
      *MESH_TFACE 0 0 1 2
    }
  }
}
