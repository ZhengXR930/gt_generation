[{"step":1,"file":"description.txt","function":"<global>","line":1,"var":"uswid input","code":"OSS-Fuzz issue 42534594 (fwupd): Heap-buffer-overflow READ 8 found by fuzz target uswid_fuzzer [asan]","note":"The vulnerable candidate is a crafted uSWID blob consumed by the fwupd uswid parser."},{"step":2,"file":"repo-vul/src-vul/fwupd/libfwupdplugin/fu-uswid-firmware.c","function":"fu_uswid_firmware_parse","line":76,"var":"st","code":"st = fu_struct_uswid_parse_stream(stream, offset, error);","note":"The attacker-controlled bytes are parsed as a uSWID header, producing the header fields used for bounds and payload handling."},{"step":3,"file":"repo-vul/src-vul/fwupd/libfwupdplugin/fu-uswid-firmware.c","function":"fu_uswid_firmware_parse","line":91,"var":"hdrsz","code":"hdrsz = fu_struct_uswid_get_hdrsz(st);","note":"The parsed header size is trusted and later used to locate the payload immediately after the header."},{"step":4,"file":"repo-vul/src-vul/fwupd/libfwupdplugin/fu-uswid-firmware.c","function":"fu_uswid_firmware_parse","line":92,"var":"payloadsz","code":"payloadsz = fu_struct_uswid_get_payloadsz(st);","note":"The parsed payload size is trusted and used to read the payload bytes from the input stream."},{"step":5,"file":"repo-vul/src-vul/fwupd/libfwupdplugin/fu-uswid-firmware.c","function":"fu_uswid_firmware_parse","line":116,"var":"payload","code":"payload = fu_input_stream_read_bytes(stream, offset + hdrsz, payloadsz, error);","note":"The parser reads the claimed payload length from the attacker-controlled offset, so malformed size fields can desynchronize the remaining parse state."},{"step":6,"file":"repo-vul/src-vul/fwupd/libfwupdplugin/fu-uswid-firmware.c","function":"fu_uswid_firmware_parse","line":129,"var":"payloadsz","code":"payloadsz = g_bytes_get_size(payload);","note":"The actual payload buffer length is derived from the bytes object and becomes the loop bound for parsing embedded coSWID records."},{"step":7,"file":"repo-vul/src-vul/fwupd/libfwupdplugin/fu-uswid-firmware.c","function":"fu_uswid_firmware_parse","line":130,"var":"offset_tmp","code":"for (gsize offset_tmp = 0; offset_tmp < payloadsz;) {","note":"The parser iterates over the payload as a concatenation of coSWID images, advancing by each image's reported size."},{"step":8,"file":"repo-vul/src-vul/fwupd/libfwupdplugin/fu-uswid-firmware.c","function":"fu_uswid_firmware_parse","line":135,"var":"fw2","code":"fw2 = fu_bytes_new_offset(payload, offset_tmp, payloadsz - offset_tmp, error);","note":"A slice of the attacker-controlled payload is handed to the coSWID parser without additional structural validation."},{"step":9,"file":"repo-vul/src-vul/fwupd/libfwupdplugin/fu-uswid-firmware.c","function":"fu_uswid_firmware_parse","line":136,"var":"firmware_coswid","code":"if (!fu_firmware_parse(firmware_coswid, fw2, flags | FWUPD_INSTALL_FLAG_NO_SEARCH, error))","note":"The nested coSWID parser consumes the slice and may report a size that is inconsistent with the remaining bytes."},{"step":10,"file":"repo-vul/src-vul/fwupd/libfwupdplugin/fu-uswid-firmware.c","function":"fu_uswid_firmware_parse","line":145,"var":"offset_tmp","code":"offset_tmp += fu_firmware_get_size(firmware_coswid);","note":"The loop advances by the nested image size; if that size is malformed, later iterations can read past the intended payload boundary and trigger the heap-buffer-overflow read in the nested parser."}] 
