[{"step":1,"file":"fuzzer/FuzzCUPS.c","function":"LLVMFuzzerTestOneInput","line":18,"var":"Data","code":"if (Size < kMinInputLength || Size > kMaxInputLength) return 1;","note":"Attacker-controlled bytes are accepted as a fuzz input when they fall within the size window."},{"step":2,"file":"fuzzer/FuzzCUPS.c","function":"LLVMFuzzerTestOneInput","line":24,"var":"DataFx","code":"DataFx = (char *)calloc(SizeFx,sizeof(char)); memcpy((void *)DataFx,(void *)Data,Size);","note":"The raw input is copied into a NUL-terminated heap buffer so it can be parsed as a C string."},{"step":3,"file":"fuzzer/FuzzCUPS.c","function":"LLVMFuzzerTestOneInput","line":31,"var":"DataFx","code":"_cupsRasterExecPS(&header, &preferred_bits,(char*)DataFx);","note":"The attacker-controlled string is passed into the PostScript mini-interpreter."},{"step":4,"file":"cups/raster-interpret.c","function":"_cupsRasterExecPS","line":535,"var":"codecopy","code":"codecopy = strdup(code)","note":"The interpreter duplicates the input and then scans it token by token."},{"step":5,"file":"cups/raster-interpret.c","function":"_cupsRasterExecPS","line":542,"var":"obj","code":"while ((obj = scan_ps(st, &codeptr)) != NULL)","note":"Each parsed token is pushed onto the PostScript stack and then executed by the switch statement."},{"step":6,"file":"cups/raster-interpret.c","function":"scan_ps","line":1338,"var":"obj.type","code":"if (!strcmp(obj.value.other, \"dup\")) obj.type = CUPS_PS_DUP;","note":"The crafted input can produce the dup operator token, which triggers stack duplication logic."},{"step":7,"file":"cups/raster-interpret.c","function":"_cupsRasterExecPS","line":580,"var":"CUPS_PS_DUP","code":"case CUPS_PS_DUP: pop_stack(st); copy_stack(st, 1);","note":"dup removes the operator token and asks copy_stack() to duplicate the top stack object."},{"step":8,"file":"cups/raster-interpret.c","function":"copy_stack","line":728,"var":"st->objs + n","code":"while (c > 0) { if (!push_stack(st, st->objs + n)) return (-1); n ++; c --; }","note":"copy_stack() re-pushes a pointer to an existing stack slot instead of deep-copying the object."},{"step":9,"file":"cups/raster-interpret.c","function":"push_stack","line":null,"var":"obj","code":"push_stack(st, st->objs + n)","note":"The duplicated stack entry aliases the original object storage, so later stack growth can invalidate the referenced slot."},{"step":10,"file":"cups/raster-interpret.c","function":"_cupsRasterExecPS","line":542,"var":"obj","code":"while ((obj = scan_ps(st, &codeptr)) != NULL)","note":"Further attacker-controlled tokens continue to mutate the same stack, eventually leaving an aliased object reachable by later operations."},{"step":11,"file":"cups/raster-interpret.c","function":"copy_stack","line":728,"var":"st->objs + n","code":"push_stack(st, st->objs + n)","note":"When the stack reallocates or objects are popped, the aliased pointer becomes stale, setting up a use-after-free read."},{"step":12,"file":"cups/raster-interpret.c","function":"_cupsRasterExecPS","line":545,"var":"DEBUG_object / DEBUG_stack","code":"DEBUG_object(\"_cupsRasterExecPS\", obj);","note":"The interpreter later reads fields from the stale stack object while formatting/debug-printing it, which is the memory-safety sink reported as copy_stack / _cupsRasterExecPS."}]
