[{"step":1,"file":"tools/fuzzers/fuzzer-jsi-entry.cpp","function":"LLVMFuzzerTestOneInput","line":15,"var":"data,size","code":"if (!size) return 0;","note":"The fuzzer entry receives attacker-controlled bytes and keeps non-empty inputs for further processing."},{"step":2,"file":"tools/fuzzers/fuzzer-jsi-entry.cpp","function":"LLVMFuzzerTestOneInput","line":22,"var":"s","code":"std::string s(reinterpret_cast<const char *>(data), size); s.append(\"\\0\");","note":"The raw input bytes are copied into a C++ string and nul-terminated so Hermes will parse them as JavaScript source text."},{"step":3,"file":"tools/fuzzers/fuzzer-jsi-entry.cpp","function":"LLVMFuzzerTestOneInput","line":28,"var":"runtime","code":"auto runtime = makeHermesRuntime();","note":"A Hermes runtime is created to evaluate the attacker-controlled source."},{"step":4,"file":"tools/fuzzers/fuzzer-jsi-entry.cpp","function":"LLVMFuzzerTestOneInput","line":32,"var":"runtime->evaluateJavaScript(...)","code":"runtime->evaluateJavaScript(std::make_unique<StringBuffer>(s), \"\");","note":"The crafted input is handed to Hermes as JavaScript code, reaching the parser and runtime execution path that can trigger the memory-safety bug."},{"step":5,"file":"API/hermes/hermes.cpp","function":"HermesRuntimeImpl::getPropertyNames","line":1677,"var":"ret","code":"jsi::Array getPropertyNames(const jsi::Object &obj)","note":"During execution, Hermes enumerates object property names into a JSI array that is later exposed to API callers."},{"step":6,"file":"API/hermes/hermes.cpp","function":"HermesRuntimeImpl::getPropertyNames","line":1683,"var":"name","code":"vm::CallResult<vm::Handle<vm::SegmentedArray>> cr = vm::getForInPropertyNames(&runtime_, handle(obj), beginIndex, endIndex);","note":"Hermes collects property names from internal storage; the vulnerable path is in the conversion of these names into JSI strings."},{"step":7,"file":"API/hermes/hermes.cpp","function":"HermesRuntimeImpl::getPropertyNames","line":1689,"var":"name","code":"if (name.isString()) { ret.setValueAtIndex(*this, i, valueFromHermesValue(name)); }","note":"String property names are converted back into JSI values; a malformed internal string representation can lead to an out-of-bounds read while materializing the result."},{"step":8,"file":"API/jsi/jsi/jsi.cpp","function":"String::utf8","line":null,"var":"runtime.utf8(*this)","code":"std::string utf8(Runtime& runtime) const { return runtime.utf8(*this); }","note":"The JSI string conversion reads the underlying Hermes string bytes into a std::string, which is the memory-safety sink when the string metadata is inconsistent."}]
