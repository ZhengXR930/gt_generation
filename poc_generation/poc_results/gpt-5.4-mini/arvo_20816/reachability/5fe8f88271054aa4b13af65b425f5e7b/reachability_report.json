      "function": "tls_process_ske_dhe",
      "line": null,
      "code": "if (EVP_PKEY_assign_DH(peer_tmp, dh) == 0) {\n    SSLfatal(s, SSL_AD_INTERNAL_ERROR, SSL_F_TLS_PROCESS_SKE_DHE,\n             ERR_R_EVP_LIB);\n    goto err;\n}",
