[{"step":1,"file":"plugins/uf2/fu-uf2-device.c","function":"fu_uf2_device_prepare_firmware","line":26,"var":"stream","code":"fu_firmware_parse_stream(firmware, stream, 0x0, flags, error)","note":"Attacker-controlled UF2 bytes are parsed from the input stream into the UF2 firmware object."},{"step":2,"file":"plugins/uf2/fu-uf2-firmware.c","function":"fu_uf2_firmware_parse","line":157,"var":"chunks","code":"chunks = fu_chunk_array_new_from_stream(stream, offset, 512, error)","note":"The input is split into 512-byte UF2 blocks, preserving the attacker-controlled block contents."},{"step":3,"file":"plugins/uf2/fu-uf2-firmware.c","function":"fu_uf2_firmware_parse_chunk","line":41,"var":"st","code":"st = fu_struct_uf2_parse(fu_chunk_get_data(chk), fu_chunk_get_data_sz(chk), 0, error)","note":"Each block is decoded as a UF2 header, exposing attacker-controlled flags, payload size, and extension-tag metadata."},{"step":4,"file":"plugins/uf2/fu-uf2-firmware.c","function":"fu_uf2_firmware_parse_chunk","line":98,"var":"datasz","code":"datasz = fu_struct_uf2_get_payload_size(st); g_byte_array_append(tmp, fu_struct_uf2_get_data(st, NULL), datasz)","note":"The parsed payload size is trusted and used to copy that many bytes from the UF2 block payload into a temporary buffer."},{"step":5,"file":"plugins/uf2/fu-uf2-firmware.c","function":"fu_uf2_firmware_parse_chunk","line":108,"var":"offset","code":"if (flags & FU_UF2_FIRMWARE_BLOCK_FLAG_HAS_EXTENSION_TAG) { gsize offset = FU_STRUCT_UF2_OFFSET_DATA; while (offset < bufsz) { ... } }","note":"When the extension-tag flag is set, parsing continues past the payload into the remaining block bytes using attacker-controlled tag records."},{"step":6,"file":"plugins/uf2/fu-uf2-firmware.c","function":"fu_uf2_firmware_parse_chunk","line":132,"var":"sz","code":"if (tag == FU_U2F_FIRMWARE_TAG_VERSION) { g_autofree gchar *utf8buf = g_malloc0(sz); if (!fu_memcpy_safe((guint8 *)utf8buf, sz, 0x0, buf, bufsz, offset + 0x4, sz - 4, error)) return FALSE; fu_firmware_set_version(FU_FIRMWARE(self), utf8buf); }","note":"A version tag causes the code to allocate a buffer of attacker-chosen size and copy sz-4 bytes from the UF2 block into it, which is the memory-safety sink that can read past the intended payload when the tag length is malformed."}]
