[{"step":1,"file":"repo-vul/src-vul/harfbuzz/test/fuzzing/hb-draw-fuzzer.cc","function":"LLVMFuzzerTestOneInput","line":79,"var":"data / size","code":"hb_blob_create((const char *) data, size, HB_MEMORY_MODE_READONLY, nullptr, nullptr)","note":"Attacker-controlled bytes become the font blob consumed by HarfBuzz."},{"step":2,"file":"repo-vul/src-vul/harfbuzz/test/fuzzing/hb-draw-fuzzer.cc","function":"LLVMFuzzerTestOneInput","line":80,"var":"face","code":"hb_face_create(blob, 0)","note":"The blob is parsed as an OpenType face, exposing tables such as gvar and glyf to later calls."},{"step":3,"file":"repo-vul/src-vul/harfbuzz/test/fuzzing/hb-draw-fuzzer.cc","function":"LLVMFuzzerTestOneInput","line":81,"var":"font","code":"hb_font_create(face)","note":"A font object is created from the parsed face so glyph drawing will consult the face tables."},{"step":4,"file":"repo-vul/src-vul/harfbuzz/test/fuzzing/hb-draw-fuzzer.cc","function":"LLVMFuzzerTestOneInput","line":89,"var":"coords","code":"hb_font_set_var_coords_normalized(font, coords, num_coords)","note":"The fuzzer-derived coordinates activate variable-font processing, which makes gvar deltas relevant during glyph path generation."},{"step":5,"file":"repo-vul/src-vul/harfbuzz/src/hb-draw.cc","function":"hb_font_draw_glyph","line":247,"var":"font->face->table.glyf / cff1 / cff2","code":"font->face->table.glyf->get_path(font, glyph, draw_helper)","note":"Drawing a glyph dispatches into the outline loaders, which in turn consult variable glyph data when the font is variable."},{"step":6,"file":"repo-vul/src-vul/harfbuzz/src/hb-ot-var-gvar-table.hh","function":"accelerator_t::apply_deltas_to_points","line":571,"var":"var_data","code":"const GlyphVarData &var_data = gvar_table->get_glyph_var_data(glyph);","note":"The gvar accelerator fetches per-glyph variation data for the current glyph id."},{"step":7,"file":"repo-vul/src-vul/harfbuzz/src/hb-ot-var-gvar-table.hh","function":"GlyphVarData::has_data","line":373,"var":"tupleVarCount","code":"bool has_data () const { return tupleVarCount; }","note":"The code treats any non-zero tupleVarCount as valid data without revalidating the backing range."},{"step":8,"file":"repo-vul/src-vul/harfbuzz/src/hb-ot-var-gvar-table.hh","function":"gvar::accelerator_t::get_glyph_var_data","line":473,"var":"return (((unsigned char *) this + start_offset) + dataZ)","code":"return (((unsigned char *) this + start_offset) + dataZ);","note":"A malformed gvar offset can make the returned reference point outside the sanitized table, so later reads from var_data dereference attacker-controlled out-of-bounds memory."}]
