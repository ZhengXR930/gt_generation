[{"step":1,"file":"src-vul/h5_extended_fuzzer.c","function":"LLVMFuzzerTestOneInput","line":11,"var":"data/size","code":"fwrite(data, size, 1, fp);","note":"Attacker-controlled bytes are written verbatim to a temporary HDF5 file that the target will reopen."},{"step":2,"file":"src-vul/h5_extended_fuzzer.c","function":"LLVMFuzzerTestOneInput","line":15,"var":"filename","code":"H5Fopen(filename, H5F_ACC_RDWR, H5P_DEFAULT);","note":"The crafted file is parsed as an HDF5 container, causing metadata decoding to consume the attacker-controlled object header contents."},{"step":3,"file":"src-vul/hdf5/src/H5D.c","function":"H5Dopen2","line":393,"var":"name","code":"H5Dopen2(loc_id, name, dapl_id)","note":"The fuzzer always tries to open dataset name \"dsetname\", which forces lookup of the dataset object and its datatype metadata."},{"step":4,"file":"src-vul/hdf5/src/H5Omessage.c","function":"H5O_msg_read_oh","line":487,"var":"oh->mesg[idx].type","code":"if (type == oh->mesg[idx].type) break; H5O_LOAD_NATIVE(...)","note":"Opening the dataset triggers object-header message loading, which decodes the stored datatype message from the file into native memory."},{"step":5,"file":"src-vul/hdf5/src/H5Odtype.c","function":"H5O__dtype_decode","line":1157,"var":"p","code":"if (H5O__dtype_decode_helper(ioflags, &p, dt) < 0)","note":"The datatype message decoder interprets the raw bytes and dispatches on the encoded datatype class and version."},{"step":6,"file":"src-vul/hdf5/src/H5Odtype.c","function":"H5O__dtype_decode_helper","line":577,"var":"dt->shared->u.array.ndims","code":"case H5T_ARRAY: dt->shared->u.array.ndims = *(*pp)++;","note":"For an array datatype, the first byte controls the number of dimensions, directly steering how many size fields the decoder will read."},{"step":7,"file":"src-vul/hdf5/src/H5Odtype.c","function":"H5O__dtype_decode_helper","line":581,"var":"dt->shared->u.array.dim[i]","code":"for (i = 0; i < dt->shared->u.array.ndims; i++) UINT32DECODE(*pp, dt->shared->u.array.dim[i]);","note":"The decoder reads one 32-bit dimension per declared axis and multiplies them into the total element count without validating that the product stays small."},{"step":8,"file":"src-vul/hdf5/src/H5Odtype.c","function":"H5O__dtype_decode_helper","line":587,"var":"*pp","code":"*pp += dt->shared->u.array.ndims * 4;","note":"The parser advances past the permutation bytes for the array encoding, so a large attacker-chosen rank also advances the read pointer over more file data."},{"step":9,"file":"src-vul/hdf5/src/H5Odtype.c","function":"H5O__dtype_decode_helper","line":590,"var":"dt->shared->parent","code":"if (NULL == (dt->shared->parent = H5T__alloc())) ... H5O__dtype_decode_helper(ioflags, pp, dt->shared->parent)","note":"The array base type is decoded recursively from the attacker-controlled stream, so nested datatype structures can amplify the amount of metadata consumed."},{"step":10,"file":"src-vul/hdf5/src/H5Odtype.c","function":"H5O__dtype_decode_helper","line":593,"var":"dt->shared->parent->shared->force_conv","code":"if (dt->shared->parent->shared->force_conv == TRUE) dt->shared->force_conv = TRUE;","note":"The decoded array type is finalized and later used by object-header consumers, so the malformed shape survives into subsequent reads."},{"step":11,"file":"src-vul/hdf5/src/H5Omessage.c","function":"H5O_msg_read_oh","line":521,"var":"type->copy","code":"if (NULL == (ret_value = (type->copy)(oh->mesg[idx].native, mesg))) ...","note":"The fully decoded datatype is copied out for the caller, which is the point where the corrupted metadata can drive an out-of-bounds read in downstream consumers."}]
