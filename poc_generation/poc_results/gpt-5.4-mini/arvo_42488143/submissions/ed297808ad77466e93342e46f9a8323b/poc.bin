[{"step":1,"file":"src-vul/fluent-bit/tests/internal/fuzzers/parser_fuzzer.c","function":"LLVMFuzzerTestOneInput","line":25,"var":"data,size","code":"LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)","note":"Attacker-controlled bytes enter the parser fuzz target as the raw input buffer."},{"step":2,"file":"src-vul/fluent-bit/tests/internal/fuzzers/parser_fuzzer.c","function":"LLVMFuzzerTestOneInput","line":33,"var":"fuzz_parser","code":"fuzz_parser = flb_parser_create(\"fuzzer\", format, pregex, time_fmt, time_key, time_offset, time_keep, types, types_len, list, fuzz_config);","note":"The input selects parser configuration, including JSON format and optional decoder rules, before parsing begins."},{"step":3,"file":"src-vul/fluent-bit/src/flb_parser_json.c","function":"flb_parser_json_do","line":49,"var":"mp_buf","code":"ret = flb_pack_json(in_buf, in_size, &mp_buf, &mp_size, &root_type);","note":"The raw input is converted into msgpack; on success the returned buffer becomes the parsed representation used downstream."},{"step":4,"file":"src-vul/fluent-bit/src/flb_parser_json.c","function":"flb_parser_json_do","line":89,"var":"tmp_out_buf","code":"ret = flb_parser_decoder_do(parser->decoders, mp_buf, mp_size, &tmp_out_buf, &tmp_out_size);","note":"When decoder rules are present, the msgpack buffer is passed to the decoder pipeline, which may replace the output buffer pointer."},{"step":5,"file":"src-vul/fluent-bit/src/flb_parser_decoder.c","function":"flb_parser_decoder_do","line":204,"var":"result.data","code":"msgpack_unpack_next(&result, in_buf, in_size, &off);","note":"The decoder unpacks the msgpack map and iterates over attacker-influenced key/value pairs to apply decode rules."},{"step":6,"file":"src-vul/fluent-bit/src/flb_parser_decoder.c","function":"flb_parser_decoder_do","line":352,"var":"data_sds","code":"tmp_sds = flb_sds_copy(data_sds, v.via.str.ptr, v.via.str.size);","note":"The original string value is copied into a mutable SDS buffer; this copy can reallocate and change the active pointer."},{"step":7,"file":"src-vul/fluent-bit/src/flb_parser_decoder.c","function":"flb_parser_decoder_do","line":403,"var":"dec_buf","code":"ret = decode_json(dec, (char *) data_sds, flb_sds_len(data_sds), &dec_buf, &dec_size, &dec_type);","note":"A decoder backend may allocate a new decoded buffer and return it through dec_buf, changing the value representation."},{"step":8,"file":"src-vul/fluent-bit/src/flb_parser_decoder.c","function":"flb_parser_decoder_do","line":480,"var":"out_sds","code":"tmp_sds = flb_sds_copy(out_sds, dec_buf, dec_size);","note":"The decoded buffer is copied into the output SDS that will later be packed into the outgoing msgpack map."},{"step":9,"file":"src-vul/fluent-bit/src/flb_parser_decoder.c","function":"flb_parser_decoder_do","line":519,"var":"mp_sbuf.data","code":"*out_buf = mp_sbuf.data;","note":"The decoder returns a freshly packed msgpack buffer to the JSON parser, which now owns the transformed record."},{"step":10,"file":"src-vul/fluent-bit/src/flb_parser_json.c","function":"flb_parser_json_do","line":194,"var":"tmp_out_buf","code":"flb_free(tmp_out_buf);","note":"The JSON parser frees the intermediate msgpack buffer after handing it to the caller, so any later use of that pointer becomes a use-after-free."}]
