[{"step":1,"file":"src/hb-aat-layout.cc","function":"hb_aat_layout_position","line":265,"var":"kerx_blob","code":"hb_blob_t *kerx_blob = font->face->table.kerx.get_blob ();","note":"Attacker-controlled font data is loaded as the kerx table blob for shaping."},{"step":2,"file":"src/hb-aat-layout.cc","function":"hb_aat_layout_position","line":270,"var":"c","code":"AAT::hb_aat_apply_context_t c (plan, font, buffer, kerx_blob);","note":"The apply context carries the parsed kerx blob and the output buffer into kerx processing."},{"step":3,"file":"src/hb-aat-layout-kerx-table.hh","function":"KerxSubTableFormat1::apply","line":371,"var":"driver","code":"StateTableDriver<Types, EntryData> driver (machine, c->buffer, c->font->face);","note":"The state-table driver begins iterating over glyphs and dispatching entries from the attacker-controlled machine."},{"step":4,"file":"src/hb-aat-layout-common.hh","function":"StateTableDriver::drive","line":721,"var":"entry","code":"const Entry<EntryData> *entry = machine.get_entryZ (state, klass);","note":"Each glyph class selects a state-machine entry, so malformed table contents control the transition and action fields."},{"step":5,"file":"src/hb-aat-layout-kerx-table.hh","function":"KerxSubTableFormat1::driver_context_t::transition","line":267,"var":"kern_idx","code":"unsigned int kern_idx = Format1EntryT::kernActionIndex (entry);","note":"The entry supplies an offset into the kerning action array, derived from font data."},{"step":6,"file":"src/hb-aat-layout-kerx-table.hh","function":"KerxSubTableFormat1::driver_context_t::transition","line":268,"var":"actions","code":"kern_idx = Types::offsetToIndex (kern_idx, &table->machine, kernAction.arrayZ); const FWORD *actions = &kernAction[kern_idx];","note":"The offset is converted to an array index and used to form a pointer into the kerning action table."},{"step":7,"file":"src/hb-aat-layout-kerx-table.hh","function":"KerxSubTableFormat1::driver_context_t::transition","line":271,"var":"actions","code":"if (!c->sanitizer.check_array (actions, depth * tuple_count)) { depth = 0; return false; }","note":"The runtime bounds check is intended to validate the action span, but the later read still depends on the attacker-chosen depth and tuple count."},{"step":8,"file":"src/hb-aat-layout-kerx-table.hh","function":"KerxSubTableFormat1::driver_context_t::transition","line":281,"var":"v","code":"int v = *actions;","note":"The code dereferences the action pointer and reads a kerning value from the table; if the pointer is invalid or insufficiently initialized, this is the memory-safety sink that can trigger the MSAN read."}]
