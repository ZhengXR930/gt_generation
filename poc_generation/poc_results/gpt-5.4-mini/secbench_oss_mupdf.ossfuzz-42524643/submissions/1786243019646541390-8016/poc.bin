[{"step":1,"file":"source/pdf/pdf-xref.c","function":"pdf_cache_object","line":2418,"var":"x->obj","code":"if (x->obj != NULL) return x;","note":"Attacker-controlled object numbers reach the xref cache; once populated, later callers reuse the cached pdf_obj pointer."},{"step":2,"file":"source/pdf/pdf-xref.c","function":"pdf_cache_object","line":2460,"var":"x->obj","code":"pdf_drop_obj(ctx, x->obj);","note":"During repair or object-stream handling, the cached object can be dropped and freed while the xref entry is still being updated."},{"step":3,"file":"source/pdf/pdf-xref.c","function":"pdf_resolve_indirect","line":2561,"var":"entry = pdf_cache_object(ctx, doc, num)","code":"entry = pdf_cache_object(ctx, doc, num);","note":"Resolving an indirect reference re-enters the cache path and can retrieve an entry whose object was just freed or replaced."},{"step":4,"file":"source/pdf/pdf-xref.c","function":"pdf_resolve_indirect","line":2568,"var":"ref","code":"ref = entry->obj;","note":"The resolver returns the cached pointer without taking a fresh ownership boundary, so a stale freed pointer can propagate outward."},{"step":5,"file":"source/pdf/pdf-xref.c","function":"pdf_resolve_indirect_chain","line":2588,"var":"ref","code":"ref = pdf_resolve_indirect(ctx, ref);","note":"Chained indirect resolution repeatedly follows the stale pointer, making the use-after-free reachable from higher-level PDF parsing code."},{"step":6,"file":"source/pdf/pdf-xref.c","function":"pdf_update_object","line":2790,"var":"x->obj","code":"pdf_drop_obj(ctx, x->obj);","note":"Updating or rewriting objects can free the previous object instance that other references still point to."},{"step":7,"file":"source/pdf/pdf-xref.c","function":"pdf_update_object","line":2795,"var":"newobj","code":"pdf_set_obj_parent(ctx, newobj, num);","note":"The replacement object is installed into the xref, but any earlier alias to the freed object remains dangling."},{"step":8,"file":"source/pdf/pdf-xref.c","function":"pdf_resolve_indirect_chain","line":2581,"var":"sanity","code":"while (pdf_is_indirect(ctx, ref))","note":"A later consumer walks the indirect chain again, dereferencing the dangling object and triggering the heap-use-after-free sink."}]
