[{"step":1,"file":"src/p_lx_elf.cpp","function":"PackLinuxElf64::unpack","line":7380,"var":"b_peek","code":"fi->readx(bp, sizeof(b_peek));","note":"Attacker-controlled packed ELF bytes are read into a fixed-size stack b_info buffer during ELF unpacking."},{"step":2,"file":"src/p_lx_elf.cpp","function":"PackLinuxElf64::unpack","line":7381,"var":"pos","code":"upx_off_t pos = fi->seek(-(off_t)sizeof(b_peek), SEEK_CUR);","note":"The code rewinds to the start of the just-read b_info so it can inspect nearby bytes in a larger peek window."},{"step":3,"file":"src/p_lx_elf.cpp","function":"PackLinuxElf64::unpack","line":7393,"var":"peek_arr","code":"unsigned char peek_arr[N_PEEK];","note":"A larger stack peek buffer is allocated to search for a valid b_info structure when the first parse looks suspicious."},{"step":4,"file":"src/p_lx_elf.cpp","function":"PackLinuxElf64::unpack","line":7396,"var":"peek_arr","code":"fi->seek(pos - H_PEEK, SEEK_SET); fi->readx(peek_arr, sizeof(peek_arr));","note":"Bytes surrounding the candidate header are copied into the stack peek buffer, creating the region later searched for a matching size field."},{"step":5,"file":"src/p_lx_elf.cpp","function":"PackLinuxElf64::unpack","line":7407,"var":"boff","code":"int boff = find_le32(peek_arr, sizeof(peek_arr), size);","note":"The code searches the stack buffer for the expected block size and uses the returned offset as the location of the b_info structure."},{"step":6,"file":"src/p_lx_elf.cpp","function":"PackLinuxElf64::unpack","line":7411,"var":"bp","code":"bp = (b_info *)(void *)&peek_arr[boff];","note":"The found offset is converted into a b_info pointer without verifying that boff + sizeof(b_info) stays within peek_arr."},{"step":7,"file":"src/p_lx_elf.cpp","function":"PackLinuxElf64::unpack","line":7413,"var":"sz_unc","code":"sz_unc = get_le32(&bp->sz_unc);","note":"This 4-byte read from bp->sz_unc is the memory-safety sink; a crafted offset can make it read past the end of the stack buffer."}]
