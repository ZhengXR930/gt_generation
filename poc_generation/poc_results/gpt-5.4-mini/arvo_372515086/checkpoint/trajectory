.name = \"-h\", .arg = &helpArg, .subcommand = generalHelp               \\\n    }                                                                          \\\n    }                                                                          \\\n    ;                                                                          \\\n                                                                               \\\n    H3Error generalHelp(int argc, char *argv[]) {                              \\\n        int arglen = sizeof(subcommands) / sizeof(subcommands[0]) - 1;         \\\n        Arg **args = calloc(arglen, sizeof(Arg *));                            \\\n        if (args == NULL) {                                                    \\\n            fprintf(stderr, \"Failed to allocate memory for argument parsing\"); \\\n            exit(1);                                                           \\\n        }                                                                      \\\n        args[0] = &helpArg;                                                    \\\n        for (int i = 0; i < arglen - 1; i++) {                                 \\\n            args[i + 1] = subcommands[i].arg;                                  \\\n        }                                                                      \\\n                                                                               \\\n        const char *helpText =                                                 \\\n            \"Please use one of the subcommands listed to perform an H3 \"       \\\n            \"calculation. Use h3 <SUBCOMMAND> --help for details on the \"      \\\n            \"usage of \"                                                        \\\n            \"any subcommand.\";                                                 \\\n        if (parseArgs(argc, argv, arglen, args, &helpArg, helpText)) {         \\\n            free(args);                                                        \\\n    