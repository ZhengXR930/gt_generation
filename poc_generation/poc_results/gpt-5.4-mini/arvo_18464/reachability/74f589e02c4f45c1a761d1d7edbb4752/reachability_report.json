      "kind": "root_cause_line"
    },
    {
      "file": "src/lib/lwan-config.c",
      "function": "backup",
      "line": null,
      "code": "if (*lexer->pos == '\\n')",
      "note": "ASan sink. `backup()` dereferences `lexer->pos` after decrementing from the EOF-lookahead state, and on the witnessed path that pointer equals `static_data + 32768`, one byte past the global buffer.",
      "kind": "sink_function"
