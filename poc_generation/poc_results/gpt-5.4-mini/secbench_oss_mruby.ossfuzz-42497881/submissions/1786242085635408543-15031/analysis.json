      "var": "prec",
      "code": "GETNUM(prec, precision);",
      "role": "source",
      "note": "The precision field is parsed from attacker-controlled format text into an mrb_int and then narrowed to int without a range check."
    },
    {
      "step": 2,
      "file": "mrbgems/mruby-sprintf/src/sprintf.c",
      "function": "get_num",
      "line": 548,
      "var": "next_n",
      "code": "*valp = (int)next_n;",
      "role": "root_cause",
      "note": "The parser explicitly casts the accumulated precision to int, so values above INT_MAX wrap into a negative precision."
    },
    {
      "step": 3,
      "file": "mrbgems/mruby-sprintf/src/sprintf.c",
      "function": "mrb_str_format",
      "line": 889,
      "var": "prec",
      "code": "if ((flags&FPREC) && (prec < slen)) { char *p = RSTRING_PTR(str) + prec; slen = prec; len = (mrb_int)(p - RSTRING_PTR(str)); }",
      "role": "intermediate",
      "note": "For %s/%p, the wrapped negative precision is used as a byte offset and length, producing a negative copy length."
    },
    {
      "step": 4,
      "file": "mrbgems/mruby-sprintf/src/sprintf.c",
      "function": "mrb_str_format",
      "line": 905,
      "var": "len",
      "code": "PUSH(RSTRING_PTR(str), len);",
      "role": "sink",
      "note": "The negative length reaches memcpy through PUSH, creating the memory-copy sink that can underflow into an oversized copy."
    }
