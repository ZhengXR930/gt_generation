    {
      "file": "lib/lookup.c",
      "function": "_tr46",
      "line": 303,
      "code": "ace = u32_to_u8 (s + 4, e - s - 4, NULL, &ace_len);",
      "note": "Converts the Unicode codepoints after the 'xn--' ACE prefix to a UTF-8 byte string via u32_to_u8. When the label is exactly 'xn--' with no payload, e - s - 4 == 0 so u32_to_u8 is called with length 0. It returns a heap-allocated buffer (ace) with ace_len == 0, containing no valid bytes.",
      "kind": "source"
    },
    {
      "file": "lib/puny_decode.c",
      "function": "_idn2_punycode_decode",
      "line": null,
      "code": "",
      "note": "Missing guard: the statement `b += delim(input[b])` executes unconditionally regardless of input_length. When input_length == 0, b == 0 from the preceding loop that never executed, and input[0] is out of bounds. The fix adds `if (input_length)` before this statement.",
      "kind": "root_cause_function"
    },
    {
      "file": "lib/puny_decode.c",
      "function": "_idn2_punycode_decode",
      "line": 164,
