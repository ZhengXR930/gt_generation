[{"step":1,"file":"code/AssetLib/FBX/FBXImporter.cpp","function":"FBXImporter::InternReadFile","line":141,"var":"contents","code":"stream->Read(&*contents.begin(), 1, contents.size() - 1);","note":"Attacker-controlled FBX bytes are loaded into the in-memory buffer that will be tokenized and parsed."},{"step":2,"file":"code/AssetLib/FBX/FBXImporter.cpp","function":"FBXImporter::InternReadFile","line":147,"var":"tokens","code":"Tokenize(tokens, begin, tempAllocator);","note":"The textual FBX input is converted into a token stream that preserves braces, keys, and data values from the attacker input."},{"step":3,"file":"code/AssetLib/FBX/FBXParser.cpp","function":"Parser::Parser","line":237,"var":"root","code":"root = new_Scope(*this, true);","note":"Parsing starts by constructing the top-level scope object that will own all parsed elements."},{"step":4,"file":"code/AssetLib/FBX/FBXParser.cpp","function":"Scope::Scope","line":205,"var":"element","code":"auto *element = new_Element(*n, parser);","note":"For each key token, the parser constructs an Element object from attacker-controlled token data."},{"step":5,"file":"code/AssetLib/FBX/FBXParser.cpp","function":"Element::Element","line":152,"var":"compound","code":"compound = new_Scope(parser);","note":"If the element is followed by an open brace, the constructor recursively creates a nested Scope for the element body."},{"step":6,"file":"code/AssetLib/FBX/FBXParser.cpp","function":"Element::Element","line":160,"var":"compound","code":"parser.AdvanceToNextToken(); return;","note":"The nested scope constructor consumes the closing brace and returns, leaving the element with a live compound scope pointer."},{"step":7,"file":"code/AssetLib/FBX/FBXParser.cpp","function":"Scope::Scope","line":214,"var":"element","code":"elements.insert(ElementMap::value_type(str, element));","note":"The newly created element is inserted into the scope map, so the scope now owns a pointer to the element."},{"step":8,"file":"code/AssetLib/FBX/FBXParser.cpp","function":"Scope::Scope","line":219,"var":"element","code":"delete element; ParseError(...);","note":"On malformed input where the parser reaches EOF inside a non-top-level scope, the code deletes the just-created element before unwinding."},{"step":9,"file":"code/AssetLib/FBX/FBXParser.cpp","function":"Scope::~Scope","line":228,"var":"v.second","code":"delete_Element(v.second);","note":"During unwinding, the owning scope destructor iterates its map and destroys every stored element again, including the one already deleted on the error path."},{"step":10,"file":"code/AssetLib/FBX/FBXParser.cpp","function":"Element::~Element","line":171,"var":"compound","code":"if (compound) { delete_Scope(compound); }","note":"Destroying the double-freed element also destroys its nested compound scope, causing the invalid free reported in the crash state."}]
