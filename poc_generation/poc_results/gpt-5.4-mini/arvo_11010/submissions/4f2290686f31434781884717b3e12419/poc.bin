[{"step":1,"file":"repo-vul/src-vul/harfbuzz/src/hb-aat-layout-kerx-table.hh","function":"AAT::KerxSubTableFormat1::driver_context_t::transition","line":157,"var":"entry->data.kernActionIndex","code":"const FWORD *actions = &kernAction[entry->data.kernActionIndex];","note":"A crafted kerx state-table entry supplies a non-0xFFFF action index, selecting an attacker-controlled action list inside the table."},{"step":2,"file":"repo-vul/src-vul/harfbuzz/src/hb-aat-layout-kerx-table.hh","function":"AAT::KerxSubTableFormat1::driver_context_t::transition","line":160,"var":"depth","code":"if (!c->sanitizer.check_array (actions, depth))","note":"The current kerning-stack depth determines how many FWORDs the code will read from the action list."},{"step":3,"file":"repo-vul/src-vul/harfbuzz/src/hb-aat-layout-kerx-table.hh","function":"AAT::KerxSubTableFormat1::driver_context_t::transition","line":166,"var":"actions[i]","code":"int v = *actions++;","note":"The loop dereferences successive action entries without any additional bounds check beyond the earlier depth-based validation."},{"step":4,"file":"repo-vul/src-vul/harfbuzz/src/hb-machinery.hh","function":"BEInt<Type, 2>::operator Type","line":671,"var":"v[0], v[1]","code":"return (v[0] <<  8) + (v[1]);","note":"Each FWORD is decoded through a 2-byte big-endian load; if the action pointer is out of bounds, this becomes the global-buffer-overflow read sink."}]
