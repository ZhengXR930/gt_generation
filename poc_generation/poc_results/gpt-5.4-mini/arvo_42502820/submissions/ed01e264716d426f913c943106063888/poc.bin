[{"step":1,"file":"src-vul/curl_fuzzer/curl_fuzzer.cc","function":"LLVMFuzzerTestOneInput","line":28,"var":"data,size","code":"LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)","note":"Attacker-controlled bytes enter the fuzzer entry point as the raw input candidate."},{"step":2,"file":"src-vul/curl_fuzzer/curl_fuzzer.cc","function":"LLVMFuzzerTestOneInput","line":41,"var":"fuzz","code":"fuzz_initialize_fuzz_data(&fuzz, data, size)","note":"The raw input is stored in fuzz.state so later TLV parsing and option setup consume the same attacker bytes."},{"step":3,"file":"src-vul/curl_fuzzer/curl_fuzzer_tlv.cc","function":"fuzz_get_tlv_comn","line":58,"var":"tlv->type / tlv->length / tlv->value","code":"tlv->type = to_u16(raw->raw_type); tlv->length = to_u32(raw->raw_length); tlv->value = &fuzz->state.data[data_offset];","note":"Each TLV header is decoded from attacker bytes into a type, length, and value pointer that drive subsequent curl configuration."},{"step":4,"file":"src-vul/curl_fuzzer/curl_fuzzer_tlv.cc","function":"fuzz_parse_tlv","line":92,"var":"TLV_TYPE_URL","code":"FSINGLETONTLV(fuzz, TLV_TYPE_URL, CURLOPT_URL);","note":"A TLV of type URL is converted into a NUL-terminated string and passed to CURLOPT_URL, letting the attacker choose the request target."},{"step":5,"file":"src-vul/curl/lib/url.c","function":"setopt","line":1768,"var":"data->set.str[STRING_SET_URL]","code":"case CURLOPT_URL: result = setstropt(&data->set.str[STRING_SET_URL], va_arg(param, char *));","note":"libcurl stores the attacker-controlled URL string in the easy handle for later request construction."},{"step":6,"file":"src-vul/curl_fuzzer/curl_fuzzer.cc","function":"fuzz_handle_transfer","line":286,"var":"fuzz->easy","code":"curl_multi_add_handle(multi_handle, fuzz->easy); curl_multi_perform(multi_handle, &still_running);","note":"The configured easy handle is executed, causing libcurl to parse the attacker-selected URL and build the HTTP transaction."},{"step":7,"file":"src-vul/curl/lib/http.c","function":"Curl_http","line":3688,"var":"k->p","code":"else if(checkprefix(\"Content-Range:\", k->p)) { ... }","note":"During HTTP response parsing, attacker-controlled response headers are examined and the Content-Range branch updates transfer state from the parsed text."},{"step":8,"file":"src-vul/curl/lib/http.c","function":"Curl_compareheader","line":1304,"var":"headerline[hlen]","code":"start = &headerline[hlen];","note":"Curl_compareheader advances a pointer by the header length and then scans the remainder of the line; malformed or unexpected header text can drive later out-of-bounds behavior in this parsing path."}]