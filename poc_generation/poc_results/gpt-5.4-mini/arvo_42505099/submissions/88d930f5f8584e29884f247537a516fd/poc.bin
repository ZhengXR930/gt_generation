<testcase>
<info>
<keywords>
FTP
</keywords>
</info>
<reply>
<servercmd>
REPLY EPSV 229 Entering Passiv Mode (|||1|)
REPLY PASV 227 Entering Passive Mode (999,0,0,1,4,51)
</servercmd>
<data>
hello
</data>
</reply>
<client>
<server>
ftp
</server>
<name>
FTP malformed PASV after EPSV fallback
</name>
<command>
ftp://%HOSTIP:%FTPPORT/1233
</command>
</client>
<verify>
<protocol>
USER anonymous
PASS ftp@example.com
PWD
EPSV
PASV
TYPE I
SIZE 1233
RETR 1233
QUIT
</protocol>
</verify>
</testcase>
