[{"step":1,"file":"repo-vul/src-vul/kimageformats/src/imageformats/heif.cpp","function":"HEIFHandler::ensureDecoder","line":10,"var":"buffer","code":"const QByteArray buffer = device()->readAll();","note":"Attacker-controlled HEIF bytes are read from the input device into a QByteArray."},{"step":2,"file":"repo-vul/src-vul/kimageformats/src/imageformats/heif.cpp","function":"HEIFHandler::ensureDecoder","line":11,"var":"buffer","code":"if (!HEIFHandler::isSupportedBMFFType(buffer)) {","note":"The parser only checks the BMFF signature before continuing, so a crafted HEIF-like container can reach the decoder path."},{"step":3,"file":"repo-vul/src-vul/kimageformats/src/imageformats/heif.cpp","function":"HEIFHandler::ensureDecoder","line":17,"var":"buffer.constData()/buffer.size()","code":"struct heif_error err = heif_context_read_from_memory(ctx, static_cast<const void *>(buffer.constData()), buffer.size(), nullptr);","note":"The in-memory attacker buffer is handed to libheif for parsing and context construction."},{"step":4,"file":"repo-vul/src-vul/kimageformats/src/imageformats/heif.cpp","function":"HEIFHandler::ensureDecoder","line":27,"var":"handle","code":"err = heif_context_get_primary_image_handle(ctx, &handle);","note":"A primary image handle is obtained from the parsed context and becomes the object used for subsequent metadata queries."},{"step":5,"file":"repo-vul/src-vul/kimageformats/src/imageformats/heif.cpp","function":"HEIFHandler::ensureDecoder","line":35,"var":"handle","code":"const bool hasAlphaChannel = heif_image_handle_has_alpha_channel(handle);","note":"The code queries image properties from the handle before decoding, keeping the libheif object alive across later operations."},{"step":6,"file":"repo-vul/src-vul/kimageformats/src/imageformats/heif.cpp","function":"HEIFHandler::ensureDecoder","line":76,"var":"handle","code":"err = heif_decode_image(handle, &img, heif_colorspace_RGB, chroma, decoder_option);","note":"The image is decoded from the handle into a libheif image object; the vulnerable state is reached in the decoder/handle lifetime management around this call."},{"step":7,"file":"repo-vul/src-vul/kimageformats/src/imageformats/heif.cpp","function":"HEIFHandler::ensureDecoder","line":105,"var":"src","code":"const uint8_t *const src = heif_image_get_plane_readonly(img, heif_channel_interleaved, &stride);","note":"The decoded plane pointer is fetched and later consumed by the copy loops, so any stale decoder state can surface as a use-after-free when the handler continues processing."}]
