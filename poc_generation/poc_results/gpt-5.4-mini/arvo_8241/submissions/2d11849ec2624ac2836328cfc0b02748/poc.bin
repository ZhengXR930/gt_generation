[{"step":1,"file":"ssl/statem/extensions_srvr.c","function":"tls_parse_ctos_psk","line":1047,"var":"sess","code":"if (s->psk_find_session_cb != NULL && !s->psk_find_session_cb(..., &sess))","note":"The server callback can supply a heap-allocated SSL_SESSION through sess based on attacker-chosen PSK identity bytes."},{"step":2,"file":"ssl/statem/extensions_srvr.c","function":"tls_parse_ctos_psk","line":1110,"var":"sesstmp","code":"SSL_SESSION *sesstmp = ssl_session_dup(sess, 0);","note":"The returned session is duplicated so the parser can safely own a separate copy for the handshake."},{"step":3,"file":"ssl/statem/extensions_srvr.c","function":"tls_parse_ctos_psk","line":1117,"var":"sess","code":"SSL_SESSION_free(sess); sess = sesstmp;","note":"The original callback session is freed and replaced with the duplicate; this is the critical ownership transition for the PSK session object."},{"step":4,"file":"ssl/statem/extensions_srvr.c","function":"tls_parse_ctos_psk","line":1232,"var":"s->session","code":"SSL_SESSION_free(s->session); s->session = sess;","note":"The selected PSK session becomes the connection session after the old one is freed, so any stale or double-freed sess state here can trigger a use-after-free during later handshake processing."}]