[{"step":1,"file":"ssl/statem/extensions_srvr.c","function":"tls_parse_ctos_psk","line":1155,"var":"sess","code":"SSL_SESSION_free(sess); sess = NULL;","note":"An incompatible PSK session is freed during ticket/PSK parsing, but the code path later reuses the local sess variable as the selected session pointer."},{"step":2,"file":"ssl/statem/extensions_srvr.c","function":"tls_parse_ctos_psk","line":1198,"var":"sess","code":"if (sess == NULL) return 1;","note":"The parser can continue with sess still NULL or with a freed object depending on the control flow, so later logic must treat it carefully."},{"step":3,"file":"ssl/statem/extensions_srvr.c","function":"tls_parse_ctos_psk","line":1223,"var":"sess","code":"tls_psk_do_binder(..., sess, ...)","note":"The binder verification routine consumes sess after the earlier free/NULL handling, making any stale or freed session state security-critical."},{"step":4,"file":"ssl/statem/extensions_srvr.c","function":"tls_parse_ctos_psk","line":1232,"var":"s->session","code":"SSL_SESSION_free(s->session); s->session = sess;","note":"The old session is freed and the new session pointer is installed; if sess was already freed or not properly reset, this creates a use-after-free hazard on the connection session."}]
