[{"step":1,"file":"src-vul/gdbm/src/gdbmseq.c","function":"gdbm_nextkey","line":180,"var":"key","code":"elem_loc = _gdbm_findkey (dbf, key, NULL, NULL);","note":"Attacker-controlled sequential-access key is passed into the lookup path to locate the current record before advancing."},{"step":2,"file":"src-vul/gdbm/src/findkey.c","function":"_gdbm_findkey","line":158,"var":"key","code":"_gdbm_hash_key (dbf, key, &new_hash_val, &bucket_dir, &elem_loc);","note":"The supplied key is hashed to derive the bucket directory and candidate element location used for validation and lookup."},{"step":3,"file":"src-vul/gdbm/src/findkey.c","function":"_gdbm_findkey","line":169,"var":"dbf->bucket->h_table[elem_loc]","code":"while (bucket_hash_val != -1) { ... if (bucket_hash_val != new_hash_val || key_size != key.dsize || memcmp (...) != 0) ... }","note":"The bucket entry is matched against the attacker-controlled key bytes and size to identify the record that will be returned to sequential access."},{"step":4,"file":"src-vul/gdbm/src/gdbmseq.c","function":"gdbm_valid_key_p","line":25,"var":"elem_loc","code":"_gdbm_hash_key (dbf, key, &hash, &bucket, &offset);","note":"The sequential-access verifier recomputes the hash from the returned key data, but it does not first validate that the bucket index is in range."},{"step":5,"file":"src-vul/gdbm/src/gdbmseq.c","function":"gdbm_valid_key_p","line":28,"var":"dbf->bucket->h_table[elem_loc].hash_value","code":"if (hash == dbf->bucket->h_table[elem_loc].hash_value && dbf->dir[bucket] == dbf->dir[dbf->bucket_dir]) return 1;","note":"The code dereferences the hash table entry and directory entry using the unchecked index; the missing gdbm_dir_entry_valid_p check and wrong check order can turn malformed sequential state into an out-of-bounds memory access or invalid validation."},{"step":6,"file":"src-vul/gdbm/src/gdbmseq.c","function":"get_next_key","line":96,"var":"return_val","code":"if (!gdbm_valid_key_p (dbf, find_data, dbf->bucket->h_ta