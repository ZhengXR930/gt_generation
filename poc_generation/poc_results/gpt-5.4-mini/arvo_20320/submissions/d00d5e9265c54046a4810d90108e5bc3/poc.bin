[{"step":1,"file":"ext/mbstring/tests/bug72399.phpt","function":"<global>","line":10,"var":"mb_ereg_search_init","code":"$var5 = mb_ereg_search_init(\"\",\"2\");","note":"The shared search state is initialized with an empty subject and attacker-controlled regex input."},{"step":2,"file":"ext/mbstring/tests/bug72399.phpt","function":"<global>","line":9,"var":"mb_eregi_replace","code":"$var6 = mb_eregi_replace(\"2\",\"\",\"\");","note":"A second regex operation runs immediately after initialization, mutating the shared mbstring regex state."},{"step":3,"file":"ext/mbstring/tests/bug72399.phpt","function":"<global>","line":12,"var":"mb_ereg_search_pos","code":"$var13 = mb_ereg_search_pos();","note":"The search API then reads the shared state, which is where the historical use-after-free was observed."},{"step":4,"file":"ext/mbstring/php_mbregex.c","function":"PHP_FUNCTION(mb_ereg_search_init)","line":0,"var":"MBREX(search_re)","code":"mb_ereg_search_init stores the compiled regex in the global search_re slot","note":"This shared slot is the vulnerable object whose lifetime is reused across mbstring regex APIs."},{"step":5,"file":"ext/mbstring/php_mbregex.c","function":"PHP_FUNCTION(mb_eregi_replace)","line":0,"var":"MBREX(search_re)","code":"mb_eregi_replace compiles and executes a new regex while the previous search state may still be referenced","note":"Cross-calling regex APIs can invalidate the shared search_re/search_regs state."},{"step":6,"file":"ext/mbstring/php_mbregex.c","function":"PHP_FUNCTION(mb_ereg_search_pos)","line":0,"var":"MBREX(search_re)","code":"if (MBREX(search_re) == NULL) { php_error_docref(NULL, E_WARNING, \"No regex given\"); RETURN_FALSE; }","note":"The search API dereferences the shared regex state after it may have been freed or replaced."},{"step":7,"file":"ext/mbstring/php_mbregex.c","function":"PHP_FUNCTION(mb_ereg_search_pos)","line":0,"var":"MBREX(search_regs)","code":"if (MBREX(search_regs) != NULL) { onig_region_free(MBREX(search_regs), 1); }","note":"The region object is explicitly freed and recreated, so stale references can become dangling if other code still uses them."},{"step":8,"file":"ext/mbstring/php_mbregex.c","function":"_php_mb_regex_ereg_search_exec","line":1551,"var":"MBREX(search_re)","code":"MBREX(search_re) = php_mbregex_compile_pattern(arg_pattern, arg_pattern_len, option, MBREX(current_mbctype), syntax);","note":"Compilation of a new pattern can replace the shared regex object and trigger the lifetime bug."},{"step":9,"file":"ext/mbstring/php_mbregex.c","function":"_php_mb_onig_search","line":880,"var":"err","code":"err = onig_search_with_param(reg, str, end, start, range, region, option, mp);","note":"The stale or replaced regex object is then used by the search engine, which is the memory-safety sink."}]