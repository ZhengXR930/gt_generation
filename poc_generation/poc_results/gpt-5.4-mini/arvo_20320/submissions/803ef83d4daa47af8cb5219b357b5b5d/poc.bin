[{"step":1,"file":"ext/mbstring/tests/mb_ereg_search_xxx.phpt","function":"test_search","line":17,"var":"look_for","code":"$look_for = mb_convert_encoding( $look_for, $test_enc, $in_enc );","note":"The attacker-controlled pattern is converted into the active regex encoding before compilation."},{"step":2,"file":"ext/mbstring/tests/mb_ereg_search_xxx.phpt","function":"test_search","line":18,"var":"mb_ereg_search_init","code":"mb_ereg_search_init( $str, $look_for, $opt );","note":"The converted pattern is compiled and stored in mbstring's shared search state."},{"step":3,"file":"ext/mbstring/php_mbregex.c","function":"PHP_FUNCTION(mb_ereg_search_init)","line":1264,"var":"MBREX(search_re)","code":"MBREX(search_re) = php_mbregex_compile_pattern(arg_pattern, arg_pattern_len, option, MBREX(current_mbctype), syntax);","note":"Compilation is the key entry point where the vulnerable AST analysis runs inside Oniguruma."},{"step":4,"file":"oniguruma/src/regcomp.c","function":"tune_quant","line":5458,"var":"qn->emptiness","code":"qn->emptiness = quantifiers_memory_node_info(body);","note":"When the quantified body can match empty, Oniguruma recursively classifies the subtree for memory-node and repeat interactions."},{"step":5,"file":"oniguruma/src/regcomp.c","function":"quantifiers_memory_node_info","line":4894,"var":"node","code":"static enum BodyEmptyType quantifiers_memory_node_info(Node* node)","note":"This recursive AST walk is the suspected root cause path from the crash report, matching the reported state names."},{"step":6,"file":"oniguruma/src/regcomp.c","function":"quantifiers_memory_node_info","line":4904,"var":"NODE_CAR(node)","code":"v = quantifiers_memory_node_info(NODE_CAR(node));","note":"Nested list/alt nodes are traversed recursively, so a crafted pattern can force repeated visits through the same logical subtree."},{"step":7,"file":"oniguruma/src/regcomp.c","function":"quantifiers_memory_node_info","line":4949,"var":"en->te.Then","code":"v = quantifiers_memory_node_info(en->te.Then);","note":"Conditional subtrees are also recursively analyzed, increasing the chance of hitting the vulnerable optimizer path with complex patterns."},{"step":8,"file":"ext/mbstring/php_mbregex.c","function":"_php_mb_regex_ereg_search_exec","line":1438,"var":"err","code":"err = _php_mb_onig_search(MBREX(search_re), str, str + len, str + pos, str  + len, MBREX(search_regs), 0);","note":"The compiled regex is executed against the subject string; if the vulnerable compiler state is reached, the crash manifests during regex processing."},{"step":9,"file":"ext/mbstring/php_mbregex.c","function":"PHP_FUNCTION(mb_ereg_search_getregs)","line":1592,"var":"MBREX(search_regs)","code":"if (MBREX(search_regs) != NULL && Z_TYPE(MBREX(search_str)) == IS_STRING) {","note":"The search result is later read back from the shared region, so any corruption in the regex/search state can surface here."}]