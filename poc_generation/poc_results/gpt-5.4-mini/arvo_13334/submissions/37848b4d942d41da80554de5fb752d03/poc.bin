[{"step":1,"file":"src-vul/openthread/src/core/thread/network_data.cpp","function":"NetworkData::GetNextOnMeshPrefix","line":137,"var":"aConfig","code":"memset(aConfig, 0, sizeof(*aConfig));","note":"The iterator copies one parsed on-mesh prefix into the caller-provided border-router config structure."},{"step":2,"file":"src-vul/openthread/src/core/thread/network_data.cpp","function":"NetworkData::GetNextOnMeshPrefix","line":138,"var":"aConfig->mPrefix.mPrefix","code":"memcpy(&aConfig->mPrefix.mPrefix, prefix->GetPrefix(), BitVectorBytes(prefix->GetPrefixLength()));","note":"The prefix bytes from network data are copied into the config and later reused by address-management code."},{"step":3,"file":"src-vul/openthread/src/core/thread/network_data.cpp","function":"NetworkData::GetNextOnMeshPrefix","line":142,"var":"aConfig->mSlaac","code":"aConfig->mSlaac = borderRouterEntry->IsSlaac();","note":"The parsed flags determine whether SLAAC consumers will treat this prefix as eligible for address creation."},{"step":4,"file":"src-vul/openthread/src/core/thread/mle.cpp","function":"Mle::HandleStateChanged","line":1509,"var":"GetNetif().UpdateSlaac()","code":"GetNetif().UpdateSlaac();","note":"A Thread network-data change triggers SLAAC recomputation using the attacker-influenced network data."},{"step":5,"file":"src-vul/openthread/src/core/thread/thread_netif.cpp","function":"ThreadNetif::UpdateSlaac","line":234,"var":"mSlaacAddresses","code":"Utils::Slaac::UpdateAddresses(&GetInstance(), mSlaacAddresses, OT_ARRAY_LENGTH(mSlaacAddresses), ...);","note":"The interface passes its address table to the SLAAC helper, which iterates over all advertised prefixes."},{"step":6,"file":"src-vul/openthread/src/core/utils/slaac_address.cpp","function":"Slaac::UpdateAddresses","line":104,"var":"config.mSlaac","code":"if (config.mSlaac == false) { continue; }","note":"Only prefixes marked SLAAC are considered for address creation, so the copied flag controls the sink path."},{"step":7,"file":"src-vul/openthread/src/core/utils/slaac_address.cpp","function":"Slaac::UpdateAddresses","line":132,"var":"address","code":"memset(address, 0, sizeof(*address)); memcpy(&address->mAddress, &config.mPrefix.mPrefix, 8);","note":"A new unicast address is materialized from the copied prefix bytes; malformed network data can drive this write into the fixed address slot."}]
