[{"step":1,"file":"src/p_mach.cpp","function":"PackMachBase<T>::canUnpack","line":1630,"var":"rawmseg / ptr","code":"fi->readx(rawmseg, mhdri.sizeofcmds); then iterate Mach-O load commands with ptr advancing by ptr->cmdsize","note":"Attacker-controlled Mach-O load-command bytes are copied into rawmseg and then parsed sequentially."},{"step":2,"file":"src/p_mach.cpp","function":"PackMachBase<T>::canUnpack","line":1679,"var":"ptr->cmd / ptr->cmdsize","code":"unsigned const cmd = ptr->cmd; unsigned const cmdsize = ptr->cmdsize;","note":"The parser dereferences the current command header before proving the command buffer still contains a full Mach_command header."},{"step":3,"file":"src/p_mach.cpp","function":"is_bad_linker_command","line":190,"var":"cmdsize","code":"return !cmd || ... || headway < cmdsize || ...","note":"Validation checks cmdsize against the remaining header bytes, but this happens after the header fields have already been read."},{"step":4,"file":"src/bele.h","function":"get_ne32","line":124,"var":"p","code":"upx_memcpy_inline(&v, p, sizeof(v));","note":"The 32-bit load helper performs a 4-byte read from the supplied pointer, so a too-short final command can read past the allocated buffer."}]
