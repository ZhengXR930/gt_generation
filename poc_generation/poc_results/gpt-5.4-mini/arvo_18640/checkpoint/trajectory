 &lang_length, 0);\n        sc_format_asn1_entry(asn1_toki_attrs + 13, asn1_profile_indication, NULL, 0);\n        sc_format_asn1_entry(asn1_tokeninfo, asn1_toki_attrs, NULL, 0);\n\n        r = sc_asn1_decode(ctx, asn1_tokeninfo, buf, blen, NULL, NULL);\n        LOG_TEST_RET(ctx, r, \"ASN.1 parsing of EF(TokenInfo) failed\");\n\n        if (asn1_toki_attrs[1].flags & SC_ASN1_PRESENT && serial_len > 0)   {\n                ti->serial_number = malloc(serial_len * 2 + 1);\n                if (ti->serial_number == NULL)\n                        return SC_ERROR_OUT_OF_MEMORY;\n                sc_bin_to_hex(serial, serial_len, ti->serial_number, serial_len * 2 + 1, 0);\n                sc_log(ctx, \"TokenInfo.serialNunmber '%s'\", ti->serial_number);\n        }\n\n---PARSE TOKENINFO---\n   126  int sc_pkcs15_parse_tokeninfo(sc_context_t *ctx,\n   127          sc_pkcs15_tokeninfo_t *ti, const u8 *buf, size_t blen)\n   128  {\n   129          int r;\n   130          size_t ii;\n   131          u8 serial[128];\n   132          size_t serial_len = sizeof(serial);\n   133          u8 mnfid[SC_PKCS15_MAX_LABEL_SIZE];\n   134          size_t mnfid_len  = sizeof(mnfid) - 1;\n   135          u8 label[SC_PKCS15_MAX_LABEL_SIZE];\n   136          size_t label_len = sizeof(label) - 1;\n   137          u8 last_update[32], profile_indication[SC_PKCS15_MAX_LABEL_SIZE];\n   138          size_t lupdate_len = sizeof(last_update) - 1, pi_len = sizeof(profile_indication) - 1;\n   139          size_t flags_len   = sizeof(ti->flags);\n   140          u8 preferred_language[3];\n   141          size_t lang_length = sizeof(preferred_language);\n   142          struct sc_asn1_entry asn1_supported_algorithms[SC_MAX_SUPPORTED_ALGORITHMS + 1],\n   143                          asn1_algo_infos[SC_MAX_SUPPORTED_ALGORITHMS][7],\n   144                          asn1_algo_infos_parameters[SC_MAX_SUPPORTED_ALGORITHMS][3];\n   145          size_t reference_len = sizeof(ti->supported_algos[0].reference);\n   146          size_t mechanism_len = sizeof(ti->supported_algos[0].mechanism);\n   147          size_t parameter_len = sizeof(ti->supported_algos[0].parameters);\n   148          size_t operations_len = sizeof(ti->supported_algos[0].operations);\n   149          size_t algo_ref_len = sizeof(ti->supported_algos[0].algo_ref);\n   150\n   151          struct sc_asn1_entry asn1_last_update[C_ASN1_LAST_UPDATE_SIZE];\n   152          struct sc_asn1_entry asn1_profile_indication[C_ASN1_PROFILE_INDICATION_SIZE];\n   153          struct sc_asn1_entry asn1_toki_attrs[C_ASN1_TOKI_ATTRS_SIZE], asn1_tokeninfo[3], asn1_twlabel[3];\n   154\n   155          memset(last_update, 0, sizeof(last_update));\n   156          memset(label, 0, sizeof(label));\n   157          memset(profile_indication, 0, sizeof(profile_indication));\n   158          memset(mnfid, 0, sizeof(mnfid));\n   159\n   160          sc_copy_asn1_entry(c_asn1_twlabel, asn1_twlabel);\n   161          sc_copy_asn1_entry(c_asn1_toki_attrs, asn1_toki_attrs);\n   162          sc_copy_asn1_entry(c_asn1_tokeninfo, asn1_tokeninfo);\n   163          sc_copy_asn1_entry(c_asn1_last_update, asn1_last_update);\n   164          sc_format_asn1_entry(asn1_twlabel, label, &label_len, 0);\n   165          sc_copy_asn1_entry(c_asn1_profile_indication, asn1_profile_indication);\n   166\n   167          for (ii=0; ii<SC_MAX_SUPPORTED_ALGORITHMS; ii++) {\n   168                  sc_copy_asn1_entry(c_asn1_algorithm_info, asn1_algo_infos[ii]);\n   169                  sc_copy_asn1_entry(c_asn1_algorithm_info_parameters,\n   170                          asn1_algo_infos_parameters[ii]);\n   171          }\n   172          sc_copy_asn1_entry(c_asn1_supported_algorithms, asn1_supported_algorithms);\n   173\n   174          for (ii=0; ii<SC_MAX_SUPPORTED_ALGORITHMS; ii++)   {\n   175                  sc_format_asn1_entry(asn1_algo_infos[ii] + 0, &ti->supported_algos[ii].reference, &reference_len, 0);\n   176                  sc_format_asn1_entry(asn1_algo_infos[ii] + 1, &ti->supported_algos[ii].mechanism, &mechanism_len, 0);\n   177                  sc_format_asn1_entry(asn1_algo_infos[ii] + 2,\n   178                          asn1_algo_infos_parameters[ii], NULL, 0);\n   179                  sc_format_asn1_entry(asn1_algo_infos_parameters[ii] + 0,\n   180                          NULL, NULL, 0);\n   181                  sc_format_asn1_entry(asn1_algo_infos_parameters[ii] + 1,\n   182                          &ti->supported_algos[ii].parameters, &parameter_len, 0);\n   183                  sc_format_asn1_entry(asn1_algo_infos[ii] + 3, &ti->supported_algos[ii].operations, &operations_len, 0);\n   184                  sc_format_asn1_entry(asn1_algo_infos[ii] + 4, &ti->supported_algos[ii].algo_id, NULL, 1);\n   185                  sc_format_asn1_entry(asn1_algo_infos[ii] + 5, &ti->supported_algos[ii].algo_ref, &algo_ref_len, 0);\n   186                  sc_format_asn1_entry(asn1_supported_algorithms + ii, asn1_algo_infos[ii], NULL, 0);\n   187          }\n   188\n   189          sc_format_asn1_entry(asn1_last_update + 0, last_update, &lupdate_len, 0);\n   190          sc_format_asn1_entry(asn1_last_update + 1, &ti->last_update.path, NULL, 0);\n   191\n   192          sc_format_asn1_entry(asn1_profile_indication + 0, &ti->profile_indication.oid, NULL, 0);\n   193          sc_format_asn1_entry(asn1_profile_indication + 1, profile_indication, &pi_len, 0);\n   194\n   195          sc_format_asn1_entry(asn1_toki_attrs + 0, &ti->version, NULL, 0);\n   196          sc_format_asn1_entry(asn1_toki_attrs + 1, serial, &serial_len, 0);\n   197          sc_format_asn1_entry(asn1_toki_attrs + 2, mnfid, &mnfid_len, 0);\n   198          sc_format_asn1_entry(asn1_toki_attrs + 3, label, &label_len, 0);\n   199          sc_format_asn1_entry(asn1_toki_attrs + 4, asn1_twlabel, NULL, 0);\n   200          sc_format_asn1_entry(asn1_toki_attrs + 5, &ti->flags, &flags_len, 0);\n   201          sc_format_asn1_entry(asn1_toki_attrs + 6, &ti->seInfo, &ti->num_seInfo, 0);\n   202          sc_format_asn1_entry(asn1_toki_attrs + 7, NULL, NULL, 0);\n   203          sc_format_asn1_entry(asn1_toki_attrs + 8, asn1_supported_algorithms, NULL, 0);\n   204          sc_format_asn1_entry(asn1_toki_attrs + 9, NULL, NULL, 0);\n   205          sc_format_asn1_entry(asn1_toki_attrs + 10, NULL, NULL, 0);\n   206          sc_format_asn1_entry(asn1_toki_attrs + 11, asn1_last_update, NULL, 0);\n   207          sc_format_asn1_entry(asn1_toki_attrs + 12, preferred_language, &lang_length, 0);\n   208          sc_format_asn1_entry(asn1_toki_attrs + 13, asn1_profile_indication, NULL, 0);\n   209          sc_format_asn1_entry(asn1_tokeninfo, asn1_toki_attrs, NULL, 0);\n   210\n   211          r = sc_asn1_decode(ctx, asn1_tokeninfo, buf, blen, NULL, NULL);\n   212          LOG_TEST_RET(ctx, r, \"ASN.1 parsing of EF(TokenInfo) failed\");\n   213\n   214          if (asn1_toki_attrs[1].flags & SC_ASN1_PRESENT && serial_len > 0)   {\n   215                  ti->serial_number = malloc(serial_len * 2 + 1);\n   216                  if (ti->serial_number == NULL)\n   217                          return SC_ERROR_OUT_OF_MEMORY;\n   218                  sc_bin_to_hex(serial, serial_len, ti->serial_number, serial_len * 2 + 1, 0);\n   219                  sc_log(ctx, \"TokenInfo.serialNunmber '%s'\", ti->serial_number);\n   220          }\n   221\n   222          if (ti->manufacturer_id == NULL) {\n   223                  if (asn1_toki_attrs[2].flags & SC_ASN1_PRESENT)\n   224                          ti->manufacturer_id = strdup((char *) mnfid);\n   225                  else\n   226                          ti->manufacturer_id = strdup(\"(unknown)\");\n   227                  if (ti->manufacturer_id == NULL)\n   228                          return SC_ERROR_OUT_OF_MEMORY;\n   229          }\n   230          if (ti->label == NULL) {\n   231                  if (asn1_toki_attrs[3].flags & SC_ASN1_PRESENT ||\n   232                      asn1