[{"step":1,"file":"repo-vul/src-vul/freetype2/src/tools/ftfuzzer/ftfuzzer.cc","function":"LLVMFuzzerTestOneInput","line":118,"var":"data","code":"parse_data(data, size_)","note":"Attacker-controlled raw input is accepted by the fuzz target and parsed as either a tar archive or a single font blob."},{"step":2,"file":"repo-vul/src-vul/freetype2/src/tools/ftfuzzer/ftfuzzer.cc","function":"parse_data","line":96,"var":"files[0]","code":"files.emplace_back( data, data + size )","note":"When the input is not a valid tar archive, the entire byte stream becomes the font file bytes passed to FreeType."},{"step":3,"file":"repo-vul/src-vul/freetype2/src/tools/ftfuzzer/ftfuzzer.cc","function":"LLVMFuzzerTestOneInput","line":132,"var":"files[0].data()","code":"FT_New_Memory_Face( library, files[0].data(), (FT_Long)files[0].size(), -1, &face )","note":"FreeType opens the attacker-controlled bytes as a face and reads the face count from the font header."},{"step":4,"file":"repo-vul/src-vul/freetype2/src/tools/ftfuzzer/ftfuzzer.cc","function":"LLVMFuzzerTestOneInput","line":145,"var":"face_index","code":"FT_New_Memory_Face( library, files[0].data(), (FT_Long)files[0].size(), -( face_index + 1 ), &face )","note":"The target reopens the same bytes for each face and prepares to parse the selected face's dictionaries and glyph data."},{"step":5,"file":"repo-vul/src-vul/freetype2/src/tools/ftfuzzer/ftfuzzer.cc","function":"LLVMFuzzerTestOneInput","line":176,"var":"flags","code":"FT_Load_Glyph( face, glyph_index, flags )","note":"Glyph loading drives the vulnerable CFF parsing path for the selected face and instance."},{"step":6,"file":"repo-vul/src-vul/freetype2/src/cff/cffload.c","function":"cff_load_private_dict","line":1872,"var":"parser","code":"cff_parser_run( &parser, (FT_Byte*)stream->cursor, (FT_Byte*)stream->limit )","note":"The private DICT bytes from the font are parsed with the CFF parser, which recognizes reserved opcode 255 as an internal CFF2 blend marker."},{"step":7,"file":"repo-vul/src-vul/freetype2/src/cff/cffparse.c","function":"cff_parse_blend","line":913,"var":"numBlends","code":"error = cff_blend_doBlend( subFont, parser, numBlends )","note":"A blend operator in the private DICT triggers construction of a blend result and rewrites parser stack entries to point at a 5-byte internal encoding."},{"step":8,"file":"repo-vul/src-vul/freetype2/src/cff/cffload.c","function":"cff_blend_doBlend","line":1346,"var":"subFont->blend_top","code":"*subFont->blend_top++ = 255; *((FT_UInt32*)subFont->blend_top) = (FT_UInt32)sum;","note":"The blended value is stored as byte 255 followed by four host-order bytes, creating an internal pseudo-number that later consumers decode via cff_parse_num."},{"step":9,"file":"repo-vul/src-vul/freetype2/src/cff/cffparse.c","function":"cff_parse_num","line":446,"var":"**d","code":"else if ( **d == 255 ) { return (FT_Long)( *( (FT_UInt32 *) ( d[0] + 1 ) ) + 0x8000U ) >> 16; }","note":"When a later parser reads the internal 255 marker, it performs an unaligned 32-bit load from the following four bytes without a bounds check, which is the memory-safety sink for the heap-buffer-overflow read."}]
