# PoC: mixed default/non-default listener configuration
# 1) 'port' creates the implicit "default listener" (config->default_listener -> listeners[0])
port 1883
# 2) an explicit listener line grows config->listeners; realloc moves the array
#    and config->default_listener is left dangling (use-after-free)
listener 1884
# 3) using 'port'/'bind_address' again dereferences the stale default_listener
port 1885
bind_address 127.0.0.1
