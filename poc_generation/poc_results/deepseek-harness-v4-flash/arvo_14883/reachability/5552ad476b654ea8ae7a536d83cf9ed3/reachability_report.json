  "checkpoints": [
    {
      "file": "library/ssl_tls.c",
      "function": "ssl_parse_certificate_chain",
      "line": 6179,
      "code": "",
      "note": "After TLS record parsing has produced a Certificate message, the project-side X.509 parser is entered here via `mbedtls_x509_crt_parse_der(chain, ssl->in_msg + i, n)`.",
      "oracle_kind": "gt_parser_checkpoint",
      "kind": "parser_admitted"
    },
    {
      "file": "library/x509_crt.c",
      "function": "x509_get_subject_alt_name",
      "line": 703,
      "code": "buf->tag = tag; buf->p = *p; buf->len = tag_len; *p += buf->len;",
      "note": "The first attacker-controlled GeneralName inside the SubjectAltName extension is materialized into the head `subject_alt_name` node. That makes `cur->buf.p` non-NULL, which is the state the next loop iteration uses to allocate `subject_alt_name->next` and later store the malformed tail entry.",
      "kind": "source"
    },
    {
      "file": "library/x509_crt.c",
      "function": "x509_get_subject_alt_name",
      "line": null,
      "code": "",
      "note": "After the malformed-entry cleanup frees every node reachable from `subject_alt_name->next`, the function returns the fatal SAN-parse error immediately without clearing `subject_alt_name->next`. The head sequence therefore keeps a dangling pointer while the same `ret` drives caller cleanup into `mbedtls_x509_crt_free`. The patch fixes this by inserting `subject_alt_name->next = NULL;` before the return.",
      "kind": "root_cause_function"
    },
    {
      "file": "library/x509_crt.c",
      "function": "x509_get_subject_alt_name",
      "line": 684,
      "code": "",
      "note": "After the malformed-entry cleanup frees every node reachable from `subject_alt_name->next`, the function returns the fatal SAN-parse error immediately without clearing `subject_alt_name->next`. The head sequence therefore keeps a dangling pointer while the same `ret` drives caller cleanup into `mbedtls_x509_crt_free`. The patch fixes this by inserting `subject_alt_name->next = NULL;` before the return.",
      "kind": "root_cause_line"
    },
    {
      "file": "library/x509_crt.c",
      "function": "mbedtls_x509_crt_free",
      "line": null,
      "code": "",
      "note": "Certificate cleanup dereferences `seq_cur->next` on the already freed `subject_alt_names.next` node. AddressSanitizer reports this read as the crashing heap-use-after-free READ 8 in `mbedtls_x509_crt_free`.",
      "kind": "sink_function"
    },
    {
      "file": "library/x509_crt.c",
      "function": "mbedtls_x509_crt_free",
      "line": 3280,
      "code": "",
      "note": "Certificate cleanup dereferences `seq_cur->next` on the already freed `subject_alt_names.next` node. AddressSanitizer reports this read as the crashing heap-use-after-free READ 8 in `mbedtls_x509_crt_free`.",
      "kind": "sink_line"
    }
  ],
