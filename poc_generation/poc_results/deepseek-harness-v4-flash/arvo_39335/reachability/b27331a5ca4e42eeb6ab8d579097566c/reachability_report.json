    {
      "file": "src/TopicTree.h",
      "function": "publish",
      "line": 306,
      "code": "s->messageIndices[s->numMessageIndices++] = (uint16_t)outgoingMessages.size();",
      "note": "The subscriber's message index is materialized from the current outgoingMessages vector size during publish(). This index is valid at creation but becomes a stale out-of-bounds value after the linked-list corruption causes the subscriber to be orphaned and a subsequent drain clears the vector.",
      "kind": "source"
    },
    {
      "file": "src/TopicTree.h",
      "function": "drain",
      "line": null,
      "code": "",
      "note": "When the subscriber being individually drained is the head of drainableSubscribers, the code sets drainableSubscribers to nullptr instead of s->next. This orphans all subsequent subscribers in the doubly-linked list: they retain numMessageIndices > 0 and stale messageIndices but are unreachable from the list head. The same bug exists in freeSubscriber at line 233. The patch introduces unlinkDrainableSubscriber() that correctly sets drainableSubscribers to s->next.",
      "kind": "root_cause_function"
    },
    {
      "file": "src/TopicTree.h",
      "function": "drain",
      "line": 254,
      "code": "",
      "note": "When the subscriber being individually drained is the head of drainableSubscribers, the code sets drainableSubscribers to nullptr instead of s->next. This orphans all subsequent subscribers in the doubly-linked list: they retain numMessageIndices > 0 and stale messageIndices but are unreachable from the list head. The same bug exists in freeSubscriber at line 233. The patch introduces unlinkDrainableSubscriber() that correctly sets drainableSubscribers to s->next.",
      "kind": "root_cause_line"
    },
    {
      "file": "src/TopicTree.h",
      "function": "drainImpl",
      "line": null,
      "code": "",
      "note": "drainImpl reads outgoingMessages at the orphaned subscriber's stale message index. The index exceeds the vector's current size (0 after clear) but falls within its allocated capacity. ASan detects the 1-byte read of a std::string in the container-overflow zone when the drain callback calls message.length().",
      "kind": "sink_function"
    },
