      "code": "if (!serializer->decode (buffer, offset, attr->pValue, &attr->ulValueLen))",
      "note": "The attribute-array serializer decodes the value; for nested attribute arrays it reports the size as count * sizeof(CK_ATTRIBUTE), which is not the actual storage needed for the nested attribute values.",
      "role": "intermediate"
    },
    {
      "step": 4,
      "file": "p11-kit/rpc-message.c",
      "function": "p11_rpc_buffer_get_attribute_array_value",
      "line": 1137,
      "var": "value_length",
      "code": "*value_length = count * sizeof (CK_ATTRIBUTE);",
      "note": "Root cause: the decoded length of a CKF_ARRAY_ATTRIBUTE value is set to the attribute count times sizeof(CK_ATTRIBUTE). The internal API therefore cannot determine the actual byte size of data that must be stored, so the server sizes the destination only from the wire length field and re-decodes the nested array into a buffer whose nested CK_ATTRIBUTE slots have uninitialized pValue pointers.",
      "role": "root_cause"
    },
    {
      "step": 5,
      "file": "p11-kit/rpc-server.c",
      "function": "proto_read_attribute_array",
      "line": 324,
      "var": "attrs[i].pValue",
      "code": "attrs[i].pValue = p11_rpc_message_alloc_extra (msg, temp.ulValueLen);",
      "note": "The server allocates temp.ulValueLen (the wire length) bytes via p11_rpc_message_alloc_extra, which 0xff-fills the memory, then re-decodes the attribute into that buffer. The nested attribute slots of the destination therefore contain garbage (0xff...) pValue pointers.",
      "role": "intermediate"
    },
    {
      "step": 6,
      "file": "p11-kit/rpc-message.c",
      "function": "p11_rpc_buffer_get_attribute_array_value",
      "line": 1130,
      "var": "attr",
      "code": "if (!p11_rpc_buffer_get_attribute (buffer, offset, attr))",
      "note": "Second-pass decode writes each nested CK_ATTRIBUTE into the freshly allocated, uninitialized destination array; for the nested CKA_LABEL attribute the decoder will use the slot's garbage pValue as the destination of the value bytes.",
      "role": "intermediate"
    },
    {
      "step": 7,
      "file": "p11-kit/rpc-message.c",
      "function": "p11_rpc_buffer_get_byte_array_value",
      "line": 1216,
      "var": "value",
      "code": "if (val && value) memcpy (value, val, len);",
      "note": "Sink: the nested attribute's value bytes are copied through the uninitialized pValue pointer (0xffffffffffffffff from the 0xff-filled allocation), causing a wild write and a crash in the rpc-server while parsing the nested attribute array.",
      "role": "sink"
    }
