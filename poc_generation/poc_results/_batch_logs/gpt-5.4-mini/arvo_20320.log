/**
 * replicate a var dump of an array but outputted string values are base64 encoded
 *
 * @param array $regs
 */
function base64_encode_var_dump($regs) {
        if ($regs) {
                echo "array(" . count($regs) . ") {\n";
                foreach ($regs as $key => $value) {
                        echo "  [$key]=>\n  ";
                        if (is_string($value)) {
                                var_dump(base64_encode($value));
                        } else {
                                var_dump($value);
                        }
                }
                echo "}\n";
        } else {
                echo "NULL\n";
        }
}

