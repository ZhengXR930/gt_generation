void Commissioner::HandleMgmtCommissisonerGetResponse(Coap::Header *aHeader, Message *aMessage,
                                                      const Ip6::MessageInfo *aMessageInfo, otError aResult)
{
    (void) aMessage;
    (void) aMessageInfo;

    otLogFuncEntry();

