cd libpcap-1.9.1
./configure --disable-shared
make -j$(nproc)
make install
cd ..
cd ndpi
sh autogen.sh
./configure --enable-fuzztargets
make
ls fuzz/fuzz* | grep -v "\." | while read i; do cp $i $OUT/; done

