      ThrowRDE("Invalid tile size: (%u, %u)", tilew, tileh);

    assert(tilew > 0);
    uint32 tilesX = (mRaw->dim.x + tilew - 1) / tilew;
    assert(tilesX > 0);

    assert(tileh > 0);
    uint32 tilesY = (mRaw->dim.y + tileh - 1) / tileh;
    assert(tilesY > 0);

    uint32 nTiles = tilesX * tilesY;
