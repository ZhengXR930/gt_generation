static inline ssize_t safe_strlcat(char *src, const char *append, size_t len)
{
        size_t new_len;

        new_len = strlcat(src, append, len);
        if (new_len >= len)
                return ret_errno(EINVAL);

        return (ssize_t)new_len;
}

