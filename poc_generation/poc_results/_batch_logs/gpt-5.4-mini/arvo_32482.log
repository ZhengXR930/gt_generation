#define strprint(str, inlen, ...)                                                     \
        do {                                                                          \
                if (str)                                                              \
                        len = snprintf(str, inlen, ##__VA_ARGS__);                    \
                else                                                                  \
                        len = snprintf((char *){""}, 0, ##__VA_ARGS__);               \
                if (len < 0)                                                          \
                        return log_error_errno(-EIO, EIO, "failed to create string"); \
                fulllen += len;                                                       \
                if (inlen > 0) {                                                      \
                        if (str)                                                      \
                                str += len;                                           \
                        inlen -= len;                                                 \
                        if (inlen < 0)                                                \
                                inlen = 0;                                            \
                }                                                                     \
        } while (0);

