        _sc_card_add_rsa_alg(card, 2048, flags, 0); /* optional */
        _sc_card_add_rsa_alg(card, 3072, flags, 0); /* optional */

        flags = SC_ALGORITHM_ECDSA_RAW | SC_ALGORITHM_ECDH_CDH_RAW | SC_ALGORITHM_ECDSA_HASH_NONE;
