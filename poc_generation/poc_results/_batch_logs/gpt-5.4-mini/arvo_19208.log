int sc_disconnect_card(sc_card_t *card)
{
        sc_context_t *ctx;

        if (!card)
                return SC_ERROR_INVALID_ARGUMENTS;

        ctx = card->ctx;
        LOG_FUNC_CALLED(ctx);

        if (card->lock_count != 0)
