664:void
665:NCPInstanceBase::remove_address_on_ncp_and_update_prefixes(const in6_addr &address, const UnicastAddressEntry &entry)
666:{
667:    remove_unicast_address_on_ncp(address, entry.get_prefix_len(),
668:            boost::bind(&NCPInstanceBase::check_ncp_entry_update_status, this, _1, "removing unicast address", NilReturn()));
669:
670:    if (!entry.is_from_ncp()
671:       && !IN6_IS_ADDR_LINKLOCAL(&address)
672:       && (!buffer_is_nonzero(mNCPV6Prefix, sizeof(mNCPV6Prefix)) || (0 != memcmp(mNCPV6Prefix, &address, sizeof(mNCPV6Prefix))))
673:    ) {
674:            struct in6_addr prefix = address;
675:            uint8_t flags = OnMeshPrefixEntry::kFlagOnMesh | OnMeshPrefixEntry::kFlagPreferred;
676:
677:            if (mSetDefaultRouteForAutoAddedPrefix) {
678:                    flags |= OnMeshPrefixEntry::kFlagDefaultRoute;
679:            }
680:
681:            if (mSetSLAACForAutoAddedPrefix) {
682:                    flags |= OnMeshPrefixEntry::kFlagSLAAC;
683:            }
684:
685:            in6_addr_apply_mask(prefix, entry.get_prefix_len());
686:            on_mesh_prefix_was_removed(entry.get_origin(), address, entry.get_prefix_len(), flags);
687:    }
688:}
