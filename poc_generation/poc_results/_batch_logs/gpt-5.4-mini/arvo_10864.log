504:NCPInstanceBase::restore_address_prefix_route_entries_on_ncp(void)
505:{
506:    syslog(LOG_INFO, "Restoring interface/user originated address/prefix/route entries on NCP");
507:
508:    // Unicast addresses
509:    for (
510:            std::map<struct in6_addr, UnicastAddressEntry>::iterator iter = mUnicastAddresses.begin();
511:            iter != mUnicastAddresses.end();
512:            ++iter
513:    ) {
514:            if (iter->second.is_from_interface() || iter->second.is_from_user()) {
515:                    add_address_on_ncp_and_update_prefixes(iter->first, iter->second);
516:            }
517:    }
518:
519:    // Multicast addresses
520:    for (
521:            std::map<struct in6_addr, MulticastAddressEntry>::iterator iter = mMulticastAddresses.begin();
522:            iter != mMulticastAddresses.end();
523:            ++iter
524:    ) {
525:            if (iter->second.is_from_interface() || iter->second.is_from_user()) {
526:                    add_multicast_address_on_ncp(iter->first,
527:                            boost::bind(&NCPInstanceBase::check_ncp_entry_update_status, this, _1, "restoring multicast address", NilReturn()));
528:            }
529:    }
530:
531:    // On-mesh prefixes
532:    for (
533:            std::multimap<IPv6Prefix, OnMeshPrefixEntry>::iterator iter = mOnMeshPrefixes.begin();
534:            iter != mOnMeshPrefixes.end();
535:            ++iter
536:    ) {
537:            if (iter->second.is_from_interface() || iter->second.is_from_user()) {
538:                    add_on_mesh_prefix_on_ncp(iter->first.get_prefix(), iter->first.get_length(),
539:                            iter->second.get_flags(), iter->second.is_stable(),
540:                            boost::bind(&NCPInstanceBase::check_ncp_entry_update_status, this, _1, "restoring on-mesh prefix", NilReturn()));
541:            }
542:    }
543:
544:    // Off-mesh-routes
545:    for (
546:            std::multimap<IPv6Prefix, OffMeshRouteEntry>::iterator iter = mOffMeshRoutes.begin();
547:            iter != mOffMeshRoutes.end();
548:            ++iter
549:    ) {
550:            if (iter->second.is_from_interface() || iter->second.is_from_user()) {
551:                    add_route_on_ncp(iter->first.get_prefix(), iter->first.get_length(), iter->second.get_preference(), iter->second.is_stable(),
552:                            boost::bind(&NCPInstanceBase::check_ncp_entry_update_status, this, _1, "restoring off-mesh route", NilReturn()));
553:            }
