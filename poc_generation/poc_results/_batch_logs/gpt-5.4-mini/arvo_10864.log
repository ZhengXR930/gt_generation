633:void
634:NCPInstanceBase::add_address_on_ncp_and_update_prefixes(const in6_addr &address, const UnicastAddressEntry &entry)
635:{
636:    add_unicast_address_on_ncp(address, entry.get_prefix_len(),
637:            boost::bind(&NCPInstanceBase::check_ncp_entry_update_status, this, _1, "adding unicast address", NilReturn()));
638:
639:    // Update the prefix if entry is not from NCP and
640:    // if address is not link-local and prefix does not
641:    // match mesh-local prefix.
642:
643:    if (!entry.is_from_ncp()
644:       && !IN6_IS_ADDR_LINKLOCAL(&address)
645:       && (!buffer_is_nonzero(mNCPV6Prefix, sizeof(mNCPV6Prefix)) || (0 != memcmp(mNCPV6Prefix, &address, sizeof(mNCPV6Prefix))))
646:    ) {
647:            struct in6_addr prefix = address;
648:            uint8_t flags = OnMeshPrefixEntry::kFlagOnMesh
649:                          | OnMeshPrefixEntry::kFlagPreferred;
650:
651:            if (mSetDefaultRouteForAutoAddedPrefix) {
652:                    flags |= OnMeshPrefixEntry::kFlagDefaultRoute;
653:            }
654:
655:            if (mSetSLAACForAutoAddedPrefix) {
656:                    flags |= OnMeshPrefixEntry::kFlagSLAAC;
657:            }
658:
659:            in6_addr_apply_mask(prefix, entry.get_prefix_len());
660:            on_mesh_prefix_was_added(entry.get_origin(), address, entry.get_prefix_len(), flags);
661:    }
662:}
