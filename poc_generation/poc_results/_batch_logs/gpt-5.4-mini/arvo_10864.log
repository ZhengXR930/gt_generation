574:void
575:NCPInstanceBase::unicast_address_was_added(Origin origin, const struct in6_addr &address, uint8_t prefix_len,
576:    uint32_t valid_lifetime, uint32_t preferred_lifetime)
577:{
578:    if (((origin == kOriginPrimaryInterface) || (origin == kOriginUser))
579:        && mFilterUserAddedLinkLocalIPv6Address
580:        && IN6_IS_ADDR_LINKLOCAL(&address)) {
581:
582:            syslog(LOG_INFO, "UnicastAddresses: Skipping user/interface added link-local IPv6 address %s",
583:                   in6_addr_to_string(address).c_str());
584:
585:            goto bail;
586:    }
587:
588:    if (!mUnicastAddresses.count(address)) {
589:            UnicastAddressEntry entry(origin, prefix_len, valid_lifetime, preferred_lifetime);
590:
591:            mUnicastAddresses[address] = entry;
592:            syslog(LOG_INFO, "UnicastAddresses: Adding %s", entry.get_description(address).c_str());
593:
594:            // Add the address on NCP or primary interface (depending on origin).
595:
596:            if ((origin == kOriginThreadNCP) || (origin == kOriginUser)) {
597:                    mPrimaryInterface->add_address(&address, prefix_len);
598:            }
599:
600:            if (((origin == kOriginPrimaryInterface) && mAutoUpdateInterfaceIPv6AddrsOnNCP) || (origin == kOriginUser)) {
601:                    add_address_on_ncp_and_update_prefixes(address, entry);
602:            }
603:    }
604:
605:bail:
606:    return;
607:}
608:
609:void
610:NCPInstanceBase::unicast_address_was_removed(Origin origin, const struct in6_addr &address)
611:{
612:    if (mUnicastAddresses.count(address)) {
613:            UnicastAddressEntry entry = mUnicastAddresses[address];
614:
615:            // Allow address remove if origin is user, or if it matches the
616:            // originator of the entry (when it was previously added).
617:
618:            if ((origin == kOriginUser) || (origin == entry.get_origin())) {
619:                    syslog(LOG_INFO, "UnicastAddresses: Removing %s", entry.get_description(address).c_str());
620:                    mUnicastAddresses.erase(address);
621:
622:                    if ((origin == kOriginThreadNCP) || (origin == kOriginUser)) {
623:                            mPrimaryInterface->remove_address(&address, entry.get_prefix_len());
624:                    }
625:
626:                    if ((origin == kOriginPrimaryInterface) || (origin == kOriginUser)) {
627:                            remove_address_on_ncp_and_update_prefixes(address, entry);
628:                    }
629:            }
630:    }
631:}
