        int             (*get_fn)(sc_card_t *, unsigned int, u8 *, size_t);
        /* function to write the DO to the card:
         * only != NULL if DO is writeable under some conditions */
        int             (*put_fn)(sc_card_t *, unsigned int, const u8 *, size_t);
};

