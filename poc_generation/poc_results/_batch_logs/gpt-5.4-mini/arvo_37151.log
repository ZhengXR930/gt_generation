                /*! Current parser position. */
                const char *current;
                /*! End of the block. */
                const char *end;
                /*! Indication for the final block parsing. */
                bool eof;
                /*! Indication of being mmap()-ed (malloc()-ed otherwise). */
                bool mmaped;
        } input;

        /*! File input parameters. */
        struct {
                /*! Zone file name. */
                char *name;

