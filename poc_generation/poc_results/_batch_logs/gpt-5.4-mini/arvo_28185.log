   162          sc_asn1_put_tag(0x83, buf, 2, p, 16, &p);
   163
   164          /* Directory name */
   165          if (file->type == SC_FILE_TYPE_DF) {
   166                  if (file->namelen) {
   167                          sc_asn1_put_tag(0x84, file->name, file->namelen,
   168                                          p, 16, &p);
   169                  } else {
   170                          /* TCOS needs one, so we use a faked one */
   171                          snprintf ((char *) buf, sizeof(buf)-1, "foo-%lu",
   172                                    (unsigned long) time (NULL));
   173                          sc_asn1_put_tag(0x84, buf, strlen ((char *) buf), p, 16, &p);
   174                  }
   175          }
   176
   177          /* File descriptor extension */
   178          if (file->prop_attr_len && file->prop_attr) {
   179                  n = file->prop_attr_len;
   180                  memcpy(buf, file->prop_attr, n);
   181          } else {
   182                  n = 0;
   183                  buf[n++] = 0x01; /* not invalidated, permanent */
   184                  if (file->type == SC_FILE_TYPE_WORKING_EF)
   185                          buf[n++] = 0x00; /* generic data file */
   186          }
   187          sc_asn1_put_tag(0x85, buf, n, p, 16, &p);
   188
   189          /* Security attributes */
   190          if (file->sec_attr_len && file->sec_attr) {
   191                  memcpy(buf, file->sec_attr, file->sec_attr_len);
   192                  n = file->sec_attr_len;
   193          } else {
   194                  /* no attributes given - fall back to default one */
   195                  memcpy (buf+ 0, "\xa4\x00\x00\x00\xff\xff", 6); /* select */
   196                  memcpy (buf+ 6, "\xb0\x00\x00\x00\xff\xff", 6); /* read bin */
   197                  memcpy (buf+12, "\xd6\x00\x00\x00\xff\xff", 6); /* upd bin */
   198                  memcpy (buf+18, "\x60\x00\x00\x00\xff\xff", 6); /* admin grp*/
   199                  n = 24;
   200          }
   201          sc_asn1_put_tag(0x86, buf, n, p, sizeof (buf), &p);
   202
   203
   204          /* fixup length of FCI */
   205          out[1] = p - out - 2;
   206
   207          *outlen = p - out;
   208          return 0;
   209  }
