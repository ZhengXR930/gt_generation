        g_return_if_fail(key != NULL);
        g_return_if_fail(funccount >= 1);
        g_return_if_fail(funcs != NULL);
        g_return_if_fail(funcs[0] != NULL);

        rec = expando_find(key);
        g_return_if_fail(rec != NULL);

        if (rec->signals == 0) {
                /* it's unknown when this expando changes..
