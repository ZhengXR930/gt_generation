int
sctp_v6src_match_nexthop(struct sockaddr_in6 *src6, sctp_route_t *ro)
{
        struct nd_prefix *pfx = NULL;
        struct nd_pfxrouter *pfxrtr = NULL;
        struct sockaddr_in6 gw6;

        if (ro == NULL || ro->ro_rt == NULL || src6->sin6_family != AF_INET6)
