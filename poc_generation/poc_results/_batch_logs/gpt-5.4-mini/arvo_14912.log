void SStream_Init(SStream *ss)
{
        ss->index = 0;
        ss->buffer[0] = '\0';
}

void SStream_concat0(SStream *ss, const char *s)
{
#ifndef CAPSTONE_DIET
        unsigned int len = (unsigned int) strlen(s);

        memcpy(ss->buffer + ss->index, s, len);
        ss->index += len;
        ss->buffer[ss->index] = '\0';
