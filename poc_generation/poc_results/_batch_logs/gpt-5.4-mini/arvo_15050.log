            error = submit_value_label(parser, labelset_name, label_type,
                first_integer, integer, string_value, buf, user_ctx);
            if (error != READSTAT_OK)
                goto cleanup;
        }

        single_quoted_string = "'" ( [^']* ) >{ str_start = fpc; } %{ str_len = fpc - str_start; } "'";

