        buf->i += strlen( p );

        if( buf->i >= buf->mx - 4 ) {
                buf->full = TRUE;
                strcpy( buf->base + buf->mx - 4, "..." );
                buf->i = buf->mx - 1;
                return( FALSE );
        }

        return( TRUE );
}

