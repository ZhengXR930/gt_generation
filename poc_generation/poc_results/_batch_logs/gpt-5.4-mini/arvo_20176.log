#define _(String) dgettext (PACKAGE, String)
#include "progname.h"
#include "version-etc.h"

#include "idn2_cmd.h"

#include "blurbs.h"

#ifdef __cplusplus
extern // define a global const variable in C++, C doesn't need it.
