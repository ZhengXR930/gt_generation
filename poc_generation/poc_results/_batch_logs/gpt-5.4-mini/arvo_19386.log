otError SpinelDecoder::ReadEui48(spinel_eui48_t &aEui48)
{
    otError               error = OT_ERROR_NONE;
    const spinel_eui48_t *eui48Ptr;

    SuccessOrExit(error = ReadEui48(eui48Ptr));
