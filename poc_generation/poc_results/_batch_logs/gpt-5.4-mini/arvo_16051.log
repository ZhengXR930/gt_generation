{
    if(ctx == NULL || buf == NULL) return 1;
    if(!ctx->valid_state) return SPNG_EBADSTATE;
    if(ctx->encode_only) return SPNG_ENCODE_ONLY;

    if(ctx->data != NULL) return SPNG_EBUF_SET;

