        if (!eld->buf)
                return 0;

        /* Copy memory */
        len = MIN (len, eld->size - eld->bytes_read);
        memcpy (eld->buf + eld->bytes_read, buf, len);
        eld->bytes_read += len;

        return (eld->bytes_read >= eld->size) ? 0 : 1;
}

