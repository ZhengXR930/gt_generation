  size_t rbytes = fread(coffsets, 1, (size_t)off_cbytes, fp);
  if (rbytes != (size_t)off_cbytes) {
    fprintf(stderr, "Error: cannot read the offsets out of the fileframe.\n");
    fclose(fp);
    return NULL;
  }
  fclose(fp);
  frame->coffsets = coffsets;

  return coffsets;
}


