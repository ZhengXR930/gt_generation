        case MULTICHAR_CONSTANT_L('C','o','o','k'):
            helper->cookie = HEADER("Cookie");
            break;
        case MULTICHAR_CONSTANT_L('I','f','-','M'):
            helper->if_modified_since.raw = HEADER("If-Modified-Since");
            break;
        case MULTICHAR_CONSTANT_L('R','a','n','g'):
