    avifIOFileReader * reader = (avifIOFileReader *)io;
    if (!reader->f) {
        return AVIF_RESULT_IO_ERROR;
    }

    if (offset < reader->io.sizeHint) {
        uint64_t availableSize = reader->io.sizeHint - offset;
        if (size > availableSize) {
