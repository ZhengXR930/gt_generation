void
NvReadObject(
             NV_REF           ref,           // IN: points to NV where index is located
             OBJECT          *object         // OUT: place to receive the object data
             )
{
    NvRead(object, (ref + sizeof(TPM_HANDLE)), sizeof(OBJECT));
