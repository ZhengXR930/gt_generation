dist-hook:
        find . -name '*.options' -exec cp -v '{}' $(distdir) ';'
        find . -name '*.dict' -exec cp -v '{}' $(distdir) ';'
#       find . -name '*.in' -exec cp -vr '{}' $(distdir) ';'
        find . -name '*.repro' -exec cp -vr '{}' $(distdir) ';'

TESTS = $(FUZZERS)

