    35  namespace rawspeed {
    36
    37  PhaseOneDecompressor::PhaseOneDecompressor(const RawImage& img,
    38                                             std::vector<PhaseOneStrip>&& strips_)
    39      : AbstractParallelizedDecompressor(img), strips(std::move(strips_)) {
    40    if (mRaw->getDataType() != TYPE_USHORT16)
    41      ThrowRDE("Unexpected data type");
    42
    43    if (!((mRaw->getCpp() == 1 && mRaw->getBpp() == 2)))
    44      ThrowRDE("Unexpected cpp: %u", mRaw->getCpp());
    45
    46    if (!mRaw->dim.hasPositiveArea() || mRaw->dim.x % 2 != 0 ||
    47        mRaw->dim.x > 11608 || mRaw->dim.y > 8708) {
    48      ThrowRDE("Unexpected image dimensions found: (%u; %u)", mRaw->dim.x,
    49               mRaw->dim.y);
    50    }
    51
    52    if (strips.size() != static_cast<decltype(strips)::size_type>(mRaw->dim.y)) {
    53      ThrowRDE("Height (%u) vs strip count %zu mismatch", mRaw->dim.y,
    54               strips.size());
    55    }
    56  }
    57
    58  void PhaseOneDecompressor::decompressStrip(const PhaseOneStrip& strip) const {
    59    uint32 width = mRaw->dim.x;
    60    assert(width % 2 == 0);
    61
    62    static constexpr std::array<const int, 10> length = {8,  7, 6,  9,  11,
    63                                                         10, 5, 12, 14, 13};
    64
    65    BitPumpMSB32 pump(strip.bs);
    66
    67    std::array<int32, 2> pred;
    68    pred.fill(0);
    69    std::array<int, 2> len;
    70    auto* img = reinterpret_cast<ushort16*>(mRaw->getData(0, strip.n));
    71    for (uint32 col = 0; col < width; col++) {
    72      if (col >= (width & -8))
    73        len[0] = len[1] = 14;
    74      else if ((col & 7) == 0) {
    75        for (int& i : len) {
    76          int j = 0;
    77
    78          for (; j < 5; j++) {
    79            if (pump.getBits(1) != 0) {
    80              if (col == 0)
    81                ThrowRDE("Can not initialize lengths. Data is corrupt.");
    82
    83              // else, we have previously initialized lengths, so we are fine
    84              break;
    85            }
    86          }
    87
    88          assert((col == 0 && j > 0) || col != 0);
    89          if (j > 0)
    90            i = length[2 * (j - 1) + pump.getBits(1)];
    91        }
    92      }
    93
    94      int i = len[col & 1];
    95      if (i == 14)
    96        img[col] = pred[col & 1] = pump.getBits(16);
    97      else {
    98        pred[col & 1] +=
    99            static_cast<signed>(pump.getBits(i)) + 1 - (1 << (i - 1));
   100        // FIXME: is the truncation the right solution here?
   101        img[col] = ushort16(pred[col & 1]);
   102      }
   103    }
   104  }
   105
   106  void PhaseOneDecompressor::decompressThreaded(
   107      const RawDecompressorThread* t) const {
   108    for (size_t i = t->start; i < t->end && i < strips.size(); i++)
   109      decompressStrip(strips[i]);
   110  }
