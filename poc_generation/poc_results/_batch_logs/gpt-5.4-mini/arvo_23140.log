int dom_node_attributes_read(dom_object *obj, zval *retval)
{
        xmlNode *nodep = dom_object_get_node(obj);
        dom_object *intern;

        if (nodep == NULL) {
                php_dom_throw_error(INVALID_STATE_ERR, 0);
                return FAILURE;
