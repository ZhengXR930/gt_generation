    X(VARIABLE) X(VARIABLE_DEFAULT) X(EOF)

#define GENERATE_ENUM(id) LEXEME_ ## id,
#define GENERATE_ARRAY_ITEM(id) [LEXEME_ ## id] = #id,

enum lexeme_type {
    FOR_EACH_LEXEME(GENERATE_ENUM)
    TOTAL_LEXEMES
};

