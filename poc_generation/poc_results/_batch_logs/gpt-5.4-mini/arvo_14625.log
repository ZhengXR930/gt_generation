        UA_Variant_deleteMembers(&value);
        if(retval != UA_STATUSCODE_GOOD || bufPos != bufEnd) {
                return 0;
        }

    UA_Variant value2;
    UA_Variant_init(&value2);

    retval = UA_decodeJson(&buf2, &value2, &UA_TYPES[UA_TYPES_VARIANT]);
    if(retval != UA_STATUSCODE_GOOD) {
                return 0;
