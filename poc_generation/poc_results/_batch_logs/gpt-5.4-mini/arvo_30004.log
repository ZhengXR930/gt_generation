typedef int (*s3_auth_callback) (void *auth_data, char *, kstring_t*, char*, kstring_t*, kstring_t*, kstring_t*, kstring_t*, int);

typedef int (*set_region_callback) (void *auth_data, kstring_t *region);

typedef struct {
