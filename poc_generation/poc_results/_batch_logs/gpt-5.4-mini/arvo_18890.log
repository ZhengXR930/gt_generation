476:const u8 *sc_asn1_find_tag(sc_context_t *ctx, const u8 * buf,
477:    size_t buflen, unsigned int tag_in, size_t *taglen_in)
478:{
479:    size_t left = buflen, taglen;
480:    const u8 *p = buf;
481:
482:    *taglen_in = 0;
483:    while (left >= 2) {
484:            unsigned int cla = 0, tag, mask = 0xff00;
485:
486:            buf = p;
487:            /* read a tag */
488:            if (sc_asn1_read_tag(&p, left, &cla, &tag, &taglen) != SC_SUCCESS
489:                            || p == NULL)
490:                    return NULL;
491:
492:            left -= (p - buf);
493:            /* we need to shift the class byte to the leftmost
494:             * byte of the tag */
495:            while ((tag & mask) != 0) {
496:                    cla  <<= 8;
497:                    mask <<= 8;
498:            }
499:            /* compare the read tag with the given tag */
500:            if ((tag | cla) == tag_in) {
501:                    /* we have a match => return length and value part */
502:                    if (taglen > left)
503:                            return NULL;
504:                    *taglen_in = taglen;
505:                    return p;
506:            }
507:            /* otherwise continue reading tags */
508:            left -= taglen;
509:            p += taglen;
510:    }
511:    return NULL;
512:}
