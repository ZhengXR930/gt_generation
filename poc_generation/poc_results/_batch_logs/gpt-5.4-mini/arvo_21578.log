        struct ucl_parser *parser;
        parser = ucl_parser_new(0);

        ucl_parser_add_string(parser, (char *)data, size);

        if (ucl_parser_get_error(parser) != NULL) {
                return 0;
        }

        ucl_parser_free (parser);
        return 0;
}
