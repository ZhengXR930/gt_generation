    11  static void
    12  ofctl_parse_flows__(struct ofputil_flow_mod *fms, size_t n_fms,
    13                      enum ofputil_protocol usable_protocols)
    14  {
    15      enum ofputil_protocol protocol = 0;
    16      char *usable_s;
    17      size_t i;
    18
    19      usable_s = ofputil_protocols_to_string(usable_protocols);
    20      printf("usable protocols: %s\n", usable_s);
    21      free(usable_s);
    22
    23      if (!(usable_protocols & OFPUTIL_P_ANY)) {
    24          printf("no usable protocol\n");
    25          return;
    26      }
    27      for (i = 0; i < sizeof(enum ofputil_protocol) * CHAR_BIT; i++) {
    28          protocol = 1u << i;
    29          if (protocol & usable_protocols & OFPUTIL_P_ANY) {
    30              break;
    31          }
    32      }
    33      ovs_assert(is_pow2(protocol));
    34
    35      printf("chosen protocol: %s\n", ofputil_protocol_to_string(protocol));
    36
    37      for (i = 0; i < n_fms; i++) {
    38          struct ofputil_flow_mod *fm = &fms[i];
    39          struct ofpbuf *msg;
    40
    41          msg = ofputil_encode_flow_mod(fm, protocol);
    42          ofpbuf_delete(msg);
    43
    44          free(CONST_CAST(struct ofpact *, fm->ofpacts));
    45          minimatch_destroy(&fm->match);
    46      }
    47  }
    48
    49  /* "parse-flow FLOW": parses the argument as a flow (like add-flow) and prints
    50   * it back to stdout.  */
    51  static void
    52  ofctl_parse_flow(const char *input, int command)
    53  {
    54      enum ofputil_protocol usable_protocols;
    55      struct ofputil_flow_mod fm;
    56      char *error;
    57
    58      error = parse_ofp_flow_mod_str(&fm, input, NULL, NULL,
    59                                     command, &usable_protocols);
    60      if (error) {
    61          printf("Error encountered: %s\n", error);
    62          free(error);
    63      } else {
    64          ofctl_parse_flows__(&fm, 1, usable_protocols);
    65          minimatch_destroy(&fm.match);
    66      }
    67  }
    68
    69  int
    70  LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
    71  {
    72      /* Bail out if we cannot construct at least a 1 char string.
    73       * Reserve 1 byte to decide flow mod command.
    74       *
    75       * Here's the structure of data we expect
    76       * |--Byte 1--|--Byte 2--|...|--Byte (size-1)--|
    77       *
    78       * where,
    79       *
    80       * Byte 1: Used to decide which ofp flow mod command to test
    81       * Bytes 2--(size-1): The C string that is actually passed to
    82       *                    ofctl_parse_flow() test API.
    83       *
    84       * This means that the fuzzed input is actually a C string of
    85       * length = (size -2) with the terminal byte being the NUL
    86       * character. Moreover, this string is expected to not contain
    87       * a new-line character.
    88       */
    89      const char *stream = (const char *) data;
    90      if (size < 3 || stream[size - 1] != '\0' || strchr(&stream[1], '\n') ||
    91          strlen(&stream[1]) != size - 2) {
    92          return 0;
    93      }
    94
    95      /* Disable logging to avoid write to disk. */
    96      static bool isInit = false;
    97      if (!isInit) {
    98          vlog_set_verbosity("off");
    99          isInit = true;
   100      }
   101
   102      /* Decide test parameters using first byte of fuzzed input. */
   103      int command = (stream[0] % OFPFC_DELETE_STRICT) + 1;
   104
   105      /* Fuzz extended match parsing. */
   106      const char *input = &stream[1];
   107      ofctl_parse_flow(input, command);
   108
   109      return 0;
   110  }
