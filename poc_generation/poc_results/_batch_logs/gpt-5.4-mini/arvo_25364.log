        {       for (k = 0 ; k < count ; k++)
                        if (abs (buffer [k]) > max)
                                max = abs (buffer [k]) ;
                total += count ;
                } ;

        printf ("Total         : %d\n", total) ;
        printf ("Maximun value : %d\n", max) ;

        sf_close (file) ;

        return 0 ;
} /* main */
