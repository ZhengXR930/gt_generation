#include <QBuffer>
#include <QCoreApplication>
#include <QImage>

#include "kra.h"
#include "ora.h"
#include "pcx_p.h"
#include "pic_p.h"
#include "psd_p.h"
#include "ras_p.h"
#include "rgb_p.h"
#include "tga_p.h"
#include "xcf_p.h"

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
    int argc = 0;
    QCoreApplication a(argc, nullptr);

    QImageIOHandler* handler = new HANDLER();

    QImage i;
    QBuffer b;
    b.setData((const char *)data, size);
    b.open(QIODevice::ReadOnly);
    handler->setDevice(&b);
    handler->canRead();
    handler->read(&i);

    delete handler;

    return 0;
}

