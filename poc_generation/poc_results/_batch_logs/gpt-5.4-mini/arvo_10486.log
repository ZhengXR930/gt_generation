        cmocka_unit_test_setup_teardown(torture_buffer_pack_badformat, setup, teardown)
    };

    ssh_init();
    torture_filter_tests(tests);
    rc = cmocka_run_group_tests(tests, NULL, NULL);
    ssh_finalize();
