                                 */
                k2++;

                if (tmpbuffer1[0] != 0)
                        snprintf(tmpbuffer2, sizeof(tmpbuffer2),
                                 "%s.?%u", tmpbuffer1, k2);
                else
                        snprintf(tmpbuffer2, sizeof(tmpbuffer2),
                                 "?%u", k2);

                /* Try to read the RelativeDistinguishedName attributes.
                 */

