                         k1);

        len = sizeof(value) - 1;
        result =
            asn1_read_value(asn1_struct, tmpbuffer1, value, &len);

        if (result != ASN1_VALUE_NOT_FOUND && result != ASN1_SUCCESS) { /* expected */
                gnutls_assert();
                result = _gnutls_asn2err(result);
                goto cleanup;
