        while (c_isspace(*p))
                p++;

        if (*p != '=')
                return gnutls_assert_val(GNUTLS_E_PARSING_ERROR);
        p++;

        while (c_isspace(*p))
                p++;

        if (*p == '#') {
                *is_raw = 1;
        }

