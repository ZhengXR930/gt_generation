static int __AFL_LOOP(int n)
{
        static int first = 1;

        if (first) {
                first = 0;
                return 1;
        }

        return 0;
}
#endif

int main(int argc, char **argv)
{
        int ret;
        unsigned char buf[64 * 1024];

        while (__AFL_LOOP(10000)) { // only works with afl-clang-fast
                ret = fread(buf, 1, sizeof(buf), stdin);
                if (ret < 0)
                        return 0;

                LLVMFuzzerTestOneInput(buf, ret);
        }

        return 0;
}

