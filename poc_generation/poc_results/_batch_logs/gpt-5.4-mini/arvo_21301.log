   208  /*###########################################################*/
   209  /*
   210   *      pscopyuntil -- copy lines of Postscript from a section of one file
   211   *                     to another file until a particular comment is reached.
   212   *                     Automatically switch to binary copying whenever
   213   *                     %%BeginBinary/%%EndBinary or %%BeginData/%%EndData
   214   *                     comments are encountered.
   215   */
   216  /*###########################################################*/
   217
   218  char *
   219  pscopyuntil(fd, to, begin, end, comment)
   220     FileData fd;
   221     FILE *to;
   222     long begin;                  /* set negative to avoid initial seek */
   223     long end;
   224     char *comment;
   225  {
   226     char *line;
   227     int comment_length;
   228
   229     BEGINMESSAGE(pscopyuntil)
   230     if (comment) {
   231        INFSMESSAGE(will copy until,comment)
   232        comment_length = strlen(comment);
   233     }
   234     else {
   235        INFMESSAGE(will copy until specified file position)
   236        comment_length = 0;
   237     }
   238     if (begin >= 0) ps_io_fseek(fd, begin);
   239     while (ps_io_ftell(fd) < end) {
   240        line = ps_io_fgetchars(fd,-1);
   241        if (!line) break;
   242        if (comment && strncmp(line, comment, comment_length) == 0) {
   243           char *cp = (char *) PS_malloc(strlen(line)+1);
   244           INFSMESSAGE(encountered specified,comment)
   245           CHECK_MALLOCED(cp);
   246           strcpy(cp, line);
   247           ENDMESSAGE(pscopyuntil)
   248           return cp;
   249        }
   250        fputs(line, to);
   251        if  (!IS_COMMENT("Begin"))     {} /* Do nothing */
   252        else if IS_BEGIN("Data:")      {
   253           int  num;
   254           char text[101];
   255           INFMESSAGE(encountered "BeginData:")
   256           if (FD_LINE_LEN > 100) FD_BUF[100] = '\0';
   257           text[0] = '\0';
   258           if (sscanf(line+length("%%BeginData:"), "%d %*s %100s", &num, text) >= 1) {
   259              if (strcmp(text, "Lines") == 0) {
   260                 INFIMESSAGE(number of lines:,num)
   261                 while (num) {
   262                    line = ps_io_fgetchars(fd,-1);
   263                    if (line) fputs(line,to);
   264                    num--;
   265                 }
   266              } else {
   267                 int read_chunk_size = LINE_CHUNK_SIZE;
   268                 INFIMESSAGE(number of chars:,num)
   269                 while (num>0) {
   270                    if (num <= LINE_CHUNK_SIZE) read_chunk_size=num;
   271                    line = ps_io_fgetchars(fd,read_chunk_size);
   272                    if (line) fwrite(line,sizeof(char),FD_LINE_LEN, to);
   273                    num -= read_chunk_size;
   274                 }
   275              }
   276           }
   277        }
   278        else if IS_BEGIN("Binary:") {
   279           int  num;
   280           INFMESSAGE(encountered "BeginBinary:")
   281           if (sscanf(line+length("%%BeginBinary:"), "%d", &num) == 1) {
   282              int read_chunk_size = LINE_CHUNK_SIZE;
   283              INFIMESSAGE(number of chars:,num)
   284              while (num>0) {
   285                 if (num <= LINE_CHUNK_SIZE) read_chunk_size=num;
   286                 line = ps_io_fgetchars(fd,read_chunk_size);
   287                 if (line) fwrite(line, sizeof (char),FD_LINE_LEN, to);
   288                 num -= read_chunk_size;
   289              }
   290           }
   291        }
   292     }
   293     ENDMESSAGE(pscopyuntil)
   294     return NULL;
   295  }
