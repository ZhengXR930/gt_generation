   176  /*----------------------------------------------------------*/
   177  /*
   178     readlineuntil()
   179     Read the next line in the postscript file until char is found
   180     Similar to readline, but it doesn't skip lines.
   181  */
   182  /*----------------------------------------------------------*/
   183
   184  static char * readlineuntil (FileData fd, long enddoseps, char **lineP, long *positionP, unsigned int *line_lenP, char charP)
   185  {
   186     char *line;
   187
   188     if (positionP) *positionP = FD_FILEPOS;
   189
   190     do {
   191         line = ps_io_fgetchars(fd,-1);
   192         if (!line) {
   193             INFMESSAGE(could not get line)
   194             *line_lenP = 0;
   195             *lineP     = empty_string;
   196             ENDMESSAGE(readline)
   197             return(NULL);
   198         }
   199
   200         if (positionP) *positionP = FD_FILEPOS;
   201         *line_lenP = FD_LINE_LEN;
   202         *lineP = FD_BUF+FD_LINE_BEGIN;
   203     } while (line[0] != charP);
   204
   205     return(FD_BUF+FD_LINE_BEGIN);
   206  }
