    38     BEGINMESSAGE(readline)
    39
    40     if (positionP) *positionP = FD_FILEPOS;
    41     if (positionP && enddoseps) {
    42         if (*positionP >= enddoseps)
    43             return NULL;    /* don't read any more, we have reached end of dos eps section */
    44     }
    45
    46     line = ps_io_fgetchars(fd,-1);
    47     if (!line) {
    48        INFMESSAGE(could not get line)
    49        *line_lenP = 0;
    50        *lineP     = empty_string;
    51        ENDMESSAGE(readline)
    52        return(NULL);
    53     }
    54
    55     *line_lenP = FD_LINE_LEN;
