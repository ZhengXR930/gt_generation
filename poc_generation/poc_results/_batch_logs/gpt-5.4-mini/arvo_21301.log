    97     if  (!IS_COMMENT("Begin"))     {} /* Do nothing */
    98     else if IS_BEGIN("Document:")  {  /* Skip the EPS without handling its content */
    99         nesting_level=1;
   100         line = ps_io_fgetchars(fd,-1);
   101         if (line) *line_lenP += FD_LINE_LEN;
   102         while (line) {
   103             if (IS_COMMENT("Begin") && IS_BEGIN("Document:"))
   104                 nesting_level++;
   105             else if (IS_COMMENT("End") && IS_END("Document"))
   106                 nesting_level--;
   107             if (nesting_level == 0) break;
   108             line = ps_io_fgetchars(fd,-1);
   109             if (line) *line_lenP += FD_LINE_LEN;
   110         }
   111     }
   112     else if IS_BEGIN("Feature:")   SKIP_UNTIL_1("EndFeature")
   113  #ifdef USE_ACROREAD_WORKAROUND
   114     else if IS_BEGIN("File")       SKIP_UNTIL_2("EndFile","EOF")
   115  #else
   116     else if IS_BEGIN("File")       SKIP_UNTIL_1("EndFile")
   117  #endif
   118     else if IS_BEGIN("Font")       SKIP_UNTIL_1("EndFont")
   119     else if IS_BEGIN("ProcSet")    SKIP_UNTIL_1("EndProcSet")
   120     else if IS_BEGIN("Resource")   SKIP_UNTIL_1("EndResource")
   121     else if IS_BEGIN("Data:")      {
   122        int  num;
   123        char text[101];
   124        INFMESSAGE(encountered "BeginData:")
   125        if (FD_LINE_LEN > 100) FD_BUF[100] = '\0';
   126        text[0] = '\0';
   127        if (sscanf(line+length("%%BeginData:"), "%d %*s %100s", &num, text) >= 1) {
   128           if (strcmp(text, "Lines") == 0) {
   129              INFIMESSAGE(number of lines to skip:,num)
   130              while (num) {
   131                 line = ps_io_fgetchars(fd,-1);
   132                 if (line) *line_lenP += FD_LINE_LEN;
   133                 num--;
   134              }
   135           } else {
   136              int read_chunk_size = LINE_CHUNK_SIZE;
   137              INFIMESSAGE(number of chars to skip:,num)
   138              while (num>0) {
   139                 if (num <= LINE_CHUNK_SIZE) read_chunk_size=num;
   140                 line = ps_io_fgetchars(fd,read_chunk_size);
   141                 if (line) *line_lenP += FD_LINE_LEN;
   142                 num -= read_chunk_size;
   143              }
   144           }
   145        }
   146        SKIP_UNTIL_1("EndData")
   147     }
   148     else if IS_BEGIN("Binary:") {
   149        int  num;
   150        INFMESSAGE(encountered "BeginBinary:")
   151        if (sscanf(line+length("%%BeginBinary:"), "%d", &num) == 1) {
   152           int read_chunk_size = LINE_CHUNK_SIZE;
   153           INFIMESSAGE(number of chars to skip:,num)
   154           while (num>0) {
   155              if (num <= LINE_CHUNK_SIZE) read_chunk_size=num;
   156              line = ps_io_fgetchars(fd,read_chunk_size);
   157              if (line) *line_lenP += FD_LINE_LEN;
   158              num -= read_chunk_size;
   159           }
   160           SKIP_UNTIL_1("EndBinary")
   161        }
   162     }
   163
   164     if (skipped) {
   165        INFMESSAGE(skipped lines)
   166        *line_lenP += nbytes;
   167        *lineP = skipped_line;
   168     } else {
   169        *lineP = FD_BUF+FD_LINE_BEGIN;
   170     }
   171
   172     ENDMESSAGE(readline)
   173     return(FD_BUF+FD_LINE_BEGIN);
   174  }
