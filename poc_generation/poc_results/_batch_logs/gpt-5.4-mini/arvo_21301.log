   106  /* We use this helper function for providing proper */
   107  /* case and colon :-) insensitive DSC matching */
   108  static int dsc_strncmp(char *s1, char *s2, size_t n)
   109  {
   110   char *tmp;
   111
   112   if (_spectre_strncasecmp(s1, s2, n) == 0)
   113           return 0;
   114   if (s2[n-1] == ':'){
   115           tmp = (char *) PS_malloc(n*sizeof(char));
   116           strncpy(tmp, s2, (n-1));
   117           tmp[n-1]=' ';
   118           if (_spectre_strncasecmp(s1, tmp, n) == 0){
   119                   PS_free(tmp);
   120                   return 0;
   121           }
   122           PS_free(tmp);
   123   }
   124
   125   return 1;
   126  }
