   211  static Boolean scan_boundingbox(int *bb, const char *line)
   212  {
   213      char fllx[21], flly[21], furx[21], fury[21];
   214
   215      if (sscanf (line, "%d %d %d %d",
   216                  &bb[LLX], &bb[LLY], &bb[URX], &bb[URY]) == 4)
   217         return True;
   218
   219      if (sscanf (line, "%20s %20s %20s %20s",
   220                  fllx, flly, furx, fury) == 4) {
   221         float ffllx, fflly, ffurx, ffury;
   222
   223         ffllx = _spectre_strtod (fllx, NULL);
   224         fflly = _spectre_strtod (flly, NULL);
   225         ffurx = _spectre_strtod (furx, NULL);
   226         ffury = _spectre_strtod (fury, NULL);
   227
   228         bb[LLX] = ffllx;
   229         bb[LLY] = fflly;
   230         bb[URX] = ffurx;
   231         bb[URY] = ffury;
   232
   233         if (bb[LLX] > ffllx)
   234            bb[LLX]--;
   235         if (bb[LLY] > fflly)
   236            bb[LLY]--;
   237         if (bb[URX] < ffurx)
   238            bb[URX]++;
   239         if (bb[URY] < ffury)
   240            bb[URY]++;
   241
   242         return True;
   243      }
   244
   245      return False;
   246  }
