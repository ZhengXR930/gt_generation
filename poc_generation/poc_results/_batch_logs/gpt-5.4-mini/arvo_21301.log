    57  #define IS_COMMENT(comment)                             \
    58             (DSCcomment(line) && iscomment(line+2,(comment)))
    59  #define IS_BEGIN(comment)                               \
    60             (iscomment(line+7,(comment)))
    61  #define IS_END(comment)                         \
    62             (iscomment(line+5,(comment)))
    63  #define SKIP_WHILE(cond)                                \
    64             while (readline(fd, enddoseps, &line, NULL, &nbytes) && (cond)) *line_lenP += nbytes;        \
    65             skipped=1;
    66  #define SKIP_UNTIL_1(comment) {                         \
    67             INFMESSAGE(skipping until comment)           \
    68             SKIP_WHILE((!IS_COMMENT(comment)))           \
    69             INFMESSAGE(completed skipping until comment) \
    70          }
    71  #define SKIP_UNTIL_2(comment1,comment2) {               \
    72             INFMESSAGE(skipping until comment1 or comment2)\
    73             SKIP_WHILE((!IS_COMMENT(comment1) && !IS_COMMENT(comment2)))\
    74             INFMESSAGE(completed skipping until comment1 or comment2)\
    75          }
    76
    77  #if 0
