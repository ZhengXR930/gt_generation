    30  #include "spectre-document.h"
    31  #include "spectre-private.h"
    32  #include "spectre-exporter.h"
    33  #include "spectre-utils.h"
    34
    35  struct SpectreDocument
    36  {
    37          struct document *doc;
    38
    39          SpectreStatus    status;
    40
    41          int              structured;
    42  };
    43
    44  SpectreDocument *
    45  spectre_document_new (void)
    46  {
    47          SpectreDocument *doc;
    48
    49          doc = calloc (1, sizeof (SpectreDocument));
    50          return doc;
    51  }
    52
    53  static void
    54  document_load (SpectreDocument *document,
    55                 const char      *filename,
    56                 FILE            *file)
    57  {
    58          _spectre_return_if_fail (document != NULL);
    59
    60          if (document->doc && strcmp (filename, document->doc->filename) == 0) {
    61                  document->status = SPECTRE_STATUS_SUCCESS;
    62                  return;
    63          }
    64
    65          if (document->doc) {
    66                  psdocdestroy (document->doc);
    67                  document->doc = NULL;
    68          }
    69
    70          if (!file) {
    71                  document->status = SPECTRE_STATUS_LOAD_ERROR;
    72                  return;
    73          }
    74
    75          document->doc = psscan (file, filename, SCANSTYLE_NORMAL);
    76          if (!document->doc) {
    77                  document->status = SPECTRE_STATUS_LOAD_ERROR;
    78                  return;
    79          }
    80
    81          if (document->doc->numpages == 0 && document->doc->lenprolog == 0) {
    82                  document->status = SPECTRE_STATUS_LOAD_ERROR;
    83                  psdocdestroy (document->doc);
    84                  document->doc = NULL;
    85
    86                  return;
    87          } else if (document->doc->numpages == 0 && !document->doc->format) {
    88                  /* Make sure it's a valid PS document */
    89                  unsigned char *data = NULL;
    90                  int            row_length;
    91
    92                  spectre_document_render (document, &data, &row_length);
    93                  free (data);
    94
    95                  if (spectre_document_status (document)) {
    96                          document->status = SPECTRE_STATUS_LOAD_ERROR;
    97                          psdocdestroy (document->doc);
    98                          document->doc = NULL;
    99
   100                          return;
   101                  }
   102          }
   103
   104          document->structured = ((!document->doc->epsf && document->doc->numpages > 0) ||
   105                                  (document->doc->epsf && document->doc->numpages > 1));
   106
   107          if (document->status != SPECTRE_STATUS_SUCCESS)
   108                  document->status = SPECTRE_STATUS_SUCCESS;
   109
   110  }
   111
   112  void
   113  spectre_document_load (SpectreDocument *document,
   114                         const char *filename)
   115  {
   116          FILE *file;
   117
   118          _spectre_return_if_fail (filename != NULL);
   119
   120          file = fopen (filename, "rb");
   121          document_load (document, filename, file);
   122          fclose (file);
   123  }
   124
   125  void
   126  spectre_document_load_from_stream (SpectreDocument *document,
   127                                     FILE            *file)
   128  {
   129          document_load (document, "stream", file);
   130  }
   131
   132  void
   133  spectre_document_free (SpectreDocument *document)
   134  {
   135          if (!document)
   136                  return;
   137
   138          if (document->doc) {
   139                  psdocdestroy (document->doc);
   140                  document->doc = NULL;
   141          }
   142
   143          free (document);
   144  }
   145
   146  SpectreStatus
   147  spectre_document_status (SpectreDocument *document)
   148  {
   149          _spectre_return_val_if_fail (document != NULL, SPECTRE_STATUS_DOCUMENT_NOT_LOADED);
   150
   151          return document->status;
   152  }
   153
   154  unsigned int
   155  spectre_document_get_n_pages (SpectreDocument *document)
   156  {
   157          _spectre_return_val_if_fail (document != NULL, 0);
   158
   159          if (!document->doc) {
   160                  document->status = SPECTRE_STATUS_DOCUMENT_NOT_LOADED;
   161                  return 0;
   162          }
   163
   164          return document->structured ? document->doc->numpages : 1;
   165  }
   166
   167  SpectreOrientation
   168  spectre_document_get_orientation (SpectreDocument *document)
   169  {
   170          int doc_orientation;
   171
   172          _spectre_return_val_if_fail (document != NULL, SPECTRE_ORIENTATION_PORTRAIT);
   173
   174          if (!document->doc) {
   175                  document->status = SPECTRE_STATUS_DOCUMENT_NOT_LOADED;
   176                  return SPECTRE_ORIENTATION_PORTRAIT;
   177          }
   178
   179          doc_orientation = document->doc->orientation != NONE ?
   180                  document->doc->orientation : document->doc->default_page_orientation;
   181
   182          switch (doc_orientation) {
   183          default:
   184          case PORTRAIT:
   185                  return SPECTRE_ORIENTATION_PORTRAIT;
   186          case LANDSCAPE:
   187                  return SPECTRE_ORIENTATION_LANDSCAPE;
   188          case SEASCAPE:
   189                  return SPECTRE_ORIENTATION_REVERSE_LANDSCAPE;
   190          case UPSIDEDOWN:
   191                  return SPECTRE_ORIENTATION_REVERSE_PORTRAIT;
   192          }
   193  }
   194
   195  const char *
   196  spectre_document_get_title (SpectreDocument *document)
   197  {
   198          _spectre_return_val_if_fail (document != NULL, NULL);
   199
   200          if (!document->doc) {
   201                  document->status = SPECTRE_STATUS_DOCUMENT_NOT_LOADED;
   202                  return NULL;
   203          }
   204
   205          return document->doc->title;
   206  }
   207
   208  const char *
   209  spectre_document_get_creator (SpectreDocument *document)
   210  {
   211          _spectre_return_val_if_fail (document != NULL, NULL);
   212
   213          if (!document->doc) {
   214                  document->status = SPECTRE_STATUS_DOCUMENT_NOT_LOADED;
   215                  return NULL;
   216          }
   217
   218          return document->doc->creator;
   219  }
