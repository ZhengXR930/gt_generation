    15  /*
    16     readline()
    17     Read the next line in the postscript file.
    18     Automatically skip over data (as indicated by
    19     %%BeginBinary/%%EndBinary or %%BeginData/%%EndData
    20     comments.)
    21     Also, skip over included documents (as indicated by
    22     %%BeginDocument/%%EndDocument comments.)
    23  */
    24  /*----------------------------------------------------------*/
    25
    26  static char * readline (fd, enddoseps, lineP, positionP, line_lenP)
    27     FileData fd;
    28     long enddoseps;
    29     char **lineP;
    30     long *positionP;
    31     unsigned int *line_lenP;
