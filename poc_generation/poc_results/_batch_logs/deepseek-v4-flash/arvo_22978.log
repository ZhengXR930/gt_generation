   453	    order = get2();
   454	    hlen = get4();
   455	    if (get4() == 0x48454150 && (save + hlen) >= 0 &&
   456	        (save + hlen) <= ifp->size()) /* "HEAP" */
   457	    {
   458	      parse_ciff(save + hlen, len - hlen, 0);
   459	    }
   460	    if (parse_tiff(save + 6))
   461	      apply_tiff();
   462	    fseek(ifp, save + len, SEEK_SET);
   463	  }
   464	  return 1;
   465	}
