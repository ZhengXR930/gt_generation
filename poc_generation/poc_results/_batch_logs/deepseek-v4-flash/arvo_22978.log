   544	/*
   545	   Since the TIFF DateTime string has no timezone information,
   546	   assume that the camera's clock was set to Universal Time.
   547	 */
   548	void LibRaw::get_timestamp(int reversed)
   549	{
   550	  struct tm t;
   551	  char str[20];
   552	  int i;
   553	
   554	  str[19] = 0;
   555	  if (reversed)
   556	    for (i = 19; i--;)
   557	      str[i] = fgetc(ifp);
   558	  else
   559	    fread(str, 19, 1, ifp);
   560	  memset(&t, 0, sizeof t);
   561	  if (sscanf(str, "%d:%d:%d %d:%d:%d", &t.tm_year, &t.tm_mon, &t.tm_mday,
   562	             &t.tm_hour, &t.tm_min, &t.tm_sec) != 6)
   563	    return;
   564	  t.tm_year -= 1900;
   565	  t.tm_mon -= 1;
   566	  t.tm_isdst = -1;
   567	  if (mktime(&t) > 0)
   568	    timestamp = mktime(&t);
   569	}
