   483	void LibRaw::parse_broadcom()
   484	{
   485	
   486	  /* This structure is at offset 0xb0 from the 'BRCM' ident. */
   487	  struct
   488	  {
   489	    uint8_t umode[32];
   490	    uint16_t uwidth;
   491	    uint16_t uheight;
   492	    uint16_t padding_right;
   493	    uint16_t padding_down;
   494	    uint32_t unknown_block[6];
   495	    uint16_t transform;
   496	    uint16_t format;
   497	    uint8_t bayer_order;
   498	    uint8_t bayer_format;
   499	  } header;
   500	
   501	  header.bayer_order = 0;
   502	  fseek(ifp, 0xb0 - 0x20, SEEK_CUR);
   503	  fread(&header, 1, sizeof(header), ifp);
   504	  /* load_flags is not used in broadcom loader, so reuse it for raw_stride */
   505	  load_flags =
   506	      ((((((header.uwidth + header.padding_right) * 5) + 3) >> 2) + 0x1f) &
   507	       (~0x1f));
   508	  raw_width = width = header.uwidth;
   509	  raw_height = height = header.uheight;
   510	  filters = 0x16161616; /* default Bayer order is 2, BGGR */
   511	
   512	  switch (header.bayer_order)
   513	  {
   514	  case 0: /* RGGB */
   515	    filters = 0x94949494;
   516	    break;
   517	  case 1: /* GBRG */
   518	    filters = 0x49494949;
   519	    break;
   520	  case 3: /* GRBG */
   521	    filters = 0x61616161;
   522	    break;
   523	  }
   524	}
