   526	/*
   527	   Returns 1 for a Coolpix 995, 0 for anything else.
   528	 */
   529	int LibRaw::nikon_e995()
   530	{
   531	  int i, histo[256];
   532	  const uchar often[] = {0x00, 0x55, 0xaa, 0xff};
   533	
   534	  memset(histo, 0, sizeof histo);
   535	  fseek(ifp, -2000, SEEK_END);
   536	  for (i = 0; i < 2000; i++)
   537	    histo[fgetc(ifp)]++;
   538	  for (i = 0; i < 4; i++)
   539	    if (histo[often[i]] < 200)
   540	      return 0;
   541	  return 1;
   542	}
