   467	void LibRaw::parse_thumb_note(int base, unsigned toff, unsigned tlen)
   468	{
   469	  unsigned entries, tag, type, len, save;
   470	
   471	  entries = get2();
   472	  while (entries--)
   473	  {
   474	    tiff_get(base, &tag, &type, &len, &save);
   475	    if (tag == toff)
   476	      thumb_offset = get4() + base;
   477	    if (tag == tlen)
   478	      thumb_length = get4();
   479	    fseek(ifp, save, SEEK_SET);
   480	  }
   481	}
