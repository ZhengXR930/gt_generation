   100  static bool HdlcByteNeedsEscape(uint8_t aByte)
   101  {
   102      bool rval;
   103
   104      switch (aByte)
   105      {
   106      case kFlagXOn:
   107      case kFlagXOff:
   108      case kEscapeSequence:
   109      case kFlagSequence:
   110      case kFlagSpecial:
   111          rval = true;
   112          break;
   113
   114      default:
   115          rval = false;
   116          break;
   117      }
   118
   119      return rval;
   120  }
