    60  otError Tlv::GetOffset(const Message &aMessage, uint8_t aType, uint16_t &aOffset)
    61  {
    62      otError  error  = OT_ERROR_NOT_FOUND;
    63      uint16_t offset = aMessage.GetOffset();
    64      uint16_t end    = aMessage.GetLength();
    65      Tlv      tlv;
    66
    67      while (offset + sizeof(tlv) <= end)
    68      {
    69          uint32_t length = sizeof(tlv);
    70
    71          aMessage.Read(offset, sizeof(tlv), &tlv);
    72
    73          if (tlv.GetLength() != kExtendedLength)
