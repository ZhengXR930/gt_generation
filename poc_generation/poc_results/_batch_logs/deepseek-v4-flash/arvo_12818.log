   383  bool TGAHandler::write(const QImage &image)
   384  {
   385      QDataStream s(device());
   386      s.setByteOrder(QDataStream::LittleEndian);
   387
   388      const QImage &img = image;
   389      const bool hasAlpha = (img.format() == QImage::Format_ARGB32);
   390      for (int i = 0; i < 12; i++) {
   391          s << targaMagic[i];
   392      }
   393
   394      // write header
   395      s << quint16(img.width());   // width
   396      s << quint16(img.height());   // height
   397      s << quint8(hasAlpha ? 32 : 24);   // depth (24 bit RGB + 8 bit alpha)
   398      s << quint8(hasAlpha ? 0x24 : 0x20);   // top left image (0x20) + 8 bit alpha (0x4)
   399
   400      for (int y = 0; y < img.height(); y++)
   401          for (int x = 0; x < img.width(); x++) {
   402              const QRgb color = img.pixel(x, y);
   403              s << quint8(qBlue(color));
   404              s << quint8(qGreen(color));
   405              s << quint8(qRed(color));
   406              if (hasAlpha) {
   407                  s << quint8(qAlpha(color));
   408              }
   409          }
   410
   411      return true;
   412  }
   413
   414  bool TGAHandler::canRead(QIODevice *device)
   415  {
   416      if (!device) {
   417          qWarning("TGAHandler::canRead() called with no device");
   418          return false;
   419      }
   420
   421      qint64 oldPos = device->pos();
   422      QByteArray head = device->read(TgaHeader::SIZE);
   423      int readBytes = head.size();
   424
   425      if (device->isSequential()) {
   426          for (int pos = readBytes - 1; pos >= 0; --pos) {
   427              device->ungetChar(head[pos]);
   428          }
   429      } else {
   430          device->seek(oldPos);
   431      }
   432
   433      if (readBytes < TgaHeader::SIZE) {
   434          return false;
   435      }
   436
   437      QDataStream stream(head);
   438      stream.setByteOrder(QDataStream::LittleEndian);
   439      TgaHeader tga;
   440      stream >> tga;
   441      return IsSupported(tga);
   442  }
