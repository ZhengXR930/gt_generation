   444  QImageIOPlugin::Capabilities TGAPlugin::capabilities(QIODevice *device, const QByteArray &format) const
   445  {
   446      if (format == "tga") {
   447          return Capabilities(CanRead | CanWrite);
   448      }
   449      if (!format.isEmpty()) {
   450          return {};
   451      }
   452      if (!device->isOpen()) {
