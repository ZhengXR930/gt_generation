   131	struct Color555 {
   132	    ushort b : 5;
   133	    ushort g : 5;
   134	    ushort r : 5;
   135	};
   136	
   137	struct TgaHeaderInfo {
   138	    bool rle;
   139	    bool pal;
   140	    bool rgb;
   141	    bool grey;
   142	
   143	    TgaHeaderInfo(const TgaHeader &tga) : rle(false), pal(false), rgb(false), grey(false)
   144	    {
   145	        switch (tga.image_type) {
   146	        case TGA_TYPE_RLE_INDEXED:
   147	            rle = true;
   148	        Q_FALLTHROUGH();
   149	        // no break is intended!
   150	        case TGA_TYPE_INDEXED:
   151	            pal = true;
   152	            break;
   153	
   154	        case TGA_TYPE_RLE_RGB:
   155	            rle = true;
   156	        Q_FALLTHROUGH();
   157	        // no break is intended!
   158	        case TGA_TYPE_RGB:
   159	            rgb = true;
   160	            break;
   161	
   162	        case TGA_TYPE_RLE_GREY:
   163	            rle = true;
   164	        Q_FALLTHROUGH();
   165	        // no break is intended!
   166	        case TGA_TYPE_GREY:
   167	            grey = true;
   168	            break;
   169	
   170	        default:
   171	            // Error, unknown image type.
   172	            break;
   173	        }
   174	    }
   175	};
   176	
   177	static bool LoadTGA(QDataStream &s, const TgaHeader &tga, QImage &img)
   178	{
   179	    // Create image.
   180	    img = QImage(tga.width, tga.height, QImage::Format_RGB32);
   181	
   182	    TgaHeaderInfo info(tga);
   183	
   184	    // Bits 0-3 are the numbers of alpha bits (can be zero!)
   185	    const int numAlphaBits = tga.flags & 0xf;
   186	    // However alpha exists only in the 32 bit format.
   187	    if ((tga.pixel_size == 32) && (tga.flags & 0xf)) {
   188	        img = QImage(tga.width, tga.height, QImage::Format_ARGB32);
   189	
   190	        if (numAlphaBits > 8) {
   191	            return false;
   192	        }
   193	    }
   194	
   195	    uint pixel_size = (tga.pixel_size / 8);
   196	    qint64 size = qint64(tga.width) * qint64(tga.height) * pixel_size;
   197	
   198	    if (size < 1) {
   199	//          qDebug() << "This TGA file is broken with size " << size;
   200	        return false;
   201	    }
   202	
   203	    // Read palette.
   204	    char palette[768];
   205	    if (info.pal) {
   206	        // @todo Support palettes in other formats!
   207	        const int size = 3 * tga.colormap_length;
   208	        const int dataRead = s.readRawData(palette, size);
   209	        if (dataRead < size) {
   210	            memset(&palette[dataRead], 0, size - dataRead);
   211	        }
   212	    }
   213	
   214	    // Allocate image.
   215	    uchar *const image = reinterpret_cast<uchar*>(malloc(size));
   216	    if (!image) {
   217	        return false;
   218	    }
   219	
   220	    bool valid = true;
   221	
   222	    if (info.rle) {
   223	        // Decode image.
   224	        char *dst = (char *)image;
   225	        qint64 num = size;
   226	
   227	        while (num > 0) {
   228	            if (s.atEnd()) {
   229	                valid = false;
   230	                break;
   231	            }
   232	
   233	            // Get packet header.
   234	            uchar c;
   235	            s >> c;
   236	
   237	            uint count = (c & 0x7f) + 1;
   238	            num -= count * pixel_size;
   239	            if (num < 0) {
   240	                valid = false;
   241	                break;
   242	            }
   243	
   244	            if (c & 0x80) {
   245	                // RLE pixels.
   246	                assert(pixel_size <= 8);
   247	                char pixel[8];
   248	                s.readRawData(pixel, pixel_size);
   249	                do {
   250	                    memcpy(dst, pixel, pixel_size);
   251	                    dst += pixel_size;
   252	                } while (--count);
   253	            } else {
   254	                // Raw pixels.
   255	                count *= pixel_size;
   256	                s.readRawData(dst, count);
   257	                dst += count;
   258	            }
   259	        }
   260	    } else {
   261	        // Read raw image.
   262	        const int dataRead = s.readRawData((char *)image, size);
   263	        if (dataRead < size) {
   264	            memset(&image[dataRead], 0, size - dataRead);
   265	        }
   266	    }
   267	
   268	    if (!valid) {
   269	        free(image);
   270	        return false;
   271	    }
   272	
   273	    // Convert image to internal format.
   274	    int y_start, y_step, y_end;
   275	    if (tga.flags & TGA_ORIGIN_UPPER) {
   276	        y_start = 0;
   277	        y_step = 1;
   278	        y_end = tga.height;
   279	    } else {
   280	        y_start = tga.height - 1;
   281	        y_step = -1;
   282	        y_end = -1;
   283	    }
   284	
   285	    uchar *src = image;
   286	
   287	    for (int y = y_start; y != y_end; y += y_step) {
   288	        QRgb *scanline = (QRgb *) img.scanLine(y);
   289	
   290	        if (info.pal) {
   291	            // Paletted.
   292	            for (int x = 0; x < tga.width; x++) {
   293	                uchar idx = *src++;
   294	                scanline[x] = qRgb(palette[3 * idx + 2], palette[3 * idx + 1], palette[3 * idx + 0]);
   295	            }
   296	        } else if (info.grey) {
   297	            // Greyscale.
   298	            for (int x = 0; x < tga.width; x++) {
   299	                scanline[x] = qRgb(*src, *src, *src);
   300	                src++;
   301	            }
   302	        } else {
   303	            // True Color.
   304	            if (tga.pixel_size == 16) {
   305	                for (int x = 0; x < tga.width; x++) {
   306	                    Color555 c = *reinterpret_cast<Color555 *>(src);
   307	                    scanline[x] = qRgb((c.r << 3) | (c.r >> 2), (c.g << 3) | (c.g >> 2), (c.b << 3) | (c.b >> 2));
   308	                    src += 2;
   309	                }
   310	            } else if (tga.pixel_size == 24) {
   311	                for (int x = 0; x < tga.width; x++) {
   312	                    scanline[x] = qRgb(src[2], src[1], src[0]);
   313	                    src += 3;
   314	                }
   315	            } else if (tga.pixel_size == 32) {
   316	                for (int x = 0; x < tga.width; x++) {
   317	                    // ### TODO: verify with images having really some alpha data
   318	                    const uchar alpha = (src[3] << (8 - numAlphaBits));
   319	                    scanline[x] = qRgba(src[2], src[1], src[0], alpha);
   320	                    src += 4;
   321	                }
   322	            }
   323	        }
   324	    }
   325	
   326	    // Free image.
   327	    free(image);
   328	
   329	    return true;
   330	}
