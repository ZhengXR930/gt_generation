/**
 * p2p_parse_free - Free temporary data from P2P parsing
 * @msg: Parsed attributes
 */
void p2p_parse_free(struct p2p_message *msg)
{
        wpabuf_free(msg->p2p_attributes);
        msg->p2p_attributes = NULL;
        wpabuf_free(msg->wps_attributes);
