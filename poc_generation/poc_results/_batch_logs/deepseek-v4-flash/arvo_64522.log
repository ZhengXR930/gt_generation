                goto end;

        if (fill_key_template(&key_template, &n_key_attr, &data, &size, &class, true) != 0)
                goto end;

        if (size < 3)
                goto end;
        if (data[0] && n_key_attr < 20) {
                data++; size--;
                ptr = data;
                if ((contents_len = get_buffer(&ptr, size, &data, &size, 5000)) == 0)
                        goto end;
