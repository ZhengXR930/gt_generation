        p11->C_CloseSession(session);
        p11->C_Finalize(NULL);
end:
        free(pin);
        free(key_template);
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size)
{
        uint8_t operation = 0;
        void (*func_ptr[])(const uint8_t*, size_t) = {
                test_change_pin,
                test_init_pin,
                test_init_token,
                test_random,
                test_digest_update,
                test_digest,
                test_sign,
                test_verify,
                test_decrypt,
                test_wrap,
                test_unwrap,
                test_derive,
                test_genkeypair,
                test_store_data,
                test_store_cert,
                test_store_key
        };

        if (size < 10)
                return 0;

        operation = *data % 16;
        data++;
        size--;

