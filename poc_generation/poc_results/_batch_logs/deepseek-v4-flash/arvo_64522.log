static void test_unwrap(const uint8_t *data, size_t size)
{
        CK_SESSION_HANDLE    session;
        CK_MECHANISM         mech = {0, NULL_PTR, 0};
        uint8_t              login_type = CKU_USER;
        char                *pin = NULL;
        const unsigned char *opt_id, *wrapped_key;
