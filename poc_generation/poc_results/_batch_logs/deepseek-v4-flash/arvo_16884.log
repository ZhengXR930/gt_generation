   313	extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
   314	  if (size < 1) {
   315	    return 0;
   316	  }
   317	  size_t colorFormatOfst = std::min((size_t)OFFSET_COLOR_FORMAT, size - 1);
   318	  size_t numCoresOfst = std::min((size_t)OFFSET_NUM_CORES, size - 1);
   319	  size_t colorFormatIdx = data[colorFormatOfst] % kSupportedColorFormats;
   320	  IV_COLOR_FORMAT_T colorFormat =
   321	      (IV_COLOR_FORMAT_T)(supportedColorFormats[colorFormatIdx]);
   322	  uint32_t numCores = (data[numCoresOfst] % kMaxCores) + 1;
   323	
   324	  Codec *codec = new Codec(colorFormat, numCores);
   325	  codec->createCodec();
   326	  codec->setCores();
   327	  codec->decodeHeader(data, size);
   328	  codec->setParams(IVD_DECODE_FRAME);
   329	  codec->allocFrame();
   330	
   331	  while (size > 0) {
   332	    IV_API_CALL_STATUS_T ret;
   333	    size_t bytesConsumed;
   334	    ret = codec->decodeFrame(data, size, &bytesConsumed);
   335	
   336	    bytesConsumed = std::min(size, bytesConsumed);
   337	    data += bytesConsumed;
   338	    size -= bytesConsumed;
   339	  }
   340	
   341	  codec->freeFrame();
   342	  codec->deleteCodec();
   343	  delete codec;
   344	  return 0;
   345	}
