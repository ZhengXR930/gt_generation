   175	void Codec::freeFrame() {
   176	  for (int i = 0; i < mOutBufHandle.u4_num_bufs; i++) {
   177	    if (mOutBufHandle.pu1_bufs[i]) {
   178	      free(mOutBufHandle.pu1_bufs[i]);
   179	      mOutBufHandle.pu1_bufs[i] = nullptr;
   180	    }
   181	  }
