   183	
   184	void Codec::allocFrame() {
   185	  size_t sizes[4] = {0};
   186	  size_t num_bufs = 0;
   187	
   188	  freeFrame();
   189	
   190	  memset(&mOutBufHandle, 0, sizeof(mOutBufHandle));
   191	
   192	  switch (mColorFormat) {
   193	    case IV_YUV_420SP_UV:
   194	      [[fallthrough]];
   195	    case IV_YUV_420SP_VU:
   196	      sizes[0] = mWidth * mHeight;
   197	      sizes[1] = mWidth * mHeight >> 1;
   198	      num_bufs = 2;
   199	      break;
   200	    case IV_YUV_422ILE:
   201	      sizes[0] = mWidth * mHeight * 2;
   202	      num_bufs = 1;
   203	      break;
   204	    case IV_RGB_565:
   205	      sizes[0] = mWidth * mHeight * 2;
   206	      num_bufs = 1;
   207	      break;
   208	    case IV_RGBA_8888:
   209	      sizes[0] = mWidth * mHeight * 4;
   210	      num_bufs = 1;
   211	      break;
   212	    case IV_YUV_420P:
   213	      [[fallthrough]];
   214	    default:
   215	      sizes[0] = mWidth * mHeight;
   216	      sizes[1] = mWidth * mHeight >> 2;
   217	      sizes[2] = mWidth * mHeight >> 2;
   218	      num_bufs = 3;
   219	      break;
   220	  }
   221	  mOutBufHandle.u4_num_bufs = num_bufs;
   222	  for (int i = 0; i < num_bufs; i++) {
   223	    mOutBufHandle.u4_min_out_buf_size[i] = sizes[i];
   224	    mOutBufHandle.pu1_bufs[i] = (UWORD8 *)memalign(16, sizes[i]);
   225	  }
   226	}
   227	
   228	void Codec::decodeHeader(const uint8_t *data, size_t size) {
   229	  setParams(IVD_DECODE_HEADER);
   230	
   231	  while (size > 0) {
   232	    IV_API_CALL_STATUS_T ret;
   233	    ivd_video_decode_ip_t dec_ip;
   234	    ivd_video_decode_op_t dec_op;
   235	    size_t bytes_consumed;
   236	
   237	    memset(&dec_ip, 0, sizeof(dec_ip));
   238	    memset(&dec_op, 0, sizeof(dec_op));
   239	
   240	    dec_ip.e_cmd = IVD_CMD_VIDEO_DECODE;
   241	    dec_ip.u4_ts = 0;
   242	    dec_ip.pv_stream_buffer = (void *)data;
   243	    dec_ip.u4_num_Bytes = size;
   244	    dec_ip.u4_size = sizeof(ivd_video_decode_ip_t);
   245	    dec_op.u4_size = sizeof(ivd_video_decode_op_t);
   246	
   247	    ret = ivd_api_function(mCodec, (void *)&dec_ip, (void *)&dec_op);
   248	
   249	    bytes_consumed = dec_op.u4_num_bytes_consumed;
   250	    /* If no bytes are consumed, then consume 4 bytes to ensure fuzzer proceeds
   251	     * to feed next data */
   252	    if (!bytes_consumed) bytes_consumed = 4;
   253	
   254	    bytes_consumed = std::min(size, bytes_consumed);
   255	
   256	    data += bytes_consumed;
   257	    size -= bytes_consumed;
   258	
   259	    mWidth = std::min(dec_op.u4_pic_wd, (UWORD32)10240);
   260	    mHeight = std::min(dec_op.u4_pic_ht, (UWORD32)10240);
   261	
   262	    /* Break after successful header decode */
   263	    if (mWidth && mHeight) {
   264	      break;
   265	    }
   266	  }
   267	  /* if width / height are invalid, set them to defaults */
   268	  if (!mWidth) mWidth = 1920;
   269	  if (!mHeight) mHeight = 1088;
   270	}
   271	
   272	IV_API_CALL_STATUS_T Codec::decodeFrame(const uint8_t *data, size_t size,
   273	                                        size_t *bytesConsumed) {
   274	  IV_API_CALL_STATUS_T ret;
   275	  ivd_video_decode_ip_t dec_ip;
   276	  ivd_video_decode_op_t dec_op;
   277	
   278	  memset(&dec_ip, 0, sizeof(dec_ip));
   279	  memset(&dec_op, 0, sizeof(dec_op));
   280	
   281	  dec_ip.e_cmd = IVD_CMD_VIDEO_DECODE;
   282	  dec_ip.u4_ts = 0;
   283	  dec_ip.pv_stream_buffer = (void *)data;
   284	  dec_ip.u4_num_Bytes = size;
   285	  dec_ip.u4_size = sizeof(ivd_video_decode_ip_t);
   286	  dec_ip.s_out_buffer = mOutBufHandle;
   287	
   288	  dec_op.u4_size = sizeof(ivd_video_decode_op_t);
   289	
   290	  ret = ivd_api_function(mCodec, (void *)&dec_ip, (void *)&dec_op);
   291	
   292	  /* In case of change in resolution, reset codec and feed the same data again
   293	   */
   294	  if (IVD_RES_CHANGED == (dec_op.u4_error_code & 0xFF)) {
   295	    resetCodec();
   296	    ret = ivd_api_function(mCodec, (void *)&dec_ip, (void *)&dec_op);
   297	  }
   298	  *bytesConsumed = dec_op.u4_num_bytes_consumed;
   299	
   300	  /* If no bytes are consumed, then consume 4 bytes to ensure fuzzer proceeds
   301	   * to feed next data */
   302	  if (!*bytesConsumed) *bytesConsumed = 4;
   303	
   304	  if (mWidth != dec_op.u4_pic_wd || mHeight != dec_op.u4_pic_ht) {
   305	    mWidth = std::min(dec_op.u4_pic_wd, (UWORD32)10240);
   306	    mHeight = std::min(dec_op.u4_pic_ht, (UWORD32)10240);
   307	    allocFrame();
   308	  }
   309	
   310	  return ret;
   311	}
