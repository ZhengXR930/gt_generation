int
cdpv2_send(struct lldpd *global,
    struct lldpd_hardware *hardware)
{
        return cdp_send(global, hardware, 2);
}
#endif

#ifdef ENABLE_FDP
int
fdp_send(struct lldpd *global,
    struct lldpd_hardware *hardware)
{
