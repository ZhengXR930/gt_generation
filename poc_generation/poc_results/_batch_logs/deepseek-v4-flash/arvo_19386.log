   260	    for (Joiner *joiner = &mJoiners[0]; joiner < OT_ARRAY_END(mJoiners); joiner++)
   261	    {
   262	        if (joiner->mValid)
   263	        {
   264	            continue;
   265	        }
   266	
   267	        if (aEui64 != NULL)
   268	        {
   269	            joiner->mEui64 = *aEui64;
   270	            joiner->mAny   = false;
   271	        }
   272	        else
   273	        {
   274	            joiner->mAny = true;
   275	        }
   276	
   277	        (void)strlcpy(joiner->mPsk, aPskd, sizeof(joiner->mPsk));
   278	        joiner->mValid          = true;
   279	        joiner->mExpirationTime = TimerMilli::GetNow() + Time::SecToMsec(aTimeout);
   280	
   281	        UpdateJoinerExpirationTimer();
   282	
   283	        SendCommissionerSet();
   284	
   285	        otLogInfoMeshCoP("Added Joiner (%s, %s)", (aEui64 != NULL) ? aEui64->ToString().AsCString() : "*", aPskd);
   286	
   287	        ExitNow(error = OT_ERROR_NONE);
   288	    }
   289	
   290	exit:
   291	    return error;
   292	}
