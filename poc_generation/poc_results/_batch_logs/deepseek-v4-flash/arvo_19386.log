   425	}
   426	
   427	void Commissioner::HandleJoinerExpirationTimer(void)
   428	{
   429	    TimeMilli now = TimerMilli::GetNow();
   430	
   431	    // Remove Joiners.
   432	    for (Joiner *joiner = &mJoiners[0]; joiner < OT_ARRAY_END(mJoiners); joiner++)
   433	    {
   434	        if (!joiner->mValid)
   435	        {
   436	            continue;
   437	        }
   438	
   439	        if (now >= joiner->mExpirationTime)
   440	        {
   441	            otLogDebgMeshCoP("removing joiner due to timeout or successfully joined");
   442	            RemoveJoiner(&joiner->mEui64, 0); // remove immediately
   443	        }
   444	    }
   445	
   446	    UpdateJoinerExpirationTimer();
   447	}
   448	
   449	void Commissioner::UpdateJoinerExpirationTimer(void)
   450	{
   451	    TimeMilli now         = TimerMilli::GetNow();
   452	    uint32_t  nextTimeout = TimeMilli::kMaxDuration;
   453	
   454	    // Check if timer should be set for next Joiner.
   455	    for (Joiner *joiner = &mJoiners[0]; joiner < OT_ARRAY_END(mJoiners); joiner++)
   456	    {
   457	        uint32_t diff;
   458	
   459	        if (!joiner->mValid)
   460	        {
   461	            continue;
   462	        }
   463	
   464	        if (now >= joiner->mExpirationTime)
   465	        {
   466	            nextTimeout = 0;
   467	            break;
   468	        }
   469	
   470	        diff = joiner->mExpirationTime - now;
   471	
   472	        if (diff < nextTimeout)
   473	        {
   474	            nextTimeout = diff;
   475	        }
   476	    }
   477	
   478	    if (nextTimeout != TimeMilli::kMaxDuration)
   479	    {
   480	        // Update the timer to the timeout of the next Joiner.
   481	        mJoinerExpirationTimer.Start(nextTimeout);
   482	    }
   483	    else
   484	    {
   485	        // No Joiners, stop the timer.
   486	        mJoinerExpirationTimer.Stop();
   487	    }
   488	}
