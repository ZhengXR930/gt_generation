   329	    {
   330	        if (!joiner->mValid)
   331	        {
   332	            continue;
   333	        }
   334	
   335	        if (aEui64 != NULL)
   336	        {
   337	            if (joiner->mEui64 != *aEui64)
   338	            {
   339	                continue;
   340	            }
   341	        }
   342	        else if (!joiner->mAny)
   343	        {
   344	            continue;
   345	        }
   346	
   347	        if (aDelay > 0)
   348	        {
   349	            TimeMilli now = TimerMilli::GetNow();
   350	
   351	            if ((joiner->mExpirationTime > now) && (joiner->mExpirationTime - now > Time::SecToMsec(aDelay)))
   352	            {
   353	                joiner->mExpirationTime = now + Time::SecToMsec(aDelay);
   354	                UpdateJoinerExpirationTimer();
   355	            }
   356	        }
   357	        else
   358	        {
   359	            Mac::ExtAddress joinerId;
   360	
   361	            joiner->mValid = false;
   362	            UpdateJoinerExpirationTimer();
   363	            SendCommissionerSet();
   364	
   365	            otLogInfoMeshCoP("Removed Joiner (%s)", (aEui64 != NULL) ? aEui64->ToString().AsCString() : "*");
   366	
   367	            ComputeJoinerId(joiner->mEui64, joinerId);
   368	            SignalJoinerEvent(OT_COMMISSIONER_JOINER_REMOVED, joinerId);
   369	        }
   370	
   371	        ExitNow(error = OT_ERROR_NONE);
   372	    }
   373	
   374	exit:
   375	    return error;
   376	}
