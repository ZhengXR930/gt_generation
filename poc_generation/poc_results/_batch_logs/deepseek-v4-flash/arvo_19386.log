   294	otError Commissioner::GetNextJoinerInfo(uint16_t &aIterator, otJoinerInfo &aJoiner) const
   295	{
   296	    otError error = OT_ERROR_NONE;
   297	    size_t  index;
   298	
   299	    for (index = aIterator; index < OT_ARRAY_LENGTH(mJoiners); index++)
   300	    {
   301	        if (!mJoiners[index].mValid)
   302	        {
   303	            continue;
   304	        }
   305	
   306	        memset(&aJoiner, 0, sizeof(aJoiner));
   307	
   308	        aJoiner.mAny   = mJoiners[index].mAny;
   309	        aJoiner.mEui64 = mJoiners[index].mEui64;
   310	        strlcpy(aJoiner.mPsk, mJoiners[index].mPsk, sizeof(aJoiner.mPsk));
   311	        aJoiner.mExpirationTime = mJoiners[index].mExpirationTime - TimerMilli::GetNow();
   312	        aIterator               = static_cast<uint16_t>(index) + 1;
   313	        ExitNow();
   314	    }
   315	
   316	    error = OT_ERROR_NOT_FOUND;
   317	
   318	exit:
   319	    return error;
   320	}
