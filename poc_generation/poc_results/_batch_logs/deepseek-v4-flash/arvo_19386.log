   254	                    }
   255	
   256	                    mFrameHandler(mContext, error);
   257	                }
   258	
   259	                mDecodedLength = 0;
   260	                mFcs           = kInitFcs;
   261	                break;
   262	
   263	            default:
   264	                if (mWritePointer.CanWrite(sizeof(uint8_t)))
   265	                {
   266	                    mFcs = UpdateFcs(mFcs, byte);
   267	                    mWritePointer.WriteByte(byte);
   268	                    mDecodedLength++;
   269	                }
   270	                else
   271	                {
   272	                    mFrameHandler(mContext, OT_ERROR_NO_BUFS);
   273	                    mState = kStateNoSync;
   274	                }
   275	
   276	                break;
   277	            }
   278	
   279	            break;
   280	
   281	        case kStateEscaped:
   282	            if (mWritePointer.CanWrite(sizeof(uint8_t)))
