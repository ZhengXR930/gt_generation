   193	otError Commissioner::SendCommissionerSet(void)
   194	{
   195	    otError                error;
   196	    otCommissioningDataset dataset;
   197	    SteeringDataTlv        steeringData;
   198	    Mac::ExtAddress        joinerId;
   199	
   200	    VerifyOrExit(mState == OT_COMMISSIONER_STATE_ACTIVE, error = OT_ERROR_INVALID_STATE);
   201	
   202	    memset(&dataset, 0, sizeof(dataset));
   203	
   204	    // session id
   205	    dataset.mSessionId      = mSessionId;
   206	    dataset.mIsSessionIdSet = true;
   207	
   208	    // compute bloom filter
   209	    steeringData.Init();
   210	    steeringData.Clear();
   211	
   212	    for (Joiner *joiner = &mJoiners[0]; joiner < OT_ARRAY_END(mJoiners); joiner++)
   213	    {
   214	        if (!joiner->mValid)
   215	        {
   216	            continue;
   217	        }
   218	
   219	        if (joiner->mAny)
   220	        {
   221	            steeringData.SetLength(1);
   222	            steeringData.Set();
   223	            break;
   224	        }
   225	
   226	        ComputeJoinerId(joiner->mEui64, joinerId);
   227	        steeringData.ComputeBloomFilter(joinerId);
   228	    }
   229	
   230	    // set bloom filter
   231	    dataset.mSteeringData.mLength = steeringData.GetSteeringDataLength();
   232	    memcpy(dataset.mSteeringData.m8, steeringData.GetValue(), dataset.mSteeringData.mLength);
   233	    dataset.mIsSteeringDataSet = true;
