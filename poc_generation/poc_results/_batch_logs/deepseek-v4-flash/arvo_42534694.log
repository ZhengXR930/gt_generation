fu_coswid_firmware_payload_free(FuCoswidFirmwarePayload *payload)
{
        g_ptr_array_unref(payload->hashes);
        g_free(payload->name);
        g_free(payload);
}

G_DEFINE_AUTOPTR_CLEANUP_FUNC(FuCoswidFirmwarePayload, fu_coswid_firmware_payload_free)

