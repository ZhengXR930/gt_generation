                                g_prefix_error(error, "failed to parse payload name: ");
                                return FALSE;
                        }
                } else if (tag_id == FU_COSWID_TAG_SIZE) {
                        if (!fu_coswid_read_u64(pairs[i].value, &payload->size, error))
                                return FALSE;
                } else if (tag_id == FU_COSWID_TAG_HASH) {
