   228	 * @oid: holds an Object Identifier in a null terminated string
   229	 *
   230	 * This function will inform about known DN OIDs. This is useful since
   231	 * functions like gnutls_x509_crt_set_dn_by_oid() use the information
   232	 * on known OIDs to properly encode their input. Object Identifiers
   233	 * that are not known are not encoded by these functions, and their
   234	 * input is stored directly into the ASN.1 structure. In that case of
   235	 * unknown OIDs, you have the responsibility of DER encoding your
   236	 * data.
   237	 *
   238	 * Returns: 1 on known OIDs and 0 otherwise.
   239	 **/
   240	int gnutls_x509_dn_oid_known(const char *oid)
   241	{
   242	        unsigned int i = 0;
   243	        unsigned len = strlen(oid);
   244	
   245	        do {
   246	                if (len == _oid2str[i].oid_size &&
   247	                        strcmp(_oid2str[i].oid, oid) == 0)
   248	                        return 1;
   249	                i++;
   250	        }
   251	        while (_oid2str[i].oid != NULL);
   252	
   253	        return 0;
   254	}
