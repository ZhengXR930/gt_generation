   256	/**
   257	 * gnutls_x509_dn_oid_name:
   258	 * @oid: holds an Object Identifier in a null terminated string
   259	 * @flags: 0 or GNUTLS_X509_DN_OID_*
   260	 *
   261	 * This function will return the name of a known DN OID. If
   262	 * %GNUTLS_X509_DN_OID_RETURN_OID is specified this function
   263	 * will return the given OID if no descriptive name has been
   264	 * found.
   265	 *
   266	 * Returns: A null terminated string or NULL otherwise.
   267	 *
   268	 * Since: 3.0
   269	 **/
   270	const char *gnutls_x509_dn_oid_name(const char *oid, unsigned int flags)
   271	{
   272	        unsigned int i = 0;
   273	        unsigned len = strlen(oid);
   274	
   275	        do {
   276	                if ((_oid2str[i].oid_size == len) && 
   277	                        strcmp(_oid2str[i].oid, oid) == 0 && _oid2str[i].ldap_desc != NULL)
   278	                        return _oid2str[i].ldap_desc;
   279	                i++;
   280	        }
   281	        while (_oid2str[i].oid != NULL);
   282	
   283	        if (flags & GNUTLS_X509_DN_OID_RETURN_OID)
   284	                return oid;
   285	        else
   286	                return NULL;
   287	}
