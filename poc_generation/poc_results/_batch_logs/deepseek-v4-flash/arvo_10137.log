   344	static int
   345	decode_complex_string(const struct oid_to_string *oentry, void *value,
   346	                      int value_size, gnutls_datum_t * out)
   347	{
   348	        char str[MAX_STRING_LEN], tmpname[128];
   349	        int len = -1, result;
   350	        ASN1_TYPE tmpasn = ASN1_TYPE_EMPTY;
   351	        char asn1_err[ASN1_MAX_ERROR_DESCRIPTION_SIZE] = "";
   352	        unsigned int etype;
   353	        gnutls_datum_t td = {NULL, 0};
   354	
   355	        if (oentry->asn_desc == NULL) {
   356	                gnutls_assert();
   357	                return GNUTLS_E_INTERNAL_ERROR;
   358	        }
   359	
   360	        if ((result =
   361	             asn1_create_element(_gnutls_get_pkix(), oentry->asn_desc,
   362	                                 &tmpasn)) != ASN1_SUCCESS) {
   363	                gnutls_assert();
   364	                return _gnutls_asn2err(result);
   365	        }
   366	
   367	        if ((result =
   368	             _asn1_strict_der_decode(&tmpasn, value, value_size,
   369	                               asn1_err)) != ASN1_SUCCESS) {
   370	                gnutls_assert();
   371	                _gnutls_debug_log("_asn1_strict_der_decode: %s\n", asn1_err);
   372	                asn1_delete_structure(&tmpasn);
   373	                return _gnutls_asn2err(result);
   374	        }
   375	
   376	        /* Read the type of choice.
   377	         */
   378	        len = sizeof(str) - 1;
   379	        if ((result = asn1_read_value(tmpasn, "", str, &len)) != ASN1_SUCCESS) {        /* CHOICE */
   380	                gnutls_assert();
   381	                asn1_delete_structure(&tmpasn);
   382	                return _gnutls_asn2err(result);
   383	        }
   384	
   385	        str[len] = 0;
   386	
   387	        /* We set the etype on the strings that may need
   388	         * some conversion to UTF-8. The INVALID flag indicates
   389	         * no conversion needed */
   390	        if (strcmp(str, "teletexString") == 0)
   391	                etype = ASN1_ETYPE_TELETEX_STRING;
   392	        else if (strcmp(str, "bmpString") == 0)
   393	                etype = ASN1_ETYPE_BMP_STRING;
   394	        else if (strcmp(str, "universalString") == 0)
   395	                etype = ASN1_ETYPE_UNIVERSAL_STRING;
   396	        else
   397	                etype = ASN1_ETYPE_INVALID;
   398	
   399	        _gnutls_str_cpy(tmpname, sizeof(tmpname), str);
   400	
   401	        result = _gnutls_x509_read_value(tmpasn, tmpname, &td);
   402	        asn1_delete_structure(&tmpasn);
   403	        if (result < 0)
   404	                return gnutls_assert_val(result);
   405	
   406	        if (etype != ASN1_ETYPE_INVALID) {
   407	                result = make_printable_string(etype, &td, out);
   408	
   409	                _gnutls_free_datum(&td);
   410	
   411	                if (result < 0)
   412	                        return gnutls_assert_val(result);
   413	        } else {
   414	                out->data = td.data;
   415	                out->size = td.size;
   416	                /* _gnutls_x509_read_value always null terminates */
   417	        }
   418	
   419	        assert(out->data != NULL);
   420	
   421	        /* Refuse to deal with strings containing NULs. */
   422	        if (strlen((void *) out->data) != (size_t) out->size) {
   423	                _gnutls_free_datum(out);
   424	                return gnutls_assert_val(GNUTLS_E_ASN1_EMBEDDED_NULL_IN_STRING);
   425	        }
   426	
   427	        return 0;
   428	}
