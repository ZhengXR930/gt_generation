   431	/* This function will convert an attribute value, specified by the OID,
   432	 * to a string. The result will be a null terminated string.
   433	 *
   434	 * res may be null. This will just return the res_size, needed to
   435	 * hold the string.
   436	 */
   437	int
   438	_gnutls_x509_dn_to_string(const char *oid, void *value,
   439	                          int value_size, gnutls_datum_t * str)
   440	{
   441	        const struct oid_to_string *oentry;
   442	        int ret;
   443	        gnutls_datum_t tmp;
   444	
   445	        if (value == NULL || value_size <= 0) {
   446	                gnutls_assert();
   447	                return GNUTLS_E_INVALID_REQUEST;
   448	        }
   449	
   450	        oentry = get_oid_entry(oid);
   451	        if (oentry == NULL) {   /* unknown OID -> hex */
   452	 unknown_oid:
   453	                ret = data2hex(value, value_size, str);
   454	                if (ret < 0) {
   455	                        gnutls_assert();
   456	                        return ret;
   457	                }
   458	                return 0;
   459	        }
   460	
   461	        if (oentry->asn_desc != NULL) { /* complex */
   462	                ret =
   463	                    decode_complex_string(oentry, value, value_size, &tmp);
   464	                if (ret < 0) {
   465	                        /* we failed decoding -> handle it as unknown OID */
   466	                        goto unknown_oid;
   467	                }
   468	        } else {
   469	                ret =
   470	                    _gnutls_x509_decode_string(oentry->etype, value,
   471	                                               value_size, &tmp, 0);
   472	                if (ret < 0) {
   473	                        /* we failed decoding -> handle it as unknown OID */
   474	                        goto unknown_oid;
   475	                }
   476	        }
   477	
   478	        ret = str_escape(&tmp, str);
   479	        _gnutls_free_datum(&tmp);
   480	
   481	        if (ret < 0)
   482	                return gnutls_assert_val(ret);
   483	
   484	        return 0;
   485	}
