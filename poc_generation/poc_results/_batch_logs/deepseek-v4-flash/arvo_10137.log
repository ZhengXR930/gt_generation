    37	static void change_u16_endianness(uint8_t *dst, const uint8_t *src, unsigned size, unsigned be)
    38	{
    39	        unsigned convert = 0;
    40	        unsigned i;
    41	        uint8_t tmp;
    42	
    43	#ifdef WORDS_BIGENDIAN
    44	        if (!be)
    45	                convert = 1;
    46	#else
    47	        if (be)
    48	                convert = 1;
    49	#endif
    50	
    51	        /* convert to LE */
    52	        if (convert) {
    53	                for (i = 0; i < size; i += 2) {
    54	                        tmp = src[i];
    55	                        dst[i] = src[1 + i];
    56	                        dst[1 + i] = tmp;
    57	                }
    58	        } else {
    59	                if (dst != src)
    60	                        memcpy(dst, src, size);
    61	        }
    62	}
