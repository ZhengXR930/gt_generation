   487	/* Converts a data string to an LDAP rfc2253 hex string
   488	 * something like '#01020304'
   489	 */
   490	static int
   491	data2hex(const void *data, size_t data_size,
   492	         gnutls_datum_t *out)
   493	{
   494	        gnutls_datum_t tmp, td;
   495	        int ret;
   496	        size_t size;
   497	
   498	        td.size = hex_str_size(data_size) + 1; /* +1 for '#' */
   499	        td.data = gnutls_malloc(td.size);
   500	        if (td.data == NULL)
   501	                return gnutls_assert_val(GNUTLS_E_MEMORY_ERROR);
   502	
   503	        tmp.data = (void*)data;
   504	        tmp.size = data_size;
   505	
   506	        td.data[0] = '#';
   507	        size = td.size-1; /* don't include '#' */
   508	        ret =
   509	            gnutls_hex_encode(&tmp,
   510	                            (char*)&td.data[1], &size);
   511	        if (ret < 0) {
   512	                gnutls_assert();
   513	                gnutls_free(td.data);
   514	                return GNUTLS_E_SHORT_MEMORY_BUFFER;
   515	        }
   516	
   517	        td.size--; /* don't include null */
   518	
   519	        out->data = td.data;
   520	        out->size = td.size;
   521	
   522	        return 0;
   523	}
