   289	static int
   290	make_printable_string(unsigned etype, const gnutls_datum_t * input,
   291	                      gnutls_datum_t * out)
   292	{
   293	        int printable = 0;
   294	        int ret;
   295	
   296	        /* empty input strings result to a null string */
   297	        if (input->data == NULL || input->size == 0) {
   298	                out->data = gnutls_calloc(1, 1);
   299	                if (out->data == NULL)
   300	                        return gnutls_assert_val(GNUTLS_E_MEMORY_ERROR);
   301	                out->size = 0;
   302	                return 0;
   303	        }
   304	
   305	        if (etype == ASN1_ETYPE_BMP_STRING) {
   306	                ret = _gnutls_ucs2_to_utf8(input->data, input->size, out, 1);
   307	                if (ret < 0) {
   308	                        /* could not convert. Handle it as non-printable */
   309	                        printable = 0;
   310	                } else
   311	                        printable = 1;
   312	        } else if (etype == ASN1_ETYPE_TELETEX_STRING) {
   313	                /* HACK: if the teletex string contains only ascii
   314	                 * characters then treat it as printable.
   315	                 */
   316	                if (_gnutls_str_is_print((char*)input->data, input->size)) {
   317	                        out->data = gnutls_malloc(input->size + 1);
   318	                        if (out->data == NULL)
   319	                                return
   320	                                    gnutls_assert_val
   321	                                    (GNUTLS_E_MEMORY_ERROR);
   322	
   323	                        memcpy(out->data, input->data, input->size);
   324	                        out->size = input->size;
   325	
   326	                        out->data[out->size] = 0;
   327	
   328	                        printable = 1;
   329	                }
   330	        } else if (etype != ASN1_ETYPE_UNIVERSAL_STRING)        /* supported but not printable */
   331	                return GNUTLS_E_INVALID_REQUEST;
   332	
   333	        if (printable == 0) {   /* need to allocate out */
   334	                ret = data2hex(input->data, input->size, out);
   335	                if (ret < 0) {
   336	                        gnutls_assert();
   337	                        return ret;
   338	                }
   339	        }
   340	
   341	        return 0;
   342	}
