   179	static int str_escape(const gnutls_datum_t * str, gnutls_datum_t * escaped)
   180	{
   181	        unsigned int j, i;
   182	        uint8_t *buffer = NULL;
   183	        int ret;
   184	
   185	        if (str == NULL)
   186	                return gnutls_assert_val(GNUTLS_E_INVALID_REQUEST);
   187	
   188	        /* the string will be at most twice the original */
   189	        buffer = gnutls_malloc(str->size * 2 + 2);
   190	        if (buffer == NULL)
   191	                return gnutls_assert_val(GNUTLS_E_MEMORY_ERROR);
   192	
   193	        for (i = j = 0; i < str->size; i++) {
   194	                if (str->data[i] == 0) {
   195	                        /* this is handled earlier */
   196	                        ret = gnutls_assert_val(GNUTLS_E_ASN1_DER_ERROR);
   197	                        goto cleanup;
   198	                }
   199	
   200	                if (str->data[i] == ',' || str->data[i] == '+'
   201	                    || str->data[i] == '"' || str->data[i] == '\\'
   202	                    || str->data[i] == '<' || str->data[i] == '>'
   203	                    || str->data[i] == ';' || str->data[i] == 0)
