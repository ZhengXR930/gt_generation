   206	                        buffer[j++] = '\\';
   207	                else if (i == 0 && str->data[i] == ' ')
   208	                        buffer[j++] = '\\';
   209	                else if (i == (str->size - 1) && str->data[i] == ' ')
   210	                        buffer[j++] = '\\';
   211	
   212	                buffer[j++] = str->data[i];
   213	        }
   214	
   215	        /* null terminate the string */
   216	        buffer[j] = 0;
