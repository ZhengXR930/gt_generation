H3Error H3_EXPORT(vertexToLatLng)(H3Index vertex, LatLng *coord) {
    // Get the vertex number and owner from the vertex
    int vertexNum = H3_GET_RESERVED_BITS(vertex);
    H3Index owner = vertex;
