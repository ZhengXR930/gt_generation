static uint32_t geostar_checksum(const uint8_t *data, size_t len)
{
    uint32_t cs = 0;
    for (size_t i = 0; i + 3 < len; i += 4) {
        uint32_t word = (uint32_t)data[i] |
                       ((uint32_t)data[i+1] << 8) |
                       ((uint32_t)data[i+2] << 16) |
                       ((uint32_t)data[i+3] << 24);
        cs ^= word;
    }
    return cs;
}
```

