   354	
   355	bool SplashRadialPattern::getParameter(double xs, double ys, double *t) {
   356	  double b, c, s0, s1;
   357	
   358	  // We want to solve this system of equations:
   359	  //
   360	  // 1. (x - xc(s))^2 + (y -yc(s))^2 = rc(s)^2
   361	  // 2. xc(s) = x0 + s * (x1 - xo)
   362	  // 3. yc(s) = y0 + s * (y1 - yo)
   363	  // 4. rc(s) = r0 + s * (r1 - ro)
   364	  //
   365	  // To simplify the system a little, we translate
   366	  // our coordinates to have the origin in (x0,y0)
   367	
   368	  xs -= x0;
   369	  ys -= y0;
   370	
   371	  // Then we have to solve the equation:
   372	  //   A*s^2 - 2*B*s + C = 0
   373	  // where
   374	  //   A = dx^2  + dy^2  - dr^2
   375	  //   B = xs*dx + ys*dy + r0*dr
   376	  //   C = xs^2  + ys^2  - r0^2
   377	
   378	  b = xs*dx + ys*dy + r0*dr;
   379	  c = xs*xs + ys*ys - r0*r0;
   380	
   381	  if (fabs(a) <= RADIAL_EPSILON) {
   382	    // A is 0, thus the equation simplifies to:
   383	    //   -2*B*s + C = 0
   384	    // If B is 0, we can either have no solution or an indeterminate
   385	    // equation, thus we behave as if we had an invalid solution
   386	    if (fabs(b) <= RADIAL_EPSILON)
   387	      return false;
   388	
   389	    s0 = s1 = 0.5 * c / b;
   390	  } else {
   391	    double d;
   392	
   393	    d = b*b - a*c;
   394	    if (d < 0)
   395	      return false;
   396	
   397	    d = sqrt (d);
   398	    s0 = b + d;
   399	    s1 = b - d;
   400	
   401	    // If A < 0, one of the two solutions will have negative radius,
   402	    // thus it will be ignored. Otherwise we know that s1 <= s0
   403	    // (because d >=0 implies b - d <= b + d), so if both are valid it
   404	    // will be the true solution.
   405	    s0 *= inva;
   406	    s1 *= inva;
   407	  }
   408	
   409	  if (r0 + s0 * dr >= 0) {
   410	    if (0 <= s0 && s0 <= 1) {
   411	      *t = t0 + dt * s0;
   412	      return true;
   413	    } else if (s0 < 0 && shading->getExtend0()) {
   414	      *t = t0;
   415	      return true;
   416	    } else if (s0 > 1 && shading->getExtend1()) {
   417	      *t = t1;
   418	      return true;
   419	    }
   420	  }
   421	
   422	  if (r0 + s1 * dr >= 0) {
   423	    if (0 <= s1 && s1 <= 1) {
   424	      *t = t0 + dt * s1;
   425	      return true;
   426	    } else if (s1 < 0 && shading->getExtend0()) {
   427	      *t = t0;
   428	      return true;
   429	    } else if (s1 > 1 && shading->getExtend1()) {
   430	      *t = t1;
   431	      return true;
   432	    }
   433	  }
   434	
   435	  return false;
   436	}
   437	
   438	#undef RADIAL_EPSILON
