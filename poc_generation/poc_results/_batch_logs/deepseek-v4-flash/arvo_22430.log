   255	  gfxMode = shadingA->getColorSpace()->getMode();
   256	  shadingA->getColorSpace()->getDefaultColor(&srcColor);
   257	  shadingA->getDomain(&xMin, &yMin, &xMax, &yMax);
   258	  convertGfxColor(defaultColor, colorModeA, shadingA->getColorSpace(), &srcColor);
