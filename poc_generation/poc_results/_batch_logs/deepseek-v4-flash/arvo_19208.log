                        r= SC_ERROR_OUT_OF_MEMORY;
                        goto cleanup;
                }
                priv->token_name_length = sizeof("COOLKEY")-1;
        }
        card->drv_data = priv;
        return SC_SUCCESS;

cleanup:
        if (priv) {
                coolkey_free_private_data(priv);
        }
        return r;
}


