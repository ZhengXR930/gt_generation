    uint64_t size_{};
    uint64_t remaining_size_{};

   public:
    explicit HeaderReader(BasicIo::UniquePtr& io);

    [[nodiscard]] uint64_t getSize() const {
      return size_;
    }

    [[nodiscard]] uint64_t getRemainingSize() const {
      return remaining_size_;
    }

    [[nodiscard]] DataBuf& getId() {
      return IdBuf_;
    }
  };

