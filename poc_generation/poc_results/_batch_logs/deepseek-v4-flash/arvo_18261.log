#ifndef MDNSD_H_
#define MDNSD_H_

#ifdef __cplusplus
extern "C" {
#endif

#include "mdnsd_config.h"
#include "1035.h"
#if !defined(__bool_true_false_are_defined) && defined(_MSC_VER) && _MSC_VER < 1600
// VS 2008 has no stdbool.h
