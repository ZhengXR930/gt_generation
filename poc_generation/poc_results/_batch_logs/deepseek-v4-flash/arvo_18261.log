   236	
   237	        if (name == 0)
   238	                return 0;
   239	
   240	        /* Make our label */
   241	        while (name[y]) {
   242	                if (name[y] == '.') {
   243	                        if (!name[y + 1])
   244	                                break;
   245	                        label[last] = (char)(x - (last + 1));
   246	                        last = x;
   247	                } else {
   248	                        label[x] = name[y];
   249	                }
   250	
   251	                if (x++ == 255)
   252	                        return 0;
   253	
   254	                y++;
   255	        }
   256	
   257	        label[last] = (char)(x - (last + 1));
   258	        if (x == 1)
