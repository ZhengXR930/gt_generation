   260	        len = x + 1;
   261	        label[x] = 0;           /* Always terminate w/ a 0 */
   262	
   263	        /* Double-loop checking each label against all m->_labels for match */
   264	        for (x = 0; label[x]; x += label[x] + 1) {
   265	                for (y = 0; y < MAX_NUM_LABELS && m->_labels[y]; y++) {
   266	                        if (_lmatch(m, label + x, m->_labels[y])) {
