   527	static void _rrappend(struct message *m, char *name, unsigned short int type, unsigned short int clazz, unsigned long ttl)
   528	{
   529	        if (m->_buf == 0) {
   530	        m->_buf = m->_packet + 12;
   531	        m->_bufEnd = m->_packet + sizeof(m->_packet);
   532	    }
   533	        _host(m, &(m->_buf), name);
   534	        short2net(type, &(m->_buf));
   535	        short2net(clazz, &(m->_buf));
   536	        long2net((uint32_t)ttl, &(m->_buf));
   537	}
