   196	/* Internal label matching */
   197	static int _lmatch(struct message *m, const char *l1, const char *l2)
   198	{
   199	        int len;
   200	
   201	        /* Always ensure we get called w/o a pointer */
   202	        if (*l1 & 0xc0)
   203	                return _lmatch(m, (char*)m->_buf + _ldecomp((const unsigned char*)l1), l2);
   204	        if (*l2 & 0xc0)
   205	                return _lmatch(m, l1, (char*)m->_buf + _ldecomp((const unsigned char*) l2));
   206	
   207	        /* Same already? */
   208	        if (l1 == l2)
   209	                return 1;
   210	
   211	        /* Compare all label characters */
   212	        if (*l1 != *l2)
   213	                return 0;
   214	        for (len = 1; len <= *l1; len++) {
   215	                if (l1[len] != l2[len])
   216	                        return 0;
   217	        }
   218	
   219	        /* Get new labels */
   220	        l1 += *l1 + 1;
   221	        l2 += *l2 + 1;
   222	
   223	        /* At the end, all matched */
   224	        if (*l1 == 0 && *l2 == 0)
   225	                return 1;
   226	
   227	        /* Try next labels */
   228	        return _lmatch(m, l1, l2);
   229	}
