/* Make sure not already on the list, then insert */
static void _r_push(mdns_record_t **list, mdns_record_t *r)
{
        mdns_record_t *cur;

        for (cur = *list; cur != 0; cur = cur->list) {
                if (cur == r)
                        return;
        }

        r->list = *list;
        *list = r;
}

