   515	void message_qd(struct message *m, char *name, unsigned short int type, unsigned short int clazz)
   516	{
   517	        m->qdcount++;
   518	    if (m->_buf == 0) {
   519	        m->_buf = m->_packet + 12;
   520	        m->_bufEnd = m->_packet + sizeof(m->_packet);
   521	    }
   522	        _host(m, &(m->_buf), name);
   523	        short2net(type, &(m->_buf));
   524	        short2net(clazz, &(m->_buf));
   525	}
