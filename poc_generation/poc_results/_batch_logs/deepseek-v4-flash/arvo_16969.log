    if (curroff < 0) return curroff;

    os = gp_fseek(f, offset, 0);
    if (os < 0) return os;

    c = gp_fread(buf, 1, count, f);
    if (c < 0) return c;

    os = gp_fseek(f, curroff, 0);
    if (os < 0) return os;

    return c;
}

