#include <cstring>

#include "demangle.h"

extern "C" int LLVMFuzzerTestOneInput(const unsigned char *Data,
                                      unsigned Size) {
  if (Size >= 4095) {
    return 0;
  }
  char Buffer[Size + 1];
  std::memcpy(Buffer, Data, Size);
  Buffer[Size] = 0;
  char demangled[4096];
  google::Demangle(Buffer, demangled, Size);
  return 0;
}
