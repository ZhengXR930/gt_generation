        foreign_class->priority = 50;

        load_class->get_flags_filename =
                vips_foreign_load_jpeg_get_flags_filename;
        load_class->get_flags = vips_foreign_load_jpeg_get_flags;
        load_class->header = vips_foreign_load_jpeg_header;
