    case MULTICHAR_CONSTANT_LARGE('H','T','T','P','/','1','.','0'):
        request->flags |= REQUEST_IS_HTTP_1_0;
        break;
    case MULTICHAR_CONSTANT_
[... Observation truncated due to length ...]
value + helper->buffer->len;
