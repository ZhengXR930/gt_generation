    printf("Input hex: ");
    for (int i = 0; buf[i]; i++) printf("%02x ", (unsigned char)buf[i]);
    printf("\n");
    
    int ret = url_decode(buf);
    printf("Return: %d\n", ret);
    if (ret >= 0) printf("Output: %s\n", buf);
    return 0;
}
