+    CASIC_CFG = 0x06,     // Configuration requests
+    CASIC_MSG = 0x08,     // Satellite information
+    CASIC_MON = 0x0a,     // System monitoring
+    CASIC_AID = 0x0b,     // AGPS
+} casic_classes_t;
