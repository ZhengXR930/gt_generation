int main(int argc, char** argv) {
    QCoreApplication app(argc, argv);

    if (argc < 2) {
        std::cerr << "Usage: " << argv[0] << " <poc_file>" << std::endl;
        return 1;
    }

    QFile file(argv[1]);
    if (!file.open(QIODevice::ReadOnly)) {
        std::cerr << "Failed to open file" << std::endl;
        return 1;
    }
    QByteArray data = file.readAll();
    file.close();

    std::cerr << "File size: " << data.size() << std::endl;
    std::cerr << "Magic: " << data.left(7).toHex().toStdString() << std::endl;

    QBuffer buffer;
    buffer.setData(data);

    KAr ar(&buffer);
    bool result = ar.open(QIODevice::ReadOnly);
    std::cerr << "open result: " << (result ? "true" : "false") << std::endl;
    if (!result) {
        std::cerr << "Error: " << ar.errorString().toStdString() << std::endl;
    }
    ar.close();

    return 0;
}
EOF


