                aiNumMeshesPerPType[3], ((mConfigRemoveMeshes & aiPrimitiveType_POLYGON) ? "X" : ""));
        ASSIMP_LOG_INFO(buffer);
        ASSIMP_LOG_DEBUG("SortByPTypeProcess finished");
    }
}
