static void *lex_string(struct lexer *lexer)
{
    int chr;

    do {
        chr = next(lexer);

        if (chr == '$' && peek(lexer) == '{') {
            backup(lexer);
            emit(lexer, LEXEME_STRING);

            advance_n(lexer, strlen("{"));

            return lex_variable;
        }
    } while (isstring(chr));

    backup(lexer);
    emit(lexer, LEXEME_STRING);

    return lex_config;
}

static void *lex_error(struct lexer *lexer, const char *msg)
{
    struct lexeme lexeme = {
        .type = LEXEME_ERROR,
        .value = {
            .value = msg,
            .len = strlen(msg)
        }
    };

    emit_lexeme(lexer, &lexeme);

    return NULL;
