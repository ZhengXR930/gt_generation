   410	len_multiply_cmp(OnigLen x, int y, OnigLen v)
   411	{
   412	  if (x == 0 || y == 0) return -1;
   413	
   414	  if (x < INFINITE_LEN / y) {
   415	    OnigLen xy = x * (OnigLen )y;
   416	    if (xy > v) return 1;
   417	    else {
   418	      if (xy == v) return 0;
   419	      else return -1;
   420	    }
