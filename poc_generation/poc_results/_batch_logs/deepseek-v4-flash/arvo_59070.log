static inline void
Classifier_destroy (Classifier* p)
{
    if (p->_suffix && !p->_stringStatic) internal_exr_free (EXR_CONST_CAST (void *,p->_suffix));
}

static exr_result_t
Classifier_read (Classifier* out, const uint8_t** ptr, size_t* size)
{
