/* Single hex char to int; -1 if not a hex char. */
private int
hextoint(int c)
{
        if (!isascii(CAST(unsigned char, c)))
                return -1;
        if (isdigit(CAST(unsigned char, c)))
                return c - '0';
        if ((c >= 'a') && (c <= 'f'))
                return c + 10 - 'a';
        if (( c>= 'A') && (c <= 'F'))
                return c + 10 - 'A';
        return -1;
}


/*
