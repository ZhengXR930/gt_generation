protected void
file_showstr(FILE *fp, const char *s, size_t len)
{
        char    c;

        for (;;) {
                if (len == FILE_BADSIZE) {
                        c = *s++;
                        if (c == '\0')
                                break;
                }
                else  {
                        if (len-- == 0)
                                break;
                        c = *s++;
                }
                if (c >= 040 && c <= 0176)      /* TODO isprint && !iscntrl */
                        (void) fputc(c, fp);
                else {
                        (void) fputc('\\', fp);
                        switch (c) {
                        case '\a':
                                (void) fputc('a', fp);
                                break;

                        case '\b':
                                (void) fputc('b', fp);
                                break;

                        case '\f':
                                (void) fputc('f', fp);
                                break;

                        case '\n':
                                (void) fputc('n', fp);
                                break;

                        case '\r':
                                (void) fputc('r', fp);
                                break;

                        case '\t':
                                (void) fputc('t', fp);
                                break;

                        case '\v':
                                (void) fputc('v', fp);
                                break;

                        default:
                                (void) fprintf(fp, "%.3o", c & 0377);
                                break;
                        }
                }
        }
}

