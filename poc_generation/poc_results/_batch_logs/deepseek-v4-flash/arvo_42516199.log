                file_magwarn(ms, "Printf format is %s for type "
                    "`%s' in description `%s'", estr,
                    file_names[m->type], m->desc);
                return -1;
        }

        for (; *ptr; ptr++) {
                if (*ptr == '%') {
                        file_magwarn(ms,
                            "Too many format strings (should have at most one) "
                            "for `%s' with description `%s'",
                            file_names[m->type], m->desc);
                        return -1;
                }
        }
        return 0;
}

