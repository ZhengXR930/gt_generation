                size = 0;
                while (1) {
                        u32 tmp = gf_bs_read_int(bs, 8);
                        size += tmp;
                        if (tmp!=255) break;
                }
                if (gf_bs_available(bs) < size) {
                        gf_bs_seek(bs, pos-3);
                        return GF_FALSE;
                }

                if (nb_bytes) {
                        *nb_bytes = (u32) size;
                }

                if (buffer) {
                        gf_bs_read_data(bs, (char *) buffer, size);
                } else {
