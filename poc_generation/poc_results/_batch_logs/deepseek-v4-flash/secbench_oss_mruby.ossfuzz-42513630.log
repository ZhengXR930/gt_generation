    90	static codegen_scope* scope_new(mrb_state *mrb, codegen_scope *prev, node *lv);
    91	static void scope_finish(codegen_scope *s);
    92	static struct loopinfo *loop_push(codegen_scope *s, enum looptype t);
    93	static void loop_break(codegen_scope *s, node *tree);
    94	static void loop_pop(codegen_scope *s, int val);
    95	
    96	/*
    97	 * The search for catch handlers starts at the end of the table in mrb_vm_run().
    98	 * Therefore, the next handler to be added must meet one of the following conditions.
    99	 * - Larger start position
   100	 * - Same start position but smaller end position
   101	 */
   102	static int catch_handler_new(codegen_scope *s);
   103	static void catch_handler_set(codegen_scope *s, int ent, enum mrb_catch_type type, uint32_t begin, uint32_t end, uint32_t target);
   104	
   105	static void gen_assignment(codegen_scope *s, node *tree, node *rhs, int sp, int val);
   106	static void gen_massignment(codegen_scope *s, node *tree, int sp, int val);
   107	
   108	static void codegen(codegen_scope *s, node *tree, int val);
   109	static void raise_error(codegen_scope *s, const char *msg);
   110	
   111	static void
   112	codegen_error(codegen_scope *s, const char *message)
   113	{
   114	  if (!s) return;
   115	#ifndef MRB_NO_STDIO
   116	  if (s->filename_sym && s->lineno) {
   117	    const char *filename = mrb_sym_name_len(s->mrb, s->filename_sym, NULL);
   118	    fprintf(stderr, "%s:%d: %s\n", filename, s->lineno, message);
   119	  }
   120	  else {
   121	    fprintf(stderr, "%s\n", message);
   122	  }
   123	#endif
   124	  while (s->prev) {
   125	    codegen_scope *tmp = s->prev;
   126	    if (s->irep) {
   127	      mrb_free(s->mrb, s->iseq);
   128	      for (int i=0; i<s->irep->plen; i++) {
   129	        mrb_pool_value *pv = &s->pool[i];
   130	        if ((pv->tt & 0x3) == IREP_TT_STR || pv->tt == IREP_TT_BIGINT) {
   131	          mrb_free(s->mrb, (void*)pv->u.str);
   132	        }
   133	      }
   134	      mrb_free(s->mrb, s->pool);
   135	      mrb_free(s->mrb, s->syms);
   136	      mrb_free(s->mrb, s->catch_table);
   137	      if (s->reps) {
   138	        /* copied from mrb_irep_free() in state.c */
   139	        for (int i=0; i<s->irep->rlen; i++) {
   140	          if (s->reps[i])
   141	            mrb_irep_decref(s->mrb, (mrb_irep*)s->reps[i]);
   142	        }
   143	        mrb_free(s->mrb, s->reps);
   144	      }
   145	      mrb_free(s->mrb, s->lines);
   146	    }
   147	    mrb_pool_close(s->mpool);
   148	    s = tmp;
   149	  }
   150	  MRB_THROW(s->mrb->jmp);
   151	}
   152	
   153	static void*
   154	codegen_palloc(codegen_scope *s, size_t len)
   155	{
   156	  void *p = mrb_pool_alloc(s->mpool, len);
   157	
   158	  if (!p) codegen_error(s, "pool memory allocation");
   159	  return p;
   160	}
   161	
   162	static void*
   163	codegen_realloc(codegen_scope *s, void *p, size_t len)
   164	{
   165	  p = mrb_realloc_simple(s->mrb, p, len);
   166	
   167	  if (!p && len > 0) codegen_error(s, "mrb_realloc");
   168	  return p;
   169	}
   170	
   171	static void
   172	check_no_ext_ops(codegen_scope *s, uint16_t a, uint16_t b)
   173	{
   174	  if (s->parser->no_ext_ops && (a | b) > 0xff) {
   175	    codegen_error(s, "need OP_EXTs instruction (currently OP_EXTs are prohibited)");
   176	  }
   177	}
   178	
   179	static int
   180	new_label(codegen_scope *s)
   181	{
   182	  return s->lastlabel = s->pc;
   183	}
   184	
   185	static void
   186	emit_B(codegen_scope *s, uint32_t pc, uint8_t i)
   187	{
   188	  if (pc >= s->icapa) {
   189	    if (pc == UINT32_MAX) {
   190	      codegen_error(s, "too big code block");
   191	    }
   192	    if (pc >= UINT32_MAX / 2) {
   193	      pc = UINT32_MAX;
   194	    }
   195	    else {
   196	      s->icapa *= 2;
   197	    }
   198	    s->iseq = (mrb_code*)codegen_realloc(s, s->iseq, sizeof(mrb_code)*s->icapa);
   199	    if (s->lines) {
   200	      s->lines = (uint16_t*)codegen_realloc(s, s->lines, sizeof(uint16_t)*s->icapa);
   201	    }
   202	  }
   203	  if (s->lines) {
   204	    if (s->lineno > 0 || pc == 0)
   205	      s->lines[pc] = s->lineno;
   206	    else
   207	      s->lines[pc] = s->lines[pc-1];
   208	  }
   209	  s->iseq[pc] = i;
   210	}
   211	
   212	static void
   213	emit_S(codegen_scope *s, int pc, uint16_t i)
   214	{
   215	  uint8_t hi = i>>8;
   216	  uint8_t lo = i&0xff;
   217	
   218	  emit_B(s, pc,   hi);
   219	  emit_B(s, pc+1, lo);
   220	}
   221	
   222	static void
   223	gen_B(codegen_scope *s, uint8_t i)
   224	{
   225	  emit_B(s, s->pc, i);
   226	  s->pc++;
   227	}
   228	
   229	static void
   230	gen_S(codegen_scope *s, uint16_t i)
   231	{
   232	  emit_S(s, s->pc, i);
   233	  s->pc += 2;
   234	}
   235	
   236	static void
   237	genop_0(codegen_scope *s, mrb_code i)
   238	{
   239	  s->lastpc = s->pc;
   240	  gen_B(s, i);
   241	}
   242	
   243	static void
   244	genop_1(codegen_scope *s, mrb_code i, uint16_t a)
   245	{
   246	  s->lastpc = s->pc;
   247	  check_no_ext_ops(s, a, 0);
   248	  if (a > 0xff) {
   249	    gen_B(s, OP_EXT1);
   250	    gen_B(s, i);
   251	    gen_S(s, a);
   252	  }
   253	  else {
   254	    gen_B(s, i);
   255	    gen_B(s, (uint8_t)a);
   256	  }
   257	}
   258	
   259	static void
   260	genop_2(codegen_scope *s, mrb_code i, uint16_t a, uint16_t b)
   261	{
   262	  s->lastpc = s->pc;
   263	  check_no_ext_ops(s, a, b);
   264	  if (a > 0xff && b > 0xff) {
   265	    gen_B(s, OP_EXT3);
   266	    gen_B(s, i);
   267	    gen_S(s, a);
   268	    gen_S(s, b);
   269	  }
   270	  else if (b > 0xff) {
   271	    gen_B(s, OP_EXT2);
   272	    gen_B(s, i);
   273	    gen_B(s, (uint8_t)a);
   274	    gen_S(s, b);
   275	  }
   276	  else if (a > 0xff) {
   277	    gen_B(s, OP_EXT1);
   278	    gen_B(s, i);
   279	    gen_S(s, a);
   280	    gen_B(s, (uint8_t)b);
   281	  }
   282	  else {
   283	    gen_B(s, i);
   284	    gen_B(s, (uint8_t)a);
   285	    gen_B(s, (uint8_t)b);
   286	  }
   287	}
   288	
   289	static void
   290	genop_3(codegen_scope *s, mrb_code i, uint16_t a, uint16_t b, uint16_t c)
   291	{
   292	  genop_2(s, i, a, b);
   293	  gen_B(s, (uint8_t)c);
   294	}
   295	
   296	static void
   297	genop_2S(codegen_scope *s, mrb_code i, uint16_t a, uint16_t b)
   298	{
   299	  genop_1(s, i, a);
   300	  gen_S(s, b);
   301	}
   302	
   303	static void
   304	genop_2SS(codegen_scope *s, mrb_code i, uint16_t a, uint32_t b)
   305	{
   306	  genop_1(s, i, a);
   307	  gen_S(s, b>>16);
   308	  gen_S(s, b&0xffff);
   309	}
   310	
   311	static void
   312	genop_W(codegen_scope *s, mrb_code i, uint32_t a)
   313	{
   314	  uint8_t a1 = (a>>16) & 0xff;
   315	  uint8_t a2 = (a>>8) & 0xff;
   316	  uint8_t a3 = a & 0xff;
   317	
   318	  s->lastpc = s->pc;
   319	  gen_B(s, i);
   320	  gen_B(s, a1);
   321	  gen_B(s, a2);
   322	  gen_B(s, a3);
   323	}
   324	
   325	#define NOVAL  0
   326	#define VAL    1
   327	
   328	static mrb_bool
   329	no_optimize(codegen_scope *s)
   330	{
   331	  if (s && s->parser && s->parser->no_optimize)
   332	    return TRUE;
   333	  return FALSE;
   334	}
   335	
   336	struct mrb_insn_data
   337	mrb_decode_insn(const mrb_code *pc)
   338	{
   339	  struct mrb_insn_data data = { 0 };
   340	  if (pc == 0) return data;
   341	  data.addr = pc;
   342	  mrb_code insn = READ_B();
   343	  uint16_t a = 0;
   344	  uint16_t b = 0;
   345	  uint16_t c = 0;
   346	
   347	  switch (insn) {
   348	#define FETCH_Z() /* empty */
   349	#define OPCODE(i,x) case OP_ ## i: FETCH_ ## x (); break;
   350	#include "mruby/ops.h"
   351	#undef OPCODE
   352	  }
   353	  switch (insn) {
   354	  case OP_EXT1:
   355	    insn = READ_B();
   356	    switch (insn) {
   357	#define OPCODE(i,x) case OP_ ## i: FETCH_ ## x ## _1 (); break;
   358	#include "mruby/ops.h"
   359	#undef OPCODE
   360	    }
   361	    break;
   362	  case OP_EXT2:
   363	    insn = READ_B();
   364	    switch (insn) {
   365	#define OPCODE(i,x) case OP_ ## i: FETCH_ ## x ## _2 (); break;
   366	#include "mruby/ops.h"
   367	#undef OPCODE
   368	    }
   369	    break;
   370	  case OP_EXT3:
   371	    insn = READ_B();
   372	    switch (insn) {
   373	#define OPCODE(i,x) case OP_ ## i: FETCH_ ## x ## _3 (); break;
   374	#include "mruby/ops.h"
   375	#undef OPCODE
   376	    }
   377	    break;
   378	  default:
   379	    break;
   380	  }
   381	  data.insn = insn;
   382	  data.a = a;
   383	  data.b = b;
   384	  data.c = c;
   385	  return data;
   386	}
   387	
   388	#undef OPCODE
   389	#define Z 1
   390	#define S 3
   391	#define W 4
   392	#define OPCODE(_,x) x,
   393	/* instruction sizes */
   394	static uint8_t mrb_insn_size[] = {
   395	#define B 2
   396	#define BB 3
   397	#define BBB 4
   398	#define BS 4
   399	#define BSS 6
   400	#include "mruby/ops.h"
   401	#undef B
   402	#undef BB
   403	#undef BBB
   404	#undef BS
   405	#undef BSS
   406	};
   407	/* EXT1 instruction sizes */
   408	static uint8_t mrb_insn_size1[] = {
   409	#define B 3
   410	#define BB 4
   411	#define BBB 5
   412	#define BS 5
   413	#define BSS 7
   414	#include "mruby/ops.h"
   415	#undef B
   416	#undef BS
   417	#undef BSS
   418	};
   419	/* EXT2 instruction sizes */
   420	static uint8_t mrb_insn_size2[] = {
   421	#define B 2
   422	#define BS 4
   423	#define BSS 6
   424	#include "mruby/ops.h"
   425	#undef B
   426	#undef BB
   427	#undef BBB
   428	#undef BS
   429	#undef BSS
   430	};
   431	/* EXT3 instruction sizes */
   432	#define B 3
   433	#define BB 5
   434	#define BBB 6
   435	#define BS 5
   436	#define BSS 7
   437	static uint8_t mrb_insn_size3[] = {
   438	#include "mruby/ops.h"
   439	};
   440	#undef B
   441	#undef BB
   442	#undef BBB
   443	#undef BS
   444	#undef BSS
   445	#undef OPCODE
   446	
   447	static const mrb_code*
   448	mrb_prev_pc(codegen_scope *s, const mrb_code *pc)
   449	{
   450	  const mrb_code *prev_pc = NULL;
   451	  const mrb_code *i = s->iseq;
   452	
   453	  while (i<pc) {
   454	    uint8_t insn = i[0];
   455	    prev_pc = i;
   456	    switch (insn) {
   457	    case OP_EXT1:
   458	      i += mrb_insn_size1[i[1]] + 1;
   459	      break;
   460	    case OP_EXT2:
   461	      i += mrb_insn_size2[i[1]] + 1;
   462	      break;
   463	    case OP_EXT3:
   464	      i += mrb_insn_size3[i[1]] + 1;
   465	      break;
   466	    default:
   467	      i += mrb_insn_size[insn];
   468	      break;
   469	    }
   470	  }
   471	  return prev_pc;
   472	}
   473	
   474	#define pc_addr(s) &((s)->iseq[(s)->pc])
   475	#define addr_pc(s, addr) (uint32_t)((addr) - s->iseq)
   476	#define rewind_pc(s) s->pc = s->lastpc
   477	
   478	static struct mrb_insn_data
   479	mrb_last_insn(codegen_scope *s)
   480	{
   481	  if (s->pc == 0) {
   482	    struct mrb_insn_data data = { OP_NOP, 0 };
   483	    return data;
   484	  }
   485	  return mrb_decode_insn(&s->iseq[s->lastpc]);
   486	}
   487	
   488	static mrb_bool
   489	no_peephole(codegen_scope *s)
   490	{
   491	  return no_optimize(s) || s->lastlabel == s->pc || s->pc == 0 || s->pc == s->lastpc;
   492	}
   493	
   494	#define JMPLINK_START UINT32_MAX
   495	
   496	static void
   497	gen_jmpdst(codegen_scope *s, uint32_t pc)
   498	{
   499	
   500	  if (pc == JMPLINK_START) {
   501	    pc = 0;
   502	  }
   503	  uint32_t pos2 = s->pc+2;
   504	  int32_t off = pc - pos2;
   505	
   506	  if (off > INT16_MAX || INT16_MIN > off) {
   507	    codegen_error(s, "too big jump offset");
   508	  }
   509	  gen_S(s, (uint16_t)off);
   510	}
   511	
   512	static uint32_t
   513	genjmp(codegen_scope *s, mrb_code i, uint32_t pc)
   514	{
   515	  uint32_t pos;
   516	
   517	  genop_0(s, i);
   518	  pos = s->pc;
   519	  gen_jmpdst(s, pc);
   520	  return pos;
   521	}
   522	
   523	#define genjmp_0(s,i) genjmp(s,i,JMPLINK_START)
   524	
   525	static uint32_t
   526	genjmp2(codegen_scope *s, mrb_code i, uint16_t a, uint32_t pc, int val)
   527	{
   528	  uint32_t pos;
   529	
   530	  if (!no_peephole(s) && !val) {
   531	    struct mrb_insn_data data = mrb_last_insn(s);
   532	
   533	    switch (data.insn) {
   534	    case OP_MOVE:
   535	      if (data.a == a && data.a > s->nlocals) {
   536	        rewind_pc(s);
   537	        a = data.b;
   538	      }
   539	      break;
   540	    case OP_LOADNIL:
   541	    case OP_LOADF:
   542	      if (data.a == a || data.a > s->nlocals) {
   543	        s->pc = addr_pc(s, data.addr);
   544	        if (i == OP_JMPNOT || (i == OP_JMPNIL && data.insn == OP_LOADNIL)) {
   545	          return genjmp(s, OP_JMP, pc);
   546	        }
   547	        else {                  /* OP_JMPIF */
   548	          return JMPLINK_START;
   549	        }
   550	      }
   551	      break;
   552	    case OP_LOADT: case OP_LOADI: case OP_LOADINEG: case OP_LOADI__1:
   553	    case OP_LOADI_0: case OP_LOADI_1: case OP_LOADI_2: case OP_LOADI_3:
   554	    case OP_LOADI_4: case OP_LOADI_5: case OP_LOADI_6: case OP_LOADI_7:
   555	      if (data.a == a || data.a > s->nlocals) {
   556	        s->pc = addr_pc(s, data.addr);
   557	        if (i == OP_JMPIF) {
   558	          return genjmp(s, OP_JMP, pc);
   559	        }
   560	        else {                  /* OP_JMPNOT and OP_JMPNIL */
   561	          return JMPLINK_START;
   562	        }
   563	      }
   564	      break;
   565	    }
   566	  }
   567	
   568	  if (a > 0xff) {
   569	    check_no_ext_ops(s, a, 0);
   570	    gen_B(s, OP_EXT1);
   571	    genop_0(s, i);
   572	    gen_S(s, a);
   573	  }
   574	  else {
   575	    genop_0(s, i);
   576	    gen_B(s, (uint8_t)a);
   577	  }
   578	  pos = s->pc;
   579	  gen_jmpdst(s, pc);
   580	  return pos;
   581	}
   582	
   583	#define genjmp2_0(s,i,a,val) genjmp2(s,i,a,JMPLINK_START,val)
   584	
   585	static mrb_bool get_int_operand(codegen_scope *s, struct mrb_insn_data *data, mrb_int *ns);
   586	static void gen_int(codegen_scope *s, uint16_t dst, mrb_int i);
   587	
   588	static void
   589	gen_move(codegen_scope *s, uint16_t dst, uint16_t src, int nopeep)
   590	{
   591	  if (nopeep || no_peephole(s)) goto normal;
   592	  else if (dst == src) return;
   593	  else {
   594	    struct mrb_insn_data data = mrb_last_insn(s);
   595	
   596	    switch (data.insn) {
   597	    case OP_MOVE:
   598	      if (dst == src) return;   /* remove useless MOVE */
   599	      if (data.a == src) {
   600	        if (data.b == dst)      /* skip swapping MOVE */
   601	          return;
   602	        if (data.a < s->nlocals) goto normal;
   603	        rewind_pc(s);
   604	        s->lastpc = addr_pc(s, mrb_prev_pc(s, data.addr));
   605	        gen_move(s, dst, data.b, FALSE);
   606	        return;
   607	      }
   608	      if (dst == data.a) {      /* skip overwritten move */
   609	        rewind_pc(s);
   610	        s->lastpc = addr_pc(s, mrb_prev_pc(s, data.addr));
   611	        gen_move(s, dst, src, FALSE);
   612	        return;
   613	      }
   614	      goto normal;
   615	    case OP_LOADNIL: case OP_LOADSELF: case OP_LOADT: case OP_LOADF:
   616	    case OP_LOADI__1:
   617	    case OP_LOADI_0: case OP_LOADI_1: case OP_LOADI_2: case OP_LOADI_3:
   618	    case OP_LOADI_4: case OP_LOADI_5: case OP_LOADI_6: case OP_LOADI_7:
   619	      if (data.a != src || data.a < s->nlocals) goto normal;
   620	      rewind_pc(s);
   621	      genop_1(s, data.insn, dst);
   622	      return;
   623	    case OP_HASH:
   624	      if (data.b != 0) goto normal;
   625	      /* fall through */
   626	    case OP_LOADI: case OP_LOADINEG:
   627	    case OP_LOADL: case OP_LOADSYM:
   628	    case OP_GETGV: case OP_GETSV: case OP_GETIV: case OP_GETCV:
   629	    case OP_GETCONST: case OP_STRING:
   630	    case OP_LAMBDA: case OP_BLOCK: case OP_METHOD: case OP_BLKPUSH:
   631	      if (data.a != src || data.a < s->nlocals) goto normal;
   632	      rewind_pc(s);
   633	      genop_2(s, data.insn, dst, data.b);
   634	      return;
   635	    case OP_LOADI16:
   636	      if (data.a != src || data.a < s->nlocals) goto normal;
   637	      rewind_pc(s);
   638	      genop_2S(s, data.insn, dst, data.b);
   639	      return;
   640	    case OP_LOADI32:
   641	      if (data.a != src || data.a < s->nlocals) goto normal;
   642	      else {
   643	        uint32_t i = (uint32_t)data.b<<16|data.c;
   644	        rewind_pc(s);
   645	        genop_2SS(s, data.insn, dst, i);
   646	      }
   647	      return;
   648	    case OP_ARRAY:
   649	      if (data.a != src || data.a < s->nlocals || data.a < dst) goto normal;
   650	      rewind_pc(s);
   651	      if (data.b == 0 || dst == data.a)
   652	        genop_2(s, OP_ARRAY, dst, 0);
   653	      else
   654	        genop_3(s, OP_ARRAY2, dst, data.a, data.b);
   655	      return;
   656	    case OP_ARRAY2:
   657	      if (data.a != src || data.a < s->nlocals || data.a < dst) goto normal;
   658	      rewind_pc(s);
   659	      genop_3(s, OP_ARRAY2, dst, data.b, data.c);
   660	      return;
   661	    case OP_AREF:
   662	    case OP_GETUPVAR:
   663	      if (data.a != src || data.a < s->nlocals) goto normal;
   664	      rewind_pc(s);
   665	      genop_3(s, data.insn, dst, data.b, data.c);
   666	      return;
   667	    case OP_ADDI: case OP_SUBI:
