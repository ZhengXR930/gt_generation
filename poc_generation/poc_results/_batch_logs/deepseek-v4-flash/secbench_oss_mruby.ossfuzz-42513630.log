static void
mpz_set_int(mrb_state *mrb, mpz_t *y, mrb_int v)
{
  mp_limb u;
  size_t len;

  if (v == 0) {
    y->sn=0;
    u = 0;
  }
  else if (v > 0) {
    y->sn = 1;
    u = v;
  }
  if (v < 0) {
    y->sn = -1;
    if (v == MRB_INT_MIN) u = v;
    else u = -v;
  }
  if ((u & LC) == 0) len = 1;
  else len = 2;
  mpz_realloc(mrb, y, len);
  y->p[0] = u & LMAX;
  if (len > 1) y->p[1] = (u & LC) >> DIGITBITS;
}

