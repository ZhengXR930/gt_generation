   260	otError Address::FromString(const char *aBuf)
   261	{
   262	    otError     error  = OT_ERROR_NONE;
   263	    uint8_t *   dst    = reinterpret_cast<uint8_t *>(mFields.m8);
   264	    uint8_t *   endp   = reinterpret_cast<uint8_t *>(mFields.m8 + 15);
   265	    uint8_t *   colonp = NULL;
   266	    const char *colonc = NULL;
   267	    uint16_t    val    = 0;
   268	    uint8_t     count  = 0;
   269	    bool        first  = true;
   270	    bool        hasIp4 = false;
   271	    char        ch;
   272	    uint8_t     d;
   273	
   274	    memset(mFields.m8, 0, 16);
   275	
   276	    dst--;
   277	
   278	    for (;;)
   279	    {
   280	        ch = *aBuf++;
   281	        d  = ch & 0xf;
   282	
   283	        if (('a' <= ch && ch <= 'f') || ('A' <= ch && ch <= 'F'))
   284	        {
   285	            d += 9;
   286	        }
   287	        else if (ch == ':' || ch == '\0' || ch == ' ')
   288	        {
   289	            if (count)
   290	            {
   291	                VerifyOrExit(dst + 2 <= endp, error = OT_ERROR_PARSE);
   292	                *(dst + 1) = static_cast<uint8_t>(val >> 8);
   293	                *(dst + 2) = static_cast<uint8_t>(val);
   294	                dst += 2;
   295	                count = 0;
   296	                val   = 0;
   297	            }
   298	            else if (ch == ':')
   299	            {
   300	                VerifyOrExit(colonp == NULL || first, error = OT_ERROR_PARSE);
   301	                colonp = dst;
   302	            }
   303	
   304	            if (ch == '\0' || ch == ' ')
   305	            {
   306	                break;
   307	            }
   308	
   309	            colonc = aBuf;
   310	
   311	            continue;
   312	        }
   313	        else if (ch == '.')
   314	        {
   315	            hasIp4 = true;
   316	
   317	            // Do not count bytes of the embedded IPv4 address.
   318	            endp -= kIp4AddressSize;
   319	            break;
   320	        }
   321	        else
   322	        {
   323	            VerifyOrExit('0' <= ch && ch <= '9', error = OT_ERROR_PARSE);
   324	        }
   325	
   326	        first = false;
   327	        val   = static_cast<uint16_t>((val << 4) | d);
   328	        VerifyOrExit(++count <= 4, error = OT_ERROR_PARSE);
   329	    }
   330	
   331	    while (colonp && dst > colonp)
   332	    {
   333	        *endp-- = *dst--;
   334	    }
   335	
   336	    while (endp > dst)
   337	    {
   338	        *endp-- = 0;
   339	    }
   340	
   341	    if (hasIp4)
   342	    {
   343	        val = 0;
   344	
   345	        // Reset the start and end pointers.
   346	        dst  = reinterpret_cast<uint8_t *>(mFields.m8 + 12);
   347	        endp = reinterpret_cast<uint8_t *>(mFields.m8 + 15);
   348	
   349	        for (;;)
   350	        {
   351	            ch = *colonc++;
   352	
   353	            if (ch == '.' || ch == '\0' || ch == ' ')
   354	            {
   355	                VerifyOrExit(dst <= endp, error = OT_ERROR_PARSE);
   356	
   357	                *dst++ = static_cast<uint8_t>(val);
   358	                val    = 0;
   359	
   360	                if (ch == '\0' || ch == ' ')
   361	                {
   362	                    // Check if embedded IPv4 address had exactly four parts.
   363	                    VerifyOrExit(dst == endp + 1, error = OT_ERROR_PARSE);
   364	                    break;
   365	                }
   366	            }
   367	            else
   368	            {
   369	                VerifyOrExit('0' <= ch && ch <= '9', error = OT_ERROR_PARSE);
   370	
   371	                val = (10 * val) + (ch & 0xf);
   372	
   373	                // Single part of IPv4 address has to fit in one byte.
   374	                VerifyOrExit(val <= 0xff, error = OT_ERROR_PARSE);
   375	            }
   376	        }
   377	    }
   378	
   379	exit:
   380	    return error;
   381	}
