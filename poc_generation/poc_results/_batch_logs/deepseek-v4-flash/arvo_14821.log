    59	void Coap::PrintPayload(otMessage *aMessage) const
    60	{
    61	    uint8_t  buf[kMaxBufferSize];
    62	    uint16_t bytesToPrint;
    63	    uint16_t bytesPrinted = 0;
    64	    uint16_t length       = otMessageGetLength(aMessage) - otMessageGetOffset(aMessage);
    65	
    66	    if (length > 0)
    67	    {
    68	        mInterpreter.mServer->OutputFormat(" with payload: ");
    69	
    70	        while (length > 0)
    71	        {
    72	            bytesToPrint = (length < sizeof(buf)) ? length : sizeof(buf);
    73	            otMessageRead(aMessage, otMessageGetOffset(aMessage) + bytesPrinted, buf, bytesToPrint);
    74	
    75	            mInterpreter.OutputBytes(buf, static_cast<uint8_t>(bytesToPrint));
    76	
    77	            length -= bytesToPrint;
    78	            bytesPrinted += bytesToPrint;
    79	        }
    80	    }
    81	
    82	    mInterpreter.mServer->OutputFormat("\r\n");
    83	}
