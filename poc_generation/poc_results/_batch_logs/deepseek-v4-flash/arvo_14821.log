   212	uint8_t Address::PrefixMatch(const uint8_t *aPrefixA, const uint8_t *aPrefixB, uint8_t aMaxLength)
   213	{
   214	    uint8_t rval = 0;
   215	    uint8_t diff;
   216	
   217	    if (aMaxLength > sizeof(Address))
   218	    {
   219	        aMaxLength = sizeof(Address);
   220	    }
   221	
   222	    for (uint8_t i = 0; i < aMaxLength; i++)
   223	    {
   224	        diff = aPrefixA[i] ^ aPrefixB[i];
   225	
   226	        if (diff == 0)
   227	        {
   228	            rval += 8;
   229	        }
   230	        else
   231	        {
   232	            while ((diff & 0x80) == 0)
   233	            {
   234	                rval++;
   235	                diff <<= 1;
   236	            }
   237	
   238	            break;
   239	        }
   240	    }
   241	
   242	    return rval;
   243	}
