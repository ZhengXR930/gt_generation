   150	    otCoapCode   coapCode               = OT_COAP_CODE_GET;
   151	    otIp6Address coapDestinationIp;
   152	
   153	    VerifyOrExit(argc > 0, error = OT_ERROR_INVALID_ARGS);
   154	
   155	    // CoAP-Code
   156	    if (strcmp(argv[0], "get") == 0)
   157	    {
   158	        coapCode = OT_COAP_CODE_GET;
   159	    }
   160	    else if (strcmp(argv[0], "post") == 0)
   161	    {
   162	        coapCode = OT_COAP_CODE_POST;
   163	    }
   164	    else if (strcmp(argv[0], "put") == 0)
   165	    {
   166	        coapCode = OT_COAP_CODE_PUT;
   167	    }
   168	    else if (strcmp(argv[0], "delete") == 0)
   169	    {
   170	        coapCode = OT_COAP_CODE_DELETE;
   171	    }
   172	    else
   173	    {
   174	        ExitNow(error = OT_ERROR_INVALID_ARGS);
   175	    }
   176	
   177	    // Destination IPv6 address
   178	    if (argc > 1)
   179	    {
   180	        SuccessOrExit(error = otIp6AddressFromString(argv[1], &coapDestinationIp));
   181	    }
   182	    else
   183	    {
   184	        ExitNow(error = OT_ERROR_INVALID_ARGS);
   185	    }
   186	
   187	    // CoAP-URI
   188	    if (argc > 2)
   189	    {
   190	        VerifyOrExit(strlen(argv[2]) < kMaxUriLength, error = OT_ERROR_INVALID_ARGS);
   191	        strlcpy(coapUri, argv[2], kMaxUriLength);
   192	    }
   193	    else
   194	    {
   195	        ExitNow(error = OT_ERROR_INVALID_ARGS);
   196	    }
   197	
   198	    // CoAP-Type
   199	    if (argc > 3)
   200	    {
   201	        if (strcmp(argv[3], "con") == 0)
   202	        {
   203	            coapType = OT_COAP_TYPE_CONFIRMABLE;
   204	        }
   205	    }
   206	
   207	    message = otCoapNewMessage(mInterpreter.mInstance, NULL);
   208	    VerifyOrExit(message != NULL, error = OT_ERROR_NO_BUFS);
   209	
   210	    otCoapMessageInit(message, coapType, coapCode);
   211	    otCoapMessageGenerateToken(message, ot::Coap::Message::kDefaultTokenLength);
   212	    SuccessOrExit(error = otCoapMessageAppendUriPathOptions(message, coapUri));
   213	
   214	    if (argc > 4)
   215	    {
   216	        payloadLength = static_cast<uint16_t>(strlen(argv[4]));
   217	
   218	        if (payloadLength > 0)
   219	        {
   220	            otCoapMessageSetPayloadMarker(message);
   221	        }
   222	    }
   223	
   224	    // Embed content into message if given
   225	    if (payloadLength > 0)
   226	    {
   227	        SuccessOrExit(error = otMessageAppend(message, argv[4], payloadLength));
   228	    }
   229	
   230	    memset(&messageInfo, 0, sizeof(messageInfo));
   231	    messageInfo.mPeerAddr    = coapDestinationIp;
   232	    messageInfo.mPeerPort    = OT_DEFAULT_COAP_PORT;
   233	    messageInfo.mInterfaceId = OT_NETIF_INTERFACE_ID_THREAD;
   234	
   235	    if ((coapType == OT_COAP_TYPE_CONFIRMABLE) || (coapCode == OT_COAP_CODE_GET))
   236	    {
   237	        error = otCoapSendRequest(mInterpreter.mInstance, message, &messageInfo, &Coap::HandleResponse, this);
   238	    }
   239	    else
   240	    {
   241	        error = otCoapSendRequest(mInterpreter.mInstance, message, &messageInfo, NULL, NULL);
   242	    }
   243	
   244	exit:
   245	
   246	    if ((error != OT_ERROR_NONE) && (message != NULL))
   247	    {
   248	        otMessageFree(message);
   249	    }
   250	
   251	    return error;
   252	}
