   376	        mInterpreter.mServer->OutputFormat("coap receive response error %d: %s\r\n", aError,
   377	                                           otThreadErrorToString(aError));
   378	    }
   379	    else
   380	    {
   381	        mInterpreter.mServer->OutputFormat(
   382	            "coap response from [%x:%x:%x:%x:%x:%x:%x:%x]", HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[0]),
   383	            HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[1]), HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[2]),
   384	            HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[3]), HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[4]),
   385	            HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[5]), HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[6]),
   386	            HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[7]));
   387	
   388	        PrintPayload(aMessage);
   389	    }
   390	}
