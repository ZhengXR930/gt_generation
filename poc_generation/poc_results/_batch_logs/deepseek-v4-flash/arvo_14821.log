   278	void Coap::HandleRequest(void *aContext, otMessage *aMessage, const otMessageInfo *aMessageInfo)
   279	{
   280	    static_cast<Coap *>(aContext)->HandleRequest(aMessage, aMessageInfo);
   281	}
   282	
   283	void Coap::HandleRequest(otMessage *aMessage, const otMessageInfo *aMessageInfo)
   284	{
   285	    otError    error           = OT_ERROR_NONE;
   286	    otMessage *responseMessage = NULL;
   287	    otCoapCode responseCode    = OT_COAP_CODE_EMPTY;
   288	    char       responseContent = '0';
   289	
   290	    mInterpreter.mServer->OutputFormat(
   291	        "coap request from [%x:%x:%x:%x:%x:%x:%x:%x] ", HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[0]),
   292	        HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[1]), HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[2]),
   293	        HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[3]), HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[4]),
   294	        HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[5]), HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[6]),
   295	        HostSwap16(aMessageInfo->mPeerAddr.mFields.m16[7]));
   296	
   297	    switch (otCoapMessageGetCode(aMessage))
   298	    {
   299	    case OT_COAP_CODE_GET:
   300	        mInterpreter.mServer->OutputFormat("GET");
   301	        break;
   302	
   303	    case OT_COAP_CODE_DELETE:
   304	        mInterpreter.mServer->OutputFormat("DELETE");
   305	        break;
   306	
   307	    case OT_COAP_CODE_PUT:
   308	        mInterpreter.mServer->OutputFormat("PUT");
   309	        break;
   310	
   311	    case OT_COAP_CODE_POST:
   312	        mInterpreter.mServer->OutputFormat("POST");
   313	        break;
   314	
   315	    default:
   316	        mInterpreter.mServer->OutputFormat("Undefined\r\n");
   317	        ExitNow(error = OT_ERROR_PARSE);
   318	    }
   319	
   320	    PrintPayload(aMessage);
   321	
   322	    if (otCoapMessageGetType(aMessage) == OT_COAP_TYPE_CONFIRMABLE ||
   323	        otCoapMessageGetCode(aMessage) == OT_COAP_CODE_GET)
   324	    {
   325	        if (otCoapMessageGetCode(aMessage) == OT_COAP_CODE_GET)
   326	        {
   327	            responseCode = OT_COAP_CODE_CONTENT;
   328	        }
   329	        else
   330	        {
   331	            responseCode = OT_COAP_CODE_VALID;
   332	        }
   333	
   334	        responseMessage = otCoapNewMessage(mInterpreter.mInstance, NULL);
   335	        VerifyOrExit(responseMessage != NULL, error = OT_ERROR_NO_BUFS);
   336	
   337	        otCoapMessageInit(responseMessage, OT_COAP_TYPE_ACKNOWLEDGMENT, responseCode);
   338	        otCoapMessageSetMessageId(responseMessage, otCoapMessageGetMessageId(aMessage));
   339	        otCoapMessageSetToken(responseMessage, otCoapMessageGetToken(aMessage), otCoapMessageGetTokenLength(aMessage));
   340	
   341	        if (otCoapMessageGetCode(aMessage) == OT_COAP_CODE_GET)
   342	        {
   343	            otCoapMessageSetPayloadMarker(responseMessage);
   344	            SuccessOrExit(error = otMessageAppend(responseMessage, &responseContent, sizeof(responseContent)));
   345	        }
   346	
   347	        SuccessOrExit(error = otCoapSendResponse(mInterpreter.mInstance, responseMessage, aMessageInfo));
   348	    }
   349	
   350	exit:
   351	
   352	    if (error != OT_ERROR_NONE)
   353	    {
   354	        if (responseMessage != NULL)
   355	        {
   356	            mInterpreter.mServer->OutputFormat("coap send response error %d: %s\r\n", error,
   357	                                               otThreadErrorToString(error));
   358	            otMessageFree(responseMessage);
   359	        }
   360	    }
   361	    else if (responseCode >= OT_COAP_CODE_RESPONSE_MIN)
   362	    {
   363	        mInterpreter.mServer->OutputFormat("coap response sent\r\n");
   364	    }
   365	}
