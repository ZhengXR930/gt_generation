#include <string.h>
#include <stdint.h>

typedef uint8_t ut8;
typedef uint16_t ut16;
typedef uint32_t ut32;
typedef uint64_t ut64;

#define R_NEW0(x) (x*)calloc(1,sizeof(x))
#define R_NEWS0(x,y) (x*)calloc(y,sizeof(x))
#define R_FREE(x) do { free((void *)(x)); (x) = NULL; } while(0)

#define ut8p_bw(x) ((x)[0]|((x)[1]<<8))

#define OMF_THEADR      0x80
#define OMF_LHEADR      0x82
#define OMF_COMENT      0x88
#define OMF_MODEND      0x8A
#define OMF_MODEND32    0x8B
#define OMF_EXTDEF      0x8C
#define OMF_PUBDEF      0x90
#define OMF_PUBDEF32    0x91
#define OMF_LINNUM      0x94
#define OMF_LINNUM32    0x95
#define OMF_LNAMES      0x96
#define OMF_SEGDEF      0x98
#define OMF_SEGDEF32    0x99
#define OMF_GRPDEF      0x9A
#define OMF_FIXUPP      0x9C
#define OMF_FIXUPP32    0x9D
#define OMF_LEDATA      0xA0
#define OMF_LEDATA32    0xA1
#define OMF_LIDATA      0xA2
#define OMF_LIDATA32    0xA3
#define OMF_COMDEF      0xB0
#define OMF_BAKPAT      0xB2
#define OMF_BAKPAT32    0xB3
#define OMF_LEXTDEF     0xB4
#define OMF_LPUBDEF     0xB6
#define OMF_LPUBDEF32   0xB7
#define OMF_LCOMDEF     0xB8
#define OMF_CEXTDEF     0xBC
#define OMF_COMDAT      0xC2
#define OMF_COMDAT32    0xC3
#define OMF_LINSYM      0xC4
#define OMF_LINSYM32    0xC5
#define OMF_ALIAS       0xC6
#define OMF_NBKPAT      0xC8
#define OMF_NBKPAT32    0xC9
#define OMF_LLNAMES     0xCA
#define OMF_VERNUM      0xCC
#define OMF_VENDEXT     0xCE

typedef struct {
    ut8 type;
    ut16 size;
    void *content;
    ut8 checksum;
} OMF_record;

typedef struct OMF_record_handler {
    OMF_record record;
    struct OMF_record_handler *next;
} OMF_record_handler;

typedef struct {
    ut32 nb_elem;
    void *elems;
} OMF_multi_datas;

static int is_valid_omf_type(ut8 type) {
    int ct = 0;
    ut8 types[] = {
        OMF_THEADR, OMF_LHEADR, OMF_COMENT, OMF_MODEND, OMF_MODEND32,
        OMF_EXTDEF, OMF_PUBDEF, OMF_PUBDEF32, OMF_LINNUM,
        OMF_LINNUM32, OMF_LNAMES, OMF_LNAMES, OMF_SEGDEF,
        OMF_SEGDEF32, OMF_GRPDEF, OMF_FIXUPP, OMF_FIXUPP32,
        OMF_LEDATA, OMF_LEDATA32, OMF_LIDATA, OMF_LIDATA32,
        OMF_COMDEF, OMF_BAKPAT, OMF_BAKPAT32, OMF_LEXTDEF,
        OMF_LPUBDEF, OMF_LPUBDEF32, OMF_LCOMDEF, OMF_CEXTDEF,
        OMF_COMDAT, OMF_COMDAT32, OMF_LINSYM, OMF_LINSYM32,
        OMF_ALIAS, OMF_NBKPAT, OMF_NBKPAT32, OMF_LLNAMES, OMF_VERNUM,
        OMF_VENDEXT, 0};
    for (; types[ct]; ct++) {
        if (type == types[ct]) {
            return 1;
        }
    }
    return 0;
}

int r_bin_checksum_omf_ok(const ut8 *buf, ut64 buf_size) {
    ut16 size;
    ut8 checksum = 0;

    if (buf_size < 3) {
        fprintf(stderr, "  checksum: too short\n");
        return 0;
    }
    size = ut8p_bw(buf + 1);
    fprintf(stderr, "  checksum: size=%u, buf_size=%llu\n", size, (unsigned long long)buf_size);
    if (buf_size < size + 3) {
        fprintf(stderr, "  checksum: buf_size < size+3\n");
        return 0;
    }
    if (!buf[2 + size]) {
        fprintf(stderr, "  checksum: byte at [2+%u]=0, OK\n", size);
        return 1;
    }
    fprintf(stderr, "  checksum: byte at [2+%u]=0x%02x, running loop\n", size, buf[2+size]);
    size += 3;
    for (; size; size--) {
        if (buf_size < size) {
            fprintf(stderr, "  checksum: buf_size < size\n");
            return 0;
        }
        checksum += buf[size - 1];
    }
    fprintf(stderr, "  checksum: computed=%u\n", checksum);
    return !checksum ? 1 : 0;
}

static void free_lname(OMF_multi_datas *lname) {
    ut32 ct = 0;
    while (ct < lname->nb_elem) {
        R_FREE(((char **)lname->elems)[ct]);
        ct++;
    }
    R_FREE(lname->elems);
    R_FREE(lname);
}

static int load_omf_lnames(OMF_record *record, const ut8 *buf, ut64 buf_size) {
    ut32 tmp_size = 0;
    ut32 ct_name = 0;
    OMF_multi_datas *ret = NULL;
    char **names;
    
    fprintf(stderr, "  load_omf_lnames: record->size=%u, buf_size=%llu\n", 
            record->size, (unsigned long long)buf_size);
    
    if (!record || !buf) {
        return 0;
    }

    if (!(ret = R_NEW0(OMF_multi_datas))) {
        return 0;
    }
    record->content = ret;

    // First loop: count elements
    while ((int)tmp_size < (int)(record->size - 1)) {
        int next;
        ret->nb_elem++;
        next = buf[3 + tmp_size] + 1;
        fprintf(stderr, "    count loop: tmp_size=%u, buf[3+%u]=0x%02x, next=%d\n", 
                tmp_size, tmp_size, buf[3+tmp_size], next);
        if (next < 1) {
            break;
        }
        tmp_size += next;
    }
    fprintf(stderr, "    counted nb_elem=%u\n", ret->nb_elem);
    
    if (!(ret->elems = R_NEWS0(char *, ret->nb_elem + 1))) {
        R_FREE(ret);
        return 0;
    }
    names = (char **)ret->elems;
    tmp_size = 0;
    
    // Second loop: read elements
    while ((int)tmp_size < (int)(record->size - 1)) {
        if (ct_name >= ret->nb_elem) {
            fprintf(stderr, "    load_omf_lnames: prevent overflow (ct_name=%u >= nb_elem=%u)\n", 
                    ct_name, ret->nb_elem);
            break;
        }
        char cb = buf[3 + tmp_size];
        fprintf(stderr, "    read loop: tmp_size=%u, buf[3+%u]=0x%02x (cb=%d), ct_name=%u\n", 
                tmp_size, tmp_size, buf[3+tmp_size], cb, ct_name);
        if (cb < 1) {
            names[ct_name++] = NULL;
            tmp_size++;
            continue;
        }
        if (record->size + 3 < tmp_size + cb) {
            fprintf(stderr, "    Invalid Lnames record (bad size)\n");
            free(ret);
            return 0;
        }
        if (!(names[ct_name] = R_NEWS0(char, cb + 1))) {
            free_lname(ret);
            return 0;
        }
        if ((tmp_size + 4 + cb) < buf_size) {
            memcpy(names[ct_name], buf + 3 + tmp_size + 1, cb);
        }
        ct_name++;
        tmp_size += cb + 1;
    }
    fprintf(stderr, "    final ct_name=%u, nb_elem=%u\n", ct_name, ret->nb_elem);
    return 1;
}

static int load_omf_content(OMF_record *record, const ut8 *buf, ut64 global_ct, ut64 buf_size) {
    fprintf(stderr, "  load_omf_content: type=0x%02x, size=%u\n", record->type, record->size);
    if (record->type == OMF_LNAMES) {
        return load_omf_lnames(record, buf, buf_size);
    }
    if (!record->size) {
        fprintf(stderr, "  Invalid record (size too short)\n");
        return 0;
    }
    if (!(record->content = R_NEWS0(char, record->size))) {
        return 0;
    }
    ((char *)record->content)[record->size - 1] = 0;
    return 1;
}

static OMF_record_handler *load_record_omf(const ut8 *buf, ut64 global_ct, ut64 buf_size) {
    OMF_record_handler *new = NULL;

    fprintf(stderr, "load_record_omf: type=0x%02x, global_ct=%llu, buf_size=%llu\n", 
            buf[0], (unsigned long long)global_ct, (unsigned long long)buf_size);

    if (is_valid_omf_type(buf[0]) && r_bin_checksum_omf_ok(buf, buf_size)) {
        if (!(new = R_NEW0(OMF_record_handler))) {
            return NULL;
        }
        new->record.type = buf[0];
        new->record.size = buf[1] | (buf[2] << 8);
        fprintf(stderr, "  record.size=%u\n", new->record.size);

        if (new->record.size > buf_size - 3 || buf_size < 4) {
            fprintf(stderr, "  Invalid record (too short)\n");
            R_FREE(new);
            return NULL;
        }

        if (!load_omf_content(&new->record, buf, global_ct, buf_size)) {
            fprintf(stderr, "  load_omf_content failed\n");
            R_FREE(new);
            return NULL;
        }
        new->record.checksum = buf[2 + new->record.size];
        new->next = NULL;
        fprintf(stderr, "  record loaded successfully\n");
    } else {
        fprintf(stderr, "  invalid type or checksum failed\n");
    }
    return new;
}

static int load_all_omf_records(void **records, const ut8 *buf, ut64 size) {
    ut64 ct = 0;
    OMF_record_handler *new_rec = NULL;
    OMF_record_handler *tmp = NULL;

    while (ct < size) {
        fprintf(stderr, "\n--- Loading record at offset %llu (remaining=%llu) ---\n", 
                (unsigned long long)ct, (unsigned long long)(size - ct));
        if (!(new_rec = load_record_omf(buf + ct, ct, size - ct))) {
            fprintf(stderr, "Failed to load record at offset %llu\n", (unsigned long long)ct);
            return 0;
        }
        
        if (!tmp) {
            *records = new_rec;
            tmp = *(OMF_record_handler **)records;
        } else {
            tmp->next = new_rec;
            tmp = tmp->next;
        }
        ct += 3 + tmp->record.size;
        fprintf(stderr, "Advanced ct to %llu\n", (unsigned long long)ct);
    }
    return 1;
}

void free_all_omf_records(void *records_ptr) {
    OMF_record_handler *rec = *(OMF_record_handler **)records_ptr;
    while (rec) {
        OMF_record_handler *next = rec->next;
        if (rec->record.type == OMF_LNAMES) {
            free_lname((OMF_multi_datas *)rec->record.content);
        } else {
            R_FREE(rec->record.content);
        }
        R_FREE(rec);
        rec = next;
    }
    *(OMF_record_handler **)records_ptr = NULL;
}

int main(int argc, char **argv) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <omf_file>\n", argv[0]);
        return 1;
    }
    
    FILE *f = fopen(argv[1], "rb");
    if (!f) {
        fprintf(stderr, "Cannot open %s\n", argv[1]);
        return 1;
    }
    fseek(f, 0, SEEK_END);
    long fsize = ftell(f);
    fseek(f, 0, SEEK_SET);
    ut8 *buf = malloc(fsize);
    fread(buf, 1, fsize, f);
    fclose(f);
    
    fprintf(stderr, "Loading OMF file: %s (%ld bytes)\n", argv[1], fsize);
    fprintf(stderr, "Hex: ");
    for (int i = 0; i < fsize; i++) fprintf(stderr, "%02x", buf[i]);
    fprintf(stderr, "\n");
    
    void *records = NULL;
    
    int result = load_all_omf_records(&records, buf, fsize);
    fprintf(stderr, "\nload_all_omf_records returned: %d\n", result);
    
    if (records) {
        fprintf(stderr, "Records loaded. Cleaning up...\n");
        free_all_omf_records(&records);
    }
    
    free(buf);
    fprintf(stderr, "Done.\n");
    return 0;
}
