    records = NULL;
    result = load_all_omf_records(&records, two_recs, sizeof(two_recs));
    printf("Result: %d\n", result);
    free_records(records);
    
    // Test 5: Record with size field saying larger than available
    ut8 large_size[] = {0x80, 0xFF, 0x00, 0x00};  // THEADR, size=255, but only 4 bytes
    printf("\n=== Test 5: Size larger than buffer ===\n");
    records = NULL;
    result = load_all_omf_records(&records, large_size, sizeof(large_size));
    printf("Result: %d\n", result);
    free_records(records);
    
    return 0;
}
