#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

typedef unsigned char ut8;
typedef unsigned short ut16;
typedef unsigned int ut32;
typedef unsigned long long ut64;

#define R_NEW0(x) (x*)calloc(1,sizeof(x))
#define R_NEWS0(x,y) (x*)calloc(y,sizeof(x))
#define R_FREE(x) { free((void *)x); x = NULL; }

#define ut8p_bw(x) ((x)[0]|((x)[1]<<8))

static int is_valid_omf_type(ut8 type) {
    int ct = 0;
    ut8 types[] = {
        0x80, 0x82, 0x88, 0x8A, 0x8B,
        0x8C, 0x90, 0x91, 0x94,
        0x95, 0x96, 0x96, 0x98,
        0x99, 0x9A, 0x9C, 0x9D,
        0xA0, 0xA1, 0xA2, 0xA3,
        0xB0, 0xB2, 0xB3, 0xB4,
        0xB6, 0xB7, 0xB8, 0xBC,
        0xC2, 0xC3, 0xC4, 0xC5,
        0xC6, 0xC8, 0xC9, 0xCA, 0xCC,
        0xCE, 0};
    for (; types[ct]; ct++) {
        if (type == types[ct]) {
            return 1;
        }
    }
    return 0;
}

int r_bin_checksum_omf_ok(const ut8 *buf, ut64 buf_size) {
    ut16 size;
    ut8 checksum = 0;

    if (buf_size < 3) {
        printf("  checksum: too short (<3)\n");
        return 0;
    }
    size = ut8p_bw(buf + 1);
    printf("  checksum: size from header=%u, buf_size=%llu\n", size, (unsigned long long)buf_size);
    if (buf_size < size + 3) {
        printf("  checksum: buf_size < size+3 (%llu < %u)\n", (unsigned long long)buf_size, size+3);
        return 0;
    }
    if (!buf[2 + size]) {
        printf("  checksum: checksum byte at [2+%u]=0, returning true\n", size);
        return 1;
    }
    printf("  checksum: checksum byte non-zero, running checksum loop\n");
    size += 3;
    for (; size; size--) {
        if (buf_size < size) {
            printf("  checksum: buf_size < size (%llu < %u)\n", (unsigned long long)buf_size, size);
            return 0;
        }
        checksum += buf[size - 1];
    }
    if (checksum) {
        printf("  checksum: invalid checksum\n");
    }
    return !checksum ? 1 : 0;
}

typedef struct {
    ut8 type;
    ut16 size;
    void *content;
    ut8 checksum;
} OMF_record;

typedef struct OMF_record_handler {
    OMF_record record;
    struct OMF_record_handler *next;
} OMF_record_handler;

typedef struct {
    ut32 nb_elem;
    void *elems;
} OMF_multi_datas;

static int load_omf_content(OMF_record *record, const ut8 *buf, ut64 global_ct, ut64 buf_size);

static OMF_record_handler *load_record_omf(const ut8 *buf, ut64 global_ct, ut64 buf_size) {
    OMF_record_handler *new = NULL;

    printf("load_record_omf: type=0x%02x, buf_size=%llu\n", buf[0], (unsigned long long)buf_size);
    
    if (is_valid_omf_type(buf[0]) && r_bin_checksum_omf_ok(buf, buf_size)) {
        if (!(new = R_NEW0(OMF_record_handler))) {
            return NULL;
        }
        new->record.type = buf[0];
        new->record.size = buf[1] | (buf[2] << 8);
        
        printf("  record size=%u\n", new->record.size);
        
        if (new->record.size > buf_size - 3 || buf_size < 4) {
            printf("  Invalid record (too short): size=%u > buf_size-3=%llu\n", 
                   new->record.size, (unsigned long long)(buf_size - 3));
            R_FREE(new);
            return NULL;
        }
        
        if (!load_omf_content(&new->record, buf, global_ct, buf_size)) {
            printf("  load_omf_content failed\n");
            R_FREE(new);
            return NULL;
        }
        new->record.checksum = buf[2 + new->record.size];
        new->next = NULL;
    } else {
        printf("  invalid type or checksum failed\n");
    }
    return new;
}

static int load_all_omf_records(OMF_record_handler **records, const ut8 *buf, ut64 size) {
    ut64 ct = 0;
    OMF_record_handler *new_rec = NULL;
    OMF_record_handler *tmp = NULL;

    while (ct < size) {
        printf("\nLoading record at offset %llu (remaining=%llu)\n", 
               (unsigned long long)ct, (unsigned long long)(size - ct));
        if (!(new_rec = load_record_omf(buf + ct, ct, size - ct))) {
            printf("Failed to load record at offset %llu\n", (unsigned long long)ct);
            return 0;
        }
        
        if (!tmp) {
            *records = new_rec;
            tmp = *records;
        } else {
            tmp->next = new_rec;
            tmp = tmp->next;
        }
        ct += 3 + tmp->record.size;
        printf("Advanced ct to %llu (size=%llu)\n", (unsigned long long)ct, (unsigned long long)size);
    }
    return 1;
}

static int load_omf_content(OMF_record *record, const ut8 *buf, ut64 global_ct, ut64 buf_size) {
    // Generic loader just copy data from buf to content
    if (!record->size) {
        printf("  Invalid record (size too short)\n");
        return 0;
    }
    if (!(record->content = R_NEWS0(char, record->size))) {
        return 0;
    }
    ((char *)record->content)[record->size - 1] = 0;
    return 1;
}

void free_records(OMF_record_handler *records) {
    while (records) {
        OMF_record_handler *next = records->next;
        R_FREE(records->record.content);
        R_FREE(records);
        records = next;
    }
}

int main() {
    // Test 1: Valid minimal OMF file (THEADR with size=0)
    // Format: [type:1][size:2][checksum:1] = 4 bytes
    ut8 valid[] = {0x80, 0x00, 0x00, 0x00};  // THEADR, size=0, checksum=0
    printf("=== Test 1: Valid minimal OMF ===\n");
    OMF_record_handler *records = NULL;
    int result = load_all_omf_records(&records, valid, sizeof(valid));
    printf("Result: %d\n", result);
    free_records(records);
    
    // Test 2: Truncated by 1 byte (missing checksum)
    ut8 truncated[] = {0x80, 0x00, 0x00};  // THEADR, size=0, NO checksum
    printf("\n=== Test 2: Truncated by 1 byte (size=0) ===\n");
    records = NULL;
    result = load_all_omf_records(&records, truncated, sizeof(truncated));
    printf("Result: %d\n", result);
    free_records(records);
    
    // Test 3: Truncated by 1 byte with non-zero data byte
    ut8 truncated2[] = {0x80, 0x01, 0x00, 0x41};  // THEADR, size=1, data='A', NO checksum
    printf("\n=== Test 3: Truncated by 1 byte (size=1, missing checksum) ===\n");
    records = NULL;
    result = load_all_omf_records(&records, truncated2, sizeof(truncated2));
