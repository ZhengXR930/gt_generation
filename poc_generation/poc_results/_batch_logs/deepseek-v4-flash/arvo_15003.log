        return 1;
    }
    fseek(f, 0, SEEK_END);
    long fsize = ftell(f);
    fseek(f, 0, SEEK_SET);
    ut8 *buf = malloc(fsize);
    fread(buf, 1, fsize, f);
    fclose(f);

    fprintf(stderr, "Loading OMF file: %s (%ld bytes)\n", argv[1], fsize);
    fprintf(stderr, "Hex: ");
    for (int i = 0; i < fsize; i++) fprintf(stderr, "%02x", buf[i]);
    fprintf(stderr, "\n");

    void *records = NULL;

    int result = load_all_omf_records(&records, buf, fsize);
    fprintf(stderr, "\nload_all_omf_records returned: %d\n", result);

    if (records) {
        fprintf(stderr, "Records loaded. Cleaning up...\n");
        free_all_omf_records(&records);
    }

    free(buf);
    fprintf(stderr, "Done.\n");
    return 0;
}
