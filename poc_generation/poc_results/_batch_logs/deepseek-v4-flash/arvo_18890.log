                obj->type = SC_PKCS15_TYPE_PRKEY_RSA;
        }
        else if (asn1_prkey[1].flags & SC_ASN1_PRESENT) {
                obj->type = SC_PKCS15_TYPE_PRKEY_EC;
        }
        else if (asn1_prkey[2].flags & SC_ASN1_PRESENT) {
