        pubkey = calloc(1, sizeof(sc_pkcs15_pubkey_t));
        if (pubkey == NULL) {
                r = SC_ERROR_OUT_OF_MEMORY;
                LOG_TEST_GOTO_ERR(ctx, r, "");
        }
        *outpubkey = pubkey;

        sc_copy_asn1_entry(c_asn1_pkinfo, asn1_pkinfo);

        sc_format_asn1_entry(asn1_pkinfo + 0, &pk_alg, NULL, 0);
