int sc_pkcs15_decode_prkdf_entry(struct sc_pkcs15_card *p15card,
                                 struct sc_pkcs15_object *obj,
                                 const u8 ** buf, size_t *buflen)
{
        sc_context_t *ctx = p15card->card->ctx;
