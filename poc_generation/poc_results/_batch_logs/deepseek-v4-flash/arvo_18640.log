   200	
   201	        /* initialize max_recv_size to a meaningful value */
   202	        if (card->caps & SC_CARD_CAP_APDU_EXT) {
   203	                if (!max_recv_size)
   204	                        max_recv_size = 65536;
   205	        } else {
   206	                if (!max_recv_size)
   207	                        max_recv_size = 256;
   208	        }
   209	
   210	        /*  Override card limitations with reader limitations. */
   211	        if (card->reader->max_recv_size != 0
   212	                        && (card->reader->max_recv_size < card->max_recv_size))
   213	                max_recv_size = card->reader->max_recv_size;
   214	
   215	        return max_recv_size;
   216	}
