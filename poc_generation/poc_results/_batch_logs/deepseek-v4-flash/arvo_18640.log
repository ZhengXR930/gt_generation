   358	
   359	/* select a CAC pki applet by index */
   360	static int cac_select_pki_applet(sc_card_t *card, int index)
   361	{
   362	        sc_path_t applet_path = cac_cac_pki_obj.path;
   363	        applet_path.aid.value[applet_path.aid.len-1] = index;
   364	        return cac_select_file_by_type(card, &applet_path, NULL);
   365	}
   366	
   367	/*
   368	 *  Find the first existing CAC applet. If none found, then this isn't a CAC
   369	 */
   370	static int cac_find_first_pki_applet(sc_card_t *card, int *index_out)
   371	{
   372	        int r, i;
   373	
   374	        for (i = 0; i < MAX_CAC_SLOTS; i++) {
   375	                r = cac_select_pki_applet(card, i);
   376	                if (r == SC_SUCCESS) {
   377	                        u8 data[2];
   378	                        sc_apdu_t apdu;
   379	
   380	                        /* Try to read first two bytes of the buffer to
   381	                         * make sure it is not just malfunctioning card
   382	                         */
   383	                        sc_format_apdu(card, &apdu, SC_APDU_CASE_2,
   384	                                CAC_INS_GET_CERTIFICATE, 0x00, 0x00);
   385	                        apdu.le = 0x02;
   386	                        apdu.resplen = 2;
   387	                        apdu.resp = data;
   388	                        r = sc_transmit_apdu(card, &apdu);
   389	                        /* SW1 = 0x63 means more data in CAC1 */
   390	                        if (r == SC_SUCCESS && apdu.sw1 != 0x63)
   391	                                continue;
   392	
   393	                        *index_out = i;
   394	                        return SC_SUCCESS;
   395	                }
   396	        }
   397	        return SC_ERROR_OBJECT_NOT_FOUND;
   398	}
   399	
   400	static int cac_populate_cac1(sc_card_t *card, int index, cac_private_data_t *priv)
   401	{
   402	        int r, i;
   403	        cac_object_t pki_obj = cac_cac_pki_obj;
   404	        u8 buf[100];
   405	        u8 *val;
   406	        size_t val_len;
   407	
   408	        /* populate PKI objects */
   409	        for (i = index; i < MAX_CAC_SLOTS; i++) {
   410	                r = cac_select_pki_applet(card, i);
   411	                if (r == SC_SUCCESS) {
   412	                        pki_obj.name = get_cac_label(i);
   413	                        sc_debug(card->ctx, SC_LOG_DEBUG_VERBOSE,
   414	                                "CAC: pki_object found, cert_next=%d (%s)",
   415	                                i, pki_obj.name);
   416	                        pki_obj.path.aid.value[pki_obj.path.aid.len-1] = i;
   417	                        pki_obj.fd = i+1; /* don't use id of zero */
   418	                        cac_add_object_to_list(&priv->pki_list, &pki_obj);
   419	                }
   420	        }
   421	
   422	        /*
   423	         * create a cuid to simulate the cac 2 cuid.
   424	         */
   425	        priv->cuid = cac_cac_cuid;
   426	        /* create a serial number by hashing the first 100 bytes of the
   427	         * first certificate on the card */
   428	        r = cac_select_pki_applet(card, index);
   429	        if (r < 0) {
   430	                return r; /* shouldn't happen unless the card has been removed or is malfunctioning */
   431	        }
   432	        val = buf;
   433	        val_len = sizeof(buf);
   434	        r = cac_cac1_get_certificate(card, &val, &val_len);
   435	        if (r >= 0) {
   436	                priv->cac_id = malloc(20);
   437	                if (priv->cac_id == NULL) {
   438	                        return SC_ERROR_OUT_OF_MEMORY;
   439	                }
   440	#ifdef ENABLE_OPENSSL
   441	                SHA1(val, val_len, priv->cac_id);
   442	                priv->cac_id_len = 20;
   443	                sc_debug_hex(card->ctx, SC_LOG_DEBUG_VERBOSE,
   444	                        "cuid", priv->cac_id, priv->cac_id_len);
   445	#else
   446	                sc_log(card->ctx, "OpenSSL Required");
   447	                return SC_ERROR_NOT_SUPPORTED;
   448	#endif /* ENABLE_OPENSSL */
   449	        }
   450	        return SC_SUCCESS;
   451	}
   452	
   453	/*
   454	 * Look for a CAC card. If it exists, initialize our data structures
   455	 */
   456	static int cac_find_and_initialize(sc_card_t *card, int initialize)
   457	{
   458	        int r, index;
   459	        cac_private_data_t *priv = NULL;
   460	
   461	        /* already initialized? */
   462	        if (card->drv_data) {
   463	                return SC_SUCCESS;
   464	        }
   465	
   466	        /* is this a CAC Alt token without any accompanying structures */
   467	        r = cac_find_first_pki_applet(card, &index);
   468	        if (r == SC_SUCCESS) {
   469	                sc_debug(card->ctx, SC_LOG_DEBUG_VERBOSE, "PKI applet found, is bare CAC-1");
   470	                if (!initialize) /* match card only */
   471	                        return r;
   472	
   473	                if (!priv) {
   474	                        priv = cac_new_private_data();
   475	                        if (!priv)
   476	                                return SC_ERROR_OUT_OF_MEMORY;
   477	                }
   478	                card->drv_data = priv; /* needed for the read_binary() */
   479	                r = cac_populate_cac1(card, index, priv);
   480	                if (r == SC_SUCCESS) {
   481	                        card->type = SC_CARD_TYPE_CAC_I;
   482	                        return r;
   483	                }
   484	                card->drv_data = NULL; /* reset on failure */
   485	        }
   486	        if (priv) {
   487	                cac_free_private_data(priv);
   488	        }
   489	        return r;
   490	}
   491	
   492	
   493	/* NOTE: returns a bool, 1 card matches, 0 it does not */
   494	static int cac_match_card(sc_card_t *card)
   495	{
   496	        int r;
   497	        SC_FUNC_CALLED(card->ctx, SC_LOG_DEBUG_VERBOSE);
   498	        /* Since we send an APDU, the card's logout function may be called...
   499	         * however it may be in dirty memory */
   500	        card->ops->logout = NULL;
   501	
   502	        r = cac_find_and_initialize(card, 0);
   503	        return (r == SC_SUCCESS); /* never match */
   504	}
   505	
   506	
   507	static int cac_init(sc_card_t *card)
   508	{
   509	        int r;
   510	        unsigned long flags;
   511	
   512	        SC_FUNC_CALLED(card->ctx, SC_LOG_DEBUG_VERBOSE);
   513	
   514	        r = cac_find_and_initialize(card, 1);
   515	        if (r < 0) {
   516	                LOG_FUNC_RETURN(card->ctx, SC_ERROR_INVALID_CARD);
   517	        }
   518	        flags = SC_ALGORITHM_RSA_RAW;
   519	
   520	        _sc_card_add_rsa_alg(card, 1024, flags, 0); /* mandatory */
   521	        _sc_card_add_rsa_alg(card, 2048, flags, 0); /* optional */
   522	        _sc_card_add_rsa_alg(card, 3072, flags, 0); /* optional */
   523	
   524	        card->caps |= SC_CARD_CAP_RNG | SC_CARD_CAP_ISO7816_PIN_INFO;
   525	
   526	        LOG_FUNC_RETURN(card->ctx, SC_SUCCESS);
   527	}
   528	
   529	static struct sc_card_operations cac_ops;
   530	
   531	static struct sc_card_driver cac1_drv = {
   532	        "Common Access Card (CAC 1)",
   533	        "cac1",
   534	        &cac_ops,
   535	        NULL, 0, NULL
   536	};
   537	
   538	static struct sc_card_driver * sc_get_driver(void)
   539	{
   540	        /* Inherit most of the things from the CAC driver */
   541	        struct sc_card_driver *cac_drv = sc_get_cac_driver();
   542	
   543	        cac_ops = *cac_drv->ops;
   544	        cac_ops.match_card = cac_match_card;
   545	        cac_ops.init = cac_init;
   546	        cac_ops.finish = cac_finish;
   547	
   548	        cac_ops.select_file =  cac_select_file; /* need to record object type */
