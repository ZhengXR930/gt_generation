   408	int sc_disconnect_card(sc_card_t *card)
   409	{
   410	        sc_context_t *ctx;
   411	
   412	        if (!card)
   413	                return SC_ERROR_INVALID_ARGUMENTS;
   414	
   415	        ctx = card->ctx;
   416	        LOG_FUNC_CALLED(ctx);
   417	
   418	        if (card->lock_count != 0)
   419	                return SC_ERROR_NOT_ALLOWED;
   420	        if (card->ops->finish) {
   421	                int r = card->ops->finish(card);
   422	                if (r)
   423	                        sc_log(ctx, "card driver finish() failed: %s", sc_strerror(r));
   424	        }
   425	
   426	        if (card->reader->ops->disconnect) {
   427	                int r = card->reader->ops->disconnect(card->reader);
   428	                if (r)
   429	                        sc_log(ctx, "disconnect() failed: %s", sc_strerror(r));
   430	        }
   431	
   432	#ifdef ENABLE_SM
   433	        /* release SM related resources */
   434	        sc_card_sm_unload(card);
   435	#endif
   436	
   437	        sc_card_free(card);
   438	        LOG_FUNC_RETURN(ctx, SC_SUCCESS);
   439	}
