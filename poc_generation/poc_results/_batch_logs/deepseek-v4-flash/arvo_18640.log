    58	/*
    59	 *  CAC hardware and APDU constants
    60	 */
    61	#define CAC_INS_GET_CERTIFICATE       0x36  /* CAC1 command to read a certificate */
    62	
    63	/*
    64	 * OLD cac read certificate, only use with CAC-1 card.
    65	 */
    66	static int cac_cac1_get_certificate(sc_card_t *card, u8 **out_buf, size_t *out_len)
    67	{
    68	        u8 buf[CAC_MAX_SIZE];
    69	        u8 *out_ptr;
    70	        size_t size = 0;
    71	        size_t left = 0;
    72	        size_t len, next_len;
    73	        sc_apdu_t apdu;
    74	        int r = SC_SUCCESS;
    75	        SC_FUNC_CALLED(card->ctx, SC_LOG_DEBUG_VERBOSE);
    76	        /* get the size */
    77	        size = left = *out_buf ? *out_len : sizeof(buf);
    78	        out_ptr = *out_buf ? *out_buf : buf;
    79	        sc_format_apdu(card, &apdu, SC_APDU_CASE_2_SHORT, CAC_INS_GET_CERTIFICATE, 0, 0 );
    80	        next_len = MIN(left, 100);
    81	        for (; left > 0; left -= len, out_ptr += len) {
    82	                len = next_len;
    83	                apdu.resp = out_ptr;
    84	                apdu.le = len;
    85	                apdu.resplen = left;
    86	                r = sc_transmit_apdu(card, &apdu);
    87	                if (r < 0) {
    88	                        break;
    89	                }
    90	                if (apdu.resplen == 0) {
    91	                        r = SC_ERROR_INTERNAL;
    92	                        break;
    93	                }
    94	                /* in the old CAC-1, 0x63 means 'more data' in addition to 'pin failed' */
    95	                if (apdu.sw1 != 0x63 || apdu.sw2 < 1)  {
    96	                        /* we've either finished reading, or hit an error, break */
    97	                        r = sc_check_sw(card, apdu.sw1, apdu.sw2);
    98	                        left -= len;
    99	                        break;
   100	                }
   101	                next_len = MIN(left, apdu.sw2);
   102	        }
   103	        if (r < 0) {
   104	                SC_FUNC_RETURN(card->ctx, SC_LOG_DEBUG_VERBOSE, r);
   105	        }
   106	        r = size - left;
   107	        if (*out_buf == NULL) {
   108	                *out_buf = malloc(r);
   109	                if (*out_buf == NULL) {
   110	                        SC_FUNC_RETURN(card->ctx, SC_LOG_DEBUG_VERBOSE,
   111	                                SC_ERROR_OUT_OF_MEMORY);
   112	                }
   113	                memcpy(*out_buf, buf, r);
   114	        }
   115	        *out_len = r;
   116	        SC_FUNC_RETURN(card->ctx, SC_LOG_DEBUG_VERBOSE, r);
   117	}
   118	
   119	/*
   120	 * Callers of this may be expecting a certificate,
   121	 * select file will have saved the object type for us
   122	 * as well as set that we want the cert from the object.
   123	 */
   124	static int cac_read_binary(sc_card_t *card, unsigned int idx,
   125	                unsigned char *buf, size_t count, unsigned long flags)
   126	{
   127	        cac_private_data_t * priv = CAC_DATA(card);
   128	        int r = 0;
   129	        u8 *val = NULL;
   130	        u8 *cert_ptr;
   131	        size_t val_len;
   132	        size_t len, cert_len;
   133	        u8 cert_type;
   134	
   135	        SC_FUNC_CALLED(card->ctx, SC_LOG_DEBUG_VERBOSE);
   136	
   137	        /* if we didn't return it all last time, return the remainder */
   138	        if (priv->cached) {
   139	                sc_log(card->ctx, 
   140	                        "returning cached value idx=%d count=%"SC_FORMAT_LEN_SIZE_T"u",
   141	                        idx, count);
   142	                if (idx > priv->cache_buf_len) {
   143	                        LOG_FUNC_RETURN(card->ctx, SC_ERROR_FILE_END_REACHED);
   144	                }
   145	                len = MIN(count, priv->cache_buf_len-idx);
   146	                memcpy(buf, &priv->cache_buf[idx], len);
   147	                LOG_FUNC_RETURN(card->ctx, len);
   148	        }
   149	
   150	        sc_log(card->ctx, 
   151	                "clearing cache idx=%d count=%"SC_FORMAT_LEN_SIZE_T"u",
   152	                idx, count);
   153	        free(priv->cache_buf);
   154	        priv->cache_buf = NULL;
   155	        priv->cache_buf_len = 0;
   156	
   157	        r = cac_cac1_get_certificate(card, &val, &val_len);
   158	        if (r < 0)
   159	                goto done;
   160	        if (val_len < 1) {
   161	                r = SC_ERROR_INVALID_DATA;
   162	                goto done;
   163	        }
   164	
   165	        cert_type = val[0];
   166	        cert_ptr = val + 1;
   167	        cert_len = val_len - 1;
   168	
   169	        /* if the info byte is 1, then the cert is compressed, decompress it */
   170	        if ((cert_type & 0x3) == 1) {
   171	#ifdef ENABLE_ZLIB
   172	                r = sc_decompress_alloc(&priv->cache_buf, &priv->cache_buf_len,
   173	                        cert_ptr, cert_len, COMPRESSION_AUTO);
   174	#else
   175	                sc_log(card->ctx, "CAC compression not supported, no zlib");
   176	                r = SC_ERROR_NOT_SUPPORTED;
   177	#endif
   178	                if (r)
   179	                        goto done;
   180	        } else if (cert_len > 0) {
   181	                priv->cache_buf = malloc(cert_len);
   182	                if (priv->cache_buf == NULL) {
   183	                        r = SC_ERROR_OUT_OF_MEMORY;
   184	                        goto done;
   185	                }
   186	                priv->cache_buf_len = cert_len;
   187	                memcpy(priv->cache_buf, cert_ptr, cert_len);
   188	        }
   189	
   190	        /* OK we've read the data, now copy the required portion out to the callers buffer */
   191	        priv->cached = 1;
   192	        len = MIN(count, priv->cache_buf_len-idx);
   193	        if (len && priv->cache_buf)
   194	                memcpy(buf, &priv->cache_buf[idx], len);
   195	        r = len;
   196	done:
   197	        if (val)
   198	                free(val);
   199	        LOG_FUNC_RETURN(card->ctx, r);
   200	}
   201	
   202	/*
   203	 * CAC cards use SC_PATH_SELECT_OBJECT_ID rather than SC_PATH_SELECT_FILE_ID. In order to use more
   204	 * of the PKCS #15 structure, we call the selection SC_PATH_SELECT_FILE_ID, but we set p1 to 2 instead
   205	 * of 0. Also cac1 does not do any FCI, but it doesn't understand not selecting it. It returns invalid INS
   206	 * if it doesn't like anything about the select, so we always 'request' FCI for CAC1
   207	 *
   208	 * The rest is just copied from iso7816_select_file
   209	 */
   210	static int cac_select_file_by_type(sc_card_t *card, const sc_path_t *in_path, sc_file_t **file_out)
   211	{
   212	        struct sc_context *ctx;
   213	        struct sc_apdu apdu;
   214	        unsigned char buf[SC_MAX_APDU_BUFFER_SIZE];
   215	        unsigned char pathbuf[SC_MAX_PATH_SIZE], *path = pathbuf;
   216	        int r, pathlen, pathtype;
   217	        struct sc_file *file = NULL;
   218	        cac_private_data_t * priv = CAC_DATA(card);
   219	
   220	        assert(card != NULL && in_path != NULL);
   221	        ctx = card->ctx;
   222	
   223	        SC_FUNC_CALLED(ctx, SC_LOG_DEBUG_VERBOSE);
   224	
   225	        memcpy(path, in_path->value, in_path->len);
   226	        pathlen = in_path->len;
   227	        pathtype = in_path->type;
   228	
   229	        sc_debug(card->ctx, SC_LOG_DEBUG_VERBOSE,
   230	                "path=%s, path->value=%s path->type=%d (%x)",
   231	                sc_print_path(in_path),
   232	                sc_dump_hex(in_path->value, in_path->len),
   233	                in_path->type, in_path->type);
   234	        sc_debug(card->ctx, SC_LOG_DEBUG_VERBOSE, "file_out=%p index=%d count=%d\n",
   235	                file_out, in_path->index, in_path->count);
   236	
   237	        /* Sigh, iso7816_select_file expects paths to keys to have specific
   238	         * formats. There is no override. We have to add some bytes to the
   239	         * path to make it happy.
   240	         * We only need to do this for private keys.
   241	         */
   242	        if ((pathlen > 2) && (pathlen <= 4) && memcmp(path, "\x3F\x00", 2) == 0) {
   243	                path += 2;
   244	                pathlen -= 2;
   245	        }
   246	
   247	
   248	        /* CAC has multiple different type of objects that aren't PKCS #15. When we read
   249	         * them we need convert them to something PKCS #15 would understand. Find the object
   250	         * and object type here:
   251	         */
   252	        if (priv) { /* don't record anything if we haven't been initialized yet */
   253	                /* forget any old cached values */
   254	                if (priv->cache_buf) {
   255	                        free(priv->cache_buf);
   256	                        priv->cache_buf = NULL;
   257	                }
   258	                priv->cache_buf_len = 0;
   259	                priv->cached = 0;
   260	        }
   261	
   262	        if (in_path->aid.len) {
   263	                if (!pathlen) {
   264	                        memcpy(path, in_path->aid.value, in_path->aid.len);
   265	                        pathlen = in_path->aid.len;
   266	                        pathtype = SC_PATH_TYPE_DF_NAME;
   267	                } else {
   268	                        /* First, select the application */
   269	                        sc_debug(card->ctx, SC_LOG_DEBUG_VERBOSE,"select application" );
   270	                        sc_format_apdu(card, &apdu, SC_APDU_CASE_3_SHORT, 0xA4, 4, 0);
   271	                        apdu.data = in_path->aid.value;
   272	                        apdu.datalen = in_path->aid.len;
   273	                        apdu.lc = in_path->aid.len;
   274	
   275	                        r = sc_transmit_apdu(card, &apdu);
   276	                        LOG_TEST_RET(ctx, r, "APDU transmit failed");
   277	                        r = sc_check_sw(card, apdu.sw1, apdu.sw2);
   278	                        if (r)
   279	                                LOG_FUNC_RETURN(ctx, r);
   280	
   281	                }
   282	        }
   283	
   284	        sc_format_apdu(card, &apdu, SC_APDU_CASE_4_SHORT, 0xA4, 0, 0);
   285	
   286	        switch (pathtype) {
   287	        /* ideally we would had SC_PATH_TYPE_OBJECT_ID and add code to the iso7816 select.
   288	         * Unfortunately we'd also need to update the caching code as well. For now just
   289	         * use FILE_ID and change p1 here */
   290	        case SC_PATH_TYPE_FILE_ID:
   291	                apdu.p1 = 2;
   292	                if (pathlen != 2)
   293	                        return SC_ERROR_INVALID_ARGUMENTS;
   294	                break;
   295	        case SC_PATH_TYPE_DF_NAME:
   296	                apdu.p1 = 4;
   297	                break;
   298	        default:
   299	                LOG_FUNC_RETURN(ctx, SC_ERROR_INVALID_ARGUMENTS);
   300	        }
   301	        apdu.lc = pathlen;
   302	        apdu.data = path;
   303	        apdu.datalen = pathlen;
   304	        apdu.resp = buf;
   305	        apdu.resplen = sizeof(buf);
   306	        apdu.le = sc_get_max_recv_size(card) < 256 ? sc_get_max_recv_size(card) : 256;
   307	        apdu.p2 = 0x00;
   308	
   309	        r = sc_transmit_apdu(card, &apdu);
   310	        LOG_TEST_RET(ctx, r, "APDU transmit failed");
   311	
   312	        if (file_out == NULL) {
   313	                /* For some cards 'SELECT' can be only with request to return FCI/FCP. */
   314	                r = sc_check_sw(card, apdu.sw1, apdu.sw2);
   315	                if (apdu.sw1 == 0x6A && apdu.sw2 == 0x86)   {
   316	                        apdu.p2 = 0x00;
   317	                        apdu.resplen = sizeof(buf);
   318	                        if (sc_transmit_apdu(card, &apdu) == SC_SUCCESS)
   319	                                r = sc_check_sw(card, apdu.sw1, apdu.sw2);
   320	                }
   321	                if (apdu.sw1 == 0x61)
   322	                        LOG_FUNC_RETURN(ctx, SC_SUCCESS);
   323	                LOG_FUNC_RETURN(ctx, r);
   324	        }
   325	
   326	        r = sc_check_sw(card, apdu.sw1, apdu.sw2);
   327	        if (r)
   328	                LOG_FUNC_RETURN(ctx, r);
   329	
   330	        /* CAC cards never return FCI, fake one */
   331	        file = sc_file_new();
   332	        if (file == NULL)
   333	                        LOG_FUNC_RETURN(ctx, SC_ERROR_OUT_OF_MEMORY);
   334	        file->path = *in_path;
   335	        file->size = CAC_MAX_SIZE; /* we don't know how big, just give a large size until we can read the file */
   336	
   337	        *file_out = file;
   338	        LOG_FUNC_RETURN(ctx, SC_SUCCESS);
   339	
   340	}
   341	
   342	static int cac_select_file(sc_card_t *card, const sc_path_t *in_path, sc_file_t **file_out)
   343	{
   344	        return cac_select_file_by_type(card, in_path, file_out);
   345	}
   346	
   347	static int cac_finish(sc_card_t *card)
   348	{
   349	        cac_private_data_t * priv = CAC_DATA(card);
   350	
   351	        SC_FUNC_CALLED(card->ctx, SC_LOG_DEBUG_VERBOSE);
   352	        if (priv) {
   353	                cac_free_private_data(priv);
   354	        }
   355	        return SC_SUCCESS;
   356	}
