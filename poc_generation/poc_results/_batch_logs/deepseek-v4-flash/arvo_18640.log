   466	int sc_lock(sc_card_t *card)
   467	{
   468	        int r = 0, r2 = 0;
   469	        int was_reset = 0;
   470	        int reader_lock_obtained  = 0;
   471	
   472	        if (card == NULL)
   473	                return SC_ERROR_INVALID_ARGUMENTS;
   474	
   475	        LOG_FUNC_CALLED(card->ctx);
   476	
   477	        r = sc_mutex_lock(card->ctx, card->mutex);
   478	        if (r != SC_SUCCESS)
   479	                return r;
   480	        if (card->lock_count == 0) {
   481	                if (card->reader->ops->lock != NULL) {
   482	                        r = card->reader->ops->lock(card->reader);
   483	                        while (r == SC_ERROR_CARD_RESET || r == SC_ERROR_READER_REATTACHED) {
   484	                                sc_invalidate_cache(card);
   485	                                if (was_reset++ > 4) /* TODO retry a few times */
   486	                                        break;
   487	                                r = card->reader->ops->lock(card->reader);
   488	                        }
   489	                        if (r == 0)
   490	                                reader_lock_obtained = 1;
   491	                }
   492	                if (r == 0)
   493	                        card->cache.valid = 1;
   494	        }
   495	        if (r == 0)
   496	                card->lock_count++;
   497	
   498	        if (r == 0 && was_reset > 0) {
   499	#ifdef ENABLE_SM
   500	                if (card->sm_ctx.ops.open)
   501	                        card->sm_ctx.ops.open(card);
   502	#endif
   503	        }
   504	
   505	        r2 = sc_mutex_unlock(card->ctx, card->mutex);
   506	        if (r2 != SC_SUCCESS) {
   507	                sc_log(card->ctx, "unable to release card->mutex lock");
   508	                r = r != SC_SUCCESS ? r : r2;
   509	        }
   510	
   511	        /* give card driver a chance to do something when reader lock first obtained */
   512	        if (r == 0 && reader_lock_obtained == 1  && card->ops->card_reader_lock_obtained)
   513	                r = card->ops->card_reader_lock_obtained(card, was_reset);
   514	
   515	        LOG_FUNC_RETURN(card->ctx, r);
   516	}
   517	
   518	int sc_unlock(sc_card_t *card)
   519	{
   520	        int r, r2;
   521	
   522	        if (!card)
   523	                return SC_ERROR_INVALID_ARGUMENTS;
   524	
   525	        LOG_FUNC_CALLED(card->ctx);
   526	
   527	        r = sc_mutex_lock(card->ctx, card->mutex);
   528	        if (r != SC_SUCCESS)
   529	                return r;
   530	
   531	        if (card->lock_count < 1) {
   532	                return SC_ERROR_INVALID_ARGUMENTS;
   533	        }
   534	        if (--card->lock_count == 0) {
   535	                if (card->flags & SC_CARD_FLAG_KEEP_ALIVE) {
   536	                        /* Multiple processes accessing the card will most likely render
   537	                         * the card cache useless. To not have a bad cache, we explicitly
   538	                         * invalidate it. */
   539	                        sc_invalidate_cache(card);
   540	                }
   541	                /* release reader lock */
   542	                if (card->reader->ops->unlock != NULL)
   543	                        r = card->reader->ops->unlock(card->reader);
   544	        }
   545	        r2 = sc_mutex_unlock(card->ctx, card->mutex);
   546	        if (r2 != SC_SUCCESS) {
   547	                sc_log(card->ctx, "unable to release lock");
   548	                r = (r == SC_SUCCESS) ? r2 : r;
   549	        }
   550	
   551	        return r;
   552	}
