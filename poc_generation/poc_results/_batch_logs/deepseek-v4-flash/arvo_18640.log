int sc_connect_card(sc_reader_t *reader, sc_card_t **card_out)
{
        sc_card_t *card;
        sc_context_t *ctx;
        struct sc_card_driver *driver;
        int i, r = 0, idx, connected = 0;

        if (card_out == NULL || reader == NULL)
                return SC_ERROR_INVALID_ARGUMENTS;
