#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

/* Simulate the vulnerable function's behavior */
#define CAC_MAX_SIZE 4096

typedef struct {
    const uint8_t *Data;
    size_t Size;
    size_t pos;
} fuzz_state_t;

static fuzz_state_t g_state;

void fuzz_get_chunk(const uint8_t **chunk, uint16_t *chunk_size)
{
    if (g_state.pos + 2 > g_state.Size) {
        *chunk = NULL;
        *chunk_size = 0;
        return;
    }
    *chunk_size = g_state.Data[g_state.pos];
    g_state.pos += 2;
    *chunk = g_state.Data + g_state.pos;
    if (g_state.Size - g_state.pos < *chunk_size) {
        *chunk_size = g_state.Size - g_state.pos;
    }
    g_state.pos += *chunk_size;
}

int fuzz_reader_transmit(unsigned char *resp, size_t *resplen, size_t le)
{
    const uint8_t *chunk;
    uint16_t chunk_size;
    
    fuzz_get_chunk(&chunk, &chunk_size);
    
    if (chunk_size >= 2) {
        /* sw1/sw2 are last 2 bytes */
        unsigned int sw1 = chunk[chunk_size - 2];
        unsigned int sw2 = chunk[chunk_size - 1];
        chunk_size -= 2;
        
        if (chunk_size <= *resplen)
            *resplen = chunk_size;
        /* if chunk_size > *resplen, *resplen stays unchanged */
        
        if (*resplen != 0)
            memcpy(resp, chunk, *resplen);
        
        return sw1; /* return sw1 as "status" */
    }
    *resplen = 0;
    return 0x6D;
}

/* Simulate the vulnerable function */
int cac_cac1_get_certificate(unsigned char **out_buf, size_t *out_len)
{
    unsigned char buf[CAC_MAX_SIZE];
    unsigned char *out_ptr;
    size_t size = 0;
    size_t left = 0;
    size_t len, next_len;
    int r = 0;
    
    size = left = *out_buf ? *out_len : sizeof(buf);
    out_ptr = *out_buf ? *out_buf : buf;
    
    next_len = (left < 100) ? left : 100;
    for (; left > 0; left -= len, out_ptr += len) {
        len = next_len;
        /* apdu.resp = out_ptr; apdu.le = len; apdu.resplen = left; */
        size_t resplen = left;
        
        /* Simulate transmit */
        int sw1 = fuzz_reader_transmit(out_ptr, &resplen, len);
        
        if (resplen == 0) {
            break;
        }
        
        /* In CAC-1, 0x63 means 'more data' */
        if (sw1 != 0x63) {
            left -= len;
            break;
        }
        next_len = (left < resplen) ? left : resplen;
        /* Note: sw2 would be used, but we use resplen as approximation */
        if (next_len > 100) next_len = 100;
    }
    
    r = size - left;
    if (*out_buf == NULL) {
        *out_buf = malloc(r);
        if (*out_buf == NULL) {
            return -1;
        }
        memcpy(*out_buf, buf, r);
    }
    *out_len = r;
    return r;
}

int main(int argc, char **argv)
{
    if (argc < 2) {
        printf("Usage: %s <input_file>\n", argv[0]);
        return 1;
    }
    
    FILE *f = fopen(argv[1], "rb");
    if (!f) { perror("fopen"); return 1; }
    fseek(f, 0, SEEK_END);
    long sz = ftell(f);
    fseek(f, 0, SEEK_SET);
    unsigned char *data = malloc(sz);
    fread(data, 1, sz, f);
    fclose(f);
    
    g_state.Data = data;
    g_state.Size = sz;
    g_state.pos = 0;
    
    unsigned char *out_buf = NULL;
    size_t out_len = 0;
    
    int r = cac_cac1_get_certificate(&out_buf, &out_len);
    printf("r=%d out_len=%zu\n", r, out_len);
    
    free(out_buf);
    free(data);
    return 0;
}
