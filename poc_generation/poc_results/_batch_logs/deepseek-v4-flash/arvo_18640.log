   441	int sc_reset(sc_card_t *card, int do_cold_reset)
   442	{
   443	        int r, r2;
   444	
   445	        if (card == NULL)
   446	                return SC_ERROR_INVALID_ARGUMENTS;
   447	        if (card->reader->ops->reset == NULL)
   448	                return SC_ERROR_NOT_SUPPORTED;
   449	
   450	        r = sc_mutex_lock(card->ctx, card->mutex);
   451	        if (r != SC_SUCCESS)
   452	                return r;
   453	
   454	        r = card->reader->ops->reset(card->reader, do_cold_reset);
   455	        sc_invalidate_cache(card);
   456	
   457	        r2 = sc_mutex_unlock(card->ctx, card->mutex);
   458	        if (r2 != SC_SUCCESS) {
   459	                sc_log(card->ctx, "unable to release lock");
   460	                r = r != SC_SUCCESS ? r : r2;
   461	        }
   462	
   463	        return r;
   464	}
