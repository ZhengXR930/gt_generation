    }

    if ((params = ossl_param_bld_to_param(&tmpl)) == NULL)
        return 0;

    /* We export, the provider imports */
    rv = evp_keymgmt_import(to_keymgmt, to_keydata, OSSL_KEYMGMT_SELECT_ALL,
                            params);

    ossl_param_bld_free(params);
