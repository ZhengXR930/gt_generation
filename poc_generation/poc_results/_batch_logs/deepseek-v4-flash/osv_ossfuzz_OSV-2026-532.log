                flags = REG_EXTENDED|REG_NOSUB;
                if (strchr(s, 'i') != NULL)
                        flags |= REG_ICASE;
                if (regcomp(&r, pattern, flags) != 0)
                        return (xstrdup("0"));
                if (regexec(&r, text, 0, NULL, 0) != 0) {
                        regfree(&r);
                        return (xstrdup("0"));
                }
                regfree(&r);
        }
        return (xstrdup("1"));
}

