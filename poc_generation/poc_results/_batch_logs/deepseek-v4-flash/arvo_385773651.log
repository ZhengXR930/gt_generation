   grk_decompress_set_default_params(&parameters);
   grk_stream_params stream_params = {};
   stream_params.buf = const_cast<uint8_t*>(buf);
   stream_params.buf_len = len;
   codec = grk_decompress_init(&stream_params, &parameters);
   if(!codec)
