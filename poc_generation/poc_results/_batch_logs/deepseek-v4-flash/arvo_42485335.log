    {
      g_set_error_literal (error, G_URI_ERROR, parse_error,
                           _("Non-UTF-8 characters in URI"));
      g_free (decoded);
      return -1;
    }

  if (out)
    *out = g_steal_pointer (&decoded);

  g_free (decoded);
  return len;
}

static gboolean
uri_decode (gchar       **out,
            const gchar  *start,
            gsize         length,
            GUriFlags     flags,
            GUriError     parse_error,
            GError      **error)
{
