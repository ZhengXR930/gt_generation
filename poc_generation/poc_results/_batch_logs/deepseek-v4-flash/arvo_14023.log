    65  static uint transformFromMsDos(const char *buffer)
    66  {
    67      quint16 time = (uchar)buffer[0] | ((uchar)buffer[1] << 8);
    68      int h = time >> 11;
    69      int m = (time & 0x7ff) >> 5;
