   116  bool KArchive::createDevice(QIODevice::OpenMode mode)
   117  {
   118      switch (mode) {
   119      case QIODevice::WriteOnly:
   120          if (!d->fileName.isEmpty()) {
   121              // The use of QSaveFile can't be done in the ctor (no mode known yet)
   122              //qCDebug(KArchiveLog) << "Writing to a file using QSaveFile";
   123              d->saveFile = new QSaveFile(d->fileName);
   124              if (!d->saveFile->open(QIODevice::WriteOnly)) {
   125                  setErrorString(
   126                      tr("QSaveFile creation for %1 failed: %2")
   127                          .arg(d->fileName, d->saveFile->errorString()));
   128
   129                  delete d->saveFile;
   130                  d->saveFile = nullptr;
   131                  return false;
   132              }
   133              d->dev = d->saveFile;
   134              Q_ASSERT(d->dev);
   135          }
   136          break;
   137      case QIODevice::ReadOnly:
   138      case QIODevice::ReadWrite:
   139          // ReadWrite mode still uses QFile for now; we'd need to copy to the tempfile, in fact.
   140          if (!d->fileName.isEmpty()) {
   141              d->dev = new QFile(d->fileName);
   142              d->deviceOwned = true;
   143          }
   144          break; // continued below
   145      default:
   146          setErrorString(tr("Unsupported mode %1").arg(d->mode));
   147          return false;
   148      }
   149      return true;
   150  }
