  1226  bool KZip::doFinishWriting(qint64 size)
  1227  {
  1228      if (d->m_currentFile->encoding() == 8) {
  1229          // Finish
  1230          (void)d->m_currentDev->write(nullptr, 0);
  1231          delete d->m_currentDev;
  1232      }
  1233      // If 0, d->m_currentDev was device() - don't delete ;)
  1234      d->m_currentDev = nullptr;
  1235
  1236      Q_ASSERT(d->m_currentFile);
  1237      //qCDebug(KArchiveLog) << "fileName: " << d->m_currentFile->path();
  1238      //qCDebug(KArchiveLog) << "getpos (at): " << device()->pos();
  1239      d->m_currentFile->setSize(size);
  1240      int extra_field_len = 0;
  1241      if (d->m_extraField == ModificationTime) {
  1242          extra_field_len = 17;    // value also used in finishWriting()
  1243      }
  1244
  1245      const QByteArray encodedName = QFile::encodeName(d->m_currentFile->path());
  1246      int csize = device()->pos() -
  1247                  d->m_currentFile->headerStart() - 30 -
  1248                  encodedName.length() - extra_field_len;
  1249      d->m_currentFile->setCompressedSize(csize);
  1250      //qCDebug(KArchiveLog) << "usize: " << d->m_currentFile->size();
  1251      //qCDebug(KArchiveLog) << "csize: " << d->m_currentFile->compressedSize();
  1252      //qCDebug(KArchiveLog) << "headerstart: " << d->m_currentFile->headerStart();
  1253
  1254      //qCDebug(KArchiveLog) << "crc: " << d->m_crc;
  1255      d->m_currentFile->setCRC32(d->m_crc);
  1256
  1257      d->m_currentFile = nullptr;
  1258
  1259      // update saved offset for appending new files
  1260      d->m_offset = device()->pos();
  1261      return true;
  1262  }
