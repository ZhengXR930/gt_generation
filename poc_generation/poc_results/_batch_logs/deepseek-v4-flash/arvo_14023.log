    45  static void transformToMsDos(const QDateTime &_dt, char *buffer)
    46  {
    47      const QDateTime dt = _dt.isValid() ? _dt : QDateTime::currentDateTime();
    48      const quint16 time =
    49          (dt.time().hour() << 11)    // 5 bit hour
    50          | (dt.time().minute() << 5)   // 6 bit minute
    51          | (dt.time().second() >> 1);  // 5 bit double seconds
    52
    53      buffer[0] = char(time);
    54      buffer[1] = char(time >> 8);
    55
    56      const quint16 date =
    57          ((dt.date().year() - 1980) << 9) // 7 bit year 1980-based
    58          | (dt.date().month() << 5)           // 4 bit month
    59          | (dt.date().day());                 // 5 bit day
    60
    61      buffer[2] = char(date);
    62      buffer[3] = char(date >> 8);
    63  }
