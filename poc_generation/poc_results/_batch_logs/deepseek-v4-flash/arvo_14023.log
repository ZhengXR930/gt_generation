  1264  bool KZip::doWriteSymLink(const QString &name, const QString &target,
  1265                            const QString &user, const QString &group,
  1266                            mode_t perm, const QDateTime &atime, const QDateTime &mtime, const QDateTime &ctime)
  1267  {
  1268      // reassure that symlink flag is set, otherwise strange things happen on
  1269      // extraction
  1270      perm |= QT_STAT_LNK;
  1271      Compression c = compression();
  1272      setCompression(NoCompression);  // link targets are never compressed
  1273
  1274      if (!doPrepareWriting(name, user, group, 0, perm, atime, mtime, ctime)) {
  1275          setCompression(c);
  1276          return false;
  1277      }
  1278
  1279      QByteArray symlink_target = QFile::encodeName(target);
  1280      if (!writeData(symlink_target.constData(), symlink_target.length())) {
  1281          setCompression(c);
  1282          return false;
  1283      }
  1284
  1285      if (!finishWriting(symlink_target.length())) {
  1286          setCompression(c);
  1287          return false;
  1288      }
  1289
  1290      setCompression(c);
  1291      return true;
  1292  }
