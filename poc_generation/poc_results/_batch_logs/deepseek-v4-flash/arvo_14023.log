   152  bool KArchive::close()
   153  {
   154      if (!isOpen()) {
   155          setErrorString(tr("Archive already closed"));
   156          return false;    // already closed (return false or true? arguable...)
   157      }
   158
   159      // moved by holger to allow kzip to write the zip central dir
   160      // to the file in closeArchive()
   161      // DF: added d->dev so that we skip closeArchive if saving aborted.
   162      bool closeSucceeded = true;
   163      if (d->dev) {
   164          closeSucceeded = closeArchive();
   165          if (d->mode == QIODevice::WriteOnly && !closeSucceeded) {
   166              d->abortWriting();
   167          }
   168      }
   169
   170      if (d->dev && d->dev != d->saveFile) {
   171          d->dev->close();
   172      }
   173
   174      // if d->saveFile is not null then it is equal to d->dev.
   175      if (d->saveFile) {
   176          closeSucceeded = d->saveFile->commit();
   177          delete d->saveFile;
   178          d->saveFile = nullptr;
   179      }
   180      if (d->deviceOwned) {
   181          delete d->dev; // we created it ourselves in open()
   182      }
   183
   184      delete d->rootDir;
   185      d->rootDir = nullptr;
   186      d->mode = QIODevice::NotOpen;
   187      d->dev = nullptr;
   188      return closeSucceeded;
   189  }
