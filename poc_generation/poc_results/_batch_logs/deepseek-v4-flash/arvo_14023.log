   111          , newinfounix_seen(false)
   112      {
   113          ctime = mtime = atime = time(nullptr);
   114      }
   115  };
   116
   117  /** updates the parse information with the given extended timestamp extra field.
   118   * @param buffer start content of buffer known to contain an extended
   119   *  timestamp extra field (without magic & size)
   120   * @param size size of field content (must not count magic and size entries)
   121   * @param islocal true if this is a local field, false if central
   122   * @param pfi ParseFileInfo object to be updated
   123   * @return true if processing was successful
   124   */
   125  static bool parseExtTimestamp(const char *buffer, int size, bool islocal,
   126                                ParseFileInfo &pfi)
   127  {
   128      if (size < 1) {
   129          //qCDebug(KArchiveLog) << "premature end of extended timestamp (#1)";
   130          return false;
   131      }/*end if*/
   132      int flags = *buffer;        // read flags
   133      buffer += 1;
   134      size -= 1;
   135
   136      if (flags & 1) {        // contains modification time
   137          if (size < 4) {
   138              //qCDebug(KArchiveLog) << "premature end of extended timestamp (#2)";
   139              return false;
   140          }/*end if*/
   141          pfi.mtime = uint((uchar)buffer[0] | (uchar)buffer[1] << 8
   142                           | (uchar)buffer[2] << 16 | (uchar)buffer[3] << 24);
   143          buffer += 4;
   144          size -= 4;
   145      }/*end if*/
   146      // central extended field cannot contain more than the modification time
   147      // even if other flags are set
   148      if (!islocal) {
   149          pfi.exttimestamp_seen = true;
   150          return true;
   151      }/*end if*/
   152
   153      if (flags & 2) {        // contains last access time
   154          if (size < 4) {
   155              //qCDebug(KArchiveLog) << "premature end of extended timestamp (#3)";
   156              return true;
   157          }/*end if*/
   158          pfi.atime = uint((uchar)buffer[0] | (uchar)buffer[1] << 8
   159                           | (uchar)buffer[2] << 16 | (uchar)buffer[3] << 24);
   160          buffer += 4;
   161          size -= 4;
   162      }/*end if*/
   163
   164      if (flags & 4) {        // contains creation time
   165          if (size < 4) {
   166              //qCDebug(KArchiveLog) << "premature end of extended timestamp (#4)";
   167              return true;
   168          }/*end if*/
   169          pfi.ctime = uint((uchar)buffer[0] | (uchar)buffer[1] << 8
   170                           | (uchar)buffer[2] << 16 | (uchar)buffer[3] << 24);
   171          buffer += 4;
   172      }/*end if*/
   173
   174      pfi.exttimestamp_seen = true;
   175      return true;
   176  }
   177
   178  /** updates the parse information with the given Info-ZIP Unix old extra field.
   179   * @param buffer start of content of buffer known to contain an Info-ZIP
   180   *  Unix old extra field (without magic & size)
   181   * @param size size of field content (must not count magic and size entries)
   182   * @param islocal true if this is a local field, false if central
   183   * @param pfi ParseFileInfo object to be updated
   184   * @return true if processing was successful
   185   */
   186  static bool parseInfoZipUnixOld(const char *buffer, int size, bool islocal,
   187                                  ParseFileInfo &pfi)
   188  {
   189      // spec mandates to omit this field if one of the newer fields are available
   190      if (pfi.exttimestamp_seen || pfi.newinfounix_seen) {
   191          return true;
   192      }
   193
   194      if (size < 8) {
   195          //qCDebug(KArchiveLog) << "premature end of Info-ZIP unix extra field old";
   196          return false;
   197      }
   198
   199      pfi.atime = uint((uchar)buffer[0] | (uchar)buffer[1] << 8
   200                       | (uchar)buffer[2] << 16 | (uchar)buffer[3] << 24);
   201      buffer += 4;
   202      pfi.mtime = uint((uchar)buffer[0] | (uchar)buffer[1] << 8
   203                       | (uchar)buffer[2] << 16 | (uchar)buffer[3] << 24);
   204      buffer += 4;
   205      if (islocal && size >= 12) {
   206          pfi.uid = (uchar)buffer[0] | (uchar)buffer[1] << 8;
   207          buffer += 2;
   208          pfi.gid = (uchar)buffer[0] | (uchar)buffer[1] << 8;
   209          buffer += 2;
   210      }/*end if*/
   211      return true;
   212  }
   213
   214  #if 0 // not needed yet
   215  /** updates the parse information with the given Info-ZIP Unix new extra field.
   216   * @param buffer start of content of buffer known to contain an Info-ZIP
   217   *      Unix new extra field (without magic & size)
   218   * @param size size of field content (must not count magic and size entries)
   219   * @param islocal true if this is a local field, false if central
   220   * @param pfi ParseFileInfo object to be updated
   221   * @return true if processing was successful
   222   */
   223  static bool parseInfoZipUnixNew(const char *buffer, int size, bool islocal,
   224                                  ParseFileInfo &pfi)
   225  {
   226      if (!islocal) { // contains nothing in central field
   227          pfi.newinfounix = true;
   228          return true;
   229      }
   230
   231      if (size < 4) {
   232          qCDebug(KArchiveLog) << "premature end of Info-ZIP unix extra field new";
   233          return false;
   234      }
   235
   236      pfi.uid = (uchar)buffer[0] | (uchar)buffer[1] << 8;
   237      buffer += 2;
   238      pfi.gid = (uchar)buffer[0] | (uchar)buffer[1] << 8;
   239      buffer += 2;
   240
   241      pfi.newinfounix = true;
   242      return true;
   243  }
   244  #endif
   245
   246  /**
   247   * parses the extra field
   248   * @param buffer start of buffer where the extra field is to be found
   249   * @param size size of the extra field
   250   * @param islocal true if this is part of a local header, false if of central
   251   * @param pfi ParseFileInfo object which to write the results into
   252   * @return true if parsing was successful
   253   */
   254  static bool parseExtraField(const char *buffer, int size, bool islocal,
   255                              ParseFileInfo &pfi)
   256  {
   257      // extra field in central directory doesn't contain useful data, so we
   258      // don't bother parsing it
   259      if (!islocal) {
   260          return true;
   261      }
   262
   263      while (size >= 4) { // as long as a potential extra field can be read
   264          int magic = (uchar)buffer[0] | (uchar)buffer[1] << 8;
   265          buffer += 2;
   266          int fieldsize = (uchar)buffer[0] | (uchar)buffer[1] << 8;
   267          buffer += 2;
   268          size -= 4;
   269
   270          if (fieldsize > size) {
   271              //qCDebug(KArchiveLog) << "fieldsize: " << fieldsize << " size: " << size;
   272              //qCDebug(KArchiveLog) << "premature end of extra fields reached";
   273              break;
   274          }
   275
   276          switch (magic) {
   277          case 0x5455:        // extended timestamp
   278              if (!parseExtTimestamp(buffer, fieldsize, islocal, pfi)) {
   279                  return false;
   280              }
   281              break;
   282          case 0x5855:        // old Info-ZIP unix extra field
   283              if (!parseInfoZipUnixOld(buffer, fieldsize, islocal, pfi)) {
   284                  return false;
   285              }
   286              break;
   287  #if 0   // not needed yet
   288          case 0x7855:        // new Info-ZIP unix extra field
   289              if (!parseInfoZipUnixNew(buffer, fieldsize, islocal, pfi)) {
   290                  return false;
   291              }
   292              break;
   293  #endif
   294          default:
   295              /* ignore everything else */
   296              ;
   297          }/*end switch*/
   298
   299          buffer += fieldsize;
   300          size -= fieldsize;
   301      }/*wend*/
   302      return true;
   303  }
