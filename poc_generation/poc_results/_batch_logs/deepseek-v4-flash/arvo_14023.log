  1299  bool KZip::writeData(const char *data, qint64 size)
  1300  {
  1301      Q_ASSERT(d->m_currentFile);
  1302      Q_ASSERT(d->m_currentDev);
  1303      if (!d->m_currentFile || !d->m_currentDev) {
  1304          setErrorString(tr("No file or device"));
  1305          return false;
  1306      }
  1307
  1308      // crc to be calculated over uncompressed stuff...
  1309      // and they didn't mention it in their docs...
  1310      d->m_crc = crc32(d->m_crc, (const Bytef *) data, size);
  1311
  1312      qint64 written = d->m_currentDev->write(data, size);
  1313      //qCDebug(KArchiveLog) << "wrote" << size << "bytes.";
  1314      const bool ok = written == size;
  1315
  1316      if (!ok) {
  1317          setErrorString(
  1318              tr("Error writing data: %1")
  1319              .arg(d->m_currentDev->errorString()));
  1320      }
  1321
  1322      return ok;
  1323  }
