   496	bool PcapFileWriterDevice::open()
   497	{
   498	        if (m_PcapDescriptor != NULL)
   499	        {
   500	                LOG_DEBUG("Pcap descriptor already opened. Nothing to do");
   501	                return true;
   502	        }
   503	
   504	        switch(m_PcapLinkLayerType)
   505	        {
   506	                case LINKTYPE_RAW:
   507	                case LINKTYPE_DLT_RAW2:
   508	                        LOG_ERROR("The only Raw IP link type supported in libpcap/WinPcap/Npcap is LINKTYPE_DLT_RAW1, please use that instead");
   509	                        return false;
   510	                default:
   511	                        break;
   512	        }
   513	
   514	        m_NumOfPacketsNotWritten = 0;
   515	        m_NumOfPacketsWritten = 0;
   516	
   517	        m_PcapDescriptor = pcap_open_dead(m_PcapLinkLayerType, PCPP_MAX_PACKET_SIZE);
   518	        if (m_PcapDescriptor == NULL)
   519	        {
   520	                LOG_ERROR("Error opening file writer device for file '%s': pcap_open_dead returned NULL", m_FileName);
   521	                m_DeviceOpened = false;
   522	                return false;
   523	        }
   524	
   525	
   526	        m_PcapDumpHandler = pcap_dump_open(m_PcapDescriptor, m_FileName);
   527	        if (m_PcapDumpHandler == NULL)
   528	        {
   529	                LOG_ERROR("Error opening file writer device for file '%s': pcap_dump_open returned NULL with error: '%s'",
   530	                                m_FileName, pcap_geterr(m_PcapDescriptor));
   531	                m_DeviceOpened = false;
   532	                return false;
   533	        }
   534	
   535	        m_DeviceOpened = true;
   536	        LOG_DEBUG("File writer device for file '%s' opened successfully", m_FileName);
   537	        return true;
   538	}
   539	
   540	void PcapFileWriterDevice::flush()
   541	{
   542	        if (!m_DeviceOpened)
   543	                return;
   544	
   545	        if (!m_AppendMode && pcap_dump_flush(m_PcapDumpHandler) == -1)
   546	        {
   547	                LOG_ERROR("Error while flushing the packets to file");
   548	        }
   549	        // in append mode it's impossible to use pcap_dump_flush, see comment above pcap_dump
   550	        else if (m_AppendMode && fflush(m_File) == EOF)
   551	        {
   552	                LOG_ERROR("Error while flushing the packets to file");
   553	        }
   554	
   555	}
   556	
   557	void PcapFileWriterDevice::close()
   558	{
   559	        if (!m_DeviceOpened)
   560	                return;
   561	
   562	        flush();
   563	
   564	        IFileDevice::close();
   565	
   566	        if (!m_AppendMode && m_PcapDumpHandler != NULL)
   567	        {
   568	                pcap_dump_close(m_PcapDumpHandler);
   569	        }
   570	        else if (m_AppendMode && m_File != NULL)
   571	        {
   572	                // in append mode it's impossible to use pcap_dump_close, see comment above pcap_dump
   573	                fclose(m_File);
   574	        }
   575	
   576	        m_PcapDumpHandler = NULL;
   577	        m_File = NULL;
   578	        LOG_DEBUG("File writer closed for file '%s'", m_FileName);
   579	}
