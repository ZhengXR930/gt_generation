   438	
   439	bool PcapFileWriterDevice::writePacket(RawPacket const& packet)
   440	{
   441	        if ((!m_AppendMode && m_PcapDescriptor == NULL) || (m_PcapDumpHandler == NULL))
   442	        {
   443	                LOG_ERROR("Device not opened");
   444	                m_NumOfPacketsNotWritten++;
   445	                return false;
   446	        }
   447	
   448	        if (packet.getLinkLayerType() != m_PcapLinkLayerType)
   449	        {
   450	                LOG_ERROR("Cannot write a packet with a different link layer type");
   451	                m_NumOfPacketsNotWritten++;
   452	                return false;
   453	        }
   454	
   455	        pcap_pkthdr pktHdr;
   456	        pktHdr.caplen = ((RawPacket&)packet).getRawDataLen();
   457	        pktHdr.len = ((RawPacket&)packet).getFrameLength();
   458	        timespec packet_timestamp = ((RawPacket&)packet).getPacketTimeStamp();
   459	        TIMESPEC_TO_TIMEVAL(&pktHdr.ts, &packet_timestamp);
   460	        if (!m_AppendMode)
   461	                pcap_dump((uint8_t*)m_PcapDumpHandler, &pktHdr, ((RawPacket&)packet).getRawData());
   462	        else
   463	        {
   464	                // Below are actually the lines run by pcap_dump. The reason I had to put them instead pcap_dump is that on Windows using WinPcap/Npcap
   465	                // you can't pass pointers between libraries compiled with different compilers. In this case - PcapPlusPlus and WinPcap/Npcap weren't
   466	                // compiled with the same compiler so it's impossible to fopen a file in PcapPlusPlus, pass the pointer to WinPcap/Npcap and use the
   467	                // FILE* pointer there. Doing this throws an exception. So the only option when implementing append to pcap is to write all relevant
   468	                // WinPcap/Npcap code that handles opening/closing/writing to pcap files inside PcapPlusPlus code
   469	
   470	                // the reason to create this packet_header struct is timeval has different sizes in 32-bit and 64-bit systems,
   471	                // but pcap format uses the 32-bit timeval version, so we need to align timeval to that
   472	                packet_header pktHdrTemp;
   473	                pktHdrTemp.tv_sec = pktHdr.ts.tv_sec;
   474	                pktHdrTemp.tv_usec = pktHdr.ts.tv_usec;
   475	                pktHdrTemp.caplen = pktHdr.caplen;
   476	                pktHdrTemp.len = pktHdr.len;
   477	                fwrite(&pktHdrTemp, sizeof(pktHdrTemp), 1, m_File);
   478	                fwrite(((RawPacket&)packet).getRawData(), pktHdrTemp.caplen, 1, m_File);
   479	        }
   480	        LOG_DEBUG("Packet written successfully to '%s'", m_FileName);
   481	        m_NumOfPacketsWritten++;
   482	        return true;
   483	}
   484	
   485	bool PcapFileWriterDevice::writePackets(const RawPacketVector& packets)
   486	{
   487	        for (RawPacketVector::ConstVectorIterator iter = packets.begin(); iter != packets.end(); iter++)
   488	        {
   489	                if (!writePacket(**iter))
   490	                        return false;
   491	        }
   492	
   493	        return true;
   494	}
