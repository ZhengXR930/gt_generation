   212	otError Mle::Enable(void)
   213	{
   214	    otError       error = OT_ERROR_NONE;
   215	    Ip6::SockAddr sockaddr;
   216	
   217	    UpdateLinkLocalAddress();
   218	    sockaddr.mPort = kUdpPort;
   219	    SuccessOrExit(error = mSocket.Open(&Mle::HandleUdpReceive, this));
   220	    SuccessOrExit(error = mSocket.Bind(sockaddr));
   221	
   222	exit:
   223	    return error;
   224	}
   225	
   226	otError Mle::Disable(void)
   227	{
   228	    otError error = OT_ERROR_NONE;
   229	
   230	    Stop(false);
   231	    SuccessOrExit(error = mSocket.Close());
   232	    SuccessOrExit(error = Get<ThreadNetif>().RemoveUnicastAddress(mLinkLocal64));
   233	
   234	exit:
   235	    return error;
   236	}
