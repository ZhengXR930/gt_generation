   238	otError Mle::Start(bool aAnnounceAttach)
   239	{
   240	    otError error = OT_ERROR_NONE;
   241	
   242	    // cannot bring up the interface if IEEE 802.15.4 promiscuous mode is enabled
   243	    VerifyOrExit(otPlatRadioGetPromiscuous(&GetInstance()) == false, error = OT_ERROR_INVALID_STATE);
   244	    VerifyOrExit(Get<ThreadNetif>().IsUp(), error = OT_ERROR_INVALID_STATE);
   245	
   246	    SetStateDetached();
   247	
   248	    ApplyMeshLocalPrefix();
   249	    SetRloc16(GetRloc16());
   250	
   251	    mAttachCounter = 0;
   252	
   253	    Get<KeyManager>().Start();
   254	
   255	    if (!aAnnounceAttach)
   256	    {
   257	        mReattachState = kReattachStart;
   258	    }
   259	
   260	    if (aAnnounceAttach || (GetRloc16() == Mac::kShortAddrInvalid))
   261	    {
   262	        BecomeChild(kAttachAny);
   263	    }
   264	    else if (IsActiveRouter(GetRloc16()))
   265	    {
   266	        if (Get<MleRouter>().BecomeRouter(ThreadStatusTlv::kTooFewRouters) != OT_ERROR_NONE)
   267	        {
   268	            BecomeChild(kAttachAny);
   269	        }
   270	    }
   271	    else
   272	    {
   273	        mChildUpdateAttempts = 0;
   274	        SendChildUpdateRequest();
   275	    }
   276	
   277	exit:
   278	    return error;
   279	}
   280	
   281	void Mle::Stop(bool aClearNetworkDatasets)
   282	{
   283	    if (aClearNetworkDatasets)
   284	    {
   285	        Get<MeshCoP::ActiveDataset>().HandleDetach();
   286	        Get<MeshCoP::PendingDataset>().HandleDetach();
   287	    }
   288	
   289	    VerifyOrExit(mRole != OT_DEVICE_ROLE_DISABLED);
   290	
   291	    Get<KeyManager>().Stop();
   292	    SetStateDetached();
   293	    Get<ThreadNetif>().UnsubscribeMulticast(mRealmLocalAllThreadNodes);
   294	    Get<ThreadNetif>().UnsubscribeMulticast(mLinkLocalAllThreadNodes);
   295	    Get<ThreadNetif>().RemoveUnicastAddress(mMeshLocal16);
   296	    Get<ThreadNetif>().RemoveUnicastAddress(mMeshLocal64);
   297	
   298	    SetRole(OT_DEVICE_ROLE_DISABLED);
   299	
   300	exit:
   301	    return;
   302	}
   303	
   304	void Mle::SetRole(otDeviceRole aRole)
   305	{
   306	    VerifyOrExit(aRole != mRole, Get<Notifier>().SignalIfFirst(OT_CHANGED_THREAD_ROLE));
   307	
   308	    otLogNoteMle("Role %s -> %s", RoleToString(mRole), RoleToString(aRole));
   309	
   310	    mRole = aRole;
   311	    Get<Notifier>().Signal(OT_CHANGED_THREAD_ROLE);
   312	
   313	    switch (mRole)
   314	    {
   315	    case OT_DEVICE_ROLE_DISABLED:
   316	        mCounters.mDisabledRole++;
   317	        break;
   318	    case OT_DEVICE_ROLE_DETACHED:
   319	        mCounters.mDetachedRole++;
   320	        break;
   321	    case OT_DEVICE_ROLE_CHILD:
   322	        mCounters.mChildRole++;
   323	        break;
   324	    case OT_DEVICE_ROLE_ROUTER:
   325	        mCounters.mRouterRole++;
   326	        break;
   327	    case OT_DEVICE_ROLE_LEADER:
   328	        mCounters.mLeaderRole++;
   329	        break;
   330	    }
   331	
   332	#if OPENTHREAD_ENABLE_BORDER_AGENT
   333	    if (IsAttached())
   334	    {
   335	        SuccessOrExit(Get<MeshCoP::BorderAgent>().Start());
   336	    }
   337	    else
   338	    {
   339	        SuccessOrExit(Get<MeshCoP::BorderAgent>().Stop());
   340	    }
   341	#endif
   342	
   343	exit:
   344	    return;
   345	}
