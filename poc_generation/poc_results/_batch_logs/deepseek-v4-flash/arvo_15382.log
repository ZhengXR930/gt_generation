   357	otError Mle::Restore(void)
   358	{
   359	    otError               error = OT_ERROR_NONE;
   360	    Settings::NetworkInfo networkInfo;
   361	    Settings::ParentInfo  parentInfo;
   362	
   363	    Get<MeshCoP::ActiveDataset>().Restore();
   364	    Get<MeshCoP::PendingDataset>().Restore();
   365	
   366	    SuccessOrExit(error = Get<Settings>().ReadNetworkInfo(networkInfo));
   367	
   368	    Get<KeyManager>().SetCurrentKeySequence(networkInfo.mKeySequence);
   369	    Get<KeyManager>().SetMleFrameCounter(networkInfo.mMleFrameCounter);
   370	    Get<KeyManager>().SetMacFrameCounter(networkInfo.mMacFrameCounter);
   371	
   372	    switch (networkInfo.mRole)
   373	    {
   374	    case OT_DEVICE_ROLE_CHILD:
   375	    case OT_DEVICE_ROLE_ROUTER:
   376	    case OT_DEVICE_ROLE_LEADER:
   377	        break;
   378	
   379	    default:
   380	        ExitNow();
   381	    }
   382	
   383	    mDeviceMode = networkInfo.mDeviceMode;
   384	    Get<Mac::Mac>().SetShortAddress(networkInfo.mRloc16);
   385	    Get<Mac::Mac>().SetExtAddress(networkInfo.mExtAddress);
   386	
   387	    memcpy(&mMeshLocal64.GetAddress().mFields.m8[OT_IP6_PREFIX_SIZE], networkInfo.mMlIid,
   388	           OT_IP6_ADDRESS_SIZE - OT_IP6_PREFIX_SIZE);
   389	
   390	    if (networkInfo.mRloc16 == Mac::kShortAddrInvalid)
   391	    {
   392	        ExitNow();
   393	    }
   394	
   395	    if (!IsActiveRouter(networkInfo.mRloc16))
   396	    {
   397	        error = Get<Settings>().ReadParentInfo(parentInfo);
   398	
   399	        if (error != OT_ERROR_NONE)
   400	        {
   401	            // If the restored RLOC16 corresponds to an end-device, it
   402	            // is expected that the `ParentInfo` settings to be valid
   403	            // as well. The device can still recover from such an invalid
   404	            // setting by skipping the re-attach ("Child Update Request"
   405	            // exchange) and going through the full attach process.
   406	
   407	            otLogWarnMle("Invalid settings - no saved parent info with valid end-device RLOC16 0x%04x",
   408	                         networkInfo.mRloc16);
   409	            ExitNow();
   410	        }
   411	
   412	        memset(&mParent, 0, sizeof(mParent));
   413	        mParent.SetExtAddress(*static_cast<Mac::ExtAddress *>(&parentInfo.mExtAddress));
   414	        mParent.SetDeviceMode(ModeTlv::kModeFullThreadDevice | ModeTlv::kModeRxOnWhenIdle |
   415	                              ModeTlv::kModeFullNetworkData | ModeTlv::kModeSecureDataRequest);
   416	        mParent.SetRloc16(GetRloc16(GetRouterId(networkInfo.mRloc16)));
   417	        mParent.SetState(Neighbor::kStateRestored);
   418	
   419	#if OPENTHREAD_CONFIG_INFORM_PREVIOUS_PARENT_ON_REATTACH
   420	        mPreviousParentRloc = mParent.GetRloc16();
   421	#endif
   422	    }
   423	    else
   424	    {
   425	        Get<MleRouter>().SetRouterId(GetRouterId(GetRloc16()));
   426	        Get<MleRouter>().SetPreviousPartitionId(networkInfo.mPreviousPartitionId);
   427	        Get<MleRouter>().RestoreChildren();
   428	    }
   429	
   430	exit:
   431	    return error;
   432	}
