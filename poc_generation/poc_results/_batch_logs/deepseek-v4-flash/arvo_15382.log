   434	otError Mle::Store(void)
   435	{
   436	    otError               error = OT_ERROR_NONE;
   437	    Settings::NetworkInfo networkInfo;
   438	
   439	    memset(&networkInfo, 0, sizeof(networkInfo));
   440	
   441	    if (IsAttached())
   442	    {
   443	        // Only update network information while we are attached to
   444	        // avoid losing/overwriting previous information when a reboot
   445	        // occurs after a message is sent but before attaching.
   446	
   447	        networkInfo.mDeviceMode          = mDeviceMode;
   448	        networkInfo.mRole                = mRole;
   449	        networkInfo.mRloc16              = GetRloc16();
   450	        networkInfo.mPreviousPartitionId = mLeaderData.GetPartitionId();
   451	        networkInfo.mExtAddress          = Get<Mac::Mac>().GetExtAddress();
   452	        memcpy(networkInfo.mMlIid, &mMeshLocal64.GetAddress().mFields.m8[OT_IP6_PREFIX_SIZE], OT_IP6_IID_SIZE);
   453	
   454	        if (mRole == OT_DEVICE_ROLE_CHILD)
   455	        {
   456	            Settings::ParentInfo parentInfo;
