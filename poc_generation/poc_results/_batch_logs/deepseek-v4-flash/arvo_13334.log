   211	otError Mle::Enable(void)
   212	{
   213	    otError       error = OT_ERROR_NONE;
   214	    Ip6::SockAddr sockaddr;
   215	
   216	    UpdateLinkLocalAddress();
   217	    sockaddr.mPort = kUdpPort;
   218	    SuccessOrExit(error = mSocket.Open(&Mle::HandleUdpReceive, this));
   219	    SuccessOrExit(error = mSocket.Bind(sockaddr));
   220	
   221	exit:
   222	    return error;
   223	}
   224	
   225	otError Mle::Disable(void)
   226	{
   227	    otError error = OT_ERROR_NONE;
   228	
   229	    Stop(false);
   230	    SuccessOrExit(error = mSocket.Close());
   231	    SuccessOrExit(error = GetNetif().RemoveUnicastAddress(mLinkLocal64));
   232	
   233	exit:
   234	    return error;
   235	}
   236	
   237	otError Mle::Start(bool aAnnounceAttach)
   238	{
   239	    ThreadNetif &netif = GetNetif();
   240	    otError      error = OT_ERROR_NONE;
   241	
   242	    // cannot bring up the interface if IEEE 802.15.4 promiscuous mode is enabled
   243	    VerifyOrExit(otPlatRadioGetPromiscuous(&GetInstance()) == false, error = OT_ERROR_INVALID_STATE);
   244	    VerifyOrExit(netif.IsUp(), error = OT_ERROR_INVALID_STATE);
   245	
   246	    SetStateDetached();
   247	
   248	    ApplyMeshLocalPrefix();
   249	    SetRloc16(GetRloc16());
   250	
   251	    mAttachCounter = 0;
   252	
   253	    netif.GetKeyManager().Start();
   254	
   255	    if (!aAnnounceAttach)
   256	    {
   257	        mReattachState = kReattachStart;
   258	    }
   259	
   260	    if (aAnnounceAttach || (GetRloc16() == Mac::kShortAddrInvalid))
   261	    {
   262	        BecomeChild(kAttachAny);
   263	    }
   264	    else if (IsActiveRouter(GetRloc16()))
   265	    {
   266	        if (netif.GetMle().BecomeRouter(ThreadStatusTlv::kTooFewRouters) != OT_ERROR_NONE)
   267	        {
   268	            BecomeChild(kAttachAny);
   269	        }
   270	    }
   271	    else
   272	    {
   273	        mChildUpdateAttempts = 0;
   274	        SendChildUpdateRequest();
   275	    }
   276	
   277	exit:
   278	    return error;
   279	}
   280	
   281	void Mle::Stop(bool aClearNetworkDatasets)
   282	{
   283	    ThreadNetif &netif = GetNetif();
   284	
   285	    if (aClearNetworkDatasets)
   286	    {
   287	        netif.GetActiveDataset().HandleDetach();
   288	        netif.GetPendingDataset().HandleDetach();
   289	    }
   290	
   291	    VerifyOrExit(mRole != OT_DEVICE_ROLE_DISABLED);
   292	
   293	    netif.GetKeyManager().Stop();
   294	    SetStateDetached();
   295	    GetNetif().UnsubscribeMulticast(mRealmLocalAllThreadNodes);
   296	    GetNetif().UnsubscribeMulticast(mLinkLocalAllThreadNodes);
   297	    netif.RemoveUnicastAddress(mMeshLocal16);
   298	    netif.RemoveUnicastAddress(mMeshLocal64);
   299	
   300	    SetRole(OT_DEVICE_ROLE_DISABLED);
   301	
   302	exit:
   303	    return;
   304	}
   305	
   306	void Mle::SetRole(otDeviceRole aRole)
   307	{
   308	    VerifyOrExit(aRole != mRole, GetNotifier().SignalIfFirst(OT_CHANGED_THREAD_ROLE));
   309	
   310	    otLogNoteMle("Role %s -> %s", RoleToString(mRole), RoleToString(aRole));
   311	
   312	    mRole = aRole;
   313	    GetNotifier().Signal(OT_CHANGED_THREAD_ROLE);
   314	
   315	    switch (mRole)
   316	    {
   317	    case OT_DEVICE_ROLE_DISABLED:
   318	        mCounters.mDisabledRole++;
   319	        break;
   320	    case OT_DEVICE_ROLE_DETACHED:
   321	        mCounters.mDetachedRole++;
   322	        break;
   323	    case OT_DEVICE_ROLE_CHILD:
   324	        mCounters.mChildRole++;
   325	        break;
   326	    case OT_DEVICE_ROLE_ROUTER:
   327	        mCounters.mRouterRole++;
   328	        break;
   329	    case OT_DEVICE_ROLE_LEADER:
   330	        mCounters.mLeaderRole++;
   331	        break;
   332	    }
   333	
   334	#if OPENTHREAD_ENABLE_BORDER_AGENT
   335	    if (IsAttached())
   336	    {
   337	        SuccessOrExit(GetInstance().Get<MeshCoP::BorderAgent>().Start());
   338	    }
   339	    else
   340	    {
   341	        SuccessOrExit(GetInstance().Get<MeshCoP::BorderAgent>().Stop());
   342	    }
   343	#endif
   344	
   345	exit:
   346	    return;
   347	}
   348	
   349	void Mle::SetAttachState(AttachState aState)
   350	{
   351	    VerifyOrExit(aState != mAttachState);
   352	    otLogInfoMle("AttachState %s -> %s", AttachStateToString(mAttachState), AttachStateToString(aState));
   353	    mAttachState = aState;
   354	
