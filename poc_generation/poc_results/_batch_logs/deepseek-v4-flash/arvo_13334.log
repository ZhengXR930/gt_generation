   338	otError Dhcp6Client::AppendIaNa(Message &aMessage, uint16_t aRloc16)
   339	{
   340	    otError  error  = OT_ERROR_NONE;
   341	    uint8_t  count  = 0;
   342	    uint16_t length = 0;
   343	    IaNa     option;
   344	
   345	    VerifyOrExit(mIdentityAssociationCurrent != NULL, error = OT_ERROR_DROP);
   346	
   347	    for (uint8_t i = 0; i < OT_ARRAY_LENGTH(mIdentityAssociations); ++i)
   348	    {
   349	        if (mIdentityAssociations[i].mStatus == kIaStatusSolicitReplied)
   350	        {
   351	            continue;
   352	        }
   353	
   354	        if (mIdentityAssociations[i].mPrefixAgentRloc == aRloc16)
   355	        {
   356	            count++;
   357	        }
   358	    }
   359	
   360	    // compute the right length
   361	    length = sizeof(IaNa) + sizeof(IaAddress) * count - sizeof(Dhcp6Option);
   362	
   363	    option.Init();
   364	    option.SetLength(length);
   365	    option.SetIaid(0);
   366	    option.SetT1(0);
   367	    option.SetT2(0);
   368	    SuccessOrExit(error = aMessage.Append(&option, sizeof(IaNa)));
   369	
   370	exit:
   371	    return error;
   372	}
