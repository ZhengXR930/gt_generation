   413	void Dhcp6Client::HandleUdpReceive(Message &aMessage, const Ip6::MessageInfo &aMessageInfo)
   414	{
   415	    OT_UNUSED_VARIABLE(aMessageInfo);
   416	
   417	    Dhcp6Header header;
   418	
   419	    VerifyOrExit(aMessage.Read(aMessage.GetOffset(), sizeof(header), &header) == sizeof(header));
   420	    aMessage.MoveOffset(sizeof(header));
   421	
   422	    if ((header.GetType() == kTypeReply) && (!memcmp(header.GetTransactionId(), mTransactionId, kTransactionIdSize)))
   423	    {
   424	        ProcessReply(aMessage);
   425	    }
   426	
   427	exit:
   428	    return;
   429	}
   430	
   431	void Dhcp6Client::ProcessReply(Message &aMessage)
   432	{
   433	    uint16_t offset = aMessage.GetOffset();
   434	    uint16_t length = aMessage.GetLength() - aMessage.GetOffset();
   435	    uint16_t optionOffset;
   436	
   437	    // Server Identifier
   438	    VerifyOrExit((optionOffset = FindOption(aMessage, offset, length, kOptionServerIdentifier)) > 0);
   439	    SuccessOrExit(ProcessServerIdentifier(aMessage, optionOffset));
   440	
   441	    // Client Identifier
   442	    VerifyOrExit((optionOffset = FindOption(aMessage, offset, length, kOptionClientIdentifier)) > 0);
   443	    SuccessOrExit(ProcessClientIdentifier(aMessage, optionOffset));
   444	
   445	    // Rapid Commit
   446	    VerifyOrExit(FindOption(aMessage, offset, length, kOptionRapidCommit) > 0);
   447	
   448	    // IA_NA
   449	    VerifyOrExit((optionOffset = FindOption(aMessage, offset, length, kOptionIaNa)) > 0);
