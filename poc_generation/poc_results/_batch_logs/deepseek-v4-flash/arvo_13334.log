   151	                    iterator.SaveSubTlvOffset(subCur, prefix->GetSubTlvs());
   152	                    iterator.SetEntryIndex(index + 1);
   153	
   154	                    ExitNow(error = OT_ERROR_NONE);
   155	                }
   156	            }
   157	        }
   158	    }
   159	
   160	exit:
   161	    return error;
   162	}
