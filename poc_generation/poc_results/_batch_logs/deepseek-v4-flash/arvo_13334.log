   458	uint16_t Dhcp6Client::FindOption(Message &aMessage, uint16_t aOffset, uint16_t aLength, Dhcp6::Code aCode)
   459	{
   460	    uint16_t end  = aOffset + aLength;
   461	    uint16_t rval = 0;
   462	
   463	    while (aOffset <= end)
   464	    {
   465	        Dhcp6Option option;
   466	        VerifyOrExit(aMessage.Read(aOffset, sizeof(option), &option) == sizeof(option));
   467	
   468	        if (option.GetCode() == (aCode))
   469	        {
   470	            ExitNow(rval = aOffset);
   471	        }
   472	
   473	        aOffset += sizeof(option) + option.GetLength();
   474	    }
   475	
   476	exit:
   477	    return rval;
   478	}
