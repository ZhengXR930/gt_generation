   189	bool Dhcp6Client::ProcessNextIdentityAssociation()
   190	{
   191	    bool rval = false;
   192	
   193	    // not interrupt in-progress solicit
   194	    VerifyOrExit(mIdentityAssociationCurrent == NULL || mIdentityAssociationCurrent->mStatus != kIaStatusSoliciting);
   195	
   196	    mTrickleTimer.Stop();
   197	
   198	    for (uint8_t i = 0; i < OT_ARRAY_LENGTH(mIdentityAssociations); ++i)
   199	    {
   200	        if (mIdentityAssociations[i].mStatus != kIaStatusSolicit)
   201	        {
   202	            continue;
   203	        }
   204	
   205	        // new transaction id
   206	        Random::FillBuffer(mTransactionId, kTransactionIdSize);
   207	
   208	        mIdentityAssociationCurrent = &mIdentityAssociations[i];
   209	
   210	        mTrickleTimer.Start(TimerMilli::SecToMsec(kTrickleTimerImin), TimerMilli::SecToMsec(kTrickleTimerImax),
   211	                            TrickleTimer::kModeNormal);
   212	
   213	        mTrickleTimer.IndicateInconsistent();
   214	
   215	        ExitNow(rval = true);
   216	    }
   217	
   218	exit:
   219	    return rval;
   220	}
   221	
   222	bool Dhcp6Client::HandleTrickleTimer(TrickleTimer &aTrickleTimer)
   223	{
   224	    return aTrickleTimer.GetOwner<Dhcp6Client>().HandleTrickleTimer();
   225	}
   226	
   227	bool Dhcp6Client::HandleTrickleTimer(void)
   228	{
   229	    bool rval = true;
   230	
   231	    VerifyOrExit(mIdentityAssociationCurrent != NULL, rval = false);
   232	
   233	    switch (mIdentityAssociationCurrent->mStatus)
   234	    {
   235	    case kIaStatusSolicit:
   236	        mStartTime                           = TimerMilli::GetNow();
   237	        mIdentityAssociationCurrent->mStatus = kIaStatusSoliciting;
   238	
   239	        // fall through
   240	
   241	    case kIaStatusSoliciting:
   242	        Solicit(mIdentityAssociationCurrent->mPrefixAgentRloc);
   243	        break;
   244	
   245	    case kIaStatusSolicitReplied:
   246	        mIdentityAssociationCurrent = NULL;
   247	
   248	        if (!ProcessNextIdentityAssociation())
   249	        {
   250	            mTrickleTimer.Stop();
   251	            Stop();
   252	            rval = false;
   253	        }
   254	
   255	        break;
   256	
   257	    default:
   258	        break;
   259	    }
   260	
   261	exit:
   262	    return rval;
   263	}
   264	
   265	otError Dhcp6Client::Solicit(uint16_t aRloc16)
   266	{
   267	    ThreadNetif &    netif = GetNetif();
   268	    otError          error = OT_ERROR_NONE;
   269	    Message *        message;
   270	    Ip6::MessageInfo messageInfo;
   271	
   272	    VerifyOrExit((message = mSocket.NewMessage(0)) != NULL, error = OT_ERROR_NO_BUFS);
   273	
   274	    SuccessOrExit(error = AppendHeader(*message));
   275	    SuccessOrExit(error = AppendElapsedTime(*message));
   276	    SuccessOrExit(error = AppendClientIdentifier(*message));
   277	    SuccessOrExit(error = AppendIaNa(*message, aRloc16));
   278	    // specify which prefixes to solicit
   279	    SuccessOrExit(error = AppendIaAddress(*message, aRloc16));
   280	    SuccessOrExit(error = AppendRapidCommit(*message));
   281	
   282	    memcpy(messageInfo.GetPeerAddr().mFields.m8, netif.GetMle().GetMeshLocalPrefix().m8, sizeof(otMeshLocalPrefix));
   283	    messageInfo.GetPeerAddr().mFields.m16[4] = HostSwap16(0x0000);
   284	    messageInfo.GetPeerAddr().mFields.m16[5] = HostSwap16(0x00ff);
   285	    messageInfo.GetPeerAddr().mFields.m16[6] = HostSwap16(0xfe00);
   286	    messageInfo.GetPeerAddr().mFields.m16[7] = HostSwap16(aRloc16);
   287	    messageInfo.SetSockAddr(netif.GetMle().GetMeshLocal16());
   288	    messageInfo.mPeerPort    = kDhcpServerPort;
   289	    messageInfo.mInterfaceId = netif.GetInterfaceId();
   290	
   291	    SuccessOrExit(error = mSocket.SendTo(*message, messageInfo));
   292	    otLogInfoIp6("solicit");
   293	
   294	exit:
   295	
   296	    if (message != NULL && error != OT_ERROR_NONE)
   297	    {
   298	        message->Free();
   299	    }
   300	
   301	    return error;
   302	}
