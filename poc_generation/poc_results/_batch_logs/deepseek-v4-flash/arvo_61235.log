                            uInt *status) {
  decContext workset;         // work
  Int        etiny, adjust;   // ..

  #if DECSUBSET
  // simple set to zero and 'hard underflow' for subset
  if (!set->extended) {
    decNumberZero(dn);
    // always full overflow
    *status|=DEC_Underflow | DEC_Subnormal | DEC_Inexact | DEC_Rounded;
    return;
    }
  #endif

