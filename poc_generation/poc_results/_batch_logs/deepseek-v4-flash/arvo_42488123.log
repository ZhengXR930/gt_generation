/*
 *  http://ltsv.org
 *
 *  ltsv        = *(record NL) [record]
 *  record      = [field *(TAB field)]
 *  field       = label ":" field-value
 *  label       = 1*lbyte
 *  field-value = *fbyte
 *
 *  TAB   = %x09
 *  NL    = [%x0D] %x0A
 *  lbyte = %x30-39 / %x41-5A / %x61-7A / "_" / "." / "-" ;; [0-9A-Za-z_.-]
 *  fbyte = %x01-08 / %x0B / %x0C / %x0E-FF
 */

