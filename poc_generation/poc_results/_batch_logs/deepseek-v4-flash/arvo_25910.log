   403	// Use this to keep track of whether or not a child box that must be unique (0 or 1 present) has
   404	// been seen yet, when parsing a parent box. If the "seen" bit is already set for a given box when
   405	// it is encountered during parse, an error is thrown. Which bit corresponds to which box is
   406	// dictated entirely by the calling function.
   407	static avifBool uniqueBoxSeen(uint32_t * uniqueBoxFlags, uint32_t whichFlag)
   408	{
   409	    const uint32_t flag = 1 << whichFlag;
   410	    if (*uniqueBoxFlags & flag) {
   411	        // This box has already been seen. Error!
   412	        return AVIF_FALSE;
   413	    }
   414	
   415	    // Mark this box as seen.
   416	    *uniqueBoxFlags |= flag;
   417	    return AVIF_TRUE;
   418	}
