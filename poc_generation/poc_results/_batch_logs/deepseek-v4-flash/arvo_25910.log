void avifRWDataSet(avifRWData * raw, const uint8_t * data, size_t len)
{
    if (len) {
        avifRWDataRealloc(raw, len);
        memcpy(raw->data, data, len);
    } else {
        avifRWDataFree(raw);
    }
}

void avifRWDataFree(avifRWData * raw)
{
    avifFree(raw->data);
    raw->data = NULL;
    raw->size = 0;
}
