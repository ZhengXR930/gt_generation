#include <cstdint>
#include <cstdlib>
#include "avif/avif.h"
int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <avif_file>\n", argv[0]);
        return 1;
    }

    FILE *f = fopen(argv[1], "rb");
    if (!f) {
        fprintf(stderr, "Failed to open %s\n", argv[1]);
        return 1;
    }

    fseek(f, 0, SEEK_END);
    long size = ftell(f);
    fseek(f, 0, SEEK_SET);

    uint8_t *data = (uint8_t *)malloc(size);
    fread(data, 1, size, f);
    fclose(f);

    avifROData raw;
    raw.data = data;
    raw.size = size;

    avifDecoder *decoder = avifDecoderCreate();
    avifResult result = avifDecoderSetIOMemory(decoder, &raw);
    printf("avifDecoderSetIOMemory: %d\n", result);

    if (result == AVIF_RESULT_OK) {
        result = avifDecoderParse(decoder);
        printf("avifDecoderParse: %d\n", result);
    }

    if (result == AVIF_RESULT_OK) {
        printf("Image: %dx%d, depth=%d, yuvFormat=%d\n",
               decoder->image->width, decoder->image->height,
               decoder->image->depth, decoder->image->yuvFormat);

        for (int loop = 0; loop < 2; ++loop) {
            int frame = 0;
            while (avifDecoderNextImage(decoder) == AVIF_RESULT_OK) {
                printf("  Frame %d: %dx%d\n", frame++,
                       decoder->image->width, decoder->image->height);
            }

            if (loop != 1) {
                result = avifDecoderReset(decoder);
                printf("avifDecoderReset: %d\n", result);
                if (result != AVIF_RESULT_OK) break;
            }
        }
    }

    avifDecoderDestroy(decoder);
    free(data);
    return 0;
}
EOF


