static inline const char *findstr(const char *hay, size_t slen, const char *needle, bool ignore_case) {
  const char *ret = NULL;

  if (hay && slen && needle) {
    const size_t nlen = strlen(needle);
    if (nlen <= slen) {
      const size_t smax = slen - nlen + 1;
      const char *sp = hay;
