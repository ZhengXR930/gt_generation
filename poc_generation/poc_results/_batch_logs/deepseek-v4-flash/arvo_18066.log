#include "sass.h"
#include <cstring>
#include <cstdio>
int main(int argc, char* argv[]) {
  if (argc < 2) {
    fprintf(stderr, "Usage: %s <input_file>\n", argv[0]);
    return 1;
  }

  FILE* f = fopen(argv[1], "rb");
  if (!f) { perror("fopen"); return 1; }
  fseek(f, 0, SEEK_END);
  size_t size = ftell(f);
  fseek(f, 0, SEEK_SET);

  char* sass_data = (char*)malloc(size + 1);
  fread(sass_data, 1, size, f);
  sass_data[size] = '\0';
  fclose(f);

  struct Sass_Data_Context* ctx = sass_make_data_context(sass_data);
  struct Sass_Options* options = sass_make_options();
  sass_option_set_output_style(options, SASS_STYLE_NESTED);
  sass_option_set_precision(options, 5);
  sass_data_context_set_options(ctx, options);
  sass_compile_data_context(ctx);

  struct Sass_Context* ctx_out = sass_data_context_get_context(ctx);
  if (sass_context_get_error_status(ctx_out)) {
    fprintf(stderr, "Error: %s\n", sass_context_get_error_message(ctx_out));
  } else {
    fprintf(stdout, "Success: %s\n", sass_context_get_output_string(ctx_out));
  }

  sass_delete_data_context(ctx);
  sass_delete_options(options);
  return 0;
}
EOF
