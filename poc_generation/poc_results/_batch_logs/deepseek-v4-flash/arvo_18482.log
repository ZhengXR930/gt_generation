                sc_debug(ctx, SC_LOG_DEBUG_ASN1, "Looking for '%s', tag 0x%x%s%s\n",
                        entry->name, entry->tag, choice? ", CHOICE" : "",
                        (entry->flags & SC_ASN1_OPTIONAL)? ", OPTIONAL": "");

                /* Special case CHOICE has no tag */
                if (entry->type == SC_ASN1_CHOICE) {
