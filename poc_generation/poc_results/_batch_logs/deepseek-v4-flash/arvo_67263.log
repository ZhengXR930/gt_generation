                char *nl;
                nl = memchr(data, '\r', size);
                if (!nl)
                        nl = memchr(data, '\n', size);
                else
                        is_cr = GF_TRUE;

                if (nl)
                        line_size = (u32) (nl - (char *) data);
                else
                        line_size = size-1;

                //line is comment
                if (data[0] != '#') {
                        Bool line_empty = GF_TRUE;
                        for (i=0;i<line_size; i++) {
                                char c = (char) data[i];
                                if (!c) return NULL;
                                if ( isalnum(c)) continue;
                                //valid URL chars plus backslash for win path
                                if (strchr("-._~:/?#[]@!$&'()*+,;%=\\", c)) {
                                        line_empty = GF_FALSE;
                                        continue;
                                }
                                //not a valid URL
                                return NULL;
                        }
                        if (!line_empty)
                                nb_lines++;
                }
                if (!nl) break;
                size -= (u32) (nl+1 - (char *) data);
                data = nl+1;
                if (is_cr && (data[0]=='\n')) {
                        size --;
                        data++;
                }
