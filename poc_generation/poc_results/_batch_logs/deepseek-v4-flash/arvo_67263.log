                        ctx->transport = RTP_TRANSPORT_TCP_ONLY;
                if (ctx->src && !strnicmp(ctx->src, "rtsph://", 8))
                        ctx->transport = RTP_TRANSPORT_TCP_ONLY;
        }

        ctx->last_start_range = -1.0;

