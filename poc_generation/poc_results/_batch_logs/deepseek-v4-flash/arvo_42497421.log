#include <stdint.h>
#include <stddef.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include <fribidi.h>

static uint32_t g_buf[400];
static int g_len = 0;

void death_cb(void) {
  FILE* f = fopen("/tmp/crash.bin","wb");
  if (f) { fwrite(g_buf, 4, g_len, f); fclose(f); }
}

int LLVMFuzzerTestOneInput (const uint8_t *data, size_t size)
{
  const FriBidiStrIndex str_len = size / 4;
  FriBidiChar *str = (FriBidiChar *) data;
  FriBidiCharType *types = calloc (str_len, sizeof (FriBidiCharType));
  FriBidiBracketType *btypes = calloc (str_len, sizeof (FriBidiBracketType));
  FriBidiLevel *levels = calloc (str_len, sizeof (FriBidiLevel));
  fribidi_get_bidi_types (str, str_len, types);
  fribidi_get_bracket_types (str, str_len, types, btypes);
  FriBidiParType par_type = FRIBIDI_PAR_ON;
  FriBidiLevel level = fribidi_get_par_embedding_levels_ex (types, btypes, str_len, &par_type, levels);
  free (types);
  free (btypes);
  free (levels);
  return 0;
}

static uint32_t rng_state = 12345;
static uint32_t rng(void) {
  rng_state ^= rng_state << 13;
  rng_state ^= rng_state >> 17;
  rng_state ^= rng_state << 5;
  return rng_state;
}

int main(void) {
  __sanitizer_set_death_callback(death_cb);
  uint32_t alpha[] = {
    0x2066, 0x2067, 0x2068, 0x2069,
    0x202A, 0x202B, 0x202D, 0x202E, 0x202C,
    0x0041, 0x05D0, 0x0627, 0x0030, 0x0020,
    0x00AD, 0x200B, 0x2028, 0x000A, 0x0028, 0x0029,
    0x002B, 0x002C, 0x002E, 0x003A, 0x0023,
  };
  int nalpha = sizeof(alpha)/sizeof(alpha[0]);
  for (long iter = 0; iter < 5000000; iter++) {
    int len = 1 + (rng() % 400);
    for (int i = 0; i < len; i++) {
      if (rng() % 3 == 0) g_buf[i] = alpha[rng() % 4];
      else g_buf[i] = alpha[rng() % nalpha];
    }
    g_len = len;
    LLVMFuzzerTestOneInput((uint8_t*)g_buf, len*4);
  }
  printf("done no crash\n");
  return 0;
}
EOF
