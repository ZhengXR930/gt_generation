            goto cleanup;
        }
    }

    ctx->varinfo[ctx->var_index] = info;

    ctx->var_index++;
    ctx->var_offset++;

cleanup:
    if (retval != READSTAT_OK) {
        spss_varinfo_free(info);
    }

    return retval;
