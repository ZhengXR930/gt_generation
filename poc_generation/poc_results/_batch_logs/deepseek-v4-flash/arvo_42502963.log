        /*
         *      If the data is variable length i.e. strings or octets
         *      there is a length field before each element.
         *
         *   +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-...-+-+-+-+-+-+-+
         *   |       text-len                |        String                 |
         *   +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-...-+-+-+-+-+-+-+
         */
        while (p < end) {
