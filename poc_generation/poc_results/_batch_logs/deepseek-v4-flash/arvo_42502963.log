                        if (!vp) return PAIR_DECODE_OOM;

                        vp->vp_ip.af = AF_INET6;
                        vp->vp_ip.scope_id = 0;
                        vp->vp_ip.prefix = 0;
                        memset(&vp->vp_ipv6addr, 0, sizeof(vp->vp_ipv6addr));
                        break;
