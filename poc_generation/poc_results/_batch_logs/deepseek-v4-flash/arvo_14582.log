   436	static void parse_fragment_and_query(struct lwan_request *request,
   437	                                     const char *space)
   438	{
   439	    struct lwan_request_parser_helper *helper = request->helper;
   440	
   441	    /* Most of the time, fragments are small -- so search backwards */
   442	    char *fragment = memrchr(request->url.value, '#', request->url.len);
   443	    if (fragment) {
   444	        *fragment = '\0';
   445	        helper->fragment.value = fragment + 1;
   446	        helper->fragment.len = (size_t)(space - fragment - 1);
   447	        request->url.len -= helper->fragment.len + 1;
   448	    }
   449	
   450	    /* Most of the time, query string values are larger than the URL, so
   451	       search from the beginning */
   452	    char *query_string = memchr(request->url.value, '?', request->url.len);
   453	    if (query_string) {
   454	        *query_string = '\0';
   455	        helper->query_string.value = query_string + 1;
   456	        helper->query_string.len =
   457	            (size_t)((fragment ? fragment : space) - query_string - 1);
   458	        request->url.len -= helper->query_string.len + 1;
   459	    }
   460	}
