   305	static ssize_t url_decode(char *str)
   306	{
   307	    if (UNLIKELY(!str))
   308	        return -EINVAL;
   309	
   310	    char *ch, *decoded;
   311	    for (decoded = ch = str; *ch; ch++) {
   312	        if (*ch == '%') {
   313	            char tmp =
   314	                (char)(decode_hex_digit(ch[1]) << 4 | decode_hex_digit(ch[2]));
   315	
   316	            if (UNLIKELY(!tmp))
   317	                return -EINVAL;
   318	
   319	            *decoded++ = tmp;
   320	            ch += 2;
   321	        } else if (*ch == '+') {
   322	            *decoded++ = ' ';
   323	        } else {
   324	            *decoded++ = *ch;
   325	        }
   326	    }
   327	
   328	    *decoded = '\0';
   329	    return (ssize_t)(decoded - str);
   330	}
