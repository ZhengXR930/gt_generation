   494	    case MULTICHAR_CONSTANT_LARGE('H','T','T','P','/','1','.','0'):
   495	        request->flags |= REQUEST_IS_HTTP_1_0;
   496	        break;
   497	    case MULTICHAR_CONSTANT_LARGE('H','T','T','P','/','1','.','1'):
   498	        break;
   499	    default:
   500	        return NULL;
   501	    }
   502	
   503	    return end_of_line + 1;
   504	}
