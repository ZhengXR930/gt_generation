   462	static char *
   463	identify_http_path(struct lwan_request *request, char *buffer)
   464	{
   465	    struct lwan_request_parser_helper *helper = request->helper;
   466	    static const size_t minimal_request_line_len = sizeof("/ HTTP/1.0") - 1;
   467	    char *space, *end_of_line;
   468	    ptrdiff_t end_len;
   469	
   470	    if (UNLIKELY(*buffer != '/'))
   471	        return NULL;
   472	
   473	    end_len = buffer - helper->buffer->value;
   474	    if (UNLIKELY((size_t)end_len >= helper->buffer->len))
   475	        return NULL;
   476	
   477	    end_of_line = memchr(buffer, '\r', helper->buffer->len - (size_t)end_len);
   478	    if (UNLIKELY(!end_of_line))
   479	        return NULL;
   480	    if (UNLIKELY((size_t)(end_of_line - buffer) < minimal_request_line_len))
   481	        return NULL;
   482	    *end_of_line = '\0';
   483	
   484	    space = end_of_line - sizeof("HTTP/X.X");
   485	
   486	    request->url.value = buffer;
   487	    request->url.len = (size_t)(space - buffer);
   488	    parse_fragment_and_query(request, space);
   489	    request->original_url = request->url;
   490	
   491	    *space++ = '\0';
   492	
   493	    STRING_SWITCH_LARGE(space) {
   494	    case MULTICHAR_CONSTANT_LARGE('H','T','T','P','/','1','.','0'):
   495	        request->flags |= REQUEST_IS_HTTP_1_0;
   496	        break;
   497	    case MULTICHAR_CONSTANT_LARGE('H','T','T','P','/','1','.','1'):
   498	        break;
   499	    default:
   500	        return NULL;
   501	    }
   502	
   503	    return end_of_line + 1;
   504	}
