   345	
   346	static void parse_key_values(struct lwan_request *request,
   347	                             struct lwan_value *helper_value,
   348	                             struct lwan_key_value_array *array,
   349	                             ssize_t (*decode_value)(char *value),
   350	                             const char separator)
   351	{
   352	    struct lwan_key_value *kv;
   353	    char *ptr = helper_value->value;
   354	
   355	    if (!helper_value->len)
   356	        return;
   357	
   358	    lwan_key_value_array_init(array);
   359	    /* Calling lwan_key_value_array_reset() twice is fine, so even if 'goto
   360	     * error' is executed in this function, nothing bad should happen.  */
   361	    coro_defer(request->conn->coro, reset_key_value_array, array);
   362	
   363	    do {
   364	        char *key, *value;
   365	
   366	        while (*ptr == ' ' || *ptr == separator)
   367	            ptr++;
   368	        if (UNLIKELY(*ptr == '\0'))
   369	            goto error;
   370	
   371	        key = ptr;
   372	        ptr = strsep_char(key, separator);
   373	
   374	        value = strsep_char(key, '=');
   375	        if (UNLIKELY(!value)) {
   376	            value = "";
   377	        } else if (UNLIKELY(decode_value(value) < 0)) {
   378	            /* Disallow values that failed decoding, but allow empty values */
   379	            goto error;
   380	        }
   381	
   382	        if (UNLIKELY(decode_value(key) <= 0)) {
   383	            /* Disallow keys that failed decoding, or empty keys */
   384	            goto error;
   385	        }
   386	
   387	        kv = lwan_key_value_array_append(array);
   388	        if (UNLIKELY(!kv))
   389	            goto error;
   390	
   391	        kv->key = key;
   392	        kv->value = value;
   393	    } while (ptr);
   394	
   395	    lwan_key_value_array_sort(array, key_value_compare);
   396	
   397	    return;
   398	
   399	error:
   400	    lwan_key_value_array_reset(array);
   401	}
