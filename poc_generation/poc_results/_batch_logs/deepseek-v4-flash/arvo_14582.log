        case MULTICHAR_CONSTANT_L('A', 'u', 't', 'h'):
            helper->authorization = HEADER("Authorization");
            break;
        case MULTICHAR_CONSTANT_L('C', 'o', 'n', 'n'):
            helper->connection = HEADER("Connection");
            break;
        case MULTICHAR_CONSTANT_L('C', 'o', 'n', 't'):
