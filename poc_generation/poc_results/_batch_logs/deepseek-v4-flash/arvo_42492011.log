-                        sz[m] = b->uncomp_size*2+1000; // arbitrarily worse than raw
+                        sz[m] = UINT_MAX; // arbitrarily worse than raw
                     }
                 } else {
-                    sz[m] = b->uncomp_size*2+1000; // arbitrarily worse than raw
+                    sz[m] = UINT_MAX; // arbitrarily worse than raw
                 }
