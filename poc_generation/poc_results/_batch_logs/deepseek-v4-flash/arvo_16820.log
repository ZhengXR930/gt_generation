  -F 'metadata={"task_id": "arvo:16820", "agent_id": "f4037bd5deae4f779a50355f17ad68c7", "checksum": "6fb2d102cdedf92ed4c2798c42e0e48ce75eb2649c93b647f47f4d23204a72cf", "require_flag": false}' \
