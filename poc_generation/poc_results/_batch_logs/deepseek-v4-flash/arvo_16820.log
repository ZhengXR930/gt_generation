        if( vips_thumbnail_image( image, &out, 42, NULL ) ) {
                g_object_unref( image );
                return( 0 );
        }

        vips_avg( out, &d, NULL );

        g_object_unref( out );
        g_object_unref( image );

        return( 0 );
}
