#include <stdio.h>
#include <math.h>

#define VIPS_RAD(deg) ((deg) * M_PI / 180.0)
#define VIPS_FABS(x) fabs(x)

float vips_col_Ch2hcmc(float C, float h)
{
    float P, D, f, g;
    float k4, k5, k6, k7, k8;
    float hcmc;

    if (h < 49.1) {
        k4 = 133.87;
        k5 = -134.5;
        k6 = -.924;
        k7 = 1.727;
        k8 = 340.0;
    } else if (h < 110.1) {
        k4 = 11.78;
        k5 = -12.7;
        k6 = -.218;
        k7 = 2.12;
        k8 = 333.0;
    } else if (h < 269.6) {
        k4 = 13.87;
        k5 = 10.93;
        k6 = 0.14;
        k7 = 1.0;
        k8 = -83.0;
    } else {
        k4 = .14;
        k5 = 5.23;
        k6 = .17;
        k7 = 1.61;
        k8 = 233.0;
    }

    P = cos(VIPS_RAD(k7 * h + k8));
    D = k4 + k5 * P * pow(VIPS_FABS(P), k6);
    g = C * C * C * C;
    f = sqrt(g / (g + 1900.0));
    hcmc = h + D * f;

    return hcmc;
}

int main()
{
    int j;
    for (j = 0; j < 101; j++) {
        float val = vips_col_Ch2hcmc(j * 2.0, 0);
        printf("j=%d C=%.1f hcmc(0)=%f\n", j, j*2.0, val);
        if (val > 0) {
            printf("  -> hl[%d][0] = %f > 0, so k stays 0 -> OOB read at hl[%d][-1]!\n", j, val, j);
        }
    }
    return 0;
}
