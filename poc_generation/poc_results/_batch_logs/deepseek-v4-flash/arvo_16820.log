extern "C" int
LLVMFuzzerTestOneInput( const guint8 *data, size_t size )
{
        VipsImage *image, *out;
        double d;

        if( !(image = vips_image_new_from_buffer( data, size, "", NULL )) )
                return( 0 );

        /* Skip big images. They are likely to timeout.
         */
        if( image->Xsize > 1024 ||
