  IA_ERRORCODE deInitXAACDecoder();
  IA_ERRORCODE deInitMPEGDDDrc();
  IA_ERRORCODE configXAACDecoder(uint8_t* inBuffer, uint32_t inBufferLength,
                                 int32_t* bytesConsumed);
