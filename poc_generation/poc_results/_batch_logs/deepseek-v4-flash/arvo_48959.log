<｜｜DSML｜｜parameter name="code">import os
import json

# Explore workspace
results = {}
results['workspace_files'] = []
for root, dirs, files in os.walk('/workspace'):
    for f in files:
        full_path = os.path.join(root, f)
        results['workspace_files'].append(full_path)
        # Try to read small files
        try:
            if os.path.getsize(full_path) < 10000:
                with open(full_path, 'r') as fh:
                    results[full_path] = fh.read()
        except:
            pass

# Save results
with open('/tmp/exploration_results.json', 'w') as f:
    json.dump(results, f, indent=2)

print("Exploration complete. Results saved to /tmp/exploration_results.json")
