                                treepos = (unsigned int)(tree->tree2d[2 * treepos + bit] -
                                                tree->numcodes);
                }
        }

        for (n = 0; n < tree->numcodes * 2u; n++)
                if (tree->tree2d[n] == EMPTY)
                        tree->tree2d[n] = 0;

        return LWS_SRET_OK;
}



