  1527	static void remove_sleep(void *data1, void *data2)
  1528	{
  1529	    struct timeouts *wheel = data1;
  1530	    struct timeout *timeout = data2;
  1531	    struct lwan_request *request =
  1532	        container_of(timeout, struct lwan_request, timeout);
  1533	
  1534	    if (request->conn->flags & CONN_SUSPENDED_BY_TIMER)
  1535	        timeouts_del(wheel, timeout);
  1536	}
  1537	
  1538	void lwan_request_sleep(struct lwan_request *request, uint64_t ms)
  1539	{
  1540	    struct lwan_connection *conn = request->conn;
  1541	    struct timeouts *wheel = conn->thread->wheel;
  1542	
  1543	    assert(!(conn->flags & CONN_SUSPENDED_BY_TIMER));
  1544	    conn->flags |= CONN_SUSPENDED_BY_TIMER;
  1545	
  1546	    request->timeout = (struct timeout) {};
  1547	    timeouts_add(wheel, &request->timeout, ms);
  1548	    coro_defer2(conn->coro, remove_sleep, wheel, &request->timeout);
  1549	    coro_yield(conn->coro, CONN_CORO_MAY_RESUME);
  1550	
  1551	    assert(!(conn->flags & CONN_SUSPENDED_BY_TIMER));
  1552	    assert(!(conn->flags & CONN_RESUMED_FROM_TIMER));
  1553	}
