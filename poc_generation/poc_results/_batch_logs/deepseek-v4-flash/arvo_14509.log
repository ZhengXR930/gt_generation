  1462	const char *lwan_request_get_header(struct lwan_request *request,
  1463	                                    const char *header)
  1464	{
  1465	    char name[64];
  1466	    int r;
  1467	
  1468	    r = snprintf(name, sizeof(name), "%s: ", header);
  1469	    if (UNLIKELY(r < 0 || r >= (int)sizeof(name)))
  1470	        return NULL;
  1471	
  1472	    for (size_t i = 0; i < request->helper->n_header_start; i += 2) {
  1473	        const char *start = request->helper->header_start[i];
  1474	        char *end = request->helper->header_start[i + 1];
  1475	
  1476	        if (UNLIKELY(end - start < r))
  1477	            continue;
  1478	
  1479	        if (!strncasecmp(start, name, (size_t)r)) {
  1480	            *end = '\0';
  1481	            return start + r;
  1482	        }
  1483	    }
  1484	
  1485	    return NULL;
  1486	}
