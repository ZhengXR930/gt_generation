  1290	    request->url.len -= url_map->prefix_len;
  1291	
  1292	    if (url_map->flags & HANDLER_MUST_AUTHORIZE) {
  1293	        if (!lwan_http_authorize(request, &helper->authorization,
  1294	                                 url_map->authorization.realm,
  1295	                                 url_map->authorization.password_file))
  1296	            return HTTP_NOT_AUTHORIZED;
  1297	    }
  1298	
  1299	    if (url_map->flags & HANDLER_REMOVE_LEADING_SLASH) {
  1300	        while (*request->url.value == '/' && request->url.len > 0) {
  1301	            ++request->url.value;
  1302	            --request->url.len;
  1303	        }
  1304	    }
  1305	
  1306	    if (url_map->flags & HANDLER_PARSE_ACCEPT_ENCODING)
  1307	        parse_accept_encoding(request);
  1308	
  1309	    if (lwan_request_get_method(request) == REQUEST_METHOD_POST) {
  1310	        enum lwan_http_status status;
  1311	
  1312	        if (!(url_map->flags & HANDLER_HAS_POST_DATA)) {
  1313	            /* FIXME: Discard POST data here? If a POST request is sent
