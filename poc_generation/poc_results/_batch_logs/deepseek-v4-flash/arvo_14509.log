  1317	             * request itself. */
  1318	            return HTTP_NOT_ALLOWED;
  1319	        }
  1320	
  1321	        status = read_post_data(request);
  1322	        if (UNLIKELY(status != HTTP_OK))
  1323	            return status;
  1324	    }
  1325	
  1326	    return HTTP_OK;
  1327	}
