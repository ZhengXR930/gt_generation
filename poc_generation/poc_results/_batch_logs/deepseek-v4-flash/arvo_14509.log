  1494	const char *
  1495	lwan_request_get_remote_address(struct lwan_request *request,
  1496	            char buffer[static INET6_ADDRSTRLEN])
  1497	{
  1498	    struct sockaddr_storage non_proxied_addr = { .ss_family = AF_UNSPEC };
  1499	    struct sockaddr_storage *sock_addr;
  1500	
  1501	    if (request->flags & REQUEST_PROXIED) {
  1502	        sock_addr = (struct sockaddr_storage *)&request->proxy->from;
  1503	
  1504	        if (UNLIKELY(sock_addr->ss_family == AF_UNSPEC))
  1505	            return memcpy(buffer, "*unspecified*", sizeof("*unspecified*"));
  1506	    } else {
  1507	        socklen_t sock_len = sizeof(non_proxied_addr);
  1508	
  1509	        sock_addr = &non_proxied_addr;
  1510	
  1511	        if (UNLIKELY(getpeername(request->fd,
  1512	                                 (struct sockaddr *) sock_addr,
  1513	                                 &sock_len) < 0))
  1514	            return NULL;
  1515	    }
  1516	
  1517	    if (sock_addr->ss_family == AF_INET)
  1518	        return inet_ntop(AF_INET,
  1519	                         &((struct sockaddr_in *) sock_addr)->sin_addr,
  1520	                         buffer, INET6_ADDRSTRLEN);
  1521	
  1522	    return inet_ntop(AF_INET6,
  1523	                     &((struct sockaddr_in6 *) sock_addr)->sin6_addr,
  1524	                     buffer, INET6_ADDRSTRLEN);
