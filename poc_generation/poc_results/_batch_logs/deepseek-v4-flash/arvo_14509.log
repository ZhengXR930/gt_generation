  1412	static inline void *
  1413	value_lookup(const struct lwan_key_value_array *array, const char *key)
  1414	{
  1415	    const struct lwan_array *la = (const struct lwan_array *)array;
  1416	
  1417	    if (LIKELY(la->elements)) {
  1418	        struct lwan_key_value k = { .key = (char *)key };
  1419	        struct lwan_key_value *entry;
  1420	
  1421	        entry = bsearch(&k, la->base, la->elements, sizeof(k), key_value_compare);
  1422	        if (LIKELY(entry))
  1423	            return entry->value;
  1424	    }
  1425	
  1426	    return NULL;
  1427	}
