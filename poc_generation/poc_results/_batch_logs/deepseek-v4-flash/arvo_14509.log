  1358	    enum lwan_http_status status;
  1359	    struct lwan_url_map *url_map;
  1360	
  1361	    request->helper = &helper;
  1362	
  1363	    status = read_request(request);
  1364	    if (UNLIKELY(status != HTTP_OK)) {
  1365	        /* This request was bad, but maybe there's a good one in the
  1366	         * pipeline.  */
  1367	        if (status == HTTP_BAD_REQUEST && helper.next_request)
  1368	            goto out;
  1369	
  1370	        /* Response here can be: HTTP_TOO_LARGE, HTTP_BAD_REQUEST (without
  1371	         * next request), or HTTP_TIMEOUT.  Nothing to do, just abort the
  1372	         * coroutine.  */
  1373	        lwan_default_response(request, status);
  1374	        coro_yield(request->conn->coro, CONN_CORO_ABORT);
  1375	        __builtin_unreachable();
  1376	    }
  1377	
  1378	    status = parse_http_request(request);
  1379	    if (UNLIKELY(status != HTTP_OK)) {
  1380	        lwan_default_response(request, status);
  1381	        goto out;
  1382	    }
  1383	
  1384	lookup_again:
  1385	    url_map = lwan_trie_lookup_prefix(&l->url_map_trie, request->url.value);
  1386	    if (UNLIKELY(!url_map)) {
  1387	        lwan_default_response(request, HTTP_NOT_FOUND);
  1388	        goto out;
  1389	    }
  1390	
  1391	    status = prepare_for_response(url_map, request);
  1392	    if (UNLIKELY(status != HTTP_OK)) {
  1393	        lwan_default_response(request, status);
  1394	        goto out;
  1395	    }
  1396	
  1397	    status = url_map->handler(request, &request->response, url_map->data);
  1398	    if (UNLIKELY(url_map->flags & HANDLER_CAN_REWRITE_URL)) {
  1399	        if (request->flags & RESPONSE_URL_REWRITTEN) {
