  1352	    struct lwan_request_parser_helper helper = {
  1353	        .buffer = buffer,
  1354	        .next_request = next_request,
  1355	        .error_when_n_packets = calculate_n_packets(DEFAULT_BUFFER_SIZE),
  1356	        .header_start = header_start,
