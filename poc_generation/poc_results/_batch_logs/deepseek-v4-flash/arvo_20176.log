    70	static exit_status_e
    71	        exit_status;
    72	
    73	void set_exit_status(exit_status_e status)
    74	{
    75	        // use Wget exit status scheme:
    76	        // - error code 0 is default
    77	        // - error code 1 is used directly by exit() (fatal errors)
    78	        // - error codes 2... : lower numbers precede higher numbers
    79	        if (exit_status) {
    80	                if (status < exit_status) {
    81	                        debug_printf("%s(%d)\n", __func__, (int) status);
    82	                        exit_status = status;
    83	                }
    84	        } else {
    85	                debug_printf("%s(%d)\n", __func__, (int) status);
    86	                exit_status = status;
    87	        }
    88	}
    89	
    90	exit_status_e get_exit_status(void)
    91	{
    92	        return exit_status;
    93	}
