   529	static char *set_char_prefix(const char *val, char prefix)
   530	{
   531	        if (val && *val) {
   532	                // we just need a scratch buffer, no need for optimal size calculation
   533	                char *prefixed_val = wget_malloc(strlen(val) * 3 + 1), *dst = prefixed_val;
   534	
   535	                *dst++ = prefix;
   536	                for (const char *src = val; *src; src++) {
   537	                        if (*src == '\\') {
   538	                                *dst++ = *src;
   539	                                if (src[1])
   540	                                        *dst++ = *++src;
   541	                        } else if (*src == ',') {
   542	                                while (dst[-1] == '/')
   543	                                        dst--;
   544	                                *dst++ = *src;
   545	                                *dst++ = prefix;
   546	                        } else
   547	                                *dst++ = *src;
   548	                }
   549	
   550	                while (dst[-1] == '/')
   551	                        dst--;
   552	
   553	                *dst = 0;
   554	
   555	                return prefixed_val;
   556	        }
   557	
   558	        return NULL;
   559	}
