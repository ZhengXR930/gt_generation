   285	// parse '2.5k' locale independent
   286	static int parse_double_modifier(const char *in, double *d, char *c)
   287	{
   288	        bool minus = false;
   289	
   290	        while (c_isspace(*in))
   291	                in++;
   292	
   293	        if (*in == '+') {
   294	                in++;
   295	        } else if (*in == '-') {
   296	                in++;
   297	                minus = true;
   298	        }
   299	
   300	        if (!c_isdigit(*in))
   301	                return 0;
   302	
   303	        for (*d = 0; c_isdigit(*in); in++)
   304	                *d = *d * 10 + (*in - '0');
   305	
   306	        if (*in == '.') {
   307	                in++;
   308	                for (double q = 10; c_isdigit(*in); q *= 10, in++)
   309	                        *d += (*in - '0') / q;
   310	        }
   311	
   312	        if (minus)
   313	                *d = -*d;
   314	
   315	        *c = *in;
   316	
   317	        return *c ? 2 : 1;
   318	}
