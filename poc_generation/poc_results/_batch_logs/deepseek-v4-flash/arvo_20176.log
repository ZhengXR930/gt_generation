   355	static int parse_filename(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   356	{
   357	        xfree(*((const char **)opt->var));
   358	        *((const char **)opt->var) = val ? shell_expand(val) : NULL;
   359	
   360	        debug_printf("Expanded value = %s\n", *(const char **)opt->var);
   361	        return 0;
   362	}
