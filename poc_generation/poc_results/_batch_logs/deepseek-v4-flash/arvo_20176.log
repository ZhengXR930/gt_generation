   701	                char modifier = 0;
   702	
   703	                if (parse_double_modifier(val, &fval, &modifier) >= 1 && fval >= 0) {
   704	                        if (modifier) {
   705	                                switch (c_tolower(modifier)) {
   706	                                case 's': fval *= 1000; break;
   707	                                case 'm': fval *= 60 * 1000; break;
   708	                                case 'h': fval *= 60 * 60 * 1000; break;
   709	                                case 'd': fval *= 60 * 60 * 24 * 1000; break;
   710	                                default: error_printf(_("Invalid time specifier in '%s'\n"), val); return -1;
