   583	static int parse_filenames(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   584	{
   585	        /* max number of 32 files to avoid out-of-memory by recursion */
   586	        return parse_stringlist_expand(opt, val, 1, 32);
   587	}
   588	
   589	static void tag_free(void *tag)
   590	{
   591	        wget_html_tag *t = tag;
   592	
   593	        if (t) {
   594	                xfree(t->attribute);
   595	                xfree(t->name);
   596	                xfree(t);
   597	        }
   598	}
   599	
   600	static void WGET_GCC_NONNULL_ALL add_tag(wget_vector *v, const char *begin, const char *end)
   601	{
   602	        wget_html_tag *tag = wget_malloc(sizeof(wget_html_tag));
   603	        const char *attribute;
   604	
   605	        if ((attribute = memchr(begin, '/', end - begin))) {
   606	                tag->name = wget_strmemdup(begin, attribute - begin);
   607	                tag->attribute = wget_strmemdup(attribute + 1, (end - begin) - (attribute - begin) - 1);
   608	        } else {
   609	                tag->name = wget_strmemdup(begin, end - begin);
   610	                tag->attribute = NULL;
   611	        }
   612	
   613	        if (wget_vector_find(v, tag) < 0)
   614	                wget_vector_insert_sorted(v, tag);
   615	        else
   616	                tag_free(tag); // avoid double entries
   617	}
   618	
   619	static int WGET_GCC_NONNULL_ALL compare_tag(const wget_html_tag *t1, const wget_html_tag *t2)
   620	{
   621	        int n;
   622	
   623	        if (!(n = wget_strcasecmp_ascii(t1->name, t2->name))) {
   624	                if (!t1->attribute) {
   625	                        if (!t2->attribute)
   626	                                n = 0;
   627	                        else
   628	                                n = -1;
   629	                } else if (!t2->attribute) {
   630	                        n = 1;
   631	                } else
   632	                        n = wget_strcasecmp_ascii(t1->attribute, t2->attribute);
   633	        }
   634	
   635	        return n;
   636	}
   637	
   638	static int parse_taglist(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   639	{
   640	        if (val && *val) {
   641	                wget_vector *v = *((wget_vector **)opt->var);
   642	                const char *s, *p;
   643	
   644	                if (!v) {
   645	                        v = *((wget_vector **)opt->var) = wget_vector_create(8, (wget_vector_compare_fn *) compare_tag);
   646	                        wget_vector_set_destructor(v, tag_free);
   647	                }
   648	
   649	                for (s = p = val; *p; s = p + 1) {
   650	                        if ((p = strchrnul(s, ',')) != s)
   651	                                add_tag(v, s, p);
   652	                }
   653	        } else {
   654	                wget_vector_free(opt->var);
   655	        }
   656	
   657	        return 0;
   658	}
   659	
   660	static int parse_bool(option_t opt, const char *val, const char invert)
   661	{
   662	        if (opt->var) {
