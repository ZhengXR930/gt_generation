   491	static int parse_stringlist_expand(option_t opt, const char *val, int expand, int max_entries)
   492	{
   493	        if (val && *val) {
   494	                wget_vector *v = *((wget_vector **)opt->var);
   495	                const char *s, *p;
   496	
   497	                if (!v)
   498	                        v = *((wget_vector **)opt->var) = wget_vector_create(8, (wget_vector_compare_fn *) strcmp);
   499	
   500	                for (s = p = val; *p; s = p + 1) {
   501	                        if ((p = strchrnul_esc(s, ',')) != s) {
   502	                                if (wget_vector_size(v) >= max_entries) {
   503	                                        wget_debug_printf("%s: More than %d entries, ignoring overflow\n", __func__, max_entries);
   504	                                        return -1;
   505	                                }
   506	
   507	                                const char *fname = strmemdup_esc(s, p - s);
   508	
   509	                                if (expand && *s == '~') {
   510	                                        wget_vector_add(v, shell_expand(fname));
   511	                                        xfree(fname);
   512	                                } else
   513	                                        wget_vector_add(v, fname);
   514	                        }
   515	                }
   516	        } else {
   517	                wget_vector_free(opt->var);
   518	        }
   519	
   520	        return 0;
   521	}
