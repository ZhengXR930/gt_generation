   447	static const char *strchrnul_esc(const char *s, char c)
   448	{
   449	        const char *p;
   450	
   451	        for (p = s; *p; p++) {
   452	                if (*p == '\\' && (p[1] == '\\' || p[1] == c))
   453	                        p++;
   454	                else if (*p == c)
   455	                        return p;
   456	        }
   457	
   458	        return p; // pointer to trailing \0
   459	}
