   696	static int parse_timeout(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   697	{
   698	        double fval = -1;
   699	
   700	        if (wget_strcasecmp_ascii(val, "INF") && wget_strcasecmp_ascii(val, "INFINITY")) {
   701	                char modifier = 0;
   702	
   703	                if (parse_double_modifier(val, &fval, &modifier) >= 1 && fval >= 0) {
   704	                        if (modifier) {
   705	                                switch (c_tolower(modifier)) {
   706	                                case 's': fval *= 1000; break;
   707	                                case 'm': fval *= 60 * 1000; break;
   708	                                case 'h': fval *= 60 * 60 * 1000; break;
   709	                                case 'd': fval *= 60 * 60 * 24 * 1000; break;
   710	                                default: error_printf(_("Invalid time specifier in '%s'\n"), val); return -1;
   711	                                }
   712	                        } else
   713	                                fval *= 1000;
   714	                }
   715	        }
   716	
   717	        if (fval <= 0) // special Wget compatibility: timeout 0 means INFINITY
   718	                fval = -1;
   719	
   720	        if (opt->var) {
   721	                *((int *)opt->var) = fval > INT_MAX ? INT_MAX : (int) fval;
   722	                // debug_printf("timeout set to %gs\n",*((int *)opt->var)/1000.);
   723	        } else {
   724	                // --timeout option sets all timeouts
   725	                config.connect_timeout =
   726	                config.dns_timeout =
   727	                config.read_timeout = fval > INT_MAX ? INT_MAX : (int) fval;
   728	        }
   729	
   730	        return 0;
   731	}
