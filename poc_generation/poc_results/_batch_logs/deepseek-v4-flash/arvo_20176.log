   393	static int compare_wget_http_param(wget_http_header_param *a, wget_http_header_param *b)
   394	{
   395	        if (wget_strcasecmp_ascii(a->name, b->name) == 0)
   396	                if (wget_strcasecmp_ascii(a->value, b->value) == 0)
   397	                        return 0;
   398	        return 1;
   399	}
   400	
   401	static int parse_header(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   402	{
   403	        wget_vector *v = *((wget_vector **)opt->var);
   404	
   405	        if (val && *val) {
   406	                char *value, *delim_pos;
   407	
   408	                if (!v) {
   409	                        v = *((wget_vector **)opt->var) =
   410	                                wget_vector_create(8, (wget_vector_compare_fn *) compare_wget_http_param);
   411	                        wget_vector_set_destructor(v, (wget_vector_destructor *) wget_http_free_param);
   412	                }
   413	
   414	                delim_pos = strchr(val, ':');
   415	
   416	                if (!delim_pos || delim_pos == val) {
   417	                        wget_error_printf(_("Ignoring invalid header: %s\n"), val);
   418	                        return 0;
   419	                }
   420	
   421	                value = delim_pos + 1;
   422	                while (*value == ' ')
   423	                        value++;
   424	
   425	                if (*value == '\0') {
   426	                        wget_error_printf(_("No value in header (ignoring): %s\n"), val);
   427	                        return 0;
   428	                }
   429	
   430	                wget_http_header_param *param = wget_malloc(sizeof(wget_http_header_param));
   431	                param->name = wget_strmemdup(val, delim_pos - val);
   432	                param->value = wget_strdup(value);
   433	
   434	                if (wget_vector_find(v, param) < 0)
   435	                        wget_vector_add(v, param);
   436	                else
   437	                        wget_http_free_param(param);
   438	
   439	        } else if (val && *val == '\0') {
   440	                wget_vector_clear(v);
   441	                return 0;
   442	        }
   443	
   444	        return 0;
   445	}
   446	
   447	static const char *strchrnul_esc(const char *s, char c)
   448	{
   449	        const char *p;
   450	
   451	        for (p = s; *p; p++) {
   452	                if (*p == '\\' && (p[1] == '\\' || p[1] == c))
   453	                        p++;
   454	                else if (*p == c)
   455	                        return p;
   456	        }
   457	
   458	        return p; // pointer to trailing \0
   459	}
   460	
   461	static char *strmemdup_esc(const char *s, size_t size)
   462	{
   463	   const char *p, *e;
   464	        size_t newsize = 0;
   465	
   466	        for (p = s, e = s + size; p < e; p++) {
   467	                if (*p == '\\') {
   468	                        if (p < e - 1) {
   469	                                newsize++;
   470	                                p++;
   471	                        }
   472	                } else
   473	                        newsize++;
   474	        }
   475	
   476	        char *ret = wget_malloc(newsize + 1);
   477	        char *dst = ret;
   478	
   479	        for (p = s, e = s + size; p < e; p++) {
   480	                if (*p == '\\') {
   481	                        if (p < e - 1)
   482	                                *dst++ = *++p;
   483	                } else
   484	                        *dst++ = *p;
   485	        }
   486	        *dst = 0;
   487	
   488	        return ret;
   489	}
   490	
   491	static int parse_stringlist_expand(option_t opt, const char *val, int expand, int max_entries)
   492	{
   493	        if (val && *val) {
   494	                wget_vector *v = *((wget_vector **)opt->var);
   495	                const char *s, *p;
   496	
   497	                if (!v)
   498	                        v = *((wget_vector **)opt->var) = wget_vector_create(8, (wget_vector_compare_fn *) strcmp);
   499	
   500	                for (s = p = val; *p; s = p + 1) {
   501	                        if ((p = strchrnul_esc(s, ',')) != s) {
   502	                                if (wget_vector_size(v) >= max_entries) {
   503	                                        wget_debug_printf("%s: More than %d entries, ignoring overflow\n", __func__, max_entries);
   504	                                        return -1;
   505	                                }
   506	
   507	                                const char *fname = strmemdup_esc(s, p - s);
   508	
   509	                                if (expand && *s == '~') {
   510	                                        wget_vector_add(v, shell_expand(fname));
   511	                                        xfree(fname);
   512	                                } else
   513	                                        wget_vector_add(v, fname);
   514	                        }
   515	                }
   516	        } else {
   517	                wget_vector_free(opt->var);
   518	        }
   519	
   520	        return 0;
   521	}
   522	
   523	static int parse_stringlist(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   524	{
   525	        /* max number of 1024 entries to avoid out-of-memory */
   526	        return parse_stringlist_expand(opt, val, 0, 1024);
   527	}
   528	
   529	static char *set_char_prefix(const char *val, char prefix)
   530	{
   531	        if (val && *val) {
   532	                // we just need a scratch buffer, no need for optimal size calculation
   533	                char *prefixed_val = wget_malloc(strlen(val) * 3 + 1), *dst = prefixed_val;
   534	
   535	                *dst++ = prefix;
   536	                for (const char *src = val; *src; src++) {
   537	                        if (*src == '\\') {
   538	                                *dst++ = *src;
   539	                                if (src[1])
   540	                                        *dst++ = *++src;
   541	                        } else if (*src == ',') {
   542	                                while (dst[-1] == '/')
   543	                                        dst--;
   544	                                *dst++ = *src;
   545	                                *dst++ = prefix;
   546	                        } else
   547	                                *dst++ = *src;
   548	                }
   549	
   550	                while (dst[-1] == '/')
   551	                        dst--;
   552	
   553	                *dst = 0;
   554	
   555	                return prefixed_val;
   556	        }
   557	
   558	        return NULL;
   559	}
   560	
   561	static int parse_included_directories(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   562	{
   563	        char *prefixed_val = set_char_prefix(val, INCLUDED_DIRECTORY_PREFIX);
   564	        int ret = parse_stringlist_expand(opt, prefixed_val, 0, 1024);
   565	
   566	        if (prefixed_val)
   567	                xfree(prefixed_val);
   568	
   569	        return ret;
   570	}
   571	
   572	static int parse_excluded_directories(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   573	{
   574	        char *prefixed_val = set_char_prefix(val, EXCLUDED_DIRECTORY_PREFIX);
   575	        int ret = parse_stringlist_expand(opt, prefixed_val, 0, 1024);
   576	
   577	        if (prefixed_val)
   578	                xfree(prefixed_val);
   579	
   580	        return ret;
   581	}
