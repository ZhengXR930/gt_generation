   265	static int parse_integer(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   266	{
   267	        *((int *)opt->var) = val ? atoi(val) : 0;
   268	
   269	        return 0;
   270	}
   271	
   272	static int parse_uint16(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   273	{
   274	        int port = val ? atoi(val) : 0;
   275	
   276	        if (port >= 0 && port <= UINT16_MAX) {
   277	                *((uint16_t *)opt->var) = (uint16_t) port;
   278	                return 0;
   279	        }
   280	
   281	        error_printf(_("Value out of range (0-65535): %s\n"), val);
   282	        return -1;
   283	}
   284	
   285	// parse '2.5k' locale independent
   286	static int parse_double_modifier(const char *in, double *d, char *c)
   287	{
   288	        bool minus = false;
   289	
   290	        while (c_isspace(*in))
   291	                in++;
   292	
   293	        if (*in == '+') {
   294	                in++;
   295	        } else if (*in == '-') {
   296	                in++;
   297	                minus = true;
   298	        }
   299	
   300	        if (!c_isdigit(*in))
   301	                return 0;
   302	
   303	        for (*d = 0; c_isdigit(*in); in++)
   304	                *d = *d * 10 + (*in - '0');
   305	
   306	        if (*in == '.') {
   307	                in++;
   308	                for (double q = 10; c_isdigit(*in); q *= 10, in++)
   309	                        *d += (*in - '0') / q;
   310	        }
   311	
   312	        if (minus)
   313	                *d = -*d;
   314	
   315	        *c = *in;
   316	
   317	        return *c ? 2 : 1;
   318	}
   319	
   320	static int parse_numbytes(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   321	{
   322	        if (val) {
   323	                char modifier = 0, error = 0;
   324	                double num = 0;
   325	
   326	                if (!wget_strcasecmp_ascii(val, "INF") || !wget_strcasecmp_ascii(val, "INFINITY")) {
   327	                        *((long long *)opt->var) = 0;
   328	                        return 0;
   329	                }
   330	
   331	                if (parse_double_modifier(val, &num, &modifier) >= 1 && num >= 0) {
   332	                        if (modifier) {
   333	                                switch (c_tolower(modifier)) {
   334	                                case 'k': num *= 1024; break;
   335	                                case 'm': num *= 1024*1024; break;
   336	                                case 'g': num *= 1024*1024*1024; break;
   337	                                case 't': num *= 1024*1024*1024*1024LL; break;
   338	                                default: error = 1;
   339	                                }
   340	                        }
   341	                } else
   342	                        error = 1;
   343	
   344	                if (error) {
   345	                        error_printf(_("Invalid byte specifier: %s\n"), val);
   346	                        return -1;
   347	                }
   348	
   349	                *((long long *)opt->var) = num > LLONG_MAX ? LLONG_MAX : (long long) num;
   350	        }
   351	
   352	        return 0;
   353	}
