   373	static int parse_stringset(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   374	{
   375	        wget_stringmap *map = *((wget_stringmap **)opt->var);
   376	
   377	        if (val) {
   378	                const char *s, *p;
   379	
   380	                wget_stringmap_clear(map);
   381	
   382	                for (s = p = val; *p; s = p + 1) {
   383	                        if ((p = strchrnul(s, ',')) != s)
   384	                                wget_stringmap_put(map, wget_strmemdup(s, p - s), NULL);
   385	                }
   386	        } else {
   387	                wget_stringmap_clear(map);
   388	        }
   389	
   390	        return 0;
   391	}
