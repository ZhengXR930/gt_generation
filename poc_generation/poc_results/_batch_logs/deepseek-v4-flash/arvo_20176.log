   461	static char *strmemdup_esc(const char *s, size_t size)
   462	{
   463	   const char *p, *e;
   464	        size_t newsize = 0;
   465	
   466	        for (p = s, e = s + size; p < e; p++) {
   467	                if (*p == '\\') {
   468	                        if (p < e - 1) {
   469	                                newsize++;
   470	                                p++;
   471	                        }
   472	                } else
   473	                        newsize++;
   474	        }
   475	
   476	        char *ret = wget_malloc(newsize + 1);
   477	        char *dst = ret;
   478	
   479	        for (p = s, e = s + size; p < e; p++) {
   480	                if (*p == '\\') {
   481	                        if (p < e - 1)
   482	                                *dst++ = *++p;
   483	                } else
   484	                        *dst++ = *p;
   485	        }
   486	        *dst = 0;
   487	
   488	        return ret;
   489	}
