   619	static int WGET_GCC_NONNULL_ALL compare_tag(const wget_html_tag *t1, const wget_html_tag *t2)
   620	{
   621	        int n;
   622	
   623	        if (!(n = wget_strcasecmp_ascii(t1->name, t2->name))) {
   624	                if (!t1->attribute) {
   625	                        if (!t2->attribute)
   626	                                n = 0;
   627	                        else
   628	                                n = -1;
   629	                } else if (!t2->attribute) {
   630	                        n = 1;
   631	                } else
   632	                        n = wget_strcasecmp_ascii(t1->attribute, t2->attribute);
   633	        }
   634	
   635	        return n;
   636	}
