   364	static int parse_string(option_t opt, const char *val, WGET_GCC_UNUSED const char invert)
   365	{
   366	        // the strdup'ed string will be released on program exit
   367	        xfree(*((const char **)opt->var));
   368	        *((const char **)opt->var) = wget_strdup(val);
   369	
   370	        return 0;
   371	}
