        p11_rpc_message_init (&msg, request, response);

        if (!p11_rpc_message_parse (&msg, P11_RPC_REQUEST)) {
                p11_rpc_message_clear (&msg);
                p11_message ("couldn't parse pkcs11 rpc message");
                return false;
        }

