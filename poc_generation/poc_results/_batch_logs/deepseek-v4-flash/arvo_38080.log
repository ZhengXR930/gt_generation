void free_to_params(struct to_body *const tb)
{
        struct to_param *tp = tb->param_lst;
        struct to_param *foo;
        while(tp) {
                foo = tp->next;
                pkg_free(tp);
                tp = foo;
        }
        tb->param_lst = NULL;
}


void free_to(struct to_body *const tb)
{
        free_to_params(tb);
        pkg_free(tb);
