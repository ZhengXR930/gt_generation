    os2_data += struct.pack('>H', 0)    # usWeightClass
    os2_data += struct.pack('>H', 0)    # usWidthClass
    os2_data += struct.pack('>H', 0)    # fsType
    os2_data += struct.pack('>h', 0)    # ySubscriptXSize
    os2_data += struct.pack('>h', 0)    # ySubscriptYSize
    os2_data += struct.pack('>h', 0)    # ySubscriptXOffset
    os2_data += struct.pack('>h', 0)    # ySubscriptYOffset
    os2_data += struct.pack('>h', 0)    # ySuperscriptXSize
    os2_data += struct.pack('>h', 0)    # ySuperscriptYSize
    os2_data += struct.pack('>h', 0)    # ySuperscriptXOffset
    os2_data += struct.pack('>h', 0)    # ySuperscriptYOffset
    os2_data += struct.pack('>h', 0)    # yStrikeoutSize
    os2_data += struct.pack('>h', 0)    # yStrikeoutPosition
    os2_data += struct.pack('>h', 0)    # sFamilyClass
    os2_data += struct.pack('B', 0) * 10  # panose
    os2_data += struct.pack('>I', 0)   # ulUnicodeRange1
    os2_data += struct.pack('>I', 0)   # ulUnicodeRange2
    os2_data += struct.pack('>I', 0)   # ulUnicodeRange3
    os2_data += struct.pack('>I', 0)   # ulUnicodeRange4
    os2_data += struct.pack('>H', 0)   # achVendID (4 bytes actually)
    os2_data += struct.pack('>H', 0)   # 
    os2_data += struct.pack('>H', 0)   # fsSelection
    os2_data += struct.pack('>H', 0)   # usFirstCharIndex
    os2_data += struct.pack('>H', 0)   # usLastCharIndex
    os2_data += struct.pack('>h', 0)   # sTypoAscender
    os2_data += struct.pack('>h', 0)   # sTypoDescender
    os2_data += struct.pack('>h', 0)   # sTypoLineGap
    os2_data += struct.pack('>H', 0)   # usWinAscent
    os2_data += struct.pack('>H', 0)   # usWinDescent
    os2_data += struct.pack('>I', 0)   # ulCodePageRange1
    os2_data += struct.pack('>I', 0)   # ulCodePageRange2
    os2_data += struct.pack('>h', 0)   # sxHeight
    os2_data += struct.pack('>h', 0)   # sCapHeight
    os2_data += struct.pack('>H', 0)   # usDefaultChar
    os2_data += struct.pack('>H', 0)   # usBreakChar
    os2_data += struct.pack('>H', 0)   # usMaxContext
    tables['OS/2'] = os2_data
    
    # Now create the kerx table
    # kerx table header
    kerx_data = struct.pack('>H', 2)   # version = 2
    kerx_data += struct.pack('>H', 0)  # unused
    kerx_data += struct.pack('>I', 1)  # tableCount = 1
    
    # KerxSubTable (Format1)
    # First, KerxSubTableHeader
    # length, coverage, tupleCount
    # We'll fill length later
    coverage = 0x00000001  # type = 1 (Format1), horizontal
    tupleCount = 0
    
    # StateTable for ExtendedTypes:
    # nClasses (HBUINT32)
    # classTable (OffsetTo<Lookup<HBUINT16>, HBUINT32, false>)
    # stateArrayTable (OffsetTo<UnsizedArrayOf<HBUINT16>, HBUINT32, false>)
    # entryTable (OffsetTo<UnsizedArrayOf<Entry<EntryData>>, HBUINT32, false>)
    
    # We need:
    # - A class table (Lookup) that maps glyphs to classes
    # - A state array (matrix of states x classes)
    # - An entry table
    
    # For simplicity, let's use LookupFormat0 (format 0) for the class table
    # Format 0: HBUINT16 format (=0), then UnsizedArrayOf<HBUINT16> indexed by glyph ID
    
    # We have 3 glyphs (0, 1, 2). Let's assign:
    # glyph 0 -> class 0 (end of text)
    # glyph 1 -> class 2 (some class)
    # glyph 2 -> class 2 (some class)
    
    num_glyphs = 3
    class_lookup_data = struct.pack('>H', 0)  # format = 0
    for g in range(num_glyphs):
        if g == 0:
            class_lookup_data += struct.pack('>H', 0)  # class 0
        else:
            class_lookup_data += struct.pack('>H', 2)  # class 2
    
    # nClasses = 3 (classes 0, 1, 2 are used)
    nClasses = 3
    
    # State array: states x nClasses entries, each is HBUINT16 (entry index)
    # We need at least 2 states: state 0 (start of text) and state 1
    # For state 0:
    #   class 0 -> entry 0 (end of text)
    #   class 1 -> entry 1 (out of bounds)
    #   class 2 -> entry 2 (process glyph)
    # For state 1:
    #   class 0 -> entry 0 (end of text)
    #   class 1 -> entry 1 (out of bounds)
    #   class 2 -> entry 3 (process glyph with action)
    
    n_states = 2
    state_array = b''
    # State 0
    state_array += struct.pack('>H', 0)  # class 0 -> entry 0
    state_array += struct.pack('>H', 1)  # class 1 -> entry 1
    state_array += struct.pack('>H', 2)  # class 2 -> entry 2
    # State 1
    state_array += struct.pack('>H', 0)  # class 0 -> entry 0
    state_array += struct.pack('>H', 1)  # class 1 -> entry 1
    state_array += struct.pack('>H', 3)  # class 2 -> entry 3 (with action)
    
    # Entry table: each entry is 6 bytes (newState, flags, data/kernActionIndex)
    # Entry 0: end of text, stay in state 0
    # Entry 1: out of bounds, stay in state 0
    # Entry 2: process glyph, transition to state 1, no action
    # Entry 3: process glyph with action, transition to state 0, Push flag + kernActionIndex
    
    entries = b''
    # Entry 0: newState=0, flags=0, data=0
    entries += struct.pack('>H', 0)  # newState = 0
    entries += struct.pack('>H', 0)  # flags
    entries += struct.pack('>H', 0)  # data (kernActionIndex)
    
    # Entry 1: newState=0, flags=0, data=0
    entries += struct.pack('>H', 0)  # newState = 0
    entries += struct.pack('>H', 0)  # flags
    entries += struct.pack('>H', 0)  # data
    
    # Entry 2: newState=1, flags=Push (0x8000), data=0 (no action)
    entries += struct.pack('>H', 1)  # newState = 1
    entries += struct.pack('>H', 0x8000)  # flags = Push
    entries += struct.pack('>H', 0xFFFF)  # data = 0xFFFF (no action)
    
    # Entry 3: newState=0, flags=Push (0x8000), data=kernActionIndex=0
    entries += struct.pack('>H', 0)  # newState = 0
    entries += struct.pack('>H', 0x8000)  # flags = Push
    entries += struct.pack('>H', 0)  # data = kernActionIndex = 0
    
