    class_table_offset = state_table_header_size
    
    # stateArrayTable offset: after class lookup data
    state_array_offset = class_table_offset + len(class_lookup_data)
    
    # entryTable offset: after state array
    entry_table_offset = state_array_offset + len(state_array)
    
    # kernAction offset: after entry table (relative to machine)
    kern_action_offset = entry_table_offset + len(entries)
    
    # Build StateTable
    state_table = b''
    state_table += struct.pack('>I', nClasses)  # nClasses
    state_table += struct.pack('>I', class_table_offset)  # classTable offset
    state_table += struct.pack('>I', state_array_offset)  # stateArrayTable offset
    state_table += struct.pack('>I', entry_table_offset)  # entryTable offset
    
    # Add the data
    state_table += class_lookup_data
    state_table += state_array
    state_table += entries
    
    # kernAction array: just one FWORD value = 0
    kern_action_data = struct.pack('>h', 0)  # FWORD = 0
    
