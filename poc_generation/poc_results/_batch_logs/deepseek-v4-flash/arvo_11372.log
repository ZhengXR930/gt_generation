    # Entry 2: push glyph, transition to state 1
    entries += struct.pack('>HHH', 1, 0x8000, 0xFFFF)  # Push flag, no action
    # Entry 3: push + action, transition to state 0
    entries += struct.pack('>HHH', 0, 0x8000, 0)  # Push flag, kernActionIndex=0
    
