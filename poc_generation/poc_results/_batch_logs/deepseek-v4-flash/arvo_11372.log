    #   class 0 -> entry 0 (end, stay in state 0)
    #   class 1 -> entry 1 (out of bounds, stay in state 0)
    #   class 2 -> entry 2 (push glyph, go to state 1)
    # State 1: 
    #   class 0 -> entry 0 (end)
    #   class 1 -> entry 1 (out of bounds)
    #   class 2 -> entry 3 (push + action, go to state 0)
    
    n_states = 2
    state_array = b''
    # State 0
    state_array += struct.pack('>H', 0)  # class 0 -> entry 0
    state_array += struct.pack('>H', 1)  # class 1 -> entry 1
    state_array += struct.pack('>H', 2)  # class 2 -> entry 2
    # State 1
    state_array += struct.pack('>H', 0)  # class 0 -> entry 0
    state_array += struct.pack('>H', 1)  # class 1 -> entry 1
    state_array += struct.pack('>H', 3)  # class 2 -> entry 3
    
