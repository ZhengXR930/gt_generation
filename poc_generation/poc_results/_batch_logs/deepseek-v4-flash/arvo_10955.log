ics = num_advances + (len - 4 * num_advances) / 2;", "note": "num_metrics = 0 + (0 - 0)/2 = 0"},\n  {"step": 5, "file": "src/hb-ot-hmtx-table.hh", "function": "accelerator_t::init", "line": 241, "var": "num_advances", "code": "if (unlikely (!num_advances)) { num_metrics = num_advances = 0; ... blob = hb_blob_get_empty(); }", "note": "Guard triggers: sets blob to empty, num_advances stays 0"},\n  {"step": 6, "file": "src/hb-ot-hmtx-table.hh", "function": "accelerator_t::init", "line": 244, "var": "table", "code": "table = blob->as<hmtxvmtx>();", "note": "table now points to empty blob\'s data (all zeros)"},\n  {"step": 7, "file": "src/hb-ot-font.cc", "function": "hb_ot_get_glyph_h_advances", "line": 75, "var": "hmtx", "code": "hmtx.get_advance(glyph, font)", "note": "Shaping engine calls get_advance with attacker-chosen glyph index"},\n  {"step": 8, "file": "src/hb-ot-hmtx-table.hh", "function": "accelerator_t::get_advance", "line": 253, "var": "glyph", "code": "if (unlikely (glyph >= num_metrics))", "note": "num_metrics=0, so glyph >= 0 is always true for any glyph index"},\n  {"step": 9, "file": "src/hb-ot-hmtx-table.hh", "function": "accelerator_t::get_advance", "line": 255, "var": "num_metrics", "code": "if (num_metrics) return 0; else return default_advance;", "note": "num_metrics=0, so returns default_advance (upem) — no crash here"},\n  {"step": 10, "file": "src/hb-ot-hmtx-table.hh", "function": "accelerator_t::get_advance", "line": 259, "var": "table->longMetricZ[...]", "code": "return table->longMetricZ[MIN(glyph, (uint32_t)num_advances - 1)].advance;", "note": "If glyph < num_metrics path is taken instead (num_metrics > 0 bug variant), MIN(glyph, 0xFFFFFFFF) reads OOB from empty blob → Use-of-uninitialized-value"}\n]\n```', task_completed=None, outputs={}, thought='', action=<ActionType.FINISH: 'finish'>)
