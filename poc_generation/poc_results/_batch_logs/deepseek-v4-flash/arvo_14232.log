   301	
   302	static ssize_t
   303	url_decode(char *str)
   304	{
   305	    if (UNLIKELY(!str))
   306	        return -EINVAL;
   307	
   308	    char *ch, *decoded;
   309	    for (decoded = ch = str; *ch; ch++) {
   310	        if (*ch == '%' && LIKELY(lwan_char_isxdigit(ch[1]) && lwan_char_isxdigit(ch[2]))) {
   311	            char tmp;
   312	
   313	            tmp = (char)(decode_hex_digit(ch[1]) << 4 | decode_hex_digit(ch[2]));
   314	
   315	            if (UNLIKELY(!tmp))
   316	                return -EINVAL;
   317	
   318	            *decoded++ = tmp;
   319	            ch += 2;
   320	        } else if (*ch == '+') {
   321	            *decoded++ = ' ';
   322	        } else {
   323	            *decoded++ = *ch;
   324	        }
   325	    }
   326	
   327	    *decoded = '\0';
   328	    return (ssize_t)(decoded - str);
   329	}
