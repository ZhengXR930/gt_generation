   434	
   435	static void parse_fragment_and_query(struct lwan_request *request,
   436	                                     const char *space)
   437	{
   438	    struct lwan_request_parser_helper *helper = request->helper;
   439	
   440	    /* Most of the time, fragments are small -- so search backwards */
   441	    char *fragment = memrchr(request->url.value, '#', request->url.len);
   442	    if (fragment) {
   443	        *fragment = '\0';
   444	        helper->fragment.value = fragment + 1;
   445	        helper->fragment.len = (size_t)(space - fragment - 1);
   446	        request->url.len -= helper->fragment.len + 1;
   447	    }
   448	
   449	    /* Most of the time, query string values are larger than the URL, so
   450	       search from the beginning */
   451	    char *query_string = memchr(request->url.value, '?', request->url.len);
   452	    if (query_string) {
   453	        *query_string = '\0';
   454	        helper->query_string.value = query_string + 1;
   455	        helper->query_string.len =
   456	            (size_t)((fragment ? fragment : space) - query_string - 1);
   457	        request->url.len -= helper->query_string.len + 1;
   458	    }
   459	}
