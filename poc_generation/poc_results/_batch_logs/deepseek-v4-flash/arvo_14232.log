   117	static bool
   118	parse_ascii_port(char *port, unsigned short *out)
   119	{
   120	    unsigned long parsed;
   121	    char *end_ptr;
   122	
   123	    errno = 0;
   124	    parsed = strtoul(port, &end_ptr, 10);
   125	
   126	    if (UNLIKELY(errno != 0))
   127	        return false;
   128	
   129	    if (UNLIKELY(*end_ptr != '\0'))
   130	        return false;
   131	
   132	    if (UNLIKELY((unsigned long)(unsigned short)parsed != parsed))
   133	        return false;
   134	
   135	    *out = htons((unsigned short)parsed);
   136	    return true;
   137	}
