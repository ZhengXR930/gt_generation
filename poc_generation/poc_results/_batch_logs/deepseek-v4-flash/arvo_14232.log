   155	static char *
   156	parse_proxy_protocol_v1(struct lwan_request *request, char *buffer)
   157	{
   158	    static const size_t line_size = 108;
   159	    char *end, *protocol, *src_addr, *dst_addr, *src_port, *dst_port;
   160	    unsigned int size;
   161	    struct lwan_proxy *const proxy = request->proxy;
   162	
   163	    end = memchr(buffer, '\r', line_size);
   164	    if (UNLIKELY(!end || end[1] != '\n'))
   165	        return NULL;
   166	    *end = '\0';
   167	    size = (unsigned int) (end + 2 - buffer);
   168	
   169	    protocol = buffer + sizeof("PROXY ") - 1;
   170	    src_addr = strsep_char(protocol, ' ');
   171	    dst_addr = strsep_char(src_addr, ' ');
   172	    src_port = strsep_char(dst_addr, ' ');
   173	    dst_port = strsep_char(src_port, ' ');
   174	
   175	    if (UNLIKELY(!dst_port))
   176	        return NULL;
   177	
   178	    STRING_SWITCH(protocol) {
   179	    case MULTICHAR_CONSTANT('T', 'C', 'P', '4'): {
   180	        struct sockaddr_in *from = &proxy->from.ipv4;
   181	        struct sockaddr_in *to = &proxy->to.ipv4;
   182	
   183	        from->sin_family = to->sin_family = AF_INET;
   184	
   185	        if (UNLIKELY(inet_pton(AF_INET, src_addr, &from->sin_addr) <= 0))
   186	            return NULL;
   187	        if (UNLIKELY(inet_pton(AF_INET, dst_addr, &to->sin_addr) <= 0))
   188	            return NULL;
   189	        if (UNLIKELY(!parse_ascii_port(src_port, &from->sin_port)))
   190	            return NULL;
   191	        if (UNLIKELY(!parse_ascii_port(dst_port, &to->sin_port)))
   192	            return NULL;
   193	
   194	        break;
   195	    }
   196	    case MULTICHAR_CONSTANT('T', 'C', 'P', '6'): {
   197	        struct sockaddr_in6 *from = &proxy->from.ipv6;
   198	        struct sockaddr_in6 *to = &proxy->to.ipv6;
   199	
   200	        from->sin6_family = to->sin6_family = AF_INET6;
   201	
   202	        if (UNLIKELY(inet_pton(AF_INET6, src_addr, &from->sin6_addr) <= 0))
   203	            return NULL;
   204	        if (UNLIKELY(inet_pton(AF_INET6, dst_addr, &to->sin6_addr) <= 0))
   205	            return NULL;
   206	        if (UNLIKELY(!parse_ascii_port(src_port, &from->sin6_port)))
   207	            return NULL;
   208	        if (UNLIKELY(!parse_ascii_port(dst_port, &to->sin6_port)))
   209	            return NULL;
   210	
   211	        break;
   212	    }
   213	    default:
   214	        return NULL;
   215	    }
   216	
   217	    request->flags |= REQUEST_PROXIED;
   218	    return buffer + size;
   219	}
   220	
   221	static char *
   222	parse_proxy_protocol_v2(struct lwan_request *request, char *buffer)
   223	{
   224	    struct proxy_header_v2 *hdr = (struct proxy_header_v2*)buffer;
   225	    const unsigned int proto_signature_length = 16;
   226	    unsigned int size;
   227	    struct lwan_proxy *const proxy = request->proxy;
   228	
   229	    enum {
   230	        LOCAL = 0x20,
   231	        PROXY = 0x21,
   232	        TCP4 = 0x11,
   233	        TCP6 = 0x21
   234	    };
   235	
   236	    size = proto_signature_length + (unsigned int)ntohs(hdr->len);
   237	    if (UNLIKELY(size > (unsigned int)sizeof(*hdr)))
   238	        return NULL;
   239	
   240	    if (LIKELY(hdr->cmd_ver == PROXY)) {
   241	        if (hdr->fam == TCP4) {
   242	            struct sockaddr_in *from = &proxy->from.ipv4;
   243	            struct sockaddr_in *to = &proxy->to.ipv4;
   244	
   245	            to->sin_family = from->sin_family = AF_INET;
   246	
   247	            from->sin_addr.s_addr = hdr->addr.ip4.src_addr;
   248	            from->sin_port = hdr->addr.ip4.src_port;
   249	
   250	            to->sin_addr.s_addr = hdr->addr.ip4.dst_addr;
   251	            to->sin_port = hdr->addr.ip4.dst_port;
   252	        } else if (hdr->fam == TCP6) {
   253	            struct sockaddr_in6 *from = &proxy->from.ipv6;
   254	            struct sockaddr_in6 *to = &proxy->to.ipv6;
   255	
   256	            from->sin6_family = to->sin6_family = AF_INET6;
   257	
   258	            from->sin6_addr = hdr->addr.ip6.src_addr;
   259	            from->sin6_port = hdr->addr.ip6.src_port;
   260	
   261	            to->sin6_addr = hdr->addr.ip6.dst_addr;
   262	            to->sin6_port = hdr->addr.ip6.dst_port;
   263	        } else {
   264	            return NULL;
   265	        }
   266	    } else if (hdr->cmd_ver == LOCAL) {
   267	        struct sockaddr_in *from = &proxy->from.ipv4;
   268	        struct sockaddr_in *to = &proxy->to.ipv4;
   269	
   270	        from->sin_family = to->sin_family = AF_UNSPEC;
   271	    } else {
   272	        return NULL;
   273	    }
   274	
   275	    request->flags |= REQUEST_PROXIED;
   276	    return buffer + size;
   277	}
