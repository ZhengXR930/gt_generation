   344	
   345	static void parse_key_values(struct lwan_request *request,
   346	                             struct lwan_value *helper_value,
   347	                             struct lwan_key_value_array *array,
   348	                             ssize_t (*decode_value)(char *value),
   349	                             const char separator)
   350	{
   351	    struct lwan_key_value *kv;
   352	    char *ptr = helper_value->value;
   353	
   354	    if (!helper_value->len)
   355	        return;
   356	
   357	    lwan_key_value_array_init(array);
   358	    /* Calling lwan_key_value_array_reset() twice is fine, so even if 'goto
   359	     * error' is executed in this function, nothing bad should happen.  */
   360	    coro_defer(request->conn->coro, reset_key_value_array, array);
   361	
   362	    do {
   363	        char *key, *value;
   364	
   365	        while (*ptr == ' ' || *ptr == separator)
   366	            ptr++;
   367	        if (UNLIKELY(*ptr == '\0'))
   368	            goto error;
   369	
   370	        key = ptr;
   371	        ptr = strsep_char(key, separator);
   372	
   373	        value = strsep_char(key, '=');
   374	        if (UNLIKELY(!value)) {
   375	            value = "";
   376	        } else if (UNLIKELY(decode_value(value) < 0)) {
   377	            /* Disallow values that failed decoding, but allow empty values */
   378	            goto error;
   379	        }
   380	
   381	        if (UNLIKELY(decode_value(key) <= 0)) {
   382	            /* Disallow keys that failed decoding, or empty keys */
   383	            goto error;
   384	        }
   385	
   386	        kv = lwan_key_value_array_append(array);
   387	        if (UNLIKELY(!kv))
   388	            goto error;
   389	
   390	        kv->key = key;
   391	        kv->value = value;
   392	    } while (ptr);
   393	
   394	    lwan_key_value_array_sort(array, key_value_compare);
   395	
   396	    return;
   397	
   398	error:
   399	    lwan_key_value_array_reset(array);
   400	}
