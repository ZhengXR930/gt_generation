import struct

# XML with DOCTYPE PUBLIC and long public ID (>100 chars)
pubid = 'A' * 150
xml_doc = '<!DOCTYPE foo PUBLIC \"' + pubid + '\" \"http://example.com/\">\n<foo/>'

