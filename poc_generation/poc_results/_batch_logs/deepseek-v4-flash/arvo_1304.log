   361	/* Decodes the SafeContents, and puts the output in
   362	 * the given bag. 
   363	 */
   364	int
   365	_pkcs12_decode_safe_contents(const gnutls_datum_t * content,
   366	                             gnutls_pkcs12_bag_t bag)
   367	{
   368	        char oid[MAX_OID_SIZE], root[MAX_NAME_SIZE];
   369	        ASN1_TYPE c2 = ASN1_TYPE_EMPTY;
   370	        int len, result;
   371	        int bag_type;
   372	        gnutls_datum_t attr_val;
   373	        gnutls_datum_t t;
   374	        int count = 0, attributes, j;
   375	        unsigned i;
   376	
   377	        /* Step 1. Extract the SEQUENCE.
   378	         */
   379	
   380	        if ((result = asn1_create_element
   381	             (_gnutls_get_pkix(), "PKIX1.pkcs-12-SafeContents",
   382	              &c2)) != ASN1_SUCCESS) {
   383	                gnutls_assert();
   384	                result = _gnutls_asn2err(result);
   385	                goto cleanup;
   386	        }
   387	
   388	        result =
   389	            asn1_der_decoding(&c2, content->data, content->size, NULL);
   390	        if (result != ASN1_SUCCESS) {
   391	                gnutls_assert();
   392	                result = _gnutls_asn2err(result);
   393	                goto cleanup;
   394	        }
   395	
   396	        /* Count the number of bags
   397	         */
   398	        result = asn1_number_of_elements(c2, "", &count);
   399	        if (result != ASN1_SUCCESS) {
   400	                gnutls_assert();
   401	                result = _gnutls_asn2err(result);
   402	                goto cleanup;
   403	        }
   404	
   405	        bag->bag_elements = MIN(MAX_BAG_ELEMENTS, count);
   406	
   407	        for (i = 0; i < bag->bag_elements; i++) {
   408	
   409	                snprintf(root, sizeof(root), "?%u.bagId", i + 1);
   410	
   411	                len = sizeof(oid);
   412	                result = asn1_read_value(c2, root, oid, &len);
   413	                if (result != ASN1_SUCCESS) {
   414	                        gnutls_assert();
   415	                        result = _gnutls_asn2err(result);
   416	                        goto cleanup;
   417	                }
   418	
   419	                /* Read the Bag type
   420	                 */
   421	                bag_type = oid2bag(oid);
   422	
   423	                if (bag_type < 0) {
   424	                        gnutls_assert();
   425	                        goto cleanup;
   426	                }
   427	
   428	                /* Read the Bag Value
   429	                 */
   430	
   431	                snprintf(root, sizeof(root), "?%u.bagValue", i + 1);
   432	
   433	                result =
   434	                    _gnutls_x509_read_value(c2, root,
   435	                                            &bag->element[i].data);
   436	                if (result < 0) {
   437	                        gnutls_assert();
   438	                        goto cleanup;
   439	                }
   440	
   441	                if (bag_type == GNUTLS_BAG_CERTIFICATE
   442	                    || bag_type == GNUTLS_BAG_CRL
   443	                    || bag_type == GNUTLS_BAG_SECRET) {
   444	                        gnutls_datum_t tmp = bag->element[i].data;
   445	
   446	                        result =
   447	                            _pkcs12_decode_crt_bag(bag_type, &tmp,
   448	                                                   &bag->element[i].data);
   449	                        if (result < 0) {
   450	                                gnutls_assert();
   451	                                goto cleanup;
   452	                        }
   453	
   454	                        _gnutls_free_datum(&tmp);
   455	                }
   456	
   457	                /* read the bag attributes
   458	                 */
   459	                snprintf(root, sizeof(root), "?%u.bagAttributes", i + 1);
   460	
   461	                result = asn1_number_of_elements(c2, root, &attributes);
   462	                if (result != ASN1_SUCCESS
   463	                    && result != ASN1_ELEMENT_NOT_FOUND) {
   464	                        gnutls_assert();
   465	                        result = _gnutls_asn2err(result);
   466	                        goto cleanup;
   467	                }
   468	
   469	                if (attributes < 0)
   470	                        attributes = 1;
   471	
   472	                if (result != ASN1_ELEMENT_NOT_FOUND)
   473	                        for (j = 0; j < attributes; j++) {
   474	
   475	                                snprintf(root, sizeof(root),
   476	                                         "?%u.bagAttributes.?%u", i + 1,
   477	                                         j + 1);
   478	
   479	                                result =
   480	                                    _gnutls_x509_decode_and_read_attribute
   481	                                    (c2, root, oid, sizeof(oid), &attr_val,
   482	                                     1, 0);
   483	
   484	                                if (result < 0) {
   485	                                        gnutls_assert();
   486	                                        continue;       /* continue in case we find some known attributes */
   487	                                }
   488	
   489	                                if (strcmp(oid, KEY_ID_OID) == 0) {
   490	                                        result =
   491	                                            _gnutls_x509_decode_string
   492	                                            (ASN1_ETYPE_OCTET_STRING,
   493	                                             attr_val.data, attr_val.size,
   494	                                             &t, 1);
   495	
   496	                                        _gnutls_free_datum(&attr_val);
   497	                                        if (result < 0) {
   498	                                                gnutls_assert();
   499	                                                _gnutls_debug_log
   500	                                                    ("Error decoding PKCS12 Bag Attribute OID '%s'\n",
   501	                                                     oid);
   502	                                                continue;
   503	                                        }
   504	
   505	                                        _gnutls_free_datum(&bag->element[i].local_key_id);
   506	                                        bag->element[i].local_key_id.data = t.data;
   507	                                        bag->element[i].local_key_id.size = t.size;
   508	                                } else if (strcmp(oid, FRIENDLY_NAME_OID) == 0 && bag->element[i].friendly_name == NULL) {
   509	                                        result =
   510	                                            _gnutls_x509_decode_string
   511	                                            (ASN1_ETYPE_BMP_STRING,
   512	                                             attr_val.data, attr_val.size,
   513	                                             &t, 1);
   514	
   515	                                        _gnutls_free_datum(&attr_val);
   516	                                        if (result < 0) {
   517	                                                gnutls_assert();
   518	                                                _gnutls_debug_log
   519	                                                    ("Error decoding PKCS12 Bag Attribute OID '%s'\n",
   520	                                                     oid);
   521	                                                continue;
   522	                                        }
   523	
   524	                                        gnutls_free(bag->element[i].friendly_name);
   525	                                        bag->element[i].friendly_name = (char *) t.data;
   526	                                } else {
   527	                                        _gnutls_free_datum(&attr_val);
   528	                                        _gnutls_debug_log
   529	                                            ("Unknown PKCS12 Bag Attribute OID '%s'\n",
   530	                                             oid);
   531	                                }
   532	                        }
   533	
   534	
   535	                bag->element[i].type = bag_type;
   536	
   537	        }
   538	
   539	        result = 0;
   540	
   541	      cleanup:
   542	        if (c2)
   543	                asn1_delete_structure(&c2);
   544	        return result;
   545	
   546	}
