   549	static int
   550	_parse_safe_contents(ASN1_TYPE sc, const char *sc_name,
   551	                     gnutls_pkcs12_bag_t bag)
   552	{
   553	        gnutls_datum_t content = { NULL, 0 };
   554	        int result;
   555	
   556	        /* Step 1. Extract the content.
   557	         */
   558	
   559	        result =
   560	            _gnutls_x509_read_string(sc, sc_name, &content,
   561	                                     ASN1_ETYPE_OCTET_STRING, 1);
   562	        if (result < 0) {
   563	                gnutls_assert();
   564	                goto cleanup;
   565	        }
