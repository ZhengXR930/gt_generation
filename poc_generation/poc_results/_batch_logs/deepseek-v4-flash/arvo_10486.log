   524	int ssh_buffer_prepend_data(struct ssh_buffer_struct *buffer, const void *data,
   525	    uint32_t len) {
   526	  buffer_verify(buffer);
   527	
   528	  if(len <= buffer->pos){
   529	    /* It's possible to insert data between begin and pos */
   530	    memcpy(buffer->data + (buffer->pos - len), data, len);
