   222	/** @internal
   223	 * @brief shifts a buffer to remove unused data in the beginning
   224	 * @param buffer SSH buffer
   225	 */
   226	static void buffer_shift(ssh_buffer buffer)
   227	{
   228	    size_t burn_pos = buffer->pos;
   229	
   230	    buffer_verify(buffer);
   231	
   232	    if (buffer->pos == 0) {
   233	        return;
   234	    }
   235	    memmove(buffer->data,
   236	            buffer->data + buffer->pos,
   237	            buffer->used - buffer->pos);
   238	    buffer->used -= buffer->pos;
   239	    buffer->pos = 0;
   240	
   241	    if (buffer->secure) {
   242	        void *ptr = buffer->data + buffer->used;
   243	        explicit_bzero(ptr, burn_pos);
   244	    }
   245	
   246	    buffer_verify(buffer);
   247	}
