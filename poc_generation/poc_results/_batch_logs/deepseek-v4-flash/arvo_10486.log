   300	int ssh_buffer_add_data(struct ssh_buffer_struct *buffer, const void *data, uint32_t len)
   301	{
   302	  buffer_verify(buffer);
   303	
   304	  if (data == NULL) {
   305	      return -1;
   306	  }
   307	
   308	  if (buffer->used + len < len) {
   309	    return -1;
   310	  }
   311	
   312	  if (buffer->allocated < (buffer->used + len)) {
   313	    if(buffer->pos > 0)
   314	      buffer_shift(buffer);
   315	    if (realloc_buffer(buffer, buffer->used + len) < 0) {
   316	      return -1;
   317	    }
   318	  }
   319	
   320	  memcpy(buffer->data+buffer->used, data, len);
   321	  buffer->used+=len;
   322	  buffer_verify(buffer);
   323	  return 0;
   324	}
