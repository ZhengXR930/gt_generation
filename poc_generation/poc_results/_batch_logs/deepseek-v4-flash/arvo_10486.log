   128	
   129	    /*
   130	     * Always preallocate 64 bytes.
   131	     *
   132	     * -1 for ralloc_buffer magic.
   133	     */
   134	    rc = ssh_buffer_allocate_size(buf, 64 - 1);
   135	    if (rc != 0) {
   136	        SAFE_FREE(buf);
   137	        return NULL;
