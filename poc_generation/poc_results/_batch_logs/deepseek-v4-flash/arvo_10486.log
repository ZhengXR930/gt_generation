   181	static int realloc_buffer(struct ssh_buffer_struct *buffer, size_t needed)
   182	{
   183	    size_t smallest = 1;
   184	    uint8_t *new = NULL;
   185	
   186	    buffer_verify(buffer);
   187	
   188	    /* Find the smallest power of two which is greater or equal to needed */
   189	    while(smallest <= needed) {
   190	        if (smallest == 0) {
   191	            return -1;
   192	        }
   193	        smallest <<= 1;
   194	    }
   195	    needed = smallest;
   196	
   197	    if (needed > BUFFER_SIZE_MAX) {
   198	        return -1;
   199	    }
   200	
   201	    if (buffer->secure) {
   202	        new = malloc(needed);
   203	        if (new == NULL) {
   204	            return -1;
   205	        }
   206	        memcpy(new, buffer->data, buffer->used);
   207	        explicit_bzero(buffer->data, buffer->used);
   208	        SAFE_FREE(buffer->data);
   209	    } else {
   210	        new = realloc(buffer->data, needed);
   211	        if (new == NULL) {
   212	            return -1;
   213	        }
   214	    }
   215	    buffer->data = new;
   216	    buffer->allocated = needed;
   217	
   218	    buffer_verify(buffer);
   219	    return 0;
   220	}
