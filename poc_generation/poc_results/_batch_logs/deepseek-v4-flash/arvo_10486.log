   540	  if (buffer->allocated < (buffer->used - buffer->pos + len)) {
   541	    if (realloc_buffer(buffer, buffer->used - buffer->pos + len) < 0) {
   542	      return -1;
   543	    }
   544	  }
   545	  memmove(buffer->data + len, buffer->data + buffer->pos, buffer->used - buffer->pos);
   546	  memcpy(buffer->data, data, len);
   547	  buffer->used += len - buffer->pos;
   548	  buffer->pos = 0;
   549	  buffer_verify(buffer);
   550	  return 0;
   551	}
