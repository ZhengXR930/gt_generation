  GTKDOCIZE=""
else
  $GTKDOCIZE
fi

$GIT submodule init
$GIT submodule update
$AUTORECONF --install --force --symlink

echo
echo "----------------------------------------------------------------"
echo "Initialized build system. For a common configuration please run:"
echo "----------------------------------------------------------------"
echo
if test -z $GTKDOCIZE; then
  echo "./configure"
else
  echo "./configure --enable-gtk-doc"
fi
echo
