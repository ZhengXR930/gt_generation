ucl_parser_add_string_priority (struct ucl_parser *parser, const char *data,
                size_t len, unsigned priority)
{
        if (data == NULL) {
                ucl_create_err (&parser->err, "invalid string added");
                return false;
        }
        if (len == 0) {
                len = strlen (data);
        }

        return ucl_parser_add_chunk_priority (parser,
