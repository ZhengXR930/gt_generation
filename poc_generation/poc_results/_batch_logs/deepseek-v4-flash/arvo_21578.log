   416	/**
   417	 * Expand a single variable
   418	 * @param parser
   419	 * @param ptr
   420	 * @param remain
   421	 * @param dest
   422	 * @return
   423	 */
   424	static const char *
   425	ucl_expand_single_variable (struct ucl_parser *parser, const char *ptr,
   426	                size_t remain, unsigned char **dest)
   427	{
   428	        unsigned char *d = *dest, *dst;
   429	        const char *p = ptr + 1, *ret;
   430	        struct ucl_variable *var;
   431	        size_t dstlen;
   432	        bool need_free = false;
   433	        bool found = false;
   434	        bool strict = false;
   435	
   436	        ret = ptr + 1;
   437	        remain --;
   438	
   439	        if (*p == '$') {
   440	                *d++ = *p++;
   441	                *dest = d;
   442	                return p;
   443	        }
   444	        else if (*p == '{') {
   445	                p ++;
   446	                strict = true;
   447	                ret += 2;
   448	                remain -= 2;
   449	        }
   450	
   451	        LL_FOREACH (parser->variables, var) {
   452	                if (remain >= var->var_len) {
   453	                        if (memcmp (p, var->var, var->var_len) == 0) {
   454	                                memcpy (d, var->value, var->value_len);
   455	                                ret += var->var_len;
   456	                                d += var->value_len;
   457	                                found = true;
   458	                                break;
   459	                        }
   460	                }
   461	        }
   462	        if (!found) {
   463	                if (strict && parser->var_handler != NULL) {
   464	                        if (parser->var_handler (ptr, remain, &dst, &dstlen, &need_free,
   465	                                                        parser->var_data)) {
   466	                                memcpy (d, dst, dstlen);
   467	                                ret += dstlen;
   468	                                d += remain;
   469	                                found = true;
   470	                        }
   471	                }
   472	
   473	                /* Leave variable as is */
   474	                if (!found) {
   475	                        if (strict) {
   476	                                /* Copy '${' */
   477	                                memcpy (d, ptr, 2);
   478	                                d += 2;
   479	                                ret --;
   480	                        }
   481	                        else {
   482	                                memcpy (d, ptr, 1);
   483	                                d ++;
   484	                        }
   485	                }
   486	        }
   487	
   488	        *dest = d;
   489	        return ret;
   490	}
