   313	static inline const char *
   314	ucl_check_variable_safe (struct ucl_parser *parser, const char *ptr, size_t remain,
   315	                size_t *out_len, bool strict, bool *found)
   316	{
   317	        struct ucl_variable *var;
   318	        unsigned char *dst;
   319	        size_t dstlen;
