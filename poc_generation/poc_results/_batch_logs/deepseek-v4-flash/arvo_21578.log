   359	/**
   360	 * Check for a variable in a given string
   361	 * @param parser
   362	 * @param ptr
   363	 * @param remain
   364	 * @param out_len
   365	 * @param vars_found
   366	 * @return
   367	 */
   368	static const char *
   369	ucl_check_variable (struct ucl_parser *parser, const char *ptr,
   370	                size_t remain, size_t *out_len, bool *vars_found)
   371	{
   372	        const char *p, *end, *ret = ptr;
   373	        bool found = false;
   374	
   375	        if (*ptr == '{') {
   376	                /* We need to match the variable enclosed in braces */
   377	                p = ptr + 1;
   378	                end = ptr + remain;
   379	                while (p < end) {
   380	                        if (*p == '}') {
   381	                                ret = ucl_check_variable_safe (parser, ptr + 1, p - ptr - 1,
   382	                                                out_len, true, &found);
   383	                                if (found) {
   384	                                        /* {} must be excluded actually */
   385	                                        ret ++;
   386	                                        if (!*vars_found) {
   387	                                                *vars_found = true;
   388	                                        }
   389	                                }
   390	                                else {
   391	                                        *out_len += 2;
   392	                                }
   393	                                break;
   394	                        }
   395	                        p ++;
   396	                }
   397	        }
   398	        else if (*ptr != '$') {
   399	                /* Not count escaped dollar sign */
   400	                ret = ucl_check_variable_safe (parser, ptr, remain, out_len, false, &found);
   401	                if (found && !*vars_found) {
   402	                        *vars_found = true;
   403	                }
   404	                if (!found) {
   405	                        (*out_len) ++;
   406	                }
   407	        }
   408	        else {
   409	                ret ++;
   410	                (*out_len) ++;
   411	        }
   412	
   413	        return ret;
   414	}
