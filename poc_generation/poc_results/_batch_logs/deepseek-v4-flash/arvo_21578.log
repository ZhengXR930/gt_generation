   552	/**
   553	 * Store or copy pointer to the trash stack
   554	 * @param parser parser object
   555	 * @param src src string
   556	 * @param dst destination buffer (trash stack pointer)
   557	 * @param dst_const const destination pointer (e.g. value of object)
   558	 * @param in_len input length
   559	 * @param need_unescape need to unescape source (and copy it)
   560	 * @param need_lowercase need to lowercase value (and copy)
   561	 * @param need_expand need to expand variables (and copy as well)
   562	 * @param unescape_squote unescape single quoted string
   563	 * @return output length (excluding \0 symbol)
   564	 */
   565	static inline ssize_t
   566	ucl_copy_or_store_ptr (struct ucl_parser *parser,
   567	                const unsigned char *src, unsigned char **dst,
   568	                const char **dst_const, size_t in_len,
   569	                bool need_unescape, bool need_lowercase, bool need_expand,
   570	                bool unescape_squote)
   571	{
   572	        ssize_t ret = -1, tret;
   573	        unsigned char *tmp;
   574	
   575	        if (need_unescape || need_lowercase ||
   576	                        (need_expand && parser->variables != NULL) ||
   577	                        !(parser->flags & UCL_PARSER_ZEROCOPY)) {
   578	                /* Copy string */
   579	                *dst = UCL_ALLOC (in_len + 1);
   580	                if (*dst == NULL) {
   581	                        ucl_set_err (parser, UCL_EINTERNAL, "cannot allocate memory for a string",
   582	                                        &parser->err);
   583	                        return false;
   584	                }
   585	                if (need_lowercase) {
   586	                        ret = ucl_strlcpy_tolower (*dst, src, in_len + 1);
   587	                }
   588	                else {
   589	                        ret = ucl_strlcpy_unsafe (*dst, src, in_len + 1);
   590	                }
   591	
   592	                if (need_unescape) {
   593	                        if (!unescape_squote) {
   594	                                ret = ucl_unescape_json_string (*dst, ret);
   595	                        }
   596	                        else {
   597	                                ret = ucl_unescape_squoted_string (*dst, ret);
   598	                        }
   599	                }
   600	
   601	                if (need_expand) {
   602	                        tmp = *dst;
   603	                        tret = ret;
   604	                        ret = ucl_expand_variable (parser, dst, tmp, ret);
   605	                        if (*dst == NULL) {
   606	                                /* Nothing to expand */
   607	                                *dst = tmp;
   608	                                ret = tret;
   609	                        }
   610	                        else {
   611	                                /* Free unexpanded value */
   612	                                UCL_FREE (in_len + 1, tmp);
   613	                        }
   614	                }
   615	                *dst_const = *dst;
   616	        }
   617	        else {
   618	                *dst_const = src;
   619	                ret = in_len;
   620	        }
   621	
   622	        return ret;
   623	}
