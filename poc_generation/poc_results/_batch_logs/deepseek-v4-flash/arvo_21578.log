   492	/**
   493	 * Expand variables in string
   494	 * @param parser
   495	 * @param dst
   496	 * @param src
   497	 * @param in_len
   498	 * @return
   499	 */
   500	static ssize_t
   501	ucl_expand_variable (struct ucl_parser *parser, unsigned char **dst,
   502	                const char *src, size_t in_len)
