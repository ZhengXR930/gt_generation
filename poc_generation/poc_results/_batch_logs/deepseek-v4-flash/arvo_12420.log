   173	            }
   174	          len2++;
   175	        }
   176	      else if (map_is (&map, TR46_FLG_MAPPED))
   177	        {
   178	          len2 += map.nmappings;
   179	        }
   180	      else if (map_is (&map, TR46_FLG_VALID))
   181	        {
   182	          len2++;
   183	        }
   184	      else if (map_is (&map, TR46_FLG_IGNORED))
   185	        {
   186	          continue;
   187	        }
   188	      else if (map_is (&map, TR46_FLG_DEVIATION))
   189	        {
   190	          if (transitional)
   191	            {
   192	              len2 += map.nmappings;
   193	            }
   194	          else
   195	            len2++;
   196	        }
   197	      else if (!(flags & IDN2_USE_STD3_ASCII_RULES))
   198	        {
   199	          if (map_is (&map, TR46_FLG_DISALLOWED_STD3_VALID))
   200	            {
   201	              /* valid because UseSTD3ASCIIRules=false, see #TR46 5 */
   202	              len2++;
   203	            }
   204	          else if (map_is (&map, TR46_FLG_DISALLOWED_STD3_MAPPED))
   205	            {
   206	              /* mapped because UseSTD3ASCIIRules=false, see #TR46 5 */
   207	              len2 += map.nmappings;
   208	            }
   209	        }
   210	    }
   211	
   212	  uint32_t *tmp = (uint32_t *) malloc ((len2 + 1) * sizeof (uint32_t));
   213	  if (!tmp)
   214	    {
   215	      free (domain_u32);
   216	      return IDN2_MALLOC;
   217	    }
   218	
   219	  len2 = 0;
   220	  for (it = 0; it < len - 1; it++)
   221	    {
   222	      uint32_t c = domain_u32[it];
   223	      IDNAMap map;
   224	
   225	      get_idna_map (c, &map);
   226	
   227	      if (map_is (&map, TR46_FLG_DISALLOWED))
   228	        {
   229	          tmp[len2++] = c;
   230	        }
   231	      else if (map_is (&map, TR46_FLG_MAPPED))
   232	        {
   233	          len2 += get_map_data (tmp + len2, &map);
   234	        }
   235	      else if (map_is (&map, TR46_FLG_VALID))
   236	        {
   237	          tmp[len2++] = c;
   238	        }
   239	      else if (map_is (&map, TR46_FLG_IGNORED))
   240	        {
   241	          continue;
   242	        }
   243	      else if (map_is (&map, TR46_FLG_DEVIATION))
   244	        {
   245	          if (transitional)
   246	            {
   247	              len2 += get_map_data (tmp + len2, &map);
   248	            }
   249	          else
   250	            tmp[len2++] = c;
   251	        }
   252	      else if (!(flags & IDN2_USE_STD3_ASCII_RULES))
   253	        {
   254	          if (map_is (&map, TR46_FLG_DISALLOWED_STD3_VALID))
   255	            {
