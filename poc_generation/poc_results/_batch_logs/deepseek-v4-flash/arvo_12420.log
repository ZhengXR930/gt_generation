   473	  if (lookupname)
   474	    {
   475	      uint8_t *tmp = (uint8_t *) malloc (lookupnamelen + 1);
   476	
   477	      if (tmp == NULL)
   478	        return IDN2_MALLOC;
   479	
   480	      memcpy (tmp, _lookupname, lookupnamelen + 1);
   481	      *lookupname = tmp;
   482	    }
   483	
   484	  return IDN2_OK;
   485	}
