   361	/**
   362	 * idn2_lookup_u8:
   363	 * @src: input zero-terminated UTF-8 string in Unicode NFC normalized form.
   364	 * @lookupname: newly allocated output variable with name to lookup in DNS.
   365	 * @flags: optional #idn2_flags to modify behaviour.
   366	 *
   367	 * Perform IDNA2008 lookup string conversion on domain name @src, as
   368	 * described in section 5 of RFC 5891.  Note that the input string
   369	 * must be encoded in UTF-8 and be in Unicode NFC form.
   370	 *
   371	 * Pass %IDN2_NFC_INPUT in @flags to convert input to NFC form before
   372	 * further processing.  %IDN2_TRANSITIONAL and %IDN2_NONTRANSITIONAL
   373	 * do already imply %IDN2_NFC_INPUT.
   374	 * Pass %IDN2_ALABEL_ROUNDTRIP in @flags to
   375	 * convert any input A-labels to U-labels and perform additional
   376	 * testing (not implemented yet).
   377	 * Pass %IDN2_TRANSITIONAL to enable Unicode TR46
   378	 * transitional processing, and %IDN2_NONTRANSITIONAL to enable
   379	 * Unicode TR46 non-transitional processing.  Multiple flags may be
   380	 * specified by binary or:ing them together.
   381	 *
   382	 * After version 2.0.3: %IDN2_USE_STD3_ASCII_RULES disabled by default.
   383	 * Previously we were eliminating non-STD3 characters from domain strings
   384	 * such as _443._tcp.example.com, or IPs 1.2.3.4/24 provided to libidn2
   385	 * functions. That was an unexpected regression for applications switching
   386	 * from libidn and thus it is no longer applied by default.
   387	 * Use %IDN2_USE_STD3_ASCII_RULES to enable that behavior again.
   388	 *
   389	 * After version 0.11: @lookupname may be NULL to test lookup of @src
   390	 * without allocating memory.
   391	 *
   392	 * Returns: On successful conversion %IDN2_OK is returned, if the
   393	 *   output domain or any label would have been too long
   394	 *   %IDN2_TOO_BIG_DOMAIN or %IDN2_TOO_BIG_LABEL is returned, or
   395	 *   another error code is returned.
   396	 *
   397	 * Since: 0.1
   398	 **/
   399	int
   400	idn2_lookup_u8 (const uint8_t * src, uint8_t ** lookupname, int flags)
   401	{
   402	  size_t lookupnamelen = 0;
   403	  uint8_t _lookupname[IDN2_DOMAIN_MAX_LENGTH + 1];
   404	  uint8_t _mapped[IDN2_DOMAIN_MAX_LENGTH + 1];
   405	  int rc;
   406	
   407	  if (src == NULL)
   408	    {
   409	      if (lookupname)
   410	        *lookupname = NULL;
   411	      return IDN2_OK;
   412	    }
   413	
   414	  rc = set_default_flags(&flags);
   415	  if (rc != IDN2_OK)
   416	    return rc;
   417	
   418	  if (!(flags & IDN2_NO_TR46))
   419	    {
   420	      uint8_t *out;
   421	      size_t outlen;
   422	
   423	      rc = _tr46 (src, &out, flags);
   424	      if (rc != IDN2_OK)
   425	        return rc;
   426	
   427	      outlen = u8_strlen (out);
   428	      if (outlen >= sizeof (_mapped))
   429	        {
   430	          free (out);
   431	          return IDN2_TOO_BIG_DOMAIN;
   432	        }
   433	
   434	      memcpy (_mapped, out, outlen + 1);
   435	      src = _mapped;
   436	      free (out);
   437	    }
   438	
   439	  do
   440	    {
   441	      const uint8_t *end = (uint8_t *) strchrnul ((const char *) src, '.');
   442	      /* XXX Do we care about non-U+002E dots such as U+3002, U+FF0E
   443	         and U+FF61 here?  Perhaps when IDN2_NFC_INPUT? */
   444	      size_t labellen = end - src;
   445	      uint8_t tmp[IDN2_LABEL_MAX_LENGTH];
   446	      size_t tmplen = IDN2_LABEL_MAX_LENGTH;
   447	
   448	      rc = label (src, labellen, tmp, &tmplen, flags);
   449	      if (rc != IDN2_OK)
   450	        return rc;
   451	
   452	      if (lookupnamelen + tmplen
   453	          > IDN2_DOMAIN_MAX_LENGTH - (tmplen == 0 && *end == '\0' ? 1 : 2))
   454	        return IDN2_TOO_BIG_DOMAIN;
   455	
   456	      memcpy (_lookupname + lookupnamelen, tmp, tmplen);
   457	      lookupnamelen += tmplen;
   458	
   459	      if (*end == '.')
   460	        {
   461	          if (lookupnamelen + 1 > IDN2_DOMAIN_MAX_LENGTH)
   462	            return IDN2_TOO_BIG_DOMAIN;
