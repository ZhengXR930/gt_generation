   307	          free (ace);
   308	
   309	          if (rc)
   310	            {
   311	              free (domain_u32);
   312	              return rc;
   313	            }
   314	
   315	          test_flags = TR46_NONTRANSITIONAL_CHECK;
   316	
   317	          if (!(flags & IDN2_USE_STD3_ASCII_RULES))
   318	            test_flags |= TEST_ALLOW_STD3_DISALLOWED;
