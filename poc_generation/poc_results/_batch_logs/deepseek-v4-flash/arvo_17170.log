    65	        size_t left = buflen, len;
    66	        unsigned int cla, tag, i;
    67	
    68	        *buf = NULL;
    69	
    70	        if (left == 0)
    71	                return SC_ERROR_INVALID_ASN1_OBJECT;
    72	        if (*p == 0xff || *p == 0) {
    73	                /* end of data reached */
    74	                *taglen = 0;
    75	                *tag_out = SC_ASN1_TAG_EOC;
    76	                return SC_SUCCESS;
    77	        }
    78	
    79	        /* parse tag byte(s)
    80	         * Resulted tag is presented by integer that has not to be
    81	         * confused with the 'tag number' part of ASN.1 tag.
    82	         */
    83	        cla = (*p & SC_ASN1_TAG_CLASS) | (*p & SC_ASN1_TAG_CONSTRUCTED);
    84	        tag = *p & SC_ASN1_TAG_PRIMITIVE;
