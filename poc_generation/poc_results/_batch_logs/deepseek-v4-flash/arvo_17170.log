   173	        sc_hex_dump(buf, buflen, lines, lines_len);
   174	
   175	        while (*line != '\0') {
   176	                char *line_end = strchr(line, '\n');
   177	                ptrdiff_t width = line_end - line;
   178	                if (!line_end || width <= 1) {
   179	                        /* don't print empty lines */
   180	                        break;
   181	                }
   182	                if (buflen > 8) {
   183	                        putchar('\n');
   184	                        print_indent(depth);
