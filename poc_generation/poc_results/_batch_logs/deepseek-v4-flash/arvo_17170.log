   300	
   301	static void sc_asn1_print_utctime(const u8 * buf, size_t buflen)
   302	{
   303	        if (buflen < 8) {
   304	                printf("Error in decoding.\n");
   305	                return;
   306	        }
   307	
   308	        print_ascii(buf, 2);            /* YY */
   309	        putchar('-');
   310	        print_ascii(buf+2, 2);          /* MM */
   311	        putchar('-');
   312	        print_ascii(buf+4, 2);          /* DD */
   313	        putchar(' ');
   314	        print_ascii(buf+6, 2);          /* hh */
   315	        buf += 8;
   316	        buflen -= 8;
   317	        if (buflen >= 2 && isdigit(buf[0]) && isdigit(buf[1])) {
   318	                putchar(':');
   319	                print_ascii(buf, 2);    /* mm */
   320	                buf += 2;
   321	                buflen -= 2;
   322	        }
   323	        if (buflen >= 2 && isdigit(buf[0]) && isdigit(buf[1])) {
   324	                putchar(':');
   325	                print_ascii(buf, 2);    /* ss */
   326	                buf += 2;
   327	                buflen -= 2;
   328	        }
   329	        if (buflen >= 4 && '.' == buf[0]) {
   330	                print_ascii(buf, 4);    /* fff */
   331	                buf += 4;
   332	                buflen -= 4;
   333	        }
   334	
   335	        if (buflen >= 1 && 'Z' == buf[0]) {
   336	                printf(" UTC");
   337	        } else if (buflen >= 5 && ('-' == buf[0] || '+' == buf[0])) {
   338	                putchar(' ');
   339	                print_ascii(buf, 3);    /* +/-hh */
   340	                putchar(':');
   341	                print_ascii(buf+3, 2);  /* mm */
   342	        }
   343	}
   344	
   345	static void sc_asn1_print_generalizedtime(const u8 * buf, size_t buflen)
   346	{
   347	        if (buflen < 8) {
   348	                printf("Error in decoding.\n");
   349	                return;
   350	        }
   351	
   352	        print_ascii(buf, 2);
   353	        sc_asn1_print_utctime(buf + 2, buflen - 2);
   354	}
   355	
   356	static void print_tags_recursive(const u8 * buf0, const u8 * buf,
   357	                                 size_t buflen, size_t depth)
   358	{
   359	        int r;
   360	        size_t i;
   361	        size_t bytesleft = buflen;
   362	        const char *classes[4] = {
   363	                "Universal",
   364	                "Application",
   365	                "Context",
   366	                "Private"
   367	        };
   368	        const u8 *p = buf;
   369	
   370	        while (bytesleft >= 2) {
   371	                unsigned int cla = 0, tag = 0, hlen;
   372	                const u8 *tagp = p;
   373	                size_t len;
   374	
   375	                r = sc_asn1_read_tag(&tagp, bytesleft, &cla, &tag, &len);
   376	                if (r != SC_SUCCESS || tagp == NULL) {
   377	                        printf("Error in decoding.\n");
   378	                        return;
   379	                }
   380	                hlen = tagp - p;
   381	                if (cla == 0 && tag == 0) {
   382	                        printf("Zero tag, finishing\n");
   383	                        break;
   384	                }
   385	                print_indent(depth);
   386	                /* let i be the length of the tag in bytes */
   387	                for (i = 1; i < sizeof tag - 1; i++) {
   388	                        if (!(tag >> 8*i))
   389	                                break;
   390	                }
   391	                printf("%02X", cla<<(i-1)*8 | tag);
   392	
   393	                if ((cla & SC_ASN1_TAG_CLASS) == SC_ASN1_TAG_UNIVERSAL) {
   394	                        printf(" %s", tag2str(tag));
   395	                } else {
   396	                        printf(" %s %-2u",
   397	                                        classes[cla >> 6],
   398	                                        i == 1 ? tag & SC_ASN1_TAG_PRIMITIVE : tag & (((unsigned int) ~0) >> (i-1)*8));
   399	                }
   400	                if (!((cla & SC_ASN1_TAG_CLASS) == SC_ASN1_TAG_UNIVERSAL
   401	                                        && tag == SC_ASN1_TAG_NULL && len == 0)) {
   402	                        printf(" (%"SC_FORMAT_LEN_SIZE_T"u byte%s)",
   403	                                        len,
   404	                                        len != 1 ? "s" : "");
   405	                }
   406	
   407	                if (len + hlen > bytesleft) {
   408	                        printf(" Illegal length!\n");
   409	                        return;
   410	                }
   411	                p += hlen + len;
   412	                bytesleft -= hlen + len;
   413	
   414	                if (cla & SC_ASN1_TAG_CONSTRUCTED) {
   415	                        putchar('\n');
   416	                        print_tags_recursive(buf0, tagp, len, depth + 2*i + 1);
   417	                        continue;
   418	                }
   419	
   420	                switch (tag) {
   421	                        case SC_ASN1_TAG_BIT_STRING:
   422	                                printf(": ");
   423	                                sc_asn1_print_bit_string(tagp, len, depth + 2*i + 1);
   424	                                break;
   425	                        case SC_ASN1_TAG_OCTET_STRING:
   426	                                sc_asn1_print_octet_string(tagp, len, depth + 2*i + 1);
   427	                                break;
   428	                        case SC_ASN1_TAG_OBJECT:
   429	                                printf(": ");
   430	                                sc_asn1_print_object_id(tagp, len);
   431	                                break;
   432	                        case SC_ASN1_TAG_INTEGER:
   433	                        case SC_ASN1_TAG_ENUMERATED:
   434	                                printf(": ");
   435	                                sc_asn1_print_integer(tagp, len);
   436	                                break;
   437	                        case SC_ASN1_TAG_IA5STRING:
   438	                        case SC_ASN1_TAG_PRINTABLESTRING:
   439	                        case SC_ASN1_TAG_T61STRING:
   440	                        case SC_ASN1_TAG_UTF8STRING:
   441	                                printf(": ");
   442	                                sc_asn1_print_utf8string(tagp, len);
   443	                                break;
   444	                        case SC_ASN1_TAG_BOOLEAN:
   445	                                printf(": ");
   446	                                sc_asn1_print_boolean(tagp, len);
   447	                                break;
   448	                        case SC_ASN1_GENERALIZEDTIME:
   449	                                printf(": ");
   450	                                sc_asn1_print_generalizedtime(tagp, len);
   451	                                break;
   452	                        case SC_ASN1_UTCTIME:
   453	                                printf(": ");
   454	                                sc_asn1_print_utctime(tagp, len);
   455	                                break;
   456	                }
   457	
   458	                if ((cla & SC_ASN1_TAG_CLASS) == SC_ASN1_TAG_APPLICATION) {
   459	                        print_hex(tagp, len, depth + 2*i + 1);
   460	                }
   461	
   462	                if ((cla & SC_ASN1_TAG_CLASS) == SC_ASN1_TAG_CONTEXT) {
   463	                        print_hex(tagp, len, depth + 2*i + 1);
   464	                }
   465	
   466	                putchar('\n');
   467	        }
   468	}
   469	
   470	void sc_asn1_print_tags(const u8 * buf, size_t buflen)
   471	{
   472	        print_tags_recursive(buf, buf, buflen, 0);
   473	}
   474	
   475	const u8 *sc_asn1_find_tag(sc_context_t *ctx, const u8 * buf,
   476	        size_t buflen, unsigned int tag_in, size_t *taglen_in)
   477	{
   478	        size_t left = buflen, taglen;
   479	        const u8 *p = buf;
   480	
   481	        *taglen_in = 0;
   482	        while (left >= 2) {
   483	                unsigned int cla = 0, tag, mask = 0xff00;
   484	
   485	                buf = p;
   486	                /* read a tag */
   487	                if (sc_asn1_read_tag(&p, left, &cla, &tag, &taglen) != SC_SUCCESS
   488	                                || p == NULL)
   489	                        return NULL;
   490	
   491	                left -= (p - buf);
   492	                /* we need to shift the class byte to the leftmost
   493	                 * byte of the tag */
   494	                while ((tag & mask) != 0) {
   495	                        cla  <<= 8;
   496	                        mask <<= 8;
   497	                }
   498	                /* compare the read tag with the given tag */
   499	                if ((tag | cla) == tag_in) {
   500	                        /* we have a match => return length and value part */
   501	                        if (taglen > left)
   502	                                return NULL;
   503	                        *taglen_in = taglen;
   504	                        return p;
   505	                }
   506	                /* otherwise continue reading tags */
   507	                left -= taglen;
   508	                p += taglen;
   509	        }
   510	        return NULL;
   511	}
   512	
   513	const u8 *sc_asn1_skip_tag(sc_context_t *ctx, const u8 ** buf, size_t *buflen,
   514	                           unsigned int tag_in, size_t *taglen_out)
   515	{
   516	        const u8 *p = *buf;
   517	        size_t len = *buflen, taglen;
   518	        unsigned int cla = 0, tag;
   519	
   520	        if (sc_asn1_read_tag((const u8 **) &p, len, &cla, &tag, &taglen) != SC_SUCCESS
   521	                        || p == NULL)
   522	                return NULL;
   523	        switch (cla & 0xC0) {
   524	        case SC_ASN1_TAG_UNIVERSAL:
   525	                if ((tag_in & SC_ASN1_CLASS_MASK) != SC_ASN1_UNI)
   526	                        return NULL;
   527	                break;
   528	        case SC_ASN1_TAG_APPLICATION:
   529	                if ((tag_in & SC_ASN1_CLASS_MASK) != SC_ASN1_APP)
   530	                        return NULL;
   531	                break;
   532	        case SC_ASN1_TAG_CONTEXT:
   533	                if ((tag_in & SC_ASN1_CLASS_MASK) != SC_ASN1_CTX)
   534	                        return NULL;
   535	                break;
   536	        case SC_ASN1_TAG_PRIVATE:
   537	                if ((tag_in & SC_ASN1_CLASS_MASK) != SC_ASN1_PRV)
   538	                        return NULL;
   539	                break;
   540	        }
   541	        if (cla & SC_ASN1_TAG_CONSTRUCTED) {
   542	                if ((tag_in & SC_ASN1_CONS) == 0)
   543	                        return NULL;
   544	        } else
   545	                if (tag_in & SC_ASN1_CONS)
   546	                        return NULL;
   547	        if ((tag_in & SC_ASN1_TAG_MASK) != tag)
   548	                return NULL;
   549	        len -= (p - *buf);      /* header size */
   550	        if (taglen > len) {
   551	                sc_debug(ctx, SC_LOG_DEBUG_ASN1,
   552	                         "too long ASN.1 object (size %"SC_FORMAT_LEN_SIZE_T"u while only %"SC_FORMAT_LEN_SIZE_T"u available)\n",
   553	                         taglen, len);
   554	                return NULL;
   555	        }
   556	        *buflen -= (p - *buf) + taglen;
   557	        *buf = p + taglen;      /* point to next tag */
   558	        *taglen_out = taglen;
   559	        return p;
   560	}
   561	
   562	const u8 *sc_asn1_verify_tag(sc_context_t *ctx, const u8 * buf, size_t buflen,
   563	                             unsigned int tag_in, size_t *taglen_out)
   564	{
   565	        return sc_asn1_skip_tag(ctx, &buf, &buflen, tag_in, taglen_out);
   566	}
   567	
   568	static int decode_bit_string(const u8 * inbuf, size_t inlen, void *outbuf,
   569	                             size_t outlen, int invert)
   570	{
   571	        const u8 *in = inbuf;
   572	        u8 *out = (u8 *) outbuf;
   573	        int i, count = 0;
   574	        int zero_bits;
   575	        size_t octets_left;
   576	
   577	        if (inlen < 1)
   578	                return SC_ERROR_INVALID_ASN1_OBJECT;
   579	        memset(outbuf, 0, outlen);
   580	        zero_bits = *in & 0x07;
   581	        in++;
   582	        octets_left = inlen - 1;
   583	        if (outlen < octets_left)
   584	                return SC_ERROR_BUFFER_TOO_SMALL;
   585	
   586	        while (octets_left) {
   587	                /* 1st octet of input:  ABCDEFGH, where A is the MSB */
   588	                /* 1st octet of output: HGFEDCBA, where A is the LSB */
   589	                /* first bit in bit string is the LSB in first resulting octet */
   590	                int bits_to_go;
   591	
   592	                *out = 0;
   593	                if (octets_left == 1)
   594	                        bits_to_go = 8 - zero_bits;
   595	                else
   596	                        bits_to_go = 8;
   597	                if (invert)
   598	                        for (i = 0; i < bits_to_go; i++) {
   599	                                *out |= ((*in >> (7 - i)) & 1) << i;
   600	                        }
   601	                else {
   602	                        *out = *in;
   603	                }
   604	                out++;
   605	                in++;
   606	                octets_left--;
   607	                count++;
   608	        }
   609	        return (count * 8) - zero_bits;
   610	}
   611	
   612	int sc_asn1_decode_bit_string(const u8 * inbuf, size_t inlen,
   613	                              void *outbuf, size_t outlen)
   614	{
   615	        return decode_bit_string(inbuf, inlen, outbuf, outlen, 1);
   616	}
   617	
   618	int sc_asn1_decode_bit_string_ni(const u8 * inbuf, size_t inlen,
   619	                                 void *outbuf, size_t outlen)
   620	{
   621	        return decode_bit_string(inbuf, inlen, outbuf, outlen, 0);
   622	}
   623	
   624	static int encode_bit_string(const u8 * inbuf, size_t bits_left, u8 **outbuf,
   625	                             size_t *outlen, int invert)
   626	{
   627	        const u8 *in = inbuf;
   628	        u8 *out;
   629	        size_t bytes;
   630	        int skipped = 0;
   631	
   632	        bytes = (bits_left + 7)/8 + 1;
   633	        *outbuf = out = malloc(bytes);
   634	        if (out == NULL)
   635	                return SC_ERROR_OUT_OF_MEMORY;
   636	        *outlen = bytes;
   637	        out += 1;
   638	        while (bits_left) {
   639	                int i, bits_to_go = 8;
   640	
   641	                *out = 0;
   642	                if (bits_left < 8) {
   643	                        bits_to_go = bits_left;
   644	                        skipped = 8 - bits_left;
   645	                }
   646	                if (invert) {
   647	                        for (i = 0; i < bits_to_go; i++)
   648	                                *out |= ((*in >> i) & 1) << (7 - i);
   649	                } else {
   650	                        *out = *in;
   651	                        if (bits_left < 8)
   652	                                return SC_ERROR_NOT_SUPPORTED; /* FIXME */
   653	                }
   654	                bits_left -= bits_to_go;
   655	                out++, in++;
   656	        }
   657	        out = *outbuf;
   658	        out[0] = skipped;
   659	        return 0;
   660	}
   661	
   662	/*
   663	 * Bitfields are just bit strings, stored in an unsigned int
   664	 * (taking endianness into account)
   665	 */
   666	static int decode_bit_field(const u8 * inbuf, size_t inlen, void *outbuf, size_t outlen)
   667	{
   668	        u8              data[sizeof(unsigned int)];
   669	        unsigned int    field = 0;
   670	        int             i, n;
   671	
   672	        if (outlen != sizeof(data))
   673	                return SC_ERROR_BUFFER_TOO_SMALL;
   674	
   675	        n = decode_bit_string(inbuf, inlen, data, sizeof(data), 1);
   676	        if (n < 0)
   677	                return n;
