   216	static void sc_asn1_print_integer(const u8 * buf, size_t buflen)
   217	{
   218	        size_t a = 0;
   219	
   220	        if (buflen > sizeof(a)) {
   221	                printf("0x%s", sc_dump_hex(buf, buflen));
   222	        } else {
   223	                size_t i;
   224	                for (i = 0; i < buflen; i++) {
   225	                        a <<= 8;
   226	                        a |= buf[i];
   227	                }
   228	                printf("%"SC_FORMAT_LEN_SIZE_T"u", a);
   229	        }
   230	}
