                return SC_ERROR_INVALID_ASN1_OBJECT;
        if (*p == 0xff || *p == 0) {
                /* end of data reached */
                *taglen = 0;
                *tag_out = SC_ASN1_TAG_EOC;
                return SC_SUCCESS;
