    81	         * confused with the 'tag number' part of ASN.1 tag.
    82	         */
    83	        cla = (*p & SC_ASN1_TAG_CLASS) | (*p & SC_ASN1_TAG_CONSTRUCTED);
    84	        tag = *p & SC_ASN1_TAG_PRIMITIVE;
    85	        p++;
    86	        left--;
    87	        if (tag == SC_ASN1_TAG_PRIMITIVE) {
    88	                /* high tag number */
    89	                size_t n = SC_ASN1_TAGNUM_SIZE - 1;
    90	                /* search the last tag octet */
    91	                do {
    92	                        if (left == 0 || n == 0)
    93	                                /* either an invalid tag or it doesn't fit in
    94	                                 * unsigned int */
    95	                                return SC_ERROR_INVALID_ASN1_OBJECT;
    96	                        tag <<= 8;
    97	                        tag |= *p;
    98	                        p++;
    99	                        left--;
   100	                        n--;
   101	                } while (tag & 0x80);
   102	        }
   103	
   104	        /* parse length byte(s) */
   105	        if (left == 0)
   106	                return SC_ERROR_INVALID_ASN1_OBJECT;
   107	        len = *p;
   108	        p++;
   109	        left--;
   110	        if (len & 0x80) {
   111	                len &= 0x7f;
   112	                unsigned int a = 0;
   113	                if (len > sizeof a || len > left)
   114	                        return SC_ERROR_INVALID_ASN1_OBJECT;
   115	                for (i = 0; i < len; i++) {
   116	                        a <<= 8;
   117	                        a |= *p;
   118	                        p++;
   119	                        left--;
   120	                }
   121	                len = a;
   122	        }
   123	
   124	        *cla_out = cla;
   125	        *tag_out = tag;
   126	        *taglen = len;
   127	        *buf = p;
   128	
   129	        if (len > left)
   130	                return SC_ERROR_ASN1_END_OF_CONTENTS;
   131	
   132	        return SC_SUCCESS;
   133	}
