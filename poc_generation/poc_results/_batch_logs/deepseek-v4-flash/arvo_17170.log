   232	static void sc_asn1_print_boolean(const u8 * buf, size_t buflen)
   233	{
   234	        if (!buflen)
   235	                return;
   236	
   237	        if (buf[0])
   238	                printf("true");
   239	        else
   240	                printf("false");
   241	}
   242	
   243	static void sc_asn1_print_bit_string(const u8 * buf, size_t buflen, size_t depth)
   244	{
   245	#ifndef _WIN32
   246	        long long a = 0;
   247	#else
   248	        __int64 a = 0;
   249	#endif
   250	        int r, i;
   251	
   252	        if (buflen > sizeof(a) + 1) {
   253	                print_hex(buf, buflen, depth);
   254	        } else {
   255	                r = sc_asn1_decode_bit_string(buf, buflen, &a, sizeof(a));
   256	                if (r < 0) {
   257	                        printf("decode error");
   258	                        return;
   259	                }
   260	                for (i = r - 1; i >= 0; i--) {
   261	                        printf("%c", ((a >> i) & 1) ? '1' : '0');
   262	                }
   263	        }
   264	}
