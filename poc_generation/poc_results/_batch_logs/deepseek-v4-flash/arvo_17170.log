   650	                        *out = *in;
   651	                        if (bits_left < 8)
   652	                                return SC_ERROR_NOT_SUPPORTED; /* FIXME */
   653	                }
   654	                bits_left -= bits_to_go;
   655	                out++, in++;
   656	        }
   657	        out = *outbuf;
   658	        out[0] = skipped;
   659	        return 0;
   660	}
