static void print_tags_recursive(const u8 * buf0, const u8 * buf,
                                 size_t buflen, size_t depth)
{
        int r;
        size_t i;
        size_t bytesleft = buflen;
        const char *classes[4] = {
                "Universal",
                "Application",
                "Context",
                "Private"
        };
