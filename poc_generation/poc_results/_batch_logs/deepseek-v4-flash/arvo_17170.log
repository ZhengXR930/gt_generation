   286	static void sc_asn1_print_object_id(const u8 * buf, size_t buflen)
   287	{
   288	        struct sc_object_id oid;
   289	        const char *sbuf;
   290	
   291	        if (sc_asn1_decode_object_id(buf, buflen, &oid)) {
   292	                printf("decode error");
   293	                return;
   294	        }
