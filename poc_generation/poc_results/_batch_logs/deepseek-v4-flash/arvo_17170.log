   154	
   155	static void print_indent(size_t depth)
   156	{
   157	        for (; depth > 0; depth--) {
   158	                putchar(' ');
   159	        }
   160	}
   161	
   162	static void print_hex(const u8 * buf, size_t buflen, size_t depth)
   163	{
   164	        size_t lines_len = buflen * 5 + 128;
   165	        char *lines = malloc(lines_len);
   166	        char *line = lines;
   167	
   168	        if (buf == NULL || buflen == 0 || lines == NULL) {
   169	                free(lines);
   170	                return;
   171	        }
   172	
   173	        sc_hex_dump(buf, buflen, lines, lines_len);
   174	
   175	        while (*line != '\0') {
   176	                char *line_end = strchr(line, '\n');
   177	                ptrdiff_t width = line_end - line;
   178	                if (!line_end || width <= 1) {
   179	                        /* don't print empty lines */
   180	                        break;
   181	                }
   182	                if (buflen > 8) {
   183	                        putchar('\n');
   184	                        print_indent(depth);
   185	                } else {
   186	                        printf(": ");
   187	                }
   188	                printf("%.*s", (int) width, line);
   189	                line = line_end + 1;
   190	        }
   191	
   192	        free(lines);
   193	}
   194	
   195	static void print_ascii(const u8 * buf, size_t buflen)
   196	{
   197	        for (; 0 < buflen; buflen--, buf++) {
   198	                if (isprint(*buf))
   199	                        printf("%c", *buf);
   200	                else
   201	                        putchar('.');
   202	        }
   203	}
   204	
   205	static void sc_asn1_print_octet_string(const u8 * buf, size_t buflen, size_t depth)
   206	{
   207	        print_hex(buf, buflen, depth);
   208	}
   209	
   210	static void sc_asn1_print_utf8string(const u8 * buf, size_t buflen)
   211	{
   212	        /* FIXME UTF-8 is not ASCII */
   213	        print_ascii(buf, buflen);
   214	}
