        sc_copy_asn1_entry(c_asn1_ec_pointQ, asn1_ec_pointQ);
        sc_format_asn1_entry(asn1_ec_pointQ + 0, key->ecpointQ.value, &key->ecpointQ.len, 1);

        LOG_FUNC_RETURN(ctx,
                        sc_asn1_encode(ctx, asn1_ec_pointQ, buf, buflen));
}


