    From 50d5c3d007cf9b4f56a29b79a8a2e736115eb6cb Mon Sep 17 00:00:00 2001
    From: Bart Van Assche 
    Date: Wed, 12 Feb 2025 07:35:48 -0800
    Subject: [PATCH] libsnmp: Fix a heap buffer overflow
    
    Fixes: https://issues.oss-fuzz.com/issues/396102403
    ---
     snmplib/read_config.c | 8 ++++++--
     1 file changed, 6 insertions(+), 2 deletions(-)
    
    diff --git a/snmplib/read_config.c b/snmplib/read_config.c
    index e6a2d12b6c..57d39730d1 100644
    --- a/snmplib/read_config.c
    +++ b/snmplib/read_config.c
    @@ -596,7 +596,7 @@ snmp_config_when(char *line, int when)
         char           *cptr, buf[STRINGMAX];
         struct config_line *lptr = NULL;
         struct config_files *ctmp = config_files;
    -    char           *st;
    +    char           *st, *start_from, *end;
     
         if (line == NULL) {
             config_perror("snmp_config() called with a null string.");
    @@ -640,7 +640,11 @@ snmp_config_when(char *line, int when)
         /*
