        usrsctp_set_non_blocking(socket_client, 1);

        so_linger.l_onoff = 1;
        so_linger.l_linger = 0;
        if (usrsctp_setsockopt(socket_client, SOL_SOCKET, SO_LINGER, &so_linger, sizeof(struct linger)) < 0) {
                perror("usrsctp_setsockopt 1");
                exit(EXIT_FAILURE);
        }

