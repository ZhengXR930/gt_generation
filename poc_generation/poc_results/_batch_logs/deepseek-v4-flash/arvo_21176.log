   214	
   215	int
   216	ares_parse_txt_reply_ext (const unsigned char *abuf, int alen,
   217	                          struct ares_txt_ext **txt_out)
   218	{
   219	  return ares__parse_txt_reply(abuf, alen, 1, (void **) txt_out);
