    44	    ares_ssize_t sig;
    45	     size_t uns;
    46	  } elen;
    47	
    48	  if (encoded == abuf+alen)
    49	    return ARES_EBADSTR;
    50	
    51	  elen.uns = *encoded;
    52	  if (encoded+elen.sig+1 > abuf+alen)
    53	    return ARES_EBADSTR;
    54	
