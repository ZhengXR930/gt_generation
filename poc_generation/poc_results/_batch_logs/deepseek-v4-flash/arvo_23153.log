    # EOB: code "1010" (4 bits)
    # Total: 6 bits per block, padded to byte
    
    bits = []
    total_blocks = 9 * 9 + 9 * 4 + 9 * 4  # 153
    for _ in range(total_blocks):
        bits.extend([0, 0])  # DC=0
        bits.extend([1, 0, 1, 0])  # EOB
    
    # Pad to byte
    while len(bits) % 8 != 0:
        bits.append(1)  # padding with 1s
    
    for i in range(0, len(bits), 8):
        byte = 0
        for j in range(8):
            byte = (byte << 1) | bits[i + j]
        encoded.append(byte)
    
    data += bytes(encoded)
    
    # EOI
    data += b'\xff\xd9'
    
    return bytes(data)

