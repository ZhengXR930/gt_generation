   280	#define GENERATE_CASE_STMT(upper, lower, mask, constant)                       \
   281	    case constant:                                                             \
   282	        request->flags |= (mask);                                              \
   283	        return buffer + sizeof(#upper);
   284	
   285	    STRING_SWITCH (buffer) {
