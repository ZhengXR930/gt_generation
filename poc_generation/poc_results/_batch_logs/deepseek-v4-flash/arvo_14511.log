   118	static bool
   119	parse_ascii_port(char *port, unsigned short *out)
   120	{
   121	    unsigned long parsed;
   122	    char *end_ptr;
   123	
   124	    errno = 0;
   125	    parsed = strtoul(port, &end_ptr, 10);
   126	
   127	    if (UNLIKELY(errno != 0))
   128	        return false;
   129	
   130	    if (UNLIKELY(*end_ptr != '\0'))
   131	        return false;
   132	
   133	    if (UNLIKELY((unsigned long)(unsigned short)parsed != parsed))
   134	        return false;
   135	
   136	    *out = htons((unsigned short)parsed);
   137	    return true;
   138	}
