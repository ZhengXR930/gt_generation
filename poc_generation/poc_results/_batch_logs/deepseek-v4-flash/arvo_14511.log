   140	static char *
   141	strsep_char(char *strp, char delim)
   142	{
   143	    char *ptr;
   144	
   145	    if (UNLIKELY(!strp))
   146	        return NULL;
   147	
   148	    ptr = strchr(strp, delim);
   149	    if (UNLIKELY(!ptr))
   150	        return NULL;
   151	
   152	    *ptr = '\0';
   153	    return ptr + 1;
   154	}
   155	
   156	static char *
   157	parse_proxy_protocol_v1(struct lwan_request *request, char *buffer)
   158	{
   159	    static const size_t line_size = 108;
   160	    char *end, *protocol, *src_addr, *dst_addr, *src_port, *dst_port;
   161	    unsigned int size;
   162	    struct lwan_proxy *const proxy = request->proxy;
   163	
   164	    end = memchr(buffer, '\r', line_size);
   165	    if (UNLIKELY(!end || end[1] != '\n'))
   166	        return NULL;
   167	    *end = '\0';
   168	    size = (unsigned int) (end + 2 - buffer);
   169	
   170	    protocol = buffer + sizeof("PROXY ") - 1;
   171	    src_addr = strsep_char(protocol, ' ');
   172	    dst_addr = strsep_char(src_addr, ' ');
   173	    src_port = strsep_char(dst_addr, ' ');
   174	    dst_port = strsep_char(src_port, ' ');
   175	
   176	    if (UNLIKELY(!dst_port))
   177	        return NULL;
   178	
   179	    STRING_SWITCH(protocol) {
   180	    case MULTICHAR_CONSTANT('T', 'C', 'P', '4'): {
   181	        struct sockaddr_in *from = &proxy->from.ipv4;
   182	        struct sockaddr_in *to = &proxy->to.ipv4;
   183	
   184	        from->sin_family = to->sin_family = AF_INET;
   185	
   186	        if (UNLIKELY(inet_pton(AF_INET, src_addr, &from->sin_addr) <= 0))
   187	            return NULL;
   188	        if (UNLIKELY(inet_pton(AF_INET, dst_addr, &to->sin_addr) <= 0))
   189	            return NULL;
   190	        if (UNLIKELY(!parse_ascii_port(src_port, &from->sin_port)))
   191	            return NULL;
   192	        if (UNLIKELY(!parse_ascii_port(dst_port, &to->sin_port)))
   193	            return NULL;
   194	
   195	        break;
   196	    }
   197	    case MULTICHAR_CONSTANT('T', 'C', 'P', '6'): {
   198	        struct sockaddr_in6 *from = &proxy->from.ipv6;
   199	        struct sockaddr_in6 *to = &proxy->to.ipv6;
   200	
   201	        from->sin6_family = to->sin6_family = AF_INET6;
   202	
   203	        if (UNLIKELY(inet_pton(AF_INET6, src_addr, &from->sin6_addr) <= 0))
   204	            return NULL;
   205	        if (UNLIKELY(inet_pton(AF_INET6, dst_addr, &to->sin6_addr) <= 0))
   206	            return NULL;
   207	        if (UNLIKELY(!parse_ascii_port(src_port, &from->sin6_port)))
   208	            return NULL;
   209	        if (UNLIKELY(!parse_ascii_port(dst_port, &to->sin6_port)))
   210	            return NULL;
   211	
   212	        break;
   213	    }
   214	    default:
   215	        return NULL;
   216	    }
   217	
   218	    request->flags |= REQUEST_PROXIED;
   219	    return buffer + size;
   220	}
   221	
   222	static char *parse_proxy_protocol_v2(struct lwan_request *request, char *buffer)
   223	{
   224	    struct proxy_header_v2 *hdr = (struct proxy_header_v2 *)buffer;
   225	    struct lwan_request_parser_helper *helper = request->helper;
   226	    const unsigned int proto_signature_length = 16;
   227	    unsigned int size;
   228	    struct lwan_proxy *const proxy = request->proxy;
   229	
   230	    enum { LOCAL = 0x20, PROXY = 0x21, TCP4 = 0x11, TCP6 = 0x21 };
   231	
   232	    size = proto_signature_length + (unsigned int)ntohs(hdr->len);
   233	    if (UNLIKELY(size > (unsigned int)sizeof(*hdr)))
   234	        return NULL;
   235	    if (UNLIKELY(size >= helper->buffer->len))
   236	        return NULL;
   237	
   238	    if (LIKELY(hdr->cmd_ver == PROXY)) {
   239	        if (hdr->fam == TCP4) {
   240	            struct sockaddr_in *from = &proxy->from.ipv4;
   241	            struct sockaddr_in *to = &proxy->to.ipv4;
   242	
   243	            to->sin_family = from->sin_family = AF_INET;
   244	
   245	            from->sin_addr.s_addr = hdr->addr.ip4.src_addr;
   246	            from->sin_port = hdr->addr.ip4.src_port;
   247	
   248	            to->sin_addr.s_addr = hdr->addr.ip4.dst_addr;
   249	            to->sin_port = hdr->addr.ip4.dst_port;
   250	        } else if (hdr->fam == TCP6) {
   251	            struct sockaddr_in6 *from = &proxy->from.ipv6;
   252	            struct sockaddr_in6 *to = &proxy->to.ipv6;
   253	
   254	            from->sin6_family = to->sin6_family = AF_INET6;
   255	
   256	            from->sin6_addr = hdr->addr.ip6.src_addr;
   257	            from->sin6_port = hdr->addr.ip6.src_port;
   258	
   259	            to->sin6_addr = hdr->addr.ip6.dst_addr;
   260	            to->sin6_port = hdr->addr.ip6.dst_port;
   261	        } else {
   262	            return NULL;
   263	        }
   264	    } else if (hdr->cmd_ver == LOCAL) {
   265	        struct sockaddr_in *from = &proxy->from.ipv4;
   266	        struct sockaddr_in *to = &proxy->to.ipv4;
   267	
   268	        from->sin_family = to->sin_family = AF_UNSPEC;
   269	    } else {
   270	        return NULL;
   271	    }
   272	
   273	    request->flags |= REQUEST_PROXIED;
   274	    return buffer + size;
   275	}
