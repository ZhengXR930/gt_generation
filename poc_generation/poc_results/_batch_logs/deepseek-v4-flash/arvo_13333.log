    linkInfo.mLinkSecurity = aFrame.GetSecurityEnabled();
#if OPENTHREAD_CONFIG_ENABLE_TIME_SYNC
    linkInfo.mNetworkTimeOffset = aFrame.GetNetworkTimeOffset();
    linkInfo.mTimeSyncSeq       = aFrame.GetTimeSyncSeq();
#endif

