    dest->width = jpeg_dec_obj_yuv420.getDecompressedImageWidth();
    dest->height = jpeg_dec_obj_yuv420.getDecompressedImageHeight();
    memcpy(dest->data, jpeg_dec_obj_yuv420.getDecompressedImagePtr(),
