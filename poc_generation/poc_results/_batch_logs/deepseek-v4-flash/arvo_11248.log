    30	class StreamBitReader {
    31	public:
    32	  StreamBitReader(Stream *strA)
    33	    : str(strA)
    34	    , inputBits(0)
    35	    , isAtEof(false)
    36	  {
    37	  }
    38	
    39	  void resetInputBits()
    40	  {
    41	    inputBits = 0;
    42	  }
    43	
    44	  bool atEOF() const
    45	  {
    46	    return isAtEof;
    47	  }
    48	
    49	  Guint readBit()
    50	  {
    51	    Guint bit;
    52	    int c;
    53	
    54	    if (inputBits == 0) {
    55	      if ((c = str->getChar()) == EOF) {
    56	        isAtEof = true;
    57	        return (Guint) -1;
    58	      }
    59	      bitsBuffer = c;
    60	      inputBits = 8;
    61	    }
    62	    bit = (bitsBuffer >> (inputBits - 1)) & 1;
    63	    --inputBits;
    64	    return bit;
    65	  }
    66	
    67	  Guint readBits(int n)
    68	  {
    69	    Guint bit, bits;
    70	
    71	    if (n < 0) return -1;
    72	    if (n == 0) return 0;
    73	
    74	    if (n == 1)
    75	      return readBit();
    76	
    77	    bit = readBit();
    78	    if (bit == (Guint) -1)
    79	      return -1;
    80	
    81	    bit = bit << (n-1);
    82	
    83	    bits = readBits(n - 1);
    84	    if (bits == (Guint) -1)
    85	      return -1;
    86	
    87	    return bit | bits;
    88	  }
    89	
    90	private:
    91	  Stream *str;
    92	  int inputBits;
    93	  char bitsBuffer;
    94	  bool isAtEof;
    95	};
