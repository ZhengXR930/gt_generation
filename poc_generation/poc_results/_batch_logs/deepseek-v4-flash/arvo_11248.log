   463	std::vector<ByteRange>* Hints::getPageRanges(int page)
   464	{
   465	  if ((page < 1) || (page > nPages)) return nullptr;
   466	
   467	  int idx;
   468	  if (page-1 > pageFirst)
   469	     idx = page-1;
   470	  else if (page-1 < pageFirst)
