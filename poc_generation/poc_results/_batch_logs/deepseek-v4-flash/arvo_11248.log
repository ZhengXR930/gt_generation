   262	int UnicodeMap::mapUnicode(Unicode u, char *buf, int bufSize) {
   263	  int a, b, m, n, i, j;
   264	  Guint code;
   265	
   266	  if (kind == unicodeMapFunc) {
   267	    return (*func)(u, buf, bufSize);
   268	  }
   269	
   270	  a = 0;
   271	  b = len;
   272	  if (u >= ranges[a].start) {
   273	    // invariant: ranges[a].start <= u < ranges[b].start
   274	    while (b - a > 1) {
   275	      m = (a + b) / 2;
   276	      if (u >= ranges[m].start) {
   277	        a = m;
   278	      } else if (u < ranges[m].start) {
   279	        b = m;
   280	      }
   281	    }
   282	    if (u <= ranges[a].end) {
   283	      n = ranges[a].nBytes;
   284	      if (n > bufSize) {
   285	        return 0;
   286	      }
   287	      code = ranges[a].code + (u - ranges[a].start);
   288	      for (i = n - 1; i >= 0; --i) {
   289	        buf[i] = (char)(code & 0xff);
   290	        code >>= 8;
   291	      }
   292	      return n;
   293	    }
   294	  }
   295	
   296	  for (i = 0; i < eMapsLen; ++i) {
   297	    if (eMaps[i].u == u) {
   298	      n = eMaps[i].nBytes;
   299	      for (j = 0; j < n; ++j) {
   300	        buf[j] = eMaps[i].code[j];
   301	      }
   302	      return n;
   303	    }
   304	  }
   305	
   306	  return 0;
   307	}
