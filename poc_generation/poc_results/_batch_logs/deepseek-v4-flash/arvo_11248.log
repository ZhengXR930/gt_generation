   451	void GlobalParams::scanEncodingDirs() {
   452	  GDir *dir;
   453	  GDirEntry *entry;
   454	  const char *dataRoot = popplerDataDir ? popplerDataDir : POPPLER_DATADIR;
   455	  
   456	  // allocate buffer large enough to append "/nameToUnicode"
   457	  size_t bufSize = strlen(dataRoot) + strlen("/nameToUnicode") + 1;
   458	  char *dataPathBuffer = new char[bufSize];
   459	  
   460	  snprintf(dataPathBuffer, bufSize, "%s/nameToUnicode", dataRoot);
   461	  dir = new GDir(dataPathBuffer, true);
   462	  while (entry = dir->getNextEntry(), entry != nullptr) {
   463	    if (!entry->isDir()) {
   464	      parseNameToUnicode(entry->getFullPath());
   465	    }
   466	    delete entry;
   467	  }
   468	  delete dir;
   469	
   470	  snprintf(dataPathBuffer, bufSize, "%s/cidToUnicode", dataRoot);
   471	  dir = new GDir(dataPathBuffer, false);
   472	  while (entry = dir->getNextEntry(), entry != nullptr) {
   473	    addCIDToUnicode(entry->getName(), entry->getFullPath());
   474	    delete entry;
   475	  }
   476	  delete dir;
   477	
   478	  snprintf(dataPathBuffer, bufSize, "%s/unicodeMap", dataRoot);
   479	  dir = new GDir(dataPathBuffer, false);
   480	  while (entry = dir->getNextEntry(), entry != nullptr) {
   481	    addUnicodeMap(entry->getName(), entry->getFullPath());
   482	    delete entry;
   483	  }
   484	  delete dir;
   485	
   486	  snprintf(dataPathBuffer, bufSize, "%s/cMap", dataRoot);
   487	  dir = new GDir(dataPathBuffer, false);
   488	  while (entry = dir->getNextEntry(), entry != nullptr) {
   489	    addCMapDir(entry->getName(), entry->getFullPath());
   490	    toUnicodeDirs->push_back(entry->getFullPath()->copy());
   491	    delete entry;
   492	  }
   493	  delete dir;
   494	  
   495	  delete[] dataPathBuffer;
   496	}
