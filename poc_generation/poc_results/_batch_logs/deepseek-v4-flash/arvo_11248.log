   451	Goffset Hints::getPageOffset(int page)
   452	{
   453	  if ((page < 1) || (page > nPages)) return 0;
   454	
   455	  if (page-1 > pageFirst)
   456	    return pageOffset[page-1];
   457	  else if (page-1 < pageFirst)
   458	    return pageOffset[page];
   459	  else
   460	    return pageOffset[0];
   461	}
