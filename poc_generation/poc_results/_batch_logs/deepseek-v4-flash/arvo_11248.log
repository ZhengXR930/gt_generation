   498	void GlobalParams::parseNameToUnicode(const GooString *name) {
   499	  char *tok1, *tok2;
   500	  FILE *f;
   501	  char buf[256];
   502	  int line;
   503	  Unicode u;
   504	  char *tokptr;
   505	
   506	  if (!(f = openFile(name->getCString(), "r"))) {
   507	    error(errIO, -1, "Couldn't open 'nameToUnicode' file '{0:t}'",
   508	          name);
   509	    return;
   510	  }
   511	  line = 1;
   512	  while (getLine(buf, sizeof(buf), f)) {
   513	    tok1 = strtok_r(buf, " \t\r\n", &tokptr);
   514	    tok2 = strtok_r(nullptr, " \t\r\n", &tokptr);
   515	    if (tok1 && tok2) {
   516	      sscanf(tok1, "%x", &u);
   517	      nameToUnicodeText->add(tok2, u);
   518	    } else {
   519	      error(errConfig, -1, "Bad line in 'nameToUnicode' file ({0:t}:{1:d})",
   520	            name, line);
   521	    }
   522	    ++line;
   523	  }
   524	  fclose(f);
   525	}
