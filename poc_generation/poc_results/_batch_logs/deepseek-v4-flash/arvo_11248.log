   259	SysFontInfo *SysFontList::find(const GooString *name, bool fixedWidth, bool exact) {
   260	  GooString *name2;
   261	  bool bold, italic, oblique;
   262	  SysFontInfo *fi;
   263	  char c;
   264	  int n, i;
   265	
   266	  name2 = name->copy();
   267	
   268	  // remove space, comma, dash chars
   269	  i = 0;
   270	  while (i < name2->getLength()) {
   271	    c = name2->getChar(i);
   272	    if (c == ' ' || c == ',' || c == '-') {
   273	      name2->del(i);
   274	    } else {
   275	      ++i;
   276	    }
   277	  }
   278	  n = name2->getLength();
   279	
   280	  // remove trailing "MT" (Foo-MT, Foo-BoldMT, etc.)
   281	  if (n > 2 && !strcmp(name2->getCString() + n - 2, "MT")) {
   282	    name2->del(n - 2, 2);
   283	    n -= 2;
   284	  }
   285	
   286	  // look for "Regular"
   287	  if (n > 7 && !strcmp(name2->getCString() + n - 7, "Regular")) {
   288	    name2->del(n - 7, 7);
   289	    n -= 7;
   290	  }
   291	
   292	  // look for "Italic"
   293	  if (n > 6 && !strcmp(name2->getCString() + n - 6, "Italic")) {
   294	    name2->del(n - 6, 6);
   295	    italic = true;
   296	    n -= 6;
   297	  } else {
   298	    italic = false;
   299	  }
   300	
   301	  // look for "Oblique"
   302	  if (n > 6 && !strcmp(name2->getCString() + n - 7, "Oblique")) {
   303	    name2->del(n - 7, 7);
   304	    oblique = true;
   305	    n -= 6;
   306	  } else {
   307	    oblique = false;
   308	  }
   309	
   310	  // look for "Bold"
   311	  if (n > 4 && !strcmp(name2->getCString() + n - 4, "Bold")) {
   312	    name2->del(n - 4, 4);
   313	    bold = true;
   314	    n -= 4;
   315	  } else {
   316	    bold = false;
   317	  }
   318	
   319	  // remove trailing "MT" (FooMT-Bold, etc.)
   320	  if (n > 2 && !strcmp(name2->getCString() + n - 2, "MT")) {
   321	    name2->del(n - 2, 2);
   322	    n -= 2;
   323	  }
   324	
   325	  // remove trailing "PS"
   326	  if (n > 2 && !strcmp(name2->getCString() + n - 2, "PS")) {
   327	    name2->del(n - 2, 2);
   328	    n -= 2;
   329	  }
   330	
   331	  // remove trailing "IdentityH"
   332	  if (n > 9 && !strcmp(name2->getCString() + n - 9, "IdentityH")) {
   333	    name2->del(n - 9, 9);
   334	    n -= 9;
   335	  }
   336	
   337	  // search for the font
   338	  fi = nullptr;
   339	  for (i = 0; i < fonts->getLength(); ++i) {
   340	    fi = (SysFontInfo *)fonts->get(i);
   341	    if (fi->match(name2, bold, italic, oblique, fixedWidth)) {
   342	      break;
   343	    }
   344	    fi = nullptr;
   345	  }
   346	  if (!fi && !exact && bold) {
   347	    // try ignoring the bold flag
   348	    for (i = 0; i < fonts->getLength(); ++i) {
   349	      fi = (SysFontInfo *)fonts->get(i);
   350	      if (fi->match(name2, false, italic)) {
   351	        break;
   352	      }
   353	      fi = nullptr;
   354	    }
   355	  }
   356	  if (!fi && !exact && (bold || italic)) {
   357	    // try ignoring the bold and italic flags
   358	    for (i = 0; i < fonts->getLength(); ++i) {
   359	      fi = (SysFontInfo *)fonts->get(i);
   360	      if (fi->match(name2, false, false)) {
   361	        break;
   362	      }
   363	      fi = nullptr;
   364	    }
   365	  }
   366	
   367	  delete name2;
   368	  return fi;
   369	}
