   193	Stream *Parser::makeStream(Object &&dict, Guchar *fileKey,
   194	                           CryptAlgorithm encAlgorithm, int keyLength,
   195	                           int objNum, int objGen, int recursion,
   196	                           bool strict) {
   197	  BaseStream *baseStr;
   198	  Stream *str;
   199	  Goffset length;
   200	  Goffset pos, endPos;
   201	  XRefEntry *entry = nullptr;
   202	
   203	  if (xref && (entry = xref->getEntry(objNum, false))) {
   204	    if (!entry->getFlag(XRefEntry::Parsing) ||
   205	        (objNum == 0 && objGen == 0)) {
   206	      entry->setFlag(XRefEntry::Parsing, true);
   207	    } else {
   208	      error(errSyntaxError, getPos(),
   209	            "Object '{0:d} {1:d} obj' is being already parsed", objNum, objGen);
   210	      return nullptr;
   211	    }
   212	  }
   213	
   214	  // get stream start position
   215	  lexer->skipToNextLine();
   216	  if (!(str = lexer->getStream())) {
   217	    return nullptr;
   218	  }
   219	  pos = str->getPos();
   220	
   221	  // get length
   222	  Object obj = dict.dictLookup("Length", recursion);
   223	  if (obj.isInt()) {
   224	    length = obj.getInt();
   225	  } else if (obj.isInt64()) {
   226	    length = obj.getInt64();
   227	  } else {
   228	    error(errSyntaxError, getPos(), "Bad 'Length' attribute in stream");
   229	    if (strict) return nullptr;
   230	    length = 0;
   231	  }
   232	
   233	  // check for length in damaged file
   234	  if (xref && xref->getStreamEnd(pos, &endPos)) {
   235	    length = endPos - pos;
   236	  }
   237	
   238	  // in badly damaged PDF files, we can run off the end of the input
   239	  // stream immediately after the "stream" token
   240	  if (!lexer->getStream()) {
   241	    return nullptr;
   242	  }
   243	  baseStr = lexer->getStream()->getBaseStream();
   244	
   245	  // skip over stream data
   246	  if (Lexer::LOOK_VALUE_NOT_CACHED != lexer->lookCharLastValueCached) {
   247	      // take into account the fact that we've cached one value
   248	      pos = pos - 1;
   249	      lexer->lookCharLastValueCached = Lexer::LOOK_VALUE_NOT_CACHED;
   250	  }
   251	  if (unlikely(length < 0)) {
   252	      return nullptr;
   253	  }
   254	  if (unlikely(pos > LLONG_MAX - length)) {
   255	      return nullptr;
   256	  }
   257	  lexer->setPos(pos + length);
   258	
   259	  // refill token buffers and check for 'endstream'
   260	  shift();  // kill '>>'
   261	  shift("endstream", objNum);  // kill 'stream'
   262	  if (buf1.isCmd("endstream")) {
   263	    shift();
   264	  } else {
   265	    error(errSyntaxError, getPos(), "Missing 'endstream' or incorrect stream length");
   266	    if (strict) return nullptr;
   267	    if (xref && lexer->getStream()) {
   268	      // shift until we find the proper endstream or we change to another object or reach eof
   269	      length = lexer->getPos() - pos;
   270	      if (buf1.isCmd("endstream")) {
   271	        dict.dictSet("Length", Object(length));
   272	      }
   273	    } else {
   274	      // When building the xref we can't use it so use this
   275	      // kludge for broken PDF files: just add 5k to the length, and
   276	      // hope its enough
   277	      if (length < LLONG_MAX - pos - 5000)
   278	        length += 5000;
   279	    }
   280	  }
   281	
   282	  // make base stream
   283	  str = baseStr->makeSubStream(pos, true, length, std::move(dict));
   284	
   285	  // handle decryption
   286	  if (fileKey) {
   287	    str = new DecryptStream(str, fileKey, encAlgorithm, keyLength,
   288	                            objNum, objGen);
   289	  }
   290	
   291	  // get filters
   292	  str = str->addFilters(str->getDict(), recursion);
   293	
   294	  if (entry)
   295	    entry->setFlag(XRefEntry::Parsing, false);
   296	
   297	  return str;
   298	}
   299	
   300	void Parser::shift(int objNum) {
   301	  if (inlineImg > 0) {
   302	    if (inlineImg < 2) {
   303	      ++inlineImg;
   304	    } else {
   305	      // in a damaged content stream, if 'ID' shows up in the middle
   306	      // of a dictionary, we need to reset
   307	      inlineImg = 0;
   308	    }
   309	  } else if (buf2.isCmd("ID")) {
   310	    lexer->skipChar();          // skip char after 'ID' command
   311	    inlineImg = 1;
   312	  }
   313	  buf1 = std::move(buf2);
   314	  if (inlineImg > 0)            // don't buffer inline image data
   315	    buf2.setToNull();
   316	  else {
   317	    buf2 = lexer->getObj(objNum);
   318	  }
   319	}
   320	
   321	void Parser::shift(const char *cmdA, int objNum) {
   322	  if (inlineImg > 0) {
   323	    if (inlineImg < 2) {
   324	      ++inlineImg;
   325	    } else {
   326	      // in a damaged content stream, if 'ID' shows up in the middle
   327	      // of a dictionary, we need to reset
   328	      inlineImg = 0;
   329	    }
   330	  } else if (buf2.isCmd("ID")) {
   331	    lexer->skipChar();          // skip char after 'ID' command
   332	    inlineImg = 1;
   333	  }
   334	  buf1 = std::move(buf2);
   335	  if (inlineImg > 0) {
   336	    buf2.setToNull();
   337	  } else if (buf1.isCmd(cmdA)) {
   338	    buf2 = lexer->getObj(objNum);
   339	  } else {
   340	    buf2 = lexer->getObj(cmdA, objNum);
   341	  }
   342	}
