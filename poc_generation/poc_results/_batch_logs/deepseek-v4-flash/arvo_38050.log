#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* parse_content_length(char* const buffer, const char* const end,
                int* const length)
{
        int number;
        char *p;
        int  size;

        p = buffer;
        /* search the begining of the number */
        while ( p<end && (*p==' ' || *p=='\t' ||
        (*p=='\n' && (*(p+1)==' '||*(p+1)=='\t')) ))
                p++;
        if (p==end)
                goto error;
        /* parse the number */
        size = 0;
        number = 0;
        while (p<end && *p>='0' && *p<='9') {
                number = number*10 + (*p)-'0';
                size ++;
                p++;
        }
        if (p==end || size==0)
                goto error;
        /* now we should have only spaces at the end */
        while ( p<end && (*p==' ' || *p=='\t' ||
        (*p=='\n' && (*(p+1)==' '||*(p+1)=='\t')) ))
                p++;
        if (p==end)
                goto error;
        /* the header ends proper? */
        if ( (*(p++)!='\n') && (*(p-1)!='\r' || *(p++)!='\n' ) )
                goto error;

        *length = number;
        return p;
error:
        fprintf(stderr, "parse error near char [%d][%c]\n", *p, *p);
        return 0;
}

int main(int argc, char** argv) {
    // body = "5\n " (5, LF, space) at end of buffer
    char buf[] = {'5','\n',' '};
    int len = 3;
    int length = 0;
    char* r = parse_content_length(buf, buf+len, &length);
    printf("result=%p length=%d\n", (void*)r, length);
    return 0;
}
EOF
