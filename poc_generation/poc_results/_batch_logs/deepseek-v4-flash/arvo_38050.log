char* parse_content_length(char* const buffer, const char* const end,
                int* const length)
{
        int number;
        char *p;
        int  size;

        p = buffer;
        /* search the begining of the number */
        while ( p<end && (*p==' ' || *p=='\t' ||
        (*p=='\n' && (*(p+1)==' '||*(p+1)=='\t')) ))
