static inline bool decodeRLEData(RLEVariant variant,
                                 QDataStream &stream,
                                 Item *dest,
                                 quint32 length,
                                 Func1 readData,
                                 Func2 updateItem)
{
    unsigned offset = 0;
    while (offset < length) {
        unsigned remaining = length - offset;
        quint8 count1;
        stream >> count1;
        if (count1 >= 128u) {
            unsigned length = 0;
            if (variant == RLEVariant::PIC) {
