                           file, linenum, (missing_lf + 1));
                err_code |= ERR_WARN;
        }

        if (cs && cs->post_section_parser)
                err_code |= cs->post_section_parser();

err:
        free(cfg_scope);
        cfg_scope = NULL;
        cursection = NULL;
        free(thisline);
        free(outline);
        fclose(f);
        return err_code;
}

