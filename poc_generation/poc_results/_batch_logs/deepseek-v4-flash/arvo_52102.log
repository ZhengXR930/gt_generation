void msProjectionInheritContextFrom(projectionObj *pDst, const projectionObj* pSrc)
{
#if PROJ_VERSION_MAJOR >= 6
    if( pDst->proj_ctx == NULL && pSrc->proj_ctx != NULL)
    {
        pDst->proj_ctx = pSrc->proj_ctx;
        pDst->proj_ctx->ref_count ++;
    }
#else
    (void)pDst;
    (void)pSrc;
#endif
}

