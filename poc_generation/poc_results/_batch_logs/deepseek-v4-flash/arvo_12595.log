   197	static readstat_error_t sav_read_variable_label(spss_varinfo_t *info, sav_ctx_t *ctx) {
   198	    readstat_io_t *io = ctx->io;
   199	    readstat_error_t retval = READSTAT_OK;
   200	    uint32_t label_len, label_capacity;
   201	    size_t out_label_len;
   202	    char *label_buf = NULL;
   203	    if (io->read(&label_len, sizeof(uint32_t), io->io_ctx) < sizeof(uint32_t)) {
   204	        retval = READSTAT_ERROR_READ;
   205	        goto cleanup;
   206	    }
   207	    label_len = ctx->bswap ? byteswap4(label_len) : label_len;
   208	
   209	    if (label_len == 0)
   210	        goto cleanup;
   211	
   212	    label_capacity = (label_len + 3) / 4 * 4;
   213	    if ((label_buf = readstat_malloc(label_capacity)) == NULL) {
   214	        retval = READSTAT_ERROR_MALLOC;
   215	        goto cleanup;
   216	    }
   217	
   218	    out_label_len = (size_t)label_len*4+1;
   219	    if ((info->label = readstat_malloc(out_label_len)) == NULL) {
   220	        retval = READSTAT_ERROR_MALLOC;
   221	        goto cleanup;
   222	    }
   223	
   224	    if (io->read(label_buf, label_capacity, io->io_ctx) < label_capacity) {
   225	        retval = READSTAT_ERROR_READ;
   226	        goto cleanup;
   227	    }
   228	
   229	    retval = readstat_convert(info->label, out_label_len, label_buf, label_len, ctx->converter);
   230	    if (retval != READSTAT_OK)
   231	        goto cleanup;
   232	
   233	cleanup:
   234	    if (label_buf)
   235	        free(label_buf);
   236	
   237	    if (retval != READSTAT_OK) {
   238	        if (info->label) {
   239	            free(info->label);
   240	            info->label = NULL;
   241	        }
   242	    }
   243	
   244	    return retval;
   245	}
