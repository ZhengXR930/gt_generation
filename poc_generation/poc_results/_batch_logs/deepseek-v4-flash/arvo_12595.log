   165	static readstat_error_t sav_skip_variable_record(sav_ctx_t *ctx) {
   166	    sav_variable_record_t variable;
   167	    readstat_error_t retval = READSTAT_OK;
   168	    readstat_io_t *io = ctx->io;
   169	    if (io->read(&variable, sizeof(sav_variable_record_t), io->io_ctx) < sizeof(sav_variable_record_t)) {
   170	        retval = READSTAT_ERROR_READ;
   171	        goto cleanup;
   172	    }
   173	    if (variable.has_var_label) {
   174	        uint32_t label_len;
   175	        if (io->read(&label_len, sizeof(uint32_t), io->io_ctx) < sizeof(uint32_t)) {
   176	            retval = READSTAT_ERROR_READ;
   177	            goto cleanup;
   178	        }
   179	        label_len = ctx->bswap ? byteswap4(label_len) : label_len;
   180	        uint32_t label_capacity = (label_len + 3) / 4 * 4;
   181	        if (io->seek(label_capacity, READSTAT_SEEK_CUR, io->io_ctx) == -1) {
   182	            retval = READSTAT_ERROR_SEEK;
   183	            goto cleanup;
   184	        }
   185	    }
   186	    if (variable.n_missing_values) {
   187	        int n_missing_values = ctx->bswap ? byteswap4(variable.n_missing_values) : variable.n_missing_values;
   188	        if (io->seek(abs(n_missing_values) * sizeof(double), READSTAT_SEEK_CUR, io->io_ctx) == -1) {
   189	            retval = READSTAT_ERROR_SEEK;
   190	            goto cleanup;
   191	        }
   192	    }
   193	cleanup:
   194	    return retval;
   195	}
