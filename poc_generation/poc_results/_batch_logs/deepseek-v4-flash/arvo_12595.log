   182	            retval = READSTAT_ERROR_SEEK;
   183	            goto cleanup;
   184	        }
   185	    }
   186	    if (variable.n_missing_values) {
   187	        int n_missing_values = ctx->bswap ? byteswap4(variable.n_missing_values) : variable.n_missing_values;
   188	        if (io->seek(abs(n_missing_values) * sizeof(double), READSTAT_SEEK_CUR, io->io_ctx) == -1) {
   189	            retval = READSTAT_ERROR_SEEK;
   190	            goto cleanup;
   191	        }
   192	    }
