   247	static readstat_error_t sav_read_variable_missing_values(spss_varinfo_t *info, sav_ctx_t *ctx) {
   248	    readstat_io_t *io = ctx->io;
   249	    readstat_error_t retval = READSTAT_OK;
   250	    int i;
   251	
   252	    if (info->n_missing_values < 0) {
   253	        info->missing_range = 1;
   254	        info->n_missing_values = abs(info->n_missing_values);
   255	    } else {
   256	        info->missing_range = 0;
   257	    }
   258	    if (info->n_missing_values > 3) {
   259	        retval = READSTAT_ERROR_PARSE;
   260	        goto cleanup;
   261	    }
   262	    if (io->read(info->missing_values, info->n_missing_values * sizeof(double), io->io_ctx) < info->n_missing_values * sizeof(double)) {
   263	        retval = READSTAT_ERROR_READ;
   264	        goto cleanup;
   265	    }
   266	    for (i=0; i<info->n_missing_values; i++) {
   267	        if (ctx->bswap) {
   268	            info->missing_values[i] = byteswap_double(info->missing_values[i]);
   269	        }
   270	
   271	        uint64_t long_value = 0;
   272	        memcpy(&long_value, &info->missing_values[i], 8);
   273	
   274	        if (long_value == ctx->missing_double)
   275	            info->missing_values[i] = NAN;
   276	        if (long_value == ctx->lowest_double)
   277	            info->missing_values[i] = -HUGE_VAL;
   278	        if (long_value == ctx->highest_double)
   279	            info->missing_values[i] = HUGE_VAL;
   280	    }
   281	
   282	cleanup:
   283	
   284	    return retval;
   285	}
