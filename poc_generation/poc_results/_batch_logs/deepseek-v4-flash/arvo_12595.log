   146	static void sav_tag_missing_double(readstat_value_t *value, sav_ctx_t *ctx) {
   147	    double fp_value = value->v.double_value;
   148	    uint64_t long_value = 0;
   149	    memcpy(&long_value, &fp_value, 8);
   150	    if (long_value == ctx->missing_double)
   151	        value->is_system_missing = 1;
   152	    if (long_value == ctx->lowest_double)
   153	        value->is_system_missing = 1;
   154	    if (long_value == ctx->highest_double)
   155	        value->is_system_missing = 1;
   156	    if (isnan(fp_value))
   157	        value->is_system_missing = 1;
