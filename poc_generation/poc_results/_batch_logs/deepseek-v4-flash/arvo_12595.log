   287	static readstat_error_t sav_read_variable_record(sav_ctx_t *ctx) {
   288	    readstat_io_t *io = ctx->io;
   289	    sav_variable_record_t variable = { 0 };
   290	    spss_varinfo_t *info = NULL;
   291	    readstat_error_t retval = READSTAT_OK;
   292	    if (ctx->var_index == ctx->varinfo_capacity) {
   293	        if ((ctx->varinfo = readstat_realloc(ctx->varinfo, (ctx->varinfo_capacity *= 2) * sizeof(spss_varinfo_t *))) == NULL) {
   294	            retval = READSTAT_ERROR_MALLOC;
   295	            goto cleanup;
   296	        }
   297	    }
   298	    if (io->read(&variable, sizeof(sav_variable_record_t), io->io_ctx) < sizeof(sav_variable_record_t)) {
   299	        retval = READSTAT_ERROR_READ;
   300	        goto cleanup;
   301	    }
   302	    variable.print = ctx->bswap ? byteswap4(variable.print) : variable.print;
   303	    variable.write = ctx->bswap ? byteswap4(variable.write) : variable.write;
   304	
   305	    int32_t type = ctx->bswap ? byteswap4(variable.type) : variable.type;
   306	    if (type < 0) {
   307	        if (ctx->var_index == 0) {
   308	            return READSTAT_ERROR_PARSE;
   309	        }
   310	        ctx->var_offset++;
   311	        ctx->varinfo[ctx->var_index-1]->width++;
   312	        return 0;
   313	    }
   314	
   315	    if ((info = readstat_calloc(1, sizeof(spss_varinfo_t))) == NULL) {
   316	        retval = READSTAT_ERROR_MALLOC;
   317	        goto cleanup;
   318	    }
   319	    info->width = 1;
   320	    info->n_segments = 1;
   321	    info->index = ctx->var_index;
   322	    info->offset = ctx->var_offset;
   323	    info->labels_index = -1;
   324	
   325	    retval = readstat_convert(info->name, sizeof(info->name),
   326	            variable.name, sizeof(variable.name), ctx->converter);
   327	    if (retval != READSTAT_OK)
   328	        goto cleanup;
   329	
   330	    retval = readstat_convert(info->longname, sizeof(info->longname), 
   331	            variable.name, sizeof(variable.name), ctx->converter);
   332	    if (retval != READSTAT_OK)
   333	        goto cleanup;
   334	
   335	    info->print_format.decimal_places = (variable.print & 0x000000FF);
   336	    info->print_format.width = (variable.print & 0x0000FF00) >> 8;
   337	    info->print_format.type = (variable.print  & 0x00FF0000) >> 16;
   338	
   339	    info->write_format.decimal_places = (variable.write & 0x000000FF);
   340	    info->write_format.width = (variable.write & 0x0000FF00) >> 8;
   341	    info->write_format.type = (variable.write  & 0x00FF0000) >> 16;
   342	
   343	    if (type > 0 || info->print_format.type == SPSS_FORMAT_TYPE_A || info->write_format.type == SPSS_FORMAT_TYPE_A) {
   344	        info->type = READSTAT_TYPE_STRING;
   345	    } else {
   346	        info->type = READSTAT_TYPE_DOUBLE;
   347	    }
   348	    
   349	    if (variable.has_var_label) {
   350	        if ((retval = sav_read_variable_label(info, ctx)) != READSTAT_OK) {
   351	            goto cleanup;
   352	        }
   353	    }
   354	    
   355	    if (variable.n_missing_values) {
   356	        info->n_missing_values = ctx->bswap ? byteswap4(variable.n_missing_values) : variable.n_missing_values;
   357	        if ((retval = sav_read_variable_missing_values(info, ctx)) != READSTAT_OK) {
   358	            goto cleanup;
   359	        }
   360	    }
   361	    
   362	    ctx->varinfo[ctx->var_index] = info;
   363	
   364	    ctx->var_index++;
   365	    ctx->var_offset++;
   366	    
   367	cleanup:
   368	    if (retval != READSTAT_OK) {
   369	        spss_varinfo_free(info);
   370	    }
   371	
   372	    return retval;
   373	}
