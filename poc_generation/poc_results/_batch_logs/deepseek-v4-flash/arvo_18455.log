        if (config_buffer_consume(&parser->items, line))
            return true;
        lwan_strbuf_reset(&parser->strbuf);
        parser->state = parser->state(parser);
    }
    return config_buffer_consume(&parser->items, line);
}

static struct config *config_init_data(struct config *config,
                                       void *data, size_t len)
{
    config->parser = (struct parser) {
        .state = parse_config,
        .lexer = {
            .state = lex_config,
            .pos = data,
            .start = data,
            .end = (char *)data + len,
