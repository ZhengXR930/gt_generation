            printf("VULNERABILITY TRIGGERED: strncmp reads %ld bytes past buffer end!\n",
                   (long)(lexer.pos + 3 - lexer.end));
        }
        
        int cmp = strncmp(lexer.pos, end, 3);
        printf("strncmp result: %d\n", cmp);
    }
    
    free(data);
    return 0;
}
