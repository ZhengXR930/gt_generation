#define _GNU_SOURCE
#include <ctype.h>
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <alloca.h>

/* Simulate the exact same buffer layout as the fuzzer would use */
/* The fuzzer uses mmap to map the file, so there's no extra byte */

struct lexer {
    void *(*state)(struct lexer *);
    const char *start, *pos, *end;
    int cur_line;
};

static int next(struct lexer *lexer) {
    if (lexer->pos >= lexer->end) { lexer->pos = lexer->end + 1; return '\0'; }
    int r = *lexer->pos; lexer->pos++;
    if (r == '\n') lexer->cur_line++;
    return r;
}

static void backup(struct lexer *lexer) { lexer->pos--; }
static int peek(struct lexer *lexer) { int chr = next(lexer); backup(lexer); return chr; }
static void advance_n(struct lexer *lexer, size_t n) { lexer->pos += n; }

int main(int argc, char *argv[]) {
    if (argc < 2) { fprintf(stderr, "Usage: %s <poc_file>\n", argv[0]); return 1; }
    FILE *f = fopen(argv[1], "rb");
    if (!f) { perror("fopen"); return 1; }
    fseek(f, 0, SEEK_END);
    long sz = ftell(f);
    fseek(f, 0, SEEK_SET);
    
    /* Use mmap-like allocation - exactly the file size, no extra byte */
    char *data = malloc((size_t)sz);
    fread(data, 1, (size_t)sz, f);
    fclose(f);
    
    struct lexer lexer;
    lexer.pos = data;
    lexer.start = data;
    lexer.end = data + sz;
    lexer.cur_line = 1;
    
    /* Simulate lex_config reading the first ' */
    int chr = next(&lexer);
    printf("First char: %c (pos-offset=%ld)\n", chr, (long)(lexer.pos - data));
    
    /* Check for ''' */
    if (chr == '\'' && lexer.pos + 1 <= lexer.end && !strncmp(lexer.pos, "''", 2)) {
        printf("Found ''' at offset %ld\n", (long)(lexer.pos - data));
        
        /* Now simulate lex_multiline_string */
        char *end = (peek(&lexer) == '"') ? "\"\"\"" : "'''";
        printf("end = %s\n", end);
        printf("Before advance_n: pos-offset=%ld, end-offset=%ld\n", 
               (long)(lexer.pos - data), (long)(lexer.end - data));
        
        advance_n(&lexer, strlen("'''") - 1);
        printf("After advance_n: pos-offset=%ld\n", (long)(lexer.pos - data));
        
        /* This is the vulnerable strncmp */
        printf("Calling strncmp(lexer.pos=%p, end=%p, 3)\n", (void*)lexer.pos, (void*)end);
        printf("  lexer.pos - data = %ld, data+sz = %ld\n", 
