    fseek(f, 0, SEEK_SET);
    
    char *data = malloc(sz + 1);
    fread(data, 1, sz, f);
    fclose(f);
    
    struct config config;
    config_init_data(&config, data, sz);
    
    struct config_line *line;
    while (parser_next(&config.parser, &line)) {
        /* consume all */
    }
    
    printf("Done (no crash)\n");
    free(data);
    return 0;
}
