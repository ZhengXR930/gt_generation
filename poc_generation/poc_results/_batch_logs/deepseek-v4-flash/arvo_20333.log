   291	static int
   292	ops_calc_size_of_string_pool(regex_t* reg)
   293	{
   294	  int i;
   295	  int total;
   296	
   297	  if (IS_NULL(reg->ops)) return 0;
   298	
   299	  total = 0;
   300	  for (i = 0; i < (int )reg->ops_used; i++) {
   301	    enum OpCode opcode;
   302	    Operation* op;
   303	
   304	    op = reg->ops + i;
   305	#ifdef USE_DIRECT_THREADED_CODE
   306	    opcode = *(reg->ocs + i);
   307	#else
   308	    opcode = op->opcode;
   309	#endif
   310	
   311	    switch (opcode) {
   312	    case OP_STR_MBN:
   313	      total += op->exact_len_n.len * op->exact_len_n.n;
   314	      break;
   315	    case OP_STR_N:
   316	    case OP_STR_MB2N:
   317	      total += op->exact_n.n * 2;
   318	      break;
   319	    case OP_STR_MB3N:
   320	      total += op->exact_n.n * 3;
   321	      break;
   322	
   323	    default:
   324	      break;
   325	    }
   326	  }
   327	
   328	  return total;
   329	}
