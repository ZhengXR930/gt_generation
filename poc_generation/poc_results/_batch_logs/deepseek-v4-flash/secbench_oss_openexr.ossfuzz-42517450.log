        return 1;
    }
    
    fseek(f, 0, SEEK_END);
    long size = ftell(f);
    fseek(f, 0, SEEK_SET);
    
    uint8_t* data = (uint8_t*)malloc(size);
    fread(data, 1, size, f);
    fclose(f);
    
    checkOpenEXRFile((const char*)data, size, true, true, false);
    
    free(data);
    return 0;
}
