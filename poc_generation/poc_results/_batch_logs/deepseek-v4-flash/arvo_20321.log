   280	    bool get_png_extents (hb_font_t          *font,
   281	                          hb_codepoint_t      glyph,
   282	                          hb_glyph_extents_t *extents) const
   283	    {
   284	      /* Following code is safe to call even without data.
   285	       * But faster to short-circuit. */
   286	      if (!has_data ())
   287	        return false;
   288	
   289	      int x_offset = 0, y_offset = 0;
   290	      unsigned int strike_ppem = 0;
   291	      hb_blob_t *blob = reference_png (font, glyph, &x_offset, &y_offset, &strike_ppem);
   292	
   293	      const PNGHeader &png = *blob->as<PNGHeader>();
   294	
   295	      extents->x_bearing = x_offset;
   296	      extents->y_bearing = png.IHDR.height + y_offset;
   297	      extents->width     = png.IHDR.width;
   298	      extents->height    = -static_cast<int>(png.IHDR.height);
   299	
   300	      /* Convert to font units. */
   301	      if (strike_ppem)
   302	      {
   303	        float scale = font->face->get_upem () / (float) strike_ppem;
   304	        extents->x_bearing = font->em_scalef_x (extents->x_bearing * scale);
   305	        extents->y_bearing = font->em_scalef_y (extents->y_bearing * scale);
   306	        extents->width = font->em_scalef_x (extents->width * scale);
   307	        extents->height = font->em_scalef_y (extents->height * scale);
   308	      }
   309	      else
   310	      {
   311	        extents->x_bearing = font->em_scale_x (extents->x_bearing);
   312	        extents->y_bearing = font->em_scale_y (extents->y_bearing);
   313	        extents->width = font->em_scale_x (extents->width);
   314	        extents->height = font->em_scale_y (extents->height);
   315	      }
   316	
   317	      hb_blob_destroy (blob);
   318	
   319	      return strike_ppem;
   320	    }
