void QuickTimeVideo::previewTagDecoder(size_t size) {
  DataBuf buf(4);
  size_t cur_pos = io_->tell();
  io_->read(buf.data(), 4);
  xmpData_["Xmp.video.PreviewDate"] = getULong(buf.data(), bigEndian);
  io_->read(buf.data(), 2);
  xmpData_["Xmp.video.PreviewVersion"] = getShort(buf.data(), bigEndian);

  io_->read(buf.data(), 4);
