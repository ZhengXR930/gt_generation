                int size = bin->shdr[i].sh_size;

                if (size - (i * sizeof (Elf_(Shdr)) > bin->size)) {
                        size = bin->size - (i*sizeof(Elf_(Shdr)));
                }
                int left = size - (i * sizeof (Elf_(Shdr)));
                left = R_MIN (left, bin->shdr[i].sh_size);
                if (left < 0) {
