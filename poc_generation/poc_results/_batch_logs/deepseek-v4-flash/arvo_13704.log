#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "sdb.h"

/* Copy of the in_list function for debugging */
static int in_list(SdbList *list, void *item) {
    SdbNs *ns;
    SdbListIter *it;
    if (list && item)
    ls_foreach (list, it, ns) {
        if (item == ns) {
            return 1;
        }
    }
    return 0;
}

int main(void) {
    Sdb *parent, *child, *grandchild;
    SdbList *tracking;

    parent = sdb_new0();
    child = sdb_new0();
    grandchild = sdb_new0();

    printf("Initial refs: parent=%d child=%d grandchild=%d\n",
           parent->refs, child->refs, grandchild->refs);

    /* child has two namespaces pointing to grandchild */
    sdb_ns_set(child, "a", grandchild);
    printf("After child->a: grandchild refs=%d\n", grandchild->refs);
    sdb_ns_set(child, "b", grandchild);
    printf("After child->b: grandchild refs=%d\n", grandchild->refs);

    /* parent has two namespaces pointing to child */
    sdb_ns_set(parent, "ns1", child);
    printf("After parent->ns1: child refs=%d\n", child->refs);
    sdb_ns_set(parent, "ns2", child);
    printf("After parent->ns2: child refs=%d\n", child->refs);

    /* Manually trace what ns_free does */
    tracking = ls_new();
    tracking->free = NULL;

    printf("\n--- Manual trace of ns_free(parent) ---\n");
    printf("parent->ns has %zu entries\n", parent->ns->length);

    /* Check if parent is in tracking */
    printf("parent in tracking? %d\n", in_list(tracking, parent));
    ls_append(tracking, parent);

    SdbListIter *it;
    SdbNs *ns;
    int count = 0;
    ls_foreach(parent->ns, it, ns) {
        count++;
        printf("\n--- Processing ns entry %d: name=%s, sdb=%p, sdb->refs=%d ---\n",
               count, ns->name, (void*)ns->sdb, ns->sdb ? ns->sdb->refs : -1);
        printf("  ns in tracking? %d\n", in_list(tracking, ns));

        if (!in_list(tracking, ns)) {
            printf("  Would process this ns\n");
            printf("  Calling sdb_free(ns->sdb) #1...\n");
            bool freed = sdb_free(ns->sdb);
            printf("  sdb_free returned %d, refs now=%d\n", freed, ns->sdb ? ns->sdb->refs : -1);

            if (freed) {
                printf("  sdb was freed, ns->sdb would be set to NULL\n");
            } else {
                printf("  sdb NOT freed, ns->sdb still valid\n");
            }

            ls_append(tracking, ns);
            ls_append(tracking, ns->sdb);

            printf("  Calling ns_free(ns->sdb) recursively...\n");
            /* Would call ns_free recursively here */
            printf("  Calling sdb_free(ns->sdb) #2...\n");
            freed = sdb_free(ns->sdb);
            printf("  sdb_free #2 returned %d, refs now=%d\n", freed, ns->sdb ? ns->sdb->refs : -1);
            if (freed) {
                printf("  *** Sdb was freed by second sdb_free! ***\n");
            }
        }
    }

    printf("\nDone with manual trace\n");
    return 0;
}
EOF
