#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <stdlib.h>

// Replicate the \u escape handling from json.c
// cp points to the 'u' character
static int parse_escape(const char *cp) {
    unsigned n;
    char uescape[5];
    unsigned u;
    cp++;  // skip the 'u'
    for (n = 0; n < 4 && isxdigit((int)*cp); n++) {
        uescape[n] = *cp++;
    }
    uescape[n] = '\0';
    --cp;
    if ((4 != n) || (1 != sscanf(uescape, "%4x", &u))) {
        return -1;
    }
    return 0;
}

int main(void) {
    // Simulate libFuzzer input: Size bytes + NUL terminator
    // Input ends with \u (the 'u' is the last byte before NUL)
    const char *input = "{\"class\":\"TOFF\",\"device\":\"\\u";
    size_t size = strlen(input);
    printf("Input size: %zu\n", size);
    
    // Allocate buffer like libFuzzer: Size bytes + NUL, then poison
    char *buf = malloc(size + 1);
    memcpy(buf, input, size);
    buf[size] = 0;  // NUL terminator
    
    // Find the 'u' at the end (last byte before NUL)
    const char *cp = buf + size - 1;
    printf("Last char: %c (0x%02x)\n", *cp, (unsigned char)*cp);
    
    // Call parse_escape which does cp++ then reads *cp
    int result = parse_escape(cp);
    printf("parse_escape result: %d\n", result);
    
    free(buf);
    return 0;
}
EOF
