 */
#include <stdio.h>
#include <stdlib.h>

#define CRCSEED 0               // could be NZ to detect leading zeros
#define CRCPOLY 0x1864CFBu      // encodes all info about the polynomial

static void crc_init(unsigned int table[256])
{
    unsigned i, j;
    unsigned h;

    table[0] = CRCSEED;
    table[1] = h = CRCPOLY;

    for (i = 2; i < 256; i *= 2) {
        if ((h <<= 1) & 0x1000000)
            h ^= CRCPOLY;
        for (j = 0; j < i; j++)
            table[i + j] = table[j] ^ h;
    }
}

int main(int argc, char *argv[])
{
    int i;

    crc_init(table);

    for (i = 0; i < 256; i++) {
        printf("0x%08X, ", table[i]);
        if ((i % 4) == 3)
            putchar('\n');
    }

    exit(EXIT_SUCCESS);
}
#endif

