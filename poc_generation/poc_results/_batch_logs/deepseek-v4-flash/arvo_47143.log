        pinfo = (sc_pkcs15_auth_info_t *) pin_obj->data;
        if (pinfo->auth_type != SC_PKCS15_PIN_AUTH_TYPE_PIN)
                return 1;

        if (pinfo->tries_left != -1) {
                if (pinfo->tries_left != pinfo->max_tries) {
                        if (pinfo->tries_left == 0) {
