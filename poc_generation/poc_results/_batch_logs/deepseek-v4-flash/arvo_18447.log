#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#include "lwan-config.h"

static bool
dump(struct config *config, struct config_line *line, int indent_level)
{
    if (indent_level > 64)
        return false;

    while (config_read_line(config, line)) {
        switch (line->type) {
        case CONFIG_LINE_TYPE_LINE:
            break;

        case CONFIG_LINE_TYPE_SECTION_END:
            if (indent_level == 0)
                return false;

            return true;

        case CONFIG_LINE_TYPE_SECTION:
            if (!dump(config, line, indent_level + 1))
                return false;

            break;
        }
    }

    if (config_last_error(config)) {
        fprintf(stderr,
                "Error while reading configuration file (line %d): %s\n",
                config_cur_line(config), config_last_error(config));
        return false;
    }

    return true;
}

int main(int argc, char *argv[])
{
    if (argc != 2) {
        fprintf(stderr, "Usage: %s <input_file>\n", argv[0]);
        return 1;
    }

    FILE *f = fopen(argv[1], "rb");
    if (!f) {
        perror("fopen");
        return 1;
    }

    fseek(f, 0, SEEK_END);
    long size = ftell(f);
    fseek(f, 0, SEEK_SET);

    if (size > 32768)
        size = 32768;

    uint8_t *data = (uint8_t *)malloc(size);
    fread(data, 1, size, f);
    fclose(f);

    struct config *config;
    struct config_line line;

    config = config_open_for_fuzzing(data, size);
    if (!config) {
        free(data);
        return 1;
    }

    bool dumped = dump(config, &line, 0);

    config_close(config);
    free(data);

    return dumped ? 1 : 0;
}
EOF
