static uint32_t get_varuint32(const uint8_t *code, size_t code_len, size_t *leng)
{
        uint32_t data = 0;
        int i;

        for(i = 0;; i++) {
                if (code_len < i + 1) {
                        *leng = -1;
                        return 0;
                }


                if (i > 4 || (i == 4 && (code[i] & 0x7f) > 0x0f)) {
                        *leng = -1;
                        return 0;
                }

                data = data + ((code[i] & 0x7f) << (i * 7));
                if (code[i] >> 7 == 0) {
                        break;
                }
        }

        *leng = i + 1;

        return data;
}

