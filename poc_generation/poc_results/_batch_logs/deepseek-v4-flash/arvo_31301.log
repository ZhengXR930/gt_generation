        while (*p) {
            if ((*p == '{') && (q = strchr(p, '}'))) {
                p = parse_tags(render_priv, p, q, 1., false);
                assert(*p == '}');
                p++;
            } else if (render_priv->state.drawing_scale) {
                q = p;
                if (*p == '{')
                    q++;
                while ((*q != '{') && (*q != 0))
