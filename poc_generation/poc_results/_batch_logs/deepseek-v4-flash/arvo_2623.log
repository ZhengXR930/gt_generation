   171  static void handle_chunked_entity_read(struct st_h2o_http1_conn_t *conn)
   172  {
   173      struct st_h2o_http1_chunked_entity_reader *reader = (void *)conn->_req_entity_reader;
   174      h2o_buffer_t *inbuf = conn->sock->input;
   175      size_t bufsz;
   176      ssize_t ret;
   177
   178      /* decode the incoming data */
   179      if ((bufsz = inbuf->size - reader->prev_input_size) == 0)
   180          return;
   181      ret = phr_decode_chunked(&reader->decoder, inbuf->bytes + reader->prev_input_size, &bufsz);
   182      inbuf->size = reader->prev_input_size + bufsz;
   183      reader->prev_input_size = inbuf->size;
   184      if (ret != -1 && inbuf->size - conn->_reqsize >= conn->super.ctx->globalconf->max_request_entity_size) {
   185          entity_read_send_error_413(conn, "Request Entity Too Large", "request entity is too large");
   186          return;
   187      }
   188      if (ret < 0) {
   189          if (ret == -2) {
   190              /* incomplete */
   191              return;
   192          }
   193          /* error */
   194          entity_read_send_error_400(conn, "Invalid Request", "broken chunked-encoding");
   195          return;
   196      }
   197      /* complete */
   198      conn->req.entity = h2o_iovec_init(inbuf->bytes + conn->_reqsize, inbuf->size - conn->_reqsize);
   199      conn->_reqsize = inbuf->size;
   200      inbuf->size += ret; /* restore the number of extra bytes */
   201
   202      on_entity_read_complete(conn);
   203  }
   204
   205  static int create_chunked_entity_reader(struct st_h2o_http1_conn_t *conn)
   206  {
   207      struct st_h2o_http1_chunked_entity_reader *reader = h2o_mem_alloc_pool(&conn->req.pool, sizeof(*reader));
   208      conn->_req_entity_reader = &reader->super;
   209
   210      reader->super.handle_incoming_entity = handle_chunked_entity_read;
   211      memset(&reader->decoder, 0, sizeof(reader->decoder));
   212      reader->decoder.consume_trailer = 1;
   213      reader->prev_input_size = conn->_reqsize;
   214
   215      return 0;
   216  }
   217
   218  static void handle_content_length_entity_read(struct st_h2o_http1_conn_t *conn)
   219  {
   220      struct st_h2o_http1_content_length_entity_reader *reader = (void *)conn->_req_entity_reader;
   221
   222      /* wait until: reqsize == conn->_input.size */
   223      if (conn->sock->input->size < conn->_reqsize)
   224          return;
   225
   226      /* all input has arrived */
   227      conn->req.entity = h2o_iovec_init(conn->sock->input->bytes + conn->_reqsize - reader->content_length, reader->content_length);
   228      on_entity_read_complete(conn);
   229  }
   230
   231  static int create_content_length_entity_reader(struct st_h2o_http1_conn_t *conn, size_t content_length)
   232  {
   233      struct st_h2o_http1_content_length_entity_reader *reader = h2o_mem_alloc_pool(&conn->req.pool, sizeof(*reader));
   234      conn->_req_entity_reader = &reader->super;
   235
   236      reader->super.handle_incoming_entity = handle_content_length_entity_read;
   237      reader->content_length = content_length;
   238      conn->_reqsize += content_length;
   239
   240      return 0;
   241  }
   242
   243  static int create_entity_reader(struct st_h2o_http1_conn_t *conn, const struct phr_header *entity_header)
   244  {
   245      /* strlen("content-length") is unequal to sizeof("transfer-encoding"), and thus checking the length only is sufficient */
   246      if (entity_header->name_len == sizeof("transfer-encoding") - 1) {
   247          /* transfer-encoding */
   248          if (!h2o_lcstris(entity_header->value, entity_header->value_len, H2O_STRLIT("chunked"))) {
   249              entity_read_send_error_400(conn, "Invalid Request", "unknown transfer-encoding");
   250              return -1;
   251          }
   252          return create_chunked_entity_reader(conn);
   253      } else {
   254          /* content-length */
   255          size_t content_length = h2o_strtosize(entity_header->value, entity_header->value_len);
   256          if (content_length == SIZE_MAX) {
   257              entity_read_send_error_400(conn, "Invalid Request", "broken content-length header");
   258              return -1;
   259          }
   260          if (content_length > conn->super.ctx->globalconf->max_request_entity_size) {
   261              entity_read_send_error_413(conn, "Request Entity Too Large", "request entity is too large");
   262              return -1;
   263          }
   264          return create_content_length_entity_reader(conn, (size_t)content_length);
   265      }
   266      /* failed */
   267      return -1;
   268  }
