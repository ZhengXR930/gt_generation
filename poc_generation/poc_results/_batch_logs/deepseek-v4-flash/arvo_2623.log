   380  static void on_continue_sent(h2o_socket_t *sock, const char *err)
   381  {
   382      struct st_h2o_http1_conn_t *conn = sock->data;
   383
   384      if (err != NULL) {
   385          close_connection(conn, 1);
   386          return;
   387      }
   388
   389      h2o_socket_read_start(sock, reqread_on_read);
   390      conn->_req_entity_reader->handle_incoming_entity(conn);
   391  }
