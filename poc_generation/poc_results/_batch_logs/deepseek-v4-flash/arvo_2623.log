   270  static ssize_t init_headers(h2o_mem_pool_t *pool, h2o_headers_t *headers, const struct phr_header *src, size_t len,
   271                              h2o_iovec_t *connection, h2o_iovec_t *host, h2o_iovec_t *upgrade, h2o_iovec_t *expect)
   272  {
   273      ssize_t entity_header_index = -1;
   274
   275      assert(headers->size == 0);
   276
   277      /* setup */
   278      if (len != 0) {
   279          size_t i;
   280          h2o_vector_reserve(pool, headers, len);
   281          for (i = 0; i != len; ++i) {
   282              const h2o_token_t *name_token;
   283              char orig_case[src[i].name_len];
   284
   285              /* preserve the original case */
   286              memcpy(orig_case, src[i].name, src[i].name_len);
   287              /* convert to lower-case in-place */
   288              h2o_strtolower((char *)src[i].name, src[i].name_len);
   289              if ((name_token = h2o_lookup_token(src[i].name, src[i].name_len)) != NULL) {
   290                  if (name_token->is_init_header_special) {
   291                      if (name_token == H2O_TOKEN_HOST) {
   292                          host->base = (char *)src[i].value;
   293                          host->len = src[i].value_len;
   294                      } else if (name_token == H2O_TOKEN_CONTENT_LENGTH) {
   295                          if (entity_header_index == -1)
   296                              entity_header_index = i;
   297                      } else if (name_token == H2O_TOKEN_TRANSFER_ENCODING) {
   298                          entity_header_index = i;
   299                      } else if (name_token == H2O_TOKEN_EXPECT) {
   300                          expect->base = (char *)src[i].value;
   301                          expect->len = src[i].value_len;
   302                      } else if (name_token == H2O_TOKEN_UPGRADE) {
   303                          upgrade->base = (char *)src[i].value;
   304                          upgrade->len = src[i].value_len;
   305                      } else {
   306                          assert(!"logic flaw");
   307                      }
   308                  } else {
   309                      h2o_add_header(pool, headers, name_token, orig_case, src[i].value, src[i].value_len);
   310                      if (name_token == H2O_TOKEN_CONNECTION)
   311                          *connection = headers->entries[headers->size - 1].value;
   312                  }
   313              } else {
   314                  h2o_add_header_by_str(pool, headers, src[i].name, src[i].name_len, 0, orig_case, src[i].value, src[i].value_len);
   315              }
   316          }
   317      }
   318
   319      return entity_header_index;
   320  }
   321
   322  static ssize_t fixup_request(struct st_h2o_http1_conn_t *conn, struct phr_header *headers, size_t num_headers, int minor_version,
   323                               h2o_iovec_t *expect)
   324  {
   325      ssize_t entity_header_index;
   326      h2o_iovec_t connection = {NULL, 0}, host = {NULL, 0}, upgrade = {NULL, 0};
   327
   328      expect->base = NULL;
   329      expect->len = 0;
   330
   331      conn->req.input.scheme = conn->sock->ssl != NULL ? &H2O_URL_SCHEME_HTTPS : &H2O_URL_SCHEME_HTTP;
   332      conn->req.version = 0x100 | (minor_version != 0);
   333
   334      /* init headers */
   335      entity_header_index =
   336          init_headers(&conn->req.pool, &conn->req.headers, headers, num_headers, &connection, &host, &upgrade, expect);
   337
   338      /* copy the values to pool, since the buffer pointed by the headers may get realloced */
   339      if (entity_header_index != -1) {
   340          size_t i;
   341          conn->req.input.method = h2o_strdup(&conn->req.pool, conn->req.input.method.base, conn->req.input.method.len);
   342          conn->req.input.path = h2o_strdup(&conn->req.pool, conn->req.input.path.base, conn->req.input.path.len);
   343          for (i = 0; i != conn->req.headers.size; ++i) {
   344              h2o_header_t *header = conn->req.headers.entries + i;
   345              if (!h2o_iovec_is_token(header->name)) {
   346                  *header->name = h2o_strdup(&conn->req.pool, header->name->base, header->name->len);
   347              }
   348              header->value = h2o_strdup(&conn->req.pool, header->value.base, header->value.len);
   349          }
   350          if (host.base != NULL)
   351              host = h2o_strdup(&conn->req.pool, host.base, host.len);
   352          if (upgrade.base != NULL)
   353              upgrade = h2o_strdup(&conn->req.pool, upgrade.base, upgrade.len);
   354      }
   355
   356      /* move host header to req->authority */
   357      if (host.base != NULL)
   358          conn->req.input.authority = host;
   359
   360      /* setup persistent flag (and upgrade info) */
   361      if (connection.base != NULL) {
   362          /* TODO contains_token function can be faster */
   363          if (h2o_contains_token(connection.base, connection.len, H2O_STRLIT("keep-alive"), ',')) {
   364              conn->req.http1_is_persistent = 1;
   365          }
   366          if (upgrade.base != NULL && h2o_contains_token(connection.base, connection.len, H2O_STRLIT("upgrade"), ',')) {
   367              conn->req.upgrade = upgrade;
   368          }
   369      } else if (conn->req.version >= 0x101) {
   370          /* defaults to keep-alive if >= HTTP/1.1 */
   371          conn->req.http1_is_persistent = 1;
   372      }
   373      /* disable keep-alive if shutdown is requested */
   374      if (conn->req.http1_is_persistent && conn->super.ctx->shutdown_requested)
   375          conn->req.http1_is_persistent = 0;
   376
   377      return entity_header_index;
   378  }
