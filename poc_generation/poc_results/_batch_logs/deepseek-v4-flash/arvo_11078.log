   111	void VC5Decompressor::Wavelet::reconstructPass(
   112	    const Array2DRef<int16_t> dst, const Array2DRef<const int16_t> high,
   113	    const Array2DRef<const int16_t> low) const noexcept {
   114	  unsigned int x, y;
   115	
   116	  auto convolution = [&x, &y, high](std::array<int, 4> muls, auto lowGetter) {
   117	    return convolute(x, y, muls, high, lowGetter, /*DescaleShift*/ 0);
   118	  };
   119	
   120	  // Vertical reconstruction
   121	  // 1st row
   122	  y = 0;
   123	  for (x = 0; x < width; ++x) {
   124	    auto getter = [&x, &y, low](int delta) { return low(x, y + delta); };
   125	
   126	    static constexpr std::array<int, 4> even_muls = {+1, +11, -4, +1};
   127	    int even = convolution(even_muls, getter);
   128	    static constexpr std::array<int, 4> odd_muls = {-1, +5, +4, -1};
   129	    int odd = convolution(odd_muls, getter);
   130	
   131	    dst(x, 2 * y) = static_cast<int16_t>(even);
   132	    dst(x, 2 * y + 1) = static_cast<int16_t>(odd);
   133	  }
   134	  // middle rows
   135	  for (y = 1; y + 1 < height; ++y) {
   136	    for (x = 0; x < width; ++x) {
   137	      auto getter = [&x, &y, low](int delta) { return low(x, y - 1 + delta); };
   138	
   139	      static constexpr std::array<int, 4> even_muls = {+1, +1, +8, -1};
   140	      int even = convolution(even_muls, getter);
   141	      static constexpr std::array<int, 4> odd_muls = {-1, -1, +8, +1};
   142	      int odd = convolution(odd_muls, getter);
   143	
   144	      dst(x, 2 * y) = static_cast<int16_t>(even);
   145	      dst(x, 2 * y + 1) = static_cast<int16_t>(odd);
   146	    }
   147	  }
   148	  // last row
   149	  for (x = 0; x < width; ++x) {
   150	    auto getter = [&x, &y, low](int delta) { return low(x, y - delta); };
   151	
   152	    static constexpr std::array<int, 4> even_muls = {+1, +5, +4, -1};
   153	    int even = convolution(even_muls, getter);
   154	    static constexpr std::array<int, 4> odd_muls = {-1, +11, -4, +1};
   155	    int odd = convolution(odd_muls, getter);
   156	
   157	    dst(x, 2 * y) = static_cast<int16_t>(even);
   158	    dst(x, 2 * y + 1) = static_cast<int16_t>(odd);
   159	  }
   160	}
   161	
   162	void VC5Decompressor::Wavelet::combineLowHighPass(
   163	    const Array2DRef<int16_t> dest, const Array2DRef<const int16_t> low,
   164	    const Array2DRef<const int16_t> high, int descaleShift,
   165	    bool clampUint = false) const noexcept {
   166	  unsigned int x, y;
   167	
   168	  auto convolution = [&x, &y, high, descaleShift](std::array<int, 4> muls,
   169	                                                  auto lowGetter) {
   170	    return convolute(x, y, muls, high, lowGetter, descaleShift);
   171	  };
   172	
   173	  // Horizontal reconstruction
   174	  for (y = 0; y < dest.height; ++y) {
   175	    x = 0;
   176	
   177	    // First col
   178	
   179	    auto getter_first = [&x, &y, low](int delta) { return low(x + delta, y); };
   180	
   181	    static constexpr std::array<int, 4> even_muls = {+1, +11, -4, +1};
   182	    int even = convolution(even_muls, getter_first);
   183	    static constexpr std::array<int, 4> odd_muls = {-1, +5, +4, -1};
   184	    int odd = convolution(odd_muls, getter_first);
   185	
   186	    if (clampUint) {
   187	      even = clampBits(even, 14);
   188	      odd = clampBits(odd, 14);
   189	    }
   190	    dest(2 * x, y) = static_cast<int16_t>(even);
   191	    dest(2 * x + 1, y) = static_cast<int16_t>(odd);
   192	
   193	    // middle cols
   194	    for (x = 1; x + 1 < width; ++x) {
   195	      auto getter = [&x, &y, low](int delta) { return low(x - 1 + delta, y); };
   196	
   197	      static constexpr std::array<int, 4> middle_even_muls = {+1, +1, +8, -1};
   198	      even = convolution(middle_even_muls, getter);
   199	      static constexpr std::array<int, 4> middle_odd_muls = {-1, -1, +8, +1};
   200	      odd = convolution(middle_odd_muls, getter);
   201	
   202	      if (clampUint) {
   203	        even = clampBits(even, 14);
   204	        odd = clampBits(odd, 14);
   205	      }
   206	      dest(2 * x, y) = static_cast<int16_t>(even);
   207	      dest(2 * x + 1, y) = static_cast<int16_t>(odd);
   208	    }
   209	
   210	    // last col
   211	
   212	    auto getter_last = [&x, &y, low](int delta) { return low(x - delta, y); };
   213	
   214	    static constexpr std::array<int, 4> last_even_muls = {+1, +5, +4, -1};
   215	    even = convolution(last_even_muls, getter_last);
   216	    static constexpr std::array<int, 4> last_odd_muls = {-1, +11, -4, +1};
   217	    odd = convolution(last_odd_muls, getter_last);
   218	
   219	    if (clampUint) {
   220	      even = clampBits(even, 14);
   221	      odd = clampBits(odd, 14);
   222	    }
   223	    dest(2 * x, y) = static_cast<int16_t>(even);
   224	    dest(2 * x + 1, y) = static_cast<int16_t>(odd);
   225	  }
   226	}
   227	
   228	void VC5Decompressor::Wavelet::ReconstructableBand::processLow(
   229	    const Wavelet& wavelet) noexcept {
   230	  lowpass_storage =
   231	      Array2DRef<int16_t>::create(wavelet.width, 2 * wavelet.height);
   232	
   233	  const Array2DRef<int16_t> lowpass(lowpass_storage.data(), wavelet.width,
   234	                                    2 * wavelet.height);
   235	
   236	  const Array2DRef<const int16_t> highlow = wavelet.bandAsArray2DRef(2);
   237	  const Array2DRef<const int16_t> lowlow = wavelet.bandAsArray2DRef(0);
   238	
   239	  // Reconstruct the "immediates", the actual low pass ...
   240	  wavelet.reconstructPass(lowpass, highlow, lowlow);
   241	}
   242	
   243	void VC5Decompressor::Wavelet::ReconstructableBand::processHigh(
   244	    const Wavelet& wavelet) noexcept {
   245	  highpass_storage =
   246	      Array2DRef<int16_t>::create(wavelet.width, 2 * wavelet.height);
   247	
   248	  const Array2DRef<int16_t> highpass(highpass_storage.data(), wavelet.width,
   249	                                     2 * wavelet.height);
   250	
   251	  const Array2DRef<const int16_t> highhigh = wavelet.bandAsArray2DRef(3);
   252	  const Array2DRef<const int16_t> lowhigh = wavelet.bandAsArray2DRef(1);
   253	
   254	  wavelet.reconstructPass(highpass, highhigh, lowhigh);
   255	}
   256	
   257	void VC5Decompressor::Wavelet::ReconstructableBand::combine(
   258	    const Wavelet& wavelet) noexcept {
   259	  int16_t descaleShift = (wavelet.prescale == 2 ? 2 : 0);
   260	
   261	  data = Array2DRef<int16_t>::create(2 * wavelet.width, 2 * wavelet.height);
   262	  const Array2DRef<int16_t> dest(data.data(), 2 * wavelet.width,
   263	                                 2 * wavelet.height);
   264	
   265	  const Array2DRef<int16_t> lowpass(lowpass_storage.data(), wavelet.width,
   266	                                    2 * wavelet.height);
   267	  const Array2DRef<int16_t> highpass(highpass_storage.data(), wavelet.width,
   268	                                     2 * wavelet.height);
   269	
   270	  // And finally, combine the low pass, and high pass.
   271	  wavelet.combineLowHighPass(dest, lowpass, highpass, descaleShift, clampUint);
   272	}
   273	
   274	void VC5Decompressor::Wavelet::ReconstructableBand::decode(
   275	    const Wavelet& wavelet) noexcept {
   276	  assert(wavelet.allBandsValid());
   277	  assert(data.empty());
   278	  processLow(wavelet);
   279	  processHigh(wavelet);
   280	  combine(wavelet);
   281	}
