    87	namespace {
    88	auto convolute = [](unsigned x, unsigned y, std::array<int, 4> muls,
    89	                    const Array2DRef<const int16_t> high, auto lowGetter,
    90	                    int DescaleShift = 0) {
    91	  auto highCombined = muls[0] * high(x, y);
    92	  auto lowsCombined = [muls, lowGetter]() {
    93	    int lows = 0;
    94	    for (int i = 0; i < 3; i++)
    95	      lows += muls[1 + i] * lowGetter(i);
    96	    return lows;
    97	  }();
    98	  // Round up 'lows' up
    99	  lowsCombined += 4;
   100	  // And finally 'average' them.
   101	  auto lowsRounded = lowsCombined >> 3;
   102	  auto total = highCombined + lowsRounded;
   103	  // Descale it.
   104	  total <<= DescaleShift;
   105	  // And average it.
   106	  total >>= 1;
   107	  return total;
   108	};
   109	} // namespace
