    61	
    62	  if (cfaHeight &&
    63	      cfaWidth > std::numeric_limits<decltype(cfaWidth)>::max() / cfaHeight)
    64	    ThrowIOE("Integer overflow when calculating CFA area");
    65	  bs->check(cfaWidth * cfaHeight, 4);
    66	
    67	  cfa.setSize(rawspeed::iPoint2D(cfaWidth, cfaHeight));
    68	
    69	  for (auto x = 0U; x < cfaWidth; x++) {
    70	    for (auto y = 0U; y < cfaHeight; y++) {
    71	      const rawspeed::uint32 color = bs->getU32();
    72	      if (color >= static_cast<rawspeed::uint32>(rawspeed::CFA_END))
