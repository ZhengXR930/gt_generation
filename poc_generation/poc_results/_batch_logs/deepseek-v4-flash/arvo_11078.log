   283	VC5Decompressor::VC5Decompressor(ByteStream bs, const RawImage& img)
   284	    : mRaw(img), mBs(std::move(bs)) {
   285	  if (!mRaw->dim.hasPositiveArea())
   286	    ThrowRDE("Bad image dimensions.");
   287	
   288	  if (mRaw->dim.x % mVC5.patternWidth != 0)
   289	    ThrowRDE("Width %u is not a multiple of %u", mRaw->dim.x,
   290	             mVC5.patternWidth);
   291	
   292	  if (mRaw->dim.y % mVC5.patternHeight != 0)
   293	    ThrowRDE("Height %u is not a multiple of %u", mRaw->dim.y,
   294	             mVC5.patternHeight);
   295	
   296	  if (mRaw->dim.x > std::numeric_limits<decltype(Channel::width)>::max())
   297	    ThrowRDE("Width %u is too large", mRaw->dim.x);
   298	
   299	  if (mRaw->dim.y > std::numeric_limits<decltype(Channel::height)>::max())
   300	    ThrowRDE("Height %u is too large", mRaw->dim.y);
   301	
   302	  // Initialize wavelet sizes.
   303	  for (Channel& channel : channels) {
   304	    channel.width = mRaw->dim.x / mVC5.patternWidth;
   305	    channel.height = mRaw->dim.y / mVC5.patternHeight;
   306	
   307	    uint16_t waveletWidth = channel.width;
   308	    uint16_t waveletHeight = channel.height;
   309	    for (Wavelet& wavelet : channel.wavelets) {
   310	      // Pad dimensions as necessary and divide them by two for the next wavelet
   311	      for (auto* dimension : {&waveletWidth, &waveletHeight})
   312	        *dimension = roundUpDivision(*dimension, 2);
   313	      wavelet.width = waveletWidth;
   314	      wavelet.height = waveletHeight;
   315	    }
   316	  }
   317	
   318	  if (img->whitePoint <= 0 || img->whitePoint > int(((1U << 16U) - 1U)))
   319	    ThrowRDE("Bad white level %i", img->whitePoint);
   320	
   321	  outputBits = 0;
   322	  for (int wp = img->whitePoint; wp != 0; wp >>= 1)
   323	    ++outputBits;
   324	  assert(outputBits <= 16);
   325	
   326	  parseVC5();
   327	}
   328	
   329	void VC5Decompressor::initVC5LogTable() {
   330	  mVC5LogTable = decltype(mVC5LogTable)(
   331	      [outputBits = outputBits](unsigned i, unsigned tableSize) {
   332	        // The vanilla "inverse log" curve for decoding.
   333	        auto normalizedCurve = [](auto normalizedI) {
   334	          return (std::pow(113.0, normalizedI) - 1) / 112.0;
   335	        };
   336	
   337	        auto normalizeI = [tableSize](auto x) { return x / (tableSize - 1.0); };
   338	        auto denormalizeY = [maxVal = std::numeric_limits<ushort16>::max()](
   339	                                auto y) { return maxVal * y; };
   340	        // Adjust for output whitelevel bitdepth.
   341	        auto rescaleY = [outputBits](auto y) {
   342	          auto scale = 16 - outputBits;
   343	          return y >> scale;
   344	        };
   345	
   346	        const auto naiveY = denormalizeY(normalizedCurve(normalizeI(i)));
   347	        const auto intY = static_cast<unsigned int>(naiveY);
   348	        const auto rescaledY = rescaleY(intY);
   349	        return rescaledY;
   350	      });
   351	}
   352	
   353	const SimpleLUT<int16_t, 16> VC5Decompressor::mVC5DecompandingTable = []() {
   354	  auto dequantize = [](int16_t val) -> int16_t {
   355	    double c = val;
   356	    // Invert companding curve
   357	    c += (c * c * c * 768) / (255. * 255. * 255.);
   358	    if (c > std::numeric_limits<int16_t>::max())
   359	      return std::numeric_limits<int16_t>::max();
   360	    if (c < std::numeric_limits<int16_t>::min())
   361	      return std::numeric_limits<int16_t>::min();
   362	    return c;
   363	  };
   364	  return decltype(mVC5DecompandingTable)(
   365	      [dequantize](unsigned i, unsigned tableSize) {
   366	        return dequantize(int16_t(uint16_t(i)));
   367	      });
   368	}();
