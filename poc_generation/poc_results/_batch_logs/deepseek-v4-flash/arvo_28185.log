        r = iso_ops->read_binary(card, 2, (unsigned char *)*tname, buf[1], 0);
        if (r < 1) {
                free(*tname);
                LOG_FUNC_RETURN(card->ctx, r);
        }

        if ((*tname)[r-1] != '\0') {
                (*tname)[r-1] = '\0';
        }
        LOG_FUNC_RETURN(card->ctx, SC_SUCCESS);
}

