   406	private int
   407	check_fmt(struct magic_set *ms, struct magic *m)
   408	{
   409	        file_regex_t rx;
   410	        int rc, rv = -1;
   411	
   412	        if (strchr(m->desc, '%') == NULL)
   413	                return 0;
   414	
   415	        rc = file_regcomp(&rx, "%[-0-9\\.]*s", REG_EXTENDED|REG_NOSUB);
   416	        if (rc) {
   417	                file_regerror(&rx, rc, ms);
   418	        } else {
   419	                rc = file_regexec(&rx, m->desc, 0, 0, 0);
   420	                rv = !rc;
   421	        }
   422	        file_regfree(&rx);
   423	        return rv;
   424	}
