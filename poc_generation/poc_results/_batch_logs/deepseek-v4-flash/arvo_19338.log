   237	otError Mle::Start(bool aAnnounceAttach)
   238	{
   239	    otError error = OT_ERROR_NONE;
   240	
   241	    // cannot bring up the interface if IEEE 802.15.4 promiscuous mode is enabled
   242	    VerifyOrExit(!Get<Radio>().GetPromiscuous(), error = OT_ERROR_INVALID_STATE);
   243	    VerifyOrExit(Get<ThreadNetif>().IsUp(), error = OT_ERROR_INVALID_STATE);
   244	
   245	    if (Get<Mac::Mac>().GetPanId() == Mac::kPanIdBroadcast)
   246	    {
   247	        // if PAN ID is not configured, pick a random one to start
   248	
   249	        uint16_t panid;
   250	
   251	        do
   252	        {
   253	            panid = Random::NonCrypto::GetUint16();
   254	        } while (panid == Mac::kPanIdBroadcast);
   255	
   256	        Get<Mac::Mac>().SetPanId(panid);
   257	    }
   258	
   259	    SetStateDetached();
   260	
   261	    ApplyMeshLocalPrefix();
   262	    SetRloc16(GetRloc16());
   263	
   264	    mAttachCounter = 0;
   265	
   266	    Get<KeyManager>().Start();
   267	
   268	    if (!aAnnounceAttach)
   269	    {
   270	        mReattachState = kReattachStart;
   271	    }
   272	
   273	    if (aAnnounceAttach || (GetRloc16() == Mac::kShortAddrInvalid))
   274	    {
   275	        BecomeChild(kAttachAny);
   276	    }
   277	    else if (IsActiveRouter(GetRloc16()))
   278	    {
   279	        if (Get<MleRouter>().BecomeRouter(ThreadStatusTlv::kTooFewRouters) != OT_ERROR_NONE)
   280	        {
   281	            BecomeChild(kAttachAny);
   282	        }
   283	    }
   284	    else
   285	    {
   286	        mChildUpdateAttempts = 0;
   287	        SendChildUpdateRequest();
   288	    }
   289	
   290	exit:
   291	    return error;
   292	}
   293	
   294	void Mle::Stop(bool aClearNetworkDatasets)
   295	{
   296	    if (aClearNetworkDatasets)
   297	    {
   298	        Get<MeshCoP::ActiveDataset>().HandleDetach();
   299	        Get<MeshCoP::PendingDataset>().HandleDetach();
   300	    }
   301	
   302	    VerifyOrExit(mRole != OT_DEVICE_ROLE_DISABLED);
   303	
   304	    Get<KeyManager>().Stop();
   305	    SetStateDetached();
   306	    Get<ThreadNetif>().UnsubscribeMulticast(mRealmLocalAllThreadNodes);
   307	    Get<ThreadNetif>().UnsubscribeMulticast(mLinkLocalAllThreadNodes);
   308	    Get<ThreadNetif>().RemoveUnicastAddress(mMeshLocal16);
   309	    Get<ThreadNetif>().RemoveUnicastAddress(mMeshLocal64);
   310	
   311	    SetRole(OT_DEVICE_ROLE_DISABLED);
   312	
   313	exit:
   314	    return;
   315	}
   316	
   317	void Mle::SetRole(otDeviceRole aRole)
   318	{
   319	    otDeviceRole oldRole = mRole;
   320	
   321	    SuccessOrExit(Get<Notifier>().Update(mRole, aRole, OT_CHANGED_THREAD_ROLE));
   322	
   323	    otLogNoteMle("Role %s -> %s", RoleToString(oldRole), RoleToString(mRole));
   324	
   325	    switch (mRole)
   326	    {
   327	    case OT_DEVICE_ROLE_DISABLED:
   328	        mCounters.mDisabledRole++;
   329	        break;
   330	    case OT_DEVICE_ROLE_DETACHED:
   331	        mCounters.mDetachedRole++;
   332	        break;
   333	    case OT_DEVICE_ROLE_CHILD:
   334	        mCounters.mChildRole++;
   335	        break;
   336	    case OT_DEVICE_ROLE_ROUTER:
   337	        mCounters.mRouterRole++;
   338	        break;
   339	    case OT_DEVICE_ROLE_LEADER:
   340	        mCounters.mLeaderRole++;
   341	        break;
   342	    }
   343	
   344	#if OPENTHREAD_CONFIG_BORDER_AGENT_ENABLE
   345	    if (IsAttached())
   346	    {
   347	        SuccessOrExit(Get<MeshCoP::BorderAgent>().Start());
   348	    }
   349	    else
   350	    {
   351	        SuccessOrExit(Get<MeshCoP::BorderAgent>().Stop());
   352	    }
   353	#endif
   354	
   355	exit:
   356	    OT_UNUSED_VARIABLE(oldRole);
   357	}
