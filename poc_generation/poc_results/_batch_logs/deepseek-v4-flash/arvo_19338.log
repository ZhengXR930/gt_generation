   179	    mMeshLocal16.GetAddress().mFields.m16[5] = HostSwap16(0x00ff);
   180	    mMeshLocal16.GetAddress().mFields.m16[6] = HostSwap16(0xfe00);
   181	    mMeshLocal16.mPrefixLength               = 64;
   182	    mMeshLocal16.mPreferred                  = true;
   183	    mMeshLocal16.mValid                      = true;
   184	    mMeshLocal16.mScopeOverride              = Ip6::Address::kRealmLocalScope;
   185	    mMeshLocal16.mScopeOverrideValid         = true;
   186	    mMeshLocal16.mRloc                       = true;
   187	
   188	    // Store RLOC address reference in MPL module.
   189	    Get<Ip6::Mpl>().SetMatchingAddress(mMeshLocal16.GetAddress());
   190	
   191	    // link-local all thread nodes
   192	    mLinkLocalAllThreadNodes.GetAddress().mFields.m16[0] = HostSwap16(0xff32);
   193	    mLinkLocalAllThreadNodes.GetAddress().mFields.m16[6] = HostSwap16(0x0000);
   194	    mLinkLocalAllThreadNodes.GetAddress().mFields.m16[7] = HostSwap16(0x0001);
   195	
   196	    // realm-local all thread nodes
   197	    mRealmLocalAllThreadNodes.GetAddress().mFields.m16[0] = HostSwap16(0xff33);
   198	    mRealmLocalAllThreadNodes.GetAddress().mFields.m16[6] = HostSwap16(0x0000);
   199	    mRealmLocalAllThreadNodes.GetAddress().mFields.m16[7] = HostSwap16(0x0001);
   200	
   201	    SetMeshLocalPrefix(meshLocalPrefix);
   202	
   203	    // `SetMeshLocalPrefix()` also adds the Mesh-Local EID and subscribes
   204	    // to the Link- and Realm-Local All Thread Nodes multicast addresses.
   205	
   206	#if OPENTHREAD_CONFIG_PARENT_SEARCH_ENABLE
   207	    StartParentSearchTimer();
   208	#endif
   209	}
