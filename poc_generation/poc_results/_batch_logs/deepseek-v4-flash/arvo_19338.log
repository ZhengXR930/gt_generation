   369	otError Mle::Restore(void)
   370	{
   371	    otError               error = OT_ERROR_NONE;
   372	    Settings::NetworkInfo networkInfo;
   373	    Settings::ParentInfo  parentInfo;
   374	
   375	    Get<MeshCoP::ActiveDataset>().Restore();
   376	    Get<MeshCoP::PendingDataset>().Restore();
   377	
   378	    SuccessOrExit(error = Get<Settings>().ReadNetworkInfo(networkInfo));
   379	
   380	    Get<KeyManager>().SetCurrentKeySequence(networkInfo.mKeySequence);
   381	    Get<KeyManager>().SetMleFrameCounter(networkInfo.mMleFrameCounter);
   382	    Get<KeyManager>().SetMacFrameCounter(networkInfo.mMacFrameCounter);
   383	    mDeviceMode.Set(networkInfo.mDeviceMode);
   384	
   385	    switch (networkInfo.mRole)
   386	    {
   387	    case OT_DEVICE_ROLE_CHILD:
   388	    case OT_DEVICE_ROLE_ROUTER:
   389	    case OT_DEVICE_ROLE_LEADER:
   390	        break;
   391	
   392	    default:
   393	        ExitNow();
   394	    }
   395	
   396	    Get<Mac::Mac>().SetShortAddress(networkInfo.mRloc16);
   397	    Get<Mac::Mac>().SetExtAddress(networkInfo.mExtAddress);
   398	
   399	    memcpy(&mMeshLocal64.GetAddress().mFields.m8[OT_IP6_PREFIX_SIZE], networkInfo.mMlIid,
   400	           OT_IP6_ADDRESS_SIZE - OT_IP6_PREFIX_SIZE);
   401	
   402	    if (networkInfo.mRloc16 == Mac::kShortAddrInvalid)
   403	    {
   404	        ExitNow();
   405	    }
   406	
   407	    if (!IsActiveRouter(networkInfo.mRloc16))
   408	    {
   409	        error = Get<Settings>().ReadParentInfo(parentInfo);
   410	
   411	        if (error != OT_ERROR_NONE)
   412	        {
   413	            // If the restored RLOC16 corresponds to an end-device, it
   414	            // is expected that the `ParentInfo` settings to be valid
   415	            // as well. The device can still recover from such an invalid
   416	            // setting by skipping the re-attach ("Child Update Request"
   417	            // exchange) and going through the full attach process.
   418	
   419	            otLogWarnMle("Invalid settings - no saved parent info with valid end-device RLOC16 0x%04x",
   420	                         networkInfo.mRloc16);
   421	            ExitNow();
   422	        }
   423	
   424	        mParent.Clear();
   425	        mParent.SetExtAddress(*static_cast<Mac::ExtAddress *>(&parentInfo.mExtAddress));
   426	        mParent.SetDeviceMode(DeviceMode(DeviceMode::kModeFullThreadDevice | DeviceMode::kModeRxOnWhenIdle |
   427	                                         DeviceMode::kModeFullNetworkData | DeviceMode::kModeSecureDataRequest));
   428	        mParent.SetRloc16(GetRloc16(GetRouterId(networkInfo.mRloc16)));
   429	        mParent.SetState(Neighbor::kStateRestored);
   430	
   431	#if OPENTHREAD_CONFIG_MLE_INFORM_PREVIOUS_PARENT_ON_REATTACH
   432	        mPreviousParentRloc = mParent.GetRloc16();
   433	#endif
   434	    }
   435	    else
   436	    {
   437	        Get<MleRouter>().SetRouterId(GetRouterId(GetRloc16()));
   438	        Get<MleRouter>().SetPreviousPartitionId(networkInfo.mPreviousPartitionId);
   439	        Get<MleRouter>().RestoreChildren();
   440	    }
   441	
   442	exit:
   443	    return error;
   444	}
