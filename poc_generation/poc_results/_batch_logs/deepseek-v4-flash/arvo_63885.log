# Code section: 1 body: locals=0, [unreachable, end]
body = uleb(0) + b'\x00\x0b'
code_payload = uleb(1) + uleb(len(body)) + body

wasm = b'\x00asm\x01\x00\x00\x00'
wasm += section(1, type_payload)
wasm += section(3, func_payload)
wasm += section(10, code_payload)

