import struct

def uleb(n):
    out = b''
    while True:
        b = n & 0x7f
        n >>= 7
        if n:
            out += bytes([b | 0x80])
        else:
            out += bytes([b])
            return out

def section(sid, payload):
    return bytes([sid]) + uleb(len(payload)) + payload

# Type section: 1 type: () -> i32
type_payload = uleb(1) + b'\x60' + uleb(0) + uleb(1) + b'\x7f'
# Function section: 1 function of type 0
