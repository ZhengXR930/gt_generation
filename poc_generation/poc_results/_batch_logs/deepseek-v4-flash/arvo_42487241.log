#include <config.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <malloc.h>
#include "htslib/hfile.h"
#include "htslib/hts.h"
#include "htslib/vcf.h"

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    hFILE *memfile;
    uint8_t *copy = malloc(size);
    memcpy(copy, data, size);
    memfile = hopen("mem:", "rb:", copy, size);
    if (memfile == NULL) { free(copy); return 0; }
    htsFile *ht_file = hts_hopen(memfile, "data", "rb");
    if (ht_file == NULL) { if (hclose(memfile) != 0) abort(); return 0; }
    if (ht_file->format.category == variant_data) {
        bcf_hdr_t *hdr = bcf_hdr_read(ht_file);
        if (hdr) {
            bcf1_t *rec = bcf_init();
            int r = bcf_read(ht_file, hdr, rec);
            fprintf(stderr, "bcf_read returned %d\n", r);
            fprintf(stderr, "indiv.l=%d indiv.m=%d usable=%zu\n", rec->indiv.l, rec->indiv.m, malloc_usable_size(rec->indiv.s));
            bcf_destroy(rec);
            bcf_hdr_destroy(hdr);
        }
    }
    hts_close(ht_file);
    return 0;
}
int main(int argc, char **argv) {
    if (argc < 2) return 1;
    FILE *f = fopen(argv[1], "rb");
    if (!f) return 1;
    fseek(f, 0, SEEK_END); long sz = ftell(f); fseek(f, 0, SEEK_SET);
    uint8_t *buf = malloc(sz); fread(buf, 1, sz, f); fclose(f);
    LLVMFuzzerTestOneInput(buf, sz);
    free(buf);
    return 0;
}
