        if (type == NULL) {
                haderror |= printf("ERROR: %s%c", magic_error(ms), c);
        } else {
                haderror |= printf("%s%c", type, c) < 0;
        }
        if (nobuffer)
                haderror |= fflush(stdout) != 0;
        return haderror || type == NULL;
}

