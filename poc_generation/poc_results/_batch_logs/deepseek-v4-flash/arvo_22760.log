   153	    if (format != L_BF_ANY && !barcodeFormatIsSupported(format))
   154	        return (SARRAY *)ERROR_PTR("unsupported format", procName, NULL);
   155	    if (method != L_USE_WIDTHS && method != L_USE_WINDOWS)
