   209	        return NULL;
   210	    }
   211	
   212	    if (debugflag) {
   213	        boxaWriteStderr(boxa);
   214	        pixDisplay(pixb, 100, 100);
   215	        pixDisplay(pixm, 800, 100);
   216	    }
   217	
   218	        /* Deskew each barcode individually */
   219	    pixa = pixaCreate(n);
   220	    for (i = 0; i < n; i++) {
   221	        box = boxaGetBox(boxa, i, L_CLONE);
   222	        pixt = pixDeskewBarcode(pixs, pixb, box, 15, 20, &angle, &conf);
   223	        L_INFO("angle = %6.2f, conf = %6.2f\n", procName, angle, conf);
   224	        if (conf > 5.0) {
   225	            pixaAddPix(pixa, pixt, L_INSERT);
   226	            pixaAddBox(pixa, box, L_INSERT);
   227	        } else {
   228	            pixDestroy(&pixt);
   229	            boxDestroy(&box);
   230	        }
   231	    }
   232	
   233	#if  DEBUG_DESKEW
   234	    pixt = pixaDisplayTiledInRows(pixa, 8, 1000, 1.0, 0, 30, 2);
   235	    pixWrite("junkpixt", pixt, IFF_PNG);
   236	    pixDestroy(&pixt);
   237	#endif  /* DEBUG_DESKEW */
   238	
   239	    pixDestroy(&pixb);
   240	    pixDestroy(&pixm);
   241	    boxaDestroy(&boxa);
   242	    return pixa;
   243	}
