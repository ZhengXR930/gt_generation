   182	 * \return  pixa  deskewed and cropped barcodes, or NULL if none found
   183	 *                or on error
   184	 */
   185	PIXA *
   186	pixExtractBarcodes(PIX     *pixs,
   187	                   l_int32  debugflag)
   188	{
   189	l_int32    i, n;
   190	l_float32  angle, conf;
   191	BOX       *box;
   192	BOXA      *boxa;
   193	PIX       *pixb, *pixm, *pixt;
   194	PIXA      *pixa;
   195	
   196	    PROCNAME("pixExtractBarcodes");
   197	
   198	    if (!pixs || pixGetDepth(pixs) != 8 || pixGetColormap(pixs))
   199	        return (PIXA *)ERROR_PTR("pixs undefined or not 8 bpp", procName, NULL);
   200	
   201	        /* Locate them; use small threshold for edges. */
   202	    boxa = pixLocateBarcodes(pixs, 20, &pixb, &pixm);
   203	    n = boxaGetCount(boxa);
   204	    L_INFO("%d possible barcode(s) found\n", procName, n);
   205	    if (n == 0) {
