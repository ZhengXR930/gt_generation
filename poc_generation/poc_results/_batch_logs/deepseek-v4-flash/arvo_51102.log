#include <cstdint>
#include <cstring>
#include <string>
#include <vector>
#include <iostream>
#include <fstream>

#include "hunspell.hxx"

class FuzzerAffixManager {
 public:
  FuzzerAffixManager(const uint8_t* data, size_t size) {
    if (size < 1)
      return;
    std::string aff(reinterpret_cast<const char*>(data), size);
    std::string dic;
    size_t split_at = aff.find('\n');
    if (split_at != std::string::npos) {
      dic = aff.substr(split_at + 1);
      aff.resize(split_at);
    }
    aff.push_back('\0');
    dic.push_back('\0');
    std::cerr << "DEBUG: aff=[" << aff << "]" << std::endl;
    std::cerr << "DEBUG: dic=[" << dic << "]" << std::endl;
    pMS = Hunspell_create(&aff[0], &dic[0]);
    if (pMS) {
      std::cerr << "DEBUG: Hunspell created successfully" << std::endl;
    } else {
      std::cerr << "DEBUG: Hunspell creation FAILED" << std::endl;
    }
  }
  ~FuzzerAffixManager() {
    if (pMS)
      Hunspell_destroy(pMS);
  }
  Hunspell* pMS = nullptr;
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  if (size < 1)
    return 0;
  std::string all(reinterpret_cast<const char*>(data), size);
  size_t wordlen = all[0];
  if (wordlen + 1 >= size)
    return 0;
  std::string word = all.substr(1, wordlen);
  std::string rest = all.substr(1 + wordlen);
  size_t split_at = rest.size() / 2;
  std::string aff = rest.substr(0, split_at);
  std::string dic = rest.substr(split_at);

  std::cerr << "DEBUG: word=[" << word << "] wordlen=" << wordlen << std::endl;
  std::cerr << "DEBUG: aff size=" << aff.size() << " dic size=" << dic.size() << std::endl;

  FuzzerAffixManager manager(reinterpret_cast<const uint8_t*>(aff.data()), aff.size());
  if (!manager.pMS)
    return 0;

  int spell_result = Hunspell_spell(manager.pMS, word.c_str());
  std::cerr << "DEBUG: spell result=" << spell_result << std::endl;

  std::vector<std::string> suggestions;
  Hunspell_suggest(manager.pMS, suggestions, word.c_str());
  std::cerr << "DEBUG: suggestions count=" << suggestions.size() << std::endl;
  return 0;
}

int main(int argc, char** argv) {
    if (argc < 2) {
        std::cerr << "Usage: " << argv[0] << " <input_file>" << std::endl;
        return 1;
    }
    std::ifstream file(argv[1], std::ios::binary);
    std::ostringstream ss;
    ss << file.rdbuf();
    std::string data = ss.str();
    return LLVMFuzzerTestOneInput(reinterpret_cast<const uint8_t*>(data.data()), data.size());
}
