   395	/************************/
   396	/* Floating Point Types */
   397	/************************/
   398	
   399	/* Convert special numbers to string
   400	 * - fmt_fp gives NAN, nan,-NAN, -nan, inf, INF, -inf, -INF
   401	 * - Special floating-point numbers such as positive infinity (INF), negative
   402	 *   infinity (-INF) and not-a-number (NaN) shall be represented by the values
   403	 *   “Infinity”, “-Infinity” and “NaN” encoded as a JSON string. */
   404	static status
   405	checkAndEncodeSpecialFloatingPoint(char *buffer, size_t *len) {
   406	    /*nan and NaN*/
   407	    if(*len == 3 && 
   408	            (buffer[0] == 'n' || buffer[0] == 'N') && 
   409	            (buffer[1] == 'a' || buffer[1] == 'A') && 
   410	            (buffer[2] == 'n' || buffer[2] == 'N')) {
   411	        *len = 5;
   412	        memcpy(buffer, "\"NaN\"", *len);
   413	        return UA_STATUSCODE_GOOD;
   414	    }
   415	
   416	    /*-nan and -NaN*/
   417	    if(*len == 4 && buffer[0] == '-' && 
   418	            (buffer[1] == 'n' || buffer[1] == 'N') && 
   419	            (buffer[2] == 'a' || buffer[2] == 'A') && 
   420	            (buffer[3] == 'n' || buffer[3] == 'N')) {
   421	        *len = 6;
   422	        memcpy(buffer, "\"-NaN\"", *len);
   423	        return UA_STATUSCODE_GOOD;
   424	    }
   425	
   426	    /*inf*/
   427	    if(*len == 3 && 
   428	            (buffer[0] == 'i' || buffer[0] == 'I') && 
   429	            (buffer[1] == 'n' || buffer[1] == 'N') && 
   430	            (buffer[2] == 'f' || buffer[2] == 'F')) {
   431	        *len = 10;
   432	        memcpy(buffer, "\"Infinity\"", *len);
   433	        return UA_STATUSCODE_GOOD;
   434	    }
   435	
   436	    /*-inf*/
   437	    if(*len == 4 && buffer[0] == '-' && 
   438	            (buffer[1] == 'i' || buffer[1] == 'I') && 
   439	            (buffer[2] == 'n' || buffer[2] == 'N') && 
   440	            (buffer[3] == 'f' || buffer[3] == 'F')) {
   441	        *len = 11;
   442	        memcpy(buffer, "\"-Infinity\"", *len);
   443	        return UA_STATUSCODE_GOOD;
   444	    }
   445	    return UA_STATUSCODE_GOOD;
   446	}
