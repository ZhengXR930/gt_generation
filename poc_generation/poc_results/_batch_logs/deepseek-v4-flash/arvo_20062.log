   501	static status
   502	encodeJsonArray(CtxJson *ctx, const void *ptr, size_t length,
   503	                const UA_DataType *type) {
   504	    encodeJsonSignature encodeType = encodeJsonJumpTable[type->typeKind];
   505	    status ret = writeJsonArrStart(ctx);
   506	    uintptr_t uptr = (uintptr_t)ptr;
   507	    for(size_t i = 0; i < length && ret == UA_STATUSCODE_GOOD; ++i) {
   508	        ret |= writeJsonCommaIfNeeded(ctx);
   509	        ret |= encodeType((const void*)uptr, type, ctx);
   510	        ctx->commaNeeded[ctx->depth] = true;
   511	        uptr += type->memSize;
   512	    }
   513	    ret |= writeJsonArrEnd(ctx);
   514	    return ret;
   515	}
