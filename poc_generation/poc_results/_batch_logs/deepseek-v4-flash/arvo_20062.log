   448	ENCODE_JSON(Float) {
   449	    char buffer[200];
   450	    if(*src == *src) {
   451	#ifdef UA_ENABLE_CUSTOM_LIBC
   452	        fmt_fp(buffer, *src, 0, -1, 0, 'g');
   453	#else
   454	        UA_snprintf(buffer, 200, "%.149g", (UA_Double)*src);
   455	#endif
   456	    } else {
   457	        strcpy(buffer, "NaN");
   458	    }
   459	
   460	    size_t len = strlen(buffer);
   461	    if(len == 0)
   462	        return UA_STATUSCODE_BADENCODINGERROR;
   463	    
   464	    checkAndEncodeSpecialFloatingPoint(buffer, &len);
   465	    
   466	    if(ctx->pos + len > ctx->end)
   467	        return UA_STATUSCODE_BADENCODINGLIMITSEXCEEDED;
   468	
   469	    if(!ctx->calcOnly)
   470	        memcpy(ctx->pos, buffer, len);
   471	
   472	    ctx->pos += len;
   473	    return UA_STATUSCODE_GOOD;
   474	}
