   215	/* Writes null terminated string to output buffer (current ctx->pos). Writes
   216	 * comma in front of key if needed. Encapsulates key in quotes. */
   217	status UA_FUNC_ATTR_WARN_UNUSED_RESULT
   218	writeJsonKey(CtxJson *ctx, const char* key) {
   219	    size_t size = strlen(key);
   220	    if(ctx->pos + size + 4 > ctx->end) /* +4 because of " " : and , */
   221	        return UA_STATUSCODE_BADENCODINGLIMITSEXCEEDED;
   222	    status ret = writeJsonCommaIfNeeded(ctx);
   223	    ctx->commaNeeded[ctx->depth] = true;
   224	    if(ctx->calcOnly) {
   225	        ctx->commaNeeded[ctx->depth] = true;
   226	        ctx->pos += 3;
   227	        ctx->pos += size;
   228	        return ret;
   229	    }
   230	
   231	    ret |= writeChar(ctx, '\"');
   232	    for(size_t i = 0; i < size; i++) {
   233	        *(ctx->pos++) = (u8)key[i];
   234	    }
   235	    ret |= writeChar(ctx, '\"');
   236	    ret |= writeChar(ctx, ':');
   237	    return ret;
   238	}
