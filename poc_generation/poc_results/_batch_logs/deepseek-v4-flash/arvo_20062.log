   479	#ifdef UA_ENABLE_CUSTOM_LIBC
   480	        fmt_fp(buffer, *src, 0, 17, 0, 'g');
   481	#else
   482	        UA_snprintf(buffer, 2000, "%.1074g", *src);
   483	#endif
   484	    } else {
   485	        strcpy(buffer, "NaN");
   486	    }
   487	
   488	    size_t len = strlen(buffer);
   489	    checkAndEncodeSpecialFloatingPoint(buffer, &len);    
   490	
   491	    if(ctx->pos + len > ctx->end)
   492	        return UA_STATUSCODE_BADENCODINGLIMITSEXCEEDED;
   493	
