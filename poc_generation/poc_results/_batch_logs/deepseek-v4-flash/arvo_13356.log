   453	static size_t
   454	_u32_cp_stream_len (const uint8_t * stream, size_t ncp)
   455	{
   456	  const uint8_t *end;
   457	
   458	  for (end = stream; ncp; end++)
   459	    {
   460	      if ((*end & 0x80) == 0)
   461	        ncp--;
   462	    }
   463	
   464	  return end - stream;
