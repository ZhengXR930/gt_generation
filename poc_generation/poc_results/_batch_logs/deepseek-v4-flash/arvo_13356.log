   149	      else if (cp <= 0x3fff)
   150	        n += 2;
   151	      else if (cp <= 0x1fffff)
   152	        n += 3;
   153	      else if (cp <= 0xFFFFFFF)
   154	        n += 4;
   155	      else
   156	        n += 5;
   157	    }
   158	
   159	  return n;
   160	}
