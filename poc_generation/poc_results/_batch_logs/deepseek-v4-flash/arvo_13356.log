   467	/* Remove doubled mappings. With Unicode 6.3.0 the mapping data shrinks
   468	 *  from 7272 to 4322 entries of uint32_t (29088 to 17288 bytes).
   469	 * Converting those 4322 uin32_t values to a uint8_t stream, we decrease mapping
   470	 *  table size from 17288 to 9153 bytes.
   471	 */
   472	static void
   473	_compact_idna_map (void)
   474	{
   475	  unsigned it;
   476	
   477	  /* sort into 'longest mappings first' */
   478	  qsort (idna_map, map_pos, sizeof (IDNAMap_gen),
   479	         (int (*)(const void *, const void *)) _compare_map_by_maplen);
   480	
   481	  uint8_t *data = calloc (sizeof (uint8_t), mapdata_pos), *p;
   482	  size_t ndata = 0, slen;
   483	
   484	  if (data == NULL)
   485	    abort();
   486	
   487	  for (it = 0; it < map_pos; it++)
   488	    {
   489	      IDNAMap_gen *map = idna_map + it;
   490	
   491	      if (!map->nmappings)
   492	        continue;
   493	
   494	      slen = _u32_cp_stream_len (genmapdata + map->offset, map->nmappings);
   495	
   496	      if ((p = _u8_memmem (data, ndata, genmapdata + map->offset, slen)))
   497	        {
   498	          map->offset = p - data;
   499	          continue;
   500	        }
   501	
   502	      memcpy (data + ndata, genmapdata + map->offset, slen);
   503	      map->offset = ndata;
   504	      ndata += slen;
   505	    }
   506	
   507	  memcpy (genmapdata, data, ndata);
   508	  mapdata_pos = ndata;
   509	  free (data);
   510	
   511	  /* sort into 'lowest codepoint first' */
   512	  qsort (idna_map, map_pos, sizeof (IDNAMap_gen),
   513	         (int (*)(const void *, const void *)) _compare_map);
   514	}
