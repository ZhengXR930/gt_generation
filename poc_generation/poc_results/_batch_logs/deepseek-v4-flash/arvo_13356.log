   136	/*
   137	1 byte: 0-0x7f -> 0xxxxxxx
   138	2 bytes: 0x80-0x3fff ->1xxxxxxx 0xxxxxxx
   139	3 bytes: 0x4000-0x1fffff ->1xxxxxxx 1xxxxxxx 0xxxxxxx
   140	4 bytes: 0x200000-0xFFFFFFF -> 1xxxxxxx 1xxxxxxx 1xxxxxxx 0xxxxxxx
   141	5 bytes: 0x10000000->0xFFFFFFFF -> 1xxxxxxx 1xxxxxxx 1xxxxxxx 1xxxxxxx
   142	*/
   143	  for (it = 0; it < len; it++)
   144	    {
   145	      uint32_t cp = src[it];
   146	
   147	      if (cp <= 0x7f)
