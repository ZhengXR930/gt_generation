   284	int _gnutls_idna_email_map(const char *input, unsigned ilen, gnutls_datum_t *output)
   285	{
   286	        const char *p = input;
   287	
   288	        while(*p != 0 && *p != '@') {
   289	                if (!c_isprint(*p))
   290	                        return gnutls_assert_val(GNUTLS_E_INVALID_UTF8_EMAIL);
   291	                p++;
   292	        }
   293	
   294	        if (_gnutls_str_is_print(input, ilen)) {
   295	                return _gnutls_set_strdatum(output, input, ilen);
   296	        }
   297	
   298	        if (*p == '@') {
   299	                unsigned name_part = p-input;
   300	                int ret;
   301	                gnutls_datum_t domain;
