    88	_idn2_u8_to_u32_nfc (const uint8_t * src, size_t srclen,
    89	                     uint32_t ** out, size_t * outlen, int nfc)
    90	{
    91	  uint32_t *p;
    92	  size_t plen;
    93	
    94	  p = u8_to_u32 (src, srclen, NULL, &plen);
    95	  if (p == NULL)
