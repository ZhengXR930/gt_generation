   145	static int idn2_to_unicode_8z8z(const char *src, char **dst, unsigned flags)
   146	{
   147	        int rc, run;
   148	        size_t out_len = 0;
   149	        const char *e, *s;
   150	        char *p = NULL;
   151	
   152	        for (run = 0; run < 2; run++) {
   153	                if (run) {
