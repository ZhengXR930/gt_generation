   437	_u8_memmem (uint8_t * haystack, size_t hlen, uint8_t * needle, size_t nlen)
   438	{
   439	  uint8_t *p;
   440	
   441	  if (nlen == 0)
   442	    return haystack;
   443	
   444	  for (p = haystack; hlen >= nlen; p++, hlen--)
   445	    {
   446	      if (*p == *needle && (nlen == 1 || memcmp (p, needle, nlen) == 0))
