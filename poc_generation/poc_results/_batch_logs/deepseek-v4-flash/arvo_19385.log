   452	_PUBLIC_ enum ndr_err_code ndr_push_string_array(struct ndr_push *ndr, int ndr_flags, const char **a)
   453	{
   454	        uint32_t count;
   455	        unsigned flags = ndr->flags;
   456	        unsigned saved_flags = ndr->flags;
   457	
   458	        if (!(ndr_flags & NDR_SCALARS)) {
   459	                return NDR_ERR_SUCCESS;
   460	        }
   461	
   462	        switch (flags & LIBNDR_STRING_FLAGS) {
   463	        case LIBNDR_FLAG_STR_NULLTERM:
   464	                for (count = 0; a && a[count]; count++) {
   465	                        NDR_CHECK(ndr_push_string(ndr, ndr_flags, a[count]));
