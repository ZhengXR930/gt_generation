   387	                        }
   388	                        ndr->current_mem_ctx = tmp_ctx;
   389	                        if (strcmp("", s)==0) {
   390	                                a[count] = NULL;
   391	                                break;
   392	                        } else {
   393	                                a[count] = s;
   394	                        }
