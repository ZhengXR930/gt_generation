#include <haproxy/cfgparse.h>

#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  struct cfgfile dummy_cfg = {
      .filename = "fuzzer",
      .content = (const char *)data,
      .size = size,
  };
  if (size < 50)
    return 0;

  parse_cfg(&dummy_cfg);
  return 0;
}
