        void (*assignBytes)(Layer &layer, uint i, uint j);

        Layer(void) : name(nullptr) {}
        ~Layer(void)
        {
            delete[] name;
        }

        Layer(const Layer &) = delete;
        Layer &operator=(const Layer &) = delete;
    };

