        shift();
        if (buf1.isEOF() || buf1.isError()) {
          if (strict && buf1.isError()) goto err;
          break;
        }
        Object obj2 = getObj(false, fileKey, encAlgorithm, keyLength, objNum, objGen, recursion + 1);
        if (unlikely(obj2.isError() && recursion + 1 >= recursionLimit)) {
