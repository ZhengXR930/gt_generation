   331	  struct Tally 
   332	  {
   333	    int size;
   334	    Uni32 mask;
   335	    int max;
   336	    int * data;
   337	    Tally(int s, int * d) : size(s), mask(s - 1), max(0), data(d) {
   338	      memset(data, 0, sizeof(int)*size);
   339	    }
   340	    void add(Uni32 chr) {
