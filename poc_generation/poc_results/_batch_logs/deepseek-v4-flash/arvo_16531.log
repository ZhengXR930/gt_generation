   156	// Returns -1 on error, or the number of bytes consumed from the config string
   157	// otherwise.
   158	int parse_config(AspellConfig *spell_config,
   159	                 uint8_t *config,
   160	                 size_t config_len)
   161	{
   162	  uint8_t line[MAX_CONFIG_LEN];
   163	
   164	  uint8_t *config_ptr = config;
   165	  size_t config_ptr_used = 0;
   166	
   167	  uint8_t *delimiter;
   168	
   169	  // Iterate over the lines.
   170	  for (delimiter = (uint8_t *)memchr(config_ptr,
   171	                                     '\n',
   172	                                     config_len - config_ptr_used);
   173	       delimiter != NULL;
   174	       delimiter = (uint8_t *)memchr(config_ptr,
   175	                                     '\n',
   176	                                     config_len - config_ptr_used))
   177	  {
   178	    int line_len = delimiter - config_ptr;
   179	
   180	    if (line_len == 0) {
   181	      // The line is zero-length; it's the end of configuration. Skip over the
   182	      // delimiter and break out.
   183	      FUZZ_DEBUG("Breaking out of config");
   184	      config_ptr++;
   185	      config_ptr_used++;
   186	      break;
   187	    }
   188	
   189	    // Copy the line into the line array. Replace the newline by a null.
   190	    memcpy(line, config_ptr, line_len);
   191	    line[line_len] = 0;
   192	
   193	    // Try and split the line by =.
   194	    uint8_t *kv_delim = (uint8_t *)memchr(line, '=', line_len);
   195	
   196	    if (kv_delim == NULL) {
   197	      // Can't split as a k/v pair. Exit early.
   198	      return -1;
   199	    }
   200	
   201	    // Convert the line into a key, value pair.
   202	    kv_delim[0] = 0;
   203	
   204	    char *keyword = reinterpret_cast<char *>(line);
   205	    char *value = reinterpret_cast<char *>(kv_delim + 1);
   206	
   207	    FUZZ_DEBUG("Key: %s; Value: %s", keyword, value);
   208	    int ok = aspell_config_replace(spell_config, keyword, value);
   209	    if (!ok) {
   210	      // Log any errors and continue.
   211	      FUZZ_DEBUG("Config error from aspell_config_replace: %s",
   212	                 aspell_config_error_message(spell_config));
   213	    }
   214	
   215	    // Advance the config pointers.  Make sure to add 1 for the delimiter.
   216	    config_ptr += (line_len + 1);
   217	    config_ptr_used += (line_len + 1);
   218	  }
   219	
   220	  // Return how much data  was used.
   221	  FUZZ_DEBUG("Used %zu bytes of configuration data", config_ptr_used);
   222	
   223	  return config_ptr_used;
   224	}
