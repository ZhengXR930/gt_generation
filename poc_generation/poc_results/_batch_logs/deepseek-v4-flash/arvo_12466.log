#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "archive.h"

struct Buffer {
  const uint8_t *buf;
  size_t len;
};

ssize_t reader_callback(struct archive *a, void *client_data,
                        const void **block) {
  struct Buffer *buffer = (struct Buffer *)client_data;
  *block = buffer->buf;
  ssize_t len = buffer->len;
  buffer->len = 0;
  return len;
}

int main(int argc, char **argv) {
  if (argc < 2) {
    fprintf(stderr, "Usage: %s <poc_file>\n", argv[0]);
    return 1;
  }

  FILE *f = fopen(argv[1], "rb");
  if (!f) {
    fprintf(stderr, "Cannot open %s\n", argv[1]);
    return 1;
  }
  fseek(f, 0, SEEK_END);
  long len = ftell(f);
  fseek(f, 0, SEEK_SET);
  uint8_t *buf = (uint8_t *)malloc(len);
  fread(buf, 1, len, f);
  fclose(f);

  struct archive *a = archive_read_new();
  archive_read_support_filter_all(a);
  archive_read_support_format_all(a);

  struct Buffer buffer = {buf, (size_t)len};
  int r = archive_read_open(a, &buffer, NULL, reader_callback, NULL);
  printf("archive_read_open returned: %d\n", r);
  if (r != ARCHIVE_OK) {
    printf("Error: %s\n", archive_error_string(a));
    archive_read_free(a);
    free(buf);
    return 1;
  }

  struct archive_entry *entry;
  r = archive_read_next_header(a, &entry);
  printf("archive_read_next_header returned: %d\n", r);
  if (r != ARCHIVE_OK) {
    printf("Error: %s\n", archive_error_string(a));
  } else {
    printf("Found entry: %s\n", archive_entry_pathname(entry));
    char data_buffer[4096];
    while ((r = archive_read_data(a, data_buffer, sizeof(data_buffer))) > 0) {
      printf("Read %d bytes\n", r);
    }
    printf("archive_read_data returned: %d\n", r);
    if (r < 0) {
      printf("Error: %s\n", archive_error_string(a));
    }
  }

  archive_read_free(a);
  free(buf);
  return 0;
}
EOF
