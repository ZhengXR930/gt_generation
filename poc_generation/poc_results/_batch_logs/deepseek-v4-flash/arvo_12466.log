        *extra_data_size -= hash_size;
    } else {
        archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
                "Unsupported hash type (0x%02x)", (int) hash_type);
        return ARCHIVE_FATAL;
    }

    return ARCHIVE_OK;
}

