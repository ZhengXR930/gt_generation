ssize_t reader_callback(struct archive *a, void *client_data,
                        const void **block) {
  struct Buffer *buffer = (struct Buffer *)client_data;
  *block = buffer->buf;
  ssize_t len = buffer->len;
  buffer->len = 0;
  return len;
}

int main(int argc, char **argv) {
  if (argc < 2) {
