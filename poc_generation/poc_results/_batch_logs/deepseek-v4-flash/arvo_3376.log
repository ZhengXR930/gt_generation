                    length += (cur->GetLength() + sizeof(MeshCoP::Tlv));
                }
            }
        }
    }

    SetCommissioningData(tlvs, length);

exit:

    if (GetNetif().GetMle().GetRole() == OT_DEVICE_ROLE_LEADER)
