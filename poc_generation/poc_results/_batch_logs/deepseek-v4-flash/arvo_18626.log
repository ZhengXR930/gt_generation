   422	static void *lex_config(struct lexer *lexer)
   423	{
   424	    while (true) {
   425	        int chr = next(lexer);
   426	
   427	        if (chr == '\0')
   428	            break;
   429	
   430	        if (chr == '\n') {
   431	            emit(lexer, LEXEME_LINEFEED);
   432	            return lex_config;
   433	        }
   434	
   435	        if (isspace(chr)) {
   436	            ignore(lexer);
   437	            continue;
   438	        }
   439	
   440	        if (chr == '{') {
   441	            emit(lexer, LEXEME_OPEN_BRACKET);
   442	            return lex_config;
   443	        }
   444	
   445	        if (chr == '}') {
   446	            emit(lexer, LEXEME_CLOSE_BRACKET);
   447	            return lex_config;
   448	        }
   449	
   450	        if (chr == '=') {
   451	            emit(lexer, LEXEME_EQUAL);
   452	            return lex_config;
   453	        }
   454	
   455	        if (chr == '#')
   456	            return lex_comment;
   457	
   458	        if (chr == '\'' && !strncmp(lexer->pos, "''", 2))
   459	            return lex_multiline_string;
   460	        if (chr == '"' && !strncmp(lexer->pos, "\"\"", 2))
   461	            return lex_multiline_string;
   462	
   463	        if (chr == '$' && peek(lexer) == '{')
   464	            return lex_variable;
   465	
   466	        if (isstring(chr))
   467	            return lex_string;
   468	
   469	        return lex_error(lexer, "Invalid character");
   470	    }
   471	
   472	    emit(lexer, LEXEME_LINEFEED);
   473	    emit(lexer, LEXEME_EOF);
   474	
   475	    return NULL;
   476	}
