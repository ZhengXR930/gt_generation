    96	unsigned int parse_time_period(const char *str, unsigned int default_value)
    97	{
    98	    unsigned int total = 0;
    99	    unsigned int period;
   100	    char multiplier;
   101	
   102	    if (!str)
   103	        return default_value;
   104	
   105	    while (*str && sscanf(str, "%u%c", &period, &multiplier) == 2) {
   106	        switch (multiplier) {
   107	        case 's': total += period; break;
   108	        case 'm': total += period * ONE_MINUTE; break;
   109	        case 'h': total += period * ONE_HOUR; break;
   110	        case 'd': total += period * ONE_DAY; break;
   111	        case 'w': total += period * ONE_WEEK; break;
   112	        case 'M': total += period * ONE_MONTH; break;
   113	        case 'y': total += period * ONE_YEAR; break;
   114	        default:
   115	            lwan_status_warning("Ignoring unknown multiplier: %c",
   116	                        multiplier);
   117	        }
   118	
   119	        str = (const char *)rawmemchr(str, multiplier) + 1;
   120	    }
   121	
   122	    return total ? total : default_value;
   123	}
