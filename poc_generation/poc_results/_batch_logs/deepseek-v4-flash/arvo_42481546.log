                                iter,
                                salt_size,
                                salt, temp_len, temp);
        else
                /* Should not reach here */
                return gnutls_assert_val(GNUTLS_E_INVALID_REQUEST);

        memcpy(keybuf, temp + temp_len - req_keylen, req_keylen);

        return 0;
}
#endif

