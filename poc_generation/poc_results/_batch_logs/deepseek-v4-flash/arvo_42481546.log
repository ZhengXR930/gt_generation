static void
output_point (const char *name, const struct ecc_curve *ecc,
              const struct ecc_point *p, int use_redc,
              unsigned size, unsigned bits_per_limb)
{
  mpz_t x, y, t;

  mpz_init (x);
  mpz_init (y);
  mpz_init (t);

  if (name)
    printf("static const mp_limb_t %s[%u] = {", name, 2*size);

  if (ecc->use_edwards)
    {
      if (ecc_zero_p (p))
        {
          mpz_set_si (x, 0);
          mpz_set_si (y, 1);
        }
      else if (!mpz_sgn (p->y))
        {
          assert (!mpz_sgn (p->x));
          mpz_set_si (x, 0);
          mpz_set_si (y, -1);
        }
      else
        {
          mpz_invert (x, p->y, ecc->p);
          mpz_mul (x, x, p->x);
          mpz_mul (x, x, ecc->t);
          mpz_mod (x, x, ecc->p);

          mpz_sub_ui (y, p->x, 1);
          mpz_add_ui (t, p->x, 1);
          mpz_invert (t, t, ecc->p);
          mpz_mul (y, y, t);
          mpz_mod (y, y, ecc->p);
        }
    }
  else
    {
      mpz_set (x, p->x);
      mpz_set (y, p->y);
    }
  if (use_redc)
    {
      mpz_mul_2exp (x, x, size * bits_per_limb);
      mpz_mod (x, x, ecc->p);
      mpz_mul_2exp (y, y, size * bits_per_limb);
      mpz_mod (y, y, ecc->p);
    }

  output_digits (x, size, bits_per_limb);
  output_digits (y, size, bits_per_limb);

  if (name)
    printf("\n};\n");
