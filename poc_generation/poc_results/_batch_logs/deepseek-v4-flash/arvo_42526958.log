                        indent, i,
                        left >  0? (unsigned char)b[ 0] : 0,
                        left >  1? (unsigned char)b[ 1] : 0,
                        left >  2? (unsigned char)b[ 2] : 0,
                        left >  3? (unsigned char)b[ 3] : 0,
