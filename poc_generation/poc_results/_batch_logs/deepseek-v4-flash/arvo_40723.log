      default: {
        pn_data_clear(msg->body);
        pn_data_decode(msg->body, msg_bytes.start, msg_bytes.size);
        pn_data_rewind(msg->body);
        break;
      }
    }
    msg_bytes = (pn_bytes_t){.size=msg_bytes.size-section_size, .start=msg_bytes.start+section_size};
  }
  return 0;
}
