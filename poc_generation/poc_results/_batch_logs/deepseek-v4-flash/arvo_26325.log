   306	void flb_parser_destroy(struct flb_parser *parser)
   307	{
   308	    int i = 0;
   309	    if (parser->type == FLB_PARSER_REGEX) {
   310	        flb_regex_destroy(parser->regex);
   311	        flb_free(parser->p_regex);
   312	    }
   313	
   314	    flb_free(parser->name);
   315	    if (parser->time_fmt) {
   316	        flb_free(parser->time_fmt);
   317	        flb_free(parser->time_fmt_full);
   318	    }
   319	    if (parser->time_fmt_year) {
   320	        flb_free(parser->time_fmt_year);
   321	    }
   322	    if (parser->time_key) {
   323	        flb_free(parser->time_key);
   324	    }
   325	    if (parser->types_len != 0) {
   326	        for (i=0; i<parser->types_len; i++){
   327	            flb_free(parser->types[i].key);
   328	        }
   329	        flb_free(parser->types);
   330	    }
   331	
   332	    if (parser->decoders) {
   333	        flb_parser_decoder_list_destroy(parser->decoders);
   334	    }
   335	
   336	    mk_list_del(&parser->_head);
   337	    flb_free(parser);
   338	}
