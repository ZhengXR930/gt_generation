   508	        if (!format) {
   509	            flb_error("[parser] no parser 'format' found for '%s' in file '%s'",
   510	                      name, cfg);
   511	            goto fconf_error;
   512	        }
   513	
   514	        /* Regex (if 'format' == 'regex') */
   515	        regex = get_parser_key("Regex", config, section);
   516	        if (!regex && strcmp(format, "regex") == 0) {
   517	            flb_error("[parser] no parser 'regex' found for '%s' in file '%s", name, cfg);
