   526	
   527	        /* Time_Keep */
   528	        time_keep = FLB_FALSE;
   529	        tmp_str = get_parser_key("Time_Keep", config, section);
   530	        if (tmp_str) {
   531	            time_keep = flb_utils_bool(tmp_str);
   532	            flb_sds_destroy(tmp_str);
   533	        }
   534	
   535	        /* Time_Offset (UTC offset) */
   536	        time_offset = get_parser_key("Time_Offset", config, section);
   537	
   538	        /* Types */
   539	        types_str = get_parser_key("Types", config, section);
