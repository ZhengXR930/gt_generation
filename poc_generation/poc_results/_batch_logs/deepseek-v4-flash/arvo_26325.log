   413	    tmp = mk_rconf_section_get_key(section, key, MK_RCONF_STR);
   414	    if (!tmp) {
   415	        return NULL;
   416	    }
   417	
   418	    val = flb_env_var_translate(config->env, tmp);
   419	    flb_free(tmp);
   420	
   421	    if (!val) {
   422	        return NULL;
   423	    }
   424	
   425	    if (flb_sds_len(val) == 0) {
   426	        flb_sds_destroy(val);
   427	        return NULL;
   428	    }
   429	
   430	    return val;
   431	}
