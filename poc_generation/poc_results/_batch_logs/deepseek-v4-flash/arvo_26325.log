   352	static int proc_types_str(const char *types_str, struct flb_parser_types **types)
   353	{
   354	    int i = 0;
   355	    int types_num = 0;
   356	    char *type_str = NULL;
   357	    size_t len;
   358	    struct mk_list *split;
   359	    struct mk_list *head;
   360	    struct flb_split_entry *sentry;
   361	
   362	    split = flb_utils_split(types_str, ' ', 256);
   363	    types_num = mk_list_size(split);
   364	    *types = flb_malloc(sizeof(struct flb_parser_types) * types_num);
   365	
   366	    for(i=0; i<types_num; i++){
   367	        (*types)[i].key = NULL;
   368	        (*types)[i].type = FLB_PARSER_TYPE_STRING;
   369	    }
   370	    i = 0;
   371	    mk_list_foreach(head ,split) {
   372	        sentry = mk_list_entry(head, struct flb_split_entry ,_head);
   373	        type_str = strchr(sentry->value ,':');
   374	
   375	        if (type_str == NULL) {
   376	            i++;
   377	            continue;
   378	        }
   379	        len = type_str - sentry->value;
   380	        (*types)[i].key = flb_strndup(sentry->value, len);
   381	        (*types)[i].key_len = len;
   382	
   383	        type_str++;
   384	        if (!strcasecmp(type_str, "integer")) {
   385	            (*types)[i].type = FLB_PARSER_TYPE_INT;
   386	        }
   387	        else if(!strcasecmp(type_str, "bool")) {
   388	            (*types)[i].type = FLB_PARSER_TYPE_BOOL;
   389	        }
   390	        else if(!strcasecmp(type_str, "float")){
   391	            (*types)[i].type = FLB_PARSER_TYPE_FLOAT;
   392	        }
   393	        else if(!strcasecmp(type_str, "hex")){
   394	            (*types)[i].type = FLB_PARSER_TYPE_HEX;
   395	        }
   396	        else {
   397	            (*types)[i].type = FLB_PARSER_TYPE_STRING;
   398	        }
   399	        i++;
   400	    }
   401	    flb_utils_split_free(split);
   402	
   403	    return i;
   404	}
