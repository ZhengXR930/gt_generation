    40	static inline uint32_t digits10(uint64_t v) {
    41	    if (v < 10) return 1;
    42	    if (v < 100) return 2;
    43	    if (v < 1000) return 3;
    44	    if (v < 1000000000000UL) {
    45	        if (v < 100000000UL) {
    46	            if (v < 1000000) {
    47	                if (v < 10000) return 4;
    48	                return 5 + (v >= 100000);
    49	            }
    50	            return 7 + (v >= 10000000UL);
    51	        }
    52	        if (v < 10000000000UL) {
    53	            return 9 + (v >= 1000000000UL);
    54	        }
    55	        return 11 + (v >= 100000000000UL);
    56	    }
    57	    return 12 + digits10(v / 1000000000000UL);
    58	}
    59	
    60	static unsigned u64_to_str(uint64_t value, char* dst) {
    61	    static const char digits[201] =
    62	        "0001020304050607080910111213141516171819"
    63	        "2021222324252627282930313233343536373839"
    64	        "4041424344454647484950515253545556575859"
    65	        "6061626364656667686970717273747576777879"
    66	        "8081828384858687888990919293949596979899";
    67	    uint32_t const length = digits10(value);
    68	    uint32_t next = length - 1;
    69	    while (value >= 100) {
    70	        int const i = (value % 100) * 2;
    71	        value /= 100;
    72	        dst[next] = digits[i + 1];
    73	        dst[next - 1] = digits[i];
    74	        next -= 2;
    75	    }
    76	
    77	    /* Handle last 1-2 digits */
    78	    if (value < 10) {
    79	        dst[next] = '0' + (uint32_t) value;
    80	    } else {
    81	        int i = (uint32_t) value * 2;
    82	        dst[next] = digits[i + 1];
    83	        dst[next - 1] = digits[i];
    84	    }
    85	    return length;
    86	}
