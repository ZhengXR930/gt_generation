import subprocess, itertools, os, sys

# Generate various PG configurations and test them
def test_sam(lines):
    content = '\n'.join(lines) + '\n'
    with open('/tmp/test_pg.sam', 'w') as f:
        f.write(content)
    result = subprocess.run(['/tmp/harness', '/tmp/test_pg.sam'], 
                          capture_output=True, timeout=5)
    return result.returncode, result.stderr.decode()

# Test various scenarios
scenarios = []

# Scenario 1: All PGs with PP to missing programs
for n in range(1, 20):
    lines = ['@HD\tVN:1.6']
    for i in range(n):
        lines.append(f'@PG\tID:P{i}\tPP:X{i}')
    scenarios.append((f'all_missing_pp_{n}', lines))

# Scenario 2: All PGs with no PP
for n in range(1, 20):
    lines = ['@HD\tVN:1.6']
    for i in range(n):
        lines.append(f'@PG\tID:P{i}')
    scenarios.append((f'all_no_pp_{n}', lines))

# Scenario 3: Mixed - some with PP to existing, some with PP to missing
for n in range(1, 20):
    lines = ['@HD\tVN:1.6']
    for i in range(n):
        if i % 2 == 0:
            lines.append(f'@PG\tID:P{i}\tPP:X{i}')
        else:
            lines.append(f'@PG\tID:P{i}\tPP:P{i-1}')
    scenarios.append((f'mixed_{n}', lines))

# Scenario 4: PP to later PG
for n in range(1, 20):
    lines = ['@HD\tVN:1.6']
    for i in range(n):
        if i < n-1:
            lines.append(f'@PG\tID:P{i}\tPP:P{i+1}')
        else:
            lines.append(f'@PG\tID:P{i}')
    scenarios.append((f'pp_to_later_{n}', lines))

# Scenario 5: PP to later PG that has PP to missing
for n in range(1, 20):
    lines = ['@HD\tVN:1.6']
    for i in range(n):
        if i < n-1:
            lines.append(f'@PG\tID:P{i}\tPP:P{i+1}')
        else:
            lines.append(f'@PG\tID:P{i}\tPP:X')
    scenarios.append((f'pp_to_later_missing_{n}', lines))

# Scenario 6: Duplicate IDs
for n in range(1, 20):
    lines = ['@HD\tVN:1.6']
    for i in range(n):
        lines.append(f'@PG\tID:A')
    scenarios.append((f'dup_ids_{n}', lines))

# Scenario 7: Duplicate IDs with PP
for n in range(1, 20):
    lines = ['@HD\tVN:1.6']
    for i in range(n):
        if i == 0:
            lines.append(f'@PG\tID:A')
        else:
            lines.append(f'@PG\tID:A\tPP:B')
    scenarios.append((f'dup_ids_pp_{n}', lines))

# Scenario 8: Chain with PP to missing at various positions
for n in range(1, 20):
    lines = ['@HD\tVN:1.6']
    for i in range(n):
        if i == 0:
            lines.append(f'@PG\tID:P{i}\tPP:X')
        else:
            lines.append(f'@PG\tID:P{i}\tPP:P{i-1}')
    scenarios.append((f'chain_missing_first_{n}', lines))

# Scenario 9: Chain with PP to missing at last position
for n in range(1, 20):
    lines = ['@HD\tVN:1.6']
    for i in range(n):
        if i == n-1:
            lines.append(f'@PG\tID:P{i}\tPP:X')
        else:
            lines.append(f'@PG\tID:P{i}\tPP:P{i+1}')
    scenarios.append((f'chain_missing_last_{n}', lines))

# Scenario 10: Multiple chains, all with PP to missing
for n in range(1, 20):
    lines = ['@HD\tVN:1.6']
    for i in range(n):
        lines.append(f'@PG\tID:P{i}\tPP:X{i}')
    scenarios.append((f'multi_chain_missing_{n}', lines))

for name, lines in scenarios:
    rc, err = test_sam(lines)
    if rc != 0:
        print(f"CRASH: {name} rc={rc}")
        print(f"  Lines: {lines}")
        print(f"  Error: {err[:500]}")
        sys.exit(0)

print("No crash found in basic scenarios")
