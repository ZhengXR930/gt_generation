   184	  /* This is reference implementation from the spec. */
   185	  static inline uint32_t CalcTableChecksum (const HBUINT32 *Table, uint32_t Length)
   186	  {
   187	    uint32_t Sum = 0L;
   188	    assert (0 == (Length & 3));
   189	    const HBUINT32 *EndPtr = Table + Length / HBUINT32::static_size;
   190	
   191	    while (Table < EndPtr)
   192	      Sum += *Table++;
   193	    return Sum;
   194	  }
   195	
   196	  /* Note: data should be 4byte aligned and have 4byte padding at the end. */
   197	  inline void set_for_data (const void *data, unsigned int length)
   198	  { set (CalcTableChecksum ((const HBUINT32 *) data, length)); }
