   437	template <typename EntryData>
   438	struct StateTableDriver
   439	{
   440	  inline StateTableDriver (const StateTable<EntryData> &machine_,
   441	                           hb_buffer_t *buffer_,
   442	                           hb_face_t *face_) :
   443	              machine (machine_),
   444	              buffer (buffer_),
   445	              num_glyphs (face_->get_num_glyphs ()) {}
   446	
   447	  template <typename context_t>
   448	  inline void drive (context_t *c)
   449	  {
   450	    if (!c->in_place)
   451	      buffer->clear_output ();
   452	
   453	    unsigned int state = StateTable<EntryData>::STATE_START_OF_TEXT;
   454	    bool last_was_dont_advance = false;
   455	    for (buffer->idx = 0;;)
   456	    {
   457	      unsigned int klass = buffer->idx < buffer->len ?
   458	                           machine.get_class (buffer->info[buffer->idx].codepoint, num_glyphs) :
   459	                           (unsigned) StateTable<EntryData>::CLASS_END_OF_TEXT;
   460	      const Entry<EntryData> *entry = machine.get_entryZ (state, klass);
   461	      if (unlikely (!entry))
   462	        break;
   463	
   464	      /* Unsafe-to-break before this if not in state 0, as things might
   465	       * go differently if we start from state 0 here.
   466	       *
   467	       * Ugh.  The indexing here is ugly... */
   468	      if (state && buffer->backtrack_len () && buffer->idx < buffer->len)
   469	      {
   470	        /* If there's no action and we're just epsilon-transitioning to state 0,
   471	         * safe to break. */
   472	        if (c->is_actionable (this, entry) ||
   473	            !(entry->newState == StateTable<EntryData>::STATE_START_OF_TEXT &&
   474	              entry->flags == context_t::DontAdvance))
   475	          buffer->unsafe_to_break_from_outbuffer (buffer->backtrack_len () - 1, buffer->idx + 1);
   476	      }
   477	
   478	      /* Unsafe-to-break if end-of-text would kick in here. */
   479	      if (buffer->idx + 2 <= buffer->len)
   480	      {
   481	        const Entry<EntryData> *end_entry = machine.get_entryZ (state, 0);
   482	        if (c->is_actionable (this, end_entry))
   483	          buffer->unsafe_to_break (buffer->idx, buffer->idx + 2);
   484	      }
   485	
   486	      if (unlikely (!c->transition (this, entry)))
   487	        break;
   488	
   489	      if (unlikely (!buffer->successful)) return;
   490	
   491	      last_was_dont_advance = (entry->flags & context_t::DontAdvance) && buffer->max_ops-- > 0;
   492	
   493	      state = entry->newState;
   494	
   495	      if (buffer->idx == buffer->len)
   496	        break;
   497	
   498	      if (!last_was_dont_advance)
   499	        buffer->next_glyph ();
   500	    }
   501	
   502	    if (!c->in_place)
   503	    {
   504	      for (; buffer->idx < buffer->len;)
   505	        buffer->next_glyph ();
   506	      buffer->swap_buffers ();
   507	    }
   508	  }
   509	
   510	  public:
   511	  const StateTable<EntryData> &machine;
   512	  hb_buffer_t *buffer;
   513	  unsigned int num_glyphs;
   514	};
