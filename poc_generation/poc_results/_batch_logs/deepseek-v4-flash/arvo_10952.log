   340	template <typename Extra>
   341	struct StateTable
   342	{
   343	  enum State
   344	  {
   345	    STATE_START_OF_TEXT = 0,
   346	    STATE_START_OF_LINE = 1,
   347	  };
   348	  enum Class
   349	  {
   350	    CLASS_END_OF_TEXT = 0,
   351	    CLASS_OUT_OF_BOUNDS = 1,
   352	    CLASS_DELETED_GLYPH = 2,
   353	    CLASS_END_OF_LINE = 3,
   354	  };
   355	
   356	  inline unsigned int get_class (hb_codepoint_t glyph_id, unsigned int num_glyphs) const
   357	  {
   358	    const HBUINT16 *v = (this+classTable).get_value (glyph_id, num_glyphs);
   359	    return v ? (unsigned) *v : (unsigned) CLASS_OUT_OF_BOUNDS;
   360	  }
   361	
   362	  inline const Entry<Extra> *get_entries () const
   363	  {
   364	    return (this+entryTable).arrayZ;
   365	  }
   366	
   367	  inline const Entry<Extra> *get_entryZ (unsigned int state, unsigned int klass) const
   368	  {
   369	    if (unlikely (klass >= nClasses)) return nullptr;
   370	
   371	    const HBUINT16 *states = (this+stateArrayTable).arrayZ;
   372	    const Entry<Extra> *entries = (this+entryTable).arrayZ;
   373	
   374	    unsigned int entry = states[state * nClasses + klass];
   375	
   376	    return &entries[entry];
   377	  }
   378	
   379	  inline bool sanitize (hb_sanitize_context_t *c,
   380	                        unsigned int *num_entries_out = nullptr) const
   381	  {
   382	    TRACE_SANITIZE (this);
   383	    if (unlikely (!(c->check_struct (this) &&
   384	                    classTable.sanitize (c, this)))) return_trace (false);
   385	
   386	    const HBUINT16 *states = (this+stateArrayTable).arrayZ;
   387	    const Entry<Extra> *entries = (this+entryTable).arrayZ;
   388	
   389	    unsigned int num_states = 1;
   390	    unsigned int num_entries = 0;
   391	
   392	    unsigned int state = 0;
   393	    unsigned int entry = 0;
   394	    while (state < num_states)
   395	    {
   396	      if (unlikely (!c->check_array (states,
   397	                                     num_states,
   398	                                     states[0].static_size * nClasses)))
   399	        return_trace (false);
   400	      { /* Sweep new states. */
   401	        const HBUINT16 *stop = &states[num_states * nClasses];
   402	        for (const HBUINT16 *p = &states[state * nClasses]; p < stop; p++)
   403	          num_entries = MAX<unsigned int> (num_entries, *p + 1);
   404	        state = num_states;
   405	      }
   406	
   407	      if (unlikely (!c->check_array (entries, num_entries)))
   408	        return_trace (false);
   409	      { /* Sweep new entries. */
   410	        const Entry<Extra> *stop = &entries[num_entries];
   411	        for (const Entry<Extra> *p = &entries[entry]; p < stop; p++)
   412	          num_states = MAX<unsigned int> (num_states, p->newState + 1);
   413	        entry = num_entries;
   414	      }
   415	    }
   416	
   417	    if (num_entries_out)
   418	      *num_entries_out = num_entries;
   419	
   420	    return_trace (true);
   421	  }
   422	
   423	  protected:
   424	  HBUINT32      nClasses;       /* Number of classes, which is the number of indices
   425	                                 * in a single line in the state array. */
   426	  LOffsetTo<Lookup<HBUINT16>, false>
   427	                classTable;     /* Offset to the class table. */
   428	  LOffsetTo<UnsizedArrayOf<HBUINT16>, false>
   429	                stateArrayTable;/* Offset to the state array. */
   430	  LOffsetTo<UnsizedArrayOf<Entry<Extra> >, false>
   431	                entryTable;     /* Offset to the entry array. */
   432	
   433	  public:
   434	  DEFINE_SIZE_STATIC (16);
   435	};
