#include <fmt/format.h>
#include <cstring>
#include <vector>
#include <iostream>

// Test format strings where the fill char is a multi-byte char that
// extends to the very end of the buffer, and the align char is the
// LAST byte. The key: the fill char's continuation bytes run up to
// the last byte, and the align char is at the last byte.
void test(const std::vector<char>& fmtbuf) {
  fmt::string_view fmtstr(fmtbuf.data(), fmtbuf.size());
  try {
    fmt::memory_buffer out;
    fmt::format_to(out, fmtstr, fmt::arg("x", 42));
    std::cout << "ok\n";
  } catch (std::exception& e) {
    std::cout << "exception: " << e.what() << "\n";
  }
}

int main() {
  // The critical case: fill char is a multi-byte char whose continuation
  // bytes extend to the very end of the buffer, and the align char is
  // the LAST byte. e.g. "{:\xE0\x80>" - 2-byte fill then '>' at end
  // Here next_code_point(begin=0xE0, end) advances: begin->0x80, then
  // begin->'>' (not continuation), returns pointer to '>'. p != begin.
  // handler.on_fill(begin, p-begin=2). Then begin = p+1 = end. OK.
  std::vector<char> f1 = {'{', ':', (char)0xE0, (char)0x80, '>'};
  test(f1);
  // "{:\xE0\x80\x80>" - 3-byte fill then '>' at end
  std::vector<char> f2 = {'{', ':', (char)0xE0, (char)0x80, (char)0x80, '>'};
  test(f2);
  // "{:\xE0\x80\x80\x80>" - 4-byte fill then '>' at end
  std::vector<char> f3 = {'{', ':', (char)0xE0, (char)0x80, (char)0x80, (char)0x80, '>'};
  test(f3);
  // "{:\xE0\x80\x80\x80\x80>" - 5-byte fill then '>' at end
  std::vector<char> f4 = {'{', ':', (char)0xE0, (char)0x80, (char)0x80, (char)0x80, (char)0x80, '>'};
  test(f4);
  return 0;
}
