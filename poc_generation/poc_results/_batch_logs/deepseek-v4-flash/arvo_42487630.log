#include <fmt/format.h>
#include <cstring>
#include <vector>
#include <iostream>

// Test format strings where the fill char is a multi-byte char that
// extends to the very end of the buffer, and the align char is the
// LAST byte. The key: the fill char's continuation bytes run up to
// the last byte, and the align char is at the last byte.
void test(const std::vector<char>& fmtbuf) {
  fmt::string_view fmtstr(fmtbuf.data(), fmtbuf.size());
