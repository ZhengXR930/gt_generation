#include <fmt/chrono.h>
#include <fmt/core.h>
#include <cstdint>
#include <cstring>
#include <vector>
#include <random>
#include <iostream>
#include "test/fuzzing/fuzzer_common.h"

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* Data, size_t Size);

int main() {
  std::mt19937 rng(12345);
  for (int trial = 0; trial < 2000000; ++trial) {
    // random size
    size_t size = 4 + rng() % 30;
    std::vector<uint8_t> data(size);
    for (auto& b : data) {
      int r = rng() % 100;
      if (r < 40) b = 0x20 + rng() % 0x5f;  // ascii
      else if (r < 80) b = 0x80 + rng() % 0x80;  // high bytes
      else b = rng() % 256;
    }
    // bias first byte to valid type/argsize
    data[0] = (rng() % 13) | ((1 + rng() % 14) << 4);
    LLVMFuzzerTestOneInput(data.data(), data.size());
