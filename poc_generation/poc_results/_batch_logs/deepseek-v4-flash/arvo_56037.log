}

static int fuzzer_subtransport_new(
        struct fuzzer_subtransport **out,
        git_transport *owner,
        const struct fuzzer_buffer *data)
{
        struct fuzzer_subtransport *sub = malloc(sizeof(*sub));
        if (!sub)
