int gitno__match_host(const char *pattern, const char *host)
{
        for (;;) {
                char c = git__tolower(*pattern++);

                if (c == '\0')
                        return *host ? -1 : 0;

                if (c == '*') {
                        c = *pattern;
                        /* '*' at the end matches everything left */
                        if (c == '\0')
                                return 0;
