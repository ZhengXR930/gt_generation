    aiAttachLogStream(&stream);

    Importer importer;
    const aiScene *sc = importer.ReadFileFromMemory(data.data(), data.size(),
        aiProcessPreset_TargetRealtime_Quality, nullptr );

    aiDetachLogStream(&stream);
    return 0;
}
