        char last_fg, last_bg;

        str = g_string_new(NULL);

        last_fg = last_bg = '\0';
        while (*format != '\0') {
                if (*format == '$') {
                        /* $variable, skrip it entirely */
                        theme_format_append_variable(str, &format);
                        last_fg = last_bg = '\0';
                } else if (*format != '%') {
                        /* a normal character */
                        g_string_append_c(str, *format);
                        format++;
                } else if (format[1] != '\0') {
                        /* %format */
                        format++;
                        if (IS_OLD_FORMAT(*format, last_fg, last_bg)) {
