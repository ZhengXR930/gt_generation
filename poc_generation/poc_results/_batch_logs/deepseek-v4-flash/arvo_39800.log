                if (memcmp(buf+3,URN_SERVICE_STR,URN_SERVICE_STR_LEN) == 0) {
                        type=URN_SERVICE_URI_T;
                }
                else if (memcmp(buf+3,URN_NENA_SERVICE_STR,URN_NENA_SERVICE_STR_LEN) == 0) {
                        type=URN_NENA_SERVICE_URI_T;
                }
        }
        return type;
}

