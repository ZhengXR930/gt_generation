    82	  if (aptr + RRFIXEDSZ > abuf + alen)
    83	    goto failed;
    84	  aptr += RRFIXEDSZ;
    85	
    86	  /* allocate result struct */
    87	  soa = ares_malloc_data(ARES_DATATYPE_SOA_REPLY);
    88	  if (!soa)
