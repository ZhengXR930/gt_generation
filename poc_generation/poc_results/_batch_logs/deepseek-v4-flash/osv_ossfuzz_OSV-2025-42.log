        ut8 magic[4];
        ut32 rev;
        ut32 entry;
        ut32 data_start;
        ut32 data_end;
        ut32 bss_end;
        ut32 stack_size;
        ut32 reloc_start;
        ut32 reloc_count;
        ut32 flags;
