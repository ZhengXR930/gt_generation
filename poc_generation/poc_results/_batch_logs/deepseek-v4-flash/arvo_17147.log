    45	MessagePool::MessagePool(Instance &aInstance)
    46	    : InstanceLocator(aInstance)
    47	{
    48	#if OPENTHREAD_CONFIG_PLATFORM_MESSAGE_MANAGEMENT
    49	    // Initialize Platform buffer pool management.
    50	    otPlatMessagePoolInit(&GetInstance(), kNumBuffers, sizeof(Buffer));
    51	#else
    52	    memset(mBuffers, 0, sizeof(mBuffers));
    53	
    54	    mFreeBuffers = mBuffers;
    55	
    56	    for (uint16_t i = 0; i < kNumBuffers - 1; i++)
    57	    {
    58	        mBuffers[i].SetNextBuffer(&mBuffers[i + 1]);
    59	    }
    60	
    61	    mBuffers[kNumBuffers - 1].SetNextBuffer(NULL);
    62	    mNumFreeBuffers = kNumBuffers;
    63	#endif
    64	}
