   241	Message *Message::GetNext(void) const
   242	{
   243	    Message *next;
   244	    Message *tail;
   245	
   246	    if (mBuffer.mHead.mInfo.mInPriorityQ)
   247	    {
   248	        PriorityQueue *priorityQueue = GetPriorityQueue();
   249	        VerifyOrExit(priorityQueue != NULL, next = NULL);
   250	        tail = priorityQueue->GetTail();
   251	    }
   252	    else
   253	    {
   254	        MessageQueue *messageQueue = GetMessageQueue();
   255	        VerifyOrExit(messageQueue != NULL, next = NULL);
   256	        tail = messageQueue->GetTail();
   257	    }
   258	
   259	    next = (this == tail) ? NULL : Next();
   260	
   261	exit:
   262	    return next;
   263	}
   264	
   265	otError Message::SetLength(uint16_t aLength)
   266	{
   267	    otError  error              = OT_ERROR_NONE;
   268	    uint16_t totalLengthRequest = GetReserved() + aLength;
   269	    uint16_t totalLengthCurrent = GetReserved() + GetLength();
   270	    int      bufs               = 0;
   271	
   272	    VerifyOrExit(totalLengthRequest >= GetReserved(), error = OT_ERROR_INVALID_ARGS);
   273	
   274	    if (totalLengthRequest > kHeadBufferDataSize)
   275	    {
   276	        bufs = (((totalLengthRequest - kHeadBufferDataSize) - 1) / kBufferDataSize) + 1;
   277	    }
   278	
   279	    if (totalLengthCurrent > kHeadBufferDataSize)
   280	    {
   281	        bufs -= (((totalLengthCurrent - kHeadBufferDataSize) - 1) / kBufferDataSize) + 1;
   282	    }
   283	
   284	    SuccessOrExit(error = GetMessagePool()->ReclaimBuffers(bufs, GetPriority()));
   285	
   286	    SuccessOrExit(error = ResizeMessage(totalLengthRequest));
   287	    mBuffer.mHead.mInfo.mLength = aLength;
   288	
   289	    // Correct offset in case shorter length is set.
   290	    if (GetOffset() > aLength)
   291	    {
   292	        SetOffset(aLength);
   293	    }
   294	
   295	exit:
   296	    return error;
   297	}
