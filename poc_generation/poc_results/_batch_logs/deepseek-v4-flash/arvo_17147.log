   362	otError Message::SetPriority(uint8_t aPriority)
   363	{
   364	    otError        error         = OT_ERROR_NONE;
   365	    PriorityQueue *priorityQueue = NULL;
   366	
   367	    VerifyOrExit(aPriority < kNumPriorities, error = OT_ERROR_INVALID_ARGS);
   368	
   369	    VerifyOrExit(IsInAQueue(), mBuffer.mHead.mInfo.mPriority = aPriority);
   370	    VerifyOrExit(mBuffer.mHead.mInfo.mPriority != aPriority);
   371	
   372	    if (mBuffer.mHead.mInfo.mInPriorityQ)
   373	    {
   374	        priorityQueue = mBuffer.mHead.mInfo.mQueue.mPriority;
   375	        priorityQueue->Dequeue(*this);
   376	    }
   377	
   378	    mBuffer.mHead.mInfo.mPriority = aPriority;
   379	
   380	    if (priorityQueue != NULL)
   381	    {
   382	        priorityQueue->Enqueue(*this);
   383	    }
   384	
   385	exit:
   386	    return error;
   387	}
