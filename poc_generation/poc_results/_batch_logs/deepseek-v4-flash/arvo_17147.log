   462	uint16_t Message::Read(uint16_t aOffset, uint16_t aLength, void *aBuf) const
   463	{
   464	    Buffer * curBuffer;
   465	    uint16_t bytesCopied = 0;
   466	    uint16_t bytesToCopy;
   467	
   468	    if (aOffset >= GetLength())
   469	    {
   470	        ExitNow();
   471	    }
   472	
   473	    if (aOffset + aLength >= GetLength())
   474	    {
   475	        aLength = GetLength() - aOffset;
   476	    }
   477	
   478	    aOffset += GetReserved();
   479	
   480	    // special case first buffer
   481	    if (aOffset < kHeadBufferDataSize)
   482	    {
   483	        bytesToCopy = kHeadBufferDataSize - aOffset;
   484	
   485	        if (bytesToCopy > aLength)
   486	        {
   487	            bytesToCopy = aLength;
   488	        }
   489	
   490	        memcpy(aBuf, GetFirstData() + aOffset, bytesToCopy);
   491	
   492	        aLength -= bytesToCopy;
   493	        bytesCopied += bytesToCopy;
   494	        aBuf = static_cast<uint8_t *>(aBuf) + bytesToCopy;
   495	
   496	        aOffset = 0;
   497	    }
   498	    else
   499	    {
   500	        aOffset -= kHeadBufferDataSize;
   501	    }
   502	
   503	    // advance to offset
   504	    curBuffer = GetNextBuffer();
   505	
   506	    while (aOffset >= kBufferDataSize)
   507	    {
   508	        assert(curBuffer != NULL);
   509	
   510	        curBuffer = curBuffer->GetNextBuffer();
   511	        aOffset -= kBufferDataSize;
   512	    }
   513	
   514	    // begin copy
   515	    while (aLength > 0)
   516	    {
   517	        assert(curBuffer != NULL);
   518	
   519	        bytesToCopy = kBufferDataSize - aOffset;
   520	
   521	        if (bytesToCopy > aLength)
   522	        {
   523	            bytesToCopy = aLength;
   524	        }
   525	
   526	        memcpy(aBuf, curBuffer->GetData() + aOffset, bytesToCopy);
   527	
   528	        aLength -= bytesToCopy;
   529	        bytesCopied += bytesToCopy;
   530	        aBuf = static_cast<uint8_t *>(aBuf) + bytesToCopy;
   531	
   532	        curBuffer = curBuffer->GetNextBuffer();
   533	        aOffset   = 0;
   534	    }
   535	
   536	exit:
   537	    return bytesCopied;
   538	}
