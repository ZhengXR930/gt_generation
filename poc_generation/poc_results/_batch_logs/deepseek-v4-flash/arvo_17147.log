   389	otError Message::Append(const void *aBuf, uint16_t aLength)
   390	{
   391	    otError  error     = OT_ERROR_NONE;
   392	    uint16_t oldLength = GetLength();
   393	    int      bytesWritten;
   394	
   395	    SuccessOrExit(error = SetLength(GetLength() + aLength));
   396	    bytesWritten = Write(oldLength, aLength, aBuf);
   397	
   398	    assert(bytesWritten == (int)aLength);
   399	    OT_UNUSED_VARIABLE(bytesWritten);
   400	
   401	exit:
   402	    return error;
   403	}
