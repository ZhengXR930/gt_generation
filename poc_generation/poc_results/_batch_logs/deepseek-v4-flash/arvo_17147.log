   462	        networkInfo.mRloc16              = GetRloc16();
   463	        networkInfo.mPreviousPartitionId = mLeaderData.GetPartitionId();
   464	        networkInfo.mExtAddress          = Get<Mac::Mac>().GetExtAddress();
   465	        memcpy(networkInfo.mMlIid, &mMeshLocal64.GetAddress().mFields.m8[OT_IP6_PREFIX_SIZE], OT_IP6_IID_SIZE);
