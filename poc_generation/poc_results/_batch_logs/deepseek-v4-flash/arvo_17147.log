   125	Buffer *MessagePool::NewBuffer(uint8_t aPriority)
   126	{
   127	    Buffer *buffer = NULL;
   128	
   129	    SuccessOrExit(ReclaimBuffers(1, aPriority));
   130	
   131	#if OPENTHREAD_CONFIG_PLATFORM_MESSAGE_MANAGEMENT
   132	
   133	    buffer = static_cast<Buffer *>(otPlatMessagePoolNew(&GetInstance()));
   134	
   135	#else
   136	
   137	    if (mFreeBuffers != NULL)
   138	    {
   139	        buffer       = mFreeBuffers;
   140	        mFreeBuffers = mFreeBuffers->GetNextBuffer();
   141	        buffer->SetNextBuffer(NULL);
   142	        mNumFreeBuffers--;
   143	    }
   144	
   145	#endif
   146	
   147	    if (buffer == NULL)
   148	    {
   149	        otLogInfoMem("No available message buffer");
   150	    }
   151	
   152	exit:
   153	    return buffer;
   154	}
   155	
   156	void MessagePool::FreeBuffers(Buffer *aBuffer)
   157	{
   158	    while (aBuffer != NULL)
   159	    {
   160	        Buffer *tmpBuffer = aBuffer->GetNextBuffer();
   161	#if OPENTHREAD_CONFIG_PLATFORM_MESSAGE_MANAGEMENT
   162	        otPlatMessagePoolFree(&GetInstance(), aBuffer);
   163	#else  // OPENTHREAD_CONFIG_PLATFORM_MESSAGE_MANAGEMENT
   164	        aBuffer->SetNextBuffer(mFreeBuffers);
   165	        mFreeBuffers = aBuffer;
   166	        mNumFreeBuffers++;
   167	#endif // OPENTHREAD_CONFIG_PLATFORM_MESSAGE_MANAGEMENT
   168	        aBuffer = tmpBuffer;
   169	    }
   170	}
   171	
   172	otError MessagePool::ReclaimBuffers(int aNumBuffers, uint8_t aPriority)
   173	{
   174	#if OPENTHREAD_MTD || OPENTHREAD_FTD
   175	    while (aNumBuffers > GetFreeBufferCount())
   176	    {
   177	        SuccessOrExit(Get<MeshForwarder>().EvictMessage(aPriority));
   178	    }
   179	
   180	exit:
   181	#else  // OPENTHREAD_MTD || OPENTHREAD_FTD
   182	    OT_UNUSED_VARIABLE(aPriority);
   183	#endif // OPENTHREAD_MTD || OPENTHREAD_FTD
   184	
   185	    // First comparison is to get around issues with comparing
   186	    // signed and unsigned numbers, if aNumBuffers is negative then
   187	    // the second comparison wont be attempted.
   188	    return (aNumBuffers < 0 || aNumBuffers <= GetFreeBufferCount()) ? OT_ERROR_NONE : OT_ERROR_NO_BUFS;
   189	}
