   410	otError Message::Prepend(const void *aBuf, uint16_t aLength)
   411	{
   412	    otError error     = OT_ERROR_NONE;
   413	    Buffer *newBuffer = NULL;
   414	
   415	    while (aLength > GetReserved())
   416	    {
   417	        VerifyOrExit((newBuffer = GetMessagePool()->NewBuffer(GetPriority())) != NULL, error = OT_ERROR_NO_BUFS);
   418	
   419	        newBuffer->SetNextBuffer(GetNextBuffer());
   420	        SetNextBuffer(newBuffer);
   421	
   422	        if (GetReserved() < sizeof(mBuffer.mHead.mData))
   423	        {
   424	            // Copy payload from the first buffer.
   425	            memcpy(newBuffer->mBuffer.mHead.mData + GetReserved(), mBuffer.mHead.mData + GetReserved(),
   426	                   sizeof(mBuffer.mHead.mData) - GetReserved());
   427	        }
   428	
   429	        SetReserved(GetReserved() + kBufferDataSize);
   430	    }
   431	
   432	    SetReserved(GetReserved() - aLength);
   433	    mBuffer.mHead.mInfo.mLength += aLength;
   434	    SetOffset(GetOffset() + aLength);
   435	
   436	    if (aBuf != NULL)
   437	    {
   438	        Write(0, aLength, aBuf);
   439	    }
   440	
   441	exit:
   442	    return error;
   443	}
   444	
   445	void Message::RemoveHeader(uint16_t aLength)
   446	{
   447	    assert(aLength <= mBuffer.mHead.mInfo.mLength);
   448	
   449	    mBuffer.mHead.mInfo.mReserved += aLength;
   450	    mBuffer.mHead.mInfo.mLength -= aLength;
   451	
   452	    if (mBuffer.mHead.mInfo.mOffset > aLength)
   453	    {
   454	        mBuffer.mHead.mInfo.mOffset -= aLength;
   455	    }
   456	    else
   457	    {
   458	        mBuffer.mHead.mInfo.mOffset = 0;
   459	    }
   460	}
