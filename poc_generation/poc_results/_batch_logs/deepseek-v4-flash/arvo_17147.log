   238	otError Mle::Start(bool aAnnounceAttach)
   239	{
   240	    otError error = OT_ERROR_NONE;
   241	
   242	    // cannot bring up the interface if IEEE 802.15.4 promiscuous mode is enabled
   243	    VerifyOrExit(!Get<Radio>().GetPromiscuous(), error = OT_ERROR_INVALID_STATE);
   244	    VerifyOrExit(Get<ThreadNetif>().IsUp(), error = OT_ERROR_INVALID_STATE);
   245	
   246	    if (Get<Mac::Mac>().GetPanId() == Mac::kPanIdBroadcast)
   247	    {
   248	        // if PAN ID is not configured, pick a random one to start
   249	
   250	        uint16_t panid;
   251	
   252	        do
   253	        {
   254	            panid = Random::NonCrypto::GetUint16();
   255	        } while (panid == Mac::kPanIdBroadcast);
   256	
   257	        Get<Mac::Mac>().SetPanId(panid);
   258	    }
   259	
   260	    SetStateDetached();
   261	
   262	    ApplyMeshLocalPrefix();
   263	    SetRloc16(GetRloc16());
   264	
   265	    mAttachCounter = 0;
   266	
   267	    Get<KeyManager>().Start();
   268	
   269	    if (!aAnnounceAttach)
   270	    {
   271	        mReattachState = kReattachStart;
   272	    }
   273	
   274	    if (aAnnounceAttach || (GetRloc16() == Mac::kShortAddrInvalid))
   275	    {
   276	        BecomeChild(kAttachAny);
   277	    }
   278	    else if (IsActiveRouter(GetRloc16()))
   279	    {
   280	        if (Get<MleRouter>().BecomeRouter(ThreadStatusTlv::kTooFewRouters) != OT_ERROR_NONE)
   281	        {
   282	            BecomeChild(kAttachAny);
   283	        }
   284	    }
   285	    else
   286	    {
   287	        mChildUpdateAttempts = 0;
   288	        SendChildUpdateRequest();
   289	    }
   290	
   291	exit:
   292	    return error;
   293	}
   294	
   295	void Mle::Stop(bool aClearNetworkDatasets)
   296	{
   297	    if (aClearNetworkDatasets)
   298	    {
   299	        Get<MeshCoP::ActiveDataset>().HandleDetach();
   300	        Get<MeshCoP::PendingDataset>().HandleDetach();
   301	    }
   302	
   303	    VerifyOrExit(mRole != OT_DEVICE_ROLE_DISABLED);
   304	
   305	    Get<KeyManager>().Stop();
   306	    SetStateDetached();
   307	    Get<ThreadNetif>().UnsubscribeMulticast(mRealmLocalAllThreadNodes);
   308	    Get<ThreadNetif>().UnsubscribeMulticast(mLinkLocalAllThreadNodes);
   309	    Get<ThreadNetif>().RemoveUnicastAddress(mMeshLocal16);
   310	    Get<ThreadNetif>().RemoveUnicastAddress(mMeshLocal64);
   311	
   312	    SetRole(OT_DEVICE_ROLE_DISABLED);
   313	
   314	exit:
   315	    return;
   316	}
   317	
   318	void Mle::SetRole(otDeviceRole aRole)
   319	{
   320	    VerifyOrExit(aRole != mRole, Get<Notifier>().SignalIfFirst(OT_CHANGED_THREAD_ROLE));
   321	
   322	    otLogNoteMle("Role %s -> %s", RoleToString(mRole), RoleToString(aRole));
   323	
   324	    mRole = aRole;
   325	    Get<Notifier>().Signal(OT_CHANGED_THREAD_ROLE);
   326	
   327	    switch (mRole)
   328	    {
   329	    case OT_DEVICE_ROLE_DISABLED:
   330	        mCounters.mDisabledRole++;
   331	        break;
   332	    case OT_DEVICE_ROLE_DETACHED:
   333	        mCounters.mDetachedRole++;
   334	        break;
   335	    case OT_DEVICE_ROLE_CHILD:
   336	        mCounters.mChildRole++;
   337	        break;
   338	    case OT_DEVICE_ROLE_ROUTER:
   339	        mCounters.mRouterRole++;
   340	        break;
   341	    case OT_DEVICE_ROLE_LEADER:
   342	        mCounters.mLeaderRole++;
   343	        break;
   344	    }
   345	
   346	#if OPENTHREAD_CONFIG_BORDER_AGENT_ENABLE
   347	    if (IsAttached())
   348	    {
   349	        SuccessOrExit(Get<MeshCoP::BorderAgent>().Start());
   350	    }
   351	    else
   352	    {
   353	        SuccessOrExit(Get<MeshCoP::BorderAgent>().Stop());
   354	    }
   355	#endif
   356	
   357	exit:
   358	    return;
   359	}
