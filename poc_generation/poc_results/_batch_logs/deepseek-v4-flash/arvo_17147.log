   448	otError Mle::Store(void)
   449	{
   450	    otError               error = OT_ERROR_NONE;
   451	    Settings::NetworkInfo networkInfo;
   452	
   453	    memset(&networkInfo, 0, sizeof(networkInfo));
   454	
   455	    if (IsAttached())
   456	    {
   457	        // Only update network information while we are attached to
   458	        // avoid losing/overwriting previous information when a reboot
   459	        // occurs after a message is sent but before attaching.
