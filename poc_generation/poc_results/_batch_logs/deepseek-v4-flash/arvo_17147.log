   371	otError Mle::Restore(void)
   372	{
   373	    otError               error = OT_ERROR_NONE;
   374	    Settings::NetworkInfo networkInfo;
   375	    Settings::ParentInfo  parentInfo;
   376	
   377	    Get<MeshCoP::ActiveDataset>().Restore();
   378	    Get<MeshCoP::PendingDataset>().Restore();
   379	
   380	    SuccessOrExit(error = Get<Settings>().ReadNetworkInfo(networkInfo));
   381	
   382	    Get<KeyManager>().SetCurrentKeySequence(networkInfo.mKeySequence);
   383	    Get<KeyManager>().SetMleFrameCounter(networkInfo.mMleFrameCounter);
   384	    Get<KeyManager>().SetMacFrameCounter(networkInfo.mMacFrameCounter);
   385	    mDeviceMode.Set(networkInfo.mDeviceMode);
   386	
   387	    switch (networkInfo.mRole)
   388	    {
   389	    case OT_DEVICE_ROLE_CHILD:
   390	    case OT_DEVICE_ROLE_ROUTER:
   391	    case OT_DEVICE_ROLE_LEADER:
   392	        break;
   393	
   394	    default:
   395	        ExitNow();
   396	    }
   397	
   398	    Get<Mac::Mac>().SetShortAddress(networkInfo.mRloc16);
   399	    Get<Mac::Mac>().SetExtAddress(networkInfo.mExtAddress);
   400	
   401	    memcpy(&mMeshLocal64.GetAddress().mFields.m8[OT_IP6_PREFIX_SIZE], networkInfo.mMlIid,
   402	           OT_IP6_ADDRESS_SIZE - OT_IP6_PREFIX_SIZE);
   403	
   404	    if (networkInfo.mRloc16 == Mac::kShortAddrInvalid)
   405	    {
   406	        ExitNow();
   407	    }
   408	
   409	    if (!IsActiveRouter(networkInfo.mRloc16))
   410	    {
   411	        error = Get<Settings>().ReadParentInfo(parentInfo);
   412	
   413	        if (error != OT_ERROR_NONE)
   414	        {
   415	            // If the restored RLOC16 corresponds to an end-device, it
   416	            // is expected that the `ParentInfo` settings to be valid
   417	            // as well. The device can still recover from such an invalid
   418	            // setting by skipping the re-attach ("Child Update Request"
   419	            // exchange) and going through the full attach process.
   420	
   421	            otLogWarnMle("Invalid settings - no saved parent info with valid end-device RLOC16 0x%04x",
   422	                         networkInfo.mRloc16);
   423	            ExitNow();
   424	        }
   425	
   426	        memset(&mParent, 0, sizeof(mParent));
   427	        mParent.SetExtAddress(*static_cast<Mac::ExtAddress *>(&parentInfo.mExtAddress));
   428	        mParent.SetDeviceMode(DeviceMode(DeviceMode::kModeFullThreadDevice | DeviceMode::kModeRxOnWhenIdle |
   429	                                         DeviceMode::kModeFullNetworkData | DeviceMode::kModeSecureDataRequest));
   430	        mParent.SetRloc16(GetRloc16(GetRouterId(networkInfo.mRloc16)));
   431	        mParent.SetState(Neighbor::kStateRestored);
   432	
   433	#if OPENTHREAD_CONFIG_MLE_INFORM_PREVIOUS_PARENT_ON_REATTACH
   434	        mPreviousParentRloc = mParent.GetRloc16();
   435	#endif
   436	    }
   437	    else
   438	    {
   439	        Get<MleRouter>().SetRouterId(GetRouterId(GetRloc16()));
   440	        Get<MleRouter>().SetPreviousPartitionId(networkInfo.mPreviousPartitionId);
   441	        Get<MleRouter>().RestoreChildren();
   442	    }
   443	
   444	exit:
   445	    return error;
   446	}
