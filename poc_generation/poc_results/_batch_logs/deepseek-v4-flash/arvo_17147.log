   361	void Mle::SetAttachState(AttachState aState)
   362	{
   363	    VerifyOrExit(aState != mAttachState);
   364	    otLogInfoMle("AttachState %s -> %s", AttachStateToString(mAttachState), AttachStateToString(aState));
   365	    mAttachState = aState;
   366	
   367	exit:
   368	    return;
   369	}
