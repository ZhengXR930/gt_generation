    66	Message *MessagePool::New(uint8_t aType, uint16_t aReserveHeader, uint8_t aPriority)
    67	{
    68	    otError  error   = OT_ERROR_NONE;
    69	    Message *message = NULL;
    70	
    71	    VerifyOrExit((message = static_cast<Message *>(NewBuffer(aPriority))) != NULL);
    72	
    73	    memset(message, 0, sizeof(*message));
    74	    message->SetMessagePool(this);
    75	    message->SetType(aType);
    76	    message->SetReserved(aReserveHeader);
    77	    message->SetLinkSecurityEnabled(true);
    78	
    79	    SuccessOrExit(error = message->SetPriority(aPriority));
    80	    SuccessOrExit(error = message->SetLength(0));
    81	
    82	exit:
    83	    if (error != OT_ERROR_NONE)
    84	    {
    85	        Free(message);
    86	        message = NULL;
    87	    }
    88	
    89	    return message;
    90	}
