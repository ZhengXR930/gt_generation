                                cwords++;
                                if (cwords >= words)
                                        goto incomplete_msbs;
                                b = br->buffer[cwords];
                                y = COUNT_ZERO_MSBS2(b);
                                x += y;
                        } while(y == FLAC__BITS_PER_WORD);
