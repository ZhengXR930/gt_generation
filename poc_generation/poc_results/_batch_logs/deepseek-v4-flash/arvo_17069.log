        for( ; i; i--) {
                if(!FLAC__bitreader_read_raw_uint32(br, &x, 8))
                        return false;
                if(raw)
                        raw[(*rawlen)++] = (FLAC__byte)x;
                if(!(x & 0x80) || (x & 0x40)) { /* 10xxxxxx */
                        *val = 0xffffffff;
                        return true;
                }
                v <<= 6;
                v |= (x & 0x3F);
        }
        *val = v;
        return true;
}

