    27  static int parse_2_digit_num(const char *str, const char end_chr, int min, int max)
    28  {
    29      int val;
    30
    31      if (UNLIKELY(!lwan_char_isdigit(*str)))
    32          return -EINVAL;
    33      if (UNLIKELY(!lwan_char_isdigit(*(str + 1))))
    34          return -EINVAL;
    35      if (UNLIKELY(*(str + 2) != end_chr))
    36          return -EINVAL;
    37
    38      val = (*str - '0') * 10;
    39      val += *(str + 1) - '0';
    40
    41      if (UNLIKELY(val < min || val > max))
    42          return -EINVAL;
    43
    44      return val;
    45  }
