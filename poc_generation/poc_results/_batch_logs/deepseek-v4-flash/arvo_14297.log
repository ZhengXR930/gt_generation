    57      case MULTICHAR_CONSTANT('M','o','n',','): tm.tm_wday = 1; break;
    58      case MULTICHAR_CONSTANT('T','u','e',','): tm.tm_wday = 2; break;
    59      case MULTICHAR_CONSTANT('W','e','d',','): tm.tm_wday = 3; break;
    60      case MULTICHAR_CONSTANT('T','h','u',','): tm.tm_wday = 4; break;
    61      case MULTICHAR_CONSTANT('F','r','i',','): tm.tm_wday = 5; break;
    62      case MULTICHAR_CONSTANT('S','a','t',','): tm.tm_wday = 6; break;
    63      default: return -EINVAL;
