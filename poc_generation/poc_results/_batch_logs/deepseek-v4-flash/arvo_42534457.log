static gboolean
fu_coswid_firmware_parse_payload(FuCoswidFirmware *self,
                                 cbor_item_t *item,
                                 gpointer user_data,
                                 GError **error)
{
        struct cbor_pair *pairs = cbor_map_handle(item);
        for (gsize i = 0; i < cbor_map_size(item); i++) {
                FuCoswidTag tag_id = cbor_get_uint8(pairs[i].key);
