                                pairs[i].value,
                                fu_coswid_firmware_parse_directory,
                                NULL, /* user_data */
                                error))
                                return FALSE;
                } else {
                        g_debug("unhandled tag %s from %s",
                                fu_coswid_tag_to_string(tag_id),
                                fu_coswid_tag_to_string(FU_COSWID_TAG_PAYLOAD));
                }
        }

        /* success */
        return TRUE;
}

