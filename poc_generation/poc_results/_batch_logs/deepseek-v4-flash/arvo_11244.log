    61	{
    62	  return getObj(false, nullptr, cryptRC4, 0, 0, 0, recursion);
    63	}
    64	
    65	Object Parser::getObj(bool simpleOnly,
    66	           Guchar *fileKey,
    67	                       CryptAlgorithm encAlgorithm, int keyLength,
    68	                       int objNum, int objGen, int recursion,
    69	                       bool strict) {
    70	  Object obj;
    71	  Stream *str;
    72	  DecryptStream *decrypt;
    73	  const GooString *s;
    74	  GooString *s2;
    75	  int c;
    76	
    77	  // refill buffer after inline image data
    78	  if (inlineImg == 2) {
    79	    buf1 = lexer->getObj();
    80	    buf2 = lexer->getObj();
    81	    inlineImg = 0;
    82	  }
    83	
    84	  if (unlikely(recursion >= recursionLimit)) {
    85	    return Object(objError);
    86	  }
    87	
    88	  // array
    89	  if (!simpleOnly && buf1.isCmd("[")) {
    90	    shift();
    91	    obj = Object(new Array(xref));
    92	    while (!buf1.isCmd("]") && !buf1.isEOF() && recursion + 1 < recursionLimit) {
    93	      Object obj2 = getObj(false, fileKey, encAlgorithm, keyLength, objNum, objGen, recursion + 1);
    94	      obj.arrayAdd(std::move(obj2));
    95	    }
    96	    if (recursion + 1 >= recursionLimit && strict) goto err;
    97	    if (buf1.isEOF()) {
    98	      error(errSyntaxError, getPos(), "End of file inside array");
    99	      if (strict) goto err;
   100	    }
   101	    shift();
   102	
   103	  // dictionary or stream
   104	  } else if (!simpleOnly && buf1.isCmd("<<")) {
   105	    shift(objNum);
   106	    obj = Object(new Dict(xref));
   107	    while (!buf1.isCmd(">>") && !buf1.isEOF()) {
   108	      if (!buf1.isName()) {
   109	        error(errSyntaxError, getPos(), "Dictionary key must be a name object");
   110	        if (strict) goto err;
   111	        shift();
   112	      } else {
   113	        // buf1 will go away in shift(), so keep the key
   114	        const auto key = std::move(buf1);
   115	        shift();
   116	        if (buf1.isEOF() || buf1.isError()) {
   117	          if (strict && buf1.isError()) goto err;
   118	          break;
   119	        }
   120	        Object obj2 = getObj(false, fileKey, encAlgorithm, keyLength, objNum, objGen, recursion + 1);
   121	        if (unlikely(obj2.isError() && recursion + 1 >= recursionLimit)) {
   122	          break;
   123	        }
   124	        obj.dictAdd(key.getName(), std::move(obj2));
   125	      }
   126	    }
   127	    if (buf1.isEOF()) {
   128	      error(errSyntaxError, getPos(), "End of file inside dictionary");
   129	      if (strict) goto err;
   130	    }
   131	    // stream objects are not allowed inside content streams or
   132	    // object streams
   133	    if (buf2.isCmd("stream")) {
   134	      if (allowStreams && (str = makeStream(std::move(obj), fileKey, encAlgorithm, keyLength,
   135	                                            objNum, objGen, recursion + 1,
   136	                                            strict))) {
   137	        return Object(str);
   138	      } else {
   139	        return Object(objError);
   140	      }
   141	    } else {
   142	      shift();
   143	    }
   144	
   145	  // indirect reference or integer
   146	  } else if (buf1.isInt()) {
   147	    const int num = buf1.getInt();
   148	    shift();
   149	    if (buf1.isInt() && buf2.isCmd("R")) {
   150	      const int gen = buf1.getInt();
   151	      shift();
   152	      shift();
   153	
   154	      if (unlikely(num <= 0 || gen < 0)) {
   155	          return Object();
   156	      }
   157	
   158	      return Object(num, gen);
   159	    } else {
   160	      return Object(num);
   161	    }
   162	
   163	  // string
   164	  } else if (buf1.isString() && fileKey) {
   165	    s = buf1.getString();
   166	    s2 = new GooString();
   167	    decrypt = new DecryptStream(new MemStream(s->getCString(), 0, s->getLength(), Object(objNull)),
   168	                                fileKey, encAlgorithm, keyLength,
   169	                                objNum, objGen);
   170	    decrypt->reset();
   171	    while ((c = decrypt->getChar()) != EOF) {
   172	      s2->append((char)c);
   173	    }
   174	    delete decrypt;
   175	    obj = Object(s2);
   176	    shift();
   177	
   178	  // simple object
   179	  } else {
   180	    // avoid re-allocating memory for complex objects like strings by
   181	    // shallow copy of <buf1> to <obj> and nulling <buf1> so that
   182	    // subsequent buf1.free() won't free this memory
   183	    obj = std::move(buf1);
   184	    shift();
   185	  }
   186	
   187	  return obj;
   188	
   189	err:
   190	  return Object(objError);
   191	}
