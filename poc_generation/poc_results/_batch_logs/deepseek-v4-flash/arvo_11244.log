   437	/* Read one xref table section.  Also reads the associated trailer
   438	 * dictionary, and returns the prev pointer (if any).
   439	 * Arguments:
   440	 *   pos                Points to a Goffset containing the offset of the XRef
   441	 *                      section to be read. If a prev pointer is found, *pos is
   442	 *                      updated with its value
   443	 *   followedXRefStm    Used in case of nested readXRef calls to spot circular
   444	 *                      references in XRefStm pointers
   445	 *   xrefStreamObjsNum  If not NULL, every time a XRef stream is encountered,
   446	 *                      its object number is appended
   447	 * Return value:
   448	 *   true if a prev pointer is found, otherwise false
   449	 */
   450	bool XRef::readXRef(Goffset *pos, std::vector<Goffset> *followedXRefStm, std::vector<int> *xrefStreamObjsNum) {
   451	  Parser *parser;
   452	  Object obj;
   453	  bool more;
   454	
   455	  if (unlikely(start > (LLONG_MAX - *pos))) {
   456	    ok = false;
   457	    return false;
   458	  }
   459	
   460	  // start up a parser, parse one token
   461	  parser = new Parser(nullptr,
   462	             new Lexer(nullptr,
   463	               str->makeSubStream(start + *pos, false, 0, Object(objNull))),
   464	             true);
   465	  obj = parser->getObj(true);
   466	
   467	  // parse an old-style xref table
   468	  if (obj.isCmd("xref")) {
   469	    more = readXRefTable(parser, pos, followedXRefStm, xrefStreamObjsNum);
   470	
   471	  // parse an xref stream
   472	  } else if (obj.isInt()) {
   473	    const int objNum = obj.getInt();
   474	    if (obj = parser->getObj(true), !obj.isInt()) {
   475	      goto err1;
   476	    }
   477	    if (obj = parser->getObj(true), !obj.isCmd("obj")) {
   478	      goto err1;
   479	    }
   480	    if (obj = parser->getObj(), !obj.isStream()) {
   481	      goto err1;
   482	    }
   483	    if (trailerDict.isNone()) {
   484	      xRefStream = true;
   485	    }
   486	    if (xrefStreamObjsNum) {
   487	      xrefStreamObjsNum->push_back(objNum);
   488	    }
   489	    more = readXRefStream(obj.getStream(), pos);
   490	
   491	  } else {
   492	    goto err1;
   493	  }
   494	
   495	  delete parser;
   496	  return more;
   497	
   498	 err1:
   499	  delete parser;
   500	  ok = false;
   501	  return false;
   502	}
