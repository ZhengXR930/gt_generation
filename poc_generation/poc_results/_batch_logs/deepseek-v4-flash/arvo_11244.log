   147	  // in the 'new Object[nObjects]' call (Acrobat apparently limits
   148	  // object streams to 100-200 objects)
   149	  if (nObjects > 1000000) {
   150	    error(errSyntaxError, -1, "Too many objects in an object stream");
   151	    return;
