   387	int XRef::reserve(int newSize)
   388	{
   389	  if (newSize > capacity) {
   390	
   391	    int realNewSize;
   392	    for (realNewSize = capacity ? 2 * capacity : 1024;
   393	          newSize > realNewSize && realNewSize > 0;
   394	          realNewSize <<= 1) ;
   395	    if ((realNewSize < 0) ||
   396	        (realNewSize >= INT_MAX / (int)sizeof(XRefEntry))) {
   397	      return 0;
   398	    }
   399	
   400	    void *p = greallocn_checkoverflow(entries, realNewSize, sizeof(XRefEntry));
   401	    if (p == nullptr) {
   402	      return 0;
   403	    }
   404	
   405	    entries = (XRefEntry *) p;
   406	    capacity = realNewSize;
   407	
   408	  }
   409	
   410	  return capacity;
   411	}
