    52	enum XRefEntryType {
    53	  xrefEntryFree,
    54	  xrefEntryUncompressed,
    55	  xrefEntryCompressed,
    56	  xrefEntryNone
    57	};
    58	
    59	struct XRefEntry {
    60	  Goffset offset;
    61	  int gen;
    62	  XRefEntryType type;
    63	  int flags;
    64	  Object obj; //if this entry was updated, obj will contains the updated object
    65	
    66	  enum Flag {
    67	    // Regular flags
    68	    Updated,     // Entry was modified
    69	    Parsing,     // Entry is currently being parsed
    70	
    71	    // Special flags -- available only after xref->scanSpecialFlags() is run
    72	    Unencrypted, // Entry is stored in unencrypted form (meaningless in unencrypted documents)
    73	    DontRewrite  // Entry must not be written back in case of full rewrite
    74	  };
    75	
    76	  inline bool getFlag(Flag flag) const {
    77	    const int mask = (1 << (int)flag);
    78	    return (flags & mask) != 0;
    79	  }
    80	
    81	  inline void setFlag(Flag flag, bool value) {
    82	    const int mask = (1 << (int)flag);
    83	    if (value) {
    84	      flags |= mask;
    85	    } else {
    86	      flags &= ~mask;
    87	    }
    88	  }
    89	};
