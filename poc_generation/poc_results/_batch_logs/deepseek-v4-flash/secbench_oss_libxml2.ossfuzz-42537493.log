#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int LLVMFuzzerInitialize(int *argc, char ***argv);
int LLVMFuzzerTestOneInput(const char *data, size_t size);

int main(int argc, char **argv) {
    FILE *f;
    char *data;
    long size;
    
    if (argc < 2) {
        fprintf(stderr, "usage: %s <input_file>\n", argv[0]);
        return 1;
    }
    
    LLVMFuzzerInitialize(&argc, &argv);
    
    f = fopen(argv[1], "rb");
    if (!f) {
        perror("fopen");
        return 1;
    }
    fseek(f, 0, SEEK_END);
    size = ftell(f);
    fseek(f, 0, SEEK_SET);
    data = malloc(size);
    if (!data) {
        perror("malloc");
        return 1;
    }
    if (fread(data, 1, size, f) != (size_t)size) {
        perror("fread");
        return 1;
    }
    fclose(f);
    
    LLVMFuzzerTestOneInput(data, size);
    free(data);
    return 0;
}
EOF
