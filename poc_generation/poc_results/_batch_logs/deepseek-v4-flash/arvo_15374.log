   359	    aDataset.mComponents.mIsMasterKeyPresent       = true;
   360	    aDataset.mComponents.mIsNetworkNamePresent     = true;
   361	    aDataset.mComponents.mIsExtendedPanIdPresent   = true;
   362	    aDataset.mComponents.mIsMeshLocalPrefixPresent = true;
   363	    aDataset.mComponents.mIsPanIdPresent           = true;
   364	    aDataset.mComponents.mIsChannelPresent         = true;
