   265	        BorderAgentLocatorTlv *borderAgentLocator;
   266	        Ip6::Address           destination;
   267	
   268	        borderAgentLocator = static_cast<BorderAgentLocatorTlv *>(
   269	            Get<NetworkData::Leader>().GetCommissioningDataSubTlv(Tlv::kBorderAgentLocator));
   270	        VerifyOrExit(borderAgentLocator != NULL);
