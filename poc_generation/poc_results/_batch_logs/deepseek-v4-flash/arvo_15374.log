   351	    do
   352	    {
   353	        aDataset.mPanId = Random::NonCrypto::GetUint16();
   354	    } while (aDataset.mPanId == Mac::kPanIdBroadcast);
   355	
   356	    snprintf(aDataset.mNetworkName.m8, sizeof(aDataset.mNetworkName), "OpenThread-%04x", aDataset.mPanId);
