   319	{
   320	    otError          error             = OT_ERROR_NONE;
   321	    Mac::ChannelMask supportedChannels = Get<Mac::Mac>().GetSupportedChannelMask();
   322	    Mac::ChannelMask preferredChannels(otPlatRadioGetPreferredChannelMask(&GetInstance()));
   323	
   324	    memset(&aDataset, 0, sizeof(aDataset));
