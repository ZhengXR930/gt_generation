   238	void DatasetManager::HandleTimer(void)
   239	{
   240	    VerifyOrExit(Get<Mle::MleRouter>().IsAttached());
   241	
   242	    VerifyOrExit(mLocal.Compare(GetTimestamp()) < 0);
   243	
   244	    if (mLocal.GetType() == Tlv::kActiveTimestamp)
   245	    {
   246	        Dataset dataset(Tlv::kPendingTimestamp);
   247	        Get<PendingDataset>().Read(dataset);
   248	
   249	        const ActiveTimestampTlv *tlv = static_cast<const ActiveTimestampTlv *>(dataset.Get(Tlv::kActiveTimestamp));
   250	        const Timestamp *         pendingActiveTimestamp = static_cast<const Timestamp *>(tlv);
   251	
   252	        if (pendingActiveTimestamp != NULL && mLocal.Compare(pendingActiveTimestamp) == 0)
   253	        {
   254	            // stop registration attempts during dataset transition
   255	            ExitNow();
   256	        }
   257	    }
   258	
   259	    Register();
   260	    mTimer.Start(1000);
   261	
   262	exit:
   263	    return;
   264	}
   265	
   266	otError DatasetManager::Register(void)
   267	{
   268	    otError          error = OT_ERROR_NONE;
   269	    Coap::Message *  message;
   270	    Ip6::MessageInfo messageInfo;
   271	    Dataset          dataset(mLocal.GetType());
   272	
   273	    VerifyOrExit((message = NewMeshCoPMessage(Get<Coap::Coap>())) != NULL, error = OT_ERROR_NO_BUFS);
   274	
   275	    SuccessOrExit(error = message->Init(OT_COAP_TYPE_CONFIRMABLE, OT_COAP_CODE_POST, mUriSet));
   276	    SuccessOrExit(error = message->SetPayloadMarker());
   277	
   278	    mLocal.Read(dataset);
   279	    SuccessOrExit(error = message->Append(dataset.GetBytes(), dataset.GetSize()));
   280	
   281	    messageInfo.SetSockAddr(Get<Mle::MleRouter>().GetMeshLocal16());
   282	    Get<Mle::MleRouter>().GetLeaderAloc(messageInfo.GetPeerAddr());
   283	    messageInfo.SetPeerPort(kCoapUdpPort);
   284	    SuccessOrExit(error = Get<Coap::Coap>().SendMessage(*message, messageInfo));
   285	
   286	    otLogInfoMeshCoP("sent dataset to leader");
   287	
   288	exit:
   289	
   290	    if (error != OT_ERROR_NONE && message != NULL)
   291	    {
   292	        message->Free();
   293	    }
   294	
   295	    return error;
   296	}
   297	
   298	void DatasetManager::HandleGet(const Coap::Message &aMessage, const Ip6::MessageInfo &aMessageInfo) const
   299	{
   300	    Tlv      tlv;
   301	    uint16_t offset = aMessage.GetOffset();
   302	    uint8_t  tlvs[Dataset::kMaxSize];
   303	    uint8_t  length = 0;
   304	
   305	    while (offset < aMessage.GetLength())
   306	    {
   307	        aMessage.Read(offset, sizeof(tlv), &tlv);
   308	
   309	        if (tlv.GetType() == Tlv::kGet)
   310	        {
   311	            length = tlv.GetLength();
   312	            aMessage.Read(offset + sizeof(Tlv), length, tlvs);
   313	            break;
   314	        }
   315	
   316	        offset += sizeof(tlv) + tlv.GetLength();
   317	    }
   318	
   319	    // MGMT_PENDING_GET.rsp must include Delay Timer TLV (Thread 1.1.1 Section 8.7.5.4)
   320	    if (length != 0 && strcmp(mUriGet, OT_URI_PATH_PENDING_GET) == 0)
   321	    {
   322	        uint16_t i;
   323	
   324	        for (i = 0; i < length; i++)
   325	        {
   326	            if (tlvs[i] == Tlv::kDelayTimer)
   327	            {
   328	                break;
   329	            }
   330	        }
   331	
   332	        if (i == length && (i + 1u) <= sizeof(tlvs))
   333	        {
   334	            tlvs[length++] = Tlv::kDelayTimer;
   335	        }
   336	    }
   337	
   338	    SendGetResponse(aMessage, aMessageInfo, tlvs, length);
   339	}
   340	
   341	void DatasetManager::SendGetResponse(const Coap::Message &   aRequest,
   342	                                     const Ip6::MessageInfo &aMessageInfo,
   343	                                     uint8_t *               aTlvs,
