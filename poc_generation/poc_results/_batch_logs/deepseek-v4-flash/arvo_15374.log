   139	otError DatasetManager::Save(const Dataset &aDataset)
   140	{
   141	    otError          error = OT_ERROR_NONE;
   142	    const Timestamp *timestamp;
   143	    int              compare;
   144	    bool             isMasterkeyUpdated = false;
   145	
   146	    timestamp = aDataset.GetTimestamp();
   147	
   148	    if (timestamp != NULL)
   149	    {
   150	        mTimestamp      = *timestamp;
   151	        mTimestampValid = true;
   152	
   153	        if (mLocal.GetType() == Tlv::kActiveTimestamp)
   154	        {
   155	            SuccessOrExit(error = aDataset.ApplyConfiguration(GetInstance(), &isMasterkeyUpdated));
   156	        }
   157	    }
   158	
   159	    compare = mLocal.Compare(timestamp);
   160	
   161	    if (isMasterkeyUpdated || compare > 0)
   162	    {
   163	        mLocal.Save(aDataset);
   164	
   165	#if OPENTHREAD_FTD
   166	        if (Get<Mle::MleRouter>().GetRole() == OT_DEVICE_ROLE_LEADER)
   167	        {
   168	            Get<NetworkData::Leader>().IncrementVersion();
   169	            Get<NetworkData::Leader>().IncrementStableVersion();
   170	        }
   171	#endif
   172	    }
   173	    else if (compare < 0)
   174	    {
   175	        mTimer.Start(1000);
   176	    }
   177	
   178	exit:
   179	    return error;
   180	}
   181	
   182	otError DatasetManager::Save(const otOperationalDataset &aDataset)
   183	{
   184	    otError error = OT_ERROR_NONE;
   185	
   186	    SuccessOrExit(error = mLocal.Save(aDataset));
   187	
   188	    switch (Get<Mle::MleRouter>().GetRole())
   189	    {
   190	    case OT_DEVICE_ROLE_DISABLED:
   191	        Restore();
   192	        break;
   193	
   194	    case OT_DEVICE_ROLE_CHILD:
   195	        mTimer.Start(1000);
   196	        break;
   197	#if OPENTHREAD_FTD
   198	    case OT_DEVICE_ROLE_ROUTER:
   199	        mTimer.Start(1000);
   200	        break;
   201	
   202	    case OT_DEVICE_ROLE_LEADER:
   203	        Restore();
   204	        Get<NetworkData::Leader>().IncrementVersion();
   205	        Get<NetworkData::Leader>().IncrementStableVersion();
   206	        break;
   207	#endif
   208	
   209	    default:
   210	        break;
   211	    }
   212	
   213	exit:
   214	    return error;
   215	}
