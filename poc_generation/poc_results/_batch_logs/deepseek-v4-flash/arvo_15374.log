   289	void DatasetManager::SendSetResponse(const Coap::Message &   aRequest,
   290	                                     const Ip6::MessageInfo &aMessageInfo,
   291	                                     StateTlv::State         aState)
   292	{
   293	    otError        error = OT_ERROR_NONE;
   294	    Coap::Message *message;
   295	    StateTlv       state;
   296	
   297	    VerifyOrExit((message = NewMeshCoPMessage(Get<Coap::Coap>())) != NULL, error = OT_ERROR_NO_BUFS);
   298	
   299	    SuccessOrExit(error = message->SetDefaultResponseHeader(aRequest));
   300	    SuccessOrExit(error = message->SetPayloadMarker());
   301	
   302	    state.Init();
   303	    state.SetState(aState);
   304	    SuccessOrExit(error = message->AppendTlv(state));
   305	
   306	    SuccessOrExit(error = Get<Coap::Coap>().SendMessage(*message, aMessageInfo));
   307	
   308	    otLogInfoMeshCoP("sent dataset set response");
   309	
   310	exit:
   311	
   312	    if (error != OT_ERROR_NONE && message != NULL)
   313	    {
   314	        message->Free();
   315	    }
   316	}
