    95	    otError        error;
    96	
    97	    error = Get<Settings>().ReadOperationalDataset(IsActive(), aDataset);
    98	    VerifyOrExit(error == OT_ERROR_NONE, aDataset.mLength = 0);
    99	
   100	    if (mType == Tlv::kActiveTimestamp)
