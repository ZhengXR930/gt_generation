   140  static int
   141  verify_one_file (ctrl_t ctrl, const char *name )
   142  {
   143      IOBUF fp;
   144      armor_filter_context_t *afx = NULL;
   145      progress_filter_context_t *pfx = new_progress_context ();
   146      int rc;
   147
   148      print_file_status( STATUS_FILE_START, name, 1 );
