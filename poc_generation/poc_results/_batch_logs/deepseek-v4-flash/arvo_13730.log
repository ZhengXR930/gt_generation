    49
    50  int
    51  verify_signatures (ctrl_t ctrl, int nfiles, char **files )
    52  {
    53      IOBUF fp;
    54      armor_filter_context_t *afx = NULL;
    55      progress_filter_context_t *pfx = new_progress_context ();
