static int str_to_regex(const char *pattern, OnigRegex *reg)
{
    int ret;
    int len;
    const char *start;
    const char *end;
    OnigErrorInfo einfo;

    len = strlen(pattern);
    start = pattern;
    end = pattern + len;

    if (pattern[0] == '/' && pattern[len - 1] == '/') {
        start++;
        end--;
    }

    ret = onig_new(reg,
                   (const unsigned char *)start, (const unsigned char *)end,
                   ONIG_OPTION_DEFAULT,
                   ONIG_ENCODING_UTF8, ONIG_SYNTAX_RUBY, &einfo);

    if (ret != ONIG_NORMAL) {
        return -1;
    }
    return 0;
}

