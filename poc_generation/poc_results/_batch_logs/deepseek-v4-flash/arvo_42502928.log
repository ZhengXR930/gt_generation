                raw:
                        slen = decode_raw(ctx, cursor, dict, parent, p, end - p , decode_ctx);
                        if (slen < 0) return slen;
                        break;
                }

                element_len = fr_net_to_uint16(p);
                if ((p + 2 + element_len) > end) {
                        goto raw;
                }

                p += 2;
                slen = decode_value(ctx, cursor, dict, parent, p, element_len, decode_ctx);
                if (slen < 0) return slen;
