            ofs - 2 * sizeof(uint32_t)));

        if (q < p) {
                DPRINTF(("Wrapped around %p < %p\n", q, p));
                return NULL;
        }

        if (q >= e) {
                DPRINTF(("Ran off the end %p >= %p\n", q, e));
                return NULL;
        }
        return q;
}

