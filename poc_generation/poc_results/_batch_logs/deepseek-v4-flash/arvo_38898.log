private char *
mkdbname(struct magic_set *ms, const char *fn, int strip)
{
        const char *p, *q;
        char *buf;

        if (strip) {
                if ((p = strrchr(fn, '/')) != NULL)
                        fn = ++p;
        }

        for (q = fn; *q; q++)
                continue;
        /* Look for .mgc */
