    58	Object Object::copy() const {
    59	  CHECK_NOT_DEAD;
    60	
    61	  Object obj;
    62	  std::memcpy(reinterpret_cast<void*>(&obj), this, sizeof(Object));
    63	
    64	  switch (type) {
    65	  case objString:
    66	    obj.string = string->copy();
    67	    break;
    68	  case objName:
    69	  case objCmd:
    70	    obj.cString = copyString(cString);
    71	    break;
    72	  case objArray:
    73	    array->incRef();
    74	    break;
    75	  case objDict:
    76	    dict->incRef();
    77	    break;
    78	  case objStream:
    79	    stream->incRef();
    80	    break;
    81	  default:
    82	    break;
    83	  }
    84	
    85	  return obj;
    86	}
