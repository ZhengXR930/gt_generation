    From 11b17f137d481f1e040ed1a1fc4efb7658f2ea35 Mon Sep 17 00:00:00 2001
    From: James Bonfield 
    Date: Mon, 1 Feb 2021 10:05:54 +0000
    Subject: [PATCH] Fix an overflow bug in the unstripe function.
    
    This was caused by a subtracting froman unsigned value and wrapping
    around.  The unstripe function was a static function common to both
    the rANS4x16 and arith_dynamic codecs, so it's now been moved to a
    utils.h file as a static inline.  This file isn't installed.
    
    It's named "utils.h" as I plan on migrating some other common code to
    it too.  Notably the histogram analysis from rANS4x8 and rANS4x16
    differ in implementation, but do the same thing.
    
    Credit to OSS-Fuzz
    Fixes oss-fuzz 30087
    ---
     htscodecs/Makefile.am         |  3 +-
     htscodecs/arith_dynamic.c     | 47 +----------------------
     htscodecs/rANS_static4x16pr.c | 47 +----------------------
     htscodecs/utils.h             | 71 +++++++++++++++++++++++++++++++++++
     4 files changed, 75 insertions(+), 93 deletions(-)
     create mode 100644 htscodecs/utils.h
    
    diff --git a/htscodecs/Makefile.am b/htscodecs/Makefile.am
    index d6a0cd5..df2c06f 100644
    --- a/htscodecs/Makefile.am
    +++ b/htscodecs/Makefile.am
    @@ -52,7 +52,8 @@ libhtscodecs_la_SOURCES = \
     	c_range_coder.h \
     	c_simple_model.h \
     	varint.h \
    -	htscodecs_endian.h
    +	htscodecs_endian.h \
    +	utils.h
     
     libhtscodecs_la_LDFLAGS = -version-info @VERS_CURRENT@:@VERS_REVISION@:@VERS_AGE@ 
     libhtscodecs_la_LIBADD = @LIBZ@
    diff --git a/htscodecs/arith_dynamic.c b/htscodecs/arith_dynamic.c
    index e18953a..e072b18 100644
    --- a/htscodecs/arith_dynamic.c
    +++ b/htscodecs/arith_dynamic.c
    @@ -65,6 +65,7 @@
     #include "arith_dynamic.h"
     #include "varint.h"
     #include "pack.h"
    +#include "utils.h"
     
     #define MIN(a,b) ((a)<(b)?(a):(b))
     
    @@ -866,52 +867,6 @@ unsigned char *arith_compress(unsigned char *in, unsigned int in_size,
         return arith_compress_to(in, in_size, NULL, out_size, order);
     }
     
