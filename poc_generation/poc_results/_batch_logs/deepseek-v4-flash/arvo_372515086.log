cat > /tmp/csearch.c << 'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include "h3api.h"
#include "polyfill.h"
#include "polygon.h"

static uint64_t rng_state = 12345;
static uint64_t rng(void) {
    rng_state ^= rng_state << 13;
    rng_state ^= rng_state >> 7;
    rng_state ^= rng_state << 17;
    return rng_state;
}
static double frand(double lo, double hi) {
    return lo + (hi - lo) * ((double)(rng() % 1000000) / 1000000.0);
}

int main(void) {
    LatLng verts[8];
    for (int trial = 0; trial < 2000000; trial++) {
        int res = rng() % 16;
        int nv = 3 + rng() % 4;
        for (int i = 0; i < nv; i++) {
            verts[i].lat = frand(-1.5, 1.5);
            verts[i].lng = frand(-3.0, 3.0);
        }
        GeoLoop gl = {.numVerts = nv, .verts = verts};
        GeoPolygon poly = {.geoloop = gl, .numHoles = 0, .holes = NULL};
        uint32_t flags = CONTAINMENT_OVERLAPPING;
        int64_t sz;
        H3Error err = maxPolygonToCellsSizeExperimental(&poly, res, flags, &sz);
        if (err) continue;
        H3Index* out = calloc(sz, sizeof(H3Index));
        H3Error err2 = polygonToCellsExperimental(&poly, res, flags, out);
        int64_t cnt = 0;
        for (int64_t i = 0; i < sz; i++) if (out[i]) cnt++;
        if (cnt > sz) {
            printf("OVERFLOW trial=%d res=%d nv=%d sz=%lld cnt=%lld\n", trial, res, nv, (long long)sz, (long long)cnt);
            for (int i = 0; i < nv; i++) printf("  vert[%d] lat=%.17g lng=%.17g\n", i, verts[i].lat, verts[i].lng);
            free(out);
            return 0;
        }
        free(out);
        if (trial % 200000 == 0) fprintf(stderr, "trial %d\n", trial);
    }
    printf("no overflow\n");
    return 0;
}
EOF
