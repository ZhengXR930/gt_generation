#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "h3api.h"
#include "polyfill.h"
#include "polygon.h"

int main(int argc, char** argv) {
    // Read a polygon from a file: first int numVerts, then numVerts LatLng
    FILE* fp = fopen(argv[1], "rb");
    if (!fp) { perror("open"); return 1; }
    int numVerts;
    fread(&numVerts, sizeof(int), 1, fp);
    LatLng* verts = malloc(sizeof(LatLng)*numVerts);
    fread(verts, sizeof(LatLng), numVerts, fp);
    fclose(fp);

    GeoLoop gl = {.numVerts = numVerts, .verts = verts};
    GeoPolygon poly = {.geoloop = gl, .numHoles = 0, .holes = NULL};

    int res = atoi(argv[2]);
    uint32_t flags = CONTAINMENT_OVERLAPPING;

    int64_t sz;
    H3Error err = maxPolygonToCellsSizeExperimental(&poly, res, flags, &sz);
    printf("maxSize err=%d sz=%lld\n", err, (long long)sz);
    if (err) return 0;

    H3Index* out = calloc(sz, sizeof(H3Index));
    H3Error err2 = polygonToCellsExperimental(&poly, res, flags, out);
    printf("polygonToCells err=%d\n", err2);
    // count non-null
    int64_t cnt = 0;
    for (int64_t i = 0; i < sz; i++) if (out[i]) cnt++;
    printf("count=%lld sz=%lld\n", (long long)cnt, (long long)sz);
    if (cnt > sz) printf("OVERFLOW!\n");
    free(out);
    free(verts);
    return 0;
}
EOF
