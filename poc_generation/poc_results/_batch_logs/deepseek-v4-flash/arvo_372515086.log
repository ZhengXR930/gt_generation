#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include "h3api.h"
#include "polyfill.h"
#include "polygon.h"

static uint64_t rng_state = 12345;
static uint64_t rng(void) {
    rng_state ^= rng_state << 13;
    rng_state ^= rng_state >> 7;
    rng_state ^= rng_state << 17;
    return rng_state;
}
static double frand(double lo, double hi) {
    return lo + (hi - lo) * ((double)(rng() % 1000000) / 1000000.0);
}

int main(void) {
    LatLng verts[8];
    for (int trial = 0; trial < 100000; trial++) {
        int res = rng() % 16;
        int nv = 3 + rng() % 4;
        for (int i = 0; i < nv; i++) {
            verts[i].lat = frand(-1.5, 1.5);
            verts[i].lng = frand(-3.0, 3.0);
        }
        GeoLoop gl = {.numVerts = nv, .verts = verts};
        GeoPolygon poly = {.geoloop = gl, .numHoles = 0, .holes = NULL};
        
        // Run OVERLAPPING mode
        int64_t sz_over;
        H3Error err = maxPolygonToCellsSizeExperimental(&poly, res, CONTAINMENT_OVERLAPPING, &sz_over);
        if (err) continue;
        H3Index *out_over = calloc(sz_over, sizeof(H3Index));
        H3Error err2 = polygonToCellsExperimental(&poly, res, CONTAINMENT_OVERLAPPING, out_over);
        int64_t cnt_over = 0;
        for (int64_t i = 0; i < sz_over; i++) if (out_over[i]) cnt_over++;
        
        // Run OVERLAPPING_BBOX mode
        int64_t sz_bbox;
        H3Error err3 = maxPolygonToCellsSizeExperimental(&poly, res, CONTAINMENT_OVERLAPPING_BBOX, &sz_bbox);
        if (err3) { free(out_over); continue; }
        H3Index *out_bbox = calloc(sz_bbox, sizeof(H3Index));
        H3Error err4 = polygonToCellsExperimental(&poly, res, CONTAINMENT_OVERLAPPING_BBOX, out_bbox);
        int64_t cnt_bbox = 0;
        for (int64_t i = 0; i < sz_bbox; i++) if (out_bbox[i]) cnt_bbox++;
        
        if (cnt_over > cnt_bbox) {
            printf("DIFF trial=%d res=%d nv=%d cnt_over=%lld cnt_bbox=%lld sz_over=%lld sz_bbox=%lld\n", 
                   trial, res, nv, (long long)cnt_over, (long long)cnt_bbox, (long long)sz_over, (long long)sz_bbox);
            for (int i = 0; i < nv; i++) printf("  vert[%d] lat=%.17g lng=%.17g\n", i, verts[i].lat, verts[i].lng);
            free(out_over);
            free(out_bbox);
            return 0;
        }
        
        free(out_over);
        free(out_bbox);
        if (trial % 10000 == 0) fprintf(stderr, "trial %d\n", trial);
    }
    printf("no diff found\n");
    return 0;
}
