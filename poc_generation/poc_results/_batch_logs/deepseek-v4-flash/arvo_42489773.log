int main(int argc, char** argv) {
  FILE* f = fopen(argv[1], "rb");
  fseek(f, 0, SEEK_END);
  long size = ftell(f);
  fseek(f, 0, SEEK_SET);
  uint8_t* data = malloc(size);
  fread(data, 1, size, f);
  fclose(f);

  blosc_init();
  blosc_set_nthreads(1);
  blosc2_dparams dparams = BLOSC2_DPARAMS_DEFAULTS;
  dparams.nthreads = 1;

  blosc2_schunk* schunk = blosc2_schunk_open_sframe(data, size);
  if (schunk == NULL) {
    printf("schunk is NULL\n");
    return 0;
  }
  printf("schunk->nchunks=%d nbytes=%lld cbytes=%lld chunksize=%d\n",
         schunk->nchunks, (long long)schunk->nbytes, (long long)schunk->cbytes, schunk->chunksize);

  uint8_t* uncompressed_data = malloc(schunk->nbytes+1);
  int i=0, nchunk=0;
  for (nchunk = 0; nchunk < schunk->nchunks-1; nchunk++) {
    int dsize = blosc2_schunk_decompress_chunk(schunk, nchunk, uncompressed_data + i, schunk->chunksize);
    printf("nchunk=%d dsize=%d\n", nchunk, dsize);
    if (dsize < 0) break;
    i += dsize;
  }
  free(uncompressed_data);
  blosc2_schunk_free(schunk);
  blosc_destroy();
  return 0;
}
