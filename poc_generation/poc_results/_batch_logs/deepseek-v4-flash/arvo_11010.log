    46	struct RearrangementSubtable
    47	{
    48	  typedef void EntryData;
    49	
    50	  struct driver_context_t
    51	  {
    52	    static const bool in_place = true;
    53	    enum Flags
    54	    {
    55	      MarkFirst         = 0x8000,       /* If set, make the current glyph the first
    56	                                         * glyph to be rearranged. */
    57	      DontAdvance       = 0x4000,       /* If set, don't advance to the next glyph
    58	                                         * before going to the new state. This means
    59	                                         * that the glyph index doesn't change, even
    60	                                         * if the glyph at that index has changed. */
    61	      MarkLast          = 0x2000,       /* If set, make the current glyph the last
    62	                                         * glyph to be rearranged. */
    63	      Reserved          = 0x1FF0,       /* These bits are reserved and should be set to 0. */
    64	      Verb              = 0x000F,       /* The type of rearrangement specified. */
    65	    };
    66	
    67	    inline driver_context_t (const RearrangementSubtable *table) :
    68	        ret (false),
    69	        start (0), end (0) {}
    70	
    71	    inline bool is_actionable (StateTableDriver<EntryData> *driver,
    72	                               const Entry<EntryData> *entry)
    73	    {
    74	      return (entry->flags & Verb) && start < end;
    75	    }
    76	    inline bool transition (StateTableDriver<EntryData> *driver,
    77	                            const Entry<EntryData> *entry)
    78	    {
    79	      hb_buffer_t *buffer = driver->buffer;
    80	      unsigned int flags = entry->flags;
    81	
    82	      if (flags & MarkFirst)
    83	        start = buffer->idx;
    84	
    85	      if (flags & MarkLast)
    86	        end = MIN (buffer->idx + 1, buffer->len);
    87	
    88	      if ((flags & Verb) && start < end)
    89	      {
    90	        /* The following map has two nibbles, for start-side
    91	         * and end-side. Values of 0,1,2 mean move that many
    92	         * to the other side. Value of 3 means move 2 and
    93	         * flip them. */
    94	        const unsigned char map[16] =
    95	        {
    96	          0x00, /* 0    no change */
    97	          0x10, /* 1    Ax => xA */
    98	          0x01, /* 2    xD => Dx */
    99	          0x11, /* 3    AxD => DxA */
   100	          0x20, /* 4    ABx => xAB */
   101	          0x30, /* 5    ABx => xBA */
   102	          0x02, /* 6    xCD => CDx */
   103	          0x03, /* 7    xCD => DCx */
   104	          0x12, /* 8    AxCD => CDxA */
   105	          0x13, /* 9    AxCD => DCxA */
   106	          0x21, /* 10   ABxD => DxAB */
   107	          0x31, /* 11   ABxD => DxBA */
   108	          0x22, /* 12   ABxCD => CDxAB */
   109	          0x32, /* 13   ABxCD => CDxBA */
   110	          0x23, /* 14   ABxCD => DCxAB */
   111	          0x33, /* 15   ABxCD => DCxBA */
   112	        };
   113	
   114	        unsigned int m = map[flags & Verb];
   115	        unsigned int l = MIN<unsigned int> (2, m >> 4);
   116	        unsigned int r = MIN<unsigned int> (2, m & 0x0F);
   117	        bool reverse_l = 3 == (m >> 4);
   118	        bool reverse_r = 3 == (m & 0x0F);
   119	
   120	        if (end - start >= l + r)
   121	        {
   122	          buffer->merge_clusters (start, MIN (buffer->idx + 1, buffer->len));
   123	          buffer->merge_clusters (start, end);
   124	
   125	          hb_glyph_info_t *info = buffer->info;
   126	          hb_glyph_info_t buf[4];
   127	
   128	          memcpy (buf, info + start, l * sizeof (buf[0]));
   129	          memcpy (buf + 2, info + end - r, r * sizeof (buf[0]));
   130	
   131	          if (l != r)
   132	            memmove (info + start + r, info + start + l, (end - start - l - r) * sizeof (buf[0]));
   133	
   134	          memcpy (info + start, buf + 2, r * sizeof (buf[0]));
   135	          memcpy (info + end - l, buf, l * sizeof (buf[0]));
   136	          if (reverse_l)
   137	          {
   138	            buf[0] = info[end - 1];
   139	            info[end - 1] = info[end - 2];
   140	            info[end - 2] = buf[0];
   141	          }
   142	          if (reverse_r)
   143	          {
   144	            buf[0] = info[start];
   145	            info[start] = info[start + 1];
   146	            info[start + 1] = buf[0];
   147	          }
   148	        }
   149	      }
   150	
   151	      return true;
   152	    }
   153	
   154	    public:
   155	    bool ret;
   156	    private:
   157	    unsigned int start;
   158	    unsigned int end;
   159	  };
