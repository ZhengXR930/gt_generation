   443	template <typename EntryData>
   444	struct StateTableDriver
   445	{
   446	  inline StateTableDriver (const StateTable<EntryData> &machine_,
   447	                           hb_buffer_t *buffer_,
   448	                           hb_face_t *face_) :
   449	              machine (machine_),
   450	              buffer (buffer_),
   451	              num_glyphs (face_->get_num_glyphs ()) {}
   452	
   453	  template <typename context_t>
   454	  inline void drive (context_t *c)
   455	  {
   456	    if (!c->in_place)
   457	      buffer->clear_output ();
   458	
   459	    unsigned int state = StateTable<EntryData>::STATE_START_OF_TEXT;
   460	    bool last_was_dont_advance = false;
   461	    for (buffer->idx = 0;;)
   462	    {
   463	      unsigned int klass = buffer->idx < buffer->len ?
   464	                           machine.get_class (buffer->info[buffer->idx].codepoint, num_glyphs) :
   465	                           (unsigned) StateTable<EntryData>::CLASS_END_OF_TEXT;
   466	      const Entry<EntryData> *entry = machine.get_entryZ (state, klass);
   467	      if (unlikely (!entry))
   468	        break;
   469	
   470	      /* Unsafe-to-break before this if not in state 0, as things might
   471	       * go differently if we start from state 0 here.
   472	       *
   473	       * Ugh.  The indexing here is ugly... */
   474	      if (state && buffer->backtrack_len () && buffer->idx < buffer->len)
   475	      {
   476	        /* If there's no action and we're just epsilon-transitioning to state 0,
   477	         * safe to break. */
   478	        if (c->is_actionable (this, entry) ||
   479	            !(entry->newState == StateTable<EntryData>::STATE_START_OF_TEXT &&
   480	              entry->flags == context_t::DontAdvance))
   481	          buffer->unsafe_to_break_from_outbuffer (buffer->backtrack_len () - 1, buffer->idx + 1);
   482	      }
   483	
   484	      /* Unsafe-to-break if end-of-text would kick in here. */
   485	      if (buffer->idx + 2 <= buffer->len)
   486	      {
   487	        const Entry<EntryData> *end_entry = machine.get_entryZ (state, 0);
   488	        if (c->is_actionable (this, end_entry))
   489	          buffer->unsafe_to_break (buffer->idx, buffer->idx + 2);
   490	      }
   491	
   492	      if (unlikely (!c->transition (this, entry)))
   493	        break;
   494	
   495	      if (unlikely (!buffer->successful)) return;
   496	
   497	      last_was_dont_advance = (entry->flags & context_t::DontAdvance) && buffer->max_ops-- > 0;
   498	
   499	      state = entry->newState;
   500	
   501	      if (buffer->idx == buffer->len)
   502	        break;
   503	
   504	      if (!last_was_dont_advance)
   505	        buffer->next_glyph ();
   506	    }
   507	
   508	    if (!c->in_place)
   509	    {
   510	      for (; buffer->successful && buffer->idx < buffer->len;)
   511	        buffer->next_glyph ();
   512	      if (likely (buffer->successful))
   513	        buffer->swap_buffers ();
   514	    }
   515	  }
   516	
   517	  public:
   518	  const StateTable<EntryData> &machine;
   519	  hb_buffer_t *buffer;
   520	  unsigned int num_glyphs;
   521	};
