   450	    bool ret;
   451	    private:
   452	    hb_aat_apply_context_t *c;
   453	    const UnsizedArrayOf<HBUINT32> &ligAction;
   454	    const UnsizedArrayOf<HBUINT16> &component;
   455	    const UnsizedArrayOf<GlyphID> &ligature;
   456	    unsigned int match_length;
   457	    unsigned int match_positions[HB_MAX_CONTEXT_LENGTH];
   458	  };
