   391	        unsigned int action_idx = entry->data.ligActionIndex;
   392	        unsigned int action;
   393	        unsigned int ligature_idx = 0;
   394	
   395	        if (unlikely (!match_length))
   396	          return false;
   397	
   398	        buffer->merge_out_clusters (match_positions[0], buffer->out_len);
   399	
   400	        do
   401	        {
   402	          if (unlikely (!match_length))
   403	            return false;
   404	
   405	          buffer->move_to (match_positions[--match_length]);
   406	
   407	          const HBUINT32 &actionData = ligAction[action_idx];
   408	          if (unlikely (!actionData.sanitize (&c->sanitizer))) return false;
   409	          action = actionData;
