   288	  inline bool sanitize (hb_sanitize_context_t *c) const
   289	  {
   290	    TRACE_SANITIZE (this);
   291	
   292	    unsigned int num_entries = 0;
   293	    if (unlikely (!machine.sanitize (c, &num_entries))) return_trace (false);
   294	
   295	    unsigned int num_lookups = 0;
   296	
   297	    const Entry<EntryData> *entries = machine.get_entries ();
   298	    for (unsigned int i = 0; i < num_entries; i++)
