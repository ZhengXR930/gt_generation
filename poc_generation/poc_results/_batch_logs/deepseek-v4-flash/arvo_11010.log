   320	struct LigatureSubtable
   321	{
   322	  struct EntryData
   323	  {
   324	    HBUINT16    ligActionIndex; /* Index to the first ligActionTable entry
   325	                                 * for processing this group, if indicated
   326	                                 * by the flags. */
   327	    public:
   328	    DEFINE_SIZE_STATIC (2);
   329	  };
   330	
   331	  struct driver_context_t
   332	  {
   333	    static const bool in_place = false;
   334	    enum Flags
   335	    {
   336	      SetComponent      = 0x8000,       /* Push this glyph onto the component stack for
   337	                                         * eventual processing. */
   338	      DontAdvance       = 0x4000,       /* Leave the glyph pointer at this glyph for the
   339	                                           next iteration. */
   340	      PerformAction     = 0x2000,       /* Use the ligActionIndex to process a ligature
   341	                                         * group. */
   342	      Reserved          = 0x1FFF,       /* These bits are reserved and should be set to 0. */
   343	    };
   344	    enum LigActionFlags
   345	    {
   346	      LigActionLast     = 0x80000000,   /* This is the last action in the list. This also
   347	                                         * implies storage. */
   348	      LigActionStore    = 0x40000000,   /* Store the ligature at the current cumulated index
   349	                                         * in the ligature table in place of the marked
   350	                                         * (i.e. currently-popped) glyph. */
   351	      LigActionOffset   = 0x3FFFFFFF,   /* A 30-bit value which is sign-extended to 32-bits
   352	                                         * and added to the glyph ID, resulting in an index
   353	                                         * into the component table. */
   354	    };
   355	
   356	    inline driver_context_t (const LigatureSubtable *table,
   357	                             hb_aat_apply_context_t *c_) :
   358	        ret (false),
   359	        c (c_),
   360	        ligAction (table+table->ligAction),
   361	        component (table+table->component),
   362	        ligature (table+table->ligature),
   363	        match_length (0) {}
   364	
   365	    inline bool is_actionable (StateTableDriver<EntryData> *driver,
   366	                               const Entry<EntryData> *entry)
   367	    {
   368	      return entry->flags & PerformAction;
   369	    }
   370	    inline bool transition (StateTableDriver<EntryData> *driver,
   371	                            const Entry<EntryData> *entry)
   372	    {
   373	      hb_buffer_t *buffer = driver->buffer;
   374	      unsigned int flags = entry->flags;
   375	
   376	      if (flags & SetComponent)
   377	      {
   378	        if (unlikely (match_length >= ARRAY_LENGTH (match_positions)))
   379	          return false;
   380	
   381	        /* Never mark same index twice, in case DontAdvance was used... */
   382	        if (match_length && match_positions[match_length - 1] == buffer->out_len)
   383	          match_length--;
   384	
   385	        match_positions[match_length++] = buffer->out_len;
   386	      }
   387	
   388	      if (flags & PerformAction)
   389	      {
   390	        unsigned int end = buffer->out_len;
   391	        unsigned int action_idx = entry->data.ligActionIndex;
   392	        unsigned int action;
   393	        unsigned int ligature_idx = 0;
   394	
   395	        if (unlikely (!match_length))
   396	          return false;
   397	
   398	        buffer->merge_out_clusters (match_positions[0], buffer->out_len);
   399	
   400	        do
   401	        {
   402	          if (unlikely (!match_length))
   403	            return false;
   404	
   405	          buffer->move_to (match_positions[--match_length]);
   406	
   407	          const HBUINT32 &actionData = ligAction[action_idx];
   408	          if (unlikely (!actionData.sanitize (&c->sanitizer))) return false;
   409	          action = actionData;
   410	
   411	          uint32_t uoffset = action & LigActionOffset;
   412	          if (uoffset & 0x20000000)
   413	            uoffset += 0xC0000000;
   414	          int32_t offset = (int32_t) uoffset;
   415	          if (buffer->idx >= buffer->len)
   416	            return false; // TODO Work on previous instead?
   417	          unsigned int component_idx = buffer->cur().codepoint + offset;
   418	
   419	          const HBUINT16 &componentData = component[component_idx];
   420	          if (unlikely (!componentData.sanitize (&c->sanitizer))) return false;
   421	          ligature_idx += componentData;
   422	
   423	          if (action & (LigActionStore | LigActionLast))
   424	          {
   425	            const GlyphID &ligatureData = ligature[ligature_idx];
   426	            if (unlikely (!ligatureData.sanitize (&c->sanitizer))) return false;
   427	            hb_codepoint_t lig = ligatureData;
   428	
   429	            match_positions[match_length++] = buffer->out_len;
   430	            buffer->replace_glyph (lig);
   431	
   432	            //ligature_idx = 0; // XXX Yes or no?
   433	          }
   434	          else
   435	          {
   436	            buffer->skip_glyph ();
   437	            end--;
   438	          }
   439	
   440	          action_idx++;
   441	        }
   442	        while (!(action & LigActionLast));
   443	        buffer->move_to (end);
   444	      }
   445	
   446	      return true;
   447	    }
