import struct

def build_font():
    """Build a complete TrueType font with a crafted morx table."""
    
    # Create the 'maxp' table
    maxp_data = struct.pack('>I', 0x00005000)  # version 0.5
    maxp_data += struct.pack('>H', 512)  # numGlyphs
    
    # Create the 'head' table
    head_data = struct.pack('>I', 0x00010000)  # version 1.0
    head_data += struct.pack('>I', 0)  # fontRevision
    head_data += struct.pack('>I', 0)  # checkSumAdjustment (filled later)
    head_data += struct.pack('>I', 0x5F0F3CF5)  # magicNumber
    head_data += struct.pack('>H', 0)  # flags
    head_data += struct.pack('>H', 12)  # unitsPerEm
    head_data += struct.pack('>q', 0)  # created
    head_data += struct.pack('>q', 0)  # modified
    head_data += struct.pack('>h', 0)  # xMin
    head_data += struct.pack('>h', 0)  # yMin
    head_data += struct.pack('>h', 0)  # xMax
    head_data += struct.pack('>h', 0)  # yMax
    head_data += struct.pack('>H', 0)  # macStyle
    head_data += struct.pack('>h', 8)  # lowestRecPPEM
    head_data += struct.pack('>h', 0)  # fontDirectionHint
    head_data += struct.pack('>h', 0)  # indexToLocFormat
    head_data += struct.pack('>h', 0)  # glyphDataFormat
    
    # Create the 'hhea' table
    hhea_data = struct.pack('>I', 0x00010000)  # version 1.0
    hhea_data += struct.pack('>h', 0)  # ascent
    hhea_data += struct.pack('>h', 0)  # descent
