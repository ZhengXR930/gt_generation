   341	template <typename Extra>
   342	struct StateTable
   343	{
   344	  enum State
   345	  {
   346	    STATE_START_OF_TEXT = 0,
   347	    STATE_START_OF_LINE = 1,
   348	  };
   349	  enum Class
   350	  {
   351	    CLASS_END_OF_TEXT = 0,
   352	    CLASS_OUT_OF_BOUNDS = 1,
   353	    CLASS_DELETED_GLYPH = 2,
   354	    CLASS_END_OF_LINE = 3,
   355	  };
   356	
   357	  inline unsigned int get_class (hb_codepoint_t glyph_id, unsigned int num_glyphs) const
   358	  {
   359	    const HBUINT16 *v = (this+classTable).get_value (glyph_id, num_glyphs);
   360	    return v ? (unsigned) *v : (unsigned) CLASS_OUT_OF_BOUNDS;
   361	  }
   362	
   363	  inline const Entry<Extra> *get_entries () const
   364	  {
   365	    return (this+entryTable).arrayZ;
   366	  }
   367	
   368	  inline const Entry<Extra> *get_entryZ (unsigned int state, unsigned int klass) const
   369	  {
   370	    if (unlikely (klass >= nClasses)) return nullptr;
   371	
   372	    const HBUINT16 *states = (this+stateArrayTable).arrayZ;
   373	    const Entry<Extra> *entries = (this+entryTable).arrayZ;
   374	
   375	    unsigned int entry = states[state * nClasses + klass];
   376	
   377	    return &entries[entry];
   378	  }
   379	
   380	  inline bool sanitize (hb_sanitize_context_t *c,
   381	                        unsigned int *num_entries_out = nullptr) const
   382	  {
   383	    TRACE_SANITIZE (this);
   384	    if (unlikely (!(c->check_struct (this) &&
   385	                    classTable.sanitize (c, this)))) return_trace (false);
   386	
   387	    const HBUINT16 *states = (this+stateArrayTable).arrayZ;
   388	    const Entry<Extra> *entries = (this+entryTable).arrayZ;
   389	
   390	    unsigned int num_classes = nClasses;
   391	
   392	    unsigned int num_states = 1;
   393	    unsigned int num_entries = 0;
   394	
   395	    unsigned int state = 0;
   396	    unsigned int entry = 0;
   397	    while (state < num_states)
   398	    {
   399	      if (unlikely (hb_unsigned_mul_overflows (num_classes, states[0].static_size)))
   400	        return_trace (false);
   401	
   402	      if (unlikely (!c->check_array (states,
   403	                                     num_states,
   404	                                     num_classes * states[0].static_size)))
   405	        return_trace (false);
   406	      { /* Sweep new states. */
   407	        const HBUINT16 *stop = &states[num_states * num_classes];
   408	        for (const HBUINT16 *p = &states[state * num_classes]; p < stop; p++)
   409	          num_entries = MAX<unsigned int> (num_entries, *p + 1);
   410	        state = num_states;
   411	      }
   412	
   413	      if (unlikely (!c->check_array (entries, num_entries)))
   414	        return_trace (false);
   415	      { /* Sweep new entries. */
   416	        const Entry<Extra> *stop = &entries[num_entries];
   417	        for (const Entry<Extra> *p = &entries[entry]; p < stop; p++)
   418	          num_states = MAX<unsigned int> (num_states, p->newState + 1);
   419	        entry = num_entries;
   420	      }
   421	    }
   422	
   423	    if (num_entries_out)
   424	      *num_entries_out = num_entries;
   425	
   426	    return_trace (true);
   427	  }
   428	
   429	  protected:
   430	  HBUINT32      nClasses;       /* Number of classes, which is the number of indices
   431	                                 * in a single line in the state array. */
   432	  LOffsetTo<Lookup<HBUINT16>, false>
   433	                classTable;     /* Offset to the class table. */
   434	  LOffsetTo<UnsizedArrayOf<HBUINT16>, false>
   435	                stateArrayTable;/* Offset to the state array. */
   436	  LOffsetTo<UnsizedArrayOf<Entry<Extra> >, false>
   437	                entryTable;     /* Offset to the entry array. */
   438	
   439	  public:
   440	  DEFINE_SIZE_STATIC (16);
   441	};
   442	
   443	template <typename EntryData>
   444	struct StateTableDriver
   445	{
   446	  inline StateTableDriver (const StateTable<EntryData> &machine_,
   447	                           hb_buffer_t *buffer_,
   448	                           hb_face_t *face_) :
   449	              machine (machine_),
   450	              buffer (buffer_),
   451	              num_glyphs (face_->get_num_glyphs ()) {}
   452	
   453	  template <typename context_t>
   454	  inline void drive (context_t *c)
   455	  {
   456	    if (!c->in_place)
   457	      buffer->clear_output ();
   458	
   459	    unsigned int state = StateTable<EntryData>::STATE_START_OF_TEXT;
   460	    bool last_was_dont_advance = false;
   461	    for (buffer->idx = 0;;)
   462	    {
   463	      unsigned int klass = buffer->idx < buffer->len ?
   464	                           machine.get_class (buffer->info[buffer->idx].codepoint, num_glyphs) :
   465	                           (unsigned) StateTable<EntryData>::CLASS_END_OF_TEXT;
   466	      const Entry<EntryData> *entry = machine.get_entryZ (state, klass);
   467	      if (unlikely (!entry))
   468	        break;
   469	
   470	      /* Unsafe-to-break before this if not in state 0, as things might
   471	       * go differently if we start from state 0 here.
   472	       *
   473	       * Ugh.  The indexing here is ugly... */
   474	      if (state && buffer->backtrack_len () && buffer->idx < buffer->len)
   475	      {
   476	        /* If there's no action and we're just epsilon-transitioning to state 0,
   477	         * safe to break. */
   478	        if (c->is_actionable (this, entry) ||
   479	            !(entry->newState == StateTable<EntryData>::STATE_START_OF_TEXT &&
   480	              entry->flags == context_t::DontAdvance))
   481	          buffer->unsafe_to_break_from_outbuffer (buffer->backtrack_len () - 1, buffer->idx + 1);
   482	      }
   483	
   484	      /* Unsafe-to-break if end-of-text would kick in here. */
   485	      if (buffer->idx + 2 <= buffer->len)
   486	      {
   487	        const Entry<EntryData> *end_entry = machine.get_entryZ (state, 0);
   488	        if (c->is_actionable (this, end_entry))
   489	          buffer->unsafe_to_break (buffer->idx, buffer->idx + 2);
   490	      }
   491	
   492	      if (unlikely (!c->transition (this, entry)))
   493	        break;
   494	
   495	      if (unlikely (!buffer->successful)) return;
   496	
   497	      last_was_dont_advance = (entry->flags & context_t::DontAdvance) && buffer->max_ops-- > 0;
   498	
   499	      state = entry->newState;
   500	
   501	      if (buffer->idx == buffer->len)
   502	        break;
   503	
   504	      if (!last_was_dont_advance)
   505	        buffer->next_glyph ();
   506	    }
   507	
   508	    if (!c->in_place)
   509	    {
   510	      for (; buffer->successful && buffer->idx < buffer->len;)
   511	        buffer->next_glyph ();
   512	      if (likely (buffer->successful))
   513	        buffer->swap_buffers ();
   514	    }
   515	  }
   516	
   517	  public:
   518	  const StateTable<EntryData> &machine;
   519	  hb_buffer_t *buffer;
   520	  unsigned int num_glyphs;
   521	};
