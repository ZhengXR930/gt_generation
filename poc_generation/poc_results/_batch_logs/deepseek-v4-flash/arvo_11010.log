    entry_array += struct.pack('>H', 0x8000)  # flags = SetMark
    entry_array += struct.pack('>H', 0)  # markIndex = 0
    entry_array += struct.pack('>H', 0xFFFF)  # currentIndex = 0xFFFF (none)
    
