   185	struct ContextualSubtable
   186	{
   187	  struct EntryData
   188	  {
   189	    HBUINT16    markIndex;      /* Index of the substitution table for the
   190	                                 * marked glyph (use 0xFFFF for none). */
   191	    HBUINT16    currentIndex;   /* Index of the substitution table for the
   192	                                 * current glyph (use 0xFFFF for none). */
   193	    public:
   194	    DEFINE_SIZE_STATIC (4);
   195	  };
   196	
   197	  struct driver_context_t
   198	  {
   199	    static const bool in_place = true;
   200	    enum Flags
   201	    {
   202	      SetMark           = 0x8000,       /* If set, make the current glyph the marked glyph. */
   203	      DontAdvance       = 0x4000,       /* If set, don't advance to the next glyph before
   204	                                         * going to the new state. */
   205	      Reserved          = 0x3FFF,       /* These bits are reserved and should be set to 0. */
   206	    };
   207	
   208	    inline driver_context_t (const ContextualSubtable *table) :
   209	        ret (false),
   210	        mark_set (false),
   211	        mark (0),
   212	        subs (table+table->substitutionTables) {}
   213	
   214	    inline bool is_actionable (StateTableDriver<EntryData> *driver,
   215	                               const Entry<EntryData> *entry)
   216	    {
   217	      hb_buffer_t *buffer = driver->buffer;
   218	
   219	      if (buffer->idx == buffer->len && !mark_set)
   220	        return false;
   221	
   222	      return entry->data.markIndex != 0xFFFF || entry->data.currentIndex != 0xFFFF;
   223	    }
   224	    inline bool transition (StateTableDriver<EntryData> *driver,
   225	                            const Entry<EntryData> *entry)
   226	    {
   227	      hb_buffer_t *buffer = driver->buffer;
   228	
   229	      /* Looks like CoreText applies neither mark nor current substitution for
   230	       * end-of-text if mark was not explicitly set. */
   231	      if (buffer->idx == buffer->len && !mark_set)
   232	        return true;
   233	
   234	      if (entry->data.markIndex != 0xFFFF)
   235	      {
   236	        const Lookup<GlyphID> &lookup = subs[entry->data.markIndex];
   237	        hb_glyph_info_t *info = buffer->info;
   238	        const GlyphID *replacement = lookup.get_value (info[mark].codepoint, driver->num_glyphs);
   239	        if (replacement)
   240	        {
   241	          buffer->unsafe_to_break (mark, MIN (buffer->idx + 1, buffer->len));
   242	          info[mark].codepoint = *replacement;
   243	          ret = true;
   244	        }
   245	      }
   246	      if (entry->data.currentIndex != 0xFFFF)
   247	      {
   248	        unsigned int idx = MIN (buffer->idx, buffer->len - 1);
   249	        const Lookup<GlyphID> &lookup = subs[entry->data.currentIndex];
   250	        hb_glyph_info_t *info = buffer->info;
   251	        const GlyphID *replacement = lookup.get_value (info[idx].codepoint, driver->num_glyphs);
   252	        if (replacement)
   253	        {
   254	          info[idx].codepoint = *replacement;
   255	          ret = true;
   256	        }
   257	      }
   258	
   259	      if (entry->flags & SetMark)
   260	      {
   261	        mark_set = true;
   262	        mark = buffer->idx;
   263	      }
   264	
   265	      return true;
   266	    }
   267	
   268	    public:
   269	    bool ret;
   270	    private:
   271	    bool mark_set;
   272	    unsigned int mark;
   273	    const UnsizedOffsetListOf<Lookup<GlyphID>, HBUINT32> &subs;
   274	  };
   275	
   276	  inline bool apply (hb_aat_apply_context_t *c) const
   277	  {
   278	    TRACE_APPLY (this);
   279	
   280	    driver_context_t dc (this);
   281	
   282	    StateTableDriver<EntryData> driver (machine, c->buffer, c->face);
   283	    driver.drive (&dc);
