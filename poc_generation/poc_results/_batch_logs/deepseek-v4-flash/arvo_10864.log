   557	ssize_t
   558	TunnelIPv6Interface::read(void* data, size_t len)
   559	{
   560	        ssize_t ret = nl::UnixSocket::read(data, len);
   561	        uint8_t *data_bytes = static_cast<uint8_t*>(data);
   562	
   563	        // Remove any subheader, if present.
   564	        if ((ret >= 4) && (data_bytes[0] == 0) && (data_bytes[1] == 0)) {
   565	                ret -= 4;
   566	                memmove(data, static_cast<const void*>(data_bytes + 4), ret);
   567	        }
   568	
   569	        return ret;
   570	}
   571	
   572	ssize_t
   573	TunnelIPv6Interface::write(const void* data, size_t len)
   574	{
   575	#ifdef __APPLE__
   576	        const uint8_t* const data_bytes = static_cast<const uint8_t*>(data);
   577	
   578	        if ((data_bytes[0] != 0) || (data_bytes[0] != 0)) {
   579	                // The utun interface on OS X needs this header.
   580	                // Linux seems to be able to infer the type of the packet
   581	                // with no problems.
   582	                uint8_t packet[len + 4];
   583	                packet[0] = 0;
   584	                packet[1] = 0;
   585	                packet[2] = (PF_INET6 << 8) & 0xFF;
   586	                packet[3] = (PF_INET6 << 0) & 0xFF;
   587	                memcpy(static_cast<void*>(packet + 4), data, len);
   588	                ssize_t ret = nl::UnixSocket::write(packet, len + 4);
   589	                return (ret >= 4)?(ret - 4):(-1);
   590	        }
   591	#endif
   592	        return nl::UnixSocket::write(data, len);
   593	}
