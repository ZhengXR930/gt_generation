   414	bool
   415	TunnelIPv6Interface::add_address(const struct in6_addr *addr, int prefixlen)
   416	{
   417	        bool ret = false;
   418	
   419	        require_action(!IN6_IS_ADDR_UNSPECIFIED(addr), bail, mLastError = EINVAL);
   420	
   421	        if (mUnicastAddresses.count(*addr)) {
   422	                ret = true;
   423	                goto bail;
   424	        }
   425	
   426	        if (is_online()) {
   427	                syslog(LOG_INFO, "Adding address \"%s/%d\" to interface \"%s\"",
   428	                       in6_addr_to_string(*addr).c_str(), prefixlen, mInterfaceName.c_str());
   429	
   430	                require_noerr_action(
   431	                        netif_mgmt_add_ipv6_address(mNetifMgmtFD, mInterfaceName.c_str(), addr->s6_addr, prefixlen),
   432	                        bail,
   433	                        mLastError = errno
   434	                );
   435	                mUnicastAddresses[*addr] = Entry(Entry::kWaitingForAddConfirm, prefixlen);
   436	        } else {
   437	                mUnicastAddresses[*addr] = Entry(Entry::kWaitingToAdd, prefixlen);
   438	        }
   439	
   440	        ret = true;
   441	
   442	bail:
   443	        return ret;
   444	}
