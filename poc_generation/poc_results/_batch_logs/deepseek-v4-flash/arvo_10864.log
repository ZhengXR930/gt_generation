import struct

def packed_uint(value):
    """Encode a value as a Spinel packed unsigned integer."""
    result = bytearray()
    while value >= 0x80:
        result.append((value & 0x7F) | 0x80)
        value >>= 7
    result.append(value & 0x7F)
    return bytes(result)

def hdlc_crc16(data):
    """Compute HDLC CRC16 (CRC-16/CCITT-FALSE)."""
    crc = 0xFFFF
    for byte in data:
        crc ^= byte
        for _ in range(8):
            if crc & 0x0001:
                crc = (crc >> 1) ^ 0x8408
            else:
                crc >>= 1
    return crc ^ 0xFFFF

def hdlc_encode(data):
    """HDLC-encode data with flag bytes and escaping."""
    result = bytearray()
    result.append(0x7E)  # FLAG
    for byte in data:
        if byte in (0x7E, 0x7D, 0x11, 0x13, 0xF8):
            result.append(0x7D)
            result.append(byte ^ 0x20)
        else:
            result.append(byte)
    # CRC
    crc = hdlc_crc16(data)
    crc_bytes = struct.pack('<H', crc)
    for byte in crc_bytes:
        if byte in (0x7E, 0x7D, 0x11, 0x13, 0xF8):
            result.append(0x7D)
            result.append(byte ^ 0x20)
        else:
            result.append(byte)
    result.append(0x7E)  # FLAG
    return bytes(result)

def make_spinel_frame(command, key, value=b''):
    """Create a Spinel frame (without HDLC)."""
    header = 0x80  # SPINEL_HEADER_FLAG | IID=0
    result = bytearray()
    result.append(header)
    result.extend(packed_uint(command))
    result.extend(packed_uint(key))
    result.extend(value)
    return bytes(result)

# Spinel constants
SPINEL_CMD_PROP_VALUE_IS = 6
SPINEL_CMD_PROP_VALUE_INSERTED = 7
SPINEL_CMD_PROP_VALUE_REMOVED = 8
SPINEL_PROP_IPV6_ADDRESS_TABLE = 0x56 + 3  # SPINEL_PROP_IPV6__BEGIN + 3
SPINEL_PROP_THREAD_ON_MESH_NETS = 0x56 + 10  # SPINEL_PROP_THREAD__BEGIN + 10

