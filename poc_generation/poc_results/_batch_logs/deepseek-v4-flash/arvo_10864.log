   141	void
   142	TunnelIPv6Interface::on_address_added(const struct in6_addr &address, uint8_t prefix_len)
   143	{
   144	        if (mUnicastAddresses.count(address)) {
   145	                mUnicastAddresses.erase(address);
   146	        }
   147	
   148	        syslog(LOG_INFO, "TunnelIPv6Interface: \"%s/%d\" was added to \"%s\"", in6_addr_to_string(address).c_str(), prefix_len,
   149	               get_interface_name().c_str());
   150	
   151	        mAddressWasAdded(address, prefix_len);
   152	}
   153	
   154	void
   155	TunnelIPv6Interface::on_address_removed(const struct in6_addr &address, uint8_t prefix_len)
   156	{
   157	        // Ignore "removed" signal if address is the list
   158	        // meaning it was added earlier and we are still
   159	        // waiting to confirm that it is added.
   160	        // This is to address the case where before adding an
   161	        // address on interface it may be first removed.
   162	
   163	        if (!mUnicastAddresses.count(address)) {
   164	                syslog(LOG_INFO, "TunnelIPv6Interface: \"%s/%d\" was removed from \"%s\"", in6_addr_to_string(address).c_str(), prefix_len,
   165	                       get_interface_name().c_str());
   166	
   167	                mAddressWasRemoved(address, prefix_len);
   168	        }
   169	
   170	}
