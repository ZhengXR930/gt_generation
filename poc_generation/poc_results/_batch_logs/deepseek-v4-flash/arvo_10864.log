   417	void
   418	NCPInstanceBase::remove_ncp_originated_address_prefix_route_entries(void)
   419	{
   420	        bool did_remove = false;
   421	
   422	        // We remove all of the addresses/prefixes/routes that originated from the NCP.
   423	
   424	        syslog(LOG_INFO, "Removing all NCP originated addresses");
   425	
   426	        // Unicast addresses
   427	        do {
   428	                std::map<struct in6_addr, UnicastAddressEntry>::iterator iter;
   429	
   430	                did_remove = false;
   431	
   432	                for (iter = mUnicastAddresses.begin(); iter != mUnicastAddresses.end(); iter++) {
   433	                        if (!iter->second.is_from_ncp()) {
   434	                                continue;
   435	                        }
   436	
   437	                        syslog(LOG_INFO, "UnicastAddresses: Removing %s", iter->second.get_description(iter->first).c_str());
   438	                        mPrimaryInterface->remove_address(&iter->first, iter->second.get_prefix_len());
   439	
   440	                        mUnicastAddresses.erase(iter);
   441	                        did_remove = true;
   442	                        break;
