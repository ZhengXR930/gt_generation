   194	
   195	uint8_t
   196	NCPInstanceBase::OnMeshPrefixEntry::encode_flag_set(
   197	        NCPControlInterface::OnMeshPrefixFlags prefix_flag_set,
   198	        NCPControlInterface::OnMeshPrefixPriority priority
   199	) {
   200	        uint8_t flags = 0;
   201	
   202	        switch (priority) {
   203	        case NCPControlInterface::PREFIX_HIGH_PREFERENCE:
   204	                flags |= kPreferenceHigh;
   205	                break;
   206	
   207	        case NCPControlInterface::PREFIX_MEDIUM_PREFERENCE:
   208	                flags |= kPreferenceMedium;
   209	                break;
   210	
   211	        case NCPControlInterface::PREFIX_LOW_PREFRENCE:
   212	                flags |= kPreferenceLow;
   213	                break;
   214	        }
   215	
   216	        if (prefix_flag_set.count(NCPControlInterface::PREFIX_FLAG_ON_MESH)) {
   217	                flags |= kFlagOnMesh;
   218	        }
   219	
   220	        if (prefix_flag_set.count(NCPControlInterface::PREFIX_FLAG_DEFAULT_ROUTE)) {
   221	                flags |= kFlagDefaultRoute;
   222	        }
   223	
   224	        if (prefix_flag_set.count(NCPControlInterface::PREFIX_FLAG_CONFIGURE)) {
   225	                flags |= kFlagConfigure;
   226	        }
   227	
   228	        if (prefix_flag_set.count(NCPControlInterface::PREFIX_FLAG_DHCP)) {
   229	                flags |= kFlagDHCP;
   230	        }
   231	
   232	        if (prefix_flag_set.count(NCPControlInterface::PREFIX_FLAG_SLAAC)) {
   233	                flags |= kFlagSLAAC;
   234	        }
   235	
   236	        if (prefix_flag_set.count(NCPControlInterface::PREFIX_FLAG_PREFERRED)) {
   237	                flags |= kFlagPreferred;
   238	        }
   239	
   240	        return flags;
   241	}
