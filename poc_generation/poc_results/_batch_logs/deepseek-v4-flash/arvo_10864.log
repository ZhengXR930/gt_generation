   374	
   375	void
   376	NCPInstanceBase::remove_all_address_prefix_route_entries(void)
   377	{
   378	        syslog(LOG_INFO, "Removing all address/prefix/route entries");
   379	
   380	        // Unicast addresses
   381	        for (
   382	                std::map<struct in6_addr, UnicastAddressEntry>::iterator iter = mUnicastAddresses.begin();
   383	                iter != mUnicastAddresses.end();
   384	                ++iter
   385	        ) {
   386	                mPrimaryInterface->remove_address(&iter->first, iter->second.get_prefix_len());
   387	        }
   388	
   389	        // Multicast addresses
   390	        for (
   391	                std::map<struct in6_addr, MulticastAddressEntry>::iterator iter = mMulticastAddresses.begin();
   392	                iter != mMulticastAddresses.end();
   393	                ++iter
   394	        ) {
   395	                mPrimaryInterface->leave_multicast_address(&iter->first);
   396	        }
   397	
   398	        // Routes
   399	        for (
   400	                std::map<IPv6Prefix, InterfaceRouteEntry>::iterator iter = mInterfaceRoutes.begin();
   401	                iter != mInterfaceRoutes.end();
   402	                ++iter
   403	        ) {
   404	                mPrimaryInterface->remove_route(&iter->first.get_prefix(), iter->first.get_length(), iter->second.get_metric());
   405	        }
   406	
   407	        memset(&mNCPLinkLocalAddress, 0, sizeof(mNCPLinkLocalAddress));
   408	        memset(&mNCPMeshLocalAddress, 0, sizeof(mNCPMeshLocalAddress));
   409	
   410	        mUnicastAddresses.clear();
   411	        mMulticastAddresses.clear();
   412	        mOnMeshPrefixes.clear();
   413	        mOffMeshRoutes.clear();
   414	        mInterfaceRoutes.clear();
   415	}
