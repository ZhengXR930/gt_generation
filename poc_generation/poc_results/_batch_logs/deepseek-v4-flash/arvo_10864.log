   353	TunnelIPv6Interface::set_up(bool isUp)
   354	{
   355	        int ret = 0;
   356	        bool old = is_up();
   357	
   358	        if (isUp != old) {
   359	                if (isUp) {
   360	                        syslog(LOG_INFO, "Bringing interface %s up. . .", mInterfaceName.c_str());
   361	                } else {
   362	                        syslog(LOG_INFO, "Taking interface %s down. . .", mInterfaceName.c_str());
   363	                }
   364	
   365	                ret = netif_mgmt_set_up(mNetifMgmtFD, mInterfaceName.c_str(), isUp);
   366	
   367	                require_action(ret == 0, bail, mLastError = errno);
   368	        }
   369	
   370	bail:
   371	        return ret;
   372	}
