   217	int
   218	TunnelIPv6Interface::process(void)
   219	{
   220	        uint8_t buffer[4096];
   221	        ssize_t buffer_len(-1);
   222	
   223	        if (mNetlinkFD >= 0) {
   224	                buffer_len = recv(mNetlinkFD, buffer, sizeof(buffer), 0);
   225	        }
   226	
   227	        if (buffer_len > 0) {
   228	                struct nlmsghdr *nlp;
   229	                struct rtmsg *rtp;
   230	                int rta_len;
   231	                struct rtattr *rta;
   232	
   233	                nlp = (struct nlmsghdr *)buffer;
   234	                for (;NLMSG_OK(nlp, buffer_len); nlp=NLMSG_NEXT(nlp, buffer_len))
   235	                {
   236	                        char ifnamebuf[IF_NAMESIZE];
   237	                        if (nlp->nlmsg_type == RTM_NEWADDR || nlp->nlmsg_type == RTM_DELADDR) {
   238	                                struct ifaddrmsg *ifaddr = (struct ifaddrmsg *)NLMSG_DATA(nlp);
   239	                                const char *ifname = if_indextoname(ifaddr->ifa_index, ifnamebuf);
   240	                                struct in6_addr addr;
   241	
   242	                                if ((ifname == NULL) || (get_interface_name() != ifname)) {
   243	                                        continue;
   244	                                }
   245	
   246	                                // get RTNETLINK message header
   247	                                // get start of attributes
   248	                                rta = (struct rtattr *) IFA_RTA(ifaddr);
   249	
   250	                                // get length of attributes
   251	                                rta_len = IFA_PAYLOAD(nlp);
   252	
   253	                                for(;RTA_OK(rta, rta_len); rta = RTA_NEXT(rta, rta_len)) {
   254	                                        switch(rta->rta_type) {
   255	                                        case IFA_ADDRESS:
   256	                                        case IFA_LOCAL:
   257	                                        case IFA_BROADCAST:
   258	                                        case IFA_ANYCAST:
   259	                                                memcpy(addr.s6_addr, RTA_DATA(rta), sizeof(addr));
   260	
   261	                                                if (nlp->nlmsg_type == RTM_NEWADDR) {
   262	                                                        on_address_added(addr, ifaddr->ifa_prefixlen);
   263	                                                } else if (nlp->nlmsg_type == RTM_DELADDR) {
   264	                                                        on_address_removed(addr, ifaddr->ifa_prefixlen);
   265	                                                }
   266	                                                break;
   267	                                        default:
   268	                                                break;
   269	                                        }
   270	                                }
   271	                        } else if (nlp->nlmsg_type == RTM_NEWLINK || nlp->nlmsg_type == RTM_DELLINK) {
   272	                                struct ifinfomsg *ifinfo = (struct ifinfomsg *)NLMSG_DATA(nlp);
   273	                                const char *ifname = if_indextoname(ifinfo->ifi_index, ifnamebuf);
   274	                                bool isUp, isRunning;
   275	
   276	                                if ((ifname == NULL) || (get_interface_name() != ifname)) {
   277	                                        continue;
   278	                                }
   279	
   280	                                isUp = ((ifinfo->ifi_flags & IFF_UP) == IFF_UP);
   281	                                isRunning = ((ifinfo->ifi_flags & IFF_RUNNING) == IFF_RUNNING);
   282	
   283	                                on_link_state_changed(isUp, isRunning);
   284	                        }
   285	                }
   286	        }
   287	
   288	        return nl::UnixSocket::process();
   289	}
