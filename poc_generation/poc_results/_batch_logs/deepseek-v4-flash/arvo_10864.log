   100	void
   101	TunnelIPv6Interface::on_link_state_changed(bool isUp, bool isRunning)
   102	{
   103	        syslog(LOG_INFO, "TunnelIPv6Interface::on_link_state_changed() UP=%d RUNNING=%d", isUp, isRunning);
   104	        if (isRunning != mIsRunning || isUp != mIsUp) {
   105	                if (isRunning && !mIsRunning) {
   106	                        std::map<struct in6_addr, Entry>::iterator iter;
   107	
   108	                        for (iter = mUnicastAddresses.begin(); iter != mUnicastAddresses.end(); ++iter) {
   109	                                if (iter->second.mState != Entry::kWaitingToAdd) {
   110	                                        continue;
   111	                                }
   112	
   113	                                syslog(LOG_INFO, "Adding address \"%s/%d\" to interface \"%s\"",
   114	                                       in6_addr_to_string(iter->first).c_str(), iter->second.mPrefixLen,
   115	                                       mInterfaceName.c_str());
   116	
   117	                                IGNORE_RETURN_VALUE(netif_mgmt_add_ipv6_address(mNetifMgmtFD, mInterfaceName.c_str(),
   118	                                                    iter->first.s6_addr, iter->second.mPrefixLen));
   119	                                iter->second.mState = Entry::kWaitingForAddConfirm;
   120	                        }
   121	
   122	                        for (iter = mMulticastAddresses.begin(); iter != mMulticastAddresses.end();     ++iter) {
   123	                                if (iter->second.mState != Entry::kWaitingToAdd) {
   124	                                        continue;
   125	                                }
   126	
   127	                                syslog(LOG_INFO, "Joining multicast address \"%s\" on interface \"%s\".",
   128	                                       in6_addr_to_string(iter->first).c_str(), mInterfaceName.c_str());
   129	
   130	                                IGNORE_RETURN_VALUE(netif_mgmt_join_ipv6_multicast_address(mNetifMgmtFD, mInterfaceName.c_str(),
   131	                                                    iter->first.s6_addr));
   132	                        }
   133	                        mMulticastAddresses.clear();
   134	                }
   135	                mIsUp = isUp;
   136	                mIsRunning = isRunning;
   137	                mLinkStateChanged(isUp, isRunning);
   138	        }
   139	}
