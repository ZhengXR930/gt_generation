   175	#define LCG32(x)                ((uint32_t)(x)*1664525+1013904223)
   176	
   177	void
   178	TunnelIPv6Interface::setup_signals(void)
   179	{
   180	        int status;
   181	        int fd;
   182	        struct sockaddr_nl la;
   183	
   184	        fd = socket(AF_NETLINK, SOCK_DGRAM, NETLINK_ROUTE);
   185	
   186	        require(fd != -1, bail);
   187	
   188	        memset(&la, 0, sizeof(la));
   189	        la.nl_family = AF_NETLINK;
   190	        la.nl_pad = 0;
   191	        la.nl_groups = RTMGRP_LINK | RTMGRP_IPV6_IFADDR;
   192	
   193	        // We calculate the PID in a pseudo-random way based on the
   194	        // address pointer and the actual process ID.
   195	        la.nl_pid = LCG32(getpid()) ^ LCG32((uint32_t)reinterpret_cast<uintptr_t>(this));
   196	
   197	        status = bind(fd, (struct sockaddr*) &la, sizeof(la));
   198	
   199	        require(status != -1, bail);
   200	
   201	        // Success!
   202	        IGNORE_RETURN_VALUE(fcntl(fd, F_SETFL, O_NONBLOCK));
   203	
   204	        mNetlinkFD = fd;
   205	        fd = -1;
   206	
   207	bail:
   208	
   209	        // Cleanup (If necessary)
   210	        if (fd > 0) {
   211	                close(fd);
   212	        }
   213	
   214	        return;
   215	}
