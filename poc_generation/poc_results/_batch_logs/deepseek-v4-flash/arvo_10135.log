   163	static char *get_pk_name(gnutls_x509_crt_t cert, unsigned *bits)
   164	{
   165	        char oid[MAX_OID_SIZE];
   166	        size_t oid_size;
   167	        oid_size = sizeof(oid);
   168	        int ret;
   169	
   170	        ret = gnutls_x509_crt_get_pk_algorithm(cert, bits);
   171	        if (ret > 0) {
   172	                const char *name = gnutls_pk_algorithm_get_name(ret);
   173	
   174	                if (name != NULL)
   175	                        return gnutls_strdup(name);
   176	        }
   177	
   178	        ret = gnutls_x509_crt_get_pk_oid(cert, oid, &oid_size);
   179	        if (ret < 0)
   180	                return NULL;
   181	
   182	        return gnutls_strdup(oid);
   183	}
