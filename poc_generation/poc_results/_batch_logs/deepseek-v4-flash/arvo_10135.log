   227	int
   228	_gnutls_x509_read_pkalgo_params(ASN1_TYPE src, const char *src_name,
   229	                              gnutls_x509_spki_st *spki, unsigned is_sig)
   230	{
   231	        int result;
   232	        char name[128];
   233	        char oid[MAX_OID_SIZE];
   234	        int oid_size;
   235	
   236	        memset(spki, 0, sizeof(*spki));
   237	
   238	        _gnutls_str_cpy(name, sizeof(name), src_name);
   239	        _gnutls_str_cat(name, sizeof(name), ".algorithm");
   240	
   241	        oid_size = sizeof(oid);
   242	        result = asn1_read_value(src, name, oid, &oid_size);
   243	
   244	        if (result != ASN1_SUCCESS) {
   245	                gnutls_assert();
   246	                return _gnutls_asn2err(result);
   247	        }
   248	
   249	        if (strcmp (oid, PK_PKIX1_RSA_PSS_OID) == 0) {
   250	                gnutls_datum_t tmp = { NULL, 0 };
   251	
   252	                _gnutls_str_cpy(name, sizeof(name), src_name);
   253	                _gnutls_str_cat(name, sizeof(name), ".parameters");
   254	
   255	                result = _gnutls_x509_read_value(src, name, &tmp);
   256	                if (result < 0) {
   257	                        if (!is_sig) {
   258	                                if (result == GNUTLS_E_ASN1_ELEMENT_NOT_FOUND ||
   259	                                    result != GNUTLS_E_ASN1_VALUE_NOT_FOUND) {
   260	                                        /* it is ok to not have parameters in SPKI, but
   261	                                         * not in signatures */
   262	                                        return 0;
   263	                                }
   264	                        }
   265	
   266	                        return gnutls_assert_val(result);
   267	                }
   268	
   269	                result = _gnutls_x509_read_rsa_pss_params(tmp.data, tmp.size,
   270	                                                          spki);
   271	                _gnutls_free_datum(&tmp);
   272	
   273	                if (result < 0)
   274	                        gnutls_assert();
   275	
   276	                return result;
   277	        }
   278	
   279	        return 0;
   280	}
