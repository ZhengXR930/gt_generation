   365	static void print_aia(gnutls_buffer_st * str, const gnutls_datum_t *der)
   366	{
   367	        int err;
   368	        int seq;
   369	        gnutls_datum_t san = { NULL, 0 }, oid = {NULL, 0};
   370	        gnutls_x509_aia_t aia;
   371	        unsigned int san_type;
   372	        
   373	        err = gnutls_x509_aia_init(&aia);
   374	        if (err < 0)
   375	                return;
   376	
   377	        err = gnutls_x509_ext_import_aia(der, aia, 0);
   378	        if (err < 0) {
   379	                addf(str, "error: get_aia: %s\n",
   380	                     gnutls_strerror(err));
   381	                goto cleanup;
   382	        }
   383	
   384	        for (seq=0;;seq++) {
   385	                err = gnutls_x509_aia_get(aia, seq, &oid, &san_type, &san);
   386	                if (err == GNUTLS_E_REQUESTED_DATA_NOT_AVAILABLE)
   387	                        goto cleanup;
   388	                if (err < 0) {
   389	                        addf(str, "error: aia_get: %s\n",
   390	                             gnutls_strerror(err));
   391	                        goto cleanup;
   392	                }
   393	
   394	                if (strcmp((char*)oid.data, GNUTLS_OID_AD_OCSP) == 0)
   395	                        addf(str, _("\t\t\tAccess Method: %s (%s)\n"), GNUTLS_OID_AD_OCSP, "id-ad-ocsp");
   396	                else if (strcmp((char*)oid.data, GNUTLS_OID_AD_CAISSUERS) == 0)
   397	                        addf(str, _("\t\t\tAccess Method: %s (%s)\n"), GNUTLS_OID_AD_CAISSUERS, "id-ad-caIssuers");
   398	                else {
   399	                        addf(str, _("\t\t\tAccess Method: %s (%s)\n"), (char*)oid.data, "UNKNOWN");
   400	                }
   401	
   402	                adds(str, "\t\t\tAccess Location ");
   403	                print_name(str, "", san_type, &san, 0);
   404	        }
   405	
   406	cleanup:
   407	        gnutls_x509_aia_deinit(aia);
   408	}
