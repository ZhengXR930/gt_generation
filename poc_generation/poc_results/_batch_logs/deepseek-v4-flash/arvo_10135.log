        char name[128];
        char oid[MAX_OID_SIZE];
        int oid_size;

        memset(spki, 0, sizeof(*spki));

        _gnutls_str_cpy(name, sizeof(name), src_name);
        _gnutls_str_cat(name, sizeof(name), ".algorithm");

        oid_size = sizeof(oid);
