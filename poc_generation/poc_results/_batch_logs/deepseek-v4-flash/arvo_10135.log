   282	static int write_oid_and_params(ASN1_TYPE dst, const char *dst_name, const char *oid, gnutls_x509_spki_st *params)
   283	{
   284	        int result;
   285	        char name[128];
   286	
   287	        if (params == NULL) {
   288	                gnutls_assert();
   289	                return GNUTLS_E_INVALID_REQUEST;
   290	        }
   291	
   292	        _gnutls_str_cpy(name, sizeof(name), dst_name);
   293	        _gnutls_str_cat(name, sizeof(name), ".algorithm");
   294	
   295	        /* write the OID.
   296	         */
   297	        result = asn1_write_value(dst, name, oid, 1);
   298	        if (result != ASN1_SUCCESS) {
   299	                gnutls_assert();
   300	                return _gnutls_asn2err(result);
   301	        }
   302	
   303	        _gnutls_str_cpy(name, sizeof(name), dst_name);
   304	        _gnutls_str_cat(name, sizeof(name), ".parameters");
   305	
   306	        if (params->pk == GNUTLS_PK_RSA)
   307	                result =
   308	                    asn1_write_value(dst, name, ASN1_NULL, ASN1_NULL_SIZE);
   309	        else if (params->pk == GNUTLS_PK_RSA_PSS) {
   310	                gnutls_datum_t tmp = { NULL, 0 };
   311	
   312	                result = _gnutls_x509_write_rsa_pss_params(params, &tmp);
   313	                if (result < 0)
   314	                        return gnutls_assert_val(result);
   315	
   316	                result = asn1_write_value(dst, name, tmp.data, tmp.size);
   317	                _gnutls_free_datum(&tmp);
   318	        } else
   319	                result = asn1_write_value(dst, name, NULL, 0);
   320	
   321	        if (result != ASN1_SUCCESS && result != ASN1_ELEMENT_NOT_FOUND) {
   322	                /* Here we ignore the element not found error, since this
   323	                 * may have been disabled before.
   324	                 */
   325	                gnutls_assert();
   326	                return _gnutls_asn2err(result);
   327	        }
   328	
   329	        return 0;
   330	}
