        if (ret < 0)
                return ret;

        pk = gnutls_x509_crt_get_pk_algorithm(crt, NULL);
        if (pk < 0) {
                gnutls_assert();
                pk = GNUTLS_PK_UNKNOWN;
        }

        if (pk == GNUTLS_PK_UNKNOWN) {
                print_pk_name(str, crt); /* print basic info only */
                return 0;
        }

        ret = gnutls_pubkey_init(&pubkey);
        if (ret < 0)
                return ret;

