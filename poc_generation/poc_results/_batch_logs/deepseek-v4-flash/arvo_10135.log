   108	/* Extracts DSA and RSA parameters from a certificate.
   109	 */
   110	int
   111	_gnutls_get_asn_mpis(ASN1_TYPE asn, const char *root,
   112	                     gnutls_pk_params_st * params)
   113	{
   114	        int result;
   115	        char name[256];
   116	        gnutls_datum_t tmp = { NULL, 0 };
   117	        gnutls_pk_algorithm_t pk_algorithm;
   118	        gnutls_ecc_curve_t curve;
   119	
   120	        gnutls_pk_params_init(params);
   121	
   122	        result = _gnutls_x509_get_pk_algorithm(asn, root, &curve, NULL);
   123	        if (result < 0) {
   124	                gnutls_assert();
   125	                return result;
   126	        }
   127	
   128	        pk_algorithm = result;
   129	        params->curve = curve;
   130	        params->algo = pk_algorithm;
   131	
   132	        /* Read the algorithm's parameters
   133	         */
   134	        _asnstr_append_name(name, sizeof(name), root,
   135	                            ".algorithm.parameters");
   136	
   137	        /* FIXME: If the parameters are not included in the certificate
   138	         * then the issuer's parameters should be used. This is not
   139	         * needed in practice though.
   140	         */
   141	        if (pk_algorithm != GNUTLS_PK_RSA && pk_algorithm != GNUTLS_PK_EDDSA_ED25519 && pk_algorithm != GNUTLS_PK_ECDH_X25519) {
   142	                /* RSA and EdDSA do not use parameters */
   143	                result = _gnutls_x509_read_value(asn, name, &tmp);
   144	                if (pk_algorithm == GNUTLS_PK_RSA_PSS && 
   145	                    (result == GNUTLS_E_ASN1_VALUE_NOT_FOUND || result == GNUTLS_E_ASN1_ELEMENT_NOT_FOUND)) {
   146	                        goto skip_params;
   147	                }
   148	                if (result < 0) {
   149	                        gnutls_assert();
   150	                        goto error;
   151	                }
   152	
   153	                result =
   154	                     _gnutls_x509_read_pubkey_params(pk_algorithm,
   155	                                                     tmp.data, tmp.size,
   156	                                                     params);
   157	                if (result < 0) {
   158	                        gnutls_assert();
   159	                        goto error;
   160	                }
   161	
   162	                _gnutls_free_datum(&tmp);
   163	        }
   164	
   165	 skip_params:
   166	        /* Now read the public key */
   167	        _asnstr_append_name(name, sizeof(name), root, ".subjectPublicKey");
   168	
   169	        result = _gnutls_x509_read_value(asn, name, &tmp);
   170	        if (result < 0) {
   171	                gnutls_assert();
   172	                goto error;
   173	        }
   174	
   175	        if ((result =
   176	             _gnutls_x509_read_pubkey(pk_algorithm, tmp.data, tmp.size,
   177	                                      params)) < 0) {
   178	                gnutls_assert();
   179	                goto error;
   180	        }
   181	
   182	        result = _gnutls_x509_check_pubkey_params(params);
   183	        if (result < 0) {
   184	                gnutls_assert();
   185	                goto error;
   186	        }
   187	
   188	        result = 0;
   189	
   190	 error:
   191	        if (result < 0)
   192	                gnutls_pk_params_release(params);
   193	        _gnutls_free_datum(&tmp);
   194	        return result;
   195	}
