   282	static void print_proxy(gnutls_buffer_st * str, gnutls_datum_t *der)
   283	{
   284	        int pathlen;
   285	        char *policyLanguage;
   286	        char *policy;
   287	        size_t npolicy;
   288	        int err;
   289	
   290	        err = gnutls_x509_ext_import_proxy(der, &pathlen, &policyLanguage,
   291	                                        &policy, &npolicy);
   292	        if (err < 0) {
   293	                addf(str, "error: get_proxy: %s\n", gnutls_strerror(err));
   294	                return;
   295	        }
   296	
   297	        if (pathlen >= 0)
   298	                addf(str, _("\t\t\tPath Length Constraint: %d\n"),
   299	                     pathlen);
   300	        addf(str, _("\t\t\tPolicy Language: %s"), policyLanguage);
   301	        if (strcmp(policyLanguage, "1.3.6.1.5.5.7.21.1") == 0)
   302	                adds(str, " (id-ppl-inheritALL)\n");
   303	        else if (strcmp(policyLanguage, "1.3.6.1.5.5.7.21.2") == 0)
   304	                adds(str, " (id-ppl-independent)\n");
   305	        else
   306	                adds(str, "\n");
   307	        if (npolicy) {
   308	                adds(str, _("\t\t\tPolicy:\n\t\t\t\tASCII: "));
   309	                _gnutls_buffer_asciiprint(str, policy, npolicy);
   310	                adds(str, _("\n\t\t\t\tHexdump: "));
   311	                _gnutls_buffer_hexprint(str, policy, npolicy);
   312	                adds(str, "\n");
   313	        }
   314	        gnutls_free(policy);
   315	        gnutls_free(policyLanguage);
   316	}
