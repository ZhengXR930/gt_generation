   319	static void print_nc(gnutls_buffer_st * str, const char* prefix, gnutls_datum_t *der)
   320	{
   321	        gnutls_x509_name_constraints_t nc;
   322	        int ret;
   323	        unsigned idx = 0;
   324	        gnutls_datum_t name;
   325	        unsigned type;
   326	        char new_prefix[16];
   327	
   328	        ret = gnutls_x509_name_constraints_init(&nc);
   329	        if (ret < 0)
   330	                return;
   331	
   332	        ret = gnutls_x509_ext_import_name_constraints(der, nc, 0);
   333	        if (ret < 0)
   334	                goto cleanup;
   335	
   336	        snprintf(new_prefix, sizeof(new_prefix), "%s\t\t\t\t", prefix);
   337	
   338	        do {
   339	                ret = gnutls_x509_name_constraints_get_permitted(nc, idx++, &type, &name);
   340	
   341	                if (ret >= 0) {
   342	                        if (idx == 1)
   343	                                addf(str,  _("%s\t\t\tPermitted:\n"), prefix);
   344	
   345	                        print_name(str, new_prefix, type, &name, 1);
   346	                }
   347	        } while (ret == 0);
   348	
   349	        idx = 0;
   350	        do {
   351	                ret = gnutls_x509_name_constraints_get_excluded(nc, idx++, &type, &name);
   352	
   353	                if (ret >= 0) {
   354	                        if (idx == 1)
   355	                                addf(str,  _("%s\t\t\tExcluded:\n"), prefix);
   356	
   357	                        print_name(str, new_prefix, type, &name, 1);
   358	                }
   359	        } while (ret == 0);
   360	
   361	cleanup:
   362	        gnutls_x509_name_constraints_deinit(nc);
   363	}
