   538	static void
   539	print_private_key_usage_period(gnutls_buffer_st * str, const char *prefix, gnutls_datum_t *der)
   540	{
   541	        time_t activation, expiration;
   542	        int err;
   543	        char s[42];
   544	        struct tm t;
   545	        size_t max;
   546	
   547	        err = gnutls_x509_ext_import_private_key_usage_period(der, &activation, &expiration);
   548	        if (err < 0) {
   549	                addf(str, "error: get_private_key_usage_period: %s\n",
   550	                     gnutls_strerror(err));
   551	                return;
   552	        }
   553	
   554	        max = sizeof(s);
   555	
   556	        if (gmtime_r(&activation, &t) == NULL)
   557	                addf(str, "error: gmtime_r (%ld)\n",
   558	                     (unsigned long) activation);
   559	        else if (strftime(s, max, "%a %b %d %H:%M:%S UTC %Y", &t) == 0)
   560	                addf(str, "error: strftime (%ld)\n",
   561	                     (unsigned long) activation);
   562	        else
   563	                addf(str, _("\t\t\tNot Before: %s\n"), s);
   564	
   565	        if (gmtime_r(&expiration, &t) == NULL)
   566	                addf(str, "error: gmtime_r (%ld)\n",
   567	                     (unsigned long) expiration);
   568	        else if (strftime(s, max, "%a %b %d %H:%M:%S UTC %Y", &t) == 0)
   569	                addf(str, "error: strftime (%ld)\n",
   570	                     (unsigned long) expiration);
   571	        else
   572	                addf(str, _("\t\t\tNot After: %s\n"), s);
   573	
   574	}
