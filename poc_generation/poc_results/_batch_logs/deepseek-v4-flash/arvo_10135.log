   127	                break;
   128	
   129	        case GNUTLS_SAN_URI:
   130	                addf(str,  _("%sURI: %.*s\n"), prefix, name->size, NON_NULL(name->data));
   131	                break;
   132	
   133	        case GNUTLS_SAN_IPADDRESS:
   134	                if (!ip_is_cidr)
