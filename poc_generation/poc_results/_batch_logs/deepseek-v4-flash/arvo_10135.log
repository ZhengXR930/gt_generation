   499	static void
   500	print_key_usage2(gnutls_buffer_st * str, const char *prefix, unsigned int key_usage)
   501	{
   502	        if (key_usage & GNUTLS_KEY_DIGITAL_SIGNATURE)
   503	                addf(str, _("%sDigital signature.\n"), prefix);
   504	        if (key_usage & GNUTLS_KEY_NON_REPUDIATION)
   505	                addf(str, _("%sNon repudiation.\n"), prefix);
   506	        if (key_usage & GNUTLS_KEY_KEY_ENCIPHERMENT)
   507	                addf(str, _("%sKey encipherment.\n"), prefix);
   508	        if (key_usage & GNUTLS_KEY_DATA_ENCIPHERMENT)
   509	                addf(str, _("%sData encipherment.\n"), prefix);
   510	        if (key_usage & GNUTLS_KEY_KEY_AGREEMENT)
   511	                addf(str, _("%sKey agreement.\n"), prefix);
   512	        if (key_usage & GNUTLS_KEY_KEY_CERT_SIGN)
   513	                addf(str, _("%sCertificate signing.\n"), prefix);
   514	        if (key_usage & GNUTLS_KEY_CRL_SIGN)
   515	                addf(str, _("%sCRL signing.\n"), prefix);
   516	        if (key_usage & GNUTLS_KEY_ENCIPHER_ONLY)
   517	                addf(str, _("%sKey encipher only.\n"), prefix);
   518	        if (key_usage & GNUTLS_KEY_DECIPHER_ONLY)
   519	                addf(str, _("%sKey decipher only.\n"), prefix);
   520	}
