   111	             || type == GNUTLS_SAN_RFC822NAME
   112	             || type == GNUTLS_SAN_URI) && sname != NULL && strlen(sname) != name->size) {
   113	                adds(str,
   114	                     _("warning: SAN contains an embedded NUL, "
   115	                              "replacing with '!'\n"));
   116	                while (strlen(sname) < name->size)
