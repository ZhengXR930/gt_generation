   190	        unsigned int i;
   191	
   192	        unspec = nl_attr_get(a);
   193	        for (i = 0; i < len; i++) {
   194	            ds_put_char(ds, i ? ' ': '(');
   195	            ds_put_format(ds, "%02x", unspec[i]);
   196	        }
   197	        ds_put_char(ds, ')');
   198	    }
   199	}
