   102	static char *
   103	get_unicode_name(const char *name, int size, int big_endian)
   104	{
   105	    int i, increment;
   106	    char *newname, *ret;
   107	
   108	    if ((name == NULL) || (*name == '\0') || (size <= 0))
   109	        return NULL;
   110	
   111	    newname = (char *)cli_malloc(size * 7 + 1);
   112	    if (newname == NULL) {
   113	        cli_errmsg("get_unicode_name: Unable to allocate memory for newname\n");
   114	        return NULL;
   115	    }
   116	
   117	    if ((!big_endian) && (size & 0x1)) {
   118	        cli_dbgmsg("get_unicode_name: odd number of bytes %d\n", size);
   119	        --size;
   120	    }
   121	
   122	    increment = (big_endian) ? 1 : 2;
   123	    ret       = newname;
   124	
   125	    for (i = 0; i < size; i += increment) {
   126	        if ((!(name[i] & 0x80)) && isprint(name[i])) {
   127	            *ret++ = tolower(name[i]);
   128	        } else {
   129	            if ((name[i] < 10) && (name[i] >= 0)) {
   130	                *ret++ = '_';
   131	                *ret++ = (char)(name[i] + '0');
   132	            } else {
   133	                uint16_t x;
   134	                if ((i + 1) >= size)
   135	                    break;
   136	                x = (uint16_t)((name[i] < 0 ? 0 : name[i] << 8) | name[i + 1]);
   137	
   138	                *ret++ = '_';
   139	                *ret++ = (char)('a' + ((x & 0xF)));
   140	                *ret++ = (char)('a' + ((x >> 4) & 0xF));
   141	                *ret++ = (char)('a' + ((x >> 8) & 0xF));
   142	                *ret++ = 'a';
   143	                *ret++ = 'a';
   144	            }
   145	            *ret++ = '_';
   146	        }
   147	    }
   148	
   149	    *ret = '\0';
   150	
   151	    /* Saves a lot of memory */
   152	    ret = cli_realloc(newname, (ret - newname) + 1);
   153	    return ret ? ret : newname;
   154	}
