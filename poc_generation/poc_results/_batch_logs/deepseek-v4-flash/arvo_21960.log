#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/types.h>
#include <sys/stat.h>

/* Copy the relevant structures and functions from vba_extract.c */
#define VBA_COMPRESSION_WINDOW 4096
#define MIDDLE_SIZE 20

/* Forward declarations */
typedef struct blob {
    unsigned char *data;
    size_t len;
    size_t alloc_len;
} blob;

/* Minimal blob implementation */
static blob *blobCreate(void) {
    blob *b = (blob *)calloc(1, sizeof(blob));
    if (b) {
        b->data = NULL;
        b->len = 0;
        b->alloc_len = 0;
    }
    return b;
}

static void blobDestroy(blob *b) {
    if (b) {
        free(b->data);
        free(b);
    }
}

static int blobAddData(blob *b, const unsigned char *data, size_t len) {
    if (len == 0) return 0;
    if (b->len + len > b->alloc_len) {
        size_t new_len = b->alloc_len ? b->alloc_len * 2 : 4096;
        while (new_len < b->len + len) new_len *= 2;
        unsigned char *new_data = (unsigned char *)realloc(b->data, new_len);
        if (!new_data) return -1;
        b->data = new_data;
        b->alloc_len = new_len;
    }
    memcpy(b->data + b->len, data, len);
    b->len += len;
    return 0;
}

static size_t blobGetDataSize(blob *b) { return b->len; }

static unsigned char *blobToMem(blob *b) { return b->data; }

/* cli_readn replacement */
static int cli_readn(int fd, void *buf, size_t n) {
    size_t total = 0;
    while (total < n) {
        ssize_t r = read(fd, (char *)buf + total, n - total);
        if (r <= 0) return total;
        total += r;
    }
    return total;
}

/* read_uint16 */
static int read_uint16(int fd, uint16_t *u, int big_endian) {
    unsigned char buf[2];
    if (cli_readn(fd, buf, 2) != 2) return 0;
    if (big_endian)
        *u = (uint16_t)((buf[0] << 8) | buf[1]);
    else
        *u = (uint16_t)((buf[1] << 8) | buf[0]);
    return 1;
}

/* Copy the cli_vba_inflate function */
static unsigned char *
cli_vba_inflate(int fd, off_t offset, size_t *size)
{
    unsigned int pos, shift, mask, distance, clean;
    uint8_t flag;
    uint16_t token;
    blob *b;
    unsigned char buffer[VBA_COMPRESSION_WINDOW];

    if (fd < 0)
        return NULL;

    b = blobCreate();

    if (b == NULL)
        return NULL;

    memset(buffer, 0, sizeof(buffer));
    lseek(fd, offset + 3, SEEK_SET);
    clean = 1;
    pos   = 0;

    while (cli_readn(fd, &flag, 1) == 1) {
        for (mask = 1; mask < 0x100; mask <<= 1) {
            unsigned int winpos = pos % VBA_COMPRESSION_WINDOW;
            if (flag & mask) {
                uint16_t len;
                unsigned int srcpos;

                if (!read_uint16(fd, &token, 0)) {
                    blobDestroy(b);
                    if (size)
                        *size = 0;
                    return NULL;
                }
                shift    = 12 - (winpos > 0x10) - (winpos > 0x20) - (winpos > 0x40) - (winpos > 0x80) - (winpos > 0x100) - (winpos > 0x200) - (winpos > 0x400) - (winpos > 0x800);
                len      = (uint16_t)((token & ((1 << shift) - 1)) + 3);
                distance = token >> shift;

                srcpos = pos - distance - 1;
                if ((((srcpos + len) % VBA_COMPRESSION_WINDOW) < winpos) &&
                    ((winpos + len) < VBA_COMPRESSION_WINDOW) &&
                    (((srcpos % VBA_COMPRESSION_WINDOW) + len) < VBA_COMPRESSION_WINDOW) &&
                    (len <= VBA_COMPRESSION_WINDOW)) {
                    srcpos %= VBA_COMPRESSION_WINDOW;
                    memcpy(&buffer[winpos], &buffer[srcpos],
                           len);
                    pos += len;
                } else
                    while (len-- > 0) {
                        srcpos                                 = (pos - distance - 1) % VBA_COMPRESSION_WINDOW;
                        buffer[pos++ % VBA_COMPRESSION_WINDOW] = buffer[srcpos];
                    }
            } else {
                if ((pos != 0) && (winpos == 0) && clean) {
                    if (cli_readn(fd, &token, 2) != 2) {
                        blobDestroy(b);
                        if (size)
                            *size = 0;
                        return NULL;
                    }
                    (void)blobAddData(b, buffer, VBA_COMPRESSION_WINDOW);
                    clean = 0;
                    break;
                }
                if (cli_readn(fd, &buffer[winpos], 1) == 1)
                    pos++;
            }
            clean = 1;
        }
    }

    if (blobAddData(b, buffer, pos % VBA_COMPRESSION_WINDOW) < 0) {
        blobDestroy(b);
        if (size)
            *size = 0;
        return NULL;
    }

    if (size)
        *size = blobGetDataSize(b);
    return (unsigned char *)blobToMem(b);
}

int main(int argc, char *argv[]) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <vba_file>\n", argv[0]);
        return 1;
    }
    
    int fd = open(argv[1], O_RDONLY);
    if (fd < 0) {
        perror("open");
        return 1;
    }
    
    size_t size;
    unsigned char *data = cli_vba_inflate(fd, 0, &size);
    if (data) {
        printf("Decompressed %zu bytes\n", size);
        free(data);
    } else {
        printf("Failed to decompress\n");
    }
    
    close(fd);
    return 0;
}
