   283	static size_t vba_normalize(unsigned char *buffer, size_t size) {
   284	    enum {
   285	        NORMAL = 0,
   286	        IN_STRING = 1,
   287	        UNDERSCORE = 2,
   288	        UNDERSCORE_CR = 3,
   289	        SPACE = 5,
   290	    } state = NORMAL;
   291	    size_t o = 0;
   292	    size_t i;
   293	    for (i = 0; i < size; ++i) {
   294	        //TODO: Don't normalize stuff in comments
   295	        //FIXME: Use UTF glyphs instead of raw bytes
   296	        switch (buffer[i]) {
   297	            case '"':
   298	                if (state == IN_STRING) {
   299	                    state = NORMAL;
   300	                }
   301	                else if (state == NORMAL || state == UNDERSCORE || state == SPACE) {
   302	                    state = IN_STRING;
   303	                }
   304	                buffer[o++] = '"';
   305	                break;
   306	            case '_':
   307	                if (state == SPACE) {
   308	                    state = UNDERSCORE;
   309	                }
   310	                buffer[o++] = '_';
   311	                break;
   312	            case '\r':
   313	                if (state == UNDERSCORE) {
   314	                    state = UNDERSCORE_CR;
   315	                }
   316	                buffer[o++] = '\r';
   317	                break;
   318	            case '\n':
   319	                if (state == UNDERSCORE) {
   320	                    o -= 1;
   321	                    state = SPACE;
   322	                }
   323	                else if (state == UNDERSCORE_CR) {
   324	                    o -= 2;
   325	                    state = SPACE;
   326	                }
   327	                else {
   328	                    buffer[o++] = '\n';;
   329	                }
   330	                break;
   331	            case '\t':
   332	            case ' ':
   333	                if (state != SPACE) {
   334	                    buffer[o++] = ' ';
   335	                }
   336	                if (state == NORMAL || state == UNDERSCORE) {
   337	                    state = SPACE;
   338	                }
   339	                break;
   340	            default:
   341	                if (state == NORMAL || state == UNDERSCORE || state == SPACE) {
   342	                    if (buffer[i] >= 'A' && buffer[i] <= 'Z') {
   343	                        buffer[o++] = (unsigned char) tolower((int) buffer[i]);
   344	                    }
   345	                    else {
   346	                        buffer[o++] = buffer[i];
   347	                    }
   348	                    state = NORMAL;
   349	                }
   350	                else {
   351	                    buffer[o++] = buffer[i];
   352	                }
   353	                break;
   354	        }
   355	    }
   356	    return o;
   357	}
