   184	static int
   185	vba_read_project_strings(int fd, int big_endian)
   186	{
   187	    unsigned char *buf = NULL;
   188	    uint16_t buflen    = 0;
   189	    uint16_t length    = 0;
   190	    int ret = 0, getnewlength = 1;
   191	
   192	    for (;;) {
   193	        off_t offset;
   194	        char *name;
   195	
   196	        /* if no initial name length, exit */
   197	        if (getnewlength && !read_uint16(fd, &length, big_endian)) {
   198	            ret = 0;
   199	            break;
   200	        }
   201	        getnewlength = 0;
   202	
   203	        /* if too short, break */
   204	        if (length < 6) {
   205	            if (lseek(fd, -2, SEEK_CUR) == -1) {
   206	                cli_dbgmsg("vba_read_project_strings: call to lseek() has failed\n");
   207	                ret = 0;
   208	            }
   209	            break;
   210	        }
   211	        /* ensure buffer is large enough */
   212	        if (length > buflen) {
   213	            unsigned char *newbuf = (unsigned char *)cli_realloc(buf, length);
   214	            if (newbuf == NULL) {
   215	                ret = 0;
   216	                break;
   217	            }
   218	            buflen = length;
   219	            buf    = newbuf;
   220	        }
   221	
   222	        /* save current offset */
   223	        offset = lseek(fd, 0, SEEK_CUR);
   224	        if (offset == -1) {
   225	            cli_dbgmsg("vba_read_project_strings: call to lseek() has failed\n");
   226	            ret = 0;
   227	            break;
   228	        }
   229	
   230	        /* if read name failed, break */
   231	        if (cli_readn(fd, buf, (size_t)length) != (size_t)length) {
   232	            cli_dbgmsg("read name failed - rewinding\n");
   233	            if (lseek(fd, offset, SEEK_SET) == -1) {
   234	                cli_dbgmsg("call to lseek() in read name failed\n");
   235	                ret = 0;
   236	            }
   237	            break;
   238	        }
   239	        name = get_unicode_name((const char *)buf, length, big_endian);
   240	        cli_dbgmsg("length: %d, name: %s\n", length, (name) ? name : "[null]");
   241	
   242	        /* if invalid name, break */
   243	        if ((name == NULL) || (memcmp("*\\", name, 2) != 0) ||
   244	            (strchr("ghcd", name[2]) == NULL)) {
   245	            /* Not a valid string, rewind */
   246	            if (lseek(fd, -(length + 2), SEEK_CUR) == -1) {
   247	                cli_dbgmsg("call to lseek() after get_unicode_name has failed\n");
   248	                ret = 0;
   249	            }
   250	            free(name);
   251	            break;
   252	        }
   253	        free(name);
   254	
   255	        /* can't get length, break */
   256	        if (!read_uint16(fd, &length, big_endian)) {
   257	            break;
   258	        }
   259	
   260	        ret++;
   261	
   262	        /* continue on reasonable length value */
   263	        if ((length != 0) && (length != 65535)) {
   264	            continue;
   265	        }
   266	
   267	        /* determine offset and run middle test */
   268	        offset = lseek(fd, 10, SEEK_CUR);
   269	        if (offset == -1) {
   270	            cli_dbgmsg("call to lseek() has failed\n");
   271	            ret = 0;
   272	            break;
   273	        }
   274	        cli_dbgmsg("offset: %lu\n", (unsigned long)offset);
   275	        vba56_test_middle(fd);
   276	        getnewlength = 1;
   277	    }
   278	
   279	    free(buf);
   280	    return ret;
   281	}
