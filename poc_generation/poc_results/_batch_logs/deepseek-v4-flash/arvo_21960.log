#include <fcntl.h>
#include <stdint.h>

#define VBA_COMPRESSION_WINDOW 4096

/* Minimal blob implementation */
typedef struct blob {
    unsigned char *data;
    size_t len;
    size_t alloc;
} blob;

static blob *blobCreate(void) {
    blob *b = (blob *)calloc(1, sizeof(blob));
    return b;
}

static int blobAddData(blob *b, const unsigned char *data, size_t len) {
    if (len == 0) return 0;
    if (b->len + len > b->alloc) {
        size_t newalloc = b->alloc ? b->alloc * 2 : 4096;
        while (newalloc < b->len + len) newalloc *= 2;
        unsigned char *newdata = (unsigned char *)realloc(b->data, newalloc);
        if (!newdata) return -1;
        b->data = newdata;
        b->alloc = newalloc;
    }
    memcpy(b->data + b->len, data, len);
    b->len += len;
    return 0;
}

static size_t blobGetDataSize(blob *b) { return b->len; }
static unsigned char *blobToMem(blob *b) { return b->data; }
static void blobDestroy(blob *b) { free(b->data); free(b); }

static int read_uint16(int fd, uint16_t *u, int big_endian) {
    if (read(fd, u, sizeof(uint16_t)) != sizeof(uint16_t))
        return 0;
    if (big_endian)
        *u = ((*u & 0xFF) << 8) | ((*u >> 8) & 0xFF);
