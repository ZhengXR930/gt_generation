    if (argc != 2) {
        fprintf(stderr, "Usage: %s <input_file>\n", argv[0]);
        return 1;
    }

    FILE *f = fopen(argv[1], "rb");
    if (!f) {
        perror("fopen");
        return 1;
    }

    fseek(f, 0, SEEK_END);
    long sz = ftell(f);
    fseek(f, 0, SEEK_SET);

    if (sz > 32768) sz = 32768;
    uint8_t *data = malloc(sz);
    fread(data, 1, sz, f);
    fclose(f);

    struct config *config;
    struct config_line line;

    config = config_open_for_fuzzing(data, sz);
    if (!config) {
        free(data);
        return 1;
    }

    dump(config, &line, 0);
    config_close(config);
    free(data);
    return 0;
}
