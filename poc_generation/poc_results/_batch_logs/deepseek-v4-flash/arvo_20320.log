   411	
   412	  if (x < INT_MAX / y) {
   413	    int xy = x * y;
   414	    if (xy > v) return 1;
   415	    else {
   416	      if (xy == v) return 0;
   417	      else return -1;
   418	    }
   419	  }
   420	  else
   421	    return 1;
   422	}
