   246	    case OP_STR_1: case OP_STR_2: case OP_STR_3: case OP_STR_4:
   247	    case OP_STR_5: case OP_STR_MB2N1: case OP_STR_MB2N2:
   248	    case OP_STR_MB2N3:
   249	      break;
   250	
   251	    case OP_CCLASS_NOT: case OP_CCLASS:
   252	      xfree(op->cclass.bsp);
   253	      break;
   254	
   255	    case OP_CCLASS_MB_NOT: case OP_CCLASS_MB:
   256	      xfree(op->cclass_mb.mb);
   257	      break;
   258	    case OP_CCLASS_MIX_NOT: case OP_CCLASS_MIX:
   259	      xfree(op->cclass_mix.mb);
   260	      xfree(op->cclass_mix.bsp);
   261	      break;
   262	
   263	    case OP_BACKREF1: case OP_BACKREF2: case OP_BACKREF_N: case OP_BACKREF_N_IC:
   264	      break;
   265	    case OP_BACKREF_MULTI:      case OP_BACKREF_MULTI_IC:
   266	    case OP_BACKREF_WITH_LEVEL:
   267	    case OP_BACKREF_WITH_LEVEL_IC:
   268	    case OP_BACKREF_CHECK:
   269	    case OP_BACKREF_CHECK_WITH_LEVEL:
   270	      if (op->backref_general.num != 1)
   271	        xfree(op->backref_general.ns);
   272	      break;
   273	
   274	    default:
   275	      break;
   276	    }
   277	  }
   278	
   279	  xfree(reg->ops);
   280	#ifdef USE_DIRECT_THREADED_CODE
   281	  xfree(reg->ocs);
   282	  reg->ocs = 0;
   283	#endif
   284	
   285	  reg->ops = 0;
   286	  reg->ops_curr  = 0;
   287	  reg->ops_alloc = 0;
   288	  reg->ops_used  = 0;
   289	}
   290	
   291	static int
   292	ops_calc_size_of_string_pool(regex_t* reg)
   293	{
   294	  int i;
   295	  int total;
   296	
   297	  if (IS_NULL(reg->ops)) return 0;
   298	
   299	  total = 0;
   300	  for (i = 0; i < (int )reg->ops_used; i++) {
   301	    enum OpCode opcode;
   302	    Operation* op;
   303	
   304	    op = reg->ops + i;
   305	#ifdef USE_DIRECT_THREADED_CODE
   306	    opcode = *(reg->ocs + i);
   307	#else
   308	    opcode = op->opcode;
   309	#endif
   310	
   311	    switch (opcode) {
   312	    case OP_STR_MBN:
   313	      total += op->exact_len_n.len * op->exact_len_n.n;
   314	      break;
   315	    case OP_STR_N:
   316	    case OP_STR_MB2N:
   317	      total += op->exact_n.n * 2;
   318	      break;
   319	    case OP_STR_MB3N:
   320	      total += op->exact_n.n * 3;
   321	      break;
   322	
   323	    default:
   324	      break;
   325	    }
   326	  }
   327	
   328	  return total;
   329	}
   330	
   331	static int
   332	ops_make_string_pool(regex_t* reg)
   333	{
   334	  int i;
   335	  int len;
   336	  int size;
   337	  UChar* pool;
   338	  UChar* curr;
   339	
   340	  size = ops_calc_size_of_string_pool(reg);
   341	  if (size <= 0) {
   342	    return 0;
   343	  }
   344	
   345	  curr = pool = (UChar* )xmalloc((size_t )size);
   346	  CHECK_NULL_RETURN_MEMERR(pool);
   347	
   348	  for (i = 0; i < (int )reg->ops_used; i++) {
   349	    enum OpCode opcode;
   350	    Operation* op;
   351	
   352	    op = reg->ops + i;
   353	#ifdef USE_DIRECT_THREADED_CODE
   354	    opcode = *(reg->ocs + i);
   355	#else
   356	    opcode = op->opcode;
   357	#endif
   358	
   359	    switch (opcode) {
   360	    case OP_STR_MBN:
   361	      len = op->exact_len_n.len * op->exact_len_n.n;
   362	      xmemcpy(curr, op->exact_len_n.s, len);
   363	      xfree(op->exact_len_n.s);
   364	      op->exact_len_n.s = curr;
   365	      curr += len;
   366	      break;
   367	    case OP_STR_N:
   368	      len = op->exact_n.n;
   369	    copy:
   370	      xmemcpy(curr, op->exact_n.s, len);
   371	      xfree(op->exact_n.s);
   372	      op->exact_n.s = curr;
   373	      curr += len;
   374	      break;
   375	    case OP_STR_MB2N:
   376	      len = op->exact_n.n * 2;
   377	      goto copy;
   378	      break;
   379	    case OP_STR_MB3N:
   380	      len = op->exact_n.n * 3;
   381	      goto copy;
   382	      break;
   383	
   384	    default:
   385	      break;
   386	    }
   387	  }
   388	
   389	  reg->string_pool     = pool;
   390	  reg->string_pool_end = pool + size;
   391	  return 0;
   392	}
