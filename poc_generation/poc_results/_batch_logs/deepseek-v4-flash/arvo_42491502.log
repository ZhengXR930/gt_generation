int main() {
  blosc_init();
  blosc2_cparams cparams = BLOSC2_CPARAMS_DEFAULTS;
  cparams.clevel = 5;
  cparams.compcode = BLOSC_BLOSCLZ;
  cparams.typesize = 4;
  blosc2_storage storage = {.cparams=&cparams, .contiguous=true};
