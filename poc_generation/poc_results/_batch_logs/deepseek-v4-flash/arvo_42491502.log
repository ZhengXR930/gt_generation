  int64_t len = blosc2_schunk_to_sframe(schunk, &sframe);
  printf("frame len %lld\n", (long long)len);
  FILE* f = fopen("/tmp/frame.bin","wb");
  fwrite(sframe, 1, len, f);
  fclose(f);
  blosc2_schunk_free(schunk);
  blosc_destroy();
  return 0;
}
EOF
