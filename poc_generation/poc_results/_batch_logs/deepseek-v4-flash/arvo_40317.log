                if (!sh)
                        return -LIBBPF_ERRNO__FORMAT;

                if (sh->sh_type == SHT_SYMTAB) {
                        if (obj->efile.symbols) {
                                pr_warn("elf: multiple symbol tables in %s\n", obj->path);
                                return -LIBBPF_ERRNO__FORMAT;
