        while ((scn = elf_nextscn(elf, scn)) != NULL) {
                idx = elf_ndxscn(scn);
                sec_desc = &obj->efile.secs[idx];

                sh = elf_sec_hdr(obj, scn);
                if (!sh)
                        return -LIBBPF_ERRNO__FORMAT;

                name = elf_sec_str(obj, sh->sh_name);
                if (!name)
                        return -LIBBPF_ERRNO__FORMAT;

                if (ignore_elf_section(sh, name))
                        continue;

                data = elf_sec_data(obj, scn);
