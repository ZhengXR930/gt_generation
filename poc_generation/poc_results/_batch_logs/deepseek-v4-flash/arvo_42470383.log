# rangeOffset such that index points past the array.

# Let's make the subtable length = 28 (so glyphIdArrayLength = (28-24)/2 = 2)
# Actual glyphIdArray starts at 26, so actual entries = (28-26)/2 = 1.
# glyphIdArrayLength = 2, so index can be 0 or 1.
