#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <brotli/decode.h>
#include <brotli/encode.h>

// Generate brotli compressed data
void gen_compressed(unsigned char* out, size_t* out_size, size_t target_size) {
    // Compress 200000 bytes of 'A'
    size_t input_size = 200000;
    unsigned char* input = malloc(input_size);
    memset(input, 'A', input_size);
    size_t max_encoded = input_size + input_size / 3 + 128;
    unsigned char* encoded = malloc(max_encoded);
    size_t encoded_size = max_encoded;
    BrotliEncoderCompress(11, 22, BROTLI_MODE_GENERIC, input_size, input,
                          &encoded_size, encoded);
    printf("compressed size: %zu\n", encoded_size);
    // Pad to target_size
    memcpy(out, encoded, encoded_size);
    memset(out + encoded_size, 0, target_size - encoded_size);
    *out_size = target_size;
    free(input);
    free(encoded);
}

void test_size(size_t compressedBufSize) {
    unsigned char* compressed = malloc(compressedBufSize);
    size_t actual_size;
    gen_compressed(compressed, &actual_size, compressedBufSize);
    
    BrotliDecoderState* state = BrotliDecoderCreateInstance(NULL, NULL, NULL);
    size_t available_in = compressedBufSize;
    const uint8_t* next_in = compressed;
    size_t total_out = 0;
    size_t uncompressedLen = compressedBufSize * 2;
    int dos = 0;
    BrotliDecoderResult result;
    unsigned char* arr = malloc(uncompressedLen);
    int overflow = 0;
    
    do {
        arr = realloc(arr, uncompressedLen);
        size_t available_out = uncompressedLen - total_out;
        uint8_t* next_out = arr + total_out;
        // Check if next_out is past the buffer
        if (total_out > uncompressedLen) {
            printf("  OVERFLOW: total_out=%zu > uncompressedLen=%zu\n", total_out, uncompressedLen);
            overflow = 1;
            break;
        }
        result = BrotliDecoderDecompressStream(state, &available_in, &next_in, &available_out, &next_out, &total_out);
        if (result == BROTLI_DECODER_RESULT_SUCCESS) {
            break;
        } else if (result == BROTLI_DECODER_RESULT_NEEDS_MORE_OUTPUT) {
            uncompressedLen *= 2;
            if (uncompressedLen > 131072) {
                if (++dos > 1) break;
                uncompressedLen = 131072;
            }
        } else {
            printf("  ERROR: %s\n", BrotliDecoderErrorString(BrotliDecoderGetErrorCode(state)));
            break;
        }
    } while (result != BROTLI_DECODER_RESULT_SUCCESS);
    
    if (!overflow) {
        printf("  size=%zu: total_out=%zu uncompressedLen=%zu result=%d\n", compressedBufSize, total_out, uncompressedLen, result);
    }
    BrotliDecoderDestroyInstance(state);
    free(arr);
    free(compressed);
}

int main() {
    size_t sizes[] = {14, 100, 1000, 32768, 65536, 100000, 131072};
    for (int i = 0; i < 7; i++) {
        printf("Testing compressedBufSize=%zu\n", sizes[i]);
        test_size(sizes[i]);
    }
    return 0;
}
