    52	{
    53	        char oid[MAX_OID_SIZE];
    54	        ASN1_TYPE c2 = ASN1_TYPE_EMPTY;
    55	        gnutls_datum_t auth_safe = { NULL, 0 };
    56	        int len, result;
    57	        char error_str[ASN1_MAX_ERROR_DESCRIPTION_SIZE];
    58	
    59	        len = sizeof(oid) - 1;
    60	        result =
    61	            asn1_read_value(pkcs12, "authSafe.contentType", oid, &len);
    62	        if (result != ASN1_SUCCESS) {
    63	                gnutls_assert();
    64	                return _gnutls_asn2err(result);
    65	        }
    66	
    67	        if (strcmp(oid, DATA_OID) != 0) {
    68	                gnutls_assert();
    69	                _gnutls_debug_log("Unknown PKCS12 Content OID '%s'\n",
    70	                                  oid);
    71	                return GNUTLS_E_UNKNOWN_PKCS_CONTENT_TYPE;
    72	        }
    73	
    74	        /* Step 1. Read the content data
    75	         */
    76	
    77	        result =
    78	            _gnutls_x509_read_string(pkcs12, "authSafe.content",
    79	                                     &auth_safe, ASN1_ETYPE_OCTET_STRING, 1);
    80	        if (result < 0) {
    81	                gnutls_assert();
    82	                goto cleanup;
    83	        }
    84	
    85	        /* Step 2. Extract the authenticatedSafe.
    86	         */
    87	
    88	        if ((result = asn1_create_element
    89	             (_gnutls_get_pkix(), "PKIX1.pkcs-12-AuthenticatedSafe",
    90	              &c2)) != ASN1_SUCCESS) {
    91	                gnutls_assert();
    92	                result = _gnutls_asn2err(result);
    93	                goto cleanup;
    94	        }
    95	
    96	        result =
    97	            asn1_der_decoding(&c2, auth_safe.data, auth_safe.size,
    98	                              error_str);
    99	        if (result != ASN1_SUCCESS) {
   100	                gnutls_assert();
   101	                _gnutls_debug_log("DER error: %s\n", error_str);
   102	                result = _gnutls_asn2err(result);
   103	                goto cleanup;
   104	        }
   105	
   106	        if (raw == NULL) {
   107	                _gnutls_free_datum(&auth_safe);
   108	        } else {
   109	                raw->data = auth_safe.data;
   110	                raw->size = auth_safe.size;
   111	        }
   112	
   113	        if (authen_safe)
   114	                *authen_safe = c2;
   115	        else
   116	                asn1_delete_structure(&c2);
   117	
   118	        return 0;
   119	
   120	      cleanup:
   121	        if (c2)
   122	                asn1_delete_structure(&c2);
   123	        _gnutls_free_datum(&auth_safe);
   124	        return result;
   125	}
   126	
   127	static int pkcs12_reinit(gnutls_pkcs12_t pkcs12)
   128	{
   129	int result;
   130	
   131	        if (pkcs12->pkcs12)
   132	                asn1_delete_structure(&pkcs12->pkcs12);
   133	
   134	        result = asn1_create_element(_gnutls_get_pkix(),
   135	                                         "PKIX1.pkcs-12-PFX",
   136	                                         &pkcs12->pkcs12);
   137	        if (result != ASN1_SUCCESS) {
   138	                gnutls_assert();
   139	                return _gnutls_asn2err(result);
   140	        }
   141	
   142	        return 0;
   143	}
   144	
   145	/**
   146	 * gnutls_pkcs12_init:
   147	 * @pkcs12: A pointer to the type to be initialized
   148	 *
   149	 * This function will initialize a PKCS12 type. PKCS12 structures
   150	 * usually contain lists of X.509 Certificates and X.509 Certificate
   151	 * revocation lists.
   152	 *
   153	 * Returns: On success, %GNUTLS_E_SUCCESS (0) is returned, otherwise a
   154	 *   negative error value.
   155	 **/
   156	int gnutls_pkcs12_init(gnutls_pkcs12_t * pkcs12)
   157	{
   158	        *pkcs12 = gnutls_calloc(1, sizeof(gnutls_pkcs12_int));
   159	
   160	        if (*pkcs12) {
   161	                int result = pkcs12_reinit(*pkcs12);
   162	                if (result < 0) {
   163	                        gnutls_assert();
   164	                        gnutls_free(*pkcs12);
   165	                        return result;
   166	                }
   167	                return 0;       /* success */
   168	        }
   169	        return GNUTLS_E_MEMORY_ERROR;
   170	}
   171	
   172	/**
   173	 * gnutls_pkcs12_deinit:
   174	 * @pkcs12: The type to be initialized
   175	 *
   176	 * This function will deinitialize a PKCS12 type.
   177	 **/
   178	void gnutls_pkcs12_deinit(gnutls_pkcs12_t pkcs12)
   179	{
   180	        if (!pkcs12)
   181	                return;
   182	
   183	        if (pkcs12->pkcs12)
   184	                asn1_delete_structure(&pkcs12->pkcs12);
   185	
   186	        gnutls_free(pkcs12);
   187	}
   188	
   189	/**
   190	 * gnutls_pkcs12_import:
   191	 * @pkcs12: The data to store the parsed PKCS12.
   192	 * @data: The DER or PEM encoded PKCS12.
   193	 * @format: One of DER or PEM
   194	 * @flags: an ORed sequence of gnutls_privkey_pkcs8_flags
   195	 *
   196	 * This function will convert the given DER or PEM encoded PKCS12
   197	 * to the native gnutls_pkcs12_t format. The output will be stored in 'pkcs12'.
   198	 *
   199	 * If the PKCS12 is PEM encoded it should have a header of "PKCS12".
   200	 *
   201	 * Returns: On success, %GNUTLS_E_SUCCESS (0) is returned, otherwise a
   202	 *   negative error value.
   203	 **/
   204	int
   205	gnutls_pkcs12_import(gnutls_pkcs12_t pkcs12,
   206	                     const gnutls_datum_t * data,
   207	                     gnutls_x509_crt_fmt_t format, unsigned int flags)
   208	{
   209	        int result = 0, need_free = 0;
   210	        gnutls_datum_t _data;
   211	        char error_str[ASN1_MAX_ERROR_DESCRIPTION_SIZE];
   212	
   213	        _data.data = data->data;
   214	        _data.size = data->size;
   215	
   216	        if (pkcs12 == NULL) {
   217	                gnutls_assert();
   218	                return GNUTLS_E_INVALID_REQUEST;
   219	        }
   220	
   221	        /* If the PKCS12 is in PEM format then decode it
   222	         */
   223	        if (format == GNUTLS_X509_FMT_PEM) {
   224	                result =
   225	                    _gnutls_fbase64_decode(PEM_PKCS12, data->data,
   226	                                           data->size, &_data);
   227	
   228	                if (result < 0) {
   229	                        gnutls_assert();
   230	                        return result;
   231	                }
   232	
   233	                need_free = 1;
   234	        }
   235	
   236	        if (pkcs12->expanded) {
   237	                result = pkcs12_reinit(pkcs12);
   238	                if (result < 0) {
   239	                        gnutls_assert();
   240	                        goto cleanup;
   241	                }
   242	        }
   243	        pkcs12->expanded = 1;
   244	
   245	        result =
   246	            asn1_der_decoding(&pkcs12->pkcs12, _data.data, _data.size,
   247	                              error_str);
   248	        if (result != ASN1_SUCCESS) {
   249	                result = _gnutls_asn2err(result);
   250	                _gnutls_debug_log("DER error: %s\n", error_str);
   251	                gnutls_assert();
   252	                goto cleanup;
   253	        }
   254	
   255	        if (need_free)
   256	                _gnutls_free_datum(&_data);
   257	
   258	        return 0;
   259	
   260	      cleanup:
   261	        if (need_free)
   262	                _gnutls_free_datum(&_data);
   263	        return result;
   264	}
   265	
   266	
   267	/**
   268	 * gnutls_pkcs12_export:
   269	 * @pkcs12: A pkcs12 type
   270	 * @format: the format of output params. One of PEM or DER.
   271	 * @output_data: will contain a structure PEM or DER encoded
   272	 * @output_data_size: holds the size of output_data (and will be
   273	 *   replaced by the actual size of parameters)
   274	 *
   275	 * This function will export the pkcs12 structure to DER or PEM format.
   276	 *
   277	 * If the buffer provided is not long enough to hold the output, then
   278	 * *output_data_size will be updated and GNUTLS_E_SHORT_MEMORY_BUFFER
   279	 * will be returned.
   280	 *
   281	 * If the structure is PEM encoded, it will have a header
   282	 * of "BEGIN PKCS12".
   283	 *
   284	 * Returns: In case of failure a negative error code will be
   285	 *   returned, and 0 on success.
   286	 **/
   287	int
   288	gnutls_pkcs12_export(gnutls_pkcs12_t pkcs12,
   289	                     gnutls_x509_crt_fmt_t format, void *output_data,
   290	                     size_t * output_data_size)
   291	{
   292	        if (pkcs12 == NULL) {
   293	                gnutls_assert();
   294	                return GNUTLS_E_INVALID_REQUEST;
   295	        }
   296	
   297	        return _gnutls_x509_export_int(pkcs12->pkcs12, format, PEM_PKCS12,
   298	                                       output_data, output_data_size);
   299	}
   300	
   301	/**
   302	 * gnutls_pkcs12_export2:
   303	 * @pkcs12: A pkcs12 type
   304	 * @format: the format of output params. One of PEM or DER.
   305	 * @out: will contain a structure PEM or DER encoded
   306	 *
   307	 * This function will export the pkcs12 structure to DER or PEM format.
   308	 *
   309	 * The output buffer is allocated using gnutls_malloc().
   310	 *
   311	 * If the structure is PEM encoded, it will have a header
   312	 * of "BEGIN PKCS12".
   313	 *
   314	 * Returns: In case of failure a negative error code will be
   315	 *   returned, and 0 on success.
   316	 *
   317	 * Since: 3.1.3
   318	 **/
   319	int
   320	gnutls_pkcs12_export2(gnutls_pkcs12_t pkcs12,
   321	                      gnutls_x509_crt_fmt_t format, gnutls_datum_t * out)
   322	{
   323	        if (pkcs12 == NULL) {
   324	                gnutls_assert();
   325	                return GNUTLS_E_INVALID_REQUEST;
   326	        }
   327	
   328	        return _gnutls_x509_export_int2(pkcs12->pkcs12, format, PEM_PKCS12,
   329	                                        out);
   330	}
   331	
   332	static int oid2bag(const char *oid)
   333	{
   334	        if (strcmp(oid, BAG_PKCS8_KEY) == 0)
   335	                return GNUTLS_BAG_PKCS8_KEY;
   336	        if (strcmp(oid, BAG_PKCS8_ENCRYPTED_KEY) == 0)
   337	                return GNUTLS_BAG_PKCS8_ENCRYPTED_KEY;
   338	        if (strcmp(oid, BAG_CERTIFICATE) == 0)
   339	                return GNUTLS_BAG_CERTIFICATE;
   340	        if (strcmp(oid, BAG_CRL) == 0)
   341	                return GNUTLS_BAG_CRL;
   342	        if (strcmp(oid, BAG_SECRET) == 0)
   343	                return GNUTLS_BAG_SECRET;
   344	
   345	        return GNUTLS_BAG_UNKNOWN;
   346	}
   347	
   348	static const char *bag_to_oid(int bag)
   349	{
   350	        switch (bag) {
   351	        case GNUTLS_BAG_PKCS8_KEY:
   352	                return BAG_PKCS8_KEY;
   353	        case GNUTLS_BAG_PKCS8_ENCRYPTED_KEY:
   354	                return BAG_PKCS8_ENCRYPTED_KEY;
   355	        case GNUTLS_BAG_CERTIFICATE:
   356	                return BAG_CERTIFICATE;
   357	        case GNUTLS_BAG_CRL:
   358	                return BAG_CRL;
   359	        case GNUTLS_BAG_SECRET:
   360	                return BAG_SECRET;
   361	        }
   362	        return NULL;
   363	}
   364	
   365	/* Decodes the SafeContents, and puts the output in
   366	 * the given bag. 
   367	 */
   368	int
   369	_pkcs12_decode_safe_contents(const gnutls_datum_t * content,
   370	                             gnutls_pkcs12_bag_t bag)
   371	{
   372	        char oid[MAX_OID_SIZE], root[MAX_NAME_SIZE];
   373	        ASN1_TYPE c2 = ASN1_TYPE_EMPTY;
   374	        int len, result;
   375	        int bag_type;
   376	        gnutls_datum_t attr_val;
   377	        gnutls_datum_t t;
   378	        int count = 0, attributes, j;
   379	        unsigned i;
   380	
   381	        /* Step 1. Extract the SEQUENCE.
   382	         */
   383	
   384	        if ((result = asn1_create_element
   385	             (_gnutls_get_pkix(), "PKIX1.pkcs-12-SafeContents",
   386	              &c2)) != ASN1_SUCCESS) {
   387	                gnutls_assert();
   388	                result = _gnutls_asn2err(result);
   389	                goto cleanup;
   390	        }
   391	
   392	        result =
   393	            asn1_der_decoding(&c2, content->data, content->size, NULL);
   394	        if (result != ASN1_SUCCESS) {
   395	                gnutls_assert();
   396	                result = _gnutls_asn2err(result);
   397	                goto cleanup;
   398	        }
   399	
   400	        /* Count the number of bags
   401	         */
   402	        result = asn1_number_of_elements(c2, "", &count);
   403	        if (result != ASN1_SUCCESS) {
   404	                gnutls_assert();
   405	                result = _gnutls_asn2err(result);
   406	                goto cleanup;
   407	        }
   408	
   409	        bag->bag_elements = MIN(MAX_BAG_ELEMENTS, count);
   410	
   411	        for (i = 0; i < bag->bag_elements; i++) {
   412	
   413	                snprintf(root, sizeof(root), "?%u.bagId", i + 1);
   414	
   415	                len = sizeof(oid);
   416	                result = asn1_read_value(c2, root, oid, &len);
   417	                if (result != ASN1_SUCCESS) {
   418	                        gnutls_assert();
   419	                        result = _gnutls_asn2err(result);
   420	                        goto cleanup;
   421	                }
   422	
   423	                /* Read the Bag type
   424	                 */
   425	                bag_type = oid2bag(oid);
   426	
   427	                if (bag_type < 0) {
   428	                        gnutls_assert();
   429	                        goto cleanup;
   430	                }
   431	
   432	                /* Read the Bag Value
   433	                 */
   434	
   435	                snprintf(root, sizeof(root), "?%u.bagValue", i + 1);
   436	
   437	                result =
   438	                    _gnutls_x509_read_value(c2, root,
   439	                                            &bag->element[i].data);
   440	                if (result < 0) {
   441	                        gnutls_assert();
   442	                        goto cleanup;
   443	                }
   444	
   445	                if (bag_type == GNUTLS_BAG_CERTIFICATE
   446	                    || bag_type == GNUTLS_BAG_CRL
   447	                    || bag_type == GNUTLS_BAG_SECRET) {
   448	                        gnutls_datum_t tmp = bag->element[i].data;
   449	
   450	                        result =
   451	                            _pkcs12_decode_crt_bag(bag_type, &tmp,
   452	                                                   &bag->element[i].data);
   453	                        if (result < 0) {
   454	                                gnutls_assert();
   455	                                goto cleanup;
   456	                        }
   457	
   458	                        _gnutls_free_datum(&tmp);
   459	                }
   460	
   461	                /* read the bag attributes
   462	                 */
   463	                snprintf(root, sizeof(root), "?%u.bagAttributes", i + 1);
   464	
   465	                result = asn1_number_of_elements(c2, root, &attributes);
   466	                if (result != ASN1_SUCCESS
   467	                    && result != ASN1_ELEMENT_NOT_FOUND) {
   468	                        gnutls_assert();
   469	                        result = _gnutls_asn2err(result);
   470	                        goto cleanup;
   471	                }
   472	
   473	                if (attributes < 0)
   474	                        attributes = 1;
   475	
   476	                if (result != ASN1_ELEMENT_NOT_FOUND)
   477	                        for (j = 0; j < attributes; j++) {
   478	
   479	                                snprintf(root, sizeof(root),
   480	                                         "?%u.bagAttributes.?%u", i + 1,
   481	                                         j + 1);
   482	
   483	                                result =
   484	                                    _gnutls_x509_decode_and_read_attribute
   485	                                    (c2, root, oid, sizeof(oid), &attr_val,
   486	                                     1, 0);
   487	
   488	                                if (result < 0) {
   489	                                        gnutls_assert();
   490	                                        continue;       /* continue in case we find some known attributes */
   491	                                }
   492	
   493	                                if (strcmp(oid, KEY_ID_OID) == 0) {
   494	                                        result =
   495	                                            _gnutls_x509_decode_string
   496	                                            (ASN1_ETYPE_OCTET_STRING,
   497	                                             attr_val.data, attr_val.size,
   498	                                             &t, 1);
   499	
   500	                                        _gnutls_free_datum(&attr_val);
   501	                                        if (result < 0) {
   502	                                                gnutls_assert();
   503	                                                _gnutls_debug_log
   504	                                                    ("Error decoding PKCS12 Bag Attribute OID '%s'\n",
   505	                                                     oid);
   506	                                                continue;
   507	                                        }
   508	
   509	                                        _gnutls_free_datum(&bag->element[i].local_key_id);
   510	                                        bag->element[i].local_key_id.data = t.data;
   511	                                        bag->element[i].local_key_id.size = t.size;
   512	                                } else if (strcmp(oid, FRIENDLY_NAME_OID) == 0 && bag->element[i].friendly_name == NULL) {
   513	                                        result =
   514	                                            _gnutls_x509_decode_string
   515	                                            (ASN1_ETYPE_BMP_STRING,
   516	                                             attr_val.data, attr_val.size,
   517	                                             &t, 1);
   518	
   519	                                        _gnutls_free_datum(&attr_val);
   520	                                        if (result < 0) {
   521	                                                gnutls_assert();
   522	                                                _gnutls_debug_log
   523	                                                    ("Error decoding PKCS12 Bag Attribute OID '%s'\n",
   524	                                                     oid);
   525	                                                continue;
   526	                                        }
   527	
   528	                                        gnutls_free(bag->element[i].friendly_name);
   529	                                        bag->element[i].friendly_name = (char *) t.data;
   530	                                } else {
   531	                                        _gnutls_free_datum(&attr_val);
   532	                                        _gnutls_debug_log
   533	                                            ("Unknown PKCS12 Bag Attribute OID '%s'\n",
   534	                                             oid);
   535	                                }
   536	                        }
   537	
   538	
   539	                bag->element[i].type = bag_type;
   540	
   541	        }
   542	
   543	        result = 0;
   544	
   545	      cleanup:
   546	        if (c2)
   547	                asn1_delete_structure(&c2);
   548	        return result;
   549	
   550	}
   551	
   552	
   553	static int
   554	_parse_safe_contents(ASN1_TYPE sc, const char *sc_name,
   555	                     gnutls_pkcs12_bag_t bag)
   556	{
   557	        gnutls_datum_t content = { NULL, 0 };
   558	        int result;
   559	
   560	        /* Step 1. Extract the content.
   561	         */
   562	
   563	        result =
   564	            _gnutls_x509_read_string(sc, sc_name, &content,
   565	                                     ASN1_ETYPE_OCTET_STRING, 1);
   566	        if (result < 0) {
   567	                gnutls_assert();
   568	                goto cleanup;
   569	        }
   570	
   571	        result = _pkcs12_decode_safe_contents(&content, bag);
   572	        if (result < 0) {
   573	                gnutls_assert();
   574	                goto cleanup;
   575	        }
   576	
   577	        _gnutls_free_datum(&content);
   578	
   579	        return 0;
   580	
   581	      cleanup:
   582	        _gnutls_free_datum(&content);
   583	        return result;
   584	}
   585	
   586	
   587	/**
   588	 * gnutls_pkcs12_get_bag:
   589	 * @pkcs12: A pkcs12 type
   590	 * @indx: contains the index of the bag to extract
   591	 * @bag: An initialized bag, where the contents of the bag will be copied
   592	 *
   593	 * This function will return a Bag from the PKCS12 structure.
   594	 *
   595	 * After the last Bag has been read
   596	 * %GNUTLS_E_REQUESTED_DATA_NOT_AVAILABLE will be returned.
   597	 *
   598	 * Returns: On success, %GNUTLS_E_SUCCESS (0) is returned, otherwise a
   599	 *   negative error value.
   600	 **/
   601	int
   602	gnutls_pkcs12_get_bag(gnutls_pkcs12_t pkcs12,
   603	                      int indx, gnutls_pkcs12_bag_t bag)
   604	{
   605	        ASN1_TYPE c2 = ASN1_TYPE_EMPTY;
   606	        int result, len;
   607	        char root2[MAX_NAME_SIZE];
   608	        char oid[MAX_OID_SIZE];
   609	
   610	        if (pkcs12 == NULL) {
   611	                gnutls_assert();
   612	                return GNUTLS_E_INVALID_REQUEST;
   613	        }
   614	
   615	        /* Step 1. decode the data.
   616	         */
   617	        result = _decode_pkcs12_auth_safe(pkcs12->pkcs12, &c2, NULL);
   618	        if (result < 0) {
   619	                gnutls_assert();
   620	                return result;
   621	        }
   622	
   623	        /* Step 2. Parse the AuthenticatedSafe
   624	         */
   625	
   626	        snprintf(root2, sizeof(root2), "?%u.contentType", indx + 1);
   627	
   628	        len = sizeof(oid) - 1;
   629	        result = asn1_read_value(c2, root2, oid, &len);
   630	
   631	        if (result == ASN1_ELEMENT_NOT_FOUND) {
   632	                result = GNUTLS_E_REQUESTED_DATA_NOT_AVAILABLE;
   633	                goto cleanup;
   634	        }
   635	
   636	        if (result != ASN1_SUCCESS) {
   637	                gnutls_assert();
   638	                result = _gnutls_asn2err(result);
   639	                goto cleanup;
   640	        }
   641	
   642	        /* Not encrypted Bag
   643	         */
   644	
   645	        snprintf(root2, sizeof(root2), "?%u.content", indx + 1);
   646	
   647	        if (strcmp(oid, DATA_OID) == 0) {
   648	                result = _parse_safe_contents(c2, root2, bag);
   649	                goto cleanup;
   650	        }
   651	
   652	        /* ENC_DATA_OID needs decryption */
   653	
   654	        result = _gnutls_x509_read_value(c2, root2, &bag->element[0].data);
   655	        if (result < 0) {
   656	                gnutls_assert();
   657	                goto cleanup;
   658	        }
   659	
   660	        bag->element[0].type = GNUTLS_BAG_ENCRYPTED;
   661	        bag->bag_elements = 1;
   662	
   663	        result = 0;
   664	
