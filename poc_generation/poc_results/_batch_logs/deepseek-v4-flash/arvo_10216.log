   375	/**
   376	 * gnutls_pkcs12_bag_set_data:
   377	 * @bag: The bag
   378	 * @type: The data's type
   379	 * @data: the data to be copied.
   380	 *
   381	 * This function will insert the given data of the given type into
   382	 * the bag.
   383	 *
   384	 * Returns: the index of the added bag on success, or a negative
   385	 * value on error.
   386	 **/
   387	int
   388	gnutls_pkcs12_bag_set_data(gnutls_pkcs12_bag_t bag,
   389	                           gnutls_pkcs12_bag_type_t type,
   390	                           const gnutls_datum_t * data)
   391	{
   392	        int ret;
   393	        if (bag == NULL) {
   394	                gnutls_assert();
   395	                return GNUTLS_E_INVALID_REQUEST;
   396	        }
   397	
   398	        if (bag->bag_elements == MAX_BAG_ELEMENTS - 1) {
   399	                gnutls_assert();
   400	                /* bag is full */
   401	                return GNUTLS_E_MEMORY_ERROR;
   402	        }
   403	
   404	        if (bag->bag_elements == 1) {
   405	                /* A bag with a key or an encrypted bag, must have
   406	                 * only one element.
   407	                 */
   408	
   409	                if (bag->element[0].type == GNUTLS_BAG_PKCS8_KEY ||
   410	                    bag->element[0].type == GNUTLS_BAG_PKCS8_ENCRYPTED_KEY
   411	                    || bag->element[0].type == GNUTLS_BAG_ENCRYPTED) {
   412	                        gnutls_assert();
   413	                        return GNUTLS_E_INVALID_REQUEST;
   414	                }
   415	        }
   416	
   417	        ret =
   418	            _gnutls_set_datum(&bag->element[bag->bag_elements].data,
   419	                              data->data, data->size);
   420	
   421	        if (ret < 0) {
   422	                gnutls_assert();
   423	                return ret;
   424	        }
   425	
   426	        bag->element[bag->bag_elements].type = type;
   427	
   428	        bag->bag_elements++;
   429	
   430	        return bag->bag_elements - 1;
   431	}
