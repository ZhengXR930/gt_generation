    if (root) {
        qDebug() << "Root entries:" << root->entries();
        const KArchiveEntry *e = root->entry("a");
        if (e && e->isDirectory()) {
            const KArchiveDirectory *dir = static_cast<const KArchiveDirectory*>(e);
            qDebug() << "Dir a entries:" << dir->entries();
        }
    }
    
    zip.close();
    qDebug() << "Success - no crash!";
    return 0;
}
