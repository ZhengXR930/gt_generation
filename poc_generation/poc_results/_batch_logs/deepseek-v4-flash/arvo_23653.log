   455	/* Allocate and initialize the frontend of a "peers" section found in
   456	 * file <file> at line <linenum> with <id> as ID.
   457	 * Return 0 if succeeded, -1 if not.
   458	 * Note that this function may be called from "default-server"
   459	 * or "peer" lines.
   460	 */
   461	static int init_peers_frontend(const char *file, int linenum,
   462	                               const char *id, struct peers *peers)
   463	{
   464	        struct proxy *p;
   465	
   466	        if (peers->peers_fe) {
   467	                p = peers->peers_fe;
   468	                goto out;
   469	        }
   470	
   471	        p = calloc(1, sizeof *p);
   472	        if (!p) {
   473	                ha_alert("parsing [%s:%d] : out of memory.\n", file, linenum);
   474	                return -1;
   475	        }
   476	
   477	        init_new_proxy(p);
   478	        peers_setup_frontend(p);
   479	        p->parent = peers;
   480	        /* Finally store this frontend. */
   481	        peers->peers_fe = p;
   482	
   483	 out:
   484	        if (id && !p->id)
   485	                p->id = strdup(id);
   486	        free(p->conf.file);
   487	        p->conf.args.file = p->conf.file = strdup(file);
   488	        if (linenum != -1)
   489	                p->conf.args.line = p->conf.line = linenum;
   490	
   491	        return 0;
   492	}
