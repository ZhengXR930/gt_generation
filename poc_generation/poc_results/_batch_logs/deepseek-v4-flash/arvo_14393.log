   387	
   388	/* Returns the first element of current circular deque. This function
   389	 * performs bounds checking. */
   390	static int cdeque_front(struct cdeque* d, void** value) {
   391	    if(d->size > 0) {
   392	        cdeque_front_fast(d, value);
   393	        return CDE_OK;
   394	    } else
