   357	/* Creates a new circular deque object. Capacity must be power of 2: 8, 16, 32,
   358	 * 64, 256, etc. When the user will add another item above current capacity,
   359	 * the circular deque will overwrite the oldest entry. */
   360	static int cdeque_init(struct cdeque* d, int max_capacity_power_of_2) {
   361	    if(d == NULL || max_capacity_power_of_2 == 0)
   362	        return CDE_PARAM;
   363	
   364	    d->cap_mask = max_capacity_power_of_2 - 1;
   365	    d->arr = NULL;
   366	
   367	    if((max_capacity_power_of_2 & d->cap_mask) > 0)
   368	        return CDE_PARAM;
   369	
   370	    cdeque_clear(d);
   371	    d->arr = malloc(sizeof(void*) * max_capacity_power_of_2);
   372	
   373	    return d->arr ? CDE_OK : CDE_ALLOC;
   374	}
