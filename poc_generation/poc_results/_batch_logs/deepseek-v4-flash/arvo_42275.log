import struct

def op(opcode, *operands):
    # operands are uint32 values or strings
    words = []
    for opnd in operands:
        if isinstance(opnd, str):
            b = opnd.encode('utf-8')
            # pad with null to multiple of 4
            b += b'\x00' * ((4 - len(b) % 4) % 4)
            for i in range(0, len(b), 4):
                words.append(struct.unpack('<I', b[i:i+4])[0])
        else:
            words.append(opnd & 0xFFFFFFFF)
    wc = len(words) + 1
    return [ (wc << 16) | opcode ] + words

# Opcodes (SPIR-V 1.0)
