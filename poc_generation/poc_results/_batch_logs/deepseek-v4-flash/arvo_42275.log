import struct
def lit_string_words(s):
    b = s.encode('utf-8') + b'\x00'
    while len(b) % 4 != 0:
        b += b'\x00'
    return list(struct.unpack('<%dI' % (len(b)//4), b))
def inst(opcode, *operands):
    flat = []
    for o in operands:
        if isinstance(o, list): flat.extend(o)
        else: flat.append(o)
    words = [opcode] + flat
    return [(len(words)<<16)|opcode] + flat

FLOAT=1; V2FLOAT=2; INNER=3; OUTER=4; PTR=5; VAR=6; VOID=7; FN=8; MAIN=9; ENTRY=10

# Inner: 20 members. member0=f32@0, member1=vec2@4, then 18 f32.
# Inner align = 8 (due to vec2).
INNER_MEMBERS = [FLOAT, V2FLOAT] + [FLOAT]*18
N_INNER = len(INNER_MEMBERS)  # 20

words=[0x07230203,0x00010000,0,11,0]
words+=inst(17,1)  # OpCapability Shader
words+=inst(14,0,1)  # OpMemoryModel
words+=inst(15,0,MAIN,lit_string_words("main"))  # OpEntryPoint Vertex %main "main"
words+=inst(5,MAIN,lit_string_words("main"))
words+=inst(5,INNER,lit_string_words("Inner"))
words+=inst(5,OUTER,lit_string_words("Outer"))
words+=inst(5,VAR,lit_string_words("u"))
words+=inst(71,OUTER,3)  # OpDecorate %Outer BufferBlock (storage)
words+=inst(71,VAR,33,0)  # DescriptorSet 0
words+=inst(71,VAR,34,0)  # Binding 0

# Inner member offsets: 0, 4, 12, 16, 20, ...
inner_offsets = [0, 4] + [12 + 4*(i-2) for i in range(2, N_INNER)]
for i, off in enumerate(inner_offsets):
    words += inst(72, INNER, i, 35, off)
# Outer member offsets: 0, 4  (Inner at offset 4, not 8-aligned -> resolver fails)
words += inst(72, OUTER, 0, 35, 0)
words += inst(72, OUTER, 1, 35, 4)

words+=inst(22,FLOAT,32)  # %float = OpTypeFloat 32
words+=inst(23,V2FLOAT,FLOAT,2)  # %v2float = OpTypeVector %float 2
words+=inst(30,INNER,*INNER_MEMBERS)  # %Inner = OpTypeStruct ...
words+=inst(30,OUTER,FLOAT,INNER)  # %Outer = OpTypeStruct %float %Inner
words+=inst(32,PTR,3,OUTER)  # %ptr = OpTypePointer Storage %Outer
words+=inst(59,PTR,VAR,3)  # %u = OpVariable %ptr Storage
words+=inst(19,VOID)  # %void = OpTypeVoid
words+=inst(33,FN,VOID)  # %fn = OpTypeFunction %void
words+=inst(54,VOID,MAIN,0,FN)  # %main = OpFunction
words+=inst(248,ENTRY)  # %entry = OpLabel
words+=inst(253)  # OpReturn
words+=inst(56)  # OpFunctionEnd

data=struct.pack('<%dI'%len(words),*words)
open('poc.spv','wb').write(data)
print("wrote",len(data),"bytes, inner members:",N_INNER)
EOF
