import struct
def lit_string_words(s):
    b = s.encode('utf-8') + b'\x00'
    while len(b) % 4 != 0:
        b += b'\x00'
    return list(struct.unpack('<%dI' % (len(b)//4), b))
def inst(opcode, *operands):
    flat = []
    for o in operands:
        if isinstance(o, list): flat.extend(o)
        else: flat.append(o)
    words = [opcode] + flat
    return [(len(words)<<16)|opcode] + flat
FLOAT=1; INNER=2; OUTER=3; PTR=4; VAR=5; VOID=6; FN=7; MAIN=8; ENTRY=9
words=[0x07230203,0x00010000,0,10,0]
words+=inst(17,1)
words+=inst(14,0,1)
words+=inst(15,0,MAIN,lit_string_words("main"))
words+=inst(5,MAIN,lit_string_words("main"))
words+=inst(5,INNER,lit_string_words("Inner"))
words+=inst(5,OUTER,lit_string_words("Outer"))
words+=inst(5,VAR,lit_string_words("u"))
words+=inst(71,OUTER,3)  # BufferBlock
words+=inst(71,VAR,33,0)
words+=inst(71,VAR,34,0)
# Inner: 3 floats, offsets 0,4,8
words+=inst(72,INNER,0,35,0)
words+=inst(72,INNER,1,35,4)
words+=inst(72,INNER,2,35,8)
# Outer: float@0, Inner@4 (not 8-aligned)
words+=inst(72,OUTER,0,35,0)
words+=inst(72,OUTER,1,35,4)
words+=inst(22,FLOAT,32)
words+=inst(30,INNER,FLOAT,FLOAT,FLOAT)
words+=inst(30,OUTER,FLOAT,INNER)
words+=inst(32,PTR,3,OUTER)  # Storage
words+=inst(59,PTR,VAR,3)
words+=inst(19,VOID)
words+=inst(33,FN,VOID)
words+=inst(54,VOID,MAIN,0,FN)
words+=inst(248,ENTRY)
words+=inst(253)
words+=inst(56)
data=struct.pack('<%dI'%len(words),*words)
open('storage.spv','wb').write(data)
print("wrote",len(data))
EOF
