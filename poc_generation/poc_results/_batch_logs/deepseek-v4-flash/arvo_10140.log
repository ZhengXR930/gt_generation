   485	static int load_iv(char **fromp, unsigned char *to, int num)
   486	{
   487	    int v, i;
   488	    char *from;
   489	
   490	    from = *fromp;
   491	    for (i = 0; i < num; i++)
   492	        to[i] = 0;
   493	    num *= 2;
   494	    for (i = 0; i < num; i++) {
   495	        if ((*from >= '0') && (*from <= '9'))
   496	            v = *from - '0';
   497	        else if ((*from >= 'A') && (*from <= 'F'))
   498	            v = *from - 'A' + 10;
   499	        else if ((*from >= 'a') && (*from <= 'f'))
   500	            v = *from - 'a' + 10;
   501	        else {
   502	            OPENSSL_PUT_ERROR(PEM, PEM_R_BAD_IV_CHARS);
   503	            return (0);
   504	        }
   505	        from++;
   506	        to[i / 2] |= v << (long)((!(i & 1)) * 4);
   507	    }
   508	
   509	    *fromp = from;
   510	    return (1);
   511	}
