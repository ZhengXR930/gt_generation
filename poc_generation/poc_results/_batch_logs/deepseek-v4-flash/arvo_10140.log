   151	               !strcmp(nm, PEM_STRING_DSA);
   152	    }
   153	
   154	    /* Permit older strings */
   155	
   156	    if (!strcmp(nm, PEM_STRING_X509_OLD) && !strcmp(name, PEM_STRING_X509))
   157	        return 1;
   158	
   159	    if (!strcmp(nm, PEM_STRING_X509_REQ_OLD) &&
   160	        !strcmp(name, PEM_STRING_X509_REQ))
