   418	int PEM_get_EVP_CIPHER_INFO(char *header, EVP_CIPHER_INFO *cipher)
   419	{
   420	    const EVP_CIPHER *enc = NULL;
   421	    char *p, c;
   422	    char **header_pp = &header;
   423	
   424	    cipher->cipher = NULL;
   425	    OPENSSL_memset(cipher->iv, 0, sizeof(cipher->iv));
   426	    if ((header == NULL) || (*header == '\0') || (*header == '\n'))
   427	        return (1);
   428	    if (strncmp(header, "Proc-Type: ", 11) != 0) {
   429	        OPENSSL_PUT_ERROR(PEM, PEM_R_NOT_PROC_TYPE);
   430	        return (0);
   431	    }
   432	    header += 11;
   433	    if (*header != '4')
   434	        return (0);
   435	    header++;
   436	    if (*header != ',')
   437	        return (0);
   438	    header++;
   439	    if (strncmp(header, "ENCRYPTED", 9) != 0) {
   440	        OPENSSL_PUT_ERROR(PEM, PEM_R_NOT_ENCRYPTED);
   441	        return (0);
   442	    }
   443	    for (; (*header != '\n') && (*header != '\0'); header++) ;
   444	    if (*header == '\0') {
   445	        OPENSSL_PUT_ERROR(PEM, PEM_R_SHORT_HEADER);
   446	        return (0);
   447	    }
   448	    header++;
   449	    if (strncmp(header, "DEK-Info: ", 10) != 0) {
   450	        OPENSSL_PUT_ERROR(PEM, PEM_R_NOT_DEK_INFO);
   451	        return (0);
   452	    }
   453	    header += 10;
   454	
   455	    p = header;
   456	    for (;;) {
   457	        c = *header;
   458	        if (!(((c >= 'A') && (c <= 'Z')) || (c == '-') ||
   459	              ((c >= '0') && (c <= '9'))))
   460	            break;
   461	        header++;
   462	    }
   463	    *header = '\0';
   464	    cipher->cipher = enc = cipher_by_name(p);
   465	    *header = c;
   466	    header++;
   467	
   468	    if (enc == NULL) {
   469	        OPENSSL_PUT_ERROR(PEM, PEM_R_UNSUPPORTED_ENCRYPTION);
   470	        return (0);
   471	    }
   472	    // The IV parameter must be at least 8 bytes long to be used as the salt in
   473	    // the KDF. (This should not happen given |cipher_by_name|.)
   474	    if (EVP_CIPHER_iv_length(enc) < 8) {
   475	        assert(0);
   476	        OPENSSL_PUT_ERROR(PEM, PEM_R_UNSUPPORTED_ENCRYPTION);
   477	        return 0;
   478	    }
   479	    if (!load_iv(header_pp, &(cipher->iv[0]), EVP_CIPHER_iv_length(enc)))
   480	        return (0);
   481	
   482	    return (1);
   483	}
