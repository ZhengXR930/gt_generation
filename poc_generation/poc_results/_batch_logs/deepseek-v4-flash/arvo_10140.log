   372	int PEM_do_header(EVP_CIPHER_INFO *cipher, unsigned char *data, long *plen,
   373	                  pem_password_cb *callback, void *u)
   374	{
   375	    int i = 0, j, o, klen;
   376	    long len;
   377	    EVP_CIPHER_CTX ctx;
   378	    unsigned char key[EVP_MAX_KEY_LENGTH];
   379	    char buf[PEM_BUFSIZE];
   380	
   381	    len = *plen;
   382	
   383	    if (cipher->cipher == NULL)
   384	        return (1);
   385	
   386	    klen = 0;
   387	    if (!callback)
   388	        callback = PEM_def_callback;
   389	    klen = callback(buf, PEM_BUFSIZE, 0, u);
   390	    if (klen <= 0) {
   391	        OPENSSL_PUT_ERROR(PEM, PEM_R_BAD_PASSWORD_READ);
   392	        return (0);
   393	    }
   394	
   395	    if (!EVP_BytesToKey(cipher->cipher, EVP_md5(), &(cipher->iv[0]),
   396	                        (unsigned char *)buf, klen, 1, key, NULL))
   397	        return 0;
   398	
   399	    j = (int)len;
   400	    EVP_CIPHER_CTX_init(&ctx);
   401	    o = EVP_DecryptInit_ex(&ctx, cipher->cipher, NULL, key, &(cipher->iv[0]));
   402	    if (o)
   403	        o = EVP_DecryptUpdate(&ctx, data, &i, data, j);
   404	    if (o)
   405	        o = EVP_DecryptFinal_ex(&ctx, &(data[i]), &j);
   406	    EVP_CIPHER_CTX_cleanup(&ctx);
   407	    OPENSSL_cleanse((char *)buf, sizeof(buf));
   408	    OPENSSL_cleanse((char *)key, sizeof(key));
   409	    if (!o) {
   410	        OPENSSL_PUT_ERROR(PEM, PEM_R_BAD_DECRYPT);
   411	        return (0);
   412	    }
   413	    j += i;
   414	    *plen = j;
   415	    return (1);
   416	}
