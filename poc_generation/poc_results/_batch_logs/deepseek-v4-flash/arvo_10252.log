   139	static void loop_filter_data_reset(LFWorkerData *lf_data,
   140	                                   YV12_BUFFER_CONFIG *frame_buffer,
   141	                                   struct AV1Common *cm, MACROBLOCKD *xd) {
   142	  struct macroblockd_plane *pd = xd->plane;
