   554	static void enqueue_lr_jobs(AV1LrSync *lr_sync, AV1LrStruct *lr_ctxt,
   555	                            AV1_COMMON *cm) {
   556	  FilterFrameCtxt *ctxt = lr_ctxt->ctxt;
   557	
   558	  const int num_planes = av1_num_planes(cm);
   559	  AV1LrMTInfo *lr_job_queue = lr_sync->job_queue;
   560	  int32_t lr_job_counter[2], num_even_lr_jobs = 0;
   561	  lr_sync->jobs_enqueued = 0;
   562	  lr_sync->jobs_dequeued = 0;
   563	
   564	  for (int plane = 0; plane < num_planes; plane++) {
   565	    if (cm->rst_info[plane].frame_restoration_type == RESTORE_NONE) continue;
   566	    num_even_lr_jobs =
   567	        num_even_lr_jobs + ((ctxt[plane].rsi->vert_units_per_tile + 1) >> 1);
   568	  }
   569	  lr_job_counter[0] = 0;
   570	  lr_job_counter[1] = num_even_lr_jobs;
   571	
   572	  for (int plane = 0; plane < num_planes; plane++) {
   573	    if (cm->rst_info[plane].frame_restoration_type == RESTORE_NONE) continue;
   574	    const int is_uv = plane > 0;
   575	    const int ss_y = is_uv && cm->seq_params.subsampling_y;
   576	
   577	    AV1PixelRect tile_rect = ctxt[plane].tile_rect;
   578	    const int unit_size = ctxt[plane].rsi->restoration_unit_size;
   579	
   580	    const int tile_h = tile_rect.bottom - tile_rect.top;
   581	    const int ext_size = unit_size * 3 / 2;
   582	
   583	    int y0 = 0, i = 0;
   584	    while (y0 < tile_h) {
   585	      int remaining_h = tile_h - y0;
   586	      int h = (remaining_h < ext_size) ? remaining_h : unit_size;
   587	
   588	      RestorationTileLimits limits;
   589	      limits.v_start = tile_rect.top + y0;
   590	      limits.v_end = tile_rect.top + y0 + h;
   591	      assert(limits.v_end <= tile_rect.bottom);
   592	      // Offset the tile upwards to align with the restoration processing stripe
   593	      const int voffset = RESTORATION_UNIT_OFFSET >> ss_y;
   594	      limits.v_start = AOMMAX(tile_rect.top, limits.v_start - voffset);
   595	      if (limits.v_end < tile_rect.bottom) limits.v_end -= voffset;
   596	
   597	      assert(lr_job_counter[0] <= num_even_lr_jobs);
   598	
   599	      lr_job_queue[lr_job_counter[i & 1]].lr_unit_row = i;
   600	      lr_job_queue[lr_job_counter[i & 1]].plane = plane;
   601	      lr_job_queue[lr_job_counter[i & 1]].v_start = limits.v_start;
   602	      lr_job_queue[lr_job_counter[i & 1]].v_end = limits.v_end;
   603	      lr_job_queue[lr_job_counter[i & 1]].sync_mode = i & 1;
   604	      if ((i & 1) == 0) {
   605	        lr_job_queue[lr_job_counter[i & 1]].v_copy_start =
   606	            limits.v_start + RESTORATION_BORDER;
   607	        lr_job_queue[lr_job_counter[i & 1]].v_copy_end =
   608	            limits.v_end - RESTORATION_BORDER;
   609	        if (i == 0) {
   610	          assert(limits.v_start == tile_rect.top);
   611	          lr_job_queue[lr_job_counter[i & 1]].v_copy_start = tile_rect.top;
   612	        }
   613	        if (i == (ctxt[plane].rsi->vert_units_per_tile - 1)) {
   614	          assert(limits.v_end == tile_rect.bottom);
   615	          lr_job_queue[lr_job_counter[i & 1]].v_copy_end = tile_rect.bottom;
   616	        }
   617	      } else {
   618	        lr_job_queue[lr_job_counter[i & 1]].v_copy_start =
   619	            AOMMAX(limits.v_start - RESTORATION_BORDER, tile_rect.top);
   620	        lr_job_queue[lr_job_counter[i & 1]].v_copy_end =
   621	            AOMMIN(limits.v_end + RESTORATION_BORDER, tile_rect.bottom);
   622	      }
   623	      lr_job_counter[i & 1]++;
   624	      lr_sync->jobs_enqueued++;
   625	
   626	      y0 += h;
   627	      ++i;
   628	    }
   629	  }
   630	}
