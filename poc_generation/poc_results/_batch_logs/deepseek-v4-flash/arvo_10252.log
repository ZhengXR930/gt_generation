   207	static void enqueue_lf_jobs(AV1LfSync *lf_sync, AV1_COMMON *cm, int start,
   208	                            int stop, int plane_start, int plane_end) {
   209	  int mi_row, plane, dir;
   210	  AV1LfMTInfo *lf_job_queue = lf_sync->job_queue;
   211	  lf_sync->jobs_enqueued = 0;
   212	  lf_sync->jobs_dequeued = 0;
   213	
   214	  for (dir = 0; dir < 2; dir++) {
   215	    for (plane = plane_start; plane < plane_end; plane++) {
   216	      if (plane == 0 && !(cm->lf.filter_level[0]) && !(cm->lf.filter_level[1]))
   217	        break;
   218	      else if (plane == 1 && !(cm->lf.filter_level_u))
   219	        continue;
   220	      else if (plane == 2 && !(cm->lf.filter_level_v))
   221	        continue;
   222	      for (mi_row = start; mi_row < stop; mi_row += MAX_MIB_SIZE) {
   223	        lf_job_queue->mi_row = mi_row;
   224	        lf_job_queue->plane = plane;
   225	        lf_job_queue->dir = dir;
   226	        lf_job_queue++;
   227	        lf_sync->jobs_enqueued++;
   228	      }
   229	    }
   230	  }
   231	}
   232	
   233	AV1LfMTInfo *get_lf_job_info(AV1LfSync *lf_sync) {
   234	  AV1LfMTInfo *cur_job_info = NULL;
   235	
   236	#if CONFIG_MULTITHREAD
   237	  pthread_mutex_lock(lf_sync->job_mutex);
   238	
   239	  if (lf_sync->jobs_dequeued < lf_sync->jobs_enqueued) {
   240	    cur_job_info = lf_sync->job_queue + lf_sync->jobs_dequeued;
   241	    lf_sync->jobs_dequeued++;
   242	  }
   243	
   244	  pthread_mutex_unlock(lf_sync->job_mutex);
   245	#else
   246	  (void)lf_sync;
   247	#endif
   248	
   249	  return cur_job_info;
   250	}
   251	
   252	// Implement row loopfiltering for each thread.
   253	static INLINE void thread_loop_filter_rows(
   254	    const YV12_BUFFER_CONFIG *const frame_buffer, AV1_COMMON *const cm,
   255	    struct macroblockd_plane *planes, MACROBLOCKD *xd,
   256	    AV1LfSync *const lf_sync) {
   257	  const int sb_cols =
   258	      ALIGN_POWER_OF_TWO(cm->mi_cols, MAX_MIB_SIZE_LOG2) >> MAX_MIB_SIZE_LOG2;
   259	  int mi_row, mi_col, plane, dir;
   260	  int r, c;
   261	
   262	  while (1) {
   263	    AV1LfMTInfo *cur_job_info = get_lf_job_info(lf_sync);
   264	
   265	    if (cur_job_info != NULL) {
   266	      mi_row = cur_job_info->mi_row;
   267	      plane = cur_job_info->plane;
   268	      dir = cur_job_info->dir;
   269	      r = mi_row >> MAX_MIB_SIZE_LOG2;
   270	
   271	      if (dir == 0) {
   272	        for (mi_col = 0; mi_col < cm->mi_cols; mi_col += MAX_MIB_SIZE) {
   273	          c = mi_col >> MAX_MIB_SIZE_LOG2;
   274	
   275	          av1_setup_dst_planes(planes, cm->seq_params.sb_size, frame_buffer,
   276	                               mi_row, mi_col, plane, plane + 1);
   277	
   278	          av1_filter_block_plane_vert(cm, xd, plane, &planes[plane], mi_row,
   279	                                      mi_col);
   280	          sync_write(lf_sync, r, c, sb_cols, plane);
   281	        }
   282	      } else if (dir == 1) {
   283	        for (mi_col = 0; mi_col < cm->mi_cols; mi_col += MAX_MIB_SIZE) {
   284	          c = mi_col >> MAX_MIB_SIZE_LOG2;
   285	
   286	          // Wait for vertical edge filtering of the top-right block to be
   287	          // completed
   288	          sync_read(lf_sync, r, c, plane);
   289	
   290	          // Wait for vertical edge filtering of the right block to be
   291	          // completed
   292	          sync_read(lf_sync, r + 1, c, plane);
   293	
   294	          av1_setup_dst_planes(planes, cm->seq_params.sb_size, frame_buffer,
   295	                               mi_row, mi_col, plane, plane + 1);
   296	          av1_filter_block_plane_horz(cm, xd, plane, &planes[plane], mi_row,
   297	                                      mi_col);
   298	        }
   299	      }
   300	    } else {
   301	      break;
   302	    }
   303	  }
   304	}
   305	
   306	// Row-based multi-threaded loopfilter hook
   307	static int loop_filter_row_worker(AV1LfSync *const lf_sync,
   308	                                  LFWorkerData *const lf_data) {
   309	  thread_loop_filter_rows(lf_data->frame_buffer, lf_data->cm, lf_data->planes,
   310	                          lf_data->xd, lf_sync);
   311	  return 1;
   312	}
   313	
   314	static void loop_filter_rows_mt(YV12_BUFFER_CONFIG *frame, AV1_COMMON *cm,
   315	                                MACROBLOCKD *xd, int start, int stop,
   316	                                int plane_start, int plane_end,
   317	                                AVxWorker *workers, int nworkers,
   318	                                AV1LfSync *lf_sync) {
   319	  const AVxWorkerInterface *const winterface = aom_get_worker_interface();
   320	  // Number of superblock rows and cols
   321	  const int sb_rows =
   322	      ALIGN_POWER_OF_TWO(cm->mi_rows, MAX_MIB_SIZE_LOG2) >> MAX_MIB_SIZE_LOG2;
   323	  const int num_workers = nworkers;
   324	  int i;
   325	
   326	  if (!lf_sync->sync_range || sb_rows != lf_sync->rows ||
   327	      num_workers > lf_sync->num_workers) {
   328	    av1_loop_filter_dealloc(lf_sync);
   329	    loop_filter_alloc(lf_sync, cm, sb_rows, cm->width, num_workers);
   330	  }
   331	
   332	  // Initialize cur_sb_col to -1 for all SB rows.
   333	  for (i = 0; i < MAX_MB_PLANE; i++) {
   334	    memset(lf_sync->cur_sb_col[i], -1,
   335	           sizeof(*(lf_sync->cur_sb_col[i])) * sb_rows);
   336	  }
   337	
   338	  enqueue_lf_jobs(lf_sync, cm, start, stop, plane_start, plane_end);
   339	
   340	  // Set up loopfilter thread data.
   341	  for (i = 0; i < num_workers; ++i) {
   342	    AVxWorker *const worker = &workers[i];
   343	    LFWorkerData *const lf_data = &lf_sync->lfdata[i];
   344	
   345	    worker->hook = (AVxWorkerHook)loop_filter_row_worker;
   346	    worker->data1 = lf_sync;
   347	    worker->data2 = lf_data;
   348	
   349	    // Loopfilter data
   350	    loop_filter_data_reset(lf_data, frame, cm, xd);
   351	
   352	    // Start loopfiltering
   353	    if (i == num_workers - 1) {
   354	      winterface->execute(worker);
   355	    } else {
   356	      winterface->launch(worker);
   357	    }
   358	  }
   359	
   360	  // Wait till all rows are finished
   361	  for (i = 0; i < num_workers; ++i) {
   362	    winterface->sync(&workers[i]);
   363	  }
   364	}
   365	
   366	void av1_loop_filter_frame_mt(YV12_BUFFER_CONFIG *frame, AV1_COMMON *cm,
   367	                              MACROBLOCKD *xd, int plane_start, int plane_end,
   368	                              int partial_frame, AVxWorker *workers,
   369	                              int num_workers, AV1LfSync *lf_sync) {
   370	  int start_mi_row, end_mi_row, mi_rows_to_filter;
   371	
   372	  start_mi_row = 0;
   373	  mi_rows_to_filter = cm->mi_rows;
   374	  if (partial_frame && cm->mi_rows > 8) {
   375	    start_mi_row = cm->mi_rows >> 1;
   376	    start_mi_row &= 0xfffffff8;
   377	    mi_rows_to_filter = AOMMAX(cm->mi_rows / 8, 8);
   378	  }
   379	  end_mi_row = start_mi_row + mi_rows_to_filter;
   380	  av1_loop_filter_frame_init(cm, plane_start, plane_end);
   381	
   382	  loop_filter_rows_mt(frame, cm, xd, start_mi_row, end_mi_row, plane_start,
   383	                      plane_end, workers, num_workers, lf_sync);
   384	}
