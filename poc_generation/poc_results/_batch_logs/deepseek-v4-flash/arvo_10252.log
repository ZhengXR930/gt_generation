   632	AV1LrMTInfo *get_lr_job_info(AV1LrSync *lr_sync) {
   633	  AV1LrMTInfo *cur_job_info = NULL;
   634	
   635	#if CONFIG_MULTITHREAD
   636	  pthread_mutex_lock(lr_sync->job_mutex);
   637	
   638	  if (lr_sync->jobs_dequeued < lr_sync->jobs_enqueued) {
   639	    cur_job_info = lr_sync->job_queue + lr_sync->jobs_dequeued;
   640	    lr_sync->jobs_dequeued++;
   641	  }
   642	
   643	  pthread_mutex_unlock(lr_sync->job_mutex);
   644	#else
   645	  (void)lr_sync;
   646	#endif
   647	
   648	  return cur_job_info;
   649	}
