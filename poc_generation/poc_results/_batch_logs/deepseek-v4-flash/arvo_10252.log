   651	// Implement row loop restoration for each thread.
   652	static int loop_restoration_row_worker(AV1LrSync *const lr_sync,
   653	                                       LRWorkerData *lrworkerdata) {
   654	  AV1LrStruct *lr_ctxt = (AV1LrStruct *)lrworkerdata->lr_ctxt;
   655	  FilterFrameCtxt *ctxt = lr_ctxt->ctxt;
   656	  int lr_unit_row;
   657	  int plane;
   658	  const int tile_row = LR_TILE_ROW;
   659	  const int tile_col = LR_TILE_COL;
   660	  const int tile_cols = LR_TILE_COLS;
   661	  const int tile_idx = tile_col + tile_row * tile_cols;
   662	  typedef void (*copy_fun)(const YV12_BUFFER_CONFIG *src_ybc,
   663	                           YV12_BUFFER_CONFIG *dst_ybc, int hstart, int hend,
   664	                           int vstart, int vend);
   665	  static const copy_fun copy_funs[3] = {
   666	    aom_yv12_partial_copy_y, aom_yv12_partial_copy_u, aom_yv12_partial_copy_v
   667	  };
   668	
   669	  while (1) {
   670	    AV1LrMTInfo *cur_job_info = get_lr_job_info(lr_sync);
   671	    if (cur_job_info != NULL) {
   672	      RestorationTileLimits limits;
   673	      sync_read_fn_t on_sync_read;
   674	      sync_write_fn_t on_sync_write;
   675	      limits.v_start = cur_job_info->v_start;
   676	      limits.v_end = cur_job_info->v_end;
   677	      lr_unit_row = cur_job_info->lr_unit_row;
   678	      plane = cur_job_info->plane;
   679	      const int unit_idx0 = tile_idx * ctxt[plane].rsi->units_per_tile;
   680	
   681	      // sync_mode == 1 implies only sync read is required in LR Multi-threading
   682	      // sync_mode == 0 implies only sync write is required.
   683	      on_sync_read =
   684	          cur_job_info->sync_mode == 1 ? lr_sync_read : av1_lr_sync_read_dummy;
   685	      on_sync_write = cur_job_info->sync_mode == 0 ? lr_sync_write
   686	                                                   : av1_lr_sync_write_dummy;
   687	
   688	      av1_foreach_rest_unit_in_row(
   689	          &limits, &(ctxt[plane].tile_rect), lr_ctxt->on_rest_unit, lr_unit_row,
   690	          ctxt[plane].rsi->restoration_unit_size, unit_idx0,
   691	          ctxt[plane].rsi->horz_units_per_tile,
   692	          ctxt[plane].rsi->vert_units_per_tile, plane, &ctxt[plane],
   693	          lrworkerdata->rst_tmpbuf, lrworkerdata->rlbs, on_sync_read,
   694	          on_sync_write, lr_sync);
   695	
   696	      copy_funs[plane](lr_ctxt->dst, lr_ctxt->frame, ctxt[plane].tile_rect.left,
   697	                       ctxt[plane].tile_rect.right, cur_job_info->v_copy_start,
   698	                       cur_job_info->v_copy_end);
   699	    } else {
   700	      break;
   701	    }
   702	  }
   703	  return 1;
   704	}
   705	
   706	static void foreach_rest_unit_in_planes_mt(AV1LrStruct *lr_ctxt,
   707	                                           AVxWorker *workers, int nworkers,
   708	                                           AV1LrSync *lr_sync, AV1_COMMON *cm) {
   709	  FilterFrameCtxt *ctxt = lr_ctxt->ctxt;
   710	
   711	  const int num_planes = av1_num_planes(cm);
   712	
   713	  const AVxWorkerInterface *const winterface = aom_get_worker_interface();
   714	  int num_rows_lr = 0;
   715	
   716	  for (int plane = 0; plane < num_planes; plane++) {
   717	    const AV1PixelRect tile_rect = ctxt[plane].tile_rect;
   718	    const int max_tile_h = tile_rect.bottom - tile_rect.top;
   719	
   720	    const int unit_size = cm->seq_params.sb_size == BLOCK_128X128 ? 128 : 64;
   721	
   722	    num_rows_lr =
   723	        AOMMAX(num_rows_lr, av1_lr_count_units_in_tile(unit_size, max_tile_h));
   724	  }
   725	
   726	  const int num_workers = nworkers;
   727	  int i;
   728	  assert(MAX_MB_PLANE == 3);
   729	
   730	  if (!lr_sync->sync_range || num_rows_lr != lr_sync->rows ||
   731	      num_workers > lr_sync->num_workers || num_planes != lr_sync->num_planes) {
   732	    av1_loop_restoration_dealloc(lr_sync, num_workers);
   733	    loop_restoration_alloc(lr_sync, cm, num_workers, num_rows_lr, num_planes,
   734	                           cm->width);
   735	  }
   736	
   737	  // Initialize cur_sb_col to -1 for all SB rows.
   738	  for (i = 0; i < num_planes; i++) {
   739	    memset(lr_sync->cur_sb_col[i], -1,
   740	           sizeof(*(lr_sync->cur_sb_col[i])) * num_rows_lr);
   741	  }
   742	
   743	  enqueue_lr_jobs(lr_sync, lr_ctxt, cm);
   744	
   745	  // Set up looprestoration thread data.
   746	  for (i = 0; i < num_workers; ++i) {
   747	    AVxWorker *const worker = &workers[i];
   748	    lr_sync->lrworkerdata[i].lr_ctxt = (void *)lr_ctxt;
   749	    worker->hook = (AVxWorkerHook)loop_restoration_row_worker;
   750	    worker->data1 = lr_sync;
   751	    worker->data2 = &lr_sync->lrworkerdata[i];
   752	
   753	    // Start loopfiltering
   754	    if (i == num_workers - 1) {
   755	      winterface->execute(worker);
   756	    } else {
   757	      winterface->launch(worker);
   758	    }
   759	  }
   760	
   761	  // Wait till all rows are finished
   762	  for (i = 0; i < num_workers; ++i) {
   763	    winterface->sync(&workers[i]);
   764	  }
   765	}
   766	
   767	void av1_loop_restoration_filter_frame_mt(YV12_BUFFER_CONFIG *frame,
   768	                                          AV1_COMMON *cm, int optimized_lr,
   769	                                          AVxWorker *workers, int num_workers,
   770	                                          AV1LrSync *lr_sync, void *lr_ctxt) {
   771	  assert(!cm->all_lossless);
   772	
   773	  const int num_planes = av1_num_planes(cm);
   774	
   775	  AV1LrStruct *loop_rest_ctxt = (AV1LrStruct *)lr_ctxt;
   776	
   777	  av1_loop_restoration_filter_frame_init(loop_rest_ctxt, frame, cm,
   778	                                         optimized_lr, num_planes);
   779	
   780	  foreach_rest_unit_in_planes_mt(loop_rest_ctxt, workers, num_workers, lr_sync,
   781	                                 cm);
   782	}



