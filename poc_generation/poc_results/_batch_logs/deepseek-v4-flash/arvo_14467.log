   348	bool SoftimagePICHandler::canRead(QIODevice *device)
   349	{
   350	    char data[4];
   351	    if (device->peek(data, 4) != 4) {
   352	        return false;
   353	    }
   354	    return qFromBigEndian<qint32>(reinterpret_cast<uchar*>(data)) == PIC_MAGIC_NUMBER;
   355	}
