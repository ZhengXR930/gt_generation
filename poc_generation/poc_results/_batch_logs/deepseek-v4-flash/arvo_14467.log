   240	
   241	bool RASHandler::canRead(QIODevice *device)
   242	{
   243	    if (!device) {
   244	        qWarning("RASHandler::canRead() called with no device");
   245	        return false;
   246	    }
   247	
   248	    if (device->isSequential()) {
   249	        // qWarning("Reading ras files from sequential devices not supported");
   250	        return false;
   251	    }
   252	
   253	    qint64 oldPos = device->pos();
   254	    QByteArray head = device->read(RasHeader::SIZE); // header is exactly 32 bytes, always FIXME
   255	    int readBytes = head.size(); // this should always be 32 bytes
   256	
   257	    device->seek(oldPos);
   258	
   259	    if (readBytes < RasHeader::SIZE) {
   260	        return false;
   261	    }
   262	
   263	    QDataStream stream(head);
   264	    stream.setByteOrder(QDataStream::BigEndian);
   265	    RasHeader ras;
   266	    stream >> ras;
   267	    return IsSupported(ras);
   268	}
   269	
   270	bool RASHandler::read(QImage *outImage)
   271	{
   272	    QDataStream s(device());
   273	    s.setByteOrder(QDataStream::BigEndian);
   274	
   275	    // Read image header.
   276	    RasHeader ras;
   277	    s >> ras;
   278	
   279	    if (ras.ColorMapLength > std::numeric_limits<int>::max())
   280	        return false;
   281	
   282	    // TODO: add support for old versions of RAS where Length may be zero in header
   283	    s.device()->seek(RasHeader::SIZE + ras.Length + ras.ColorMapLength);
   284	
   285	    // Check image file format. Type 2 is RLE, which causing seeking to be silly.
   286	    if (!s.atEnd() && ras.Type != 2) {
   287	//         qDebug() << "This RAS file is not valid, or an older version of the format.";
   288	        return false;
   289	    }
   290	
   291	    // Check supported file types.
   292	    if (!IsSupported(ras)) {
   293	//         qDebug() << "This RAS file is not supported.";
   294	        return false;
   295	    }
   296	
   297	    QImage img;
   298	    bool result = LoadRAS(s, ras, img);
   299	
   300	    if (result == false) {
   301	//         qDebug() << "Error loading RAS file.";
   302	        return false;
   303	    }
   304	
   305	    *outImage = img;
   306	    return true;
   307	}
