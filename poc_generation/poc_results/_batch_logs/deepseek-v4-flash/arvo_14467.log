   238	bool SoftimagePICHandler::read(QImage *image)
   239	{
   240	    if (!readChannels()) {
   241	        return false;
   242	    }
   243	
   244	    QImage::Format fmt = QImage::Format_RGB32;
   245	    for (const PicChannel &channel : qAsConst(m_channels)) {
   246	        if (channel.size != 8) {
   247	            // we cannot read images that do not come in bytes
   248	            qDebug() << "Channel size was" << channel.size;
   249	            m_state = Error;
   250	            return false;
   251	        }
   252	        if (channel.code & ALPHA) {
   253	            fmt = QImage::Format_ARGB32;
   254	        }
   255	    }
   256	
   257	    QImage img(m_header.width, m_header.height, fmt);
   258	    img.fill(qRgb(0,0,0));
   259	
   260	    for (int y = 0; y < m_header.height; y++) {
   261	        QRgb *row = reinterpret_cast<QRgb*>(img.scanLine(y));
   262	        if (!readRow(m_dataStream, row, m_header.width, m_channels)) {
   263	            qDebug() << "readRow failed";
   264	            m_state = Error;
   265	            return false;
   266	        }
   267	    }
   268	
   269	    *image = img;
   270	    m_state = Ready;
   271	
   272	    return true;
   273	}
   274	
   275	bool SoftimagePICHandler::write(const QImage &_image)
   276	{
   277	    bool alpha = _image.hasAlphaChannel();
   278	    const QImage image = _image.convertToFormat(
   279	            alpha ? QImage::Format_ARGB32
   280	                  : QImage::Format_RGB32);
   281	
   282	    if (image.width() < 0 || image.height() < 0) {
   283	        qDebug() << "Image size invalid:" << image.width() << image.height();
   284	        return false;
   285	    }
   286	    if (image.width() > 65535 || image.height() > 65535) {
   287	        qDebug() << "Image too big:" << image.width() << image.height();
   288	        // there are only two bytes for each dimension
   289	        return false;
   290	    }
   291	
   292	    QDataStream stream(device());
   293	
   294	    stream << PicHeader(image.width(), image.height(), m_description);
   295	
   296	    PicChannelEncoding encoding = m_compression ? MixedRLE : Uncompressed;
   297	    QList<PicChannel> channels;
   298	    channels << PicChannel(encoding, RED | GREEN | BLUE);
   299	    if (alpha) {
   300	        channels << PicChannel(encoding, ALPHA);
   301	    }
   302	    stream << channels;
   303	
   304	    for (int r = 0; r < image.height(); r++) {
   305	        const QRgb *row = reinterpret_cast<const QRgb*>(image.scanLine(r));
   306	
   307	        /* Write the RGB part of the scanline */
   308	        auto rgbEqual = [] (QRgb p1, QRgb p2) -> bool {
   309	            return qRed(p1) == qRed(p2) &&
   310	                   qGreen(p1) == qGreen(p2) &&
   311	                   qBlue(p1) == qBlue(p2);
   312	        };
   313	        auto writeRgb = [] (QDataStream &str, QRgb pixel) -> void {
   314	            str << quint8(qRed(pixel))
   315	                << quint8(qGreen(pixel))
   316	                << quint8(qBlue(pixel));
   317	        };
   318	        if (m_compression) {
   319	            encodeRLEData(RLEVariant::PIC, stream, row, image.width(),
   320	                          rgbEqual, writeRgb);
   321	        } else {
   322	            for (int i = 0; i < image.width(); ++i) {
   323	                writeRgb(stream, row[i]);
   324	            }
   325	        }
   326	
   327	        /* Write the alpha channel */
   328	        if (alpha) {
   329	            auto alphaEqual = [] (QRgb p1, QRgb p2) -> bool {
   330	                return qAlpha(p1) == qAlpha(p2);
   331	            };
   332	            auto writeAlpha = [] (QDataStream &str, QRgb pixel) -> void {
   333	                str << quint8(qAlpha(pixel));
   334	            };
