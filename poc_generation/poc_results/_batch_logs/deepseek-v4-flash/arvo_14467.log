   370	bool SoftimagePICHandler::readChannels()
   371	{
   372	    readHeader();
   373	    if (m_state == ReadHeader) {
   374	        m_state = Error;
   375	        m_dataStream >> m_channels;
   376	        if (m_dataStream.status() == QDataStream::Ok) {
   377	            m_state = ReadChannels;
   378	        }
   379	    }
   380	    return m_state != Error;
   381	}
   382	
   383	void SoftimagePICHandler::setOption(ImageOption option, const QVariant &value)
   384	{
   385	    switch (option) {
   386	        case CompressionRatio:
   387	            m_compression = value.toBool();
   388	            break;
   389	        case Description: {
   390	            m_description.clear();
   391	            const QStringList entries = value.toString().split(QStringLiteral("\n\n"));
   392	            for (const QString &entry : entries) {
   393	                if (entry.startsWith(QStringLiteral("Description: "))) {
   394	                    m_description = entry.mid(13).simplified().toUtf8();
   395	                }
   396	            }
   397	            break;
   398	        }
   399	        default:
   400	            break;
   401	    }
   402	}
   403	
   404	QVariant SoftimagePICHandler::option(ImageOption option) const
   405	{
   406	    const_cast<SoftimagePICHandler*>(this)->readHeader();
   407	    switch (option) {
   408	        case Size:
   409	            if (const_cast<SoftimagePICHandler*>(this)->readHeader()) {
   410	                return QSize(m_header.width, m_header.height);
   411	            } else {
   412	                return QVariant();
   413	            }
   414	        case CompressionRatio:
   415	            return m_compression;
   416	        case Description:
   417	            if (const_cast<SoftimagePICHandler*>(this)->readHeader()) {
   418	                QString descStr = QString::fromUtf8(m_header.comment);
   419	                if (!descStr.isEmpty()) {
   420	                    return QString(QStringLiteral("Description: ") +
   421	                           descStr +
   422	                           QStringLiteral("\n\n"));
   423	                }
   424	            }
   425	            return QString();
   426	        case ImageFormat:
   427	            if (const_cast<SoftimagePICHandler*>(this)->readChannels()) {
   428	                for (const PicChannel &channel : qAsConst(m_channels)) {
   429	                    if (channel.code & ALPHA) {
   430	                        return QImage::Format_ARGB32;
   431	                    }
   432	                }
   433	                return QImage::Format_RGB32;
   434	            }
   435	            return QVariant();
   436	        default:
   437	            return QVariant();
   438	    }
   439	}
   440	
   441	bool SoftimagePICHandler::supportsOption(ImageOption option) const
   442	{
   443	    return (option == CompressionRatio ||
   444	            option == Description ||
   445	            option == ImageFormat ||
   446	            option == Size);
   447	}
