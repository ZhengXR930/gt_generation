   336	                encodeRLEData(RLEVariant::PIC, stream, row, image.width(),
   337	                              alphaEqual, writeAlpha);
   338	            } else {
   339	                for (int i = 0; i < image.width(); ++i) {
   340	                    writeAlpha(stream, row[i]);
   341	                }
   342	            }
   343	        }
   344	    }
   345	    return stream.status() == QDataStream::Ok;
   346	}
