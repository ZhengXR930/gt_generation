   449	QImageIOPlugin::Capabilities SoftimagePICPlugin::capabilities(QIODevice *device, const QByteArray &format) const
   450	{
   451	    if (format == "pic") {
   452	        return Capabilities(CanRead | CanWrite);
   453	    }
   454	    if (!format.isEmpty()) {
   455	        return {};
   456	    }
   457	    if (!device->isOpen()) {
   458	        return {};
   459	    }
   460	
   461	    Capabilities cap;
   462	    if (device->isReadable() && SoftimagePICHandler::canRead(device)) {
   463	        cap |= CanRead;
   464	    }
   465	    if (device->isWritable()) {
   466	        cap |= CanWrite;
   467	    }
   468	    return cap;
   469	}
