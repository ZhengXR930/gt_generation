   355	/*!
   356	 * Implement the HLS "double hex-cone".
   357	 * \param n1 lightness fraction (?)
   358	 * \param n2 saturation fraction (?)
   359	 * \param hue hue "angle".
   360	 * \return HLS value.
   361	 */
   362	static int HLSVALUE(double n1, double n2, double hue)
   363	{
   364	    double value;
   365	
   366	    if (hue > 255) {
   367	        hue -= 255;
   368	    } else if (hue < 0) {
   369	        hue += 255;
   370	    }
   371	
   372	    if (hue < 42.5) {
   373	        value = n1 + (n2 - n1) * (hue / 42.5);
   374	    } else if (hue < 127.5) {
   375	        value = n2;
   376	    } else if (hue < 170) {
   377	        value = n1 + (n2 - n1) * ((170 - hue) / 42.5);
   378	    } else {
   379	        value = n1;
   380	    }
   381	
   382	    return (int)(value * 255);
   383	}
