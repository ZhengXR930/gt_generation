   419	
   420	uint SGIImage::compact(uchar *d, uchar *s)
   421	{
   422	    uchar *dest = d, *src = s, patt, *t, *end = s + _xsize;
   423	    int i, n;
   424	    while (src < end) {
   425	        for (n = 0, t = src; t + 2 < end && !(*t == t[1] && *t == t[2]); t++) {
   426	            n++;
   427	        }
   428	
   429	        while (n) {
   430	            i = n > 126 ? 126 : n;
   431	            n -= i;
   432	            *dest++ = 0x80 | i;
   433	            while (i--) {
   434	                *dest++ = *src++;
   435	            }
   436	        }
   437	
   438	        if (src == end) {
   439	            break;
   440	        }
   441	
   442	        patt = *src++;
   443	        for (n = 1; src < end && *src == patt; src++) {
   444	            n++;
   445	        }
   446	
   447	        while (n) {
   448	            i = n > 126 ? 126 : n;
   449	            n -= i;
   450	            *dest++ = i;
   451	            *dest++ = patt;
   452	        }
   453	    }
   454	    *dest++ = 0;
   455	    return dest - d;
   456	}
