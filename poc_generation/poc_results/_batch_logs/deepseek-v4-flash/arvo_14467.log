   248	bool SGIImage::readImage(QImage &img)
   249	{
   250	    qint8 u8;
   251	    qint16 u16;
   252	    qint32 u32;
   253	
   254	//     qDebug() << "reading rgb ";
   255	
   256	    // magic
   257	    _stream >> u16;
   258	    if (u16 != 0x01da) {
   259	        return false;
   260	    }
   261	
   262	    // verbatim/rle
   263	    _stream >> _rle;
   264	//     qDebug() << (_rle ? "RLE" : "verbatim");
   265	    if (_rle > 1) {
   266	        return false;
   267	    }
   268	
   269	    // bytes per channel
   270	    _stream >> _bpc;
   271	//     qDebug() << "bytes per channel: " << int(_bpc);
   272	    if (_bpc == 1)
   273	        ;
   274	    else if (_bpc == 2) {
   275	//         qDebug() << "dropping least significant byte";
   276	    } else {
   277	        return false;
   278	    }
   279	
   280	    // number of dimensions
   281	    _stream >> _dim;
   282	//     qDebug() << "dimensions: " << _dim;
   283	    if (_dim < 1 || _dim > 3) {
   284	        return false;
   285	    }
   286	
   287	    _stream >> _xsize >> _ysize >> _zsize >> _pixmin >> _pixmax >> u32;
   288	//     qDebug() << "x: " << _xsize;
   289	//     qDebug() << "y: " << _ysize;
   290	//     qDebug() << "z: " << _zsize;
   291	
   292	    // name
   293	    _stream.readRawData(_imagename, 80);
   294	    _imagename[79] = '\0';
   295	
   296	    _stream >> _colormap;
   297	//     qDebug() << "colormap: " << _colormap;
   298	    if (_colormap != NORMAL) {
   299	        return false;    // only NORMAL supported
   300	    }
   301	
   302	    for (int i = 0; i < 404; i++) {
   303	        _stream >> u8;
   304	    }
   305	
   306	    if (_dim == 1) {
   307	//         qDebug() << "1-dimensional images aren't supported yet";
   308	        return false;
   309	    }
   310	
   311	    if (_stream.atEnd()) {
   312	        return false;
   313	    }
   314	
   315	    img = QImage(_xsize, _ysize, QImage::Format_RGB32);
   316	
   317	    if (_zsize == 0 )
   318	        return false;
   319	
   320	    if (_zsize == 2 || _zsize == 4) {
   321	        img = img.convertToFormat(QImage::Format_ARGB32);
   322	    } else if (_zsize > 4) {
   323	//         qDebug() << "using first 4 of " << _zsize << " channels";
   324	        // Only let this continue if it won't cause a int overflow later
   325	        // this is most likely a broken file anyway
   326	        if (_ysize > std::numeric_limits<int>::max() / _zsize)
   327	            return false;
   328	    }
   329	
   330	    _numrows = _ysize * _zsize;
   331	
   332	    if (_rle) {
   333	        uint l;
   334	        _starttab = new quint32[_numrows];
   335	        for (l = 0; !_stream.atEnd() && l < _numrows; l++) {
   336	            _stream >> _starttab[l];
   337	            _starttab[l] -= 512 + _numrows * 2 * sizeof(quint32);
   338	        }
   339	
   340	        _lengthtab = new quint32[_numrows];
   341	        for (l = 0; l < _numrows; l++) {
   342	            _stream >> _lengthtab[l];
   343	        }
   344	    }
   345	
   346	    _data = _dev->readAll();
   347	
   348	    // sanity check
   349	    if (_rle)
   350	        for (uint o = 0; o < _numrows; o++)
   351	            // don't change to greater-or-equal!
   352	            if (_starttab[o] + _lengthtab[o] > (uint)_data.size()) {
   353	//                 qDebug() << "image corrupt (sanity check failed)";
   354	                return false;
   355	            }
   356	
   357	    if (!readData(img)) {
   358	//         qDebug() << "image corrupt (incomplete scanline)";
   359	        return false;
   360	    }
   361	
   362	    return true;
   363	}
