   354	bool TGAHandler::read(QImage *outImage)
   355	{
   356	    //qDebug() << "Loading TGA file!";
   357	
   358	    QDataStream s(device());
   359	    s.setByteOrder(QDataStream::LittleEndian);
   360	
   361	    // Read image header.
   362	    TgaHeader tga;
   363	    s >> tga;
   364	    s.device()->seek(TgaHeader::SIZE + tga.id_length);
   365	
   366	    // Check image file format.
   367	    if (s.atEnd()) {
   368	//         qDebug() << "This TGA file is not valid.";
   369	        return false;
   370	    }
   371	
   372	    // Check supported file types.
   373	    if (!IsSupported(tga)) {
   374	//         qDebug() << "This TGA file is not supported.";
   375	        return false;
   376	    }
   377	
   378	    QImage img;
   379	    bool result = LoadTGA(s, tga, img);
   380	
   381	    if (result == false) {
   382	//         qDebug() << "Error loading TGA file.";
   383	        return false;
   384	    }
   385	
   386	    *outImage = img;
   387	    return true;
   388	}
   389	
   390	bool TGAHandler::write(const QImage &image)
   391	{
   392	    QDataStream s(device());
   393	    s.setByteOrder(QDataStream::LittleEndian);
   394	
   395	    const QImage &img = image;
   396	    const bool hasAlpha = (img.format() == QImage::Format_ARGB32);
   397	    for (int i = 0; i < 12; i++) {
   398	        s << targaMagic[i];
   399	    }
   400	
   401	    // write header
   402	    s << quint16(img.width());   // width
   403	    s << quint16(img.height());   // height
   404	    s << quint8(hasAlpha ? 32 : 24);   // depth (24 bit RGB + 8 bit alpha)
   405	    s << quint8(hasAlpha ? 0x24 : 0x20);   // top left image (0x20) + 8 bit alpha (0x4)
   406	
   407	    for (int y = 0; y < img.height(); y++)
   408	        for (int x = 0; x < img.width(); x++) {
   409	            const QRgb color = img.pixel(x, y);
   410	            s << quint8(qBlue(color));
   411	            s << quint8(qGreen(color));
   412	            s << quint8(qRed(color));
   413	            if (hasAlpha) {
   414	                s << quint8(qAlpha(color));
   415	            }
   416	        }
   417	
   418	    return true;
   419	}
