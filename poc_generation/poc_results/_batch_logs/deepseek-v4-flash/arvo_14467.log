   294	void XCFImageFormat::initializeRandomTable()
   295	{
   296	    // From GIMP "paint_funcs.c" v1.2
   297	    srand(RANDOM_SEED);
   298	
   299	    for (int i = 0; i < RANDOM_TABLE_SIZE; i++) {
   300	        random_table[i] = rand();
   301	    }
   302	
   303	    for (int i = 0; i < RANDOM_TABLE_SIZE; i++) {
   304	        int tmp;
   305	        int swap = i + rand() % (RANDOM_TABLE_SIZE - i);
   306	        tmp = random_table[i];
   307	        random_table[i] = random_table[swap];
   308	        random_table[swap] = tmp;
   309	    }
   310	}
