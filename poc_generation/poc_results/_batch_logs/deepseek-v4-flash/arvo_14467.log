   227	        if (_zsize == 3) {
   228	            return true;
   229	        }
   230	    }
   231	
   232	    for (y = 0; y < _ysize; y++) {
   233	        if (_rle) {
   234	            _pos = _data.begin() + *start++;
   235	        }
   236	        if (!getRow(line)) {
   237	            return false;
   238	        }
   239	        c = (QRgb *)img.scanLine(_ysize - y - 1);
   240	        for (x = 0; x < _xsize; x++, c++) {
   241	            *c = qRgba(qRed(*c), qGreen(*c), qBlue(*c), line[x]);
   242	        }
   243	    }
   244	
   245	    return true;
   246	}
