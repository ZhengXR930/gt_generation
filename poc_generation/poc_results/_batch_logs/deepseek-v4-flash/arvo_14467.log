   309	QImageIOPlugin::Capabilities RASPlugin::capabilities(QIODevice *device, const QByteArray &format) const
   310	{
   311	
   312	    if (format == "ras") {
   313	        return Capabilities(CanRead);
   314	    }
   315	    if (!format.isEmpty()) {
   316	        return {};
   317	    }
   318	    if (!device->isOpen()) {
   319	        return {};
   320	    }
   321	
   322	    Capabilities cap;
   323	    if (device->isReadable() && RASHandler::canRead(device)) {
   324	        cap |= CanRead;
   325	    }
   326	    return cap;
   327	}
