   357	bool SoftimagePICHandler::readHeader()
   358	{
   359	    if (m_state == Ready) {
   360	        m_state = Error;
   361	        m_dataStream.setDevice(device());
   362	        m_dataStream >> m_header;
   363	        if (m_header.isValid() && m_dataStream.status() == QDataStream::Ok) {
   364	            m_state = ReadHeader;
   365	        }
   366	    }
   367	    return m_state != Error;
   368	}
