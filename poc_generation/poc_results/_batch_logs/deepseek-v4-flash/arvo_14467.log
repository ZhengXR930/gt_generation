    41	/**
    42	 * Reads a PIC file header from a data stream.
    43	 *
    44	 * @param s         The data stream to read from.
    45	 * @param channels  Where the read header will be stored.
    46	 * @returns  @p s
    47	 *
    48	 * @relates PicHeader
    49	 */
    50	static QDataStream &operator>> (QDataStream &s, PicHeader &header)
    51	{
    52	    s.setFloatingPointPrecision(QDataStream::SinglePrecision);
    53	    s >> header.magic;
    54	    s >> header.version;
    55	
    56	    // the comment should be truncated to the first null byte
    57	    char comment[81] = {};
    58	    s.readRawData(comment, 80);
    59	    header.comment = QByteArray(comment);
    60	
    61	    header.id.resize(4);
    62	    const int bytesRead = s.readRawData(header.id.data(), 4);
    63	    if (bytesRead != 4) {
    64	        header.id.resize(bytesRead);
    65	    }
    66	
    67	    s >> header.width;
    68	    s >> header.height;
    69	    s >> header.ratio;
    70	    qint16 fields;
    71	    s >> fields;
    72	    header.fields = static_cast<PicFields>(fields);
    73	    qint16 pad;
    74	    s >> pad;
    75	    return s;
    76	}
    77	
    78	/**
    79	 * Writes a PIC file header to a data stream.
    80	 *
    81	 * @param s         The data stream to write to.
    82	 * @param channels  The header to write.
    83	 * @returns  @p s
    84	 *
    85	 * @relates PicHeader
    86	 */
    87	static QDataStream &operator<< (QDataStream &s, const PicHeader &header)
    88	{
    89	    s.setFloatingPointPrecision(QDataStream::SinglePrecision);
    90	    s << header.magic;
    91	    s << header.version;
    92	
    93	    char comment[80] = {};
    94	    strncpy(comment, header.comment.constData(), sizeof(comment));
    95	    s.writeRawData(comment, sizeof(comment));
    96	
    97	    char id[4] = {};
    98	    strncpy(id, header.id.constData(), sizeof(id));
    99	    s.writeRawData(id, sizeof(id));
   100	
