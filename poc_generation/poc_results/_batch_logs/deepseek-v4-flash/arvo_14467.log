   206	                return false;
   207	            }
   208	            c = (QRgb *)img.scanLine(_ysize - y - 1);
   209	            for (x = 0; x < _xsize; x++, c++) {
   210	                *c = qRgb(qRed(*c), line[x], line[x]);
   211	            }
   212	        }
   213	
   214	        for (y = 0; y < _ysize; y++) {
   215	            if (_rle) {
   216	                _pos = _data.begin() + *start++;
   217	            }
   218	            if (!getRow(line)) {
   219	                return false;
   220	            }
   221	            c = (QRgb *)img.scanLine(_ysize - y - 1);
   222	            for (x = 0; x < _xsize; x++, c++) {
   223	                *c = qRgb(qRed(*c), qGreen(*c), line[x]);
   224	            }
   225	        }
