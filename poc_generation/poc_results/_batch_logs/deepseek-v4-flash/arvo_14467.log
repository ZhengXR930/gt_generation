   108	        qWarning() << "LoadRAS() unsupported image color map length in file header" << ras.ColorMapLength;
   109	        return false;
   110	    }
   111	
   112	    // Read palette if needed.
   113	    QVector<quint8> palette(ras.ColorMapLength);
