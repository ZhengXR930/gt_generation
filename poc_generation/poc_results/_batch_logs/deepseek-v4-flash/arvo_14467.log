   179	    if (!_rle) {
   180	        _pos = _data.begin();
   181	    }
   182	
   183	    for (y = 0; y < _ysize; y++) {
   184	        if (_rle) {
   185	            _pos = _data.begin() + *start++;
   186	        }
   187	        if (!getRow(line)) {
   188	            return false;
   189	        }
   190	        c = (QRgb *)img.scanLine(_ysize - y - 1);
   191	        for (x = 0; x < _xsize; x++, c++) {
   192	            *c = qRgb(line[x], line[x], line[x]);
   193	        }
   194	    }
   195	
   196	    if (_zsize == 1) {
   197	        return true;
   198	    }
   199	
   200	    if (_zsize != 2) {
   201	        for (y = 0; y < _ysize; y++) {
   202	            if (_rle) {
   203	                _pos = _data.begin() + *start++;
   204	            }
