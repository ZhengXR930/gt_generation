   109	/**
   110	 * Reads a series of channel descriptions from a data stream.
   111	 *
   112	 * If the stream contains more than 8 channel descriptions, the status of @p s
   113	 * will be set to QDataStream::ReadCorruptData (note that more than 4 channels
   114	 * - one for each component - does not really make sense anyway).
   115	 *
   116	 * @param s         The data stream to read from.
   117	 * @param channels  The location to place the read channel descriptions; any
   118	 *                  existing entries will be cleared.
   119	 * @returns  @p s
   120	 *
   121	 * @relates PicChannel
   122	 */
   123	static QDataStream &operator>> (QDataStream &s, QList<PicChannel> &channels)
   124	{
   125	    const unsigned maxChannels = 8;
   126	    unsigned count = 0;
   127	    quint8 chained = 1;
   128	    channels.clear();
   129	    while (chained && count < maxChannels && s.status() == QDataStream::Ok) {
   130	        PicChannel channel;
   131	        s >> chained;
   132	        s >> channel.size;
   133	        quint8 encoding;
   134	        s >> encoding;
   135	        channel.encoding = PicChannelEncoding(encoding);
   136	        s >> channel.code;
   137	        channels << channel;
   138	        ++count;
   139	    }
   140	    if (chained) {
   141	        // too many channels!
   142	        s.setStatus(QDataStream::ReadCorruptData);
   143	    }
   144	    return s;
   145	}
   146	
   147	/**
   148	 * Writes a series of channel descriptions to a data stream.
   149	 *
   150	 * Note that the corresponding read operation will not read more than 8 channel
   151	 * descriptions, although there should be no reason to have more than 4 channels
   152	 * anyway.
   153	 *
   154	 * @param s         The data stream to write to.
   155	 * @param channels  The channel descriptions to write.
   156	 * @returns  @p s
   157	 *
   158	 * @relates PicChannel
   159	 */
   160	static QDataStream &operator<< (QDataStream &s, const QList<PicChannel> &channels)
   161	{
   162	    Q_ASSERT(channels.size() > 0);
   163	    for (int i = 0; i < channels.size() - 1; ++i) {
   164	        s << quint8(1); // chained
   165	        s << channels[i].size;
   166	        s << quint8(channels[i].encoding);
   167	        s << channels[i].code;
   168	    }
   169	    s << quint8(0); // chained
   170	    s << channels.last().size;
   171	    s << quint8(channels.last().encoding);
   172	    s << channels.last().code;
   173	    return s;
   174	}
   175	
   176	static bool readRow(QDataStream &stream, QRgb *row, quint16 width, const QList<PicChannel> &channels)
   177	{
   178	    for(const PicChannel &channel : channels) {
   179	        auto readPixel = [&] (QDataStream &str) -> QRgb {
   180	            quint8 red = 0;
   181	            if (channel.code & RED) {
   182	                str >> red;
   183	            }
   184	            quint8 green = 0;
   185	            if (channel.code & GREEN) {
   186	                str >> green;
   187	            }
   188	            quint8 blue = 0;
   189	            if (channel.code & BLUE) {
   190	                str >> blue;
   191	            }
   192	            quint8 alpha = 0;
   193	            if (channel.code & ALPHA) {
   194	                str >> alpha;
   195	            }
   196	            return qRgba(red, green, blue, alpha);
   197	        };
   198	        auto updatePixel = [&] (QRgb oldPixel, QRgb newPixel) -> QRgb {
   199	            return qRgba(
   200	                qRed((channel.code & RED) ? newPixel : oldPixel),
   201	                qGreen((channel.code & GREEN) ? newPixel : oldPixel),
   202	                qBlue((channel.code & BLUE) ? newPixel : oldPixel),
   203	                qAlpha((channel.code & ALPHA) ? newPixel : oldPixel));
   204	        };
   205	        if (channel.encoding == MixedRLE) {
   206	            bool success = decodeRLEData(RLEVariant::PIC, stream, row, width,
   207	                                         readPixel, updatePixel);
   208	            if (!success) {
   209	                qDebug() << "decodeRLEData failed";
   210	                return false;
   211	            }
   212	        } else if (channel.encoding == Uncompressed) {
   213	            for (quint16 i = 0; i < width; ++i) {
   214	                QRgb pixel = readPixel(stream);
   215	                row[i] = updatePixel(row[i], pixel);
   216	            }
   217	        } else {
   218	            // unknown encoding
   219	            qDebug() << "Unknown encoding";
   220	            return false;
   221	        }
   222	    }
   223	    if (stream.status() != QDataStream::Ok) {
   224	        qDebug() << "DataStream status was" << stream.status();
   225	    }
   226	    return stream.status() == QDataStream::Ok;
   227	}
