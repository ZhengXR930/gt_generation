   458	bool SGIImage::scanData(const QImage &img)
   459	{
   460	    quint32 *start = _starttab;
   461	    QByteArray lineguard(_xsize * 2, 0);
   462	    QByteArray bufguard(_xsize, 0);
   463	    uchar *line = (uchar *)lineguard.data();
   464	    uchar *buf = (uchar *)bufguard.data();
   465	    const QRgb *c;
   466	    unsigned x, y;
   467	    uint len;
   468	
   469	    for (y = 0; y < _ysize; y++) {
   470	        c = reinterpret_cast<const QRgb *>(img.scanLine(_ysize - y - 1));
   471	        for (x = 0; x < _xsize; x++) {
   472	            buf[x] = intensity(qRed(*c++));
   473	        }
   474	        len = compact(line, buf);
   475	        *start++ = _rlemap.insert(line, len);
   476	    }
   477	
   478	    if (_zsize == 1) {
   479	        return true;
   480	    }
   481	
   482	    if (_zsize != 2) {
   483	        for (y = 0; y < _ysize; y++) {
   484	            c = reinterpret_cast<const QRgb *>(img.scanLine(_ysize - y - 1));
   485	            for (x = 0; x < _xsize; x++) {
   486	                buf[x] = intensity(qGreen(*c++));
   487	            }
   488	            len = compact(line, buf);
   489	            *start++ = _rlemap.insert(line, len);
   490	        }
   491	
   492	        for (y = 0; y < _ysize; y++) {
   493	            c = reinterpret_cast<const QRgb *>(img.scanLine(_ysize - y - 1));
   494	            for (x = 0; x < _xsize; x++) {
   495	                buf[x] = intensity(qBlue(*c++));
   496	            }
   497	            len = compact(line, buf);
   498	            *start++ = _rlemap.insert(line, len);
   499	        }
   500	
   501	        if (_zsize == 3) {
   502	            return true;
   503	        }
   504	    }
   505	
   506	    for (y = 0; y < _ysize; y++) {
   507	        c = reinterpret_cast<const QRgb *>(img.scanLine(_ysize - y - 1));
   508	        for (x = 0; x < _xsize; x++) {
   509	            buf[x] = intensity(qAlpha(*c++));
   510	        }
   511	        len = compact(line, buf);
   512	        *start++ = _rlemap.insert(line, len);
   513	    }
   514	
   515	    return true;
   516	}
   517	
   518	void SGIImage::writeHeader()
   519	{
   520	    _stream << quint16(0x01da);
   521	    _stream << _rle << _bpc << _dim;
   522	    _stream << _xsize << _ysize << _zsize;
   523	    _stream << _pixmin << _pixmax;
   524	    _stream << quint32(0);
   525	
   526	    for (int i = 0; i < 80; i++) {
   527	        _imagename[i] = '\0';
   528	    }
   529	    _stream.writeRawData(_imagename, 80);
   530	
   531	    _stream << _colormap;
   532	    for (int i = 0; i < 404; i++) {
   533	        _stream << quint8(0);
   534	    }
   535	}
   536	
   537	void SGIImage::writeRle()
   538	{
   539	    _rle = 1;
   540	//     qDebug() << "writing RLE data";
   541	    writeHeader();
   542	    uint i;
   543	
   544	    // write start table
   545	    for (i = 0; i < _numrows; i++) {
   546	        _stream << quint32(_rlevector[_starttab[i]]->offset());
   547	    }
   548	
   549	    // write length table
   550	    for (i = 0; i < _numrows; i++) {
   551	        _stream << quint32(_rlevector[_starttab[i]]->size());
   552	    }
   553	
   554	    // write data
   555	    for (i = 0; (int)i < _rlevector.size(); i++) {
   556	        const_cast<RLEData *>(_rlevector[i])->write(_stream);
   557	    }
   558	}
