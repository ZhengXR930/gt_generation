   318	bool XCFImageFormat::readXCF(QIODevice *device, QImage *outImage)
   319	{
   320	    XCFImage xcf_image;
   321	    QDataStream xcf_io(device);
   322	
   323	    char tag[14];;
   324	
   325	    if (xcf_io.readRawData(tag, sizeof(tag)) != sizeof(tag)) {
   326	//             qDebug() << "XCF: read failure on header tag";
   327	        return false;
   328	    }
   329	    if (qstrncmp(tag, "gimp xcf", 8) != 0) {
   330	//             qDebug() << "XCF: read called on non-XCF file";
   331	        return false;
   332	    }
   333	
   334	    xcf_io >> xcf_image.width >> xcf_image.height >> xcf_image.type;
   335	
   336	//  qDebug() << tag << " " << xcf_image.width << " " << xcf_image.height << " " <<  xcf_image.type;
   337	    if (!loadImageProperties(xcf_io, xcf_image)) {
   338	        return false;
   339	    }
   340	
   341	    // The layers appear to be stored in top-to-bottom order. This is
   342	    // the reverse of how a merged image must be computed. So, the layer
   343	    // offsets are pushed onto a LIFO stack (thus, we don't have to load
   344	    // all the data of all layers before beginning to construct the
   345	    // merged image).
   346	
   347	    QStack<qint32> layer_offsets;
   348	
   349	    while (true) {
   350	        qint32 layer_offset;
   351	
   352	        xcf_io >> layer_offset;
   353	
   354	        if (layer_offset == 0) {
   355	            break;
   356	        }
   357	
   358	        layer_offsets.push(layer_offset);
   359	    }
   360	
   361	    xcf_image.num_layers = layer_offsets.size();
   362	
   363	    if (layer_offsets.size() == 0) {
   364	//      qDebug() << "XCF: no layers!"; return false;
   365	    }
   366	
   367	    // Load each layer and add it to the image
   368	    while (!layer_offsets.isEmpty()) {
   369	        qint32 layer_offset = layer_offsets.pop();
   370	
   371	        xcf_io.device()->seek(layer_offset);
   372	
   373	        if (!loadLayer(xcf_io, xcf_image)) {
   374	            return false;
   375	        }
   376	    }
   377	
   378	    if (!xcf_image.initialized) {
   379	//      qDebug() << "XCF: no visible layers!";
   380	        return false;
   381	    }
   382	
   383	    *outImage = xcf_image.image;
   384	    return true;
   385	}
