   129	bool SGIImage::getRow(uchar *dest)
   130	{
   131	    int n, i;
   132	    if (!_rle) {
   133	        for (i = 0; i < _xsize; i++) {
   134	            if (_pos >= _data.end()) {
   135	                return false;
   136	            }
   137	            dest[i] = uchar(*_pos);
   138	            _pos += _bpc;
   139	        }
   140	        return true;
   141	    }
   142	
   143	    for (i = 0; i < _xsize;) {
   144	        if (_bpc == 2) {
   145	            _pos++;
   146	        }
   147	        if (_pos >= _data.end()) {
   148	            return false;
   149	        }
   150	        n = *_pos & 0x7f;
   151	        if (!n) {
   152	            break;
   153	        }
   154	
   155	        if (*_pos++ & 0x80) {
   156	            for (; i < _xsize && _pos < _data.end() && n--; i++) {
   157	                *dest++ = *_pos;
   158	                _pos += _bpc;
   159	            }
   160	        } else {
   161	            for (; i < _xsize && n--; i++) {
   162	                *dest++ = *_pos;
   163	            }
   164	
   165	            _pos += _bpc;
   166	        }
   167	    }
   168	    return i == _xsize;
   169	}
