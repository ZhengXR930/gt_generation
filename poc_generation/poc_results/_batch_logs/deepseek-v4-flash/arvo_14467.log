   367	void RLEData::write(QDataStream &s)
   368	{
   369	    for (int i = 0; i < size(); i++) {
   370	        s << at(i);
   371	    }
   372	}
   373	
   374	bool RLEData::operator<(const RLEData &b) const
   375	{
   376	    uchar ac, bc;
   377	    for (int i = 0; i < qMin(size(), b.size()); i++) {
   378	        ac = at(i);
   379	        bc = b[i];
   380	        if (ac != bc) {
   381	            return ac < bc;
   382	        }
   383	    }
   384	    return size() < b.size();
   385	}
   386	
   387	uint RLEMap::insert(const uchar *d, uint l)
   388	{
   389	    RLEData data = RLEData(d, l, _offset);
   390	    Iterator it = find(data);
   391	    if (it != end()) {
   392	        return it.value();
   393	    }
   394	
   395	    _offset += l;
   396	    return QMap<RLEData, uint>::insert(data, _counter++).value();
   397	}
   398	
   399	QVector<const RLEData *> RLEMap::vector()
   400	{
   401	    QVector<const RLEData *> v(size());
   402	    for (Iterator it = begin(); it != end(); ++it) {
   403	        v.replace(it.value(), &it.key());
   404	    }
   405	
   406	    return v;
   407	}
