    74	template<typename Item, typename Func1, typename Func2>
    75	static inline bool decodeRLEData(RLEVariant variant,
    76	                                 QDataStream &stream,
    77	                                 Item *dest,
    78	                                 quint32 length,
    79	                                 Func1 readData,
    80	                                 Func2 updateItem)
