   177	static bool LoadTGA(QDataStream &s, const TgaHeader &tga, QImage &img)
   178	{
   179	    // Create image.
   180	    img = QImage(tga.width, tga.height, QImage::Format_RGB32);
   181	
   182	    TgaHeaderInfo info(tga);
   183	
   184	    // Bits 0-3 are the numbers of alpha bits (can be zero!)
   185	    const int numAlphaBits = tga.flags & 0xf;
   186	    // However alpha exists only in the 32 bit format.
   187	    if ((tga.pixel_size == 32) && (tga.flags & 0xf)) {
   188	        img = QImage(tga.width, tga.height, QImage::Format_ARGB32);
   189	
   190	        if (numAlphaBits > 8) {
   191	            return false;
   192	        }
   193	    }
   194	
   195	    uint pixel_size = (tga.pixel_size / 8);
   196	    qint64 size = qint64(tga.width) * qint64(tga.height) * pixel_size;
   197	
   198	    if (size < 1) {
   199	//          qDebug() << "This TGA file is broken with size " << size;
   200	        return false;
   201	    }
   202	
   203	    // Read palette.
   204	    char palette[768];
   205	    if (info.pal) {
   206	        // @todo Support palettes in other formats!
   207	        const int size = 3 * tga.colormap_length;
   208	        const int dataRead = s.readRawData(palette, size);
   209	        if (dataRead < 0) {
   210	            return false;
   211	        }
   212	        if (dataRead < size) {
   213	            memset(&palette[dataRead], 0, size - dataRead);
   214	        }
   215	    }
   216	
   217	    // Allocate image.
   218	    uchar *const image = reinterpret_cast<uchar*>(malloc(size));
   219	    if (!image) {
   220	        return false;
   221	    }
   222	
   223	    bool valid = true;
   224	
   225	    if (info.rle) {
   226	        // Decode image.
   227	        char *dst = (char *)image;
   228	        qint64 num = size;
   229	
   230	        while (num > 0) {
   231	            if (s.atEnd()) {
   232	                valid = false;
   233	                break;
   234	            }
   235	
   236	            // Get packet header.
   237	            uchar c;
   238	            s >> c;
   239	
   240	            uint count = (c & 0x7f) + 1;
   241	            num -= count * pixel_size;
   242	            if (num < 0) {
   243	                valid = false;
   244	                break;
   245	            }
   246	
   247	            if (c & 0x80) {
   248	                // RLE pixels.
   249	                assert(pixel_size <= 8);
   250	                char pixel[8];
   251	                s.readRawData(pixel, pixel_size);
   252	                do {
   253	                    memcpy(dst, pixel, pixel_size);
   254	                    dst += pixel_size;
   255	                } while (--count);
   256	            } else {
   257	                // Raw pixels.
   258	                count *= pixel_size;
   259	                s.readRawData(dst, count);
   260	                dst += count;
   261	            }
   262	        }
   263	    } else {
   264	        // Read raw image.
   265	        const int dataRead = s.readRawData((char *)image, size);
   266	        if (dataRead < 0) {
   267	            free(image);
   268	            return false;
   269	        }
   270	        if (dataRead < size) {
   271	            memset(&image[dataRead], 0, size - dataRead);
   272	        }
   273	    }
   274	
   275	    if (!valid) {
   276	        free(image);
   277	        return false;
   278	    }
   279	
   280	    // Convert image to internal format.
   281	    int y_start, y_step, y_end;
   282	    if (tga.flags & TGA_ORIGIN_UPPER) {
   283	        y_start = 0;
   284	        y_step = 1;
   285	        y_end = tga.height;
   286	    } else {
   287	        y_start = tga.height - 1;
   288	        y_step = -1;
   289	        y_end = -1;
   290	    }
   291	
   292	    uchar *src = image;
   293	
   294	    for (int y = y_start; y != y_end; y += y_step) {
   295	        QRgb *scanline = (QRgb *) img.scanLine(y);
   296	
   297	        if (info.pal) {
   298	            // Paletted.
   299	            for (int x = 0; x < tga.width; x++) {
   300	                uchar idx = *src++;
   301	                scanline[x] = qRgb(palette[3 * idx + 2], palette[3 * idx + 1], palette[3 * idx + 0]);
   302	            }
   303	        } else if (info.grey) {
   304	            // Greyscale.
   305	            for (int x = 0; x < tga.width; x++) {
   306	                scanline[x] = qRgb(*src, *src, *src);
   307	                src++;
   308	            }
   309	        } else {
   310	            // True Color.
   311	            if (tga.pixel_size == 16) {
   312	                for (int x = 0; x < tga.width; x++) {
   313	                    Color555 c = *reinterpret_cast<Color555 *>(src);
   314	                    scanline[x] = qRgb((c.r << 3) | (c.r >> 2), (c.g << 3) | (c.g >> 2), (c.b << 3) | (c.b >> 2));
   315	                    src += 2;
   316	                }
   317	            } else if (tga.pixel_size == 24) {
   318	                for (int x = 0; x < tga.width; x++) {
   319	                    scanline[x] = qRgb(src[2], src[1], src[0]);
   320	                    src += 3;
   321	                }
   322	            } else if (tga.pixel_size == 32) {
   323	                for (int x = 0; x < tga.width; x++) {
   324	                    // ### TODO: verify with images having really some alpha data
   325	                    const uchar alpha = (src[3] << (8 - numAlphaBits));
   326	                    scanline[x] = qRgba(src[2], src[1], src[0], alpha);
   327	                    src += 4;
   328	                }
   329	            }
   330	        }
   331	    }
   332	
   333	    // Free image.
   334	    free(image);
   335	
   336	    return true;
   337	}
