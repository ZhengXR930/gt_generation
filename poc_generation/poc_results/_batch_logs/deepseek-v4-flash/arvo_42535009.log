                                /* no adjustment needed */
                                break;
                        case FLAC__CHANNEL_ASSIGNMENT_LEFT_SIDE:
                                FLAC__ASSERT(decoder->private_->frame.header.channels == 2);
                                if(channel == 1)
                                        bps++;
                                break;
                        case FLAC__CHANNEL_ASSIGNMENT_RIGHT_SIDE:
                                FLAC__ASSERT(decoder->private_->frame.header.channels == 2);
                                if(channel == 0)
                                        bps++;
                                break;
                        case FLAC__CHANNEL_ASSIGNMENT_MID_SIDE:
                                FLAC__ASSERT(decoder->private_->frame.header.channels == 2);
                                if(channel == 1)
                                        bps++;
                                break;
                        default:
                                FLAC__ASSERT(0);
                }
