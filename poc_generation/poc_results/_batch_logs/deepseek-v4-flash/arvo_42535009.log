FLAC__bool read_subframe_(FLAC__StreamDecoder *decoder, uint32_t channel, uint32_t bps, FLAC__bool do_full_decode)
{
        FLAC__uint32 x;
        FLAC__bool wasted_bits;
        uint32_t i;

