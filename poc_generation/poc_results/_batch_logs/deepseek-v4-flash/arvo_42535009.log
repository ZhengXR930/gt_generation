                        return false;
        }
        else if(x == 2) {
                if(!read_subframe_verbatim_(decoder, channel, bps, do_full_decode))
                        return false;
        }
        else if(x < 16) {
                send_error_to_client_(decoder, FLAC__STREAM_DECODER_ERROR_STATUS_UNPARSEABLE_STREAM);
