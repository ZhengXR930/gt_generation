void
fu_coswid_write_tag_s8(cbor_item_t *item, FuCoswidTag tag, gint8 value)
{
        g_autoptr(cbor_item_t) key = cbor_build_uint8(tag);
        g_autoptr(cbor_item_t) val = cbor_new_int8();
