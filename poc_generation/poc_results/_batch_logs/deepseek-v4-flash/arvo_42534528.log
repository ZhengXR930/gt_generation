    print(f'cbor_get_uint16 error: {e}')

# cbor_decref
lib.cbor_decref.argtypes = [ctypes.POINTER(ctypes.c_void_p)]
lib.cbor_decref(ctypes.byref(ctypes.c_void_p(item)))
