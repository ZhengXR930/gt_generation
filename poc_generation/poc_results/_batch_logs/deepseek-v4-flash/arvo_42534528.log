import ctypes

# Load libcbor
lib = ctypes.CDLL('/usr/lib/x86_64-linux-gnu/libcbor.so.0.8.0')

# Define cbor_item_t structure
class CborItem(ctypes.Structure):
    pass

# We need to know the size of cbor_item_t
# From the source: metadata (union), refcount (size_t), type (enum), data (pointer)
# Let's just use cbor_new_int8 and check the allocation

# cbor_new_int8
