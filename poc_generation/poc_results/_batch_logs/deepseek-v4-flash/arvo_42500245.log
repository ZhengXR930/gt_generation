                { "tab ",          0xe009 },
                { "underscore ",   0xe05f },
                { "double-quote ", '"' },
                { NULL,            0 }
        };

        int ix;
        int letter;
        char *p;

        p = &outbuf[index];

        if ((letter = LookupMnem(keynames, p)) != 0) {
