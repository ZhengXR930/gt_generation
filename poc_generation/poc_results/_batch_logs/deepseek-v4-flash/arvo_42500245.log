static MNEM_TAB xml_entity_mnemonics[] = {
        { "gt",   '>' },
        { "lt",   0xe000 + '<' },   // private usage area, to avoid confusion with XML tag
        { "amp",  '&' },
        { "quot", '"' },
        { "nbsp", ' ' },
        { "apos", '\'' },
        { NULL,   -1 }
