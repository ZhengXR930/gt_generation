                        "ExifData", "Canon MakerNote variant type %d", mnoteid);
                data->priv->md = exif_mnote_data_canon_new (data->priv->mem, data->priv->options);

        } else if ((mnoteid = exif_mnote_data_fuji_identify (data, e)) != 0) {
