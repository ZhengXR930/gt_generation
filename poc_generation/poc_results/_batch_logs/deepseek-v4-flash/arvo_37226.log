    data_dump(image);
    mnote_dump(image);
    unsigned char *obuf;
    unsigned int osz;
    exif_data_save_data(image, &obuf, &osz);
    free(obuf);
    exif_data_fix(image);
    exif_data_unref(image);
  }
  free(buf);
  return 0;
}
