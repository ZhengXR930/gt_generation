                    0, mode, text, 0, indir_count, name_count,
                    &printed_something, &need_separator, NULL, NULL);
                switch (ret) {
                case -1:
                        return ret;
                case 0:
                        continue;
                default:
                        if ((ms->flags & MAGIC_CONTINUE) == 0)
                                return ret;
                        rv = ret;
                        break;
                }
        }

        return rv;
}

