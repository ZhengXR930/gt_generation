```cpp
void Leader::HandleCommissioningGet(Coap::Message &aMessage, const Ip6::MessageInfo &aMessageInfo)
{
    MeshCoP::Tlv tlv;
    uint16_t     offset = aMessage.GetOffset();
    uint8_t      tlvs[NetworkData::kMaxSize];  // 254 bytes
    uint8_t      length = 0;

    while (offset < aMessage.GetLength())
