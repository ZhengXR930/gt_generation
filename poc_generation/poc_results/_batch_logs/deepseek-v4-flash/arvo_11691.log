    struct.pack_into('>H', os2, 64, 0)  # usLastCharIndex
    struct.pack_into('>h', os2, 66, 0)  # sTypoAscender
    struct.pack_into('>h', os2, 68, 0)  # sTypoDescender
    struct.pack_into('>h', os2, 70, 0)  # sTypoLineGap
