    84      {
    85        param.start_path ();
    86        param.update_bounds (env.get_pt ());
    87      }
    88      /* include control points */
    89      param.update_bounds (pt1);
    90      param.update_bounds (pt2);
    91      env.moveto (pt3);
    92      param.update_bounds (env.get_pt ());
    93    }
    94  };
