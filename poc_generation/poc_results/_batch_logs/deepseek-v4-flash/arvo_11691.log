    fb.setupGlyphOrder([".notdef"])
    fb.setupCharacterMap({})
    fb.setupGlyf({".notdef": {}})
    fb.setupHorizontalMetrics({".notdef": (500, 0)})
    fb.setupHorizontalHeader()
    fb.setupNameTable({"familyName": "POC", "styleName": "Regular"})
    fb.setupOs2()
    fb.setupPost()
    fb.setupHead(unitsPerEm=1000, macStyle=0)
    
    font = fb.font
    
