   132    inline bool in_error (void) const
   133    {
   134      return callStack.in_error () || SUPER::in_error ();
   135    }
   136
   137    inline bool popSubrNum (const BiasedSubrs<SUBRS>& biasedSubrs, unsigned int &subr_num)
   138    {
   139      int n = SUPER::argStack.pop_int ();
   140      n += biasedSubrs.bias;
   141      if (unlikely ((n < 0) || ((unsigned int)n >= biasedSubrs.subrs->count)))
   142        return false;
   143
   144      subr_num = (unsigned int)n;
   145      return true;
   146    }
   147
