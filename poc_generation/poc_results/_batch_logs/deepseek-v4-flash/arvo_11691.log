        (b'head', bytes(head)),
        (b'hhea', bytes(hhea)),
        (b'hmtx', bytes(hmtx)),
        (b'maxp', bytes(maxp)),
        (b'OS/2', bytes(os2)),
        (b'cmap', bytes(cmap)),
