                        return -1;
                break;
        case SHA512SIZEBYTES:
                shasize = SHA512SIZEBYTES;
                if(shatype != SHATYPE_SHA512)
                        return -1;
                break;
        case SHA1SIZEBYTES:
                shasize = SHA1SIZEBYTES;
                if(shatype != SHATYPE_SHA1)
                        return -1;
                break;
        default:
                return -1;
        };

        int orig_len = stun_get_command_message_len_str(buf, len);
        if (orig_len < 0)
                return -1;

