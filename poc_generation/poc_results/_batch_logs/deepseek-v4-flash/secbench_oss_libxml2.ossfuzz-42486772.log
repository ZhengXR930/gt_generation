#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <libxml/parser.h>
#include <libxml/tree.h>
#include <libxml/xmlreader.h>
#include <libxml/xinclude.h>
#include <libxml/parserInternals.h>
static const char *entity_data = NULL;
static size_t entity_size = 0;
xmlParserInputPtr custom_loader(const char *URL, const char *ID, xmlParserCtxtPtr ctxt) {
    fprintf(stderr, "Loading URL: %s\n", URL ? URL : "NULL");
    if (URL && strstr(URL, "test.txt") != NULL) {
        xmlParserInputPtr input = xmlNewInputStream(ctxt);
        input->filename = NULL;
        input->buf = xmlParserInputBufferCreateMem(entity_data, entity_size, XML_CHAR_ENCODING_NONE);
        input->base = input->cur = xmlBufContent(input->buf->buffer);
        input->end = input->base + entity_size;
        return input;
    }
    return NULL;
}
int main(int argc, char **argv) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <xml_file>\n", argv[0]);
        return 1;
    }
    xmlInitParser();
    xmlSetGenericErrorFunc(NULL, NULL);

    FILE *f = fopen("test.txt", "rb");
    if (f) {
        fseek(f, 0, SEEK_END);
        long sz = ftell(f);
        fseek(f, 0, SEEK_SET);
        entity_data = malloc(sz + 1);
        entity_size = fread((void*)entity_data, 1, sz, f);
        ((char*)entity_data)[entity_size] = 0;
        fclose(f);
    }

    xmlSetExternalEntityLoader(custom_loader);

    xmlTextReaderPtr reader = xmlReaderForFile(argv[1], NULL, XML_PARSE_XINCLUDE);
    if (reader == NULL) {
        fprintf(stderr, "Failed to create reader\n");
        return 1;
    }

    int ret;
    int count = 0;
    while ((ret = xmlTextReaderRead(reader)) == 1) {
        count++;
        int type = xmlTextReaderNodeType(reader);
        const xmlChar *name = xmlTextReaderConstName(reader);
        fprintf(stderr, "Node %d: type=%d name=%s\n", count, type, name ? (char*)name : "NULL");
    }
    fprintf(stderr, "Read %d nodes, ret=%d\n", count, ret);

    xmlFreeTextReader(reader);
    xmlCleanupParser();
    return 0;
}
