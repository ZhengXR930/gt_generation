mvar += struct.pack('>H', 0)  # outerIndex
mvar += struct.pack('>H', 0)  # innerIndex

# Item variation store
# format(2) + regionOffset(4) + dataCount(2)
mvar += struct.pack('>H', 1)  # format
mvar += struct.pack('>I', 12)  # regionOffset (from start of item store)
mvar += struct.pack('>H', 1)  # dataCount

# dataOffsets
mvar += struct.pack('>I', 28)  # dataOffset (from start of item store)

# Region list
mvar += struct.pack('>H', 2)  # axisCount (must match fvar num_axes=2)
mvar += struct.pack('>H', 1)  # regionCount

# Region record: 2 axes * 3 shorts (start, peak, end)
# For axis 0: start=0, peak=0, end=0
mvar += struct.pack('>h', 0)  # start
mvar += struct.pack('>h', 0)  # peak
mvar += struct.pack('>h', 0)  # end
# For axis 1: start=0, peak=0, end=0
mvar += struct.pack('>h', 0)  # start
mvar += struct.pack('>h', 0)  # peak
mvar += struct.pack('>h', 0)  # end

# varData
