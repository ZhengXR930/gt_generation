# MVAR format:
#   majorVersion (2) = 1
#   minorVersion (2) = 0
#   reserved (2) = 0
#   valueRecordSize (2) = 8
#   valueCount (2) = 1
#   storeOffset (2) = offset from start of MVAR to item variation store
#   value records: tag(4) + outerIndex(2) + innerIndex(2) = 8 bytes
#   item variation store

# Item variation store format:
#   format (2) = 1
#   regionOffset (4) = offset from start of item store to region list
#   dataCount (2) = 1
#   dataOffsets (4) = offset from start of item store to varData
#   Region list:
#     axisCount (2) = 2 (must match fvar num_axes)
#     regionCount (2) = 1
#     region records: axisCount * 3 shorts (start, peak, end) = 2*3*2 = 12 bytes
#   varData:
#     itemCount (2) = 1
#     shortDeltaCount (2) = 0
#     regionIdxCount (2) = 1
#     regionIndices (2) = 0
#     deltaSet: regionIdxCount * itemCount bytes = 1 byte

# Layout of MVAR table:
# Offset 0: header (12 bytes)
# Offset 12: value record (8 bytes) - tag=gsp0, outerIndex=0, innerIndex=0
# Offset 20: item variation store

# Item variation store layout:
# Offset 0 (relative to store): format(2) + regionOffset(4) + dataCount(2) = 8 bytes
# Offset 8: dataOffsets (4 bytes) = offset to varData
# Offset 12: region list: axisCount(2) + regionCount(2) + region records(12) = 16 bytes
# Offset 28: varData: itemCount(2) + shortDeltaCount(2) + regionIdxCount(2) + regionIndices(2) + deltaSet(1) = 9 bytes

# So item store total = 28 + 9 = 37 bytes
# regionOffset = 12 (offset from start of item store to region list)
# dataOffset = 28 (offset from start of item store to varData)

# MVAR table total = 20 + 37 = 57 bytes

mvar = bytearray()
# Header
mvar += struct.pack('>H', 1)  # majorVersion
mvar += struct.pack('>H', 0)  # minorVersion
mvar += struct.pack('>H', 0)  # reserved
mvar += struct.pack('>H', 8)  # valueRecordSize
mvar += struct.pack('>H', 1)  # valueCount
mvar += struct.pack('>H', 20)  # storeOffset (offset from start of MVAR to item store)

# Value record: tag=gsp0, outerIndex=0, innerIndex=0
