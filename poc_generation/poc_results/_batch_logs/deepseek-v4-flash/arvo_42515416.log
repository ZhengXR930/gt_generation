    FT_Library library;
    FT_Init_FreeType(&library);
    
    FILE* f = fopen(argv[1], "rb");
    if (!f) { printf("Cannot open file\n"); return 1; }
    fseek(f, 0, SEEK_END);
    long size = ftell(f);
    fseek(f, 0, SEEK_SET);
    unsigned char* buffer = (unsigned char*)malloc(size);
    fread(buffer, 1, size, f);
    fclose(f);
    
