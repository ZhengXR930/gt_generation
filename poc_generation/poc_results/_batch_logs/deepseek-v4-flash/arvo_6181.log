static char *get_long_variable(char **cmd, SERVER_REC *server,
                               void *item, int *free_ret, int getname)
{
        char *start, *var, *ret;

        /* get variable name */
        start = *cmd;
        while (isvarchar((*cmd)[1])) (*cmd)++;

        var = g_strndup(start, (int) (*cmd-start)+1);
        if (getname) {
