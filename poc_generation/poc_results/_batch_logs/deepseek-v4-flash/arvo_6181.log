static char *theme_format_compress_colors(THEME_REC *theme, const char *format)
{
        GString *str;
        char *ret;
        char last_fg, last_bg;

        str = g_string_new(NULL);

        last_fg = last_bg = '\0';
        while (*format != '\0') {
                if (*format == '$') {
                        /* $variable, skrip it entirely */
