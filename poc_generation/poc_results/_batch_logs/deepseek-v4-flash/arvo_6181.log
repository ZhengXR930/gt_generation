                        format++;
                        g_string_append_c(str, '%');
                        g_string_append_c(str, '%');
                }
        }

        ret = str->str;
        g_string_free(str, FALSE);
        return ret;
}

char *theme_format_expand(THEME_REC *theme, const char *format)
{
        char *data, *ret;
