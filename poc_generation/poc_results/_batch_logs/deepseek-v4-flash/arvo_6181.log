        ret = parse_special((char **) &p, server,
                            active_win == NULL ? NULL : active_win->active,
                            arglist, &free_ret, NULL, 0);
        p++;

        while (*p == ' ') p++;
        empty = *p == '}' && (ret == NULL || *ret == '\0');
        if (free_ret) g_free(ret);

        if (empty) {
                /* empty */
                *data = p+1;
                return TRUE;
        }

        return FALSE;
}

