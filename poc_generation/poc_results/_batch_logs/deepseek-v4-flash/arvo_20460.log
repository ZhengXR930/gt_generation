   124	static int
   125	ops_init(regex_t* reg, int init_alloc_size)
   126	{
   127	  Operation* p;
   128	  size_t size;
   129	
   130	  if (init_alloc_size > 0) {
   131	    size = sizeof(Operation) * init_alloc_size;
   132	    p = (Operation* )xrealloc(reg->ops, size);
   133	    CHECK_NULL_RETURN_MEMERR(p);
   134	#ifdef USE_DIRECT_THREADED_CODE
   135	    {
   136	      enum OpCode* cp;
   137	      size = sizeof(enum OpCode) * init_alloc_size;
   138	      cp = (enum OpCode* )xrealloc(reg->ocs, size);
   139	      CHECK_NULL_RETURN_MEMERR(cp);
   140	      reg->ocs = cp;
   141	    }
   142	#endif
   143	  }
   144	  else {
   145	    p  = (Operation* )0;
   146	#ifdef USE_DIRECT_THREADED_CODE
   147	    reg->ocs = (enum OpCode* )0;
   148	#endif
   149	  }
   150	
   151	  reg->ops = p;
   152	  reg->ops_curr  = 0; /* !!! not yet done ops_new() */
   153	  reg->ops_alloc = init_alloc_size;
   154	  reg->ops_used  = 0;
   155	
   156	  return ONIG_NORMAL;
   157	}
   158	
   159	static int
   160	ops_expand(regex_t* reg, int n)
   161	{
   162	#define MIN_OPS_EXPAND_SIZE   4
   163	
   164	#ifdef USE_DIRECT_THREADED_CODE
   165	  enum OpCode* cp;
   166	#endif
   167	  Operation* p;
   168	  size_t size;
   169	
   170	  if (n <= 0) n = MIN_OPS_EXPAND_SIZE;
   171	
   172	  n += reg->ops_alloc;
   173	
   174	  size = sizeof(Operation) * n;
   175	  p = (Operation* )xrealloc(reg->ops, size);
   176	  CHECK_NULL_RETURN_MEMERR(p);
   177	
   178	#ifdef USE_DIRECT_THREADED_CODE
   179	  size = sizeof(enum OpCode) * n;
   180	  cp = (enum OpCode* )xrealloc(reg->ocs, size);
   181	  CHECK_NULL_RETURN_MEMERR(cp);
   182	  reg->ocs = cp;
   183	#endif
   184	
   185	  reg->ops = p;
   186	  reg->ops_alloc = n;
   187	  if (reg->ops_used == 0)
   188	    reg->ops_curr = 0;
   189	  else
   190	    reg->ops_curr = reg->ops + (reg->ops_used - 1);
   191	
   192	  return ONIG_NORMAL;
   193	}
   194	
   195	static int
   196	ops_new(regex_t* reg)
   197	{
   198	  int r;
   199	
   200	  if (reg->ops_used >= reg->ops_alloc) {
   201	    r = ops_expand(reg, reg->ops_alloc);
   202	    if (r != ONIG_NORMAL) return r;
   203	  }
   204	
   205	  reg->ops_curr = reg->ops + reg->ops_used;
   206	  reg->ops_used++;
   207	
   208	  xmemset(reg->ops_curr, 0, sizeof(Operation));
   209	  return ONIG_NORMAL;
   210	}
   211	
   212	static int
   213	is_in_string_pool(regex_t* reg, UChar* s)
   214	{
   215	  return (s >= reg->string_pool && s < reg->string_pool_end);
   216	}
   217	
   218	static void
   219	ops_free(regex_t* reg)
   220	{
   221	  int i;
   222	
   223	  if (IS_NULL(reg->ops)) return ;
   224	
   225	  for (i = 0; i < (int )reg->ops_used; i++) {
   226	    enum OpCode opcode;
   227	    Operation* op;
   228	
   229	    op = reg->ops + i;
   230	
   231	#ifdef USE_DIRECT_THREADED_CODE
   232	    opcode = *(reg->ocs + i);
   233	#else
   234	    opcode = op->opcode;
   235	#endif
   236	
   237	    switch (opcode) {
   238	    case OP_STR_MBN:
   239	      if (! is_in_string_pool(reg, op->exact_len_n.s))
   240	        xfree(op->exact_len_n.s);
   241	      break;
   242	    case OP_STR_N: case OP_STR_MB2N: case OP_STR_MB3N:
   243	      if (! is_in_string_pool(reg, op->exact_n.s))
   244	        xfree(op->exact_n.s);
   245	      break;
   246	    case OP_STR_1: case OP_STR_2: case OP_STR_3: case OP_STR_4:
   247	    case OP_STR_5: case OP_STR_MB2N1: case OP_STR_MB2N2:
   248	    case OP_STR_MB2N3:
   249	      break;
   250	
   251	    case OP_CCLASS_NOT: case OP_CCLASS:
   252	      xfree(op->cclass.bsp);
   253	      break;
   254	
   255	    case OP_CCLASS_MB_NOT: case OP_CCLASS_MB:
   256	      xfree(op->cclass_mb.mb);
   257	      break;
   258	    case OP_CCLASS_MIX_NOT: case OP_CCLASS_MIX:
   259	      xfree(op->cclass_mix.mb);
   260	      xfree(op->cclass_mix.bsp);
   261	      break;
   262	
   263	    case OP_BACKREF1: case OP_BACKREF2: case OP_BACKREF_N: case OP_BACKREF_N_IC:
   264	      break;
   265	    case OP_BACKREF_MULTI:      case OP_BACKREF_MULTI_IC:
   266	    case OP_BACKREF_WITH_LEVEL:
   267	    case OP_BACKREF_WITH_LEVEL_IC:
   268	    case OP_BACKREF_CHECK:
   269	    case OP_BACKREF_CHECK_WITH_LEVEL:
   270	      if (op->backref_general.num != 1)
   271	        xfree(op->backref_general.ns);
   272	      break;
   273	
   274	    default:
   275	      break;
   276	    }
   277	  }
   278	
   279	  xfree(reg->ops);
   280	#ifdef USE_DIRECT_THREADED_CODE
   281	  xfree(reg->ocs);
   282	  reg->ocs = 0;
   283	#endif
   284	
   285	  reg->ops = 0;
   286	  reg->ops_curr  = 0;
   287	  reg->ops_alloc = 0;
   288	  reg->ops_used  = 0;
   289	}
   290	
   291	static int
   292	ops_calc_size_of_string_pool(regex_t* reg)
   293	{
   294	  int i;
   295	  int total;
   296	
   297	  if (IS_NULL(reg->ops)) return 0;
   298	
   299	  total = 0;
   300	  for (i = 0; i < (int )reg->ops_used; i++) {
   301	    enum OpCode opcode;
   302	    Operation* op;
   303	
   304	    op = reg->ops + i;
   305	#ifdef USE_DIRECT_THREADED_CODE
   306	    opcode = *(reg->ocs + i);
   307	#else
   308	    opcode = op->opcode;
   309	#endif
   310	
   311	    switch (opcode) {
   312	    case OP_STR_MBN:
   313	      total += op->exact_len_n.len * op->exact_len_n.n;
   314	      break;
   315	    case OP_STR_N:
   316	    case OP_STR_MB2N:
   317	      total += op->exact_n.n * 2;
   318	      break;
   319	    case OP_STR_MB3N:
   320	      total += op->exact_n.n * 3;
   321	      break;
   322	
   323	    default:
   324	      break;
   325	    }
   326	  }
   327	
   328	  return total;
   329	}
   330	
   331	static int
   332	ops_make_string_pool(regex_t* reg)
   333	{
   334	  int i;
   335	  int len;
   336	  int size;
   337	  UChar* pool;
   338	  UChar* curr;
   339	
   340	  size = ops_calc_size_of_string_pool(reg);
   341	  if (size <= 0) {
   342	    return 0;
   343	  }
   344	
   345	  curr = pool = (UChar* )xmalloc((size_t )size);
   346	  CHECK_NULL_RETURN_MEMERR(pool);
   347	
   348	  for (i = 0; i < (int )reg->ops_used; i++) {
   349	    enum OpCode opcode;
   350	    Operation* op;
   351	
   352	    op = reg->ops + i;
   353	#ifdef USE_DIRECT_THREADED_CODE
   354	    opcode = *(reg->ocs + i);
   355	#else
   356	    opcode = op->opcode;
   357	#endif
   358	
   359	    switch (opcode) {
   360	    case OP_STR_MBN:
   361	      len = op->exact_len_n.len * op->exact_len_n.n;
   362	      xmemcpy(curr, op->exact_len_n.s, len);
   363	      xfree(op->exact_len_n.s);
   364	      op->exact_len_n.s = curr;
   365	      curr += len;
   366	      break;
   367	    case OP_STR_N:
   368	      len = op->exact_n.n;
   369	    copy:
   370	      xmemcpy(curr, op->exact_n.s, len);
   371	      xfree(op->exact_n.s);
   372	      op->exact_n.s = curr;
   373	      curr += len;
   374	      break;
   375	    case OP_STR_MB2N:
   376	      len = op->exact_n.n * 2;
   377	      goto copy;
   378	      break;
   379	    case OP_STR_MB3N:
   380	      len = op->exact_n.n * 3;
   381	      goto copy;
   382	      break;
   383	
   384	    default:
   385	      break;
   386	    }
   387	  }
   388	
   389	  reg->string_pool     = pool;
   390	  reg->string_pool_end = pool + size;
   391	  return 0;
   392	}
