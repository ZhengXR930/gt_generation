   476	static Node*
   477	node_list_add(Node* list, Node* x)
   478	{
   479	  Node *n;
   480	
   481	  n = onig_node_new_list(x, NULL);
   482	  if (IS_NULL(n)) return NULL_NODE;
   483	
   484	  if (IS_NOT_NULL(list)) {
   485	    while (IS_NOT_NULL(NODE_CDR(list)))
