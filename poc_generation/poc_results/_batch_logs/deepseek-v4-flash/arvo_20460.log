   512	node_conv_to_str_node(Node* node, Node* ref_node)
   513	{
   514	  xmemset(node, 0, sizeof(*node));
   515	  NODE_SET_TYPE(node, NODE_STRING);
   516	  NODE_STATUS(node) = NODE_STATUS(ref_node);
   517	
   518	  STR_(node)->flag     = STR_(ref_node)->flag;
   519	  STR_(node)->s        = STR_(node)->buf;
   520	  STR_(node)->end      = STR_(node)->buf;
   521	  STR_(node)->capacity = 0;
   522	}
