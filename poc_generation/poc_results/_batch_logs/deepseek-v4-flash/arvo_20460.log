   494	static int
   495	node_str_node_cat(Node* node, Node* add)
   496	{
   497	  int r;
   498	
   499	  if (NODE_STATUS(node) != NODE_STATUS(add))
   500	    return ONIGERR_TYPE_BUG;
   501	
   502	  if (STR_(node)->flag != STR_(add)->flag)
   503	    return ONIGERR_TYPE_BUG;
   504	
   505	  r = onig_node_str_cat(node, STR_(add)->s, STR_(add)->end);
   506	  if (r != 0) return r;
   507	
   508	  return 0;
   509	}
