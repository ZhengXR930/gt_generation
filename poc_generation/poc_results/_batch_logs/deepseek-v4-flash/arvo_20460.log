   436	static void
   437	node_swap(Node* a, Node* b)
   438	{
   439	  Node c;
   440	
   441	  c = *a; *a = *b; *b = c;
   442	
   443	  if (NODE_TYPE(a) == NODE_STRING) {
   444	    StrNode* sn = STR_(a);
   445	    if (sn->capacity == 0) {
   446	      int len = (int )(sn->end - sn->s);
   447	      sn->s   = sn->buf;
   448	      sn->end = sn->s + len;
   449	    }
   450	  }
   451	
   452	  if (NODE_TYPE(b) == NODE_STRING) {
   453	    StrNode* sn = STR_(b);
   454	    if (sn->capacity == 0) {
   455	      int len = (int )(sn->end - sn->s);
   456	      sn->s   = sn->buf;
   457	      sn->end = sn->s + len;
   458	    }
   459	  }
   460	}
