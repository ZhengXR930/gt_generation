   407	static int
   408	int_multiply_cmp(int x, int y, int v)
   409	{
   410	  if (x == 0 || y == 0) return -1;
   411	
   412	  if (x < INT_MAX / y) {
   413	    int xy = x * y;
   414	    if (xy > v) return 1;
   415	    else {
   416	      if (xy == v) return 0;
   417	      else return -1;
   418	    }
   419	  }
   420	  else
   421	    return 1;
   422	}
   423	
   424	extern int
   425	onig_positive_int_multiply(int x, int y)
   426	{
   427	  if (x == 0 || y == 0) return 0;
   428	
   429	  if (x < INT_MAX / y)
   430	    return x * y;
   431	  else
   432	    return -1;
   433	}
