   463	node_list_len(Node* list)
   464	{
   465	  int len;
   466	
   467	  len = 1;
   468	  while (IS_NOT_NULL(NODE_CDR(list))) {
   469	    list = NODE_CDR(list);
   470	    len++;
   471	  }
   472	
   473	  return len;
   474	}
