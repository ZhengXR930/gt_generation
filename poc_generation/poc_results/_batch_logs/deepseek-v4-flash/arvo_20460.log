   524	static OnigLen
   525	distance_add(OnigLen d1, OnigLen d2)
   526	{
   527	  if (d1 == INFINITE_LEN || d2 == INFINITE_LEN)
   528	    return INFINITE_LEN;
   529	  else {
   530	    if (d1 <= INFINITE_LEN - d2) return d1 + d2;
   531	    else return INFINITE_LEN;
   532	  }
   533	}
   534	
   535	static OnigLen
   536	distance_multiply(OnigLen d, int m)
   537	{
   538	  if (m == 0) return 0;
   539	
   540	  if (d < INFINITE_LEN / m)
   541	    return d * m;
   542	  else
   543	    return INFINITE_LEN;
   544	}
