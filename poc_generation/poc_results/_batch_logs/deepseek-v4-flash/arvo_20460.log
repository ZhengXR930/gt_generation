   599	enum CharLenReturnType {
   600	  CHAR_LEN_NORMAL = 0,       /* fixed or variable */
   601	  CHAR_LEN_TOP_ALT_FIXED = 1
   602	};
   603	
   604	static int
   605	mmcl_fixed(MinMaxCharLen* c)
   606	{
   607	  return (c->min == c->max && c->min != INFINITE_LEN);
   608	}
   609	
   610	static void
   611	mmcl_set(MinMaxCharLen* l, OnigLen len)
   612	{
   613	  l->min = len;
   614	  l->max = len;
   615	  l->min_is_sure = TRUE;
   616	}
   617	
   618	static void
   619	mmcl_set_min_max(MinMaxCharLen* l, OnigLen min, OnigLen max, int min_is_sure)
   620	{
   621	  l->min = min;
   622	  l->max = max;
   623	  l->min_is_sure = min_is_sure;
   624	}
   625	
   626	static void
   627	mmcl_add(MinMaxCharLen* to, MinMaxCharLen* add)
   628	{
   629	  to->min = distance_add(to->min, add->min);
   630	  to->max = distance_add(to->max, add->max);
   631	
   632	  to->min_is_sure = add->min_is_sure != 0 && to->min_is_sure != 0;
   633	}
   634	
   635	static void
   636	mmcl_multiply(MinMaxCharLen* to, int m)
   637	{
   638	  to->min = distance_multiply(to->min, m);
   639	  to->max = distance_multiply(to->max, m);
   640	}
   641	
   642	static void
   643	mmcl_repeat_range_multiply(MinMaxCharLen* to, int mlow, int mhigh)
   644	{
   645	  to->min = distance_multiply(to->min, mlow);
   646	
   647	  if (IS_INFINITE_REPEAT(mhigh))
   648	    to->max = INFINITE_LEN;
   649	  else
   650	    to->max = distance_multiply(to->max, mhigh);
   651	}
   652	
   653	static void
   654	mmcl_alt_merge(MinMaxCharLen* to, MinMaxCharLen* alt)
   655	{
   656	  if (to->min > alt->min) {
   657	    to->min = alt->min;
   658	    if (alt->min_is_sure != 0)
   659	      to->min_is_sure = TRUE;
   660	  }
   661	
   662	  if (to->max < alt->max) to->max = alt->max;
   663	}
   664	
   665	static int
   666	mml_is_equal(MinMaxLen* a, MinMaxLen* b)
   667	{
   668	  return a->min == b->min && a->max == b->max;
   669	}
   670	
   671	static void
   672	mml_set_min_max(MinMaxLen* l, OnigLen min, OnigLen max)
   673	{
   674	  l->min = min;
   675	  l->max = max;
   676	}
   677	
   678	static void
   679	mml_clear(MinMaxLen* l)
   680	{
   681	  l->min = l->max = 0;
   682	}
   683	
   684	static void
   685	mml_copy(MinMaxLen* to, MinMaxLen* from)
   686	{
   687	  to->min = from->min;
   688	  to->max = from->max;
   689	}
   690	
   691	static void
   692	mml_add(MinMaxLen* to, MinMaxLen* add)
   693	{
   694	  to->min = distance_add(to->min, add->min);
   695	  to->max = distance_add(to->max, add->max);
   696	}
   697	
   698	static void
   699	mml_alt_merge(MinMaxLen* to, MinMaxLen* alt)
   700	{
   701	  if (to->min > alt->min) to->min = alt->min;
   702	  if (to->max < alt->max) to->max = alt->max;
   703	}
