   507	static uint8_t paeth(uint8_t a, uint8_t b, uint8_t c)
   508	{
   509	    int16_t p = (int16_t)a + (int16_t)b - (int16_t)c;
   510	    int16_t pa = abs(p - (int16_t)a);
   511	    int16_t pb = abs(p - (int16_t)b);
   512	    int16_t pc = abs(p - (int16_t)c);
   513	
   514	    if(pa <= pb && pa <= pc) return a;
   515	    else if(pb <= pc) return b;
   516	
   517	    return c;
   518	}
