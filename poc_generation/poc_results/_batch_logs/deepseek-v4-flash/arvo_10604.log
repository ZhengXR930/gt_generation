            if(retval != UA_STATUSCODE_GOOD) {
                UA_SecureChannel_deleteMembersCleanup(channel);
                return retval;
            }
            cp->bytes = copy;
            cp->copied = true;
        }
    }
    return UA_STATUSCODE_GOOD;
}

