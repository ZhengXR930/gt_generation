      "line": null,
      "code": "for(i=0; i<strlen(hex); i=i+2) {\n    if(strncmp(hex + i, \"00\", 2) == 0) {\n        leading_zero++;\n        /* output leading zero to bin */\n        bin[start++] = 0;\n    }else{\n        break;\n    }\n}",
