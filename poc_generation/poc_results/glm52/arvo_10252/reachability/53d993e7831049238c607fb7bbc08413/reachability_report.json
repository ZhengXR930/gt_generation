  "checkpoints": [
    {
      "file": "av1/decoder/decodeframe.c",
      "function": "read_uncompressed_header",
      "line": 4996,
      "code": "",
      "note": "The uncompressed-frame-header parser has reached the restoration syntax branch, so `decode_restoration_mode(cm, rb)` now consumes attacker-controlled loop-restoration mode and unit-size bits from the staged AV1 frame.",
      "oracle_kind": "gt_parser_checkpoint",
      "kind": "parser_admitted"
    },
    {
      "file": "av1/decoder/decodeframe.c",
      "function": "decode_restoration_mode",
      "line": 1679,
      "code": "if (aom_rb_read_bit(rb)) { rsi->frame_restoration_type = aom_rb_read_bit(rb) ? RESTORE_SGRPROJ : RESTORE_WIENER; } else { rsi->frame_restoration_type = aom_rb_read_bit(rb) ? RESTORE_SWITCHABLE : RESTORE_NONE; } if (rsi->frame_restoration_type != RESTORE_NONE) { all_none = 0; chroma_none &= p == 0; }",
      "note": "The frame-header parser first materializes the attacker-controlled per-plane restoration-mode state. On the crashing path, plane 0 becomes `RESTORE_NONE` while at least one chroma plane remains enabled, so loop restoration stays on even though luma restoration is disabled.",
      "kind": "source"
    },
    {
      "file": "av1/common/thread_common.c",
      "function": "foreach_rest_unit_in_planes_mt",
      "line": null,
      "code": "for (int plane = 0; plane < num_planes; plane++) { const AV1PixelRect tile_rect = ctxt[plane].tile_rect; const int max_tile_h = tile_rect.bottom - tile_rect.top; const int unit_size = cm->seq_params.sb_size == BLOCK_128X128 ? 128 : 64; num_rows_lr = AOMMAX(num_rows_lr, av1_lr_count_units_in_tile(unit_size, max_tile_h)); }",
      "note": "The vulnerable sizing loop still iterates every plane after `av1_loop_restoration_filter_frame_init()` skipped disabled ones, reads `ctxt[plane].tile_rect`, and hardcodes the sequence superblock size instead of each active plane's parsed `restoration_unit_size`. That can make `num_rows_lr` smaller than the actual active-plane row count later used by `enqueue_lr_jobs()`, under-sizing both `cur_sb_col` and `job_queue`. The patch fixes both obligations here.",
      "kind": "root_cause_function"
    },
    {
      "file": "av1/common/thread_common.c",
      "function": "foreach_rest_unit_in_planes_mt",
      "line": 720,
      "code": "for (int plane = 0; plane < num_planes; plane++) { const AV1PixelRect tile_rect = ctxt[plane].tile_rect; const int max_tile_h = tile_rect.bottom - tile_rect.top; const int unit_size = cm->seq_params.sb_size == BLOCK_128X128 ? 128 : 64; num_rows_lr = AOMMAX(num_rows_lr, av1_lr_count_units_in_tile(unit_size, max_tile_h)); }",
      "note": "The vulnerable sizing loop still iterates every plane after `av1_loop_restoration_filter_frame_init()` skipped disabled ones, reads `ctxt[plane].tile_rect`, and hardcodes the sequence superblock size instead of each active plane's parsed `restoration_unit_size`. That can make `num_rows_lr` smaller than the actual active-plane row count later used by `enqueue_lr_jobs()`, under-sizing both `cur_sb_col` and `job_queue`. The patch fixes both obligations here.",
      "kind": "root_cause_line"
    },
    {
      "file": "av1/common/thread_common.c",
      "function": "enqueue_lr_jobs",
      "line": null,
      "code": "lr_job_queue[lr_job_counter[i & 1]].lr_unit_row = i;",
      "note": "Source-level sink. Once `lr_job_counter[i & 1]` advances past the `num_rows_lr * num_planes` allocation from `loop_restoration_alloc()`, this 4-byte store writes into the heap redzone; AddressSanitizer reports the same write at `thread_common.c:599:55`.",
      "kind": "sink_function"
    },
