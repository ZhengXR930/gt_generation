      "code": "jtmp = cJSON_GetObjectItem(j_client, \"username\");\nif(jtmp == NULL || !cJSON_IsString(jtmp)){\n\tcontinue;\n}\nusername_len = strlen(jtmp->valuestring);\nif(username_len == 0){\n\tcontinue;\n}",
