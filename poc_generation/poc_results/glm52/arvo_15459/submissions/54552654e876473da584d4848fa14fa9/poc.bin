#include <stddef.h>
#include <stdlib.h>
#include <string.h>

#include "ares.h"
#include "nameser.h"

int LLVMFuzzerTestOneInput(const unsigned char *data, unsigned long size) {
  char *name = malloc(size + 1);
  if (!name) return 0;
  name[size] = '\0';
  memcpy(name, data, size);

  unsigned char *buf = NULL;
  int buflen = 0;
  ares_create_query(name, ns_c_in, ns_t_aaaa, 1234, 0, &buf, &buflen, 0);
  free(buf);
  free(name);
  return 0;
}
