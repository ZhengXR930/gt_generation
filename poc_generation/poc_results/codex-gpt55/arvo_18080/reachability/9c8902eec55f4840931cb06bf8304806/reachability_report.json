      "oracle_kind": "gt_parser_checkpoint",
      "kind": "parser_admitted"
    },
    {
      "file": "usrsctplib/netinet/sctp_input.c",
      "function": "sctp_common_input_processing",
      "line": 5496,
      "code": "sctp_handle_asconf(m, *offset, src,",
      "note": "After the leading AUTH chunk has been accepted, this call dispatches the attacker-controlled ASCONF chunk from the injected SCTP packet into the address-configuration handler. Its parameters are the first project-side input that becomes vulnerability-relevant state by mutating the association's remote-address set used by the later per-destination send loop.",
      "kind": "source"
    },
    {
      "file": "usrsctplib/netinet/sctp_output.c",
      "function": "sctp_med_chunk_output",
      "line": null,
      "code": "endoutchain = outchain = NULL;",
      "note": "At the start of each `for (net = start_at; ...)` iteration, the vulnerable code reinitializes only the new packet chain. It does not reset the loop-local `auth` and `auth_offset`, so after an earlier send error frees the old AUTH chunk and `continue`s, the next destination iteration inherits a dangling pointer. The fix adds `auth = NULL; auth_offset = 0;` exactly here.",
      "kind": "root_cause_function"
    },
    {
      "file": "usrsctplib/netinet/sctp_output.c",
      "function": "sctp_med_chunk_output",
      "line": 8578,
      "code": "endoutchain = outchain = NULL;",
      "note": "At the start of each `for (net = start_at; ...)` iteration, the vulnerable code reinitializes only the new packet chain. It does not reset the loop-local `auth` and `auth_offset`, so after an earlier send error frees the old AUTH chunk and `continue`s, the next destination iteration inherits a dangling pointer. The fix adds `auth = NULL; auth_offset = 0;` exactly here.",
      "kind": "root_cause_line"
    },
    {
      "file": "usrsctplib/netinet/sctp_auth.c",
      "function": "sctp_fill_hmac_digest_m",
      "line": null,
      "code": "memset(auth->hmac, 0, SCTP_SIZE32(digestlen));",
      "note": "Zeroes the HMAC field through the stale `auth` pointer. ASan reports a 20-byte heap-use-after-free WRITE 100 bytes into the freed 256-byte AUTH-chunk region.",
      "kind": "sink_function"
    },
