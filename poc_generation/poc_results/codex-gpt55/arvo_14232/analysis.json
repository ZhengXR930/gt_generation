      "function": "parse_http_request",
      "line": 1180,
      "var": "buffer_end",
      "code": "if (UNLIKELY(!parse_headers(helper, buffer, helper->buffer->value + helper->buffer->len)))",
      "role": "intermediate",
      "note": "After the request line is accepted, parse_headers receives buffer_end computed from helper->buffer->value plus helper->buffer->len."
    },
    {
      "step": 5,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_headers",
      "line": 527,
      "var": "p",
      "code": "for (p = buffer + 1; n_headers < N_HEADER_START && buffer_end > p;) {",
      "role": "intermediate",
      "note": "The header collection loop only checks that p is before buffer_end, allowing a truncated header line near the end of data_copy to be recorded."
    },
    {
      "step": 6,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_headers",
      "line": 537,
      "var": "header_start[n_headers]",
      "code": "header_start[n_headers++] = next_chr;",
      "role": "intermediate",
      "note": "CRLF placement in the input stores a header-start pointer for a short trailing line such as Cont."
    },
    {
      "step": 7,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_headers",
      "line": 553,
      "var": "p",
      "code": "STRING_SWITCH_L(p) {",
      "role": "intermediate",
      "note": "The first 4-byte dispatch can match the beginning of Content when the available bytes are only Cont."
    },
    {
      "step": 8,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_headers",
      "line": 570,
      "var": "p",
      "code": "p += sizeof(\"Content\") - 1;",
      "role": "root_cause",
      "note": "The parser advances p by the full Content prefix after a 4-byte Cont match, without proving that the full prefix is present inside data_copy."
    },
    {
      "step": 9,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_headers",
      "line": 572,
      "var": "p",
      "code": "STRING_SWITCH_L(p) {",
      "role": "sink",
      "note": "The nested dispatch expands to string_as_int32(p), producing the ASAN global-buffer-overflow read immediately past data_copy."
    }
