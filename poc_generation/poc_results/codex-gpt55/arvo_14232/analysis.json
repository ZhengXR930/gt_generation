      "function": "fuzz_parse_http_request",
      "line": 1631,
      "var": "helper.buffer",
      "code": ".buffer = &(struct lwan_value){.value = data_copy, .len = length},",
      "role": "intermediate",
      "note": "The helper exposes data_copy and its input-derived length to the request parser."
    },
    {
