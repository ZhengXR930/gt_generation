      "file": "h2o/lib/http2/connection.c",
      "function": "handle_headers_frame",
      "line": 710,
      "var": "frame->flags",
      "code": "if ((frame->flags & H2O_HTTP2_FRAME_FLAG_END_STREAM) == 0)",
      "role": "source",
      "note": "The PoC sends a request HEADERS frame for stream 1 without END_STREAM, so the stream is prepared to receive request-body DATA."
    },
    {
      "step": 2,
      "file": "h2o/lib/http2/connection.c",
      "function": "handle_headers_frame",
      "line": 711,
      "var": "stream->_req_body.body",
      "code": "h2o_buffer_init(&stream->_req_body.body, &h2o_socket_buffer_prototype);",
      "role": "intermediate",
      "note": "The missing END_STREAM bit causes request-body buffering state to be allocated for the stream."
    },
    {
      "step": 3,
      "file": "h2o/lib/http2/connection.c",
      "function": "handle_incoming_request",
      "line": 411,
      "var": "stream->state",
      "code": "h2o_http2_stream_set_state(conn, stream, H2O_HTTP2_STREAM_STATE_RECV_BODY);",
      "role": "intermediate",
      "note": "Because the body buffer exists, the request is left in RECV_BODY and future DATA frames are accepted for this stream."
    },
    {
      "step": 4,
      "file": "h2o/lib/http2/connection.c",
      "function": "handle_data_frame",
      "line": 636,
      "var": "stream->req._write_req_chunk.cb",
      "code": "ret = stream->req._write_req_chunk.cb(stream->req._write_req_chunk.priv, h2o_iovec_init(payload.data, payload.length),",
      "role": "sink",
      "note": "The first non-final DATA frame is delivered to the request-body callback while the stream is still receiving body data."
    },
    {
      "step": 5,
      "file": "h2o/lib/http2/connection.c",
      "function": "write_req_chunk",
      "line": 576,
      "var": "h->has_body_stream",
      "code": "if (h != NULL && h->has_body_stream) {",
      "role": "intermediate",
      "note": "The /reproxy-test path selects the reverse-proxy handler, which has streaming request-body support enabled."
    },
    {
      "step": 6,
      "file": "h2o/lib/http2/connection.c",
      "function": "write_req_chunk",
      "line": 577,
      "var": "stream->req._write_req_chunk_done",
      "code": "stream->req._write_req_chunk_done = write_req_chunk_done;",
      "role": "intermediate",
      "note": "Streaming mode is enabled for the request body after the first non-final DATA frame."
    },
    {
      "step": 7,
      "file": "h2o/lib/http2/connection.c",
      "function": "write_req_chunk",
      "line": 586,
      "var": "is_end_stream",
      "code": "if (is_end_stream) {",
      "role": "intermediate",
      "note": "The PoC's second DATA frame carries END_STREAM while streaming mode is active."
    },
    {
      "step": 8,
      "file": "h2o/lib/http2/connection.c",
      "function": "write_req_chunk",
      "line": 588,
      "var": "stream->req._write_req_chunk.cb",
      "code": "stream->req._write_req_chunk.cb = NULL;",
      "role": "root_cause",
      "note": "On END_STREAM, the code clears the streaming callback but does not transition the HTTP/2 stream out of RECV_BODY or reject further DATA."
    },
    {
      "step": 9,
      "file": "h2o/lib/http2/connection.c",
      "function": "handle_data_frame",
      "line": 620,
      "var": "stream->state",
      "code": "} else if (stream->state != H2O_HTTP2_STREAM_STATE_RECV_BODY) {",
      "role": "intermediate",
      "note": "For the PoC's third DATA frame, stream->state is still RECV_BODY, so the protocol-error branch for closed/non-body streams is skipped."
    },
    {
      "step": 10,
      "file": "h2o/lib/http2/connection.c",
      "function": "handle_data_frame",
      "line": 636,
      "var": "stream->req._write_req_chunk.cb",
      "code": "ret = stream->req._write_req_chunk.cb(stream->req._write_req_chunk.priv, h2o_iovec_init(payload.data, payload.length),",
      "role": "intermediate",
      "note": "The post-END_STREAM DATA frame reaches the body callback dispatch after that callback has been cleared instead of producing a stream error."
    }
