      "function": "parse_http_request",
      "line": 1195,
      "var": "buffer",
      "code": "buffer = parse_proxy_protocol(request, buffer);",
      "role": "intermediate",
      "note": "Because proxy requests are allowed, HTTP parsing first passes the buffer to the proxy protocol parser."
    },
    {
      "step": 5,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_proxy_protocol",
      "line": 1179,
      "var": "buffer",
      "code": "return parse_proxy_protocol_v1(request, buffer);",
      "role": "intermediate",
      "note": "The input begins with PROX, so dispatch selects the PROXY protocol v1 parser."
    },
    {
      "step": 6,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_proxy_protocol_v1",
      "line": 164,
      "var": "end",
      "code": "end = memchr(buffer, '\\r', line_size);",
      "role": "intermediate",
      "note": "The parser finds the first carriage return near the start of the buffer and treats it as the end of the proxy line."
    },
    {
      "step": 7,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_proxy_protocol_v1",
      "line": 167,
      "var": "end",
      "code": "*end = '\\0';",
      "role": "intermediate",
      "note": "The CR is replaced by NUL, so the proxy line becomes the short string PROX."
    },
    {
      "step": 8,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_proxy_protocol_v1",
      "line": 170,
      "var": "protocol",
      "code": "protocol = buffer + sizeof(\"PROXY \") - 1;",
      "role": "intermediate",
      "note": "The parser assumes a complete PROXY prefix and advances six bytes even though the actual NUL-terminated line is only PROX."
    },
    {
      "step": 9,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_proxy_protocol_v1",
      "line": 173,
      "var": "src_port",
      "code": "src_port = strsep_char(dst_addr, ' ');",
      "role": "root_cause",
      "note": "On the crafted buffer, prior splitting reaches spaces after the NUL-terminated proxy line. This call can return ptr + 1 outside the logical proxy line because strsep_char has no end-pointer bound."
    },
    {
      "step": 10,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_proxy_protocol_v1",
      "line": 174,
      "var": "src_port",
      "code": "dst_port = strsep_char(src_port, ' ');",
      "role": "intermediate",
      "note": "The next split is invoked with a pointer that no longer belongs to the NUL-terminated proxy line."
    },
    {
      "step": 11,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "strsep_char",
      "line": 148,
      "var": "strp",
      "code": "ptr = strchr(strp, delim);",
      "role": "sink",
      "note": "strchr scans from the out-of-line pointer until it finds a delimiter or NUL; because data_copy is full and unterminated, the read crosses the global buffer boundary."
    }
