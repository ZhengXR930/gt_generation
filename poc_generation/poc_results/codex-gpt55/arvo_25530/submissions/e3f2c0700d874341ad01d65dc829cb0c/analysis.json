      "function": "wavlike_ima_decode_block",
      "line": 429,
      "var": "indx",
      "code": "indx = indxstart + chan ;",
      "role": "intermediate",
      "note": "indx starts at sample slot 1 for the one-channel block."
    },
    {
      "step": 13,
      "file": "libsndfile/src/ima_adpcm.c",
      "function": "wavlike_ima_decode_block",
      "line": 432,
      "var": "pima->samples[indx]",
      "code": "pima->samples [indx] = bytecode & 0x0F ;",
      "role": "intermediate",
      "note": "The decoder writes the low nibble and advances indx by one channel."
    },
    {
      "step": 14,
      "file": "libsndfile/src/ima_adpcm.c",
      "function": "wavlike_ima_decode_block",
      "line": 434,
      "var": "pima->samples[indx]",
      "code": "pima->samples [indx] = (bytecode >> 4) & 0x0F ;",
      "role": "sink",
      "note": "The loop continues for four byte slots and writes past the three allocated mono sample slots, corrupting the following heap buffer region."
    }
