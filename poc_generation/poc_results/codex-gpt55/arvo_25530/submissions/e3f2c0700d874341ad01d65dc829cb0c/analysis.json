      "file": "libsndfile/src/ima_adpcm.c",
      "function": "ima_reader_init",
      "line": 192,
      "var": "pima->samples",
      "code": "pima->samples\t= pima->data ;",
      "role": "intermediate",
      "note": "Decoded samples start at the flexible array."
    },
