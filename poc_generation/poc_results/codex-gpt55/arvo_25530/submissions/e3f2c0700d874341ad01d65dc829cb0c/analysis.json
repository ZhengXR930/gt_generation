      "function": "wavlike_ima_decode_block",
      "line": 427,
      "var": "blockindx",
      "code": "while (blockindx < pima->blocksize)",
      "role": "intermediate",
      "note": "With one channel, blockindx starts at 4 and a blocksize of 5 enters the loop for one remaining byte."
    },
    {
