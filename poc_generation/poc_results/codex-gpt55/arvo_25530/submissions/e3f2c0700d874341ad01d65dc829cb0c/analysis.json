      "function": "ima_reader_init",
      "line": 193,
      "var": "pima->block",
      "code": "pima->block\t\t= (unsigned char*) (pima->data + samplesperblock * psf->sf.channels) ;",
      "role": "intermediate",
      "note": "The compressed block buffer is placed immediately after samplesperblock * channels short samples."
    },
    {
      "step": 9,
      "file": "libsndfile/src/ima_adpcm.c",
      "function": "ima_reader_init",
      "line": 221,
      "var": "count",
      "code": "count = 2 * (pima->blocksize - 4 * pima->channels) / pima->channels + 1 ;",
      "role": "intermediate",
      "note": "For blocksize 5 and one channel, the accepted count is 3."
    },
    {
      "step": 10,
      "file": "libsndfile/src/ima_adpcm.c",
      "function": "ima_reader_init",
      "line": 223,
      "var": "pima->samplesperblock",
      "code": "if (pima->samplesperblock != count)",
      "role": "root_cause",
      "note": "The consistency check accepts samplesperblock 3, but does not require the compressed payload length to align with the eight-sample unpack group."
    },
    {
      "step": 11,
