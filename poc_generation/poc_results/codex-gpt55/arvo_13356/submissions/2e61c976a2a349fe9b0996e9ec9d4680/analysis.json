      "var": "name",
      "code": "ret = idn2_lookup_u8((const uint8_t *)name, (uint8_t **)&out, IDN2_NONTRANSITIONAL);",
      "role": "source",
      "note": "The project IDNA wrapper forwards the caller supplied name bytes into libidn2 lookup without normalizing or initializing any replacement storage in GnuTLS first."
    },
    {
      "step": 2,
      "file": "libidn2/lib/idna.c",
      "function": "gnutls_idna_map",
      "line": 50,
      "var": "out",
      "code": "ret = idn2_lookup_u8((const uint8_t *)name, (uint8_t **)&out, IDN2_NONTRANSITIONAL);",
      "role": "intermediate",
      "note": "The same call requests libidn2 to produce the mapped output string, so parsing and decoding decisions are delegated to idn2_lookup_u8."
    },
    {
      "step": 3,
      "file": "lib/idn2/lookup.c",
      "function": "idn2_lookup_u8",
      "line": 1,
      "var": "input",
      "code": "rc = _tr46(input, lookupname, flags);",
      "role": "intermediate",
      "note": "idn2_lookup_u8 passes the original U-label or A-label text into TR46 processing before returning it to the GnuTLS caller."
    },
    {
      "step": 4,
      "file": "lib/idn2/tr46.c",
      "function": "_tr46",
      "line": 1,
      "var": "label",
      "code": "rc = _idn2_punycode_decode(label + 4, label_len - 4, &decoded, &decoded_len);",
      "role": "intermediate",
      "note": "TR46 detects an xn-- label and strips the prefix before calling the punycode decoder on the remaining label bytes."
    },
    {
      "step": 5,
      "file": "lib/idn2/punycode.c",
      "function": "_idn2_punycode_decode",
      "line": 1,
      "var": "out[i]",
      "code": "uint32_t *out = malloc(input_length * sizeof(uint32_t));",
      "role": "root_cause",
      "note": "The decoder allocates the output code point array but does not initialize every slot before later table-style processing can inspect it."
    },
    {
      "step": 6,
      "file": "lib/idn2/punycode.c",
      "function": "_idn2_punycode_decode",
