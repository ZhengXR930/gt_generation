      "var": "size",
      "code": "if (UNLIKELY(size > (unsigned int)sizeof(*hdr)))",
      "role": "root_cause",
      "note": "The only length check compares the advertised header size against sizeof(*hdr), not against helper->buffer->len, so a short actual buffer with len=36 is accepted."
    },
