      "function": "parse_proxy_protocol_v2",
      "line": 277,
      "var": "adjusted_size",
      "code": "const size_t adjusted_size =",
      "role": "intermediate",
      "note": "The remaining-length calculation subtracts the advanced pointer from helper->buffer->value + helper->buffer->len."
    },
    {
      "step": 10,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_proxy_protocol_v2",
      "line": 278,
      "var": "adjusted_size",
      "code": "(size_t)(helper->buffer->value + helper->buffer->len - buffer);",
      "role": "intermediate",
      "note": "Because buffer now points past the actual end of the 16-byte input, the negative pointer difference is converted to a large size_t."
    },
    {
      "step": 11,
      "file": "lwan/src/lib/lwan-request.c",
      "function": "parse_proxy_protocol_v2",
