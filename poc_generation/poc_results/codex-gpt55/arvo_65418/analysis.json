      "var": "ui4_payload_type",
      "code": "case SEI_FILM_GRAIN_CHARACTERISTICS:",
      "role": "intermediate",
      "note": "A film grain characteristics SEI payload enters the FGC-specific parser."
    },
    {
      "step": 7,
      "file": "libavc/decoder/ih264d_sei.c",
      "function": "ih264d_parse_sei_payload",
      "line": 1009,
      "var": "ui4_payload_size",
      "code": "i4_status = ih264d_parse_fgc(ps_bitstrm, ps_dec, ui4_payload_size);",
      "role": "intermediate",
      "note": "The declared payload size is passed into ih264d_parse_fgc along with the same input-backed bitstream."
