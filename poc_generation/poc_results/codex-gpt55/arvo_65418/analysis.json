      "step": 8,
      "file": "libavc/decoder/ih264d_sei.c",
      "function": "ih264d_parse_fgc",
      "line": 766,
      "var": "ui4_payload_size",
      "code": "UNUSED(ui4_payload_size);",
      "role": "root_cause",
      "note": "The FGC parser discards the only bound that describes how many bits belong to this SEI payload."
    },
    {
      "step": 9,
      "file": "libavc/decoder/ih264d_sei.c",
      "function": "ih264d_parse_fgc",
      "line": 842,
      "var": "au1_num_intensity_intervals_minus1[c]",
      "code": "ps_sei->s_sei_fgc_params.au1_num_intensity_intervals_minus1[c] = (UWORD8) ih264d_get_bits_h264(ps_bitstrm, 8);",
      "role": "intermediate",
      "note": "An input-controlled interval count drives nested FGC parsing loops."
    },
    {
      "step": 10,
      "file": "libavc/decoder/ih264d_sei.c",
      "function": "ih264d_parse_fgc",
      "line": 854,
      "var": "i",
      "code": "for(i = 0; i <= ps_sei->s_sei_fgc_params.au1_num_intensity_intervals_minus1[c]; i++)",
      "role": "intermediate",
      "note": "The parser continues consuming fields according to the input-controlled loop count without checking the declared payload boundary."
    },
    {
      "step": 11,
      "file": "libavc/decoder/ih264d_sei.c",
      "function": "ih264d_parse_fgc",
      "line": 857,
      "var": "ps_bitstrm",
      "code": "(UWORD8) ih264d_get_bits_h264(ps_bitstrm, 8);",
      "role": "intermediate",
      "note": "The loop performs fixed-width bit reads that may advance beyond the actual RBSP allocation once the unchecked FGC structure outgrows the input buffer."
    },
    {
      "step": 12,
      "file": "libavc/decoder/ih264d_bitstrm.c",
      "function": "ih264d_get_bits_h264",
      "line": 94,
      "var": "ps_bitstrm->pu4_buffer",
      "code": "GETBITS(u4_code, ps_bitstrm->u4_ofst, ps_bitstrm->pu4_buffer, u4_num_bits);",
      "role": "sink",
      "note": "GETBITS indexes the bitstream word buffer using the advanced offset, causing the reported 4-byte heap-buffer-overflow read when the offset is beyond the allocated RBSP words."
    }
  ],
