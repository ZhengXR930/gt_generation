      "var": "server_public_key_len,s,data_len",
      "code": "server_public_key_len = _libssh2_ntohu32((const unsigned char *)s);",
      "role": "intermediate",
      "note": "The same parser later reads the Q_S length from the advanced pointer without checking that s is still within the packet."
    },
    {
      "step": 7,
      "file": "libssh2/src/kex.c",
      "function": "ecdh_sha2_nistp",
      "line": 1888,
      "var": "server_public_key,server_public_key_len",
      "code": "rc = _libssh2_ecdh_gen_k(&exchange_state->k, private_key, server_public_key, server_public_key_len);",
      "role": "intermediate",
      "note": "If parsing reaches Q_S, another server-controlled length and pointer are passed to elliptic-curve parsing without a remaining-buffer check."
