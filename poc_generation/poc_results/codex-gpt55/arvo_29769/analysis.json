      "code": "session->server_hostkey_len = _libssh2_ntohu32((const unsigned char *)s);",
      "role": "intermediate",
      "note": "A server-controlled uint32 is trusted as the host key length even when it exceeds the remaining reply bytes."
    },
    {
      "step": 5,
      "file": "libssh2/src/kex.c",
