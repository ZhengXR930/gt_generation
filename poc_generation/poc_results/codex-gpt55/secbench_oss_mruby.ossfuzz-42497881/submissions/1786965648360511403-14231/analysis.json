      "function": "mrb_str_format",
      "line": 826,
      "var": "len",
      "code": "len = (mrb_int)(p - RSTRING_PTR(str));",
      "role": "intermediate",
      "note": "Adding the negative precision to the string pointer makes p precede the string and stores a negative byte count in len."
    },
    {
      "step": 8,
      "file": "mrbgems/mruby-sprintf/src/sprintf.c",
      "function": "mrb_str_format",
      "line": 841,
      "var": "len",
      "code": "PUSH(RSTRING_PTR(str), len);",
      "role": "sink",
      "note": "The negative len reaches PUSH, whose memcpy length argument is converted to a huge size_t and triggers ASAN negative-size-param."
    }
