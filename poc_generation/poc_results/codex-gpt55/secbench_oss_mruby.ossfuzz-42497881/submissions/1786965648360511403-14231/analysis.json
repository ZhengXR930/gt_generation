      "function": "mrb_str_format",
      "line": 823,
      "var": "prec < slen",
      "code": "if ((flags&FPREC) && (prec < slen)) {",
      "role": "intermediate",
      "note": "The negative precision is treated as smaller than the source string length, so the truncation branch executes."
    },
    {
      "step": 7,
