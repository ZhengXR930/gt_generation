      "line": 388,
      "var": "readcount",
      "code": "err = SafeMul(&readcount, (size_t)sparse->nir, sizeof(mat_int32_t));",
      "role": "intermediate",
      "note": "The negative row count is cast to size_t and the overflow check fails, returning from the read path before sparse pointer fields are initialized."
    },
    {
      "step": 6,
      "file": "matio/src/mat.c",
      "function": "Mat_VarFree",
      "line": 1539,
      "var": "sparse->ir",
      "code": "if ( sparse->ir != NULL )",
      "role": "intermediate",
      "note": "Cleanup treats the partially initialized sparse object as valid and reads an uninitialized pointer field."
    },
    {
