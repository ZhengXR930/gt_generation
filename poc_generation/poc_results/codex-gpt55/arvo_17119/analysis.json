      "file": "matio/src/mat.c",
      "function": "Mat_VarFree",
      "line": 1540,
      "var": "sparse->ir",
      "code": "free(sparse->ir);",
      "role": "sink",
      "note": "When the uninitialized pointer is non-null, free is called on an invalid address, producing the ASan crash observed for the PoC."
    }
