      "var": "pdb_image.version",
      "code": "pdb_image.version=ReadBlobByte(image);",
      "role": "source",
      "note": "The PoC supplies version 1 in the PDB image header, selecting the RLE decoder before pixel expansion."
    },
    {
      "step": 2,
      "file": "graphicsmagick/coders/pdb.c",
      "function": "ReadPDBImage",
      "line": 469,
      "var": "pdb_image.type",
      "code": "pdb_image.type=ReadBlobByte(image);",
      "role": "intermediate",
      "note": "The PoC supplies type 0 in the PDB image header, which is the file-controlled selector for the 2-bit gray path."
    },
    {
      "step": 3,
      "file": "graphicsmagick/coders/pdb.c",
      "function": "ReadPDBImage",
      "line": 488,
      "var": "bits_per_pixel",
      "code": "bits_per_pixel=pdb_image.type == 0 ? 2 : pdb_image.type == 2 ? 4 : 1;",
      "role": "intermediate",
      "note": "Because pdb_image.type equals 0, bits_per_pixel becomes 2."
    },
    {
      "step": 4,
      "file": "graphicsmagick/coders/pdb.c",
      "function": "ReadPDBImage",
      "line": 520,
      "var": "pixels",
      "code": "if (DecodeImage(image,pixels,packets) == MagickFail)",
      "role": "intermediate",
      "note": "The RLE stream in the PoC decodes one raster byte into pixels, so the parser proceeds to the selected pixel expansion loop."
    },
    {
      "step": 5,
      "file": "graphicsmagick/coders/pdb.c",
      "function": "ReadPDBImage",
      "line": 530,
      "var": "bits_per_pixel",
      "code": "switch (bits_per_pixel)",
      "role": "intermediate",
      "note": "The computed value 2 dispatches execution to the 2-bit PDB image case."
    },
    {
      "step": 6,
      "file": "graphicsmagick/coders/pdb.c",
      "function": "ReadPDBImage",
      "line": 579,
      "var": "q",
      "code": "q=SetImagePixels(image,0,y,image->columns,1);",
      "role": "intermediate",
      "note": "A writable PixelPacket row is acquired for the decoded PDB row. SetImagePixels returns storage that the caller must initialize."
    },
    {
      "step": 7,
      "file": "graphicsmagick/coders/pdb.c",
      "function": "ReadPDBImage",
      "line": 587,
      "var": "index",
      "code": "index=(IndexPacket) (3-((*p >> shift) & 0x03));",
      "role": "intermediate",
      "note": "The decoded raster byte is converted to a palette index for each output pixel."
    },
    {
      "step": 8,
      "file": "graphicsmagick/coders/pdb.c",
      "function": "ReadPDBImage",
      "line": 589,
      "var": "indexes[x]",
      "code": "indexes[x]=index;",
      "role": "root_cause",
      "note": "The 2-bit branch stores only the colormap index. Unlike the 1-bit and 4-bit branches, it does not assign *q++=image->colormap[index], leaving the PixelPacket row contents uninitialized."
    },
    {
      "step": 9,
      "file": "graphicsmagick/coders/pdb.c",
      "function": "ReadPDBImage",
      "line": 596,
      "var": "q",
      "code": "if (!SyncImagePixels(image))",
      "role": "intermediate",
      "note": "The row is synchronized after only indexes were initialized, propagating uninitialized PixelPacket values into the image cache."
    },
    {
      "step": 10,
      "file": "graphicsmagick/coders/pdb.c",
      "function": "WritePDBImage",
      "line": 959,
      "var": "scanline",
      "code": "(void) ExportImagePixelArea(image,GrayQuantum,image->depth,scanline,0,0);",
      "role": "sink",
      "note": "The PDB fuzzer writes the decoded image back as PDB; gray export reads the cached PixelPacket data and MemorySanitizer reports use of uninitialized values."
    }
  ],
