  "checkpoints": [
    {
      "file": "src/libFLAC/stream_decoder.c",
      "function": "frame_sync_",
      "line": 2001,
      "code": "decoder->protected_->state = FLAC__STREAM_DECODER_READ_FRAME;",
      "note": "The attacker-controlled byte pair is accepted as a frame-sync candidate, so control leaves `SEARCH_FOR_FRAME_SYNC` and enters `read_frame_`, where CRC state is initialized from the current cursor.",
      "oracle_kind": "gt_parser_checkpoint",
      "kind": "parser_admitted"
    },
    {
      "file": "src/libFLAC/stream_decoder.c",
      "function": "frame_sync_",
      "line": 2000,
      "code": "decoder->private_->header_warmup[1] = (FLAC__byte)x;",
      "note": "First project-side statement that materializes attacker-controlled stream state used by the bug. After `frame_sync_` has already matched the leading `0xff`, this assignment records the second sync/header byte of a candidate frame and admits the parser into `read_frame_`, which immediately seeds CRC bookkeeping from the current bitreader cursor.",
      "kind": "source"
    },
    {
      "file": "src/libFLAC/bitreader.c",
      "function": "crc16_update_block_",
      "line": null,
      "code": "br->read_crc16 = FLAC__crc16_update_words32(br->buffer + br->crc16_offset, br->consumed_words - br->crc16_offset, br->read_crc16);",
      "note": "Missing wraparound guard. This bulk CRC call assumes `consumed_words >= crc16_offset`, but `FLAC__bitreader_clear()` can zero `consumed_words` without resetting `crc16_offset`. When the current resync scan later consumes only a smaller number of words, the unsigned subtraction underflows and the CRC helper reads out of bounds. The fix adds the missing predicate `if (br->consumed_words > br->crc16_offset)` around this call.",
      "kind": "root_cause_function"
    },
    {
      "file": "src/libFLAC/bitreader.c",
      "function": "crc16_update_block_",
      "line": 135,
      "code": "br->read_crc16 = FLAC__crc16_update_words32(br->buffer + br->crc16_offset, br->consumed_words - br->crc16_offset, br->read_crc16);",
      "note": "Missing wraparound guard. This bulk CRC call assumes `consumed_words >= crc16_offset`, but `FLAC__bitreader_clear()` can zero `consumed_words` without resetting `crc16_offset`. When the current resync scan later consumes only a smaller number of words, the unsigned subtraction underflows and the CRC helper reads out of bounds. The fix adds the missing predicate `if (br->consumed_words > br->crc16_offset)` around this call.",
      "kind": "root_cause_line"
    },
    {
      "file": "src/libFLAC/crc.c",
      "function": "FLAC__crc16_update_words32",
      "line": null,
      "code": "crc = FLAC__crc16_table[7][crc >> 8               ] ^ FLAC__crc16_table[6][crc & 0xFF             ] ^\n      FLAC__crc16_table[5][(words[0] >>  8) & 0xFF] ^ FLAC__crc16_table[4][ words[0]        & 0xFF] ^\n      FLAC__crc16_table[3][ words[1] >> 24        ] ^ FLAC__crc16_table[2][(words[1] >> 16) & 0xFF] ^\n      FLAC__crc16_table[1][(words[1] >>  8) & 0xFF] ^ FLAC__crc16_table[0][ words[1]        & 0xFF];",
      "note": "MSan sink. The wrapped `len` and advanced `words` pointer from `crc16_update_block_()` make this CRC loop dereference past `br->buffer`, and the staged sanitizer trace reports `MemorySanitizer: SEGV` on a READ at line 404 in this expression.",
      "kind": "sink_function"
    },
    {
      "file": "src/libFLAC/crc.c",
      "function": "FLAC__crc16_update_words32",
      "line": 404,
      "code": "crc = FLAC__crc16_table[7][crc >> 8               ] ^ FLAC__crc16_table[6][crc & 0xFF             ] ^\n      FLAC__crc16_table[5][(words[0] >>  8) & 0xFF] ^ FLAC__crc16_table[4][ words[0]        & 0xFF] ^\n      FLAC__crc16_table[3][ words[1] >> 24        ] ^ FLAC__crc16_table[2][(words[1] >> 16) & 0xFF] ^\n      FLAC__crc16_table[1][(words[1] >>  8) & 0xFF] ^ FLAC__crc16_table[0][ words[1]        & 0xFF];",
      "note": "MSan sink. The wrapped `len` and advanced `words` pointer from `crc16_update_block_()` make this CRC loop dereference past `br->buffer`, and the staged sanitizer trace reports `MemorySanitizer: SEGV` on a READ at line 404 in this expression.",
      "kind": "sink_line"
    }
