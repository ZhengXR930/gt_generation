      "function": "exif_data_load_data_content",
      "line": 445,
      "var": "tag",
      "code": "tag = exif_get_short (d + offset + 12 * i, data->priv->order);",
      "role": "intermediate",
      "note": "IFD0 contains an EXIF_IFD_POINTER entry, so parsing recurses into the EXIF sub-IFD that contains the MakerNote entry."
    },
    {
      "step": 3,
      "file": "libexif/libexif/exif-data.c",
      "function": "exif_data_load_data_entry",
      "line": 170,
      "var": "entry->tag",
      "code": "entry->tag        = exif_get_short (d + offset + 0, data->priv->order);",
      "role": "intermediate",
      "note": "The EXIF sub-IFD entry tag is parsed from input as EXIF_TAG_MAKER_NOTE."
    },
    {
      "step": 4,
      "file": "libexif/libexif/exif-data.c",
      "function": "exif_data_load_data_entry",
      "line": 183,
      "var": "s",
      "code": "s = exif_format_get_size(entry->format) * entry->components;",
      "role": "intermediate",
      "note": "The PoC sets MakerNote format UNDEFINED and component count 16, so the outer MakerNote byte range is considered bounded and copyable."
    },
    {
      "step": 5,
      "file": "libexif/libexif/exif-data.c",
      "function": "exif_data_load_data_entry",
      "line": 193,
      "var": "doff",
      "code": "doff = exif_get_long (d + offset + 8, data->priv->order);",
      "role": "intermediate",
      "note": "The MakerNote value offset is parsed as 44 relative to the TIFF header."
    },
    {
      "step": 6,
      "file": "libexif/libexif/exif-data.c",
      "function": "exif_data_load_data_entry",
      "line": 213,
      "var": "entry->data",
      "code": "memcpy (entry->data, d + doff, s);",
      "role": "intermediate",
      "note": "The MakerNote bytes beginning with Apple iOS are copied into the EXIF entry after the outer bounds check passes."
    },
    {
      "step": 7,
      "file": "libexif/libexif/exif-data.c",
      "function": "exif_data_load_data_entry",
      "line": 233,
      "var": "data->priv->offset_mnote",
      "code": "data->priv->offset_mnote = doff;",
      "role": "intermediate",
      "note": "The original TIFF-relative MakerNote data offset is saved for MakerNote interpretation."
    },
    {
      "step": 8,
      "file": "libexif/libexif/apple/exif-mnote-data-apple.c",
      "function": "exif_mnote_data_apple_identify",
      "line": 235,
      "var": "e->data",
      "code": "if (!strcmp((const char *) e->data, \"Apple iOS\")) {",
      "role": "intermediate",
      "note": "The copied MakerNote starts with a NUL-terminated Apple iOS string, selecting the Apple MakerNote handler."
    },
    {
      "step": 9,
      "file": "libexif/libexif/exif-data.c",
      "function": "interpret_maker_note",
      "line": 833,
      "var": "data->priv->offset_mnote",
      "code": "exif_mnote_data_set_offset (data->priv->md, data->priv->offset_mnote);",
      "role": "intermediate",
      "note": "The Apple handler receives the saved original offset rather than a MakerNote-local offset."
    },
    {
      "step": 10,
      "file": "libexif/libexif/apple/exif-mnote-data-apple.c",
      "function": "exif_mnote_data_apple_load",
      "line": 72,
      "var": "ofs",
      "code": "ofs = d->offset + 6;",
      "role": "intermediate",
      "note": "The Apple parser derives its internal base from the input-controlled MakerNote data offset."
    },
    {
      "step": 11,
      "file": "libexif/libexif/apple/exif-mnote-data-apple.c",
      "function": "exif_mnote_data_apple_load",
      "line": 85,
      "var": "tcount",
      "code": "tcount = (unsigned int) exif_get_short(buf + ofs + 14, d->order);",
      "role": "intermediate",
      "note": "The PoC sets the Apple MakerNote entry count to 100."
    },
    {
      "step": 12,
      "file": "libexif/libexif/apple/exif-mnote-data-apple.c",
      "function": "exif_mnote_data_apple_load",
      "line": 88,
      "var": "buf_size, tcount",
      "code": "if (buf_size < 6 + 16 + tcount * 6 + 4) {",
      "role": "root_cause",
      "note": "The length check ignores d->offset and accounts for only six bytes per Apple entry even though each loop iteration reads a twelve-byte entry header."
    },
    {
      "step": 13,
      "file": "libexif/libexif/apple/exif-mnote-data-apple.c",
      "function": "exif_mnote_data_apple_load",
      "line": 112,
      "var": "buf + ofs + 4",
      "code": "d->entries[i].components = exif_get_long(buf + ofs + 4, d->order);",
      "role": "intermediate",
      "note": "At later loop iterations, the unchecked Apple entry-header read advances beyond the raw input buffer."
    },
    {
      "step": 14,
      "file": "libexif/libexif/exif-utils.c",
      "function": "exif_get_slong",
      "line": 137,
      "var": "b[3]",
      "code": "return (((uint32_t)b[3] << 24) | ((uint32_t)b[2] << 16) | ((uint32_t)b[1] << 8) | (uint32_t)b[0]);",
      "role": "sink",
      "note": "The little-endian four-byte fetch reads past the heap allocation containing the fuzzer input."
    }
  ],
