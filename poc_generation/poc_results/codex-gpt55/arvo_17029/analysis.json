      "var": "u4_num_st_foll",
      "code": "ai4_poc_st_foll[u4_num_st_foll] = i4_pic_order_cnt_val + pi2_delta_poc[i];",
      "role": "sink",
      "note": "ASan reports a 4-byte stack-buffer-overflow here when u4_num_st_foll reaches the 16-entry MAX_DPB_SIZE stack array boundary."
    }
