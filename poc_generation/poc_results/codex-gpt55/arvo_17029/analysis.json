      "file": "libhevc/decoder/ihevcd_parse_slice_header.c",
      "function": "ihevcd_parse_slice_header",
      "line": 984,
      "var": "ps_slice_hdr",
      "code": "ret = ihevcd_ref_list(ps_codec, ps_pps, ps_sps, ps_slice_hdr);",
      "role": "intermediate",
      "note": "For a non-IDR picture after the first picture, parsing calls reference-list construction with the populated slice header."
    },
    {
