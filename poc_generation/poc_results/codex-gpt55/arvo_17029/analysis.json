      "function": "ihevcd_ref_list",
      "line": 170,
      "var": "i",
      "code": "for(i = num_neg_pics; i < num_neg_pics + num_pos_pics; i++)",
      "role": "intermediate",
      "note": "The malformed reference picture state reaches the positive short-term reference loop used to build the following-reference list."
    },
    {
      "step": 6,
      "file": "libhevc/decoder/ihevcd_ref_list.c",
      "function": "ihevcd_ref_list",
