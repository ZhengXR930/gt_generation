      "function": "mg_mqtt_next_prop",
      "line": null,
      "code": "prop->val.len = (uint16_t) ((((uint16_t) i[0]) << 8) | i[1]);\nprop->val.buf = (char *) i + 2;\nnew_pos += 2 + prop->val.len;",
