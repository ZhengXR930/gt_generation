  "fine_trace": [
    {
      "step": 1,
      "file": "libvips/libvips/foreign/heifload.c",
      "function": "vips_foreign_load_heif_set_header",
      "line": 428,
      "var": "length",
      "code": "size_t length = heif_image_handle_get_metadata_size(heif->handle, id[i]);",
      "role": "source",
      "note": "The HEIF input controls the size reported for each metadata item; the crashing candidate supplies an EXIF metadata item shorter than the four-byte HEIF EXIF offset prefix."
    },
    {
      "step": 2,
      "file": "libvips/libvips/foreign/heifload.c",
      "function": "vips_foreign_load_heif_set_header",
      "line": 440,
      "var": "data",
      "code": "if( !(data = VIPS_ARRAY( out, length, unsigned char )) )",
      "role": "intermediate",
      "note": "The destination buffer is allocated for exactly the original metadata length, before the EXIF-specific prefix adjustment."
    },
    {
      "step": 3,
      "file": "libvips/libvips/foreign/heifload.c",
      "function": "vips_foreign_load_heif_set_header",
      "line": 442,
      "var": "data",
      "code": "error = heif_image_handle_get_metadata( heif->handle, id[i], data );",
      "role": "intermediate",
      "note": "libheif copies the metadata bytes from the input item into the short buffer."
    },
    {
      "step": 4,
      "file": "libvips/libvips/foreign/heifload.c",
      "function": "vips_foreign_load_heif_set_header",
      "line": 452,
      "var": "type",
      "code": "if( g_ascii_strcasecmp( type, \"exif\" ) == 0 ) {",
      "role": "intermediate",
      "note": "The item type from the HEIF metadata table selects the EXIF handling branch."
    },
    {
      "step": 5,
      "file": "libvips/libvips/foreign/heifload.c",
      "function": "vips_foreign_load_heif_set_header",
      "line": 453,
      "var": "data",
      "code": "data += 4;",
      "role": "intermediate",
      "note": "The pointer is advanced by four bytes even when the metadata item is shorter than four bytes."
    },
    {
      "step": 6,
      "file": "libvips/libvips/foreign/heifload.c",
      "function": "vips_foreign_load_heif_set_header",
      "line": 454,
      "var": "length",
      "code": "length -= 4;",
      "role": "root_cause",
      "note": "Because length is size_t, a value below four underflows to a huge blob size instead of rejecting the malformed EXIF item."
    },
    {
      "step": 7,
      "file": "libvips/libvips/foreign/heifload.c",
      "function": "vips_foreign_load_heif_set_header",
      "line": 470,
      "var": "data,length,name",
      "code": "vips_image_set_blob( out, name, (VipsCallbackFn) NULL, data, length );",
      "role": "intermediate",
      "note": "The adjusted out-of-bounds pointer and underflowed length are stored as the image EXIF metadata blob."
    },
    {
      "step": 8,
      "file": "libvips/libvips/iofuncs/header.c",
      "function": "vips_image_set_blob",
      "line": 1531,
      "var": "data,size",
      "code": "vips_value_set_blob( &value, free_fn, data, size );",
      "role": "intermediate",
      "note": "The metadata value preserves the bogus blob pointer and size."
    },
    {
      "step": 9,
      "file": "libvips/libvips/iofuncs/header.c",
      "function": "vips_image_set",
      "line": 1115,
      "var": "image",
      "code": "if( vips__exif_parse( image ) )",
      "role": "intermediate",
      "note": "Setting metadata named VIPS_META_EXIF_NAME immediately invokes EXIF parsing."
    },
    {
      "step": 10,
      "file": "libvips/libvips/foreign/exif.c",
      "function": "vips__exif_parse",
      "line": 478,
      "var": "data,size",
      "code": "if( vips_image_get_blob( image, VIPS_META_EXIF_NAME, &data, &size ) )",
      "role": "intermediate",
      "note": "The malformed blob pointer and length are read back from image metadata."
    },
    {
      "step": 11,
      "file": "libvips/libvips/foreign/exif.c",
      "function": "vips__exif_parse",
      "line": 480,
      "var": "data,size",
      "code": "if( !(ed = vips_exif_load_data_without_fix( data, size )) )",
      "role": "intermediate",
      "note": "The bogus blob is passed to libvips' libexif wrapper."
    },
    {
      "step": 12,
      "file": "libvips/libvips/foreign/exif.c",
      "function": "vips_exif_load_data_without_fix",
      "line": 171,
      "var": "data,length",
      "code": "exif_data_load_data( ed, data, length );",
      "role": "intermediate",
      "note": "The unchecked pointer and underflowed length enter libexif."
    },
    {
      "step": 13,
      "file": "libexif/libexif/exif-data.c",
      "function": "exif_data_load_data",
      "line": 862,
      "var": "d,ds",
      "code": "if (!memcmp (d, ExifHeader, 6)) {",
      "role": "sink",
      "note": "The huge ds value bypasses the small-size guard and libexif reads six bytes from the adjusted pointer, past the allocated metadata item."
    }
