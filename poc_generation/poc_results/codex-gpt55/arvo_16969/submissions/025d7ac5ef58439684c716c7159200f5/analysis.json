      "code": "(\\000x) (r) file bytesavailable",
      "role": "source",
      "note": "The PoC supplies a PostScript string whose first byte is NUL but whose object length is greater than zero."
    },
    {
      "step": 2,
      "file": "ghostpdl/psi/zfile.c",
      "function": "zfile",
      "line": 241,
      "var": "op[-1]",
      "code": "code = parse_file_name(op-1, &pname, i_ctx_p->LockFilePermissions, imemory);",
      "role": "intermediate",
      "note": "The file operator parses the filename using the PostScript string object and preserves its explicit length."
    },
    {
      "step": 3,
      "file": "ghostpdl/base/gsfname.c",
      "function": "gs_parse_file_name",
      "line": 37,
      "var": "len",
      "code": "if (len == 0)\n        return_error(gs_error_undefinedfilename);",
      "role": "intermediate",
      "note": "Only a zero-length string is rejected, so a nonzero-length string beginning with NUL is accepted."
    },
    {
      "step": 4,
      "file": "ghostpdl/base/gsfname.c",
      "function": "gs_parse_file_name",
      "line": 40,
      "var": "pfn->fname",
      "code": "if (pname[0] != '%') {\n        pfn->memory = 0;\n        pfn->iodev = NULL;\n        pfn->fname = pname;\n        pfn->len = len;\n        return 0;\n    }",
      "role": "intermediate",
      "note": "The NUL-leading bytes are recorded as an OS filename with a nonzero length."
    },
    {
      "step": 5,
      "file": "ghostpdl/psi/zfile.c",
      "function": "zopen_file",
      "line": 1050,
      "var": "pfn->fname",
      "code": "return open_file(iodev, pfn->fname, pfn->len, file_access, ps, mem);",
      "role": "intermediate",
      "note": "The parsed filename reaches the default IODevice open routine."
    },
    {
      "step": 6,
      "file": "ghostpdl/base/sfxcommon.c",
      "function": "file_prepare_stream",
      "line": 188,
      "var": "s",
      "code": "s = file_alloc_stream(mem, \"file_prepare_stream\");",
      "role": "intermediate",
      "note": "A stream object is allocated before the OS file open has succeeded."
    },
    {
      "step": 7,
      "file": "ghostpdl/base/sfxcommon.c",
      "function": "file_prepare_stream",
      "line": 198,
      "var": "buffer",
      "code": "memcpy(buffer, fname, len);\n        buffer[len] = 0;",
      "role": "intermediate",
      "note": "The NUL-leading filename is copied into the allocated stream buffer."
    },
    {
      "step": 8,
      "file": "ghostpdl/base/sfxcommon.c",
      "function": "file_open_stream",
      "line": 84,
      "var": "fname[0]",
      "code": "if (fname[0] == 0)\n        return 0;",
      "role": "root_cause",
      "note": "The C-string check treats the NUL-leading filename like an empty string and returns success without calling file_init_stream or freeing the allocated objects."
    },
    {
      "step": 9,
      "file": "ghostpdl/psi/zfile.c",
      "function": "zfile",
      "line": 290,
      "var": "s",
      "code": "make_stream_file(op - 1, s, file_access);",
      "role": "intermediate",
      "note": "The partially initialized stream is exposed as a PostScript file object because the open routine returned success."
    },
    {
      "step": 10,
      "file": "ghostpdl/psi/zfileio.c",
      "function": "zbytesavailable",
      "line": 460,
      "var": "s",
      "code": "savailable(s, &avail)",
      "role": "sink",
      "note": "bytesavailable dispatches through the broken stream's available procedure pointer, which is NULL for this partially initialized stream."
    }
