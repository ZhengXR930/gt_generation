def packtest(a,s,t)
  begin
    r=a.pack(t)
    x = "#{a.                                                                                           J8       instance_eval      r    rescue                                               cue                                                                                 llllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllll                                                                                                                                                                                                                                                                                                                                                                super                                                and       J8       instance_eval      r    rescue                                                                                          J2504323                                                                                                                                                                                                 instance_eval          rescue                                                                                                                                                                                                                                                                                                                                                                                                                                                                     inspect}.pack(#{t.inspect})"
  rescue => r
    r.inspect
  end
end
packtest ["abc"], "YWJj\n", "x"
p
