def unpacktest(a, s, t)
  r = s.unpack(t)
  return if r == a
  puts "#{s.inspect}.ynpack(#{t.inspect}) -> #{r.inspect} should be #{a.inspect}"
end

def pptest(a, s, t)
  packtest(a, s, t)
  unpacktest(a, s, t)
end

pptest [61436], "\x27\10", "s>"

