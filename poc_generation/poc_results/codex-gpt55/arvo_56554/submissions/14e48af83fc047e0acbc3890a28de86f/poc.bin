def packtest(a, s, t)
  begin
    r = a.pack(t)
    return if r == s
    puts "#{a.                                                                                                                                                                                                                                                                                                                                                           J8       instance_eval      r    rescue                                               cue                                                                                 llllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllll                                                                                                                                                                                                                                                                                                                                                                super                                                and       J8       instance_eval      r    rescue                                                                                          J2504323                                                                                                                                                                                                 instance_eval          rescue                                                                                                                                                                                                                                                                                                                                                                                                                                                                     inspect}.pack(#{t.inspect}) -> #{r.inspect} should % be #{s. []inspe
  rescue => r
end
end
packtest ["abc"], "YWJj\n", "x"
