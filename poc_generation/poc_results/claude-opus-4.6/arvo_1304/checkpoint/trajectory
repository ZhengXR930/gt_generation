anup;\n   204\t                }\n   205\t\n   206\t                ret = asn1_der_decoding(&c2, in->data, in->size, NULL);\n   207\t                if (ret != ASN1_SUCCESS) {\n   208\t                        gnutls_assert();\n   209\t                        ret = _gnutls_asn2err(ret);\n   210\t                        goto cleanup;\n   211\t                }\n   212\t\n   213\t                ret =\n   214\t                    _gnutls_x509_read_string(c2, \"crlValue\", out,\n   215\t                                             ASN1_ETYPE_OCTET_STRING, 1);\n   216\t                if (ret < 0) {\n   217\t                        gnutls_assert();\n   218\t                        goto cleanup;\n   219\t                }\n   220\t                break;\n   221\t\n   222\t        case GNUTLS_BAG_SECRET:\n   223\t                if ((ret = asn1_create_element(_gnutls_get_pkix(),\n   224\t                                               \"PKIX1.pkcs-12-SecretBag\",\n   225\t                                               &c2)) != ASN1_SUCCESS) {\n   226\t                        gnutls_assert();\n   227\t                        ret = _gnutls_asn2err(ret);\n   228\t                        goto cleanup;\n   229\t                }\n   230\t\n   231\t                ret = asn1_der_decoding(&c2, in->data, in->size, NULL);\n   232\t                if (ret != ASN1_SUCCESS) {\n   233\t                        gnutls_assert();\n   234\t                        ret = _gnutls_asn2err(ret);\n   235\t                        goto cleanup;\n   236\t                }\n   237\t\n   238\t                ret =\n   239\t                    _gnutls_x509_read_string(c2, \"secretValue\", out,\n   240\t                                             ASN1_ETYPE_OCTET_STRING, 1);\n   241\t                if (ret < 0) {\n   242\t                        gnutls_assert();\n   243\t                        goto cleanup;\n   244\t                }\n   245\t                break;\n   246\t\n   247\t        default:\n   248\t                gnutls_assert();\n   249\t                asn1_delete_structure(&c2);\n   250\t                return GNUTLS_E_UNIMPLEMENTED_FEATURE;\n   251\t        }\n   252\t\n   253\t        asn1_delete_structure(&c2);\n   254\t\n   255\t        return 0;\n   256\t\n   257\t\n   258\t      cleanup:\n   259\t\n   260\t        asn1_delete_structure(&c2);\n   261\t        return ret;\n   262\t}\n   263\t\n   264\t\n   265\tint\n   266\t_pkcs12_encode_crt_bag(gnutls_pkcs12_bag_type_t type,\n   267\t                       const gnutls_datum_t * raw, gnutls_datum_t * out)\n   268\t{\n   269\t        int ret;\n   270\t        ASN1_TYPE c2 = ASN1_TYPE_EMPTY;\n   271\t\n   272\t        switch (type) {\n   273\t        case GNUTLS_BAG_CERTIFICATE:\n   274\t                if ((ret = asn1_create_element(_gnutls_get_pkix(),\n   275\t                                               \"PKIX1.pkcs-12-CertBag\",\n   276\t                                               &c2)) != ASN1_SUCCESS) {\n   277\t                        gnutls_assert();\n   278\t                        ret = _gnutls_asn2err(ret);\n   279\t                        goto cleanup;\n   280\t                }\n   281\t\n   282\t                ret = asn1_write_value(c2, \"certId\", X509_CERT_OID, 1);\n   283\t                if (ret != ASN1_SUCCESS) {\n   284\t                        gnutls_assert();\n   285\t                        ret = _gnutls_asn2err(ret);\n   286\t                        goto cleanup;\n   287\t                }\n   288\t\n   289\t                ret =\n   290\t                    _gnutls_x509_write_string(c2, \"certValue\", raw,\n   291\t                                              ASN1_ETYPE_OCTET_STRING);\n   292\t                if (ret < 0) {\n   293\t                        gnutls_assert();\n   294\t                        goto cleanup;\n   295\t                }\n   296\t                break;\n   297\t\n   298\t        case GNUTLS_BAG_CRL:\n   299\t                if ((ret = asn1_create_element(_gnutls_get_pkix(),\n   300\t                                               \"PKIX1.pkcs-12-CRLBag\",\n   301\t                                               &c2)) != ASN1_SUCCESS) {\n   302\t                        gnutls_assert();\n   303\t                        ret = _gnutls_asn2err(ret);\n   304\t                        goto cleanup;\n   305\t                }\n   306\t\n   307\t                ret = asn1_write_value(c2, \"crlId\", X509_CRL_OID, 1);\n   308\t                if (ret != ASN1_SUCCESS) {\n   309\t                        gnutls_assert();\n   310\t                        ret = _gnutls_asn2err(ret);\n   311\t                        goto cleanup;\n   312\t                }\n   313\t\n   314\t                ret =\n   315\t                    _gnutls_x509_write_string(c2, \"crlValue\", raw,\n   316\t                                              ASN1_ETYPE_OCTET_STRING);\n   317\t                if (ret < 0) {\n   318\t                        gnutls_assert();\n   319\t                        goto cleanup;\n   320\t                }\n   321\t                break;\n   322\t\n   323\t        case GNUTLS_BAG_SECRET:\n   324\t                if ((ret = asn1_create_element(_gnutls_get_pkix(),\n   325\t                                               \"PKIX1.pkcs-12-SecretBag\",\n   326\t                                               &c2)) != ASN1_SUCCESS) {\n   327\t                        gnutls_assert();\n   328\t                        ret = _gnutls_asn2err(ret);\n   329\t                        goto cleanup;\n   330\t                }\n   331\t\n   332\t                ret =\n   333\t                    asn1_write_value(c2, \"secretTypeId\", RANDOM_NONCE_OID,\n   334\t                                     1);\n   335\t                if (ret != ASN1_SUCCESS) {\n   336\t                        gnutls_assert();\n   337\t                        ret = _gnutls_asn2err(ret);\n   338\t                        goto cleanup;\n   339\t                }\n   340\t\n   341\t                ret =\n   342\t                    _gnutls_x509_write_string(c2, \"secretValue\", raw,\n   343\t                                              ASN1_ETYPE_OCTET_STRING);\n   344\t                if (ret < 0) {\n   345\t                        gnutls_assert();\n   346\t                        goto cleanup;\n   347\t                }\n   348\t                break;\n   349\t\n   350\t        default:\n   351\t                gnutls_assert();\n   352\t                asn1_delete_structure(&c2);\n   353\t                return GNUTLS_E_UNIMPLEMENTED_FEATURE;\n   354\t        }\n   355\t\n   356\t        ret = _gnutls_x509_der_encode(c2, \"\", out, 0);\n   357\t\n   358\t        if (ret < 0) {\n   359\t                gnutls_assert();\n   360\t                goto cleanup;\n   361\t        }\n   362\t\n   363\t        asn1_delete_structure(&c2);\n   364\t\n   365\t        return 0;\n   366\t\n   367\t\n   368\t      cleanup:\n   369\t\n   370\t        asn1_delete_structure(&c2);\n   371\t        return ret;\n   372\t}\n   373\t\n   374\t\n   375\t/**\n   376\t * gnutls_pkcs12_bag_set_data:\n   377\t * @bag: The bag\n   378\t * @type: The data's type\n   379\t * @data: the data to be copied.\n   380\t *\n   381\t * This function will insert the given data of the given type into\n   382\t * the bag.\n   383\t *\n   384\t * Returns: the index of the added bag on success, or a negative\n   385\t * value on error.\n   386\t **/\n   387\tint\n   388\tgnutls_pkcs12_bag_set_data(gnutls_pkcs12_bag_t bag,\n   389\t                           gnutls_pkcs12_bag_type_t type,\n   390\t                           const gnutls_datum_t * data)\n   391\t{\n   392\t        int ret;\n   393\t        if (bag == NULL) {\n   394\t                gnutls_assert();\n   395\t                return GNUTLS_E_INVALID_REQUEST;\n   396\t        }\n   397\t\n   398\t        if (bag->bag_elements == MAX_BAG_ELEMENTS - 1) {\n   399\t                gnutls_assert();\n   400\t                /* bag is full */\n   401\t                return GNUTLS_E_MEMORY_ERROR;\n   402\t        }\n   403\t\n   404\t        if (bag->bag_elements == 1) {\n   405\t                /* A bag with a key or an encrypted bag, must have\n   406\t                 * only one element.\n   407\t                 */\n   408\t\n   409\t                if (bag->element[0].type == GNUTLS_BAG_PKCS8_KEY ||\n   410\t                    bag->element[0].type == GNUTLS_BAG_PKCS8_ENCRYPTED_KEY\n   411\t                    || bag->element[0].type == GNUTLS_BAG_ENCRYPTED) {\n   412\t                        gnutls_assert();\n   413\t                        return GNUTLS_E_INVALID_REQUEST;\n   414\t                }\n   415\t        }\n   416\t\n   417\t        ret =\n   418\t            _gnutls_set_datum(&bag->element[bag->bag_elements].data,\n   419\t                              data->data, data->size);\n   420\t\n   421\t        if (ret < 0) {\n   422\t                gnutls_assert();\n   423\t                return ret;\n   424\t        }\n   425\t\n   426\t        bag->element[bag->bag_elements].type = type;\n   427\t\n   428\t        bag->bag_elements++;\n   429\t\n   430\t        return bag->bag_elements - 1;\n   431\t}\n   432\t\n   433\t/**\n   434\t * gnutls_pkcs12_bag_set_crt:\n   435\t * @bag: The bag\n   436\t * @crt: the certificate to be copied.\n   437\t *\n   438\t * This function will insert the given certificate into the\n   439\t * bag. This is just a wrapper over gnutls_pkcs12_bag_set_data().\n   440\t *\n   441\t * Returns: the index of the added bag on success, or a negative\n   442\t * value on failure.\n   443\t **/\n   444\tint\n   445\tgnutls_pkcs12_bag_set_crt(gnutls_pkcs12_bag_t bag, gnutls_x509_crt_t crt)\n   446\t{\n   447\t        int ret;\n   448\t        gnutls_datum_t data;\n   449\t\n   450\t        if (bag == NULL) {\n   451\t                gnutls_assert();\n   452\t                return GNUTLS_E_INVALID_REQUEST;\n   453\t        }\n   454\t\n   455\t        ret = _gnutls_x509_der_encode(crt->cert, \"\", &data, 0);\n   456\t        if (ret < 0) {\n   457\t                gnutls_assert();\n   458\t                return ret;\n   459\t        }\n   460\t\n   461\t        ret =\n   462\t            gnutls_pkcs12_bag_set_data(bag, GNUTLS_BAG_CERTIFICATE, &data);\n   463\t\n   464\t        _gnutls_free_datum(&data);\n   465\t\n   466\t        return ret;\n   467\t}\n   468\t\n   469\t/**\n   470\t * gnutls_pkcs12_bag_set_crl:\n   471\t * @bag: The bag\n   472\t * @crl: the CRL to be copied.\n   473\t *\n   474\t * This function will insert the given CRL into the\n   475\t * bag. This is just a wrapper over gnutls_pkcs12_bag_set_data().\n   476\t *\n   477\t * Returns: the index of the added bag on success, or a negative error code\n   478\t * on failure.\n   479\t **/\n   480\tint\n   481\tgnutls_pkcs12_bag_set_crl(gnutls_pkcs12_bag_t bag, gnutls_x509_crl_t crl)\n   482\t{\n   483\t        int ret;\n   484\t        gnutls_datum_t data;\n   485\t\n   486\t\n   487\t        if (bag == NULL) {\n   488\t                gnutls_assert();\n   489\t                return GNUTLS_E_INVALID_REQUEST;\n   490\t        }\n   491\t\n   492\t        ret = _gnutls_x509_der_encode(crl->crl, \"\", &data, 0);\n   493\t        if (ret < 0) {\n   494\t                gnutls_assert();\n   495\t                return ret;\n   496\t        }\n   497\t\n   498\t        ret = gnutls_pkcs12_bag_set_data(bag, GNUTLS_BAG_CRL, &data);\n   499\t\n   500\t        _gnutls_free_datum(&data);\n   501\t\n   502\t        return ret;\n   503\t}\n   504\t\n   505\t/**\n   506\t * gnutls_pkcs12_bag_set_key_id:\n   507\t * @bag: The bag\n   508\t * @indx: The bag's element to add the id\n   509\t * @id: the ID\n   510\t *\n   511\t * This function will add the given key ID, to the specified, by the\n   512\t * index, bag element. The key ID will be encoded as a 'Local key\n   513\t * identifier' bag attribute, which is usually used to distinguish\n   514\t * the local private key and the certificate pair.\n   515\t *\n   516\t * Returns: On success, %GNUTLS_E_SUCCESS (0) is returned, otherwise a\n   517\t *   negative error value. or a negative error code on error.\n   518\t **/\n   519\tint\n   520\tgnutls_pkcs12_bag_set_key_id(gnutls_pkcs12_bag_t bag, unsigned indx,\n   521\t                             const gnutls_datum_t * id)\n   522\t{\n   523\t        int ret;\n   524\t\n   525\t\n   526\t        if (bag == NULL) {\n   527\t                gnutls_assert();\n   528\t                return GNUTLS_E_INVALID_REQUEST;\n   529\t        }\n   530\t\n   531\t        if (indx > bag->bag_elements - 1) {\n   532\t                gnutls_assert();\n   533\t                return GNUTLS_E_INVALID_REQUEST;\n   534\t        }\n   535\t\n   536\t        ret = _gnutls_set_datum(&bag->element[indx].local_key_id,\n   537\t                                id->data, id->size);\n   538\t\n   539\t        if (ret < 0) {\n   540\t                gnutls_assert();\n   541\t                return ret;\n   542\t        }\n   543\t\n   544\t        return 0;\n   545\t}\n   546\t\n   547\t/**\n   548\t * gnutls_pkcs12_bag_get_key_id:\n   549\t * @bag: The bag\n   550\t * @indx: The bag's element to add the id\n   551\t * @id: where the ID will be copied (to be treated as const)\n   552\t *\n   553\t * This function will return the key ID, of the specified bag element.\n   554\t * The key ID is usually used to distinguish the local private key and\n   555\t * the certificate pair.\n   556\t *\n   557\t * Returns: On success, %GNUTLS_E_SUCCESS (0) is returned, otherwise a\n   558\t *   negative error value. or a negative error code on error.\n   559\t **/\n   560\tint\n   561\tgnutls_pkcs12_bag_get_key_id(gnutls_pkcs12_bag_t bag, unsigned indx,\n   562\t                             gnutls_datum_t * id)\n   563\t{\n   564\t        if (bag == NULL) {\n   565\t                gnutls_assert();\n   566\t                return GNUTLS_E_INV