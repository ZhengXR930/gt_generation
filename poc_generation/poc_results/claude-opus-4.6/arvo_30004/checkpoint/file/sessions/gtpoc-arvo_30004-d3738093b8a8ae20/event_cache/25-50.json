      } else {\n    86                  saved[data[i]]--;\n    87                  last = data[i];\n    88              }\n    89          }\n    90      }\n    91\n    92      // Map back to a list\n    93      for (i = n = 0; i < 256; i++) {\n    94          if (saved[i] > 0)\n    95              rle_syms[n++] = i;\n    96      }\n    97      *rle_nsyms = n;\n    98  }\n    99\n   100  uint8_t *rle_encode(uint8_t *data, uint64_t data_len,\n   101                      uint8_t *run,  uint64_t *run_len,\n   102                      uint8_t *rle_syms, int *rle_nsyms,\n   103                      uint8_t *out, uint64_t *out_len) {\n   104      uint64_t i, j, k;\n   105      if (!out)\n   106          if (!(out = malloc(data_len*2)))\n   107              return NULL;\n   108\n   109      // Two pass:  Firstly compute which symbols are worth using RLE on.\n   110      int64_t saved[256+MAGIC] = {0};\n   111\n   112      if (*rle_nsyms) {\n   113          for (i = 0; i < *rle_nsyms; i++)\n   114              saved[rle_syms[i]] = 1;\n   115      } else {\n   116          // Writes back to rle_syms and rle_nsyms\n   117          rle_find_syms(data, data_len, saved, rle_syms, rle_nsyms);\n   118      }\n   119\n   120      // 2nd pass: perform RLE itself to out[] and run[] arrays.\n   121      for (i = j = k = 0; i < data_len; i++) {\n   122          out[k++] = data[i];\n   123          if (saved[data[i]] > 0) {\n   124              int rlen = i;\n   125              int last = data[i];\n   126              while (i < data_len && data[i] == last)\n   127                  i++;\n   128              i--;\n   129              rlen = i-rlen;\n   130\n   131              j += var_put_u32(&run[j], NULL, rlen);\n   132          }\n   133      }\n   134\n   135      *run_len = j;\n   136      *out_len = k;\n   137      return out;\n   138  }\n   139\n   140  // On input *out_len holds the allocated size of out[].\n   141  // On output it holds the used size of out[].\n   142  uint8_t