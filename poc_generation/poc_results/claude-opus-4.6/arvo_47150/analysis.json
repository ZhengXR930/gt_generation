      "function": "_dwarf_pathjoinl",
      "line": 201,
      "var": "inputs",
      "code": "if (!is_full_path(inputs,joinchar)) {",
      "role": "intermediate",
      "note": "inputs points to the 1-byte global \"\" buffer. is_full_path is called with this pointer."
    },
    {
      "step": 6,
      "file": "libdwarf/src/lib/libdwarf/dwarf_debuglink.c",
      "function": "is_full_path",
      "line": 81,
      "var": "c1",
      "code": "c1 = path[1];",
      "role": "sink",
      "note": "path points to a 1-byte global buffer containing only '\\0'. path[0] is '\\0' (not '/'), so the function falls through to read path[1], which is 1 byte past the end of the global buffer. This is the global-buffer-overflow READ 1."
    }
