ch an empty string. */\n   354\t\n   355\tif (offset >= Foffset_top || Fovector[offset] == PCRE2_UNSET)\n   356\t  {\n   357\t  if ((mb->poptions & PCRE2_MATCH_UNSET_BACKREF) != 0)\n   358\t    {\n   359\t    *lengthptr = 0;\n   360\t    return 0;      /* Match */\n   361\t    }\n   362\t  else return -1;  /* No match */\n   363\t  }\n   364\t\n   365\t/* Separate the caseless and UTF cases for speed. */\n   366\t\n   367\teptr = eptr_start = Feptr;\n   368\tp = mb->start_subject + Fovector[offset];\n   369\tlength = Fovector[offset+1] - Fovector[offset];\n   370\t\n   371\tif (caseless)\n   372\t  {\n   373\t#if defined SUPPORT_UNICODE\n   374\t  if ((mb->poptions & PCRE2_UTF) != 0)\n   375\t    {\n   376\t    /* Match characters up to the end of the reference. NOTE: the number of\n   377\t    code units matched may differ, because in UTF-8 there are some characters\n   378\t    whose upper and lower case codes have different numbers of bytes. For\n   379\t    example, U+023A (2 bytes in UTF-8) is the upper case version of U+2C65 (3\n   380\t    bytes in UTF-8); a sequence of 3 of the former uses 6 bytes, as does a\n   381\t    sequence of two of the latter. It is important, therefore, to check the\n   382\t    length along the reference, not along the subject (earlier code did this\n   383\t    wrong). */\n   384\t\n   385\t    PCRE2_SPTR endptr = p + length;\n   386\t    while (p < endptr)\n   387\t      {\n   388\t      uint32_t c, d;\n   389\t      const ucd_record *ur;\n   390\t      if (eptr >= mb->end_subject) return 1;   /* Partial match */\n   391\t      GETCHARINC(c, eptr);\n   392\t      GETCHARINC(d, p);\n   393\t      ur = GET_UCD(d);\n   394\t      if (c != d && c != (uint32_t)((int)d + ur->other_case))\n   395\t        {\n   396\t        const uint32_t *pp = PRIV(ucd_caseless_sets) + ur->caseset;\n   397\t        for (;;)\n   398\t          {\n   399\t          if (c < *pp) return -1;  /* No match */\n   400\t          if (c == *pp++) break;\n   401\t          }\n   402\t        }\n   403\t      }\n   404\t    }\n   405\t  else\n   406\t#endif\n   407\t\n   408\t    /* Not in UTF mode */\n   409\t\n   410\t    {\n   411\t    for (; length > 0; length--)\n   412\t      {\n   413\t      uint32_t cc, cp;\n   414\t      if (eptr >= mb->end_subject) return 1;   /* Partial match */\n   415\t      cc = UCHAR21TEST(eptr);\n   416\t      cp = UCHAR21TEST(p);\n   417\t      if (TABLE_GET(cp, mb->lcc, cp) != TABLE_GET(cc, mb->lcc, cc))\n   418\t        return -1;  /* No match */\n   419\t      p++;\n   420\t      eptr++;\n   421\t      }\n   422\t    }\n   423\t  }\n   424\t\n   425\t/* In the caseful case, we can just compare the code units, whether or not we\n   426\tare in UTF mode. When partial matching, we have to do this unit-by-unit. */\n   427\t\n   428\telse\n   429\t  {\n   430\t  if (mb->partial != 0)\n   431\t    {\n   432\t    for (; length > 0; length--)\n   433\t      {\n   434\t      if (eptr >= mb->end_subject) return 1;   /* Partial match */\n   435\t      if (UCHAR21INCTEST(p) != UCHAR21INCTEST(eptr)) return -1;  /* No match */\n   436\t      }\n   437\t    }\n   438\t\n   439\t  /* Not partial matching */\n   440\t\n   441\t  else\n   442\t    {\n   443\t    if ((PCRE2_SIZE)(mb->end_subject - eptr) < length) return 1; /* Partial */\n   444\t    if (memcmp(p, eptr, CU2BYTES(length)) != 0) return -1;  /* No match */\n   445\t    eptr += length;\n   446\t    }\n   447\t  }\n   448\t\n   449\t*lengthptr = eptr - eptr_start;\n   450\treturn 0;  /* Match */\n   451\t}\n   452\t\n   453\t\n   454\t\n   455\t/******************************************************************************\n   456\t*******************************************************************************\n   457\t                   \"Recursion\" in the match() function\n   458\t\n   459\tThe original match() function was highly recursive, but this proved to be the\n   460\tsource of a number of problems over the years, mostly because of the