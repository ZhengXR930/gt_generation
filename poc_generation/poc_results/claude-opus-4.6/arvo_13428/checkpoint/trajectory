X86_INS_SIDT:\n   136\t                                case X86_INS_LGDT:\n   137\t                                case X86_INS_LIDT:\n   138\t                                        MI->x86opsize = 10;\n   139\t                                        break;\n   140\t                        }\n   141\t                        break;\n   142\t                default:        // never reach\n   143\t                        break;\n   144\t        }\n   145\t\n   146\t        printMemReference(MI, OpNo, O);\n   147\t}\n   148\t\n   149\tstatic void printi8mem(MCInst *MI, unsigned OpNo, SStream *O)\n   150\t{\n   151\t        SStream_concat0(O, \"byte ptr \");\n   152\t        MI->x86opsize = 1;\n   153\t        printMemReference(MI, OpNo, O);\n   154\t}\n   155\t\n   156\tstatic void printi16mem(MCInst *MI, unsigned OpNo, SStream *O)\n   157\t{\n   158\t        MI->x86opsize = 2;\n   159\t        SStream_concat0(O, \"word ptr \");\n   160\t        printMemReference(MI, OpNo, O);\n   161\t}\n   162\t\n   163\tstatic void printi32mem(MCInst *MI, unsigned OpNo, SStream *O)\n   164\t{\n   165\t        MI->x86opsize = 4;\n   166\t        SStream_concat0(O, \"dword ptr \");\n   167\t        printMemReference(MI, OpNo, O);\n   168\t}\n   169\t\n   170\tstatic void printi64mem(MCInst *MI, unsigned OpNo, SStream *O)\n   171\t{\n   172\t        SStream_concat0(O, \"qword ptr \");\n   173\t        MI->x86opsize = 8;\n   174\t        printMemReference(MI, OpNo, O);\n   175\t}\n   176\t\n   177\tstatic void printi128mem(MCInst *MI, unsigned OpNo, SStream *O)\n   178\t{\n   179\t        SStream_concat0(O, \"xmmword ptr \");\n   180\t        MI->x86opsize = 16;\n   181\t        printMemReference(MI, OpNo, O);\n   182\t}\n   183\t\n   184\t#ifndef CAPSTONE_X86_REDUCE\n   185\tstatic void printi512mem(MCInst *MI, unsigned OpNo, SStream *O)\n   186\t{\n   187\t        SStream_concat0(O, \"zmmword ptr \");\n   188\t        MI->x86opsize = 64;\n   189\t        printMemReference(MI, OpNo, O);\n   190\t}\n   191\t\n   192\tstatic void printi256mem(MCInst *MI, unsigned OpNo, SStream *O)\n   193\t{\n   194\t        SStream_concat0(O, \"ymmword ptr \");\n   195\t        MI->x86opsize = 32;\n   196\t        printMemReference(MI, OpNo, O);\n   197\t}\n   198\t\n   199\tstatic void printf32mem(MCInst *MI, unsigned OpNo, SStream *O)\n   200\t{\n   201\t        switch(MCInst_getOpcode(MI)) {\n   202\t                default:\n   203\t                        SStream_concat0(O, \"dword ptr \");\n   204\t                        MI->x86opsize = 4;\n   205\t                        break;\n   206\t                case X86_FSTENVm:\n   207\t                case X86_FLDENVm:\n   208\t                        // TODO: fix this in tablegen instead\n   209\t                        switch(MI->csh->mode) {\n   210\t                                default:    // never reach\n   211\t                                        break;\n   212\t                                case CS_MODE_16:\n   213\t                                        MI->x86opsize = 14;\n   214\t                                        break;\n   215\t                                case CS_MODE_32:\n   216\t                                case CS_MODE_64:\n   217\t                                        MI->x86opsize = 28;\n   218\t                                        break;\n   219\t                        }\n   220\t                        break;\n   221\t        }\n   222\t\n   223\t        printMemReference(MI, OpNo, O);\n   224\t}\n   225\t\n   226\tstatic void printf64mem(MCInst *MI, unsigned OpNo, SStream *O)\n   227\t{\n   228\t        SStream_concat0(O, \"qword ptr \");\n   229\t        MI->x86opsize = 8;\n   230\t        printMemReference(MI, OpNo, O);\n   231\t}\n   232\t\n   233\tstatic void printf80mem(MCInst *MI, unsigned OpNo, SStream *O)\n   234\t{\n   235\t        switch(MCInst_getOpcode(MI)) {\n   236\t                default:\n   237\t                        SStream_concat0(O, \"xword ptr \");\n   238\t                        break;\n   239\t                case X86_FBLDm:\n   240\t                case X86_FBSTPm:\n   241\t                        break;\n   242\t        }\n   243\t\n   244\t        MI->x86opsize = 10;\n   245\t        printMemReference(MI, OpNo, O);\n   246\t}\n   247\t\n   248\tstatic void printf128mem(MCInst *MI, unsigned OpNo, SStream *O)\n   249\t{\n   250\t        SStream_concat0(O, \"xmmword ptr \");\n   251\t        MI->x86opsize = 16;\n   252\t        printMemReference(MI, OpNo, O);\n   253\t}\n   254\t\n   255\tstatic void printf256mem(MCInst *MI, unsigned OpNo, SStream *O)\n   256\t{\n   257\t        SStream_concat0(O, \"ymmword ptr \");\n   258\t        MI->x86opsize = 32;\n   259\t        printMemReference(MI, OpNo, O);\n   260\t}\n   261\t\n   262\tstatic void printf512mem(MCInst *MI, unsigned OpNo, SStream *O)\n   263\t{\n   264\t        SStream_concat0(O, \"zmmword ptr \");\n   265\t        MI->x86opsize = 64;\n   266\t        printMemReference(MI, OpNo, O);\n   267\t}\n   268\t#endif\n   269\t\n   270\tstatic const char *getRegisterName(unsigned RegNo);\n   271\tstatic void printRegName(SStream *OS, unsigned RegNo)\n   272\t{\n   273\t        SStream_concat0(OS, getRegisterName(RegNo));\n   274\t}\n   275\t\n   276\t// for MASM syntax, 0x123 = 123h, 0xA123 = 0A123h\n   277\t// this function tell us if we need to have prefix 0 in front of a number\n   278\tstatic bool need_zero_prefix(uint64_t imm)\n   279\t{\n   280\t        // find the first hex letter representing imm\n   281\t        while(imm >= 0x10)\n   282\t                imm >>= 4;\n   283\t\n   284\t        if (imm < 0xa)\n   285\t                return false;\n   286\t        else    // this need 0 prefix\n   287\t                return true;\n   288\t}\n   289\t\n   290\tstatic void printImm(MCInst *MI, SStream *O, int64_t imm, bool positive)\n   291\t{\n   292\t        if (positive) {\n   293\t                // always print this number in positive form\n   294\t                if (MI->csh->syntax == CS_OPT_SYNTAX_MASM) {\n   295\t                        if (imm < 0) {\n   296\t                                if (MI->op1_size) {\n   297\t                                        switch(MI->op1_size) {\n   298\t                                                default:\n   299\t                                                        break;\n   300\t                                                case 1:\n   301\t                                                        imm &= 0xff;\n   302\t                                                        break;\n   303\t                                                case 2:\n   304\t                                                        imm &= 0xffff;\n   305\t                                                        break;\n   306\t                                                case 4:\n   307\t                                                        imm &= 0xffffffff;\n   308\t                                                        break;\n   309\t                                        }\n   310\t                                }\n   311\t\n   312\t                                if (imm == 0x8000000000000000LL)  // imm == -imm\n   313\t                                        SStream_concat0(O, \"8000000000000000h\");\n   314\t                                else if (need_zero_prefix(imm))\n   315\t                                        SStream_concat(O, \"0%\"PRIx64\"h\", imm);\n   316\t                                else\n   317\t                                        SStream_concat(O, \"%\"PRIx64\"h\", imm);\n   318\t                        } else {\n   319\t                                if (imm > HEX_THRESHOLD) {\n   320\t                                        if (need_zero_prefix(imm))\n   321\t                                                SStream_concat(O, \"0%\"PRIx64\"h\", imm);\n   322\t                                        else\n   323\t                                                SStream_concat(O, \"%\"PRIx64\"h\", imm);\n   324\t                                } else\n   325\t                                        SStream_concat(O, \"%\"PRIu64, imm);\n   326\t                        }\n   327\t                } else {        // Intel syntax\n   328\t                        if (imm < 0) {\n   329\t                                if (MI->op1_size) {\n   330\t                                        switch(MI->op1_size) {\n   331\t                                                default:\n   332\t                                                        break;\n   333\t                                                case 1:\n   334\t                                                        imm &= 0xff;\n   335\t                                                        break;\n   336\t                                                case 2:\n   337\t                                                        imm &= 0xffff;\n   338\t                                                        break;\n   339\t                                                case 4:\n   340\t                                                        imm &= 0xffffffff;\n   341\t                                                        break;\n   342\t                                        }\n   343\t                                }\n   344\t\n   345\t                                SStream_concat(O, \"0x%\"PRIx64, imm);\n   346\t                        } else {\n   347\t                                if (imm > HEX_THRESHOLD)\n   348\t                                        SStream_concat(O, \"0x%\"PRIx64, imm);\n   349\t                                else\n   350\t                                        SStream_concat(O, \"%\"PRIu64, imm);\n   351\t                        }\n   352\t                }\n   353\t        } else {\n   354\t                if (MI->csh->syntax == CS_OPT_SYNTAX_MASM) {\n   355\t                        if (imm < 0) {\n   356\t                                if (imm == 0x8000000000000000LL)  // imm == -imm\n   357\t                                        SStream_concat0(O, \"8000000000000000h\");\n   358\t                                else if (imm < -HEX_THRESHOLD) {\n   359\t                                        if (need_zero_prefix(imm))\n   360\t                                                SStream_concat(O, \"-0%\"PRIx64\"h\", -imm);\n   361\t                                        else\n   362\t                                                SStream_concat(O, \"-%\"PRIx64\"h\", -imm);\n   363\t                                } else\n   364\t                                        SStream_concat(O, \"-%\"PRIu64, -imm);\n   365\t                        } else {\n   366\t                                if (imm > HEX_THRESHOLD) {\n   367\t                                        if (need_zero_prefix(imm))\n   368\t                                                SStream_concat(O, \"0%\"PRIx64\"h\", imm);\n   369\t                                        else\n   370\t                                                SStream_concat(O, \"%\"PRIx64\"h\", imm);\n   371\t                                } else\n   372\t                                        SStream_concat(O, \"%\"PRIu64, imm);\n   373\t                        }\n   374\t                } else {        // Intel syntax\n   375\t                        if (imm < 0) {\n   376\t                                if (imm == 0x8000000000000000LL)  // imm == -imm\n   377\t                                        SStream_concat0(O, \"0x8000000000000000\");\n   378\t                                else if (imm < -HEX_THRESHOLD)\n   379\t                                        SStream_concat(O, \"-0x%\"PRIx64, -imm);\n   380\t                                else\n   381\t                                        SStream_concat(O, \"-%\"PRIu64, -imm);\n   382\t\n   383\t                        } else {\n   384\t                                if (imm > HEX_THRESHOLD)\n   385\t                                        SStream_concat(O, \"0x%\"PRIx64, imm);\n   386\t                                else\n   387\t                                        SStream_concat(O, \"%\"PRIu64, imm);\n   388\t                        }\n   389\t                }\n   390\t        }\n   391\t}\n   392\t\n   393\t// local printOperand, without updating public operands\n   394\tstatic void _printOperand(MCInst *MI, unsigned OpNo, SStream *O)\n   395\t{\n   396\t        MCOperand *Op  = MCInst_getOperand(MI, OpNo);\n   397\t        if (MCOperand_isReg(Op)) {\n   398\t                printRegName(O, MCOperand_getReg(Op));\n   399\t        } else if (MCOperand_isImm(Op)) {\n   400\t                int64_t imm = MCOperand_getImm(Op);\n   401\t                printImm(MI, O, imm, MI->csh->imm_unsigned);\n   402\t        }\n   403\t}\n   404\t\n   405\t#ifndef CAPSTONE_DIET\n   406\t// copy & normalize access info\n   407\tstatic void get_op_access(cs_struct *h, unsigned int id, uint8_t *access, uint64_t *eflags)\n   408\t{\n   409\t#ifndef CAPSTONE_DIET\n   410\t        uint8_t i;\n   411\t        uint8_t *arr = X86_get_op_access(h, id, eflags);\n   412\t\n   413\t        if (!arr) {\n   414\t                access[0] = 0;\n   415\t                return;\n   416\t        }\n   417\t\n   418\t        // copy to access but zero out CS_AC_IGNORE\n   419\t        for(i = 0; arr[i]; i++) {\n   420\t                if (arr[i] != CS_AC_IGNORE)\n   421\t                        access[i] = arr[i];\n   422\t                else\n   423\t                        access[i] = 0;\n   424\t        }\n   425\t\n   426\t        // mark the end of array\n   427\t        access[i] = 0;\n   428\t#endif\n   429\t}\n   430\t#endif\n   431\t\n   432\tstatic void printSrcIdx(MCInst *MI, unsigned Op, SStream *O)\n   433\t{\n   434\t        MCOperand *SegReg;\n   435\t        int reg;\n   436\t\n   437\t        if (MI->csh->detail) {\n   438\t#ifndef CAPSTONE_D