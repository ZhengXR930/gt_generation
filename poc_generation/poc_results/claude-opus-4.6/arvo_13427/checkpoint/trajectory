t#else\n   248\t        0,\n   249\t#endif\n   250\t#ifdef CAPSTONE_HAS_SPARC\n   251\t        ~(CS_MODE_BIG_ENDIAN | CS_MODE_V9),\n   252\t#else\n   253\t        0,\n   254\t#endif\n   255\t#ifdef CAPSTONE_HAS_SYSZ\n   256\t        ~(CS_MODE_BIG_ENDIAN),\n   257\t#else\n   258\t        0,\n   259\t#endif\n   260\t#ifdef CAPSTONE_HAS_XCORE\n   261\t        ~(CS_MODE_BIG_ENDIAN),\n   262\t#else\n   263\t        0,\n   264\t#endif\n   265\t#ifdef CAPSTONE_HAS_M68K\n   266\t        ~(CS_MODE_BIG_ENDIAN | CS_MODE_M68K_000 | CS_MODE_M68K_010 | CS_MODE_M68K_020\n   267\t          | CS_MODE_M68K_030 | CS_MODE_M68K_040 | CS_MODE_M68K_060),\n   268\t#else\n   269\t        0,\n   270\t#endif\n   271\t#ifdef CAPSTONE_HAS_TMS320C64X\n   272\t        ~(CS_MODE_BIG_ENDIAN),\n   273\t#else\n   274\t        0,\n   275\t#endif\n   276\t#ifdef CAPSTONE_HAS_M680X\n   277\t        ~(CS_MODE_M680X_6301 | CS_MODE_M680X_6309 | CS_MODE_M680X_6800\n   278\t          | CS_MODE_M680X_6801 | CS_MODE_M680X_6805 | CS_MODE_M680X_6808\n   279\t          | CS_MODE_M680X_6809 | CS_MODE_M680X_6811 | CS_MODE_M680X_CPU12\n   280\t          | CS_MODE_M680X_HCS08),\n   281\t#else\n   282\t        0,\n   283\t#endif\n   284\t#ifdef CAPSTONE_HAS_EVM\n   285\t        0,\n   286\t#else\n   287\t        0,\n   288\t#endif\n   289\t#ifdef CAPSTONE_HAS_WASM\n   290\t        0,\n   291\t#else\n   292\t    0,\n   293\t#endif\n   294\t#ifdef CAPSTONE_HAS_MOS65XX\n   295\t        ~(CS_MODE_BIG_ENDIAN),\n   296\t#else\n   297\t        0,\n   298\t#endif\n   299\t};\n   300\t\n   301\t// bitmask of enabled architectures\n   302\tstatic uint32_t all_arch = 0\n   303\t#ifdef CAPSTONE_HAS_ARM\n   304\t        | (1 << CS_ARCH_ARM)\n   305\t#endif\n   306\t#ifdef CAPSTONE_HAS_ARM64\n   307\t        | (1 << CS_ARCH_ARM64)\n   308\t#endif\n   309\t#ifdef CAPSTONE_HAS_MIPS\n   310\t        | (1 << CS_ARCH_MIPS)\n   311\t#endif\n   312\t#ifdef CAPSTONE_HAS_X86\n   313\t        | (1 << CS_ARCH_X86)\n   314\t#endif\n   315\t#ifdef CAPSTONE_HAS_POWERPC\n   316\t        | (1 << CS_ARCH_PPC)\n   317\t#endif\n   318\t#ifdef CAPSTONE_HAS_SPARC\n   319\t        | (1 << CS_ARCH_SPARC)\n   320\t#endif\n   321\t#ifdef CAPSTONE_HAS_SYSZ\n   322\t        | (1 << CS_ARCH_SYSZ)\n   323\t#endif\n   324\t#ifdef CAPSTONE_HAS_XCORE\n   325\t        | (1 << CS_ARCH_XCORE)\n   326\t#endif\n   327\t#ifdef CAPSTONE_HAS_M68K\n   328\t        | (1 << CS_ARCH_M68K)\n   329\t#endif\n   330\t#ifdef CAPSTONE_HAS_TMS320C64X\n   331\t        | (1 << CS_ARCH_TMS320C64X)\n   332\t#endif\n   333\t#ifdef CAPSTONE_HAS_M680X\n   334\t        | (1 << CS_ARCH_M680X)\n   335\t#endif\n   336\t#ifdef CAPSTONE_HAS_EVM\n   337\t        | (1 << CS_ARCH_EVM)\n   338\t#endif\n   339\t#ifdef CAPSTONE_HAS_WASM\n   340\t        | (1 << CS_ARCH_WASM)\n   341\t#endif\n   342\t#ifdef CAPSTONE_HAS_MOS65XX\n   343\t    | (1 << CS_ARCH_MOS65XX)\n   344\t#endif\n   345\t;\n   346\t\n   347\t\n   348\t#if defined(CAPSTONE_USE_SYS_DYN_MEM)\n   349\t#if !defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE)\n   350\t// default\n   351\tcs_malloc_t cs_mem_malloc = malloc;\n   352\tcs_calloc_t cs_mem_calloc = calloc;\n   353\tcs_realloc_t cs_mem_realloc = realloc;\n   354\tcs_free_t cs_mem_free = free;\n   355\t#if defined(_WIN32_WCE)\n   356\tcs_vsnprintf_t cs_vsnprintf = _vsnprintf;\n   357\t#else\n   358\tcs_vsnprintf_t cs_vsnprintf = vsnprintf;\n   359\t#endif  // defined(_WIN32_WCE)\n   360\t\n   361\t#elif defined(_KERNEL_MODE)\n   362\t// Windows driver\n   363\tcs_malloc_t cs_mem_malloc = cs_winkernel_malloc;\n   364\tcs_calloc_t cs_mem_calloc = cs_winkernel_calloc;\n   365\tcs_realloc_t cs_mem_realloc = cs_winkernel_realloc;\n   366\tcs_free_t cs_mem_free = cs_winkernel_free;\n   367\tcs_vsnprintf_t cs_vsnprintf = cs_winkernel_vsnprintf;\n   368\t#else\n   369\t// OSX kernel\n   370\textern void* kern_os_malloc(size_t size);\n   371\textern void kern_os_free(void* addr);\n   372\textern void* kern_os_realloc(void* addr, size_t nsize);\n   373\t\n   374\tstatic void* cs_kern_os_calloc(size_t num, size_t size)\n   375\t{\n   376\t        return kern_os_malloc(num * size); // malloc bzeroes the buffer\n   377\t}\n   378\t\n   379\tcs_malloc_t cs_mem_malloc = kern_os_malloc;\n   380\tcs_calloc_t cs_mem_calloc = cs_kern_os_calloc;\n   381\tcs_realloc_t cs_mem_realloc = kern_os_realloc;\n   382\tcs_free_t cs_mem_free = kern_os_free;\n   383\tcs_vsnprintf_t cs_vsnprintf = vsnprintf;\n   384\t#endif  // !defined(CAPSTONE_HAS_OSXKERNEL) && !defined(_KERNEL_MODE)\n   385\t#else\n   386\t// User-defined\n   387\tcs_malloc_t cs_mem_malloc = NULL;\n   388\tcs_calloc_t cs_mem_calloc = NULL;\n   389\tcs_realloc_t cs_mem_realloc = NULL;\n   390\tcs_free_t cs_mem_free = NULL;\n   391\tcs_vsnprintf_t cs_vsnprintf = NULL;\n   392\t\n   393\t#endif  // defined(CAPSTONE_USE_SYS_DYN_MEM)\n   394\t\n   395\tCAPSTONE_EXPORT\n   396\tunsigned int CAPSTONE_API cs_version(int *major, int *minor)\n   397\t{\n   398\t        if (major != NULL && minor != NULL) {\n   399\t                *major = CS_API_MAJOR;\n   400\t                *minor = CS_API_MINOR;\n   401\t        }\n   402\t\n   403\t        return (CS_API_MAJOR << 8) + CS_API_MINOR;\n   404\t}\n   405\t\n   406\tCAPSTONE_EXPORT\n   407\tbool CAPSTONE_API cs_support(int query)\n   408\t{\n   409\t        if (query == CS_ARCH_ALL)\n   410\t                return all_arch == ((1 << CS_ARCH_ARM) | (1 << CS_ARCH_ARM64) |\n   411\t                                (1 << CS_ARCH_MIPS) | (1 << CS_ARCH_X86) |\n   412\t                                (1 << CS_ARCH_PPC) | (1 << CS_ARCH_SPARC) |\n   413\t                                (1 << CS_ARCH_SYSZ) | (1 << CS_ARCH_XCORE) |\n   414\t                                (1 << CS_ARCH_M68K) | (1 << CS_ARCH_TMS320C64X) |\n   415\t                                (1 << CS_ARCH_M680X) | (1 << CS_ARCH_EVM) |\n   416\t                                (1 << CS_ARCH_MOS65XX) | (1 << CS_ARCH_WASM));\n   417\t\n   418\t        if ((unsigned int)query < CS_ARCH_MAX)\n   419\t                return all_arch & (1 << query);\n   420\t\n   421\t        if (query == CS_SUPPORT_DIET) {\n   422\t#ifdef CAPSTONE_DIET\n   423\t                return true;\n   424\t#else\n   425\t                return false;\n   426\t#endif\n   427\t        }\n   428\t\n   429\t        if (query == CS_SUPPORT_X86_REDUCE) {\n   430\t#if defined(CAPSTONE_HAS_X86) && defined(CAPSTONE_X86_REDUCE)\n   431\t                return true;\n   432\t#else\n   433\t                return false;\n   434\t#endif\n   435\t        }\n   436\t\n   437\t        // unsupported query\n   438\t        return false;\n   439\t}\n   440\t\n   441\tCAPSTONE_EXPORT\n   442\tcs_err CAPSTONE_API cs_errno(csh handle)\n   443\t{\n   444\t        struct cs_struct *ud;\n   445\t        if (!handle)\n   446\t                return CS_ERR_CSH;\n   447\t\n   448\t        ud = (struct cs_struct *)(uintptr_t)handle;\n   449\t\n   450\t        return ud->errnum;\n   451\t}\n   452\t\n   453\tCAPSTONE_EXPORT\n   454\tconst char * CAPSTONE_API cs_strerror(cs_err code)\n   455\t{\n   456\t        switch(code) {\n   457\t                default:\n   458\t                        return \"Unknown error code\";\n   459\t                case CS_ERR_OK:\n   460\t                        return \"OK (CS_ERR_OK)\";\n   461\t                case CS_ERR_MEM:\n   462\t                        return \"Out of memory (CS_ERR_MEM)\";\n   463\t                case CS_ERR_ARCH:\n   464\t                        return \"Invalid/unsupported architecture(CS_ERR_ARCH)\";\n   465\t                case CS_ERR_HANDLE:\n   466\t                        return \"Invalid handle (CS_ERR_HANDLE)\";\n   467\t                case CS_ERR_CSH:\n   468\t                        return \"Invalid csh (CS_ERR_CSH)\";\n   469\t                case CS_ERR_MODE:\n   470\t                        return \"Invalid mode (CS_ERR_MODE)\";\n   471\t                case CS_ERR_OPTION:\n   472\t                        return \"Invalid option (CS_ERR_OPTION)\";\n   473\t                case CS_ERR_DETAIL:\n   474\t                        return \"Details are unavailable (CS_ERR_DETAIL)\";\n   475\t                case CS_ERR_MEMSETUP:\n   476\t                        return \"Dynamic memory management uninitialized (CS_ERR_MEMSETUP)\";\n   477\t                case CS_ERR_VERSION:\n   478\t                        return \"Different API version between core & binding (CS_ERR_VERSION)\";\n   479\t                case CS_ERR_DIET:\n   480\t                        return \"Information irrelevant in diet engine (CS_ERR_DIET)\";\n   481\t                case CS_ERR_SKIPDATA:\n   482\t                        return \"Information irrelevant for 'data' instruction in SKIPDATA mode (CS_ERR_SKIPDATA)\";\n   483\t                case CS_ERR_X86_ATT:\n   484\t                        return \"AT&T syntax is unavailable (CS_ERR_X86_ATT)\";\n   485\t                case CS_ERR_X86_INTEL:\n   486\t                        return \"INTEL syntax is unavailable (CS_ERR_X86_INTEL)\";\n   487\t                case CS_ERR_X86_MASM:\n   488\t                        return \"MASM syntax is unavailable (CS_ERR_X86_MASM)\";\n   489\t        }\n   490\t}\n   491\t\n   492\tCAPSTONE_EXPORT\n   493\tcs_err CAPSTONE_API cs_open(cs_arch arch, cs_mode mode, csh *handle)\n   494\t{\n   495\t        cs_err err;\n   496\t        struct cs_struct *ud;\n   497\t        if (!cs_mem_malloc || !cs_mem_calloc || !cs_mem_realloc || !cs_mem_free || !cs_vsnprintf)\n   498\t                // Error: before cs_open(), dynamic memory management must be initialized\n   499\t                // with cs_option(CS_OPT_MEM)\n   500\t                return CS_ERR_MEMSETUP;\n   501\t\n   502\t        if (arch < CS_ARCH_MAX && cs_arch_init[arch]) {\n   503\t                // verify if requested mode is valid\n   504\t                if (mode & cs_arch_disallowed_mode_mask[arch]) {\n   505\t                        *handle = 0;\n   506\t                        return CS_ERR_MODE;\n   507\t                }\n   508\t\n   509\t                ud = cs_mem_calloc(1, sizeof(*ud));\n   510\t                if (!ud) {\n   511\t                        // memory insufficient\n   512\t                        return CS_ERR_MEM;\n   513\t                }\n   514\t\n   515\t                ud->errnum = CS_ERR_OK;\n   516\t                ud->arch = arch;\n   517\t                ud->mode = mode;\n   518\t                // by default, do not break instruction into details\n   519\t                ud->detail = CS_OPT_OFF;\n   520\t\n   521\t                // default skipdata setup\n   522\t                ud->skipdata_setup.mnemonic = SKIPDATA_MNEM;\n   523\t\n   524\t                err = cs_arch_init[ud->arch](ud);\n   525\t                if (err) {\n   526\t                        cs_mem_free(ud);\n   527\t                        *handle = 0;\n   528\t                        return err;\n   529\t                }\n   530\t\n   531\t                *handle = (uintptr_t)ud;\n   532\t\n   533\t                return CS_ERR_OK;\n   534\t        } else {\n   535\t                *handle = 0;\n   536\t                return CS_ERR_ARCH;\n   537\t        }\n   538\t}\n   539\t\n   540\tCAPSTONE_EXPORT\n   541\tcs_err CAPSTONE_API cs_close(csh *handle)\n   542\t{\n   543\t        struct cs_struct *ud;\n   544\t        struct insn_mnem *next, *tmp;\n   545\t\n   546\t        if (*handle == 0)\n   547\t                // invalid handle\n   548\t                return CS_ERR_CSH;\n   549\t\n   550\t        ud = (struct cs_struct *)(*handle);\n   551\t\n   552\t        if (ud->printer_info)\n   553\t                cs_mem_free(ud->printer_info);\n   554\t\n   555\t        // free the linked list of customized mnemonic\n   556\t        tmp = ud->mnem_list;\n   557\t        while(tmp) {\n   558\t                next = tmp->next;\n   559\t                cs_mem_free(tmp);\n   560\t                tmp = next;\n   561\t        }\n   562\t\n   563\t        cs_mem_free(ud->insn_cache);\n   564\t\n   565\t        memset(ud, 0, sizeof(*ud));\n   566\t        cs_mem_free(ud);\n   567\t\n   568\t        // invalidate this handle by ZERO out its value.\n   569\t        // this is to make sure it is unusable after cs_close()\n   570\t        *handle = 0;\n   571\t\n   572\t        return CS_ERR_OK;\n   573\t}\n   574\t\n   575\t// fill insn with mnemonic & operands info\n   576\tstatic void fill_insn(struct cs_struct *handle, cs_insn *insn, char *buffer, MCInst *mci,\n   577\t                PostPrinter_t postprinter, const uint8_t *code)\n   578\t{\n   579\t#ifndef CAPSTONE_DIET\n   580\t        char *sp, *mnem;\n   581\t#endif\n   582\t        uint16_t copy_size = MIN(sizeof(insn->bytes), insn->size);\n   583\t\n   584\t        // fill the instruction bytes.\n   585\t        // we might skip some redundant bytes in front in the case of X86\n   586\t        memcpy(insn->bytes, code + insn->size - copy_size, copy_size);\n   587\t        insn->size = copy_size;\n   588\t\n   589\t        // alias instruction might have ID saved in OpcodePub\n   590\t        if (MCInst_getOpcodePub(mci))\n   591\t                insn->id = MCInst_getOpcodePub(mci);\n   592\t\n   593\t        // post printer handles some corner cases (hacky)\n   594\t        if (postprinter)\n   595\t                postprinter((csh)handle, insn, buffer, mci);\n   596\t\n   597\t#ifndef CAPSTONE_DIET\n   598\t        // fill in mnemonic & operands\n   599\t        // find first space or tab\n   600\t        mnem = insn->mnemonic;\n   601\t        for (sp = buffer; *sp; sp++) {\n   602\t                if (*sp == ' '|| *sp == '\\t')\n   603\t                        break;\n   604\t                if (*sp == '|') // lock|rep prefix for x86\n   605\t                        *sp = ' ';\n   606\t                // copy to @mnemonic\n   607\t                *mnem = *sp;\n   608\t                mnem++;\n   609\t        }\n   610\t\n 