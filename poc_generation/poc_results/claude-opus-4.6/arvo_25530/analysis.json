      "var": "wav_fmt->ima.blockalign",
      "code": "bytespersec = (wav_fmt->ima.samplerate * wav_fmt->ima.blockalign) / wav_fmt->ima.samplesperblock ;",
      "role": "intermediate",
      "note": "blockalign and the unvalidated samplesperblock are combined here and both values are subsequently used to size and drive the per-block IMA ADPCM decode buffer and loop"
    },
    {
      "step": 4,
      "file": "libsndfile/src/ima_adpcm.c",
      "function": "wavlike_ima_decode_block",
      "line": 1,
      "var": "samples8",
      "code": "for (chan = 0 ; chan < channels ; chan++) for (k = 0 ; k < 8 ; k++) { *ptr++ = decoded_sample ; }",
      "role": "sink",
      "note": "the decode loop unconditionally writes 8 decoded nibbles per channel into the output buffer even though the buffer was sized from the attacker-controlled samplesperblock/blockalign, causing an out-of-bounds write when fewer samples were actually allocated"
    }
