{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["admission", "source", "root", "propagation", "sink"],
  "properties": {
    "admission": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/location_claim"}
    },
    "source": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/location_claim"}
    },
    "root": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/checked_claim"}
    },
    "propagation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/transition_claim"}
        },
        "optional": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/transition_claim"}
        }
      }
    },
    "sink": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/checked_claim"}
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "function", "line"],
      "properties": {
        "file": {"type": "string"},
        "function": {"type": "string"},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "left", "right"],
      "properties": {
        "op": {
          "type": "string",
          "enum": ["eq", "ne", "lt", "le", "gt", "ge", "same_object"]
        },
        "left": {"type": "string"},
        "right": {"type": "string"}
      }
    },
    "location_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "claim", "operands"],
      "properties": {
        "id": {"type": "string"},
        "at": {"$ref": "#/$defs/location"},
        "claim": {"type": "string"},
        "operands": {
          "type": "array",
          "maxItems": 4,
          "items": {"type": "string"}
        }
      }
    },
    "checked_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "claim", "check"],
      "properties": {
        "id": {"type": "string"},
        "at": {"$ref": "#/$defs/location"},
        "claim": {"type": "string"},
        "check": {"$ref": "#/$defs/check"}
      }
    },
    "transition_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "claim", "via", "check"],
      "properties": {
        "id": {"type": "string"},
        "from": {"$ref": "#/$defs/location"},
        "to": {"$ref": "#/$defs/location"},
        "claim": {"type": "string"},
        "via": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": "string"}
        },
        "check": {
          "anyOf": [
            {"$ref": "#/$defs/check"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
