{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["probes", "trace_claims"],
  "properties": {
    "probes": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "anchor_kind", "file", "function", "statement", "captures", "condition", "purpose"],
        "properties": {
          "stage": {"type": "string", "enum": ["admission", "source", "root", "propagation", "target"]},
          "anchor_kind": {"type": "string", "enum": ["issue", "trace"]},
          "file": {"type": "string"},
          "function": {"type": "string"},
          "statement": {"type": ["string", "null"]},
          "captures": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
          "condition": {"type": ["string", "null"]},
          "purpose": {"type": "string"}
        }
      }
    },
    "trace_claims": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string"}
    }
  }
}
