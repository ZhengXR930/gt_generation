{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims", "evidence"],
  "properties": {
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admission", "source", "root", "propagation", "target"],
      "properties": {
        "admission": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]},
        "root": {"type": ["string", "null"]},
        "propagation": {"type": ["string", "null"]},
        "target": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admission", "source", "root", "propagation", "target"],
      "properties": {
        "admission": {"$ref": "#/$defs/citations"},
        "source": {"$ref": "#/$defs/citations"},
        "root": {"$ref": "#/$defs/citations"},
        "propagation": {"$ref": "#/$defs/citations"},
        "target": {"$ref": "#/$defs/citations"}
      }
    }
  },
  "$defs": {
    "citations": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "function", "fact"],
        "properties": {
          "file": {"type": "string"},
          "function": {"type": "string"},
          "fact": {"type": "string"}
        }
      }
    }
  }
}
