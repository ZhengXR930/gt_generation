{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage_observations", "facts", "error"],
  "properties": {
    "stage_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admission", "source", "root", "propagation", "sink"],
      "properties": {
        "admission": {"$ref": "#/$defs/status"},
        "source": {"$ref": "#/$defs/status"},
        "root": {"$ref": "#/$defs/status"},
        "propagation": {"$ref": "#/$defs/status"},
        "sink": {"$ref": "#/$defs/status"}
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "stage", "kind", "statement", "data", "trusted"],
        "properties": {
          "fact_id": {"type": "string"},
          "stage": {
            "type": "string",
            "enum": ["admission", "source", "root", "propagation", "sink", "trigger"]
          },
          "kind": {"type": "string"},
          "statement": {"type": "string"},
          "data": {"type": "object"},
          "trusted": {"type": "boolean"}
        }
      }
    },
    "error": {"type": ["string", "null"]}
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["confirmed", "refuted", "unresolved", "not_reached"]
    }
  }
}
