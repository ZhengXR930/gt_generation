{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "contradiction", "delta", "evidence_ids"],
  "properties": {
    "summary": {"type": "string", "maxLength": 1800},
    "contradiction": {"type": ["string", "null"], "maxLength": 900},
    "delta": {"type": "string", "maxLength": 900},
    "evidence_ids": {
      "type": "array",
      "maxItems": 6,
      "items": {"type": "string"}
    }
  }
}
