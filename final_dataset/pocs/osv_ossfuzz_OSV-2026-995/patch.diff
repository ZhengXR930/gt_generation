From 5c707f7c5f748b060eb0e607f045ef617ea75e16 Mon Sep 17 00:00:00 2001
From: Reini Urban <reini.urban@gmail.com>
Date: Sun, 28 Jun 2026 11:41:00 +0200
Subject: [PATCH] UPGRADE_ENTITY: fix double-free when macro frees dxfname

UPGRADE_ENTITY calls free(obj->dxfname) which aliases the dxfname
parameter of new_object (via ADD_ENTITY setting obj->dxfname = dxfname).
After the free, the dxfname parameter still points to freed memory,
causing a double-free in subsequent error-path free(dxfname) calls.
Set dxfname = NULL after the free so those later free()s become safe
no-ops.

Fixes ossfuzz issue 528859714 (double-free in dxf_entities_read via
UPGRADE_ENTITY DIMENSION_ANG2LN -> DIMENSION_LINEAR upgrade).

        * src/in_dxf.h (UPGRADE_ENTITY): Set dxfname = NULL after
        free(obj->dxfname)

Co-authored-by: omp + DeepSeek V4 Pro <deepseek@deepseek.com>
---
 src/in_dxf.h | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/in_dxf.h b/src/in_dxf.h
index a1c6228d17..1869273c9c 100644
--- a/src/in_dxf.h
+++ b/src/in_dxf.h
@@ -261,6 +261,8 @@ BITCODE_RC dxf_find_lweight (const int16_t lw);
     obj->type = obj->fixedtype = DWG_TYPE_##TO;                               \
     obj->name = (char *)#TO;                                                  \
     free (obj->dxfname);                                                      \
+    dxfname                                                                   \
+        = NULL; /* obj->dxfname was freed and may equal caller's dxfname */   \
     obj->dxfname = strdup (obj->name);                                        \
     strcpy (name, obj->name);                                                 \
     LOG_TRACE ("change type to %s\n", name);                                  \
@@ -277,6 +279,8 @@ BITCODE_RC dxf_find_lweight (const int16_t lw);
     obj->type = obj->fixedtype = DWG_TYPE_##TO;                               \
     obj->name = (char *)#TO;                                                  \
     free (obj->dxfname);                                                      \
+    dxfname                                                                   \
+        = NULL; /* obj->dxfname was freed and may equal caller's dxfname */   \
     obj->dxfname = strdup (obj->name);                                        \
     strcpy (name, obj->name);                                                 \
     LOG_TRACE ("change type to %s\n", name);                                  \
