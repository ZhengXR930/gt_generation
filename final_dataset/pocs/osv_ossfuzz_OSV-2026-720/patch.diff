-          break;
-        case COAP_OPTION_URI_QUERY:
-          if (!coap_add_option(response, COAP_OPTION_LOCATION_QUERY,
-                               coap_opt_length(option),
-                               coap_opt_value(option)))
-            goto fail;
-          break;
-        default:
-          break;
-        }
-      }
-    }
   } else {
     coap_pdu_set_code(response, COAP_RESPONSE_CODE_CHANGED);
