From 13139e7be9cdb19a3eca3e170ae49261730473f8 Mon Sep 17 00:00:00 2001
From: Jon Shallow <supjps-libcoap@jpshallow.com>
Date: Sat, 9 May 2026 16:14:03 +0100
Subject: [PATCH] Options: Check Uri-Path and Location-Path options for . or ..

Check incoming Uri-Path and Location-Path options for just . or .. (or %2e
hex encoded variants) and treat as being invalid.

Stop insertion of Uri-Path and Location-Path options that contain just
. or .. (or %2e hex encoded variants).
---
 examples/coap-client.c            |  7 ++++--
 examples/coap-rd.c                |  4 +++-
 examples/coap-server.c            | 32 +++------------------------
 include/coap3/coap_pdu_internal.h | 12 +++++++++++
 include/coap3/coap_uri_internal.h | 11 ++++++++++
 src/coap_net.c                    | 25 +++++++++++++++------
 src/coap_option.c                 |  9 +++++---
 src/coap_pdu.c                    | 36 ++++++++++++++++++++-----------
 src/coap_uri.c                    | 12 +++++------
 tests/test_error_response.c       |  8 ++-----
 tests/test_pdu.c                  | 20 ++++++++---------
 11 files changed, 99 insertions(+), 77 deletions(-)

diff --git a/examples/coap-client.c b/examples/coap-client.c
index 85a9c43edc..3aec823743 100644
--- a/examples/coap-client.c
+++ b/examples/coap-client.c
@@ -340,8 +340,11 @@ coap_new_request(coap_context_t *ctx,
     coap_log_debug("cannot add token to request\n");
   }
 
-  if (options)
-    coap_add_optlist_pdu(pdu, options);
+  if (options) {
+    if (!coap_add_optlist_pdu(pdu, options)) {
+      coap_log_warn("cannot add all options to request\n");
+    }
+  }
 
   if (length) {
     /* Let the underlying libcoap decide how this data should be sent */
