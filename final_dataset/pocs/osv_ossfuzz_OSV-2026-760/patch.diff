From b8d9ee1135b8f7f26df3e86a7afb04a0ccbc55b9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Martin=20Mit=C3=A1=C5=A1?= <mity@morous.org>
Date: Sun, 17 May 2026 03:53:04 +0200
Subject: [PATCH] md_analyze_permissive_autolink: Allow tilde '~' in path of
 the URL.

Fixes #331.
---
 src/md4c.c           |  2 +-
 test/regressions.txt | 12 ++++++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/md4c.c b/src/md4c.c
index f403876d..6ddc0183 100644
--- a/src/md4c.c
+++ b/src/md4c.c
@@ -4125,7 +4125,7 @@ md_analyze_permissive_autolink(MD_CTX* ctx, int mark_index)
         /* Scan for path segment. */
         if(end < line_end  &&  CH(end) == _T('/')) {
             if(md_analyze_permissive_autolink_segment(ctx, end+1, line_end, &end, FALSE,
-                        _T('/'), _T(".+-_"), NULL, &right_cursor) < 0)
+                        _T('/'), _T(".+-_~"), NULL, &right_cursor) < 0)
                 return;
 
             /* Path can also end with additional '/' if its a directory. */
diff --git a/test/regressions.txt b/test/regressions.txt
index 1eeb96a1..97d71f94 100644
--- a/test/regressions.txt
+++ b/test/regressions.txt
@@ -908,3 +908,15 @@ tle"
 <p><a href="/url" title="ti
 tle">foo</a></p>
 ````````````````````````````````
+
+
+## [Issue 331](https://github.com/mity/md4c/issues/331)
+
+```````````````````````````````` example
+https://example.com/~username
+.
+<p><a href="https://example.com/~username">https://example.com/~username</a></p>
+.
+--fpermissive-autolinks
+````````````````````````````````
+
