From 658240b9b536f6926e5ff4500968cf024a972e1f Mon Sep 17 00:00:00 2001
From: tbeu <tbeu@users.noreply.github.com>
Date: Mon, 27 Apr 2026 19:24:39 +0200
Subject: [PATCH] Avoid uninitialized memory access

As reported by https://issues.oss-fuzz.com/505903317
---
 src/mat73.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/src/mat73.c b/src/mat73.c
index 17aa4268..958a94f1 100644
--- a/src/mat73.c
+++ b/src/mat73.c
@@ -1541,6 +1541,14 @@ Mat_H5ReadNextReferenceData(matvar_t *matvar, mat_t *mat)
                 err = Mat_H5ReadData(matvar->internal->id, data_type_id, mem_space_id, H5S_ALL,
                                      matvar->isComplex, matvar->data);
                 H5Sclose(mem_space_id);
+                if ( err ) {
+                    if ( !matvar->isComplex ) {
+                        free(matvar->data);
+                    } else {
+                        ComplexFree((mat_complex_split_t *)matvar->data);
+                    }
+                    matvar->data = NULL;
+                }
             }
             break;
         }
@@ -3043,6 +3051,14 @@ Mat_VarRead73(mat_t *mat, matvar_t *matvar)
                 err = Mat_H5ReadData(dset_id, ClassType2H5T(matvar->class_type), mem_space_id,
                                      H5S_ALL, matvar->isComplex, matvar->data);
                 H5Sclose(mem_space_id);
+                if ( err ) {
+                    if ( !matvar->isComplex ) {
+                        free(matvar->data);
+                    } else {
+                        ComplexFree((mat_complex_split_t *)matvar->data);
+                    }
+                    matvar->data = NULL;
+                }
             }
             H5Dclose(dset_id);
             H5Dclose(ref_id);
@@ -3073,6 +3089,8 @@ Mat_VarRead73(mat_t *mat, matvar_t *matvar)
                                           H5S_ALL, H5P_DEFAULT, matvar->data);
                     H5Sclose(mem_space_id);
                     if ( herr < 0 ) {
+                        free(matvar->data);
+                        matvar->data = NULL;
                         err = MATIO_E_GENERIC_READ_ERROR;
                     }
                 } else {
