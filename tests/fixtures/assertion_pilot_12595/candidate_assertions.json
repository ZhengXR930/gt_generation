{
  "schema_version": "assertion-spec-v2",
  "sample_id": "arvo_12595",
  "original_case": "int_min",
  "content_hash": "sha256:eedc5fe08575621485fbf3ea3dbb582b81ca5cecc699405ae9c5544647293a78",
  "assertions": [
    {
      "id": "observed.count_materialization",
      "invariants": ["node.materialization", "edge.count_dataflow"],
      "kind": "observed",
      "at": "materialize",
      "check": ["eq", "$stored_count", "$source_count"]
    },
    {
      "id": "observed.normalized_count_reaches_read",
      "invariants": ["node.normalization"],
      "kind": "observed",
      "at": "read",
      "check": ["eq", "$read_count", "$normalized_count"]
    },
    {
      "id": "observed.read_size_exceeds_destination",
      "invariants": ["node.read_size"],
      "kind": "observed",
      "at": "read",
      "check": ["gt", "$requested_bytes", "$destination_bytes"]
    },
    {
      "id": "required.raw_count_lower_bound",
      "invariants": ["root_cause_criterion"],
      "kind": "required",
      "at": "range_decision",
      "check": ["ge", "$raw_count", -3],
      "protects": "normalized"
    }
  ]
}
