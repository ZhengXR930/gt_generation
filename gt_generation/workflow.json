{
  "result_root": "gt_results",
  "default_timeout": 3600,
  "default_retries": 0,
  "compact_on_success": true,
  "runtime_disambiguation": false,
  "vars": {},
  "agent_command_template": "${GT_AGENT_COMMAND} --role-file {role_file} --sample {sample_path} --result-dir {result_dir}",
  "stages": [
    {
      "name": "00_prepare",
      "command_template": "PYTHONPATH={code_root} python3 -m gt_toolkit prepare --sample {sample_path} --result-dir {result_dir}",
      "required_outputs": [
        "{result_dir}/prepare_report.json",
        "{result_dir}/sample_info.json",
        "{result_dir}/default_crash_trace.txt",
        "{result_dir}/build.sh",
        "{result_dir}/poc",
        "{result_dir}/patch.diff"
      ],
      "timeout": 3000,
      "retries": 1
    },
    {
      "name": "01_reproducer",
      "role": "roles/01_reproducer.md",
      "required_outputs": [
        "{result_dir}/sanitizer_trace.txt",
        "{result_dir}/reproduction_report.json",
        "{result_dir}/sample_state.json"
      ],
      "success_check": {
        "path": "{result_dir}/reproduction_report.json",
        "all": [
          {
            "field": "vulnerable_reproduced",
            "equals": true
          },
          {
            "field": "matches_issue",
            "equals": true
          }
        ]
      },
      "timeout": 3600
    },
    {
      "name": "02_fine_trace",
      "role": "roles/02_fine_trace.md",
      "required_outputs": [
        "{result_dir}/ground_truth.json"
      ],
      "validate_gt": true,
      "validate_strict": true,
      "timeout": 2400
    },
    {
      "name": "03_trace_review",
      "role": "roles/03_trace_review.md",
      "required_outputs": [
        "{result_dir}/static_review.json",
        "{result_dir}/trace_feedback.json"
      ],
      "success_check": {
        "path": "{result_dir}/static_review.json",
        "all": [
          {
            "field": "static_valid",
            "equals": true
          },
          {
            "field": "trace_complete",
            "equals": true
          },
          {
            "field": "local_transitions_closed",
            "equals": true
          },
          {
            "field": "global_causal_chain_closed",
            "equals": true
          }
        ]
      },
      "feedback_to": "02_fine_trace",
      "runtime_role": "roles/02_runtime_disambiguation.md",
      "incremental_role": "roles/03_trace_review_incremental.md",
      "feedback_rounds": 2,
      "timeout": 1800
    },
    {
      "name": "04_assertion_plan",
      "role": "roles/04_assertion_plan.md",
      "required_outputs": [
        "{result_dir}/candidate_assertions.json",
        "{result_dir}/candidate_invariants.json",
        "{result_dir}/field_bindings.json",
        "{result_dir}/event_locations.json",
        "{result_dir}/assertion_preflight.json",
        "{result_dir}/.assertion_spec_frozen.json"
      ],
      "success_check": {
        "path": "{result_dir}/assertion_preflight.json",
        "field": "ok",
        "equals": true
      },
      "retries": 1,
      "timeout": 2400
    },
    {
      "name": "04_instrument_vulnerable",
      "role": "roles/04_instrument_vulnerable.md",
      "required_outputs": [
        "{result_dir}/vulnerable-instrumentation.patch",
        "{result_dir}/vulnerable_instrumentation_preflight.json"
      ],
      "retries": 2,
      "timeout": 7200
    },
    {
      "name": "04_instrument_fixed",
      "role": "roles/04_instrument_fixed.md",
      "required_outputs": [
        "{result_dir}/fixed-instrumentation.patch",
        "{result_dir}/fixed_instrumentation_preflight.json"
      ],
      "retries": 2,
      "timeout": 7200
    },
    {
      "name": "04_assertion_execute",
      "role": "roles/04_assertion_execute.md",
      "required_outputs": [
        "{result_dir}/vulnerable_assertion_trace.txt",
        "{result_dir}/fixed_assertion_trace.txt",
        "{result_dir}/assertion_results.json",
        "{result_dir}/perturbation_results.json",
        "{result_dir}/verified_assertions.json",
        "{result_dir}/verified_invariants.json"
      ],
      "success_check": {
        "path": "{result_dir}/assertion_results.json",
        "field": "required_verified",
        "equals": true
      },
      "retries": 1,
      "timeout": 7200
    },
    {
      "name": "04_reachability",
      "command_template": "PYTHONPATH={code_root}:{repo_root} python3 -m gt_toolkit reachability --for-result-dir {result_dir}",
      "required_outputs": [
        "{result_dir}/reachability_report.json"
      ],
      "success_check": {
        "path": "{result_dir}/reachability_report.json",
        "reachability_gate": true
      },
      "retries": 1,
      "timeout": 2400
    },
    {
      "name": "05_validate",
      "command_template": "PYTHONPATH={code_root}:{repo_root} python3 -m gt_toolkit macro-aliases --result-dir {result_dir} && PYTHONPATH={code_root}:{repo_root} python3 -m gt_toolkit validate {gt_path} --strict --json && PYTHONPATH={code_root}:{repo_root} python3 -m gt_toolkit assertions --check-bindings-only --spec {candidate_assertions_path} --verified-invariants {verified_invariants_path} --field-bindings {result_dir}/field_bindings.json --event-locations {result_dir}/event_locations.json && PYTHONPATH={code_root}:{repo_root} python3 -m gt_toolkit assertions --spec {candidate_assertions_path} --vulnerable-trace {result_dir}/vulnerable_assertion_trace.txt --fixed-trace {result_dir}/fixed_assertion_trace.txt --sanitizer-trace {result_dir}/sanitizer_trace.txt --verified-invariants {verified_invariants_path} --results-out {result_dir}/assertion_results.json --perturbation-results-out {result_dir}/perturbation_results.json --verified-assertions-out {result_dir}/verified_assertions.json --field-bindings {result_dir}/field_bindings.json --event-locations {result_dir}/event_locations.json --ground-truth {gt_path} && PYTHONPATH={code_root}:{repo_root} python3 -m gt_toolkit bind-evidence --result-dir {result_dir} && PYTHONPATH={code_root}:{repo_root} python3 -m gt_toolkit audit-package --result-dir {result_dir}",
      "timeout": 1200
    }
  ]
}
