{
  "result_root": "gt_results",
  "default_timeout": 1800,
  "default_retries": 1,
  "vars": {},
  "agent_command_template": "${GT_AGENT_COMMAND} --role-file {role_file} --sample {sample_path} --result-dir {result_dir}",
  "stages": [
    {
      "name": "00_materialize",
      "role": "roles/00_materialize.md",
      "required_outputs": [
        "{result_dir}/sample_state.json"
      ],
      "timeout": 1200
    },
    {
      "name": "01_reproducer",
      "role": "roles/01_reproducer.md",
      "required_outputs": [
        "{result_dir}/sanitizer_trace.txt",
        "{result_dir}/sample_state.json"
      ],
      "timeout": 3600
    },
    {
      "name": "02_gt_generator",
      "role": "roles/02_gt_generator.md",
      "required_outputs": [
        "{result_dir}/ground_truth.json"
      ],
      "timeout": 1800
    },
    {
      "name": "03_source_auditor",
      "role": "roles/03_source_auditor.md",
      "required_outputs": [
        "{result_dir}/source_review.json"
      ],
      "success_check": {
        "path": "{result_dir}/source_review.json",
        "field": "source_valid",
        "equals": true
      },
      "timeout": 1200
    },
    {
      "name": "04_semantic_reviewer",
      "role": "roles/04_semantic_reviewer.md",
      "required_outputs": [
        "{result_dir}/semantic_review.json"
      ],
      "success_check": {
        "path": "{result_dir}/semantic_review.json",
        "field": "semantic_valid",
        "equals": true
      },
      "timeout": 1200
    },
    {
      "name": "05_runtime_validator",
      "role": "roles/05_runtime_validator.md",
      "required_outputs": [
        "{result_dir}/reachability_report.json"
      ],
      "timeout": 1800
    },
    {
      "name": "06_validate",
      "command_template": "python3 -m gt_toolkit validate {gt_path} --json",
      "timeout": 300,
      "retries": 0
    }
  ]
}
