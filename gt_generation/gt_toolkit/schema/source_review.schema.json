{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Review",
  "type": "object",
  "required": [
    "source_valid",
    "parser_admitted_valid",
    "tainted_value_origin_valid",
    "issues",
    "suggested_fix",
    "review_notes"
  ],
  "properties": {
    "source_valid": {"type": "boolean"},
    "parser_admitted_valid": {"type": "boolean"},
    "tainted_value_origin_valid": {"type": "boolean"},
    "issues": {"type": "array", "items": {"type": "string"}},
    "suggested_fix": {},
    "review_notes": {"type": "array", "items": {"type": "string"}}
  }
}
