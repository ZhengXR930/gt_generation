{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic Review",
  "type": "object",
  "required": [
    "semantic_valid",
    "trace_complete",
    "root_cause_valid",
    "sink_valid",
    "patch_explanation_valid",
    "issues",
    "suggested_fixes",
    "review_notes"
  ],
  "properties": {
    "semantic_valid": {"type": "boolean"},
    "trace_complete": {"type": "boolean"},
    "root_cause_valid": {"type": "boolean"},
    "sink_valid": {"type": "boolean"},
    "patch_explanation_valid": {"type": "boolean"},
    "issues": {"type": "array", "items": {"type": "string"}},
    "suggested_fixes": {"type": "array"},
    "review_notes": {"type": "array", "items": {"type": "string"}}
  }
}
