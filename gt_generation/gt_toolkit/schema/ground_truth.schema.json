{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas/gt/ground_truth.schema.json",
  "title": "Fine-grained Memory-Safety Ground Truth",
  "description": "Canonical, CLI-agnostic schema for one fine-grained memory-safety GT sample. This is the single source of truth: role prompts, adapters, and the gt-toolkit validator all reference this file. Structural requirements are intentionally minimal so historical samples validate; richer expectations (value_from, description, reachability_checkpoints, line-exactness) are enforced as tiered quality checks by `gt-toolkit validate` (warn by default, error under --strict).",
  "type": "object",
  "required": [
    "sample_id",
    "vuln_id",
    "project",
    "classification",
    "bug_description",
    "source",
    "sink",
    "root_cause",
    "tainted_value_origin",
    "coarse_trace",
    "fine_trace",
    "sanitizer_ground_truth",
    "poc"
  ],
  "additionalProperties": true,
  "properties": {
    "sample_id": {"type": "string"},
    "vuln_id": {"type": "string"},
    "project": {
      "type": "object",
      "required": ["id", "repo", "vulnerable_commit", "fixed_commit"],
      "properties": {
        "id": {"type": "string"},
        "repo": {"type": "string"},
        "vulnerable_commit": {"type": "string"},
        "fixed_commit": {"type": "string"}
      }
    },
    "classification": {
      "type": "object",
      "required": ["class", "cwe"],
      "properties": {
        "class": {"type": "string"},
        "cwe": {"type": "string"}
      }
    },
    "bug_description": {
      "type": "object",
      "required": ["original", "original_source", "normalized"],
      "properties": {
        "original": {"type": "string"},
        "original_source": {"type": "string"},
        "normalized": {"type": "string"}
      }
    },
    "source": {"$ref": "#/$defs/trace_anchor"},
    "sink": {"$ref": "#/$defs/trace_anchor"},
    "root_cause": {"$ref": "#/$defs/trace_anchor"},
    "reachability_checkpoints": {
      "type": "object",
      "description": "Optional. When present, parser_admitted marks the point where attacker input has passed format/header/container dispatch and entered the target parser path. Used for R1 reachability, not for source/sink scoring.",
      "properties": {
        "parser_admitted": {"$ref": "#/$defs/location"}
      }
    },
    "tainted_value_origin": {"$ref": "#/$defs/location"},
    "coarse_trace": {
      "type": "array",
      "items": {"$ref": "#/$defs/coarse_step"}
    },
    "fine_trace": {
      "type": "array",
      "items": {"$ref": "#/$defs/trace_step"}
    },
    "sanitizer_ground_truth": {"$ref": "#/$defs/sanitizer_ground_truth"},
    "poc": {"$ref": "#/$defs/poc"}
  },
  "$defs": {
    "location": {
      "type": "object",
      "required": ["file", "function", "line"],
      "properties": {
        "file": {"type": "string"},
        "function": {"type": "string"},
        "line": {"type": ["integer", "string"]},
        "statement": {"type": "string"},
        "code": {"type": "string"},
        "description": {"type": "string"},
        "value_from": {"type": "string"},
        "var": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "trace_anchor": {
      "allOf": [
        {"$ref": "#/$defs/location"},
        {
          "type": "object",
          "required": ["trace_step"],
          "properties": {
            "trace_step": {"type": "integer", "description": "Exact fine_trace step number implementing this top-level anchor."}
          }
        }
      ]
    },
    "coarse_step": {
      "type": "object",
      "required": ["step", "file", "function", "summary"],
      "not": {"anyOf": [{"required": ["role"]}, {"required": ["kind"]}]},
      "properties": {
        "step": {"type": "integer"},
        "file": {"type": "string"},
        "function": {"type": "string"},
        "summary": {"type": "string"}
      }
    },
    "trace_step": {
      "type": "object",
      "required": ["step", "file", "function", "line", "var", "code", "note"],
      "not": {"anyOf": [{"required": ["role"]}, {"required": ["kind"]}]},
      "properties": {
        "step": {"type": "integer"},
        "file": {"type": "string"},
        "function": {"type": "string"},
        "line": {"type": "integer"},
        "line_end": {"type": "integer"},
        "var": {"type": "string"},
        "code": {"type": "string"},
        "note": {"type": "string"},
        "key": {"type": "boolean", "description": "Optional and NOT produced by stage 02. Which fine_trace nodes are the scored invariants is selected and verified by stage 04 (runtime validator), which writes them to verified_invariants.json; the agent evaluator scores against that, not against this field."},
        "depends_on": {
          "type": "array",
          "description": "Typed edges into this step encoding the source->sink association: data (value provenance), control (guard/branch/dispatch that makes the sink reachable or the missing check), order (temporal happens-before for UAF/double-free/uninit). This is the fine_trace's edge set; nodes are the steps.",
          "items": {
            "type": "object",
            "required": ["on", "type"],
            "properties": {
              "on": {"type": "integer", "description": "step number this edge comes from"},
              "type": {"enum": ["data", "control", "order"]},
              "via": {"type": "string", "description": "The edge's matchable content, code not prose (a natural-language sentence belongs in the step's `note`). data: the variable carrying the value (e.g. `len`). control: the guard PREDICATE EXPRESSION the code is missing or takes, verbatim from the patch/source (e.g. `out + count > end`). order: a relation keyword from {free_before_use, double_free, use_before_init, use_after_return, use_after_scope}."},
              "obj": {"type": "string", "description": "Optional. The pointer/object a control or order edge is about, only when it is not already one of the edge's step variables (e.g. an aliased pointer)."}
            }
          }
        }
      }
    },
    "sanitizer_ground_truth": {
      "type": "object",
      "required": [
        "detector",
        "trace_format",
        "crash_type",
        "access_type",
        "crash_location",
        "crash_stack",
        "patch_resolves",
        "cross_tool_confirmed",
        "reproduction_rate",
        "flaky",
        "cross_validation"
      ],
      "properties": {
        "detector": {"type": "string"},
        "trace_format": {"type": "string"},
        "sanitizer": {"type": "string"},
        "crash_type": {"type": "string"},
        "access_type": {"type": "string"},
        "access_size": {"type": ["integer", "null"]},
        "crash_location": {"$ref": "#/$defs/frame_location"},
        "runtime_crash_location": {"$ref": "#/$defs/frame_location"},
        "allocation_context": {"anyOf": [{"$ref": "#/$defs/frame_location"}, {"type": "null"}]},
        "free_context": {"anyOf": [{"$ref": "#/$defs/frame_location"}, {"type": "null"}]},
        "crash_stack": {"type": "array", "items": {"$ref": "#/$defs/stack_frame"}},
        "allocation_stack": {"type": "array", "items": {"$ref": "#/$defs/stack_frame"}},
        "free_stack": {"type": "array", "items": {"$ref": "#/$defs/stack_frame"}},
        "patch_resolves": {"type": "boolean"},
        "cross_tool_confirmed": {"type": "boolean"},
        "reproduction_rate": {"type": "number"},
        "flaky": {"type": "boolean"},
        "cross_validation": {
          "type": "object",
          "required": ["sink_matches_crash", "trace_consistent_with_stack", "tainted_value_reaches_sink"],
          "properties": {
            "sink_matches_crash": {"type": ["boolean", "string"]},
            "root_cause_matches_allocation_context": {"type": ["boolean", "string"]},
            "trace_consistent_with_stack": {"type": ["boolean", "string"]},
            "tainted_value_reaches_sink": {"type": ["boolean", "string"]}
          }
        }
      }
    },
    "frame_location": {
      "type": "object",
      "required": ["file", "function", "line"],
      "properties": {
        "file": {"type": "string"},
        "function": {"type": "string"},
        "line": {"type": ["integer", "string"]}
      }
    },
    "stack_frame": {
      "type": "object",
      "required": ["frame", "function", "file", "line"],
      "properties": {
        "frame": {"type": "integer"},
        "function": {"type": "string"},
        "file": {"type": "string"},
        "line": {"type": ["integer", "string"]}
      }
    },
    "poc": {
      "type": "object",
      "required": ["path", "trigger", "format"],
      "properties": {
        "path": {"type": "string"},
        "trigger": {"type": "string"},
        "format": {
          "type": "object",
          "required": ["name", "contract"],
          "properties": {
            "name": {"type": "string"},
            "contract": {"type": "string"}
          }
        }
      }
    }
  }
}
