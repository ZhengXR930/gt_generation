{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gt_contract/ground_truth.schema.json",
  "title": "Ground Truth Contract",
  "type": "object",
  "required": [
    "sample_id",
    "vuln_id",
    "project",
    "classification",
    "bug_description",
    "source",
    "root_cause",
    "sink",
    "tainted_value_origin",
    "fine_trace",
    "sanitizer_ground_truth",
    "poc"
  ],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "vuln_id": {"type": "string"},
    "project": {
      "type": "object",
      "required": ["id", "repo", "vulnerable_commit", "fixed_commit"],
      "properties": {
        "id": {"type": "string"},
        "repo": {"type": "string"},
        "vulnerable_commit": {"type": "string"},
        "fixed_commit": {"type": "string"}
      },
      "additionalProperties": true
    },
    "classification": {
      "type": "object",
      "required": ["class", "cwe"],
      "properties": {
        "class": {"type": "string"},
        "cwe": {"type": "string"}
      },
      "additionalProperties": true
    },
    "bug_description": {
      "type": "object",
      "required": ["original", "original_source", "normalized"],
      "properties": {
        "original": {"type": "string"},
        "original_source": {"type": "string"},
        "normalized": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source": {
      "description": "Source anchor. Must carry operands so it is comparable with root/sink and invariant nodes.",
      "$ref": "common.schema.json#/$defs/trace_anchor"
    },
    "root_cause": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/trace_anchor"},
        {"required": ["relation"]}
      ],
      "description": "Root-cause anchor. Requires relation because this is the causal obligation/violation to recover."
    },
    "sink": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/trace_anchor"},
        {"required": ["relation"]}
      ],
      "description": "Sink anchor. Requires relation because the sink is the unsafe consumption condition."
    },
    "tainted_value_origin": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/location"},
        {
          "type": "object",
          "required": ["operands"],
          "properties": {
            "operands": {"$ref": "common.schema.json#/$defs/operands"}
          }
        }
      ]
    },
    "fine_trace": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fine_trace_step"}
    },
    "sanitizer_ground_truth": {"type": "object"},
    "poc": {"type": "object"}
  },
  "additionalProperties": true,
  "$defs": {
    "fine_trace_step": {
      "type": "object",
      "required": ["step", "file", "function", "line", "var", "code", "note"],
      "properties": {
        "step": {"type": "integer"},
        "file": {"type": "string"},
        "function": {"type": "string"},
        "line": {"type": "integer"},
        "line_end": {"type": "integer"},
        "var": {
          "type": "string",
          "description": "Single focal expression for this trace step. Keep this as a string; invariant nodes carry multi-operand relations."
        },
        "code": {"type": "string"},
        "note": {"type": "string"},
        "depends_on": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["on", "type", "via"],
            "properties": {
              "on": {"type": "integer"},
              "type": {"enum": ["data", "control", "order"]},
              "via": {
                "type": "string",
                "minLength": 1,
                "description": "data: carrier expression; control: guard predicate; order: relation keyword."
              },
              "obj": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
