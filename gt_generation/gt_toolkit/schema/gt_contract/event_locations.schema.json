{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gt_contract/event_locations.schema.json",
  "title": "Event Locations Contract",
  "type": "object",
  "required": ["sample_id", "locations"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "locations": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          {"$ref": "common.schema.json#/$defs/location"},
          {
            "type": "object",
            "properties": {
              "trace_step": {
                "type": "integer",
                "description": "Optional fine_trace step that corresponds to this runtime event."
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
