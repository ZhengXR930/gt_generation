{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gt_contract/verified_invariants.schema.json",
  "title": "Verified Invariants Contract",
  "type": "object",
  "required": ["sample_id", "nodes", "edges", "root_cause_criterion"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "common.schema.json#/$defs/invariant_node"},
      "description": "Must include at least one source node, one root_cause node, and one sink node. Cross-item role coverage is enforced by the validator."
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/invariant_edge"}
    },
    "root_cause_criterion": {
      "type": "object",
      "required": ["invariant_id"],
      "properties": {
        "invariant_id": {
          "type": "string",
          "description": "Must equal the invariant_id of a nodes[] entry with role=root_cause."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
