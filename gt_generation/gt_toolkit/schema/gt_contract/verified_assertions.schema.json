{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gt_contract/verified_assertions.schema.json",
  "title": "Verified Assertions Contract",
  "type": "object",
  "required": ["sample_id", "assertions"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string"},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assertion"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "assertion": {
      "type": "object",
      "required": ["id", "invariants", "kind", "at", "check"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "Every id must exist in verified_invariants nodes[].invariant_id or edges[].invariant_id."
        },
        "kind": {"enum": ["required", "observed", "transition"]},
        "at": {
          "type": "string",
          "minLength": 1,
          "description": "Event id resolved by event_locations.json."
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "description": "Required for transition assertions."
        },
        "check": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"enum": ["eq", "ne", "lt", "le", "gt", "ge"]},
            {"type": ["string", "number", "boolean", "null"]},
            {"type": ["string", "number", "boolean", "null"]}
          ],
          "description": "Runtime predicate over ASSERT_EVT fields/literals. Source expressions are resolved through field_bindings.json."
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "transition"}}},
          "then": {"required": ["from"]}
        }
      ]
    }
  }
}
