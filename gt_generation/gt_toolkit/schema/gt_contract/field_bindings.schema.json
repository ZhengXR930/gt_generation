{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gt_contract/field_bindings.schema.json",
  "title": "Field Bindings Contract",
  "type": "object",
  "required": ["sample_id", "bindings"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "description": "Legacy compact form: event.field maps directly to a source expression."
          },
          {
            "type": "object",
            "required": ["expr"],
            "properties": {
              "expr": {
                "$ref": "common.schema.json#/$defs/operand",
                "description": "Canonical source expression for this runtime field."
              },
              "aliases": {
                "type": "array",
                "items": {"$ref": "common.schema.json#/$defs/operand"},
                "description": "Equivalent source expressions/macros accepted by canonical matching."
              },
              "file": {"type": "string"},
              "function": {"type": "string"},
              "line": {"type": "integer"},
              "description": {"type": "string"}
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
