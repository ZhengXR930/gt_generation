{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gt_contract/common.schema.json",
  "title": "Shared GT Contract Definitions",
  "$defs": {
    "location": {
      "type": "object",
      "required": ["file", "function", "line"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1},
        "line": {"type": "integer"},
        "line_end": {"type": "integer"},
        "code": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": true
    },
    "operand": {
      "type": "string",
      "minLength": 1,
      "description": "A source-level expression or literal in the same lexical space used by fine_trace.var and semantic claims, for example len, *crl, capacity, NULL, or sizeof(buf)."
    },
    "operands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operand"},
      "description": "All source expressions/literals needed to compare this point or edge. This is not a prose explanation."
    },
    "relation": {
      "type": "object",
      "required": ["op", "left", "right"],
      "properties": {
        "op": {"enum": ["eq", "ne", "lt", "le", "gt", "ge", "contains", "same_object", "free_before_use", "use_before_init", "use_after_return", "use_after_scope", "double_free"]},
        "left": {"$ref": "#/$defs/operand"},
        "right": {"$ref": "#/$defs/operand"},
        "description": {"type": "string"}
      },
      "additionalProperties": false,
      "description": "The deterministic comparison target. Use left/right explicitly instead of relying on operands array order."
    },
    "trace_anchor": {
      "allOf": [
        {"$ref": "#/$defs/location"},
        {
          "type": "object",
          "required": ["trace_step", "operands"],
          "properties": {
            "trace_step": {
              "type": "integer",
              "description": "Must reference an existing fine_trace step. The referenced step must have the same function and a line within the configured tolerance."
            },
            "operands": {"$ref": "#/$defs/operands"},
            "relation": {"$ref": "#/$defs/relation"}
          },
          "additionalProperties": true
        }
      ]
    },
    "invariant_node": {
      "type": "object",
      "required": ["invariant_id", "role", "file", "function", "line", "operands", "relation", "verified"],
      "properties": {
        "invariant_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["source", "root_cause", "sink", "intermediate"]},
        "type": {
          "type": "string",
          "description": "Optional legacy or human subtype. Not required and not a scoring field."
        },
        "file": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1},
        "line": {"type": "integer"},
        "line_end": {"type": "integer"},
        "operands": {"$ref": "#/$defs/operands"},
        "relation": {"$ref": "#/$defs/relation"},
        "fine_trace_step": {"type": "integer"},
        "description": {"type": "string"},
        "verified": {"const": true},
        "verified_by": {"type": "string"},
        "evidence": {}
      },
      "additionalProperties": true
    },
    "invariant_edge": {
      "type": "object",
      "required": ["invariant_id", "type", "from_node", "to_node", "operands", "relation", "verified"],
      "properties": {
        "invariant_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["data", "control", "order"]},
        "from_node": {"type": "string", "minLength": 1},
        "to_node": {"type": "string", "minLength": 1},
        "operands": {
          "$ref": "#/$defs/operands",
          "description": "Carrier expressions for the edge. This replaces legacy scalar via values."
        },
        "relation": {"$ref": "#/$defs/relation"},
        "from_file": {"type": "string"},
        "from_function": {"type": "string"},
        "from_line": {"type": "integer"},
        "to_file": {"type": "string"},
        "to_function": {"type": "string"},
        "to_line": {"type": "integer"},
        "from_step": {"type": "integer"},
        "to_step": {"type": "integer"},
        "description": {"type": "string"},
        "verified": {"const": true},
        "verified_by": {"type": "string"},
        "evidence": {}
      },
      "additionalProperties": true
    }
  }
}
