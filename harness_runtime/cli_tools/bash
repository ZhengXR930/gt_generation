#!/bin/bash
set -euo pipefail

REAL_BASH=/bin/bash

is_submit_target() {
  case "${1:-}" in
    submit.sh|./submit.sh|*/submit.sh) return 0 ;;
    *) return 1 ;;
  esac
}

if is_submit_target "${1:-}" && [[ -n "${GT_SUBMIT_SH_PATH:-}" ]]; then
  target="$1"
  if [[ "$target" != /* ]]; then
    target="$PWD/$target"
  fi
  target_real="$(readlink -f "$target" 2>/dev/null || printf %s "$target")"
  expected_real="$(readlink -f "$GT_SUBMIT_SH_PATH" 2>/dev/null || printf %s "$GT_SUBMIT_SH_PATH")"
  if [[ "$target_real" == "$expected_real" ]]; then
    actual_line="$(sha256sum "$target_real" 2>/dev/null || true)"
    actual="${actual_line%% *}"
    if [[ -n "${GT_SUBMIT_SH_SHA256:-}" && "$actual" != "$GT_SUBMIT_SH_SHA256" ]]; then
      if [[ -f "${GT_SUBMIT_SH_CANONICAL:-}" ]]; then
        cp "$GT_SUBMIT_SH_CANONICAL" "$target_real"
        chmod 755 "$target_real"
        echo "Notice: restored benchmark submit.sh contract before validation." >&2
      else
        echo "Error: benchmark submit.sh contract changed and canonical copy is missing." >&2
        exit 2
      fi
    fi
  fi
fi

exec "$REAL_BASH" "$@"
