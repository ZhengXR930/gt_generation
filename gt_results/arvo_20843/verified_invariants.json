      "verified": true,
      "verified_by": "a_bad_number_error_requires_live_token_argument",
      "fine_trace_step": 4,
      "description": "The parser frees the row buffer before reporting the conversion error. Because `p` still aliases the current token inside `line`, the subsequent `vips_error(..., p)` call uses a dangling pointer. The staged fix removes this use-after-free by moving `g_free(line)` after `vips_error(...)`."
    },
