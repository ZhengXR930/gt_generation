  "assertions": [
    {
      "id": "A-ROOT-USB-MMAPPED-GUARD-REQUIRES-FULL-HEADER",
      "invariants": [
        "I-ROOT-USB-MMAPPED-GUARD-REQUIRES-FULL-HEADER"
      ],
      "kind": "required",
      "at": "usb_mmapped_guard",
      "check": [
        "ge",
        "$usb_mmapped_guard.capture_len",
        "$usb_mmapped_guard.required_usb_header_bytes"
      ],
      "protects": "usb_data_flag_sink"
    },
    {
      "id": "A-SINK-USB-DATA-FLAG-READ-PAST-CAPTURE-LEN",
      "invariants": [
        "I-SINK-USB-DATA-FLAG-READ-PAST-CAPTURE-LEN"
      ],
      "kind": "observed",
      "at": "usb_data_flag_sink",
      "check": [
        "gt",
        "$usb_data_flag_sink.data_flag_read_end",
        "$usb_data_flag_sink.capture_len"
      ]
    },
    {
      "id": "A-PACKET-DATA-POINTER-REACHES-USB-SINK",
      "invariants": [
        "I-PACKET-DATA-POINTER-REACHES-USB-SINK"
      ],
      "kind": "transition",
      "from": "packet_data_ready",
      "at": "usb_data_flag_sink",
      "check": [
        "eq",
        "$packet_data_ready.packet_data_ptr",
        "$usb_data_flag_sink.data_ptr"
      ]
    }
  ]
}
