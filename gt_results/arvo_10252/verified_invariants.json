        "lr_job_counter[i & 1]"
      ],
      "relation": {
        "op": "le",
        "left": "lr_sync->rows * num_planes",
        "right": "lr_job_counter[i & 1]"
      },
      "verified": true,
      "verified_by": "a_enqueue_store_crosses_allocated_slots",
      "fine_trace_step": 10,
      "description": "Source-level sink. Once `lr_job_counter[i & 1]` advances past the `num_rows_lr * num_planes` allocation from `loop_restoration_alloc()`, this 4-byte store writes into the heap redzone; AddressSanitizer reports the same write at `thread_common.c:599:55`."
    },
    {
