{
  "sample_id": "arvo_10252",
  "content_hash": "sha256:7af656ea4924011b0ed9825cce130250e7b3d6ffc6772319710ff0c16bc9231f",
  "assertions": [
    {
      "id": "a_root_sized_rows_cover_active_chroma_rows",
      "invariants": [
        "r_num_rows_lr_covers_active_chroma_rows"
      ],
      "kind": "required",
      "at": "lr_row_count_complete",
      "check": [
        "ge",
        "$lr_row_count_complete.computed_rows",
        "$lr_row_count_complete.plane1_required_rows"
      ],
      "protects": "lr_job_queue_store"
    },
    {
      "id": "a_enqueue_store_crosses_allocated_slots",
      "invariants": [
        "n_enqueue_store_crosses_job_queue_capacity"
      ],
      "kind": "observed",
      "at": "lr_job_queue_store",
      "check": [
        "ge",
        "$lr_job_queue_store.queue_index",
        "$lr_job_queue_store.allocated_slots"
      ]
    },
    {
      "id": "a_sized_rows_reach_job_queue_alloc",
      "invariants": [
        "e_num_rows_lr_flows_to_job_queue_alloc",
        "n_job_queue_underallocated_from_num_rows_lr"
      ],
      "kind": "transition",
      "from": "lr_row_count_complete",
      "at": "lr_job_queue_alloc",
      "check": [
        "eq",
        "$lr_row_count_complete.computed_rows",
        "$lr_job_queue_alloc.allocated_rows"
      ]
    },
    {
      "id": "a_allocated_slots_reach_enqueue_store",
      "invariants": [
        "e_allocated_slot_count_bounds_enqueue_store"
      ],
      "kind": "transition",
      "from": "lr_job_queue_alloc",
      "at": "lr_job_queue_store",
      "check": [
        "eq",
        "$lr_job_queue_alloc.allocated_slots",
        "$lr_job_queue_store.allocated_slots"
      ]
    }
  ]
}
