  "assertions": [
    {
      "id": "a_create_failure_must_preserve_caller_decoder_list",
      "invariants": [
        "r_create_failure_must_preserve_caller_decoder_list"
      ],
      "kind": "required",
      "at": "create_failure_cleanup",
      "check": [
        "ne",
        "$create_failure_cleanup.free_argument",
        "$create_failure_cleanup.owned_ptr"
      ],
      "protects": "create_failure_cleanup"
    },
    {
      "id": "a_tracked_decoder_list_reaches_caller_cleanup_destroy",
      "invariants": [
        "e_tracked_decoder_list_reaches_caller_cleanup_destroy",
        "n_caller_cleanup_reuses_freed_decoder_list"
      ],
      "kind": "transition",
      "from": "create_failure_cleanup",
      "at": "caller_cleanup_destroy",
      "check": [
        "eq",
        "$create_failure_cleanup.owned_ptr",
        "$caller_cleanup_destroy.destroy_argument"
      ]
    },
    {
      "id": "a_caller_cleanup_argument_reaches_second_destroy_sink",
      "invariants": [
        "e_caller_cleanup_argument_reaches_second_destroy_sink",
        "n_second_destroy_iterates_freed_decoder_list_head"
      ],
      "kind": "transition",
      "from": "caller_cleanup_destroy",
      "at": "decoder_list_destroy_sink",
      "check": [
        "eq",
        "$caller_cleanup_destroy.destroy_argument",
        "$decoder_list_destroy_sink.list_argument"
      ]
    }
  ]
