        "right": "obj.getDict()"
      },
      "verified": true,
      "verified_by": "a_released_dict_reaches_objectstream_cached_free",
      "fine_trace_step": 8,
      "description": "During `ObjectStream::~ObjectStream()` cleanup, the stale cached `Object` from the compressed object stream executes `dict->decRef()` on a dictionary that was already freed during page teardown, causing the ASan heap-use-after-free write to the freed refcount field."
    },
    {
      "invariant_id": "n_standalone_field_teardown_becomes_last_recorded_owner",
