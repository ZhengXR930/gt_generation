      },
      "verified": true,
      "verified_by": "a_standalone_field_must_increment_shared_dict_refcount",
      "fine_trace_step": 5,
      "description": "The standalone-field path wraps `annot->getDict()` in `Object(...)`, creating another owning `Object` for the same dictionary without calling `copy()` or otherwise incrementing the dict refcount. The shared dictionary is now owned by more `Object` instances than its refcount records. The fix replaces this with `annot->getAnnotObj().copy()`, which increments the refcount correctly."
    },
    {
      "invariant_id": "n_objectstream_cached_dict_free_sink",
      "role": "sink",
      "file": "poppler/Object.cc",
      "function": "Object::free",
