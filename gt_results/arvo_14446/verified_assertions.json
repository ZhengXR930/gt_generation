      ],
      "kind": "required",
      "at": "starttab_ready",
      "check": [
        "ge",
        "$starttab_ready.starttab_initialized_rows",
        "$starttab_ready.numrows"
      ],
      "protects": "starttab_sanity_check"
    },
    {
      "id": "a_sink_sanity_check_reads_beyond_initialized_starttab_rows",
      "invariants": [
        "n_sink_sanity_check_reads_beyond_initialized_starttab_rows"
      ],
      "kind": "observed",
      "at": "starttab_sanity_check",
      "check": [
        "gt",
        "$starttab_sanity_check.rows_checked_total",
        "$starttab_sanity_check.starttab_initialized_rows"
      ]
    },
    {
      "id": "a_partial_starttab_initialization_persists_to_sanity_check",
      "invariants": [
        "e_partial_starttab_initialization_persists_to_sanity_check"
      ],
      "kind": "transition",
      "from": "starttab_ready",
      "at": "starttab_sanity_check",
      "check": [
        "eq",
        "$starttab_ready.starttab_initialized_rows",
        "$starttab_sanity_check.starttab_initialized_rows"
      ]
    }
  ]
