      "verified": true,
      "verified_by": "transition.lowlevel_auth_to_hmac_sink",
      "fine_trace_step": 10,
      "description": "Zeroes the HMAC field through the stale `auth` pointer. ASan reports a 20-byte heap-use-after-free WRITE 100 bytes into the freed 256-byte AUTH-chunk region."
    },
