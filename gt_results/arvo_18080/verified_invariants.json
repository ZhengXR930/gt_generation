      "verified": true,
      "fine_trace_step": 1,
      "description": "After the leading AUTH chunk has been accepted, this call dispatches the attacker-controlled ASCONF chunk from the injected SCTP packet into the address-configuration handler. Its parameters are the first project-side input that becomes vulnerability-relevant state by mutating the association's remote-address set used by the later per-destination send loop."
    },
    {
      "invariant_id": "root.auth_cleared_before_next_send",
      "role": "root_cause",
      "file": "usrsctplib/netinet/sctp_output.c",
      "function": "sctp_med_chunk_output",
      "line": 8578,
      "operands": [
        "NULL",
        "auth"
