{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_14023",
  "content_hash": "sha256:6ca97b0555a1ae1129022b0775c3d54e2b353628e5edfb7faf780ad6909ed9e4",
  "assertions": [
    {
      "id": "A-ROOT-PARSE-BYTES-WITHIN-READ",
      "invariants": [
        "I-ROOT-PARSE-BYTES-WITHIN-READ"
      ],
      "kind": "required",
      "at": "parse_extra_call",
      "check": [
        "le",
        "$parse_extra_call.parse_bytes",
        "$parse_extra_call.actual_read_bytes"
      ],
      "protects": "parse_extra_call"
    },
    {
      "id": "A-SINK-FIELDSIZE-READS-UNINITIALIZED-BYTES",
      "invariants": [
        "I-SINK-FIELDSIZE-READS-UNINITIALIZED-BYTES"
      ],
      "kind": "observed",
      "at": "fieldsize_check",
      "check": [
        "gt",
        "$fieldsize_check.fieldsize_read_bytes",
        "$fieldsize_check.fieldsize_initialized_prefix_len"
      ]
    },
    {
      "id": "A-BUFFER-BASE-FLOWS-TO-FIELDSIZE-CHECK",
      "invariants": [
        "I-BUFFER-BASE-FLOWS-TO-FIELDSIZE-CHECK"
      ],
      "kind": "transition",
      "from": "parse_extra_call",
      "at": "fieldsize_check",
      "check": [
        "eq",
        "$parse_extra_call.buffer_base",
        "$fieldsize_check.buffer_base"
      ]
    }
  ]
}
