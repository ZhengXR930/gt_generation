{
  "sample_id": "arvo_16266",
  "content_hash": "sha256:11be0764b7d6ae007491259145b7d56550895a22dc20e83c4880b2d8514e6afb",
  "assertions": [
    {
      "id": "A-ROOT-DATA-MUST-REFRESH-AFTER-READ",
      "invariants": [
        "I-ROOT-DATA-MUST-REFRESH-AFTER-READ"
      ],
      "kind": "required",
      "at": "post_body_read",
      "check": [
        "eq",
        "$post_body_read.data_ptr",
        "$post_body_read.ctx_data_ptr"
      ],
      "protects": "exif_memcpy"
    },
    {
      "id": "A-SINK-EXIF-MEMCPY-USES-STALE-DATA",
      "invariants": [
        "I-SINK-EXIF-MEMCPY-USES-STALE-DATA"
      ],
      "kind": "observed",
      "at": "exif_memcpy",
      "check": [
        "ne",
        "$exif_memcpy.source_ptr",
        "$exif_memcpy.ctx_data_ptr"
      ]
    },
    {
      "id": "A-POST-BODY-READ-DATA-REACHES-EXIF-MEMCPY",
      "invariants": [
        "I-POST-BODY-READ-DATA-REACHES-EXIF-MEMCPY"
      ],
      "kind": "transition",
      "from": "post_body_read",
      "at": "exif_memcpy",
      "check": [
        "eq",
        "$post_body_read.data_ptr",
        "$exif_memcpy.source_ptr"
      ]
    },
    {
      "id": "A-STREAM-REALLOC-MOVES-STREAM-BUFFER",
      "invariants": [
        "I-STREAM-REALLOC-MOVES-STREAM-BUFFER"
      ],
      "kind": "observed",
      "at": "stream_realloc",
      "check": [
        "ne",
        "$stream_realloc.old_buffer_ptr",
        "$stream_realloc.new_buffer_ptr"
      ]
    },
    {
      "id": "A-STREAM-REALLOC-OLD-BUFFER-BECOMES-STALE-DATA",
      "invariants": [
        "I-STREAM-REALLOC-OLD-BUFFER-BECOMES-STALE-DATA"
      ],
      "kind": "transition",
      "from": "stream_realloc",
      "at": "post_body_read",
      "check": [
        "eq",
        "$stream_realloc.old_buffer_ptr",
        "$post_body_read.data_ptr"
      ]
    }
  ]
}
