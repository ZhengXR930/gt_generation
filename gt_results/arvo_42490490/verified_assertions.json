  "assertions": [
    {
      "id": "a_input_must_be_valid_utf8_before_casefold",
      "invariants": [
        "r_input_must_be_valid_utf8_before_casefold"
      ],
      "kind": "required",
      "at": "parse_utf8_guard",
      "check": [
        "eq",
        "$parse_utf8_guard.utf8_valid",
        1
      ],
      "protects": "casefold_call"
    },
    {
      "id": "a_parser_input_reaches_casefold_call",
      "invariants": [
        "e_parser_input_reaches_casefold_call",
        "n_casefold_receives_original_parser_input"
      ],
      "kind": "transition",
      "from": "parse_utf8_guard",
      "at": "casefold_call",
      "check": [
        "eq",
        "$parse_utf8_guard.str_argument",
        "$casefold_call.str_argument"
      ]
    },
    {
      "id": "a_casefold_input_becomes_utf8_iterator",
      "invariants": [
        "e_casefold_input_becomes_utf8_iterator",
        "n_utf8_iterator_aliases_casefold_input"
      ],
      "kind": "transition",
      "from": "casefold_call",
      "at": "next_char_advance",
      "check": [
        "eq",
        "$casefold_call.str_argument",
        "$next_char_advance.p_before"
      ]
    },
    {
      "id": "a_utf8_next_char_advances_iterator",
      "invariants": [
        "n_utf8_next_char_advances_iterator"
      ],
      "kind": "observed",
      "at": "next_char_advance",
      "check": [
        "ne",
        "$next_char_advance.p_before",
        "$next_char_advance.p_after"
      ]
    },
    {
      "id": "a_advanced_iterator_reaches_casefold_loop_deref",
      "invariants": [
        "e_advanced_iterator_reaches_casefold_loop_deref",
        "n_casefold_loop_deref_sink"
      ],
      "kind": "transition",
      "from": "next_char_advance",
      "at": "casefold_loop_deref",
      "check": [
        "eq",
        "$next_char_advance.p_after",
        "$casefold_loop_deref.p_argument"
      ]
    }
  ]
}
