{
  "sample_id": "arvo_11869",
  "content_hash": "sha256:d168f79086bf81fc39c4f66b3d47eca85111ed5c232ca09e80a9a4c77ab71fb7",
  "assertions": [
    {
      "id": "a_root_lossless_width_store",
      "invariants": [
        "r_width_store_preserves_dst_n_bits"
      ],
      "kind": "required",
      "at": "learn_spec_store",
      "check": [
        "eq",
        "$learn_spec_store.stored_n_bits",
        "$learn_spec_store.dst_n_bits"
      ],
      "protects": "spec_next_stride"
    },
    {
      "id": "a_stored_n_bits_reaches_iterator_stride",
      "invariants": [
        "e_stored_n_bits_reaches_iterator_stride",
        "N_EVENT_spec_next_stride"
      ],
      "kind": "transition",
      "from": "learn_spec_store",
      "at": "spec_next_stride",
      "check": [
        "eq",
        "$learn_spec_store.stored_n_bits",
        "$spec_next_stride.used_n_bits"
      ]
    },
    {
      "id": "a_payload_stride_exceeds_iterator_stride",
      "invariants": [
        "e_payload_stride_exceeds_iterator_stride",
        "N_EVENT_learn_spec_payload"
      ],
      "kind": "transition",
      "from": "learn_spec_payload",
      "at": "spec_next_stride",
      "check": [
        "gt",
        "$learn_spec_payload.payload_stride_bytes",
        "$spec_next_stride.iter_stride_bytes"
      ]
    },
    {
      "id": "a_iterator_next_ptr_reaches_field_check",
      "invariants": [
        "e_iterator_next_ptr_reaches_field_check",
        "N_EVENT_learn_check_field"
      ],
      "kind": "transition",
      "from": "spec_next_stride",
      "at": "learn_check_field",
      "check": [
        "eq",
        "$spec_next_stride.next_spec_ptr",
        "$learn_check_field.spec_ptr"
      ]
    },
    {
      "id": "a_forged_src_field_reaches_sink",
      "invariants": [
        "e_forged_src_field_reaches_sink"
      ],
      "kind": "transition",
      "from": "learn_check_field",
      "at": "mf_check_sink",
      "check": [
        "eq",
        "$learn_check_field.src_field_ptr",
        "$mf_check_sink.sf_field_ptr"
      ]
    },
    {
      "id": "a_sink_reaches_field_dereference",
      "invariants": [
        "n_mf_check_reaches_field_dereference"
      ],
      "kind": "observed",
      "at": "mf_check_sink",
      "check": [
        "ne",
        "$mf_check_sink.sf_field_ptr",
        "$mf_check_sink.null_literal"
      ]
    }
  ]
}
