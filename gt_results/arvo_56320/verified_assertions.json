{
  "sample_id": "arvo_56320",
  "content_hash": "sha256:b8254c332771cf8f1c3155ea863d833a59e29085f82c7789f319588ac3f47b3e",
  "assertions": [
    {
      "id": "a_material_count_must_fit_existing_vector",
      "invariants": [
        "r_material_count_must_fit_existing_vector"
      ],
      "kind": "required",
      "at": "material_count_guard",
      "check": [
        "ge",
        "$material_count_guard.max_material_count_without_overflow",
        "$material_count_guard.material_count"
      ],
      "protects": "material_resize"
    },
    {
      "id": "a_guard_violation_reaches_wrapped_resize",
      "invariants": [
        "e_guard_violation_reaches_wrapped_resize",
        "n_wrapped_resize_shrinks_material_vector"
      ],
      "kind": "transition",
      "from": "material_count_guard",
      "at": "material_resize",
      "check": [
        "lt",
        "$material_resize.materials_size_after",
        "$material_count_guard.old_material_count"
      ]
    },
    {
      "id": "a_wrapped_resize_leaves_material_slot_oob",
      "invariants": [
        "e_wrapped_resize_leaves_later_material_slot_oob",
        "n_material_slot_oob"
      ],
      "kind": "transition",
      "from": "material_resize",
      "at": "material_binding",
      "check": [
        "lt",
        "$material_resize.materials_size_after",
        "$material_binding.bound_material_index"
      ]
    },
    {
      "id": "a_invalid_material_alias_reaches_submaterials_resize",
      "invariants": [
        "e_invalid_material_alias_reaches_submaterials_resize",
        "n_submaterials_resize_sink"
      ],
      "kind": "transition",
      "from": "material_binding",
      "at": "submaterials_resize",
      "check": [
        "eq",
        "$material_binding.bound_material_ptr",
        "$submaterials_resize.material_this"
      ]
    }
  ]
}
