{
  "sample_id": "arvo_35902",
  "content_hash": "sha256:b84422f364bf84f060a6d1a4ca192ba2d6328ea54c1641a84096da48f61e98ce",
  "assertions": [
    {
      "id": "REQ-root-cause-digit-must-not-be-invalid",
      "invariants": [
        "I-ROOT-OLDDIGIT-MUST-BE-VALID"
      ],
      "kind": "required",
      "at": "root_cause_digit_guard",
      "check": [
        "ne",
        "$root_cause_digit_guard.old_digit",
        "$root_cause_digit_guard.invalid_digit"
      ],
      "protects": "root_cause_digit_lookup_sink"
    },
    {
      "id": "OBS-sink-lookup-uses-invalid-digit",
      "invariants": [
        "I-SINK-LOOKUP-USES-INVALID-DIGIT"
      ],
      "kind": "observed",
      "at": "root_cause_digit_lookup_sink",
      "check": [
        "eq",
        "$root_cause_digit_lookup_sink.row_digit",
        "$root_cause_digit_lookup_sink.invalid_digit"
      ]
    },
    {
      "id": "TRANS-olddigit-carries-to-lookup-row",
      "invariants": [
        "I-EDGE-OLDDIGIT-CARRIES-TO-LOOKUP"
      ],
      "kind": "transition",
      "from": "root_cause_digit_guard",
      "at": "root_cause_digit_lookup_sink",
      "check": [
        "eq",
        "$root_cause_digit_guard.old_digit",
        "$root_cause_digit_lookup_sink.row_digit"
      ]
    }
  ]
}
