{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_31541",
  "content_hash": "sha256:3f58215911b90c15f97bc3567468e8e98cb819cdc60d4eda948a6808d8efa024",
  "assertions": [
    {
      "id": "a_frame_rewrite_must_wait_for_stackcheck",
      "invariants": [
        "r_frame_code_base_must_stay_caller_until_stackcheck"
      ],
      "kind": "required",
      "at": "tailcall_stack_guard",
      "check": [
        "ne",
        "$tailcall_stack_guard.frame_code_base",
        "$tailcall_stack_guard.callee_code_base"
      ],
      "protects": "currentpc_state"
    },
    {
      "id": "a_callee_code_base_reaches_currentpc",
      "invariants": [
        "e_callee_code_base_reaches_currentpc",
        "n_currentpc_uses_callee_code_base"
      ],
      "kind": "transition",
      "from": "tailcall_stack_guard",
      "at": "currentpc_state",
      "check": [
        "eq",
        "$tailcall_stack_guard.callee_code_base",
        "$currentpc_state.frame_code_base"
      ]
    },
    {
      "id": "a_savedpc_reaches_currentpc",
      "invariants": [
        "e_savedpc_reaches_currentpc",
        "n_currentpc_uses_caller_savedpc"
      ],
      "kind": "transition",
      "from": "tailcall_stack_guard",
      "at": "currentpc_state",
      "check": [
        "eq",
        "$tailcall_stack_guard.savedpc_ptr",
        "$currentpc_state.savedpc_ptr"
      ]
    },
    {
      "id": "a_currentpc_index_reaches_lineinfo_walk",
      "invariants": [
        "e_currentpc_index_reaches_lineinfo_walk",
        "n_lineinfo_walk_uses_currentpc_index"
      ],
      "kind": "transition",
      "from": "currentpc_state",
      "at": "lineinfo_walk",
      "check": [
        "eq",
        "$currentpc_state.pc_index",
        "$lineinfo_walk.pc_index"
      ]
    }
  ]
}
