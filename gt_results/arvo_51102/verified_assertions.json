{
  "sample_id": "arvo_51102",
  "content_hash": "sha256:33906875677570072e541aaa3e9522ba9a945868913d2cb74ed40c0232650847",
  "assertions": [
    {
      "id": "A-ROOT-CKEYL-STAYS-WITHIN-CONVERTED-KEY-VECTOR",
      "invariants": [
        "I-ROOT-CKEYL-STAYS-WITHIN-CONVERTED-KEY-VECTOR"
      ],
      "kind": "required",
      "at": "ckey_root_state",
      "check": [
        "le",
        "$ckey_root_state.ckeyl_after",
        "$ckey_root_state.ckey_utf_size_after"
      ],
      "protects": "badcharkey_utf_scan"
    },
    {
      "id": "A-SINK-KEY-SCAN-BOUND-EXCEEDS-CONVERTED-KEY-VECTOR",
      "invariants": [
        "I-SINK-KEY-SCAN-BOUND-EXCEEDS-CONVERTED-KEY-VECTOR"
      ],
      "kind": "observed",
      "at": "badcharkey_utf_scan",
      "check": [
        "gt",
        "$badcharkey_utf_scan.ckeyl_bound",
        "$badcharkey_utf_scan.ckey_utf_size"
      ]
    },
    {
      "id": "A-CKEYL-BOUND-PROPAGATES-TO-KEY-SCAN",
      "invariants": [
        "I-CKEYL-BOUND-PROPAGATES-TO-KEY-SCAN"
      ],
      "kind": "transition",
      "from": "ckey_root_state",
      "at": "badcharkey_utf_scan",
      "check": [
        "eq",
        "$ckey_root_state.ckeyl_after",
        "$badcharkey_utf_scan.ckeyl_bound"
      ]
    },
    {
      "id": "A-CONVERTED-KEY-VECTOR-STORAGE-PROPAGATES-TO-SCAN",
      "invariants": [
        "I-CONVERTED-KEY-VECTOR-STORAGE-PROPAGATES-TO-SCAN"
      ],
      "kind": "transition",
      "from": "ckey_root_state",
      "at": "badcharkey_utf_scan",
      "check": [
        "eq",
        "$ckey_root_state.ckey_utf_storage",
        "$badcharkey_utf_scan.ckey_utf_storage"
      ]
    }
  ]
}
