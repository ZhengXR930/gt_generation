        "$weight_index_read.remap_size"
      ]
    },
    {
      "id": "TR_missing_guard_reaches_sink",
      "invariants": [
        "E_missing_bounds_guard_to_sink"
      ],
      "kind": "transition",
      "from": "bone_weight_iter",
      "at": "weight_index_read",
      "check": [
