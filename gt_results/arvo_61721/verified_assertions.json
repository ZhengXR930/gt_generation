{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_61721",
  "content_hash": "sha256:b5c6e6caa222db2f8f69de968d4c3047ad3cfd8bb9f14b8b1dcd111e00b50124",
  "assertions": [
    {
      "id": "A-ROOT-FUNC-VERSION-INITIALIZED-BEFORE-SETTER",
      "invariants": [
        "I-ROOT-FUNC-VERSION-INITIALIZED-BEFORE-SETTER"
      ],
      "kind": "required",
      "at": "constructor_version_state",
      "check": [
        "ge",
        "$constructor_version_state.func_version_initialized_prefix_len",
        "$constructor_version_state.func_version_read_bytes"
      ]
    },
    {
      "id": "A-SINK-SETTER-READ-USES-UNINITIALIZED-FUNC-VERSION",
      "invariants": [
        "I-SINK-SETTER-READ-USES-UNINITIALIZED-FUNC-VERSION"
      ],
      "kind": "observed",
      "at": "setter_invalidation_read",
      "check": [
        "lt",
        "$setter_invalidation_read.func_version_initialized_prefix_len",
        "$setter_invalidation_read.func_version_read_bytes"
      ]
    },
    {
      "id": "A-CONSTRUCTOR-FUNC-OBJECT-REACHES-SETTER-READ",
      "invariants": [
        "I-CONSTRUCTOR-FUNC-OBJECT-REACHES-SETTER-READ"
      ],
      "kind": "transition",
      "from": "constructor_version_state",
      "at": "setter_invalidation_read",
      "check": [
        "eq",
        "$constructor_version_state.func_obj_ptr",
        "$setter_invalidation_read.func_obj_ptr"
      ]
    }
  ]
}
