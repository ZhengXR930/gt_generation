      "relation": {
        "op": "le",
        "left": "-3",
        "right": "info->n_missing_values"
      },
      "verified": true,
      "verified_by": "a_root_negative_bound",
      "fine_trace_step": 7,
      "description": "The vulnerable code checks only an upper bound after applying abs(). It has no pre-abs lower-bound predicate to reject the singular INT32_MIN value, for which abs is not representable as int and remains negative on the executed build. The patch establishes the missing obligation before abs with `info->n_missing_values > 3 || info->n_missing_values < -3`."
    },
