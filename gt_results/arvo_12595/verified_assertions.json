{
  "sample_id": "arvo_12595",
  "content_hash": "sha256:cdc4b46821b6af4175ed2b0aee398f694b4e9d74bba7fd0d5c4d9c675299fd98",
  "assertions": [
    {
      "id": "a_root_negative_bound",
      "invariants": [
        "r_missing_negative_bound_on_n_missing_values",
        "n_bounds_check_admits_negative_count"
      ],
      "kind": "required",
      "at": "missing_values_entry",
      "check": [
        "ge",
        "$n_missing_values_before_abs",
        -3
      ],
      "protects": "missing_values_read"
    },
    {
      "id": "a_corrupted_label_reaches_free",
      "invariants": [
        "e_corrupted_label_reaches_free",
        "e_corrupted_label_reaches_free_edge",
        "n_sink_frees_corrupted_label",
        "N_EVENT_missing_values_read_result"
      ],
      "kind": "transition",
      "from": "missing_values_read_result",
      "at": "sink_free_label",
      "check": [
        "eq",
        "$missing_values_read_result.label_after",
        "$sink_free_label.free_argument"
      ]
    },
    {
      "id": "a_overflowing_read_mutates_label",
      "invariants": [
        "e_overflowing_read_mutates_label",
        "n_label_corrupted_to_non_heap_value",
        "N_EVENT_missing_values_read"
      ],
      "kind": "transition",
      "from": "missing_values_read",
      "at": "missing_values_read_result",
      "check": [
        "ne",
        "$missing_values_read.label_before",
        "$missing_values_read_result.label_after"
      ]
    },
    {
      "id": "a_copy_overflows_destination",
      "invariants": [
        "e_copy_overflows_destination_extent",
        "n_overflow_writes_past_destination",
        "N_EVENT_read_handler"
      ],
      "kind": "transition",
      "from": "missing_values_read",
      "at": "read_handler",
      "check": [
        "gt",
        "$read_handler.bytes_copied",
        "$missing_values_read.missing_values_extent"
      ]
    },
    {
      "id": "a_request_propagates_to_read_handler",
      "invariants": [
        "e_request_propagates_to_read_handler"
      ],
      "kind": "transition",
      "from": "missing_values_read",
      "at": "read_handler",
      "check": [
        "eq",
        "$missing_values_read.nbytes_requested",
        "$read_handler.nbytes"
      ]
    },
    {
      "id": "a_admitted_count_sizes_the_read",
      "invariants": [
        "e_admitted_count_sizes_the_read"
      ],
      "kind": "transition",
      "from": "abs_normalization",
      "at": "missing_values_read",
      "check": [
        "eq",
        "$abs_normalization.n_missing_values_after_abs",
        "$missing_values_read.n_missing_values_at_read"
      ]
    },
    {
      "id": "a_abs_does_not_normalize",
      "invariants": [
        "e_abs_does_not_change_out_of_range_count",
        "n_abs_leaves_count_negative",
        "N_EVENT_missing_values_entry"
      ],
      "kind": "transition",
      "from": "missing_values_entry",
      "at": "abs_normalization",
      "check": [
        "eq",
        "$missing_values_entry.n_missing_values_before_abs",
        "$abs_normalization.n_missing_values_after_abs"
      ]
    },
    {
      "id": "a_count_propagates_to_varinfo",
      "invariants": [
        "e_count_propagates_from_record_to_varinfo",
        "n_count_materialized_without_validation",
        "N_EVENT_count_propagated_to_heap"
      ],
      "kind": "transition",
      "from": "record_read",
      "at": "count_propagated_to_heap",
      "check": [
        "eq",
        "$record_read.variable_n_missing_values",
        "$count_propagated_to_heap.info_n_missing_values"
      ]
    },
    {
      "id": "a_short_read_routes_to_error_path",
      "invariants": [
        "e_short_read_routes_to_error_path",
        "n_short_read_becomes_read_error",
        "N_EVENT_error_path_free"
      ],
      "kind": "transition",
      "from": "missing_values_error",
      "at": "error_path_free",
      "check": [
        "eq",
        "$missing_values_error.retval_after_short_read",
        "$error_path_free.retval_at_cleanup"
      ]
    },
    {
      "id": "a_request_exceeds_destination_extent",
      "invariants": [
        "n_request_exceeds_destination_extent"
      ],
      "kind": "observed",
      "at": "missing_values_read",
      "check": [
        "gt",
        "$missing_values_read.nbytes_requested",
        "$missing_values_read.missing_values_extent"
      ]
    },
    {
      "id": "a_request_exceeds_available_source_bytes",
      "invariants": [
        "n_request_exceeds_available_source_bytes"
      ],
      "kind": "observed",
      "at": "read_handler",
      "check": [
        "gt",
        "$read_handler.nbytes",
        "$read_handler.bytes_left"
      ]
    },
    {
      "id": "a_copy_length_bounded_by_source_only",
      "invariants": [
        "n_copy_length_bounded_by_source_only"
      ],
      "kind": "observed",
      "at": "read_handler",
      "check": [
        "eq",
        "$read_handler.bytes_copied",
        "$read_handler.bytes_left"
      ]
    },
    {
      "id": "a_short_read_detected",
      "invariants": [
        "n_short_read_detected"
      ],
      "kind": "observed",
      "at": "missing_values_read_result",
      "check": [
        "lt",
        "$missing_values_read_result.bytes_copied",
        "$missing_values_read_result.nbytes_requested"
      ]
    }
  ]
}
