{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42496071",
  "content_hash": "sha256:a33c481490356efa988c4fb1b5070fafec4f9d32b001543e968deef00eefebe1",
  "assertions": [
    {
      "id": "a_row_sync_row_count_change_must_clear_stale_row_sync",
      "invariants": [
        "r_row_sync_row_count_change_must_clear_stale_row_sync"
      ],
      "kind": "required",
      "at": "row_sync_row_change_handled",
      "check": [
        "eq",
        "$row_sync_row_change_handled.row_sync_ptr_after_guard",
        "$row_sync_row_change_handled.null_literal"
      ],
      "protects": "row_sync_bound_store"
    },
    {
      "id": "a_requested_row_count_reaches_allocated_mi_rows_store",
      "invariants": [
        "e_requested_row_count_reaches_allocated_mi_rows_store"
      ],
      "kind": "transition",
      "from": "row_sync_row_change_handled",
      "at": "row_sync_bound_store",
      "check": [
        "eq",
        "$row_sync_row_change_handled.num_mi_rows",
        "$row_sync_bound_store.allocated_mi_rows_after"
      ]
    },
    {
      "id": "a_overwritten_allocated_mi_rows_reaches_destroy_loop_bound",
      "invariants": [
        "e_overwritten_allocated_mi_rows_reaches_destroy_loop_bound"
      ],
      "kind": "transition",
      "from": "row_sync_bound_store",
      "at": "row_sync_destroy_sink",
      "check": [
        "eq",
        "$row_sync_bound_store.allocated_mi_rows_after",
        "$row_sync_destroy_sink.destroy_rows"
      ]
    },
    {
      "id": "a_earlier_row_sync_pointer_reaches_destroy_loop",
      "invariants": [
        "e_earlier_row_sync_pointer_reaches_destroy_loop"
      ],
      "kind": "transition",
      "from": "row_sync_alloc",
      "at": "row_sync_destroy_sink",
      "check": [
        "eq",
        "$row_sync_alloc.row_sync_ptr",
        "$row_sync_destroy_sink.row_sync_ptr"
      ]
    },
    {
      "id": "a_destroy_loop_bound_exceeds_row_sync_allocation",
      "invariants": [
        "e_earlier_row_sync_allocation_rows_reach_destroy_bound",
        "n_destroy_loop_bound_exceeds_row_sync_allocation"
      ],
      "kind": "transition",
      "from": "row_sync_alloc",
      "at": "row_sync_destroy_sink",
      "check": [
        "lt",
        "$row_sync_alloc.alloc_rows",
        "$row_sync_destroy_sink.destroy_rows"
      ]
    }
  ]
}
