  "assertions": [
    {
      "id": "A-ROOT-IS-FULL-PATH-REQUIRES-NONEMPTY-PATH",
      "invariants": [
        "I-ROOT-IS-FULL-PATH-REQUIRES-NONEMPTY-PATH"
      ],
      "kind": "required",
      "at": "full_path_guard",
      "check": [
        "ne",
        "$full_path_guard.path_first_char",
        "$full_path_guard.zero_literal"
      ],
      "protects": "full_path_read"
    },
    {
      "id": "A-LINKSTRING-REMAINS-EMPTY-AFTER-APPEND",
      "invariants": [
        "I-LINKSTRING-REMAINS-EMPTY-AFTER-APPEND"
      ],
      "kind": "observed",
      "at": "linkstring_ready",
      "check": [
        "eq",
        "$linkstring_ready.linkstring_first_char",
        "$linkstring_ready.zero_literal"
      ]
    },
    {
      "id": "A-LINKSTRING-BUFFER-FLOWS-TO-PATHJOIN-INPUT",
      "invariants": [
        "I-LINKSTRING-BUFFER-FLOWS-TO-PATHJOIN-INPUT"
      ],
      "kind": "transition",
      "from": "linkstring_ready",
      "at": "pathjoin_input",
      "check": [
        "eq",
        "$linkstring_ready.linkstring_ptr",
        "$pathjoin_input.inputs_ptr"
      ]
    },
    {
      "id": "A-PATHJOIN-INPUT-FLOWS-TO-SECOND-BYTE-READ",
      "invariants": [
        "I-PATHJOIN-INPUT-FLOWS-TO-SECOND-BYTE-READ"
      ],
      "kind": "transition",
      "from": "pathjoin_input",
      "at": "full_path_read",
      "check": [
        "eq",
        "$pathjoin_input.inputs_ptr",
        "$full_path_read.path_ptr"
      ]
    },
    {
      "id": "A-SINK-EMPTY-PATH-REACHES-SECOND-BYTE-READ",
      "invariants": [
        "I-SINK-EMPTY-PATH-REACHES-SECOND-BYTE-READ"
      ],
      "kind": "observed",
      "at": "full_path_read",
      "check": [
        "eq",
        "$full_path_read.path_first_char",
        "$full_path_read.zero_literal"
      ]
    }
  ]
}
