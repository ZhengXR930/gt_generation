      ],
      "relation": {
        "op": "eq",
        "left": "&algo",
        "right": "o.string"
      },
      "verified": true,
      "verified_by": "a_root_rollback_realigns_to_algo_slot",
      "fine_trace_step": 7,
      "description": "Rollback of previously unpacked scalar outputs consumes va_arg(ap_copy, ...) only when buffer->secure is true. On the normal non-secure packet buffer this skips the leading 'b' argument &has_sign, leaves ap_copy misaligned, and causes the following 'S' cleanup to reinterpret &has_sign as ssh_string *. The fix moves the va_arg(ap_copy, ...) out of the if(buffer->secure) block for b/w/d/q so rollback always advances the copied va_list."
    },
    {
      "invariant_id": "n_safe_free_uses_misaligned_string_slot",
      "role": "sink",
      "file": "src/buffer.c",
      "function": "ssh_buffer_unpack_va",
      "line": 1274,
      "operands": [
        "o.string"
      ],
      "relation": {
        "op": "eq",
        "left": "o.string",
        "right": "o.string"
      },
      "verified": true,
      "verified_by": "a_misaligned_string_slot_reaches_safe_free",
      "fine_trace_step": 9,
      "description": "AddressSanitizer crash site. SAFE_FREE first evaluates *o.string as a pointer-sized value. Because rollback mis-set o.string to &has_sign, this dereference reads 8 bytes starting at the 1-byte has_sign stack object in ssh_packet_userauth_request, causing the observed stack-buffer-overflow READ of size 8."
    },
    {
      "invariant_id": "n_rollback_string_cleanup_targets_has_sign_slot",
      "verified": true,
