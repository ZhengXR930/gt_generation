      "line": 1270,
      "fine_trace_step": 8,
      "state": "The first rollback `S` cleanup recovers `o.string = &has_sign` instead of `&algo`, retyping the caller's one-byte flag slot as `ssh_string *`.",
      "operands": [
        "&has_sign",
        "o.string"
      ],
      "relation": {
        "op": "eq",
        "left": "&has_sign",
        "right": "o.string"
      },
      "verified_by": "a_first_scalar_slot_retyped_as_string_cleanup_target"
    },
    {
