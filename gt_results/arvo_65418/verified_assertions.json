{
  "sample_id": "arvo_65418",
  "content_hash": "sha256:9c43489eeb1381e391bf550e76703dd0e1d47de112db881891f780ac3eec2261",
  "assertions": [
    {
      "id": "a_fgc_interval_pair_fits_bit_limit",
      "invariants": [
        "r_fgc_interval_pair_fits_bit_limit"
      ],
      "kind": "required",
      "at": "fgc_pair_guard",
      "check": [
        "lt",
        "$fgc_pair_guard.pair_end_offset",
        "$fgc_pair_guard.bit_limit"
      ],
      "protects": "get_bits_sink"
    },
    {
      "id": "a_get_bits_starts_at_or_past_bit_limit",
      "invariants": [
        "n_get_bits_starts_at_or_past_bit_limit"
      ],
      "kind": "observed",
      "at": "get_bits_sink",
      "check": [
        "ge",
        "$get_bits_sink.bitstream_offset",
        "$get_bits_sink.bit_limit"
      ]
    },
    {
      "id": "a_pair_guard_offset_advances_to_upper_bound_read",
      "invariants": [
        "e_pair_guard_offset_advances_to_upper_bound_read",
        "n_upper_bound_read_uses_projected_pair_offset"
      ],
      "kind": "transition",
      "from": "fgc_pair_guard",
      "at": "fgc_upper_bound_read",
      "check": [
        "eq",
        "$fgc_pair_guard.expected_upper_offset",
        "$fgc_upper_bound_read.upper_read_offset"
      ]
    },
    {
      "id": "a_upper_bound_read_offset_reaches_get_bits",
      "invariants": [
        "e_upper_bound_read_offset_reaches_get_bits"
      ],
      "kind": "transition",
      "from": "fgc_upper_bound_read",
      "at": "get_bits_sink",
      "check": [
        "eq",
        "$fgc_upper_bound_read.upper_read_offset",
        "$get_bits_sink.bitstream_offset"
      ]
    }
  ]
}
