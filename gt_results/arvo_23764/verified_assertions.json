{
  "sample_id": "arvo_23764",
  "content_hash": "sha256:335753476e4822f1336381ba3c04cf3a02798eb82828d812d3934832c8bac9bd",
  "assertions": [
    {
      "id": "A-ROOT-REMAINING-BYTES-BEFORE-CODEFENCE-READ",
      "invariants": [
        "I-ROOT-REMAINING-BYTES-BEFORE-CODEFENCE-READ"
      ],
      "kind": "required",
      "at": "codefence_pre_read_guard",
      "check": [
        "lt",
        "$codefence_pre_read_guard.fence_skip_index_plus_two",
        "$codefence_pre_read_guard.fence_candidate_size"
      ],
      "protects": "codefence_read_sink"
    },
    {
      "id": "A-SINK-CODEFENCE-READ-INDEX-OUT-OF-BOUNDS",
      "invariants": [
        "I-SINK-CODEFENCE-READ-INDEX-OUT-OF-BOUNDS"
      ],
      "kind": "observed",
      "at": "codefence_read_sink",
      "check": [
        "ge",
        "$codefence_read_sink.fence_skip_index",
        "$codefence_read_sink.fence_candidate_size"
      ]
    },
    {
      "id": "A-ROOT-SKIP-INDEX-TO-SINK-READ",
      "invariants": [
        "I-ROOT-SKIP-INDEX-TO-SINK-READ"
      ],
      "kind": "transition",
      "from": "codefence_pre_read_guard",
      "at": "codefence_read_sink",
      "check": [
        "eq",
        "$codefence_pre_read_guard.fence_skip_index",
        "$codefence_read_sink.fence_skip_index"
      ]
    },
    {
      "id": "A-CALL-CANDIDATE-SIZE-TO-ROOT-SIZE",
      "invariants": [
        "I-CALL-CANDIDATE-SIZE-TO-ROOT-SIZE",
        "N_EVENT_fence_candidate_call"
      ],
      "kind": "transition",
      "from": "fence_candidate_call",
      "at": "codefence_pre_read_guard",
      "check": [
        "eq",
        "$fence_candidate_call.fence_candidate_size",
        "$codefence_pre_read_guard.fence_candidate_size"
      ]
    }
  ]
}
