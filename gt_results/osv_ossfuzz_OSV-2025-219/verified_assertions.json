  "assertions": [
    {
      "id": "A-ROOT-CURRENT-TILE-PART-IN-BOUNDS",
      "invariants": [
        "I-ROOT-CURRENT-TILE-PART-IN-BOUNDS"
      ],
      "kind": "required",
      "at": "sod_guard",
      "check": [
        "lt",
        "$sod_guard.l_current_tile_part",
        "$sod_guard.nb_tps"
      ],
      "protects": "sod_store"
    },
    {
      "id": "A-SOD-GUARD-INDEX-REACHES-SOD-STORE",
      "invariants": [
        "I-SOD-GUARD-INDEX-REACHES-SOD-STORE",
        "I-SINK-SOD-STORE-USES-GUARD-INDEX"
      ],
      "kind": "transition",
      "from": "sod_guard",
      "at": "sod_store",
      "check": [
        "eq",
        "$sod_guard.l_current_tile_part",
        "$sod_store.store_index"
      ]
    },
    {
      "id": "A-TLM-NB-TPS-REACHES-SOD-GUARD",
      "invariants": [
        "I-TLM-NB-TPS-REACHES-SOD-GUARD",
        "N_EVENT_tp_index_ready"
      ],
      "kind": "transition",
      "from": "tp_index_ready",
      "at": "sod_guard",
      "check": [
        "eq",
        "$tp_index_ready.nb_tps",
        "$sod_guard.nb_tps"
      ]
    },
    {
      "id": "A-CURRENT-TPSNO-REACHES-SOD-GUARD",
      "invariants": [
        "I-CURRENT-TPSNO-REACHES-SOD-GUARD",
        "N_EVENT_sot_index_update"
      ],
      "kind": "transition",
      "from": "sot_index_update",
      "at": "sod_guard",
      "check": [
        "eq",
        "$sot_index_update.current_tpsno",
        "$sod_guard.l_current_tile_part"
      ]
    }
  ]
}
