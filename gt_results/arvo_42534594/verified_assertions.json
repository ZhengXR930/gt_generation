{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42534594",
  "content_hash": "sha256:55e1dd4abb0db577277740fb52a22b3c41ff58dc643809ab7af5f625b1409136",
  "assertions": [
    {
      "id": "A-ROOT-HASH-TUPLE-ARITY-IS-2",
      "invariants": [
        "I-ROOT-HASH-TUPLE-ARITY-IS-2"
      ],
      "kind": "required",
      "at": "hash_tuple_guard",
      "check": [
        "eq",
        "$hash_tuple_guard.item_array_size",
        2
      ],
      "protects": "hash_value_read"
    },
    {
      "id": "A-SINK-HASH-VALUE-READ-INDEX-IS-OUT-OF-RANGE",
      "invariants": [
        "I-SINK-HASH-VALUE-READ-INDEX-IS-OUT-OF-RANGE"
      ],
      "kind": "observed",
      "at": "hash_value_read",
      "check": [
        "ge",
        "$hash_value_read.requested_index",
        "$hash_value_read.item_array_size"
      ]
    },
    {
      "id": "A-HASH-ITEM-REACHES-VALUE-READ",
      "invariants": [
        "I-HASH-ITEM-REACHES-VALUE-READ"
      ],
      "kind": "transition",
      "from": "hash_tuple_guard",
      "at": "hash_value_read",
      "check": [
        "eq",
        "$hash_tuple_guard.item_ptr",
        "$hash_value_read.item_ptr"
      ]
    },
    {
      "id": "A-DIRECT-HASH-PATH-SELECTED",
      "invariants": [
        "I-DIRECT-HASH-PATH-SELECTED"
      ],
      "kind": "observed",
      "at": "hash_direct_dispatch",
      "check": [
        "eq",
        "$hash_direct_dispatch.direct_hash_selected",
        "$hash_direct_dispatch.true_literal"
      ]
    },
    {
      "id": "A-DIRECT-HASH-ARRAY-REACHES-TUPLE-GUARD",
      "invariants": [
        "I-DIRECT-HASH-ARRAY-REACHES-TUPLE-GUARD"
      ],
      "kind": "transition",
      "from": "hash_direct_dispatch",
      "at": "hash_tuple_guard",
      "check": [
        "eq",
        "$hash_direct_dispatch.hash_array_ptr",
        "$hash_tuple_guard.item_ptr"
      ]
    }
  ]
}
