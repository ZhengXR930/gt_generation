{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_18447",
  "content_hash": "sha256:e5fb3ab91bbf7ba3f8cd3491518f8ffa3b63463edc644a0fff9d701046434334",
  "assertions": [
    {
      "id": "A-ROOT-RESERVE-INBOUNDS-BACKUP-BYTE",
      "invariants": [
        "R-RESERVE-INBOUNDS-BACKUP-BYTE"
      ],
      "kind": "required",
      "at": "config_fuzz_handoff",
      "check": [
        "lt",
        "$config_fuzz_handoff.handoff_len",
        "$copy_extent.static_data_capacity"
      ],
      "protects": "backup_sink"
    },
    {
      "id": "A-NEXT-SETS-POS-TO-END-PLUS-ONE",
      "invariants": [
        "N-NEXT-SETS-POS-TO-END-PLUS-ONE"
      ],
      "kind": "observed",
      "at": "next_eof",
      "check": [
        "eq",
        "$next_eof.pos_after",
        "$next_eof.end_plus_one"
      ]
    },
    {
      "id": "A-BACKUP-DEREF-USES-LEXER-END",
      "invariants": [
        "N-BACKUP-DEREF-USES-LEXER-END"
      ],
      "kind": "observed",
      "at": "backup_sink",
      "check": [
        "eq",
        "$backup_sink.deref_ptr",
        "$backup_sink.end_ptr"
      ]
    },
    {
      "id": "A-COPIED-LEN-REACHES-FUZZ-HANDOFF",
      "invariants": [
        "E-COPIED-LEN-REACHES-FUZZ-HANDOFF"
      ],
      "kind": "transition",
      "from": "copy_extent",
      "at": "config_fuzz_handoff",
      "check": [
        "eq",
        "$copy_extent.copied_len",
        "$config_fuzz_handoff.handoff_len"
      ]
    },
    {
      "id": "A-FUZZ-HANDOFF-LEN-REACHES-LEXER-INIT",
      "invariants": [
        "E-FUZZ-HANDOFF-LEN-REACHES-LEXER-INIT"
      ],
      "kind": "transition",
      "from": "config_fuzz_handoff",
      "at": "lexer_init",
      "check": [
        "eq",
        "$config_fuzz_handoff.handoff_len",
        "$lexer_init.init_len"
      ]
    },
    {
      "id": "A-LEXER-END-REACHES-NEXT-EOF",
      "invariants": [
        "E-LEXER-END-REACHES-NEXT-EOF"
      ],
      "kind": "transition",
      "from": "lexer_init",
      "at": "next_eof",
      "check": [
        "eq",
        "$lexer_init.lexer_end",
        "$next_eof.end_ptr"
      ]
    },
    {
      "id": "A-EOF-BOUNDARY-REACHES-BACKUP-SINK",
      "invariants": [
        "E-EOF-BOUNDARY-REACHES-BACKUP-SINK"
      ],
      "kind": "transition",
      "from": "next_eof",
      "at": "backup_sink",
      "check": [
        "eq",
        "$next_eof.end_ptr",
        "$backup_sink.deref_ptr"
      ]
    }
  ]
}
