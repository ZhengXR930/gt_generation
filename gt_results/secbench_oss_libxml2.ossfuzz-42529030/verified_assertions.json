  "assertions": [
    {
      "id": "required.error_path_clears_input_cur",
      "invariants": [
        "root.error_path_clears_input_cur"
      ],
      "kind": "required",
      "at": "root_reset_error_path",
      "check": [
        "eq",
        "$root_reset_error_path.input_cur_after",
        "$root_reset_error_path.empty_string"
      ],
      "protects": "error_context_scan"
    },
    {
      "id": "observed.post_loop_input_cur_differs_from_current_buffer_content",
      "invariants": [
        "node.post_loop_input_cur_differs_from_current_buffer_content"
      ],
      "kind": "observed",
      "at": "post_loop_reset_call",
      "check": [
        "ne",
        "$post_loop_reset_call.input_cur_before",
        "$post_loop_reset_call.buffer_content_current"
      ]
    },
    {
      "id": "transition.stale_input_cur_reaches_error_reset",
      "invariants": [
        "edge.stale_input_cur_reaches_error_reset"
      ],
      "kind": "transition",
      "from": "post_loop_reset_call",
      "at": "root_reset_error_path",
      "check": [
        "eq",
        "$post_loop_reset_call.input_cur_before",
        "$root_reset_error_path.input_cur_before"
      ]
    },
    {
      "id": "transition.error_reset_output_reaches_error_report",
      "invariants": [
        "edge.error_reset_output_reaches_error_report"
      ],
      "kind": "transition",
      "from": "root_reset_error_path",
      "at": "error_report_input",
      "check": [
        "eq",
        "$root_reset_error_path.input_cur_after",
        "$error_report_input.input_cur"
      ]
    },
    {
      "id": "transition.error_report_cur_reaches_context_scan",
      "invariants": [
        "edge.error_report_cur_reaches_context_scan",
        "node.error_context_scan_reads_reported_cur"
      ],
      "kind": "transition",
      "from": "error_report_input",
      "at": "error_context_scan",
      "check": [
        "eq",
        "$error_report_input.input_cur",
        "$error_context_scan.cur"
      ]
    }
  ]
}
