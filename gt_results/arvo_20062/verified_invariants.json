        "right": "p->data"
      },
      "verified": true,
      "verified_by": "a_variant_data_reaches_array_delete",
      "fine_trace_step": 12,
      "description": "AddressSanitizer sink. `UA_decodeJson()` failure cleanup reaches `Variant_clear()` on a partially built Variant whose `p->data` still points to the 2-byte buffer already freed at `Variant_decodeJsonUnwrapExtensionObject:2994`; `UA_Array_delete()` passes that stale pointer to `UA_free()` and triggers the second free."
    },
    {
