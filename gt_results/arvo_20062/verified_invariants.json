      "relation": {
        "op": "eq",
        "left": "NULL",
        "right": "dst->data"
      },
      "verified": true,
      "verified_by": "a_unwrap_error_cleanup_must_null_dst_data",
      "fine_trace_step": 9,
      "description": "Error cleanup frees the allocated unwrapped body buffer but does not clear `dst->data`. The fixing commit adds `dst->data = NULL;` immediately after this free, so the later `UA_deleteMembers()` / `Variant_clear()` cleanup on the same partially built Variant no longer frees the same pointer again."
    },
    {
      "invariant_id": "n_array_delete_reuses_variant_data_pointer",
      "role": "sink",
      "file": "src/ua_types.c",
      "function": "UA_Array_delete",
      "line": 1112,
