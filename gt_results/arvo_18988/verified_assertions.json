  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_18988",
  "content_hash": "sha256:092b8d50ba77d1b9546e23568800fc91f3e7d472d7311ff84acf7ab113cdac44",
  "assertions": [
    {
      "id": "a_size_must_leave_room_for_terminator",
      "invariants": [
        "r_size_must_be_less_than_copy_capacity_before_terminator_write"
      ],
      "kind": "required",
      "at": "post_size_clamp",
      "check": [
        "lt",
        "$post_size_clamp.size_after_clamp",
        "$post_size_clamp.copy_capacity"
      ],
      "protects": "terminator_write"
    },
    {
      "id": "a_clamped_size_reaches_terminator_index",
      "invariants": [
        "e_clamped_size_flows_to_terminator_index"
      ],
      "kind": "transition",
      "from": "post_size_clamp",
      "at": "terminator_write",
      "check": [
        "eq",
        "$post_size_clamp.size_after_clamp",
        "$terminator_write.terminator_index"
      ]
    },
    {
      "id": "a_terminator_index_hits_copy_end_boundary",
      "invariants": [
        "n_terminator_write_indexes_first_byte_past_copy"
      ],
      "kind": "observed",
      "at": "terminator_write",
      "check": [
        "eq",
        "$terminator_write.terminator_index",
        "$terminator_write.copy_capacity"
      ]
    }
  ]
}
