{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_25910",
  "content_hash": "sha256:beaa20438a7205fbae23dfd0f1b1468928fab648b94df3dc45929a9199ce5b16",
  "assertions": [
    {
      "id": "a_parse_result_must_not_report_ok_after_ftyp_parse_failure",
      "invariants": [
        "r_parse_result_must_not_report_ok_after_ftyp_parse_failure"
      ],
      "kind": "required",
      "at": "parse_result_gate",
      "check": [
        "ne",
        "$parse_result_gate.parse_result",
        "$parse_result_gate.ok_result"
      ]
    },
    {
      "id": "a_parse_result_ok_reaches_compatibility_call",
      "invariants": [
        "e_parse_result_ok_reaches_compatibility_call"
      ],
      "kind": "transition",
      "from": "parse_result_gate",
      "at": "compatibility_call_state",
      "check": [
        "eq",
        "$parse_result_gate.parse_result",
        "$compatibility_call_state.parse_result"
      ]
    },
    {
      "id": "a_duplicate_ftyp_clears_owned_ftyp_buffer_before_compatibility_check",
      "invariants": [
        "n_duplicate_ftyp_clears_owned_ftyp_buffer_before_compatibility_check"
      ],
      "kind": "observed",
      "at": "compatibility_call_state",
      "check": [
        "eq",
        "$compatibility_call_state.ftyp_data_ptr",
        "$compatibility_call_state.null_literal"
      ]
    },
    {
      "id": "a_first_ftyp_alias_reaches_compatibility_call",
      "invariants": [
        "e_first_ftyp_alias_reaches_compatibility_call"
      ],
      "kind": "transition",
      "from": "ftyp_alias_init",
      "at": "compatibility_call_state",
      "check": [
        "eq",
        "$ftyp_alias_init.compatible_brands_ptr",
        "$compatibility_call_state.compatible_brands_ptr"
      ]
    },
    {
      "id": "a_stale_compatible_brand_reaches_sink",
      "invariants": [
        "e_stale_compatible_brand_reaches_sink",
        "n_sink_memcmp_reads_stale_compatible_brand_pointer"
      ],
      "kind": "transition",
      "from": "compatibility_call_state",
      "at": "sink_use",
      "check": [
        "eq",
        "$compatibility_call_state.compatible_brands_ptr",
        "$sink_use.compatible_brand_ptr"
      ]
    }
  ]
}
