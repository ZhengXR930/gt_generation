{
  "sample_id": "arvo_33991",
  "content_hash": "sha256:dcb67a89b15fe077c7d9251527f1bceb1a8d191c41e90ddef9975530ec844912",
  "assertions": [
    {
      "id": "A-ROOT-RAW-STRING-DECREMENT-REQUIRES-POSITIVE-USED",
      "invariants": [
        "I-ROOT-RAW-STRING-DECREMENT-REQUIRES-POSITIVE-USED"
      ],
      "kind": "required",
      "at": "raw_str_guard",
      "check": [
        "gt",
        "$raw_str_guard.raw_str_used_before",
        0
      ],
      "protects": "raw_str_decrement"
    },
    {
      "id": "A-SINK-TRIM-READ-ADDRESS-FALLS-BEFORE-SRC-BASE",
      "invariants": [
        "I-SINK-TRIM-READ-ADDRESS-FALLS-BEFORE-SRC-BASE"
      ],
      "kind": "observed",
      "at": "convert_trim_sink",
      "check": [
        "lt",
        "$convert_trim_sink.read_address",
        "$convert_trim_sink.src_base_addr"
      ]
    },
    {
      "id": "A-UNDERFLOWED-USED-REACHES-CONVERT-SRC-LEN",
      "invariants": [
        "E-UNDERFLOWED-USED-REACHES-CONVERT-SRC-LEN",
        "N_EVENT_convert_call"
      ],
      "kind": "transition",
      "from": "raw_str_decrement",
      "at": "convert_call",
      "check": [
        "eq",
        "$raw_str_decrement.raw_str_used_after",
        "$convert_call.src_len_arg"
      ]
    },
    {
      "id": "A-CONVERT-SRC-LEN-REACHES-TRIM-CHECK",
      "invariants": [
        "E-CONVERT-SRC-LEN-REACHES-TRIM-CHECK"
      ],
      "kind": "transition",
      "from": "convert_call",
      "at": "convert_trim_sink",
      "check": [
        "eq",
        "$convert_call.src_len_arg",
        "$convert_trim_sink.src_len"
      ]
    }
  ]
}
