{
  "sample_id": "arvo_14467",
  "content_hash": "sha256:c10e5ec70e804b5a32509bc903a1b3a9b8e77c6ccfd85159911f0e8dee1501f4",
  "assertions": [
    {
      "id": "A1",
      "invariants": [
        "N3:missing_short_read_check"
      ],
      "kind": "required",
      "at": "raw_read",
      "check": [
        "eq",
        "$raw_read.gap_zero_filled",
        1
      ]
    },
    {
      "id": "A2",
      "invariants": [
        "N1:malloc_uninitialized"
      ],
      "kind": "observed",
      "at": "alloc",
      "check": [
        "eq",
        "$alloc.image_ptr",
        "$alloc.image_ptr_echo"
      ]
    },
    {
      "id": "A3",
      "invariants": [
        "E2_3:short_read_unchecked"
      ],
      "kind": "transition",
      "from": "before_read",
      "at": "raw_read",
      "check": [
        "lt",
        "$raw_read.dataRead",
        "$before_read.count"
      ]
    },
    {
      "id": "A4",
      "invariants": [
        "E3_4:uninit_propagation"
      ],
      "kind": "transition",
      "from": "raw_read",
      "at": "idx_load",
      "check": [
        "eq",
        "$idx_load.image_base",
        "$raw_read.image_base"
      ]
    },
    {
      "id": "A5",
      "invariants": [
        "N5:uninit_use_at_sink"
      ],
      "kind": "observed",
      "at": "sink_use",
      "check": [
        "ge",
        "$sink_use.idx_source_buf",
        "$sink_use.image_buf"
      ]
    }
  ]
}
