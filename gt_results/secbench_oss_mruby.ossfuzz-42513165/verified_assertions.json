{
  "sample_id": "secbench_oss_mruby.ossfuzz-42513165",
  "content_hash": "sha256:0f5399f08be77355a32a66e4e53a0ff8714764ff7b6b8be13782b09983b5f3c9",
  "assertions": [
    {
      "id": "required.nonnegative_len_before_digit_loop",
      "invariants": [
        "root.len_nonnegative_before_digit_loop"
      ],
      "kind": "required",
      "at": "digit_loop_guard",
      "check": [
        "ge",
        "$digit_loop_guard.len_before_read",
        0
      ],
      "protects": "first_digit_read"
    },
    {
      "id": "transition.header_len_byte_reaches_vm_len",
      "invariants": [
        "edge.header_len_byte_reaches_vm_len",
        "N_EVENT_vm_bigint_materialize"
      ],
      "kind": "transition",
      "from": "bigint_header_store",
      "at": "vm_bigint_materialize",
      "check": [
        "eq",
        "$bigint_header_store.stored_len_byte",
        "$vm_bigint_materialize.len_argument"
      ]
    },
    {
      "id": "observed.header_len_byte_differs_from_digit_count",
      "invariants": [
        "node.header_len_byte_differs_from_digit_count"
      ],
      "kind": "observed",
      "at": "bigint_header_store",
      "check": [
        "ne",
        "$bigint_header_store.stored_len_byte",
        "$bigint_header_store.digit_count"
      ]
    },
    {
      "id": "transition.vm_len_reaches_bint_new_str",
      "invariants": [
        "edge.vm_len_reaches_bint_new_str",
        "N_EVENT_bint_new_str_forward"
      ],
      "kind": "transition",
      "from": "vm_bigint_materialize",
      "at": "bint_new_str_forward",
      "check": [
        "eq",
        "$vm_bigint_materialize.len_argument",
        "$bint_new_str_forward.forwarded_len"
      ]
    },
    {
      "id": "transition.bint_len_reaches_digit_loop_guard",
      "invariants": [
        "edge.bint_len_reaches_digit_loop_guard",
        "edge.bint_len_reaches_digit_loop_guard_edge"
      ],
      "kind": "transition",
      "from": "bint_new_str_forward",
      "at": "digit_loop_guard",
      "check": [
        "eq",
        "$bint_new_str_forward.forwarded_len",
        "$digit_loop_guard.len_before_read"
      ]
    },
    {
      "id": "transition.wrapped_index_reaches_first_digit_read",
      "invariants": [
        "edge.wrapped_index_reaches_first_digit_read"
      ],
      "kind": "transition",
      "from": "wrapped_index_entry",
      "at": "first_digit_read",
      "check": [
        "eq",
        "$wrapped_index_entry.read_index",
        "$first_digit_read.read_index"
      ]
    },
    {
      "id": "observed.first_digit_read_uses_out_of_bounds_index",
      "invariants": [
        "node.first_digit_read_uses_out_of_bounds_index"
      ],
      "kind": "observed",
      "at": "first_digit_read",
      "check": [
        "ge",
        "$first_digit_read.read_index",
        "$first_digit_read.digit_count"
      ]
    }
  ]
}
