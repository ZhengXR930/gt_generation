  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42475209",
  "content_hash": "sha256:c1dfea0acde533145b4d4957115aaf9f0186716a11dd175934aae89ea99ba65c",
  "assertions": [
    {
      "id": "A-ROOT-UNROUNDED-SOURCE-REQUIRES-VARIATION",
      "invariants": [
        "I-ROOT-UNROUNDED-SOURCE-REQUIRES-VARIATION"
      ],
      "kind": "required",
      "at": "scale_source_selection",
      "check": [
        "le",
        "$scale_source_selection.scale_uses_unrounded",
        "$scale_source_selection.variation_instance_active"
      ],
      "protects": "scale_source_selection"
    },
    {
      "id": "A-SINK-UNROUNDED-POINTER-IS-UNINITIALIZED",
      "invariants": [
        "I-SINK-UNROUNDED-POINTER-IS-UNINITIALIZED"
      ],
      "kind": "observed",
      "at": "unrounded_sink",
      "check": [
        "lt",
        "$unrounded_sink.unrounded_initialized_prefix_len",
        "$unrounded_sink.unrounded_ptr_bytes"
      ]
    },
    {
      "id": "A-UNROUNDED-SLOT-REACHES-SINK",
      "invariants": [
        "I-UNROUNDED-SLOT-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "scale_source_selection",
      "at": "unrounded_sink",
      "check": [
        "eq",
        "$scale_source_selection.unrounded_slot_addr",
        "$unrounded_sink.unrounded_slot_addr"
      ]
    }
  ]
}
