  "assertions": [
    {
      "id": "a_static_allocator_size_is_preserved",
      "invariants": [
        "r_static_allocator_size_is_preserved"
      ],
      "kind": "required",
      "at": "single_allocator_resize",
      "check": [
        "eq",
        "$single_allocator_resize.buf_size_before",
        "$single_allocator_resize.buf_size_after"
      ],
      "protects": "single_allocator_resize"
    },
    {
      "id": "a_stale_allocator_size_reaches_fallback_size",
      "invariants": [
        "e_stale_allocator_size_reaches_fallback_size",
        "N_EVENT_fallback_get_buffer"
      ],
      "kind": "transition",
      "from": "single_allocator_resize",
      "at": "fallback_get_buffer",
      "check": [
        "eq",
        "$single_allocator_resize.buf_size_after",
        "$fallback_get_buffer.returned_size"
      ]
    },
    {
      "id": "a_fallback_size_reaches_recv_size",
      "invariants": [
        "e_fallback_size_reaches_recv_size",
        "e_fallback_size_reaches_recv_size_edge"
      ],
      "kind": "transition",
      "from": "fallback_get_buffer",
      "at": "tcp_recv_sink",
      "check": [
        "eq",
        "$fallback_get_buffer.returned_size",
        "$tcp_recv_sink.recv_size"
      ]
    },
    {
      "id": "a_fallback_buffer_reaches_recv_buffer",
      "invariants": [
        "e_fallback_buffer_reaches_recv_buffer"
      ],
      "kind": "transition",
      "from": "fallback_get_buffer",
      "at": "tcp_recv_sink",
      "check": [
        "eq",
        "$fallback_get_buffer.returned_buffer",
        "$tcp_recv_sink.recv_buffer"
      ]
    }
  ]
}
