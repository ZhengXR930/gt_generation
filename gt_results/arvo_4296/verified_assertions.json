{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_4296",
  "content_hash": "sha256:3f72e97b7150a9a8b9502fa80349a41c2f20cab911e8f94b096e46ea8be2e050",
  "assertions": [
    {
      "id": "a_encoded_typeid_must_not_alias_source_typeid",
      "invariants": [
        "r_encoded_typeid_must_not_alias_source_typeid"
      ],
      "kind": "required",
      "at": "encoded_typeid_store",
      "check": [
        "ne",
        "$encoded_typeid_store.stored_typeid_ptr",
        "$encoded_typeid_store.source_typeid_ptr"
      ],
      "protects": "post_bin_typeid_cleanup"
    },
    {
      "id": "a_stored_typeid_ptr_reaches_post_cleanup_stale_alias",
      "invariants": [
        "e_stored_typeid_ptr_reaches_post_cleanup_stale_alias"
      ],
      "kind": "transition",
      "from": "encoded_typeid_store",
      "at": "post_bin_typeid_cleanup",
      "check": [
        "eq",
        "$encoded_typeid_store.stored_typeid_ptr",
        "$post_bin_typeid_cleanup.stale_encoded_typeid_ptr"
      ]
    },
    {
      "id": "a_post_cleanup_stale_alias_matches_freed_source",
      "invariants": [
        "n_post_cleanup_leaves_stale_encoded_typeid"
      ],
      "kind": "observed",
      "at": "post_bin_typeid_cleanup",
      "check": [
        "eq",
        "$post_bin_typeid_cleanup.stale_encoded_typeid_ptr",
        "$post_bin_typeid_cleanup.freed_source_ptr"
      ]
    },
    {
      "id": "a_stale_encoded_typeid_reaches_string_delete_sink",
      "invariants": [
        "e_stale_encoded_typeid_reaches_string_delete_sink",
        "n_string_delete_refrees_tracked_typeid"
      ],
      "kind": "transition",
      "from": "post_bin_typeid_cleanup",
      "at": "tracked_string_delete_sink",
      "check": [
        "eq",
        "$post_bin_typeid_cleanup.stale_encoded_typeid_ptr",
        "$tracked_string_delete_sink.free_argument"
      ]
    }
  ]
}
