      },
      "verified": true,
      "verified_by": "a_stale_encoded_typeid_reaches_string_delete_sink",
      "fine_trace_step": 10,
      "description": "ASan sink. Cleanup of the partially decoded `ExtensionObject` reaches `String_deleteMembers` on the aliased `NodeId` string and passes the same 1-byte heap region to `UA_free()` a second time."
    },
    {
      "invariant_id": "n_post_cleanup_leaves_stale_encoded_typeid",
