      "verified": true,
      "verified_by": "a_first_delimiter_within_line_end",
      "fine_trace_step": 4,
      "description": "The token splitter uses unbounded `strchr` and blindly returns `ptr + 1` without checking whether the found delimiter is still within the caller's recorded line extent. On the first split of the malformed proxy line, it accepts the space at `data_copy + 6` even though the line ended at `data_copy + 4`."
    },
    {
      "invariant_id": "e_first_return_reaches_second_split",
