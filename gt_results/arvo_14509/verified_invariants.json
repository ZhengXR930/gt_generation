        "ptr + 1",
        "strp"
      ],
      "relation": {
        "op": "eq",
        "left": "ptr + 1",
        "right": "strp"
      },
      "verified": true,
      "verified_by": "a_first_return_reaches_second_split",
      "fine_trace_step": 7,
      "description": "ASan sink. The fourth `strsep_char()` call searches for another space from `src_port = data_copy + 9`, but the exact 32767-byte witness contains no in-bounds space or NUL after that point, so `strchr` reads off the end of global `data_copy`."
    },
