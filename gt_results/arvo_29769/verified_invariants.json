        "left": "session->server_hostkey_len",
        "right": "session->server_hostkey_len"
      },
      "verified": true,
      "verified_by": "a_hostkey_length_reaches_copy_size",
      "fine_trace_step": 5,
      "description": "ASan sink. The copy reads `session->server_hostkey_len` bytes from `s == data + 5`; the saved crash shows the reply buffer is only a 24-byte heap allocation, so this read crosses the end of that buffer."
    }
