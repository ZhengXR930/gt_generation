      "verified": true,
      "fine_trace_step": 3,
      "description": "The ECDH reply parser skips the packet-type byte and decodes the next four attacker-controlled bytes as `session->server_hostkey_len`, materializing the copy size later used by `memcpy()`."
    },
    {
      "invariant_id": "r_hostkey_field_must_fit_reply_payload",
      "role": "root_cause",
      "file": "src/kex.c",
      "function": "ecdh_sha2_nistp",
      "line": 1764,
      "operands": [
        "session->server_hostkey_len",
        "data_len - (size_t)(s - data)"
      ],
      "relation": {
        "op": "le",
        "left": "session->server_hostkey_len",
        "right": "data_len - (size_t)(s - data)"
      },
      "verified": true,
      "verified_by": "a_hostkey_field_must_fit_reply_payload",
      "fine_trace_step": 4,
      "description": "After decoding the untrusted host-key length, the vulnerable code allocates a destination buffer of that size and proceeds toward the copy without any check that the length-prefixed field actually fits in the received reply buffer. The staged patch replaces this manual sequence with `_libssh2_copy_string()` on a bounded `struct string_buf`."
    },
    {
      "invariant_id": "n_hostkey_memcpy_sink",
      "role": "sink",
      "file": "src/kex.c",
      "function": "ecdh_sha2_nistp",
