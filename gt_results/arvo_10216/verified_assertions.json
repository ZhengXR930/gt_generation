      ],
      "kind": "observed",
      "at": "key_id_dispatch",
      "check": [
        "gt",
        "$key_id_dispatch.cmp_bytes",
        "$key_id_dispatch.oid_initialized_prefix_len"
      ]
    },
    {
      "id": "A-ATTRIBUTE-OID-BUFFER-TO-KEY-ID-DISPATCH",
      "invariants": [
        "I-ATTRIBUTE-OID-BUFFER-TO-KEY-ID-DISPATCH"
      ],
      "kind": "transition",
      "from": "attr_oid_read",
      "at": "key_id_dispatch",
      "check": [
