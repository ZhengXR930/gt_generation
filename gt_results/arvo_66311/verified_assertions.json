      ],
      "kind": "required",
      "at": "variant_type_guard",
      "check": [
        "le",
        "$variant_type_guard.built_in_type_id",
        "$variant_type_guard.max_valid_builtin_type_id"
      ],
      "protects": "variant_table_lookup"
    },
    {
      "id": "a_variant_table_lookup_uses_first_invalid_builtin_type",
      "invariants": [
        "n_variant_table_lookup_uses_first_invalid_builtin_type"
      ],
      "kind": "observed",
      "at": "variant_table_lookup",
      "check": [
        "eq",
        "$variant_table_lookup.table_index",
        "$variant_table_lookup.first_invalid_builtin_type_id"
      ]
    },
    {
      "id": "a_out_of_range_builtin_type_reaches_variant_table_lookup",
      "invariants": [
        "e_out_of_range_builtin_type_reaches_variant_table_lookup"
      ],
      "kind": "transition",
      "from": "variant_type_guard",
      "at": "variant_table_lookup",
