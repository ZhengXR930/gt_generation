        "left": "SOPC_BUILTINID_MAX + 1",
        "right": "builtInTypeId"
      },
      "verified": true,
      "verified_by": "a_variant_table_lookup_uses_first_invalid_builtin_type",
      "fine_trace_step": 7,
      "description": "AddressSanitizer crash site. With `builtInTypeId == 26`, evaluating the first size argument reads `SOPC_BuiltInType_HandlingTable[26]` one entry past the 26-element global table; the same call also prepares two more one-past-end table lookups from the encoding and initialize/clear tables."
    }
