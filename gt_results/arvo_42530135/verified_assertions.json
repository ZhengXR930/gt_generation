{
  "sample_id": "arvo_42530135",
  "content_hash": "sha256:51c469398314d9ea7e23ad7a8708e6908ca2206bb78ce2947f1e971d1fe4f956",
  "assertions": [
    {
      "id": "a_nikon_text_length_leaves_terminator_space",
      "invariants": [
        "r_nikon_text_length_leaves_terminator_space"
      ],
      "kind": "required",
      "at": "nikon_text_guard",
      "check": [
        "lt",
        "$nikon_text_guard.data_length",
        "$nikon_text_guard.buf_size"
      ],
      "protects": "nikon_to_string_call"
    },
    {
      "id": "a_nikon_to_string_receives_nonterminated_buffer",
      "invariants": [
        "n_nikon_to_string_receives_nonterminated_buffer"
      ],
      "kind": "observed",
      "at": "nikon_to_string_call",
      "check": [
        "ne",
        "$nikon_to_string_call.last_byte",
        "$nikon_to_string_call.zero_literal"
      ]
    },
    {
      "id": "a_guard_length_reaches_payload_read",
      "invariants": [
        "e_guard_length_reaches_payload_read"
      ],
      "kind": "transition",
      "from": "nikon_text_guard",
      "at": "nikon_payload_read",
      "check": [
        "eq",
        "$nikon_text_guard.data_length",
        "$nikon_payload_read.read_len"
      ]
    },
    {
      "id": "a_payload_buffer_reaches_to_string_call",
      "invariants": [
        "e_payload_buffer_reaches_to_string_call"
      ],
      "kind": "transition",
      "from": "nikon_payload_read",
      "at": "nikon_to_string_call",
      "check": [
        "eq",
        "$nikon_payload_read.buf_ptr",
        "$nikon_to_string_call.buf_ptr"
      ]
    },
    {
      "id": "a_nikon_payload_read_is_exact_fit",
      "invariants": [
        "n_nikon_payload_read_is_exact_fit"
      ],
      "kind": "observed",
      "at": "nikon_payload_read",
      "check": [
        "eq",
        "$nikon_payload_read.read_len",
        "$nikon_payload_read.buf_size"
      ]
    }
  ]
}
