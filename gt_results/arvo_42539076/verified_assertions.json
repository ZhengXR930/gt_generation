{
  "sample_id": "arvo_42539076",
  "content_hash": "sha256:617c61e398cc655babec5e396915d59275fa5dc573ba0e7a23b465a75621883a",
  "assertions": [
    {
      "id": "A-ROOT-CFF-GATE-PRESERVES-NAMED-INSTANCE-COUNT",
      "invariants": [
        "R-CFF-GATE-PRESERVES-NAMED-INSTANCE-COUNT"
      ],
      "kind": "required",
      "at": "named_instance_cff_gate",
      "check": [
        "eq",
        "$named_instance_cff_gate.num_instances_after_cff",
        "$named_instance_cff_gate.num_instances_before_cff"
      ],
      "protects": "coords_write_sink"
    },
    {
      "id": "A-CFF-GATE-COUNT-FLOWS-INTO-DEFAULT-SYNTH",
      "invariants": [
        "E-CFF-GATE-COUNT-FLOWS-INTO-DEFAULT-SYNTH"
      ],
      "kind": "transition",
      "from": "named_instance_cff_gate",
      "at": "default_instance_synthesis",
      "check": [
        "eq",
        "$named_instance_cff_gate.num_instances_after_cff",
        "$default_instance_synthesis.num_instances_before_default_synth"
      ]
    },
    {
      "id": "A-DEFAULT-SYNTH-INCREMENTS-ZEROED-COUNT",
      "invariants": [
        "N-DEFAULT-SYNTH-INCREMENTS-ZEROED-COUNT"
      ],
      "kind": "observed",
      "at": "default_instance_synthesis",
      "check": [
        "gt",
        "$default_instance_synthesis.num_instances_after_default_synth",
        "$default_instance_synthesis.num_instances_before_default_synth"
      ]
    },
    {
      "id": "A-DEFAULT-SYNTH-COUNT-CACHED-IN-STYLE-FLAGS",
      "invariants": [
        "E-DEFAULT-SYNTH-COUNT-CACHED-IN-STYLE-FLAGS",
        "N_EVENT_named_instance_cache_store"
      ],
      "kind": "transition",
      "from": "default_instance_synthesis",
      "at": "named_instance_cache_store",
      "check": [
        "eq",
        "$default_instance_synthesis.num_instances_after_default_synth",
        "$named_instance_cache_store.cached_named_instance_count"
      ]
    },
    {
      "id": "A-CACHED-NAMED-INSTANCE-COUNT-SIZES-MMVAR",
      "invariants": [
        "E-CACHED-NAMED-INSTANCE-COUNT-SIZES-MMVAR"
      ],
      "kind": "transition",
      "from": "named_instance_cache_store",
      "at": "mmvar_capacity_setup",
      "check": [
        "eq",
        "$named_instance_cache_store.cached_named_instance_count",
        "$mmvar_capacity_setup.mmvar_namedstyle_capacity"
      ]
    },
    {
      "id": "A-MMVAR-CAPACITY-LT-FVAR-INSTANCE-COUNT",
      "invariants": [
        "N-MMVAR-CAPACITY-LT-FVAR-INSTANCE-COUNT"
      ],
      "kind": "observed",
      "at": "mmvar_capacity_setup",
      "check": [
        "lt",
        "$mmvar_capacity_setup.mmvar_namedstyle_capacity",
        "$mmvar_capacity_setup.fvar_instance_count"
      ]
    },
    {
      "id": "A-MMVAR-CAPACITY-REACHES-COORDS-WRITE-SINK",
      "invariants": [
        "E-MMVAR-CAPACITY-REACHES-COORDS-WRITE-SINK"
      ],
      "kind": "transition",
      "from": "mmvar_capacity_setup",
      "at": "coords_write_sink",
      "check": [
        "eq",
        "$mmvar_capacity_setup.mmvar_namedstyle_capacity",
        "$coords_write_sink.mmvar_namedstyle_capacity"
      ]
    },
    {
      "id": "A-NAMEDSTYLE-COORDS-POINTER-REACHES-WRITE-SINK",
      "invariants": [
        "E-NAMEDSTYLE-COORDS-POINTER-REACHES-WRITE-SINK"
      ],
      "kind": "transition",
      "from": "namedstyle_coords_read",
      "at": "coords_write_sink",
      "check": [
        "eq",
        "$namedstyle_coords_read.ns_coords_ptr",
        "$coords_write_sink.write_target_ptr"
      ]
    },
    {
      "id": "A-COORDS-WRITE-INDEX-EXCEEDS-NAMEDSTYLE-CAPACITY",
      "invariants": [
        "N-COORDS-WRITE-INDEX-EXCEEDS-NAMEDSTYLE-CAPACITY"
      ],
      "kind": "observed",
      "at": "coords_write_sink",
      "check": [
        "ge",
        "$coords_write_sink.write_instance_index",
        "$coords_write_sink.mmvar_namedstyle_capacity"
      ]
    }
  ]
}
