{
  "sample_id": "secbench_oss_wasm3.ossfuzz-42495624",
  "content_hash": "sha256:788bf75dbab9ba204d6276432088fca6fdfbb308127ec94c98178891be550223",
  "assertions": [
    {
      "id": "required.ordinary_opcode_index_in_bounds",
      "invariants": [
        "root.ordinary_opcode_index_in_bounds"
      ],
      "kind": "required",
      "at": "opcode_lookup",
      "check": [
        "lt",
        "$opcode_lookup.opcode",
        "$opcode_lookup.ordinary_opcode_limit"
      ],
      "protects": "sink_deref"
    },
    {
      "id": "observed.sink_uses_out_of_range_ordinary_opcode",
      "invariants": [
        "node.sink_uses_out_of_range_ordinary_opcode"
      ],
      "kind": "observed",
      "at": "sink_deref",
      "check": [
        "ge",
        "$sink_deref.opcode",
        "$sink_deref.ordinary_opcode_limit"
      ]
    },
    {
      "id": "transition.decoded_opcode_reaches_lookup",
      "invariants": [
        "edge.decoded_opcode_reaches_lookup"
      ],
      "kind": "transition",
      "from": "opcode_decode",
      "at": "opcode_lookup",
      "check": [
        "eq",
        "$opcode_decode.opcode",
        "$opcode_lookup.opcode"
      ]
    },
    {
      "id": "transition.lookup_opcode_reaches_sink",
      "invariants": [
        "edge.lookup_opcode_reaches_sink"
      ],
      "kind": "transition",
      "from": "opcode_lookup",
      "at": "sink_deref",
      "check": [
        "eq",
        "$opcode_lookup.opcode",
        "$sink_deref.opcode"
      ]
    }
  ]
}
