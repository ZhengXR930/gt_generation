{
  "sample_id": "arvo_63885",
  "content_hash": "sha256:0ad2bec8df28142780c042d06c0c436de0726faeed4e4a87f1e136c36153a615",
  "assertions": [
    {
      "id": "A-ROOT-FORCE-INTERPRETER-ENABLED-BEFORE-PARSE",
      "invariants": [
        "R_FORCE_INTERPRETER_ENABLED_BEFORE_PARSE"
      ],
      "kind": "required",
      "at": "fuzztool_config",
      "check": [
        "eq",
        "$fuzztool_config.force_interpreter_enabled",
        "$fuzztool_config.true_literal"
      ],
      "protects": "parse_returned"
    },
    {
      "id": "A-SKIP-BRANCH-LEAVES-CODE-EXPR-EMPTY",
      "invariants": [
        "N_SKIP_BRANCH_LEAVES_CODE_EXPR_EMPTY"
      ],
      "kind": "observed",
      "at": "skip_body_state",
      "check": [
        "eq",
        "$skip_body_state.expr_instr_count_after",
        "$skip_body_state.zero_literal"
      ]
    },
    {
      "id": "A-POST-COMPILE-STACK-REMAINS-EMPTY",
      "invariants": [
        "N_POST_COMPILE_STACK_REMAINS_EMPTY"
      ],
      "kind": "observed",
      "at": "compile_post_expr",
      "check": [
        "eq",
        "$compile_post_expr.stack_size_after_compile",
        "$compile_post_expr.zero_literal"
      ]
    },
    {
      "id": "A-STACKPOP-SINK-READS-FROM-EMPTY-STACK",
      "invariants": [
        "N_STACKPOP_SINK_READS_FROM_EMPTY_STACK"
      ],
      "kind": "observed",
      "at": "stackpop_sink",
      "check": [
        "eq",
        "$stackpop_sink.stack_size_before_back",
        "$stackpop_sink.zero_literal"
      ]
    },
    {
      "id": "A-CONFIG-FLOWS-TO-AOT-SECTION-HANDLER",
      "invariants": [
        "E_CONFIG_FLOWS_TO_AOT_SECTION_HANDLER",
        "N_EVENT_aot_section_state"
      ],
      "kind": "transition",
      "from": "fuzztool_config",
      "at": "aot_section_state",
      "check": [
        "eq",
        "$fuzztool_config.force_interpreter_enabled",
        "$aot_section_state.force_interpreter_enabled"
      ]
    },
    {
      "id": "A-AOT-MODE-REACHES-SKIP-BRANCH",
      "invariants": [
        "E_AOT_MODE_REACHES_SKIP_BRANCH"
      ],
      "kind": "transition",
      "from": "aot_section_state",
      "at": "skip_body_state",
      "check": [
        "eq",
        "$aot_section_state.wasm_type_after",
        "$skip_body_state.wasm_type_current"
      ]
    },
    {
      "id": "A-EMPTY-EXPR-REACHES-FUNCTION-COMPILER",
      "invariants": [
        "E_EMPTY_EXPR_REACHES_FUNCTION_COMPILER"
      ],
      "kind": "transition",
      "from": "skip_body_state",
      "at": "compile_post_expr",
      "check": [
        "eq",
        "$skip_body_state.expr_instr_count_after",
        "$compile_post_expr.expr_instr_count"
      ]
    },
    {
      "id": "A-EMPTY-STACK-REACHES-STACKPOP-SINK",
      "invariants": [
        "E_EMPTY_STACK_REACHES_STACKPOP_SINK"
      ],
      "kind": "transition",
      "from": "compile_post_expr",
      "at": "stackpop_sink",
      "check": [
        "eq",
        "$compile_post_expr.stack_size_after_compile",
        "$stackpop_sink.stack_size_before_back"
      ]
    }
  ]
}
