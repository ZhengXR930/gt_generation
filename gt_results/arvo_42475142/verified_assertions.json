  "assertions": [
    {
      "id": "A-ROOT-U1IMM-OPERAND-INDEX-IN-RANGE",
      "invariants": [
        "I-ROOT-U1IMM-OPERAND-INDEX-IN-RANGE"
      ],
      "kind": "required",
      "at": "u1imm_operand_load",
      "check": [
        "lt",
        "$u1imm_operand_load.requested_operand_index",
        "$u1imm_operand_load.decoded_operand_count"
      ],
      "protects": "print_uint32_sink"
    },
    {
      "id": "A-SINK-PRINTUINT32-USES-UNINITIALIZED-U1IMM",
      "invariants": [
        "I-SINK-PRINTUINT32-USES-UNINITIALIZED-U1IMM"
      ],
      "kind": "observed",
      "at": "print_uint32_sink",
      "check": [
        "gt",
        "$print_uint32_sink.value_read_bytes",
        "$print_uint32_sink.value_initialized_prefix_len"
      ]
    },
    {
      "id": "A-U1IMM-VALUE-REACHES-PRINTUINT32",
      "invariants": [
        "I-U1IMM-VALUE-REACHES-PRINTUINT32"
      ],
      "kind": "transition",
      "from": "u1imm_operand_load",
      "at": "print_uint32_sink",
      "check": [
        "eq",
        "$u1imm_operand_load.loaded_value_bits",
        "$print_uint32_sink.val_bits"
      ]
    }
  ]
