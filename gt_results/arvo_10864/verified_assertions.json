{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_10864",
  "content_hash": "sha256:aee0df563cb03bb1c569b936386404654e6ba0e1dcf75bff89bdb782a6e4c9af",
  "assertions": [
    {
      "id": "a_root_address_copied_before_erase",
      "invariants": [
        "r_address_must_not_alias_map_key_storage"
      ],
      "kind": "required",
      "at": "alias_slaac_key_by_reference",
      "check": [
        "ne",
        "$alias_slaac_key_by_reference.address_object_ptr",
        "$alias_slaac_key_by_reference.map_key_object_ptr"
      ],
      "protects": "tunnel_remove_address_guard"
    },
    {
      "id": "a_alias_object_reaches_erase",
      "invariants": [
        "e_alias_object_reaches_erase",
        "erase_unicast_address_entry"
      ],
      "kind": "transition",
      "from": "alias_slaac_key_by_reference",
      "at": "erase_unicast_address_entry",
      "check": [
        "eq",
        "$alias_slaac_key_by_reference.address_object_ptr",
        "$erase_unicast_address_entry.erase_argument_ptr"
      ]
    },
    {
      "id": "a_freed_address_object_reaches_interface_call",
      "invariants": [
        "e_freed_address_object_reaches_interface_call"
      ],
      "kind": "transition",
      "from": "erase_unicast_address_entry",
      "at": "forward_address_to_interface",
      "check": [
        "eq",
        "$erase_unicast_address_entry.erase_argument_ptr",
        "$forward_address_to_interface.remove_argument_ptr"
      ]
    },
    {
      "id": "a_forwarded_pointer_reaches_remove_address_guard",
      "invariants": [
        "e_forwarded_pointer_reaches_remove_address_guard",
        "tunnel_remove_address_guard"
      ],
      "kind": "transition",
      "from": "forward_address_to_interface",
      "at": "tunnel_remove_address_guard",
      "check": [
        "eq",
        "$forward_address_to_interface.remove_argument_ptr",
        "$tunnel_remove_address_guard.addr_argument_ptr"
      ]
    }
  ]
}
