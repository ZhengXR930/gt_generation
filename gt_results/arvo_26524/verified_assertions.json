{
  "sample_id": "arvo_26524",
  "content_hash": "sha256:eafb4c8881097a6086b9b12c227ff4282a274e1889d0c296f168b7f6ca6d1aff",
  "assertions": [
    {
      "id": "a_exif_trim_requires_reported_length_gt_4",
      "invariants": [
        "r_exif_trim_requires_reported_length_gt_4"
      ],
      "kind": "required",
      "at": "exif_trim_guard",
      "check": [
        "gt",
        "$exif_trim_guard.reported_length",
        4
      ],
      "protects": "exif_trim_apply"
    },
    {
      "id": "a_trimmed_data_ptr_stored_in_exif_blob",
      "invariants": [
        "e_trimmed_data_ptr_stored_in_exif_blob",
        "n_short_exif_trimmed_data_ptr",
        "n_exif_blob_store_uses_trimmed_data_ptr"
      ],
      "kind": "transition",
      "from": "exif_trim_apply",
      "at": "exif_blob_store",
      "check": [
        "eq",
        "$exif_trim_apply.trimmed_data_ptr",
        "$exif_blob_store.blob_data_ptr"
      ]
    },
    {
      "id": "a_trimmed_length_u32_stored_in_exif_blob",
      "invariants": [
        "e_trimmed_length_u32_stored_in_exif_blob",
        "n_short_exif_trimmed_length_u32",
        "n_exif_blob_store_uses_trimmed_length_u32"
      ],
      "kind": "transition",
      "from": "exif_trim_apply",
      "at": "exif_blob_store",
      "check": [
        "eq",
        "$exif_trim_apply.trimmed_length_u32",
        "$exif_blob_store.blob_length_u32"
      ]
    },
    {
      "id": "a_exif_blob_data_ptr_reaches_libexif_call",
      "invariants": [
        "e_exif_blob_data_ptr_reaches_libexif_call",
        "n_libexif_call_uses_trimmed_data_ptr"
      ],
      "kind": "transition",
      "from": "exif_blob_store",
      "at": "libexif_call",
      "check": [
        "eq",
        "$exif_blob_store.blob_data_ptr",
        "$libexif_call.libexif_data_ptr"
      ]
    },
    {
      "id": "a_exif_blob_length_u32_reaches_libexif_call",
      "invariants": [
        "e_exif_blob_length_u32_reaches_libexif_call",
        "n_libexif_call_uses_wrapped_length_u32"
      ],
      "kind": "transition",
      "from": "exif_blob_store",
      "at": "libexif_call",
      "check": [
        "eq",
        "$exif_blob_store.blob_length_u32",
        "$libexif_call.forwarded_length_u32"
      ]
    }
  ]
