  "root_cause_criterion": {
    "invariant_id": "r_exif_trim_requires_reported_length_gt_4",
    "type": "missing_obligation",
    "verified": true,
    "verified_by": "a_exif_trim_requires_reported_length_gt_4",
    "file": "libvips/foreign/heifload.c",
    "function": "vips_foreign_load_heif_set_header",
    "line": 452,
    "fine_trace_step": 5,
    "variable": "length",
    "missing_conjunct": "length > 4",
    "criterion": "Before the EXIF trim path skips the 4-byte offset prefix, the reported EXIF metadata length must be greater than 4 so `data += 4; length -= 4` only runs on a block that actually contains that prefix and at least one remaining byte.",
    "description": "The vulnerable original enters the EXIF trim path with `length == 1`, advances `data` four bytes, and wraps the unsigned `length` before storing the blob. In the authoritative fixed image, the original PoC still reaches the EXIF path but `exif_trim_apply` is guarded; the closest source-grounded `length == 5` perturbation makes the required predicate true and executes the protected trim path as a genuine witness."
  },
