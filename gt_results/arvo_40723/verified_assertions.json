{
  "sample_id": "arvo_40723",
  "content_hash": "sha256:dc0a68187b180afd0d605ec6f4cd51b43123481de80e757a4a38e423d5c95537",
  "assertions": [
    {
      "id": "a_selected_list_extent_must_not_exceed_remaining_bytes",
      "invariants": [
        "r_selected_list_extent_within_remaining_bytes"
      ],
      "kind": "required",
      "at": "list_subconsumer_extent",
      "check": [
        "le",
        "$list_subconsumer_extent.selected_list_size",
        "$list_subconsumer_extent.remaining_bytes_after_size"
      ],
      "protects": "list_count_read_sink"
    },
    {
      "id": "a_list_subconsumer_starts_at_end_of_real_slice",
      "invariants": [
        "n_list_subconsumer_starts_at_consumer_end"
      ],
      "kind": "observed",
      "at": "list_subconsumer_extent",
      "check": [
        "eq",
        "$list_subconsumer_extent.subconsumer_start_ptr",
        "$list_subconsumer_extent.consumer_end_ptr"
      ]
    },
    {
      "id": "a_selected_list_extent_becomes_count_read_logical_size",
      "invariants": [
        "e_selected_list_extent_reaches_count_read_logical_size"
      ],
      "kind": "transition",
      "from": "list_subconsumer_extent",
      "at": "list_count_read_sink",
      "check": [
        "eq",
        "$list_subconsumer_extent.selected_list_size",
        "$list_count_read_sink.logical_subconsumer_size"
      ]
    },
    {
      "id": "a_fabricated_list_base_reaches_count_byte_dereference",
      "invariants": [
        "e_fabricated_list_base_reaches_count_read",
        "n_list_count_read_uses_fabricated_base"
      ],
      "kind": "transition",
      "from": "list_subconsumer_extent",
      "at": "list_count_read_sink",
      "check": [
        "eq",
        "$list_subconsumer_extent.subconsumer_start_ptr",
        "$list_count_read_sink.read_base_ptr"
      ]
    }
  ]
}
