{
  "sample_id": "arvo_38675",
  "content_hash": "sha256:1665f7130e774b7ae08520adae673379f8cc951847ca504837da2a048170e732",
  "assertions": [
    {
      "id": "A-ROOT-COPY-SPAN-COVERS-KEYLEN",
      "invariants": [
        "I-ROOT-COPY-SPAN-COVERS-KEYLEN"
      ],
      "kind": "required",
      "at": "copy_key_post",
      "check": [
        "ge",
        "$copy_key_post.copy_bytes",
        "$copy_key_post.keylen_after"
      ],
      "protects": "hash_word_read"
    },
    {
      "id": "A-SINK-HASH-READ-EXCEEDS-COPIED-SPAN",
      "invariants": [
        "I-SINK-HASH-READ-EXCEEDS-COPIED-SPAN"
      ],
      "kind": "observed",
      "at": "hash_word_read",
      "check": [
        "gt",
        "$hash_word_read.hash_len",
        "$hash_word_read.copy_bytes"
      ]
    },
    {
      "id": "A-COPIED-KEY-POINTER-TO-HASH",
      "invariants": [
        "I-COPIED-KEY-POINTER-TO-HASH"
      ],
      "kind": "transition",
      "from": "copy_key_post",
      "at": "hash_word_read",
      "check": [
        "eq",
        "$copy_key_post.key_ptr",
        "$hash_word_read.hash_key_ptr"
      ]
    },
    {
      "id": "A-COPIED-KEYLEN-TO-HASH",
      "invariants": [
        "I-COPIED-KEYLEN-TO-HASH"
      ],
      "kind": "transition",
      "from": "copy_key_post",
      "at": "hash_word_read",
      "check": [
        "eq",
        "$copy_key_post.keylen_after",
        "$hash_word_read.hash_len"
      ]
    }
  ]
}
