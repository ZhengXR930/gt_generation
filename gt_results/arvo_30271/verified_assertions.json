{
  "sample_id": "arvo_30271",
  "content_hash": "sha256:ab1c3cc251e9148051aaa686efcff91d3d73ca2909127ae7fb646f8e8e87db3c",
  "assertions": [
    {
      "id": "A-ROOT-QUOTED-INCLUDE-LEN-GT-1-BEFORE-STRIP",
      "invariants": [
        "I-ROOT-QUOTED-INCLUDE-LEN-GT-1-BEFORE-STRIP"
      ],
      "kind": "required",
      "at": "quote_strip_guard",
      "check": [
        "gt",
        "$quote_strip_guard.path_len_before",
        1
      ],
      "protects": "quote_strip_effect"
    },
    {
      "id": "A-ONE-BYTE-QUOTED-PATH-WRAPS-ON-STRIP",
      "invariants": [
        "I-ONE-BYTE-QUOTED-PATH-WRAPS-ON-STRIP",
        "I-POST-STRIP-PATH-LEN-WRAPPED"
      ],
      "kind": "transition",
      "from": "quote_strip_guard",
      "at": "quote_strip_effect",
      "check": [
        "lt",
        "$quote_strip_guard.path_len_before",
        "$quote_strip_effect.path_len_after"
      ]
    },
    {
      "id": "A-WRAPPED-LEN-FLOWS-INTO-SIGNED-COPY-LEN",
      "invariants": [
        "I-WRAPPED-LEN-FLOWS-INTO-SIGNED-COPY-LEN"
      ],
      "kind": "transition",
      "from": "quote_strip_effect",
      "at": "include_len_cast",
      "check": [
        "eq",
        "$quote_strip_effect.path_len_after",
        "$include_len_cast.path_len_before_cast"
      ]
    },
    {
      "id": "A-SIGNED-COPY-LEN-NEGATIVE",
      "invariants": [
        "I-SIGNED-COPY-LEN-NEGATIVE"
      ],
      "kind": "observed",
      "at": "include_len_cast",
      "check": [
        "lt",
        "$include_len_cast.signed_copy_len",
        "$include_len_cast.zero_literal"
      ]
    },
    {
      "id": "A-NEGATIVE-LEN-REACHES-RAW-COPY-MEMCPY",
      "invariants": [
        "I-NEGATIVE-LEN-REACHES-RAW-COPY-MEMCPY",
        "I-SINK-MEMCPY-USES-NEGATIVE-LEN"
      ],
      "kind": "transition",
      "from": "include_len_cast",
      "at": "raw_copy_memcpy_sink",
      "check": [
        "eq",
        "$include_len_cast.signed_copy_len",
        "$raw_copy_memcpy_sink.copy_len"
      ]
    }
  ]
}
