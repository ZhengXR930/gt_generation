      ]
    },
    {
      "id": "A-MAP-PERM-ITEM-USE-REINTERPRETS-LIST-ITEM",
      "invariants": [
        "I-MAP-PERM-ITEM-USE-REINTERPRETS-LIST-ITEM"
      ],
      "kind": "observed",
      "at": "map_perm_item_use",
      "check": [
        "eq",
        "$map_perm_item_use.item_is_list",
        "$map_perm_item_use.true_literal"
      ]
    },
    {
      "id": "A-RESOLVED-NESTED-PERM-ITEM-IS-STORED-AS-LIST",
      "invariants": [
        "I-RESOLVED-NESTED-PERM-ITEM-IS-STORED-AS-LIST"
      ],
      "kind": "observed",
      "at": "resolved_nested_perm_list",
      "check": [
        "eq",
        "$resolved_nested_perm_list.stored_as_list",
        "$resolved_nested_perm_list.true_literal"
