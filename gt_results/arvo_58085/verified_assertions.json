      "check": [
        "eq",
        "$map_perm_root.item_data_ptr",
        "$map_perm_item_use.perm_ptr"
      ]
    },
    {
      "id": "A-RESOLVED-NESTED-LIST-POINTER-REACHES-ROOT-ITEM",
      "invariants": [
        "I-RESOLVED-NESTED-LIST-POINTER-REACHES-ROOT-ITEM"
      ],
      "kind": "transition",
      "from": "resolved_nested_perm_list",
