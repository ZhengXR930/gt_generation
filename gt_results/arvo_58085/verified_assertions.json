        "$map_perm_item_use.perm_ptr",
        "$map_perm_recursive_sink.perm_ptr"
      ]
    },
    {
      "id": "A-ROOT-ITEM-DATA-REACHES-MAP-PERM-ITEM-USE",
      "invariants": [
        "I-ROOT-ITEM-DATA-REACHES-MAP-PERM-ITEM-USE"
      ],
      "kind": "transition",
      "from": "map_perm_root",
