      "invariants": [
        "I-SINK-RECURSIVE-CALL-REACHES-LIST-ITEM"
      ],
      "kind": "observed",
      "at": "map_perm_recursive_sink",
      "check": [
        "eq",
        "$map_perm_recursive_sink.item_is_list",
        "$map_perm_recursive_sink.true_literal"
      ]
    },
    {
      "id": "A-MAP-PERM-ITEM-USE-POINTER-REACHES-RECURSIVE-SINK",
      "invariants": [
        "I-MAP-PERM-ITEM-USE-POINTER-REACHES-RECURSIVE-SINK"
      ],
      "kind": "transition",
      "from": "map_perm_item_use",
