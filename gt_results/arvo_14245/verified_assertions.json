  "assertions": [
    {
      "id": "A-ROOT-PATH-LOOKUP-CLEARED-BEFORE-DELETE",
      "invariants": [
        "I-ROOT-PATH-LOOKUP-CLEARED-BEFORE-DELETE"
      ],
      "kind": "required",
      "at": "post_remove_lookup",
      "check": [
        "ne",
        "$post_remove_lookup.path_lookup_after_remove",
        "$post_remove_lookup.delete_target"
      ],
      "protects": "delete_entry"
    },
    {
      "id": "A-DELETED-ENTRY-REACHES-QDELETEALL-SINK",
      "invariants": [
        "I-DELETE-MYENTRY-FREES-STILL-REACHABLE-ENTRY",
        "I-SINK-QDELETEALL-READS-DELETED-ENTRY",
        "I-DELETED-ENTRY-REACHES-QDELETEALL-SINK"
      ],
      "kind": "transition",
      "from": "delete_entry",
      "at": "stale_qdelete_sink",
      "check": [
        "eq",
        "$delete_entry.delete_target",
        "$stale_qdelete_sink.stale_entry_ptr"
      ]
    }
  ]
