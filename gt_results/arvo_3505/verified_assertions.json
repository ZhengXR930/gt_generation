{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_3505",
  "content_hash": "sha256:a4d65e565b72fed510df61dd53fecf2e893bd929a8e92a5ab1ffb68b96144563",
  "assertions": [
    {
      "id": "A-ROOT-COMPONENT-COUNT-FITS-ROW-LENGTH",
      "invariants": [
        "I-ROOT-COMPONENT-COUNT-FITS-ROW-LENGTH"
      ],
      "kind": "required",
      "at": "sof_component_guard",
      "check": [
        "le",
        "$sof_component_guard.jpeg_component_count",
        "$sof_component_guard.raw_row_length"
      ],
      "protects": "predictor_copy_sink"
    },
    {
      "id": "A-SINK-PREDICTOR-COPY-EXCEEDS-ROW-LENGTH",
      "invariants": [
        "I-SINK-PREDICTOR-COPY-EXCEEDS-ROW-LENGTH"
      ],
      "kind": "observed",
      "at": "predictor_copy_sink",
      "check": [
        "gt",
        "$predictor_copy_sink.copy_component_count",
        "$predictor_copy_sink.row_component_capacity"
      ]
    },
    {
      "id": "A-COMPONENT-COUNT-REACHES-PREDICTOR-COPY",
      "invariants": [
        "I-COMPONENT-COUNT-REACHES-PREDICTOR-COPY"
      ],
      "kind": "transition",
      "from": "sof_component_guard",
      "at": "predictor_copy_sink",
      "check": [
        "eq",
        "$sof_component_guard.jpeg_component_count",
        "$predictor_copy_sink.copy_component_count"
      ]
    },
    {
      "id": "A-ROW-START-ALIASES-PREDNEXT-AT-SINK",
      "invariants": [
        "I-ROW-START-ALIASES-PREDNEXT-AT-SINK"
      ],
      "kind": "transition",
      "from": "prednext_alias",
      "at": "predictor_copy_sink",
      "check": [
        "eq",
        "$prednext_alias.row_start_ptr",
        "$predictor_copy_sink.prednext_ptr"
      ]
    }
  ]
}
