  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_9445",
  "content_hash": "sha256:f220a98e317598195cf0d9aa2ff48943872b51a84c81b7a56e1dc2758ef128f6",
  "assertions": [
    {
      "id": "A-ROOT-CUSTOM-HEADER-FITS-LOGICAL-PROPERTY",
      "invariants": [
        "I-ROOT-CUSTOM-HEADER-FITS-LOGICAL-PROPERTY"
      ],
      "kind": "required",
      "at": "custom_header_guard",
      "check": [
        "ge",
        "$custom_header_guard.payload_logical_size",
        "$custom_header_guard.required_header_size"
      ],
      "protects": "custom_header_interpreted"
    },
    {
      "id": "A-SINK-FIRST-COUNTER-READ-AT-OR-PAST-PROPERTY-END",
      "invariants": [
        "I-SINK-FIRST-COUNTER-READ-AT-OR-PAST-PROPERTY-END"
      ],
      "kind": "observed",
      "at": "custom_counter_access",
      "check": [
        "ge",
        "$custom_counter_access.current_ptr",
        "$custom_counter_access.payload_end_ptr"
      ]
    },
    {
      "id": "A-HEADER-FIRST-COUNTER-PTR-REACHES-SINK",
      "invariants": [
        "I-HEADER-FIRST-COUNTER-PTR-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "custom_header_guard",
      "at": "custom_counter_access",
      "check": [
        "eq",
        "$custom_header_guard.first_counter_ptr",
        "$custom_counter_access.current_ptr"
      ]
    }
  ]
}
