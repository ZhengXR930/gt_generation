        "state"
      ],
      "relation": {
        "op": "eq",
        "left": "bs->par",
        "right": "state"
      },
      "verified": true,
      "verified_by": "a_eof_dispatch_argument_reaches_eos_sink",
      "fine_trace_step": 13,
      "description": "AddressSanitizer sink. The shared file-backed bitstream reaches local EOF during the bogus `sub_profiles_idc` loop, `BS_ReadByte` falls into its `bs_eof` callback path, and `on_aom_av1_eos` writes through a pointer to a returned stack `AV1State` object."
    },
    {
