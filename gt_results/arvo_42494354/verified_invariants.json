    {
      "invariant_id": "r_vvc_header_must_not_enter_ptl_branch",
      "role": "root_cause",
      "file": "src/odf/descriptors.c",
      "function": "gf_odf_vvc_cfg_read_bs",
      "line": 1232,
      "operands": [
        "0",
        "cfg->ptl_present"
      ],
      "relation": {
        "op": "eq",
        "left": "0",
        "right": "cfg->ptl_present"
      },
      "verified": true,
      "verified_by": "a_vvc_header_must_not_set_ptl_present",
      "fine_trace_step": 4,
      "description": "Root cause. The parser decodes the first 32 bits of the witness's `vvcC` payload with the obsolete pre-FDIS layout, so reserved and downstream header bits are misinterpreted as live header fields. For the exact bytes `3e 76 00 3f`, this block incorrectly sets `ptl_present = 1` and `numTemporalLayers = 7` even though the fixed syntax encodes `ptl_present = 0` in the first byte."
    },
    {
      "invariant_id": "n_eos_write_sink",
