{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42494354",
  "content_hash": "sha256:958de8a05e130c886bd7125a14339099ef696b83c688adf0476687cfb5d37ed2",
  "assertions": [
    {
      "id": "a_vvc_header_must_not_set_ptl_present",
      "invariants": [
        "r_vvc_header_must_not_enter_ptl_branch"
      ],
      "kind": "required",
      "at": "vvc_header_decode",
      "check": [
        "eq",
        "$vvc_header_decode.ptl_present",
        0
      ],
      "protects": "vvc_header_decode"
    },
    {
      "id": "a_short_tail_u32_read_still_uses_root_temporal_layers",
      "invariants": [
        "e_vvc_header_state_reaches_short_tail_u32_read"
      ],
      "kind": "transition",
      "from": "vvc_header_decode",
      "at": "vvc_short_u32_read",
      "check": [
        "eq",
        "$vvc_header_decode.temporal_layers",
        "$vvc_short_u32_read.temporal_layers"
      ]
    },
    {
      "id": "a_vvc_short_tail_u32_read_has_fewer_than_four_bytes",
      "invariants": [
        "n_vvc_short_tail_u32_read"
      ],
      "kind": "observed",
      "at": "vvc_short_u32_read",
      "check": [
        "lt",
        "$vvc_short_u32_read.tail_bytes",
        "$vvc_short_u32_read.u32_width_bytes"
      ]
    },
    {
      "id": "a_short_tail_read_triggers_same_eof_dispatch_state",
      "invariants": [
        "e_short_tail_read_triggers_eof_dispatch",
        "n_eof_callback_dispatch_uses_stale_callback_state"
      ],
      "kind": "transition",
      "from": "vvc_short_u32_read",
      "at": "eof_callback_dispatch",
      "check": [
        "eq",
        "$vvc_short_u32_read.callback_state_ptr",
        "$eof_callback_dispatch.callback_state_ptr"
      ]
    },
    {
      "id": "a_eof_dispatch_argument_reaches_eos_sink",
      "invariants": [
        "e_eof_dispatch_argument_reaches_sink",
        "n_eos_write_sink"
      ],
      "kind": "transition",
      "from": "eof_callback_dispatch",
      "at": "eos_write_sink",
      "check": [
        "eq",
        "$eof_callback_dispatch.callback_state_ptr",
        "$eos_write_sink.sink_state_ptr"
      ]
    },
    {
      "id": "a_av1_callback_state_aliases_stack_state",
      "invariants": [
        "n_av1_callback_stores_stack_state"
      ],
      "kind": "observed",
      "at": "av1_callback_install",
      "check": [
        "eq",
        "$av1_callback_install.callback_state_ptr",
        "$av1_callback_install.stack_state_ptr"
      ]
    },
    {
      "id": "a_av1_stack_state_reaches_eof_dispatch",
      "invariants": [
        "e_av1_stack_state_reaches_eof_dispatch"
      ],
      "kind": "transition",
      "from": "av1_callback_install",
      "at": "eof_callback_dispatch",
      "check": [
        "eq",
        "$av1_callback_install.callback_state_ptr",
        "$eof_callback_dispatch.callback_state_ptr"
      ]
    }
  ]
}
