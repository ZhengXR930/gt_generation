  "assertions": [
    {
      "id": "required.decisive_scan_byte_is_colon",
      "invariants": [
        "root.decisive_scan_byte_is_colon"
      ],
      "kind": "required",
      "at": "colon_boundary",
      "check": [
        "eq",
        "$colon_boundary.decisive_char",
        "$colon_boundary.colon_literal"
      ],
      "protects": "final_scan_step"
    },
    {
      "id": "observed.enum_token_has_no_colon",
      "invariants": [
        "node.enum_token_has_no_colon"
      ],
      "kind": "observed",
      "at": "enum_token",
      "check": [
        "eq",
        "$enum_token.delimiter_offset",
        "$enum_token.enum_length"
      ]
    },
    {
      "id": "observed.oob_sink_reaches_one_past_end",
      "invariants": [
        "node.oob_sink_reaches_one_past_end"
      ],
      "kind": "observed",
      "at": "oob_sink",
      "check": [
        "eq",
        "$oob_sink.scan_cursor",
        "$oob_sink.buffer_end"
      ]
    },
    {
      "id": "transition.enum_boundary_reaches_decisive_scan",
      "invariants": [
        "edge.enum_boundary_reaches_decisive_scan"
      ],
      "kind": "transition",
      "from": "enum_token",
      "at": "colon_boundary",
      "check": [
        "eq",
        "$enum_token.delimiter_offset",
        "$colon_boundary.decisive_offset"
      ]
    },
    {
      "id": "transition.decisive_scan_char_is_consumed_by_final_scan_step",
      "invariants": [
        "edge.decisive_scan_char_is_consumed_by_final_scan_step"
      ],
      "kind": "transition",
      "from": "colon_boundary",
      "at": "final_scan_step",
      "check": [
        "eq",
        "$colon_boundary.decisive_char",
        "$final_scan_step.scan_char"
      ]
    },
    {
      "id": "transition.same_stack_buffer_reaches_oob_sink",
      "invariants": [
        "edge.same_stack_buffer_reaches_oob_sink"
      ],
      "kind": "transition",
      "from": "final_scan_step",
      "at": "oob_sink",
      "check": [
        "eq",
        "$final_scan_step.scan_buffer",
        "$oob_sink.buffer_base"
      ]
    }
  ]
