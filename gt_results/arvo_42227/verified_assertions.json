  "assertions": [
    {
      "id": "a_quote_loop_requires_non_eof_char_before_append",
      "invariants": [
        "r_quote_loop_requires_non_eof_char_before_append"
      ],
      "kind": "required",
      "at": "quote_loop_guard",
      "check": [
        "ne",
        "$quote_loop_guard.current_char",
        0
      ],
      "protects": "quote_append"
    },
    {
      "id": "a_growth_copy_uses_length_beyond_initial_capacity",
      "invariants": [
        "n_growth_copy_uses_amplified_copy_len"
      ],
      "kind": "observed",
      "at": "growth_copy",
      "check": [
        "gt",
        "$growth_copy.copy_len",
        "$growth_copy.initial_capacity"
      ]
    },
    {
      "id": "a_guard_char_reaches_string_append_argument",
      "invariants": [
        "e_guard_char_reaches_string_append"
      ],
      "kind": "transition",
      "from": "quote_loop_guard",
      "at": "quote_append",
      "check": [
        "eq",
        "$quote_loop_guard.current_char",
        "$quote_append.append_char"
      ]
    },
    {
      "id": "a_append_argument_reaches_growth_copy_iteration",
      "invariants": [
        "e_append_char_reaches_growth_copy"
      ],
      "kind": "transition",
      "from": "quote_append",
      "at": "growth_copy",
      "check": [
        "eq",
        "$quote_append.append_char",
        "$growth_copy.append_char"
      ]
    },
    {
      "id": "a_entry_char_reaches_quote_guard",
      "invariants": [
        "e_entry_char_reaches_quote_guard",
        "n_quote_loop_entry_reads_initial_char"
      ],
      "kind": "transition",
      "from": "quote_loop_entry",
      "at": "quote_loop_guard",
      "check": [
        "eq",
        "$quote_loop_entry.current_char",
        "$quote_loop_guard.current_char"
      ]
    }
  ]
}
