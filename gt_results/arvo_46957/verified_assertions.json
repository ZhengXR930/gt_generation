{
  "sample_id": "arvo_46957",
  "content_hash": "sha256:10621bd793cd62ecc315023682c297552e6d6a9595127f5f6b9597b3d7fd9092",
  "assertions": [
    {
      "id": "a_module_cur_pc_initialized_before_publish",
      "invariants": [
        "r_module_cur_pc_initialized_before_publish"
      ],
      "kind": "required",
      "at": "module_cur_pc_root",
      "check": [
        "ge",
        "$module_cur_pc_root.cur_pc_initialized_prefix_len",
        "$module_cur_pc_root.cur_pc_bytes"
      ],
      "protects": "module_frame_published"
    },
    {
      "id": "a_find_line_num_reads_uninitialized_pc_value",
      "invariants": [
        "n_find_line_num_reads_uninitialized_pc_value"
      ],
      "kind": "observed",
      "at": "find_line_num_sink",
      "check": [
        "gt",
        "$find_line_num_sink.pc_value_read_bytes",
        "$find_line_num_sink.pc_value_initialized_prefix_len"
      ]
    },
    {
      "id": "a_module_frame_slot_reaches_backtrace",
      "invariants": [
        "e_module_frame_slot_reaches_backtrace",
        "n_build_backtrace_uses_watched_module_cur_pc"
      ],
      "kind": "transition",
      "from": "module_frame_published",
      "at": "module_backtrace_cur_pc",
      "check": [
        "eq",
        "$module_frame_published.cur_pc_slot_addr",
        "$module_backtrace_cur_pc.cur_pc_slot_addr"
      ]
    },
    {
      "id": "a_backtrace_cur_pc_state_reaches_find_line_num",
      "invariants": [
        "e_backtrace_cur_pc_state_reaches_find_line_num"
      ],
      "kind": "transition",
      "from": "module_backtrace_cur_pc",
      "at": "find_line_num_sink",
      "check": [
        "eq",
        "$module_backtrace_cur_pc.cur_pc_initialized_prefix_len",
        "$find_line_num_sink.pc_value_initialized_prefix_len"
      ]
    }
  ]
}
