{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42526050",
  "content_hash": "sha256:461b8431cdeaafc52c4071e257624eb2a871cdd2d61ee086c6a6cfa2e55dfb17",
  "assertions": [
    {
      "id": "a_payload_total_size_covers_nflog_tlv_header",
      "invariants": [
        "r_payload_total_size_covers_nflog_tlv_header"
      ],
      "kind": "required",
      "at": "nflog_payload_extent",
      "check": [
        "ge",
        "$nflog_payload_extent.payload_total_size",
        "$nflog_payload_extent.tlv_header_size"
      ],
      "protects": "nflog_payload_extent"
    },
    {
      "id": "a_dns_data_length_read_past_packet_end",
      "invariants": [
        "n_dns_data_length_read_past_packet_end"
      ],
      "kind": "observed",
      "at": "dns_length_read",
      "check": [
        "gt",
        "$dns_length_read.read_end_offset",
        "$dns_length_read.packet_raw_length"
      ]
    },
    {
      "id": "a_underflowed_payload_len_reaches_ipv4_extent",
      "invariants": [
        "e_underflowed_payload_len_reaches_ipv4_extent"
      ],
      "kind": "transition",
      "from": "nflog_payload_extent",
      "at": "ipv4_payload_extent",
      "check": [
        "eq",
        "$nflog_payload_extent.payload_len_after_sub",
        "$ipv4_payload_extent.ipv4_layer_data_len"
      ]
    },
    {
      "id": "a_ipv4_payload_len_reaches_udp_extent",
      "invariants": [
        "e_ipv4_payload_len_reaches_udp_extent"
      ],
      "kind": "transition",
      "from": "ipv4_payload_extent",
      "at": "udp_dns_extent",
      "check": [
        "eq",
        "$ipv4_payload_extent.ipv4_payload_len",
        "$udp_dns_extent.udp_layer_data_len"
      ]
    },
    {
      "id": "a_udp_payload_len_reaches_dns_extent",
      "invariants": [
        "e_udp_payload_len_reaches_dns_extent"
      ],
      "kind": "transition",
      "from": "udp_dns_extent",
      "at": "dns_guard",
      "check": [
        "eq",
        "$udp_dns_extent.udp_payload_len",
        "$dns_guard.dns_layer_data_len"
      ]
    },
    {
      "id": "a_guarded_dns_read_reaches_sink",
      "invariants": [
        "e_guarded_dns_read_reaches_sink"
      ],
      "kind": "transition",
      "from": "dns_guard",
      "at": "dns_length_read",
      "check": [
        "eq",
        "$dns_guard.read_end_offset",
        "$dns_length_read.read_end_offset"
      ]
    },
    {
      "id": "a_dns_claimed_extent_exceeds_packet_bytes",
      "invariants": [
        "n_dns_claimed_extent_exceeds_packet_bytes"
      ],
      "kind": "observed",
      "at": "dns_guard",
      "check": [
        "gt",
        "$dns_guard.dns_layer_data_len",
        "$dns_guard.packet_dns_remaining"
      ]
    }
  ]
}
