      "at": "svcb_key_write",
      "check": [
        "eq",
        "$svcb_param_init.write_ptr_before",
        "$svcb_key_write.write_ptr_before"
      ]
    },
    {
      "id": "a_one_past_end_tail_reaches_zero_value_length_write",
      "invariants": [
        "e_one_past_end_tail_reaches_zero_value_length_write"
      ],
      "kind": "transition",
      "from": "svcb_key_write",
      "at": "svcb_empty_length_write",
      "check": [
        "eq",
        "$svcb_key_write.write_ptr_after_key",
        "$svcb_empty_length_write.write_ptr"
      ]
    }
  ]
