        "$svcb_param_init.header_end",
        "$svcb_param_init.buffer_end"
      ],
      "protects": "svcb_empty_length_write"
    },
    {
      "id": "a_key_write_advances_tail_to_rdata_end",
      "invariants": [
        "n_key_write_advances_tail_to_rdata_end"
      ],
      "kind": "observed",
      "at": "svcb_key_write",
      "check": [
        "eq",
        "$svcb_key_write.write_ptr_after_key",
        "$svcb_key_write.buffer_end"
      ]
    },
    {
      "id": "a_zero_value_length_write_overruns_rdata",
      "invariants": [
        "n_zero_value_length_write_overruns_rdata"
      ],
      "kind": "observed",
      "at": "svcb_empty_length_write",
      "check": [
