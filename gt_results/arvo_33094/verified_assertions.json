{
  "sample_id": "arvo_33094",
  "content_hash": "sha256:5aa84f4a7769f2d1be2f6de68d90dbe2a8fa4fb51eff0c4aecb8792ddd65bf69",
  "assertions": [
    {
      "id": "A-ROOT-INITEXPR-OPCODE-MUST-BE-ALLOWED",
      "invariants": [
        "R-INITEXPR-OPCODE-MUST-BE-ALLOWED"
      ],
      "kind": "required",
      "at": "dispatch_guard",
      "check": [
        "eq",
        "$dispatch_guard.allowed_initexpr_opcode",
        "$dispatch_guard.true_literal"
      ],
      "protects": "dispatch_call"
    },
    {
      "id": "A-PARSER-ONLY-DISPATCH-HAS-NULL-FUNCTION",
      "invariants": [
        "N-PARSER-ONLY-DISPATCH-HAS-NULL-FUNCTION"
      ],
      "kind": "observed",
      "at": "dispatch_guard",
      "check": [
        "eq",
        "$dispatch_guard.function_ptr",
        "$dispatch_guard.null_literal"
      ]
    },
    {
      "id": "A-IF-OPCODE-REACHES-COMPILEIF",
      "invariants": [
        "E-IF-OPCODE-REACHES-COMPILEIF",
        "N_EVENT_if_enter"
      ],
      "kind": "transition",
      "from": "dispatch_guard",
      "at": "if_enter",
      "check": [
        "eq",
        "$dispatch_guard.opcode",
        "$if_enter.opcode_argument"
      ]
    },
    {
      "id": "A-NESTED-ELSE-MARKER-REACHES-IF-ELSE-GUARD",
      "invariants": [
        "E-NESTED-ELSE-MARKER-REACHES-IF-ELSE-GUARD",
        "N_EVENT_nested_else_marker"
      ],
      "kind": "transition",
      "from": "nested_else_marker",
      "at": "if_else_guard",
      "check": [
        "eq",
        "$nested_else_marker.previous_opcode",
        "$if_else_guard.previous_opcode"
      ]
    },
    {
      "id": "A-IF-ELSE-GUARD-SEES-ELSE",
      "invariants": [
        "N-IF-ELSE-GUARD-SEES-ELSE"
      ],
      "kind": "observed",
      "at": "if_else_guard",
      "check": [
        "eq",
        "$if_else_guard.previous_opcode",
        "$if_else_guard.else_opcode_literal"
      ]
    },
    {
      "id": "A-RUNTIME-REACHES-PAGESOPEN-CALL",
      "invariants": [
        "E-RUNTIME-REACHES-PAGESOPEN-CALL"
      ],
      "kind": "transition",
      "from": "if_else_guard",
      "at": "pagesopen_call",
      "check": [
        "eq",
        "$if_else_guard.runtime_ptr",
        "$pagesopen_call.runtime_ptr"
      ]
    },
    {
      "id": "A-PAGESOPEN-CALL-USES-NULL-RUNTIME",
      "invariants": [
        "N-PAGESOPEN-CALL-USES-NULL-RUNTIME"
      ],
      "kind": "observed",
      "at": "pagesopen_call",
      "check": [
        "eq",
        "$pagesopen_call.runtime_ptr",
        "$pagesopen_call.null_literal"
      ]
    },
    {
      "id": "A-PAGESOPEN-ARG-REACHES-REMOVE-SINK",
      "invariants": [
        "E-PAGESOPEN-ARG-REACHES-REMOVE-SINK",
        "N-REMOVE-SINK-DEREFS-PAGESOPEN-ARG"
      ],
      "kind": "transition",
      "from": "pagesopen_call",
      "at": "remove_sink",
      "check": [
        "eq",
        "$pagesopen_call.pages_open_list_ptr",
        "$remove_sink.io_list_ptr"
      ]
    }
  ]
}
