{
  "sample_id": "arvo_16051",
  "content_hash": "sha256:7e3fc4c5d1001016ba1f7f18380dd4eabf04ea4d7d4b74ec10832671e1e8c505",
  "assertions": [
    {
      "id": "A-root-data-refreshed-after-chunk-read",
      "invariants": [
        "r_data_refreshed_after_chunk_read"
      ],
      "kind": "required",
      "at": "post_chunk_read",
      "check": [
        "eq",
        "$post_chunk_read.data_ptr",
        "$post_chunk_read.ctx_data_ptr"
      ],
      "protects": "splt_keyword_scan"
    },
    {
      "id": "A-read-data-realloc-moves-ctx-data",
      "invariants": [
        "n_realloc_moves_ctx_data"
      ],
      "kind": "observed",
      "at": "read_data_realloc",
      "check": [
        "ne",
        "$read_data_realloc.ctx_data_before",
        "$read_data_realloc.ctx_data_after"
      ]
    },
    {
      "id": "A-captured-data-aliases-realloc-old-buffer",
      "invariants": [
        "e_capture_aliases_realloc_old_buffer"
      ],
      "kind": "transition",
      "from": "capture_data",
      "at": "read_data_realloc",
      "check": [
        "eq",
        "$capture_data.data_ptr",
        "$read_data_realloc.ctx_data_before"
      ]
    },
    {
      "id": "A-stale-data-reaches-splt-memchr",
      "invariants": [
        "e_stale_data_reaches_splt_memchr",
        "n_splt_memchr_uses_local_data"
      ],
      "kind": "transition",
      "from": "post_chunk_read",
      "at": "splt_keyword_scan",
      "check": [
        "eq",
        "$post_chunk_read.data_ptr",
        "$splt_keyword_scan.data_ptr"
      ]
    }
  ]
}
