{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_30983",
  "content_hash": "sha256:3671a940338aa426a93102da51fe3bff084491eb19895c3951d17451381c133e",
  "assertions": [
    {
      "id": "A-ROOT-ZERO-INIT-BEFORE-REPARSE",
      "invariants": [
        "I-ROOT-ZERO-INIT-BEFORE-REPARSE"
      ],
      "kind": "required",
      "at": "decompress_alloc",
      "protects": "reparse_call",
      "check": [
        "ne",
        "$decompress_alloc.zero_init",
        "$decompress_alloc.zero_literal"
      ]
    },
    {
      "id": "A-SINK-READU16-PARTIAL-INIT",
      "invariants": [
        "I-SINK-READU16-PARTIAL-INIT"
      ],
      "kind": "observed",
      "at": "readu16_sink",
      "check": [
        "gt",
        "$readu16_sink.access_bytes",
        "$readu16_sink.initialized_prefix_len"
      ]
    },
    {
      "id": "A-ALLOC-TO-REPARSE",
      "invariants": [
        "E-ALLOC-TO-REPARSE"
      ],
      "kind": "transition",
      "from": "decompress_alloc",
      "at": "reparse_call",
      "check": [
        "eq",
        "$decompress_alloc.decompressed_ptr",
        "$reparse_call.parse_data"
      ]
    },
    {
      "id": "A-REPARSE-TO-SINK",
      "invariants": [
        "E-REPARSE-TO-SINK"
      ],
      "kind": "transition",
      "from": "reparse_call",
      "at": "readu16_sink",
      "check": [
        "eq",
        "$reparse_call.parse_data",
        "$readu16_sink.buffer_base"
      ]
    }
  ]
}
