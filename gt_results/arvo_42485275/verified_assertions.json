  "assertions": [
    {
      "id": "A-ROOT-CODEFENCE-NEEDS-THREE-BYTES-AFTER-SPACE-SKIP",
      "invariants": [
        "R-CODEFENCE-NEEDS-THREE-BYTES-AFTER-SPACE-SKIP"
      ],
      "kind": "required",
      "at": "codefence_guard",
      "check": [
        "gt",
        "$codefence_guard.slice_size",
        "$codefence_guard.index_plus_two"
      ],
      "protects": "codefence_read"
    },
    {
      "id": "A-SINK-CODEFENCE-READ-AT-SLICE-END",
      "invariants": [
        "N-CODEFENCE-READ-AT-SLICE-END"
      ],
      "kind": "observed",
      "at": "codefence_read",
      "check": [
        "eq",
        "$codefence_read.read_index",
        "$codefence_read.slice_size"
      ]
    },
    {
      "id": "A-LISTITEM-PROBE-POINTER-REACHES-CODEFENCE-READ",
      "invariants": [
        "E-LISTITEM-PROBE-POINTER-REACHES-CODEFENCE-READ"
      ],
      "kind": "transition",
      "from": "listitem_probe",
      "at": "codefence_read",
      "check": [
        "eq",
        "$listitem_probe.probe_ptr",
        "$codefence_read.slice_ptr"
      ]
    },
    {
      "id": "A-LISTITEM-PROBE-SHORTER-THAN-DEFINITION-LINE",
      "invariants": [
        "N-LISTITEM-PROBE-SHORTER-THAN-DEFINITION-LINE"
      ],
      "kind": "observed",
      "at": "listitem_probe",
      "check": [
        "lt",
        "$listitem_probe.probe_len",
        "$listitem_probe.listitem_len"
      ]
    }
  ]
}
