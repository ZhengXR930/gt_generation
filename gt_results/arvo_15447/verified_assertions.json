{
  "sample_id": "arvo_15447",
  "content_hash": "sha256:fefde2f0de3e509a89e1fbd5cbfd208569798e0760d4cf4e061960c1a4cf67cb",
  "assertions": [
    {
      "id": "A-ROOT-TARGET-TLV-LENGTH-RESET-BEFORE-REUSE",
      "invariants": [
        "I-ROOT-TARGET-TLV-LENGTH-RESET-BEFORE-REUSE"
      ],
      "kind": "required",
      "at": "target_tlv_reuse_root",
      "check": [
        "eq",
        "$target_tlv_reuse_root.target_length",
        "$target_tlv_reuse_root.fixed_length"
      ],
      "protects": "target_tlv_memcpy_sink"
    },
    {
      "id": "A-APPEND-TARGET-TLV-SERIALIZED-SIZE-EXCEEDS-OBJECT",
      "invariants": [
        "I-APPEND-TARGET-TLV-SERIALIZED-SIZE-EXCEEDS-OBJECT"
      ],
      "kind": "observed",
      "at": "target_tlv_append",
      "check": [
        "gt",
        "$target_tlv_append.append_size",
        "$target_tlv_append.fixed_size"
      ]
    },
    {
      "id": "A-TARGET-LENGTH-CARRIES-TO-APPEND",
      "invariants": [
        "I-TARGET-LENGTH-CARRIES-TO-APPEND"
      ],
      "kind": "transition",
      "from": "target_tlv_reuse_root",
      "at": "target_tlv_append",
      "check": [
        "eq",
        "$target_tlv_reuse_root.target_length",
        "$target_tlv_append.target_length"
      ]
    },
    {
      "id": "A-APPEND-SIZE-CARRIES-TO-WRITE",
      "invariants": [
        "I-APPEND-SIZE-CARRIES-TO-WRITE",
        "I-WRITE-RECEIVES-TARGET-TLV-COPY-REQUEST"
      ],
      "kind": "transition",
      "from": "target_tlv_append",
      "at": "target_tlv_memcpy_sink",
      "check": [
        "eq",
        "$target_tlv_append.append_size",
        "$target_tlv_memcpy_sink.copy_request_size"
      ]
    }
  ]
}
