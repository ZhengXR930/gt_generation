{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_23816",
  "content_hash": "sha256:6d7dda0ef5d8866ad85974361b3d03e29fd5867da66f17dc194b74af8a87559e",
  "assertions": [
    {
      "id": "A-ROOT-SCOPE-ID-GUARD-SATISFIED",
      "invariants": [
        "I-ROOT-SCOPE-ID-GUARD-SATISFIED"
      ],
      "kind": "required",
      "at": "scope_id_guard",
      "check": [
        "eq",
        "$scope_id_guard.scope_id_guard_satisfied",
        1
      ],
      "protects": "parsed_host_return"
    },
    {
      "id": "A-SINK-MEMCPY-LEN-EXCEEDS-TAIL-STORAGE",
      "invariants": [
        "I-SINK-MEMCPY-LEN-EXCEEDS-TAIL-STORAGE"
      ],
      "kind": "observed",
      "at": "memcpy_sink",
      "check": [
        "gt",
        "$memcpy_sink.copy_len",
        "$memcpy_sink.remaining_storage_bytes"
      ]
    },
    {
      "id": "A-REQUESTED-COPY-LEN-REACHES-MEMCPY",
      "invariants": [
        "I-REQUESTED-COPY-LEN-REACHES-MEMCPY"
      ],
      "kind": "transition",
      "from": "uri_encoder_tail",
      "at": "memcpy_sink",
      "check": [
        "eq",
        "$uri_encoder_tail.requested_copy_len",
        "$memcpy_sink.copy_len"
      ]
    },
    {
      "id": "A-PARSED-HOST-POINTER-REACHES-ENCODER",
      "invariants": [
        "I-PARSED-HOST-POINTER-REACHES-ENCODER"
      ],
      "kind": "transition",
      "from": "parsed_host_return",
      "at": "uri_encoder_tail",
      "check": [
        "eq",
        "$parsed_host_return.host_ptr",
        "$uri_encoder_tail.start_ptr"
      ]
    },
    {
      "id": "A-ENCODER-REQUEST-LEN-EXCEEDS-REMAINING-HOST-BYTES",
      "invariants": [
        "I-ENCODER-REQUEST-LEN-EXCEEDS-REMAINING-HOST-BYTES"
      ],
      "kind": "observed",
      "at": "uri_encoder_tail",
      "check": [
        "gt",
        "$uri_encoder_tail.requested_copy_len",
        "$uri_encoder_tail.remaining_input_bytes"
      ]
    }
  ]
}
