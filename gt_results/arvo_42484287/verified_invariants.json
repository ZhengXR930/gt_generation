      "verified": true,
      "verified_by": "a_rebound_buffer_ptr_reaches_cached_copy_sink",
      "fine_trace_step": 21,
      "description": "AddressSanitizer crash site. Disconnect-time IMAP response handling copies the cached 1025-byte tail into the closure handle's 1024-byte stack buffer, producing the recorded stack-buffer-overflow WRITE."
    }
