        "sizeof(buffer)"
      ],
      "relation": {
        "op": "le",
        "left": "conn->data->set.buffer_size + 1",
        "right": "sizeof(buffer)"
      },
      "verified": true,
      "verified_by": "a_closure_buffer_extent_satisfies_cached_replay_contract",
      "fine_trace_step": 17,
      "description": "Root cause. Connection-cache cleanup allocates the closure handle's temporary download buffer at only `READBUFFER_MIN` bytes even though curl's pingpong receive path can legally replay `set.buffer_size + 1` bytes into `state.buffer`."
    },
