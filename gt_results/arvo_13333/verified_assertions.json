{
  "sample_id": "arvo_13333",
  "content_hash": "sha256:d66b54c2da575460e0e87e81a6a0c9836e7a17ed6b093d5b43fe8dcb9c098ef4",
  "assertions": [
    {
      "id": "A-ROOT-PREFIX-BYTES-FIT-IP6-ADDRESS",
      "invariants": [
        "I-ROOT-PREFIX-BYTES-FIT-IP6-ADDRESS"
      ],
      "kind": "required",
      "at": "prefix_bound_check",
      "check": [
        "le",
        "$prefix_bound_check.prefix_bytes",
        "$prefix_bound_check.address_capacity"
      ],
      "protects": "prefix_compare_sink"
    },
    {
      "id": "A-PREFIX-BYTES-PERSIST-TO-STORED-PREFIX",
      "invariants": [
        "I-PREFIX-BYTES-PERSIST-TO-STORED-PREFIX",
        "N_EVENT_prefix_bound_check",
        "N_EVENT_stored_prefix"
      ],
      "kind": "transition",
      "from": "prefix_bound_check",
      "at": "stored_prefix",
      "check": [
        "eq",
        "$prefix_bound_check.prefix_bytes",
        "$stored_prefix.stored_prefix_bytes"
      ]
    },
    {
      "id": "A-STORED-PREFIX-BYTES-FLOW-TO-COMPARE-SINK",
      "invariants": [
        "I-STORED-PREFIX-BYTES-FLOW-TO-COMPARE-SINK"
      ],
      "kind": "transition",
      "from": "stored_prefix",
      "at": "prefix_compare_sink",
      "check": [
        "eq",
        "$stored_prefix.stored_prefix_bytes",
        "$prefix_compare_sink.compare_bytes"
      ]
    },
    {
      "id": "A-SINK-COMPARE-BYTES-EXCEED-DESTINATION-CAPACITY",
      "invariants": [
        "I-SINK-COMPARE-BYTES-EXCEED-DESTINATION-CAPACITY"
      ],
      "kind": "observed",
      "at": "prefix_compare_sink",
      "check": [
        "gt",
        "$prefix_compare_sink.compare_bytes",
        "$prefix_compare_sink.destination_capacity"
      ]
    }
  ]
}
