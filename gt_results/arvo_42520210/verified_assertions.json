{
  "sample_id": "arvo_42520210",
  "content_hash": "sha256:4d86e75d50ca832a2fc78605b57b4c08dc292a0f1922146d0486516ef3a5580c",
  "assertions": [
    {
      "id": "a_cached_stab_scratch_must_fit_two_addresses",
      "invariants": [
        "r_cached_stab_scratch_must_fit_two_addresses"
      ],
      "kind": "required",
      "at": "cached_stab_guard",
      "check": [
        "le",
        "$cached_stab_guard.bytes_needed",
        "$cached_stab_guard.scratch_bytes"
      ],
      "protects": "second_cached_stab_read"
    },
    {
      "id": "a_superblock_end_reaches_second_cached_stab_decode",
      "invariants": [
        "e_superblock_end_reaches_second_cached_stab_decode",
        "n_second_cached_stab_decode_starts_at_superblock_end"
      ],
      "kind": "transition",
      "from": "superblock_bounds",
      "at": "cached_stab_second_decode",
      "check": [
        "eq",
        "$superblock_bounds.superblock_end_ptr",
        "$cached_stab_second_decode.second_decode_ptr"
      ]
    },
    {
      "id": "a_second_cached_stab_decode_ptr_reaches_addr_read",
      "invariants": [
        "e_second_cached_stab_decode_ptr_reaches_addr_read",
        "n_second_cached_stab_addr_read_sink"
      ],
      "kind": "transition",
      "from": "cached_stab_second_decode",
      "at": "second_cached_stab_read",
      "check": [
        "eq",
        "$cached_stab_second_decode.second_decode_ptr",
        "$second_cached_stab_read.read_ptr"
      ]
    }
  ]
}
