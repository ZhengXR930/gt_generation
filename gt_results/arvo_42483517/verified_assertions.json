  "assertions": [
    {
      "id": "A-ROOT-OCTAL-CONTINUATION-INDEX-WITHIN-ESCAPE-SUFFIX",
      "invariants": [
        "R-OCTAL-CONTINUATION-INDEX-WITHIN-ESCAPE-SUFFIX"
      ],
      "kind": "required",
      "at": "octal_bound_check",
      "check": [
        "gt",
        "$escape_dispatch.escape_suffix_len",
        "$octal_bound_check.octal_index"
      ],
      "protects": "octal_sink_read"
    },
    {
      "id": "A-SINK-OCTAL-CONTINUATION-READ-HITS-SUFFIX-END",
      "invariants": [
        "N-SINK-OCTAL-CONTINUATION-READ-HITS-SUFFIX-END"
      ],
      "kind": "observed",
      "at": "octal_sink_read",
      "check": [
        "eq",
        "$escape_dispatch.escape_end_ptr",
        "$octal_sink_read.probe_ptr"
      ]
    },
    {
      "id": "A-ESCAPE-SUFFIX-PTR-FLOWS-TO-OCTAL-HELPER",
      "invariants": [
        "E-ESCAPE-SUFFIX-PTR-FLOWS-TO-OCTAL-HELPER"
      ],
      "kind": "transition",
      "from": "escape_dispatch",
      "at": "octal_bound_check",
      "check": [
        "eq",
        "$escape_dispatch.escape_suffix_ptr",
        "$octal_bound_check.escape_str_ptr"
      ]
    },
    {
      "id": "A-OCTAL-PROBE-PTR-FLOWS-TO-SINK-READ",
      "invariants": [
        "E-OCTAL-PROBE-PTR-FLOWS-TO-SINK-READ"
      ],
      "kind": "transition",
      "from": "octal_bound_check",
      "at": "octal_sink_read",
      "check": [
        "eq",
        "$octal_bound_check.probe_ptr",
        "$octal_sink_read.probe_ptr"
      ]
    }
  ]
}
