{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_54319",
  "content_hash": "sha256:c5987495df2c293836d73ec033c2f27a6e83931a74bcf48b2d7e186e8dbbb7e7",
  "assertions": [
    {
      "id": "a_compare_handler_requires_equal_name_lengths",
      "invariants": [
        "r_compare_handler_requires_equal_name_lengths"
      ],
      "kind": "required",
      "at": "compare_handler_guard",
      "check": [
        "eq",
        "$compare_handler_guard.stored_name_len",
        "$compare_handler_guard.incoming_name_len"
      ],
      "protects": "compare_handler_sink"
    },
    {
      "id": "a_compare_handler_memcmp_reads_past_initialized_prefix",
      "invariants": [
        "n_compare_handler_memcmp_reads_past_initialized_prefix"
      ],
      "kind": "observed",
      "at": "compare_handler_sink",
      "check": [
        "gt",
        "$compare_handler_sink.cmp_bytes",
        "$compare_handler_sink.stored_name_initialized_prefix_len"
      ]
    },
    {
      "id": "a_length_mismatch_reaches_memcmp_count",
      "invariants": [
        "e_length_mismatch_reaches_memcmp_count"
      ],
      "kind": "transition",
      "from": "compare_handler_guard",
      "at": "compare_handler_sink",
      "check": [
        "eq",
        "$compare_handler_guard.incoming_name_len",
        "$compare_handler_sink.cmp_bytes"
      ]
    },
    {
      "id": "a_supported_shortname_store_leaves_uninitialized_tail",
      "invariants": [
        "n_supported_shortname_store_leaves_uninitialized_tail"
      ],
      "kind": "observed",
      "at": "supported_shortname_store",
      "check": [
        "lt",
        "$supported_shortname_store.stored_name_initialized_prefix_len",
        "$supported_shortname_store.stored_name_buffer_bytes"
      ]
    },
    {
      "id": "a_supported_shortname_hash_reaches_compare_handler",
      "invariants": [
        "e_supported_shortname_hash_reaches_compare_handler"
      ],
      "kind": "transition",
      "from": "supported_shortname_store",
      "at": "compare_handler_guard",
      "check": [
        "eq",
        "$supported_shortname_store.stored_name_hash",
        "$compare_handler_guard.stored_name_hash"
      ]
    }
  ]
}
