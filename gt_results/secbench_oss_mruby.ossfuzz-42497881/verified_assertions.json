{
  "sample_id": "secbench_oss_mruby.ossfuzz-42497881",
  "content_hash": "sha256:282fb6f81687f7da6546fc486fa37dab779cb4a3c8c92e13f16d98d9d48ba0b0",
  "assertions": [
    {
      "id": "a_precision_value_must_fit_int",
      "invariants": [
        "r_precision_value_must_fit_int"
      ],
      "kind": "required",
      "at": "precision_narrowing_root",
      "check": [
        "le",
        "$precision_narrowing_root.next_n_before_cast",
        "$precision_narrowing_root.int_max"
      ],
      "protects": "final_push_sink"
    },
    {
      "id": "a_negative_precision_materialized",
      "invariants": [
        "n_negative_precision_materialized"
      ],
      "kind": "observed",
      "at": "precision_materialized",
      "check": [
        "lt",
        "$precision_materialized.prec_after_getnum",
        "$precision_materialized.zero_literal"
      ]
    },
    {
      "id": "a_negative_copy_len_materialized",
      "invariants": [
        "n_negative_copy_len_materialized"
      ],
      "kind": "observed",
      "at": "precision_to_len",
      "check": [
        "lt",
        "$precision_to_len.len_after_precision",
        "$precision_to_len.zero_literal"
      ]
    },
    {
      "id": "a_negative_push_len_at_sink",
      "invariants": [
        "n_negative_push_len_sink"
      ],
      "kind": "observed",
      "at": "final_push_sink",
      "check": [
        "lt",
        "$final_push_sink.copy_len",
        "$final_push_sink.zero_literal"
      ]
    },
    {
      "id": "a_narrowed_precision_reaches_caller",
      "invariants": [
        "e_narrowed_precision_reaches_caller"
      ],
      "kind": "transition",
      "from": "precision_narrowing_root",
      "at": "precision_materialized",
      "check": [
        "eq",
        "$precision_narrowing_root.narrowed_precision",
        "$precision_materialized.prec_after_getnum"
      ]
    },
    {
      "id": "a_precision_reaches_copy_len",
      "invariants": [
        "e_precision_reaches_copy_len"
      ],
      "kind": "transition",
      "from": "precision_materialized",
      "at": "precision_to_len",
      "check": [
        "eq",
        "$precision_materialized.prec_after_getnum",
        "$precision_to_len.len_after_precision"
      ]
    },
    {
      "id": "a_copy_len_reaches_push",
      "invariants": [
        "e_copy_len_reaches_push"
      ],
      "kind": "transition",
      "from": "precision_to_len",
      "at": "final_push_sink",
      "check": [
        "eq",
        "$precision_to_len.len_after_precision",
        "$final_push_sink.copy_len"
      ]
    }
  ]
}
