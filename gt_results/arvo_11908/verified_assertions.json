  "content_hash": "sha256:17bcf854b9e16300b12339ea00bcd763c42bc198f831aaa6edf21d002bb77edc",
  "assertions": [
    {
      "id": "a_root_bsearch_key_uses_st_object_address",
      "invariants": [
        "r_bsearch_key_must_address_st_object"
      ],
      "kind": "required",
      "at": "bsearch_key",
      "protects": "cmp_len_read",
      "check": [
        "eq",
        "$bsearch_key.pk_arg",
        "$bsearch_key.st_object_addr"
      ]
    },
    {
      "id": "a_bsearch_key_flows_to_cmp_key",
      "invariants": [
        "e_bsearch_key_to_cmp_key",
        "n_cmp_key_reinterprets_search_key"
      ],
      "kind": "transition",
      "from": "bsearch_key",
      "at": "cmp_key_cast",
      "check": [
        "eq",
        "$bsearch_key.pk_arg",
        "$cmp_key_cast.pk"
      ]
    },
    {
      "id": "a_cmp_key_reaches_len_read",
      "invariants": [
        "e_cmp_key_to_cmp_len_read",
        "n_cmp_len_reads_forged_key"
      ],
      "kind": "transition",
      "from": "cmp_key_cast",
      "at": "cmp_len_read",
      "check": [
        "eq",
        "$cmp_key_cast.pk",
        "$cmp_len_read.a_object_addr"
      ]
    }
  ]
}
