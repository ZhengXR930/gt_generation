{
  "sample_id": "arvo_26682",
  "content_hash": "sha256:0045f4c405b03dc1a0cf275c2d4aff93673ef6c1a6662ee32665c7e85a18f96c",
  "assertions": [
    {
      "id": "A-ROOT",
      "invariants": [
        "I-ROOT-OBLIGATION"
      ],
      "kind": "required",
      "at": "nonwrapping_guard",
      "check": [
        "gt",
        "$nonwrapping_guard.dist_from_out_buf_start",
        0
      ],
      "protects": "backref_copy"
    },
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK-ADLER32-READS-UNINITIALIZED-PREFIX"
      ],
      "kind": "observed",
      "at": "adler32_scan",
      "check": [
        "gt",
        "$adler32_scan.buf_len",
        "$adler32_scan.initialized_prefix_len"
      ]
    },
    {
      "id": "A-GUARD-TO-COPY",
      "invariants": [
        "I-GUARD-STATE-REACHES-BACKREF-COPY"
      ],
      "kind": "transition",
      "from": "nonwrapping_guard",
      "at": "backref_copy",
      "check": [
        "eq",
        "$nonwrapping_guard.dist_from_out_buf_start",
        "$backref_copy.prior_output_len"
      ]
    },
    {
      "id": "A-COPY-TO-SINK",
      "invariants": [
        "I-OUTPUT-BASE-REACHES-ADLER32-SCAN"
      ],
      "kind": "transition",
      "from": "backref_copy",
      "at": "adler32_scan",
      "check": [
        "eq",
        "$backref_copy.output_base",
        "$adler32_scan.buf_base"
      ]
    },
    {
      "id": "A-COPY",
      "invariants": [
        "I-BACKREF-COPY-USES-OUTPUT-BASE"
      ],
      "kind": "observed",
      "at": "backref_copy",
      "check": [
        "eq",
        "$backref_copy.copy_src",
        "$backref_copy.output_base"
      ]
    }
  ]
}
