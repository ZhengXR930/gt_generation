{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_11408",
  "content_hash": "sha256:e7ae69916018db55d0d536abb795aab732ec1af8246747d1eff2069209b30ce5",
  "assertions": [
    {
      "id": "a_match_flow_must_not_be_freed_twice",
      "invariants": [
        "r_match_flow_must_not_repeat_destroy"
      ],
      "kind": "required",
      "at": "match_flow_free",
      "check": [
        "ne",
        "$match_flow_free.current_flow_ptr",
        "$match_flow_free.previous_flow_ptr"
      ],
      "protects": "match_flow_free"
    },
    {
      "id": "a_first_freed_match_flow_reaches_caller_cleanup",
      "invariants": [
        "e_first_free_ptr_reaches_caller_cleanup"
      ],
      "kind": "transition",
      "from": "match_flow_free",
      "at": "caller_match_destroy",
      "check": [
        "eq",
        "$match_flow_free.current_flow_ptr",
        "$caller_match_destroy.fm_match_flow_ptr"
      ]
    },
    {
      "id": "a_caller_cleanup_ptr_reaches_free_sink",
      "invariants": [
        "e_caller_cleanup_ptr_reaches_free_sink"
      ],
      "kind": "transition",
      "from": "caller_match_destroy",
      "at": "match_flow_free",
      "check": [
        "eq",
        "$caller_match_destroy.fm_match_flow_ptr",
        "$match_flow_free.current_flow_ptr"
      ]
    }
  ]
}
