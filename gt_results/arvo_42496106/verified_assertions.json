  "assertions": [
    {
      "id": "a_row_sync_row_count_change_must_clear_stale_row_sync",
      "invariants": [
        "r_row_sync_row_count_change_must_clear_stale_row_sync"
      ],
      "kind": "required",
      "at": "row_sync_row_change_guard",
      "check": [
        "eq",
        "$row_sync_row_change_guard.row_sync_ptr_after_guard",
        "$row_sync_row_change_guard.null_literal"
      ],
      "protects": "row_sync_row_change_guard"
    },
    {
      "id": "a_sink_row_exceeds_prior_row_sync_rows",
      "invariants": [
        "n_sink_row_exceeds_prior_row_sync_rows"
      ],
      "kind": "observed",
      "at": "row_sync_sink",
      "check": [
        "le",
        "$row_sync_row_change_guard.allocated_mi_rows_before",
        "$row_sync_sink.row"
      ]
    },
    {
      "id": "a_stale_row_sync_ptr_reaches_sink",
      "invariants": [
        "e_stale_row_sync_ptr_reaches_sink"
      ],
      "kind": "transition",
      "from": "row_sync_row_change_guard",
      "at": "row_sync_sink",
      "check": [
        "eq",
        "$row_sync_row_change_guard.row_sync_ptr_after_guard",
        "$row_sync_sink.row_sync_ptr"
      ]
    },
    {
      "id": "a_later_num_mi_rows_reaches_scheduler_bound",
      "invariants": [
        "e_later_num_mi_rows_reaches_scheduler_bound"
      ],
      "kind": "transition",
      "from": "row_sync_row_change_guard",
      "at": "row_job_dispatch",
      "check": [
        "eq",
        "$row_sync_row_change_guard.num_mi_rows",
        "$row_job_dispatch.nvfb"
      ]
    },
    {
      "id": "a_dispatched_row_reaches_sink",
      "invariants": [
        "e_dispatched_row_reaches_sink",
        "N_EVENT_row_job_dispatch"
      ],
      "kind": "transition",
      "from": "row_job_dispatch",
      "at": "row_sync_sink",
      "check": [
        "eq",
        "$row_job_dispatch.cur_fbr",
        "$row_sync_sink.row"
      ]
    }
  ]
