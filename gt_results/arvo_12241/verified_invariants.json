      "relation": {
        "op": "eq",
        "left": "NULL",
        "right": "static_array[i].values.arrayZ_"
      },
      "verified": true,
      "verified_by": "a_copied_fontdict_slot_must_not_own_nested_heap",
      "fine_trace_step": 6,
      "description": "Unsafe ownership duplication. When `fontDicts` grows out of inline storage, `alloc()` copies the existing inline `CFF1FontDictValues` objects byte-for-byte from `static_array` into a heap buffer. For these non-trivial objects that already own nested `hb_vector_t<OpStr>` allocations, the raw `memcpy` duplicates the inner `arrayZ_` pointers without destroying or clearing the original inline owners."
    },
    {
      "invariant_id": "e_heap_copy_ptr_reaches_cleanup_free",
