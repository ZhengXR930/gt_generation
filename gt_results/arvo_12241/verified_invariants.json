      ],
      "relation": {
        "op": "eq",
        "left": "arrayZ_",
        "right": "new_array[i].values.arrayZ_"
      },
      "verified": true,
      "verified_by": "a_heap_copy_ptr_reaches_cleanup_free",
      "fine_trace_step": 8,
      "description": "ASan crash site. A stale inline copy of a `CFF1FontDictValues` object's nested `hb_vector_t<OpStr>` reaches `fini()` during accelerator destruction and frees `arrayZ_` even though the same heap buffer was already freed from the heap copy during earlier cleanup."
    }
