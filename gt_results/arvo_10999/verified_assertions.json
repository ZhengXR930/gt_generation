{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_10999",
  "content_hash": "sha256:001f4313117e0af900765fee40d58005ee7dba2c8fc1a3f5cbc2967b23160f82",
  "assertions": [
    {
      "id": "a_separator_search_is_length_bounded",
      "invariants": [
        "r_separator_search_must_use_bounded_span"
      ],
      "kind": "required",
      "at": "separator_search",
      "check": [
        "eq",
        "$separator_search.search_is_bounded",
        1
      ],
      "protects": "separator_search"
    },
    {
      "id": "a_separator_search_starts_on_last_inbounds_byte",
      "invariants": [
        "n_separator_search_enters_with_single_byte_span"
      ],
      "kind": "observed",
      "at": "separator_search",
      "check": [
        "eq",
        "$separator_search.buffer_plus_one",
        "$separator_search.buffer_end_ptr"
      ]
    },
    {
      "id": "a_tagger_buffer_reaches_separator_search",
      "invariants": [
        "e_tagger_buffer_reaches_separator_search"
      ],
      "kind": "transition",
      "from": "after_tagger_parse",
      "at": "separator_search",
      "check": [
        "eq",
        "$after_tagger_parse.buffer_ptr",
        "$separator_search.buffer_ptr"
      ]
    },
    {
      "id": "a_tagger_parse_leaves_single_byte_span",
      "invariants": [
        "n_after_tagger_parse_leaves_single_byte_span"
      ],
      "kind": "observed",
      "at": "after_tagger_parse",
      "check": [
        "eq",
        "$after_tagger_parse.buffer_plus_one",
        "$after_tagger_parse.buffer_end_ptr"
      ]
    }
  ]
}
