{
  "sample_id": "arvo_34386",
  "content_hash": "sha256:8ee8aa2bc193610b3c3f3c0d448961603b65911d8da724774624ec3c8d3d0618",
  "assertions": [
    {
      "id": "a_root_expand_path_must_remain_literal",
      "invariants": [
        "r_literal_filepath_before_expand"
      ],
      "kind": "required",
      "at": "expand_path_sink",
      "check": [
        "eq",
        "$expand_path_sink.lookup_path_hex",
        "$expand_path_sink.filepath_hex"
      ],
      "protects": "expand_path_sink"
    },
    {
      "id": "a_sink_expand_path_uses_nonliteral_lookup_path",
      "invariants": [
        "n_expand_sink_uses_nonliteral_lookup_path"
      ],
      "kind": "observed",
      "at": "expand_path_sink",
      "check": [
        "ne",
        "$expand_path_sink.lookup_path_hex",
        "$expand_path_sink.filepath_hex"
      ]
    },
    {
      "id": "a_findfile_candidate_reaches_expand_sink",
      "invariants": [
        "e_findfile_candidate_reaches_expand_sink",
        "N_EVENT_findfile_candidate"
      ],
      "kind": "transition",
      "from": "findfile_candidate",
      "at": "expand_path_sink",
      "check": [
        "eq",
        "$findfile_candidate.candidate_path_hex",
        "$expand_path_sink.filepath_hex"
      ]
    },
    {
      "id": "a_decoded_uri_reaches_findfile_candidate",
      "invariants": [
        "e_decoded_uri_reaches_findfile_candidate"
      ],
      "kind": "transition",
      "from": "parse_external_uri",
      "at": "findfile_candidate",
      "check": [
        "eq",
        "$parse_external_uri.decoded_uri_hex",
        "$findfile_candidate.candidate_path_hex"
      ]
    },
    {
      "id": "a_external_file_branch_selected",
      "invariants": [
        "n_external_file_branch_selected"
      ],
      "kind": "observed",
      "at": "parse_external_uri",
      "check": [
        "eq",
        "$parse_external_uri.is_data_uri",
        "$parse_external_uri.zero_literal"
      ]
    },
    {
      "id": "a_uri_decode_transforms_uri",
      "invariants": [
        "n_uri_decode_transforms_uri"
      ],
      "kind": "observed",
      "at": "parse_external_uri",
      "check": [
        "ne",
        "$parse_external_uri.decoded_uri_hex",
        "$parse_external_uri.uri_hex"
      ]
    }
  ]
}
