{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_10136",
  "content_hash": "sha256:d6768b220f59d1ca8ffc2e34bfbe61a0a0d6a6ea6823194f124fafc0b3c749bf",
  "assertions": [
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK"
      ],
      "kind": "observed",
      "at": "oid_dispatch",
      "check": [
        "gt",
        "$oid_dispatch.cmp_bytes",
        "$oid_dispatch.oid_bytes_written"
      ]
    },
    {
      "id": "A-DECL-TO-READ",
      "invariants": [
        "I-ROOT-OBLIGATION",
        "I-DECL-TO-READ"
      ],
      "kind": "transition",
      "from": "oid_decl",
      "at": "oid_read",
      "check": [
        "gt",
        "$oid_decl.sizeof_oid",
        "$oid_read.oid_bytes_written"
      ]
    },
    {
      "id": "A-READ-TO-DISPATCH",
      "invariants": [
        "I-READ-TO-DISPATCH"
      ],
      "kind": "transition",
      "from": "oid_read",
      "at": "oid_dispatch",
      "check": [
        "eq",
        "$oid_read.oid_ptr",
        "$oid_dispatch.oid_ptr"
      ]
    }
  ]
}
