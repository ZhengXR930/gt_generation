{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_10136",
  "content_hash": "sha256:ebf4bfbc7db7e20a19bb77a4920425db9f802cb49a94b3022bca56dca8277f97",
  "assertions": [
    {
      "id": "A-ROOT",
      "invariants": [
        "I-ROOT-OBLIGATION"
      ],
      "kind": "required",
      "at": "oid_decl",
      "check": [
        "eq",
        "$oid_decl.zero_init",
        1
      ],
      "protects": "oid_strcmp"
    },
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK"
      ],
      "kind": "observed",
      "at": "oid_strcmp",
      "check": [
        "gt",
        "$oid_strcmp.cmp_bytes",
        "$oid_strcmp.oid_bytes_written"
      ]
    },
    {
      "id": "A-DECL-TO-READ",
      "invariants": [
        "I-DECL-TO-READ"
      ],
      "kind": "transition",
      "from": "oid_decl",
      "at": "oid_read",
      "check": [
        "gt",
        "$oid_decl.sizeof_oid",
        "$oid_read.oid_bytes_written"
      ]
    },
    {
      "id": "A-READ-TO-SINK",
      "invariants": [
        "I-READ-TO-SINK"
      ],
      "kind": "transition",
      "from": "oid_read",
      "at": "oid_strcmp",
      "check": [
        "eq",
        "$oid_read.oid_ptr",
        "$oid_strcmp.oid_ptr"
      ]
    }
  ]
}
