{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_10136",
  "content_hash": "sha256:8ac7d5328b94ff8f1d496ee31b9177b05c5b0d790b7b1f890d9363be9700cc78",
  "assertions": [
    {
      "id": "A-ROOT",
      "invariants": [
        "I-ROOT-OBLIGATION"
      ],
      "kind": "required",
      "at": "oid_decl",
      "check": [
        "eq",
        "$oid_decl.zero_init",
        1
      ],
      "protects": "oid_dispatch"
    },
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK"
      ],
      "kind": "observed",
      "at": "oid_dispatch",
      "check": [
        "gt",
        "$oid_dispatch.cmp_bytes",
        "$oid_dispatch.oid_bytes_written"
      ]
    },
    {
      "id": "A-DECL-TO-READ",
      "invariants": [
        "I-ROOT-OBLIGATION",
        "I-DECL-TO-READ"
      ],
      "kind": "transition",
      "from": "oid_decl",
      "at": "oid_read",
      "check": [
        "gt",
        "$oid_decl.sizeof_oid",
        "$oid_read.oid_bytes_written"
      ]
    },
    {
      "id": "A-READ-TO-DISPATCH",
      "invariants": [
        "I-READ-TO-DISPATCH"
      ],
      "kind": "transition",
      "from": "oid_read",
      "at": "oid_dispatch",
      "check": [
        "eq",
        "$oid_read.oid_ptr",
        "$oid_dispatch.oid_ptr"
      ]
    }
  ]
}
