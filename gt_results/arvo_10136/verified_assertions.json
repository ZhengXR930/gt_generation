{
  "sample_id": "arvo_10136",
  "content_hash": "sha256:0c806725dd71dbd89d972e4e2110d6fa9683b71f1760c6792be7fd35c11bee5e",
  "assertions": [
    {
      "id": "A-ROOT",
      "invariants": [
        "I-ROOT-OBLIGATION"
      ],
      "kind": "required",
      "at": "oid_decl",
      "check": [
        "eq",
        "$oid_decl.zero_init",
        1
      ],
      "protects": "oid_dispatch"
    },
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK"
      ],
      "kind": "observed",
      "at": "oid_dispatch",
      "check": [
        "gt",
        "$oid_dispatch.cmp_bytes",
        "$oid_dispatch.oid_bytes_written"
      ]
    },
    {
      "id": "A-DECL-TO-READ",
      "invariants": [
        "I-ROOT-OBLIGATION",
        "I-DECL-TO-READ",
        "N_EVENT_oid_read"
      ],
      "kind": "transition",
      "from": "oid_decl",
      "at": "oid_read",
      "check": [
        "gt",
        "$oid_decl.sizeof_oid",
        "$oid_read.oid_bytes_written"
      ]
    },
    {
      "id": "A-READ-TO-DISPATCH",
      "invariants": [
        "I-READ-TO-DISPATCH"
      ],
      "kind": "transition",
      "from": "oid_read",
      "at": "oid_dispatch",
      "check": [
        "eq",
        "$oid_read.oid_ptr",
        "$oid_dispatch.oid_ptr"
      ]
    }
  ]
}
