{
  "sample_id": "arvo_13466",
  "content_hash": "sha256:0b683a2c4953dd9fb300bfe1c4120fea2451f6d915e6dbe2f23f01ca06d17737",
  "assertions": [
    {
      "id": "A-ROOT-X86OPSIZE-BYTE-INITIALIZED",
      "invariants": [
        "I-ROOT-X86OPSIZE-BYTE-INITIALIZED"
      ],
      "kind": "required",
      "at": "bndstx_memsize_root",
      "check": [
        "ge",
        "$bndstx_memsize_root.x86opsize_initialized_prefix_len",
        "$bndstx_memsize_root.x86opsize_read_bytes"
      ],
      "protects": "op1_size_sink"
    },
    {
      "id": "A-SINK-READS-UNINITIALIZED-OP1-SIZE",
      "invariants": [
        "I-SINK-READS-UNINITIALIZED-OP1_SIZE"
      ],
      "kind": "observed",
      "at": "op1_size_sink",
      "check": [
        "lt",
        "$op1_size_sink.op1_size_initialized_prefix_len",
        "$op1_size_sink.op1_size_read_bytes"
      ]
    },
    {
      "id": "A-OP1-SIZE-FIELD-REACHES-SINK",
      "invariants": [
        "I-OP1_SIZE-FIELD-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "op1_size_copy",
      "at": "op1_size_sink",
      "check": [
        "eq",
        "$op1_size_copy.op1_size_field_addr",
        "$op1_size_sink.op1_size_field_addr"
      ]
    },
    {
      "id": "A-ROOT-FIELD-REACHES-COPY",
      "invariants": [
        "I-ROOT-FIELD-REACHES-COPY"
      ],
      "kind": "transition",
      "from": "bndstx_memsize_root",
      "at": "op1_size_copy",
      "check": [
        "eq",
        "$bndstx_memsize_root.x86opsize_field_addr",
        "$op1_size_copy.x86opsize_field_addr"
      ]
    },
    {
      "id": "A-COPY-STORES-UNINITIALIZED-OP1-SIZE",
      "invariants": [
        "I-COPY-STORES-UNINITIALIZED-OP1_SIZE"
      ],
      "kind": "observed",
      "at": "op1_size_copy",
      "check": [
        "lt",
        "$op1_size_copy.op1_size_initialized_prefix_len",
        "$op1_size_copy.op1_size_store_bytes"
      ]
    }
  ]
}
