{
  "sample_id": "osv_ossfuzz_OSV-2026-195",
  "content_hash": "sha256:ba34452527fce6dc131288fe0400b5169cc7c818d07db33f3cff37e1c4e37b9b",
  "assertions": [
    {
      "id": "required.structured_field_index_within_fixed_storage",
      "invariants": [
        "root.structured_field_index_within_fixed_storage"
      ],
      "kind": "required",
      "at": "structured_field_append",
      "protects": "structured_field_read",
      "check": [
        "lt",
        "$structured_field_append.field_index_before_store",
        "$structured_field_append.max_structured_fields"
      ]
    },
    {
      "id": "transition.structured_object_reaches_destructor",
      "invariants": [
        "edge.structured_object_reaches_destructor",
        "N_EVENT_parameter_structured_unref"
      ],
      "kind": "transition",
      "from": "parameter_structured_unref",
      "at": "structured_field_read",
      "check": [
        "eq",
        "$parameter_structured_unref.structured_object_arg",
        "$structured_field_read.structured_object"
      ]
    },
    {
      "id": "observed.destructor_reads_beyond_fixed_field_storage",
      "invariants": [
        "node.destructor_reads_beyond_fixed_field_storage"
      ],
      "kind": "observed",
      "at": "structured_field_read",
      "check": [
        "gt",
        "$structured_field_read.num_fields",
        "$structured_field_read.max_structured_fields"
      ]
    }
  ]
}
