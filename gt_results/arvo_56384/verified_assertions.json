  "sample_id": "arvo_56384",
  "content_hash": "sha256:6e01893b1e678db6c1b9c9f0501ec565aa45ffb836e68096778b3f21850039f3",
  "assertions": [
    {
      "id": "A-ROOT-IDENTIFIER-LENGTH-NONNEGATIVE",
      "invariants": [
        "I-ROOT-IDENTIFIER-LENGTH-NONNEGATIVE"
      ],
      "kind": "required",
      "at": "identifier_guard",
      "check": [
        "ge",
        "$identifier_guard.length",
        0
      ],
      "protects": "cursor_rewind"
    },
    {
      "id": "A-CURSOR-REWIND-MOVES-BACKWARD",
      "invariants": [
        "I-CURSOR-REWIND-MOVES-BACKWARD"
      ],
      "kind": "observed",
      "at": "cursor_rewind",
      "check": [
        "lt",
        "$cursor_rewind.cursor_after",
        "$cursor_rewind.cursor_before"
      ]
    },
    {
      "id": "A-GUARD-LENGTH-FLOWS-TO-REWIND",
      "invariants": [
        "I-GUARD-LENGTH-FLOWS-TO-REWIND"
      ],
      "kind": "transition",
      "from": "identifier_guard",
      "at": "cursor_rewind",
      "check": [
        "eq",
        "$identifier_guard.length",
        "$cursor_rewind.length"
      ]
    },
    {
      "id": "A-REWOUND-CURSOR-REACHES-ABI-TAG-PROBE",
      "invariants": [
        "I-REWOUND-CURSOR-REACHES-ABI-TAG-PROBE",
        "I-SINK-ABI-TAG-PROBE-USES-REWOUND-CURSOR"
      ],
      "kind": "transition",
      "from": "cursor_rewind",
      "at": "abi_tag_probe",
      "check": [
        "eq",
        "$cursor_rewind.cursor_after",
        "$abi_tag_probe.probe_cursor"
      ]
    }
  ]
}
