{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42485333",
  "content_hash": "sha256:bc862215c0308b6ab65c256395d6e4657c880033bb28cda2a4241cd147c4fd68",
  "assertions": [
    {
      "id": "A-root-zone-marker-requires-pct25",
      "invariants": [
        "I-ROOT-ZONE-MARKER-REQUIRES-PCT25"
      ],
      "kind": "required",
      "at": "zone_check",
      "check": [
        "eq",
        "$zone_check.zone_id_prefix_valid",
        1
      ],
      "protects": "host_emit"
    },
    {
      "id": "A-encoder-tail-request-exceeds-remaining-bytes",
      "invariants": [
        "I-ENCODER-TAIL-REQUEST-EXCEEDS-REMAINING-BYTES"
      ],
      "kind": "observed",
      "at": "encoder_tail",
      "check": [
        "gt",
        "$encoder_tail.append_len",
        "$encoder_tail.remaining_bytes"
      ]
    },
    {
      "id": "A-host-tail-reaches-sink",
      "invariants": [
        "I-HOST-TAIL-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "host_emit",
      "at": "sink",
      "check": [
        "eq",
        "$host_emit.host_tail_ptr",
        "$sink.val_ptr"
      ]
    },
    {
      "id": "A-encoder-request-length-reaches-sink",
      "invariants": [
        "I-ENCODER-REQUEST-LENGTH-REACHES-SINK",
        "I-SINK-MEMCPY-RECEIVES-ENCODER-REQUEST"
      ],
      "kind": "transition",
      "from": "encoder_tail",
      "at": "sink",
      "check": [
        "eq",
        "$encoder_tail.append_len",
        "$sink.read_len"
      ]
    }
  ]
}
