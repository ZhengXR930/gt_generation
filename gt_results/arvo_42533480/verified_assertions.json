{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42533480",
  "content_hash": "sha256:926462e0cbe82ac4520abde7d435643345718853882e68a1b3527b5f5af0e84d",
  "assertions": [
    {
      "id": "A-ROOT-TILE-COL-SIZE-WITHIN-REMAINING-DATA",
      "invariants": [
        "I-ROOT-TILE-COL-SIZE-WITHIN-REMAINING-DATA"
      ],
      "kind": "required",
      "at": "tile_col_bound_check",
      "check": [
        "le",
        "$tile_col_bound_check.tile_col_size",
        "$tile_col_bound_check.remaining_after_width_read"
      ],
      "protects": "tile_col_end_commit"
    },
    {
      "id": "A-SINK-ENTROPY-BOOL-USES-UNINITIALIZED-DIF",
      "invariants": [
        "I-SINK-ENTROPY-BOOL-USES-UNINITIALIZED-DIF"
      ],
      "kind": "observed",
      "at": "entropy_bool_sink",
      "check": [
        "gt",
        "$entropy_bool_sink.dif_read_bytes",
        "$entropy_bool_sink.dif_initialized_prefix_len"
      ]
    },
    {
      "id": "A-TILE-COLUMN-LIMIT-REACHES-TILE-SPAN",
      "invariants": [
        "I-TILE-COLUMN-LIMIT-REACHES-TILE-SPAN"
      ],
      "kind": "transition",
      "from": "tile_col_end_commit",
      "at": "tile_span_selected",
      "check": [
        "eq",
        "$tile_col_end_commit.column_end_ptr",
        "$tile_span_selected.column_limit_ptr"
      ]
    },
    {
      "id": "A-TILE-SPAN-DATA-SEEDS-BOOL-DECODER",
      "invariants": [
        "I-TILE-SPAN-DATA-SEEDS-BOOL-DECODER"
      ],
      "kind": "transition",
      "from": "tile_span_selected",
      "at": "bool_decoder_init",
      "check": [
        "eq",
        "$tile_span_selected.tile_data_ptr",
        "$bool_decoder_init.reader_start_ptr"
      ]
    },
    {
      "id": "A-TILE-SPAN-SIZE-SEEDS-BOOL-DECODER",
      "invariants": [
        "I-TILE-SPAN-SIZE-SEEDS-BOOL-DECODER"
      ],
      "kind": "transition",
      "from": "tile_span_selected",
      "at": "bool_decoder_init",
      "check": [
        "eq",
        "$tile_span_selected.tile_size",
        "$bool_decoder_init.reader_size"
      ]
    },
    {
      "id": "A-BOOL-DECODER-BUFFER-REACHES-ENTROPY-SINK",
      "invariants": [
        "I-BOOL-DECODER-BUFFER-REACHES-ENTROPY-SINK"
      ],
      "kind": "transition",
      "from": "bool_decoder_init",
      "at": "entropy_bool_sink",
      "check": [
        "eq",
        "$bool_decoder_init.reader_start_ptr",
        "$entropy_bool_sink.decoder_buf_ptr"
      ]
    },
    {
      "id": "A-BOOL-DECODER-SIZE-REACHES-ENTROPY-SINK",
      "invariants": [
        "I-BOOL-DECODER-SIZE-REACHES-ENTROPY-SINK"
      ],
      "kind": "transition",
      "from": "bool_decoder_init",
      "at": "entropy_bool_sink",
      "check": [
        "eq",
        "$bool_decoder_init.reader_size",
        "$entropy_bool_sink.decoder_storage_bytes"
      ]
    },
    {
      "id": "A-TILE-SPAN-END-EXCEEDS-REAL-DATA-END",
      "invariants": [
        "I-TILE-SPAN-END-EXCEEDS-REAL-DATA-END"
      ],
      "kind": "observed",
      "at": "tile_span_selected",
      "check": [
        "gt",
        "$tile_span_selected.tile_span_end_ptr",
        "$tile_span_selected.real_data_end_ptr"
      ]
    }
  ]
}
