  "root_cause_criterion": {
    "invariant_id": "I-ROOT-TILE-COL-SIZE-WITHIN-REMAINING-DATA",
    "type": "missing_bounds_check",
    "verified": true,
    "verified_by": "A-ROOT-TILE-COL-SIZE-WITHIN-REMAINING-DATA",
    "file": "av1/decoder/decodeframe.c",
    "function": "get_ls_tile_buffers",
    "line": 2307,
    "fine_trace_step": 3,
    "variable": "tile_col_size",
    "missing_conjunct": "`tile_col_size <= (size_t)(data_end - data)` before `tile_col_data_end[c] = data + tile_col_size`.",
    "criterion": "Before `get_ls_tile_buffers()` commits `tile_col_data_end[c]` for a non-last tile column, the decoded `tile_col_size` must fit within the real remaining bytes after the width field has been consumed.",
    "description": "The vulnerable code decodes `tile_col_size`, advances `data` by `tile_col_size_bytes`, and immediately trusts `tile_col_data_end[c] = data + tile_col_size` without proving that the derived column end stays inside the real `[data, data_end)` remainder. The fixed code adds this exact post-read bound check before the column end pointer is used."
  },
