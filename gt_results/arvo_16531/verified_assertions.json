  "assertions": [
    {
      "id": "A-ROOT-SIZE-ALIGNS-TO-UCS2-WIDTH",
      "invariants": [
        "I-ROOT-SIZE-ALIGNS-TO-UCS2-WIDTH"
      ],
      "kind": "required",
      "at": "second_decode_stop",
      "check": [
        "eq",
        "$second_decode_stop.size_mod_chr",
        0
      ],
      "protects": "second_decode_stop"
    },
    {
      "id": "A-VIOLATION-STOP-USES-RAW-BYTE-END",
      "invariants": [
        "I-VIOLATION-STOP-USES-RAW-BYTE-END"
      ],
      "kind": "observed",
      "at": "second_decode_stop",
      "check": [
        "eq",
        "$second_decode_stop.stop_addr",
        "$second_decode_stop.requested_end_addr"
      ]
    },
    {
      "id": "A-TOKEN-LEN-REACHES-SECOND-DECODE-SIZE",
      "invariants": [
        "I-TOKEN-LEN-REACHES-SECOND-DECODE-SIZE"
      ],
      "kind": "transition",
      "from": "token_export",
      "at": "second_decode_stop",
      "check": [
        "eq",
        "$token_export.token_len",
        "$second_decode_stop.size_bytes"
      ]
    },
    {
      "id": "A-STOP-PERSISTS-TO-OVERREAD",
      "invariants": [
        "I-STOP-PERSISTS-TO-OVERREAD"
      ],
      "kind": "transition",
      "from": "second_decode_stop",
      "at": "second_decode_overread",
      "check": [
        "eq",
        "$second_decode_stop.stop_addr",
        "$second_decode_overread.stop_addr"
      ]
    },
    {
      "id": "A-SINK-OVERREAD-AT-REQUESTED-END",
      "invariants": [
        "I-SINK-OVERREAD-AT-REQUESTED-END"
      ],
      "kind": "observed",
      "at": "second_decode_overread",
      "check": [
        "gt",
        "$second_decode_overread.read_addr",
        "$second_decode_overread.requested_end_addr"
      ]
    }
  ]
