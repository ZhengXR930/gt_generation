{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_67263",
  "content_hash": "sha256:8e9f8715ec62375cd0e65a873e3bf0a67bc54cdb0ed261a01442aa6d07ad533e",
  "assertions": [
    {
      "id": "A-ROOT-TERMINATOR-WRITE-INDEX-MUST-STAY-WITHIN-TEXT",
      "invariants": [
        "I-ROOT-TERMINATOR-WRITE-INDEX-MUST-STAY-WITHIN-TEXT"
      ],
      "kind": "required",
      "at": "satip_terminator_store",
      "check": [
        "lt",
        "$satip_terminator_store.write_index",
        "$satip_terminator_store.text_capacity"
      ],
      "protects": "satip_terminator_store"
    },
    {
      "id": "A-SINK-TERMINATOR-WRITE-HITS-TEXT-END",
      "invariants": [
        "I-SINK-TERMINATOR-WRITE-HITS-TEXT-END"
      ],
      "kind": "observed",
      "at": "satip_terminator_store",
      "check": [
        "eq",
        "$satip_terminator_store.write_index",
        "$satip_terminator_store.text_capacity"
      ]
    },
    {
      "id": "A-LOOP-EXIT-INDEX-FLOWS-TO-TERMINATOR-WRITE",
      "invariants": [
        "I-LOOP-EXIT-INDEX-FLOWS-TO-TERMINATOR-WRITE"
      ],
      "kind": "transition",
      "from": "satip_loop_exit",
      "at": "satip_terminator_store",
      "check": [
        "eq",
        "$satip_loop_exit.terminator_candidate_index",
        "$satip_terminator_store.raw_index"
      ]
    },
    {
      "id": "A-SOURCE-LOOP-EXIT-FILLS-TEXT-BUFFER",
      "invariants": [
        "I-SOURCE-LOOP-EXIT-FILLS-TEXT-BUFFER"
      ],
      "kind": "observed",
      "at": "satip_loop_exit",
      "check": [
        "eq",
        "$satip_loop_exit.terminator_candidate_index",
        "$satip_loop_exit.text_capacity"
      ]
    }
  ]
}
