  "assertions": [
    {
      "id": "A-ROOT-WRITE-INDEX-WITHIN-OID-CAPACITY",
      "invariants": [
        "I-ROOT-WRITE-INDEX-WITHIN-OID-CAPACITY"
      ],
      "kind": "required",
      "at": "oid_copy_guard",
      "check": [
        "lt",
        "$oid_copy_guard.write_index",
        "$oid_copy_guard.oid_capacity"
      ],
      "protects": "oid_copy_write"
    },
    {
      "id": "A-SINK-WRITE-INDEX-REACHES-OID-CAPACITY",
      "invariants": [
        "I-SINK-WRITE-INDEX-REACHES-OID-CAPACITY"
      ],
      "kind": "observed",
      "at": "oid_copy_write",
      "check": [
        "ge",
        "$oid_copy_write.write_index",
        "$oid_copy_write.oid_capacity"
      ]
    },
    {
      "id": "A-WRITE-INDEX-FLOWS-TO-OID-WRITE",
      "invariants": [
        "I-WRITE-INDEX-FLOWS-TO-OID-WRITE"
      ],
      "kind": "transition",
      "from": "oid_copy_guard",
      "at": "oid_copy_write",
      "check": [
        "eq",
        "$oid_copy_guard.write_index",
        "$oid_copy_write.write_index"
      ]
    }
  ]
}
