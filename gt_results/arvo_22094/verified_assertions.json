{
  "sample_id": "arvo_22094",
  "content_hash": "sha256:f19ab475d42eebe1a8ec68feae5b3f20dfbe138e9a5d55568a3cf9d75e4072a0",
  "assertions": [
    {
      "id": "A-ROOT-ALPHA-WIDTH-MATCHES-IMAGE-WIDTH",
      "invariants": [
        "I-ROOT-ALPHA-WIDTH-MATCHES-IMAGE-WIDTH"
      ],
      "kind": "required",
      "at": "alpha_width_guard",
      "check": [
        "eq",
        "$alpha_width_guard.alpha_width",
        "$alpha_width_guard.image_width"
      ],
      "protects": "alpha_read_sink"
    },
    {
      "id": "A-SINK-READ-USES-WIDER-IMAGE-WIDTH-THAN-ALPHA-PLANE",
      "invariants": [
        "I-SINK-READ-USES-WIDER-IMAGE-WIDTH-THAN-ALPHA-PLANE"
      ],
      "kind": "observed",
      "at": "alpha_read_sink",
      "check": [
        "gt",
        "$alpha_read_sink.image_width",
        "$alpha_read_sink.alpha_width"
      ]
    },
    {
      "id": "A-ALPHA-WIDTH-FLOWS-TO-SINK",
      "invariants": [
        "I-ALPHA-WIDTH-FLOWS-TO-SINK"
      ],
      "kind": "transition",
      "from": "alpha_width_guard",
      "at": "alpha_read_sink",
      "check": [
        "eq",
        "$alpha_width_guard.alpha_width",
        "$alpha_read_sink.alpha_width"
      ]
    }
  ]
}
