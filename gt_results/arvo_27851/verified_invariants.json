        "right": "encap"
      },
      "verified": true,
      "verified_by": "a_stale_encap_reaches_n_props_write",
      "fine_trace_step": 10,
      "description": "Writes `n_props` through the stale `encap` pointer after the old `ofpacts` buffer has been freed by `xrealloc()`. AddressSanitizer reports a heap-use-after-free WRITE of size 2 at this line."
    }
