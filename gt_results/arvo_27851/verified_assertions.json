  "assertions": [
    {
      "id": "a_encap_must_track_saved_offset_before_n_props_write",
      "invariants": [
        "r_encap_must_track_saved_offset_before_n_props_write"
      ],
      "kind": "required",
      "at": "encap_refresh_guard",
      "check": [
        "eq",
        "$encap_refresh_guard.encap_offset_now",
        "$encap_refresh_guard.saved_offset"
      ],
      "protects": "encap_n_props_sink"
    },
    {
      "id": "a_decode_ed_prop_realloc_moves_out_base",
      "invariants": [
        "n_decode_ed_prop_realloc_moves_out_base"
      ],
      "kind": "observed",
      "at": "encap_refresh_guard",
      "check": [
        "ne",
        "$encap_refresh_guard.base_before",
        "$encap_refresh_guard.base_after"
      ]
    },
    {
      "id": "a_stale_encap_reaches_n_props_write",
      "invariants": [
        "e_stale_encap_reaches_n_props_write",
        "n_sink_writes_encap_n_props"
      ],
      "kind": "transition",
      "from": "encap_refresh_guard",
      "at": "encap_n_props_sink",
      "check": [
        "eq",
        "$encap_refresh_guard.encap_ptr",
        "$encap_n_props_sink.encap_ptr"
      ]
    }
  ]
}
