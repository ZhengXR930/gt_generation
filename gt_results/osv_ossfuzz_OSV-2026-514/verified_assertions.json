{
  "schema_version": "verified-assertions-v3",
  "sample_id": "osv_ossfuzz_OSV-2026-514",
  "content_hash": "sha256:97a395ac0b179bd24689cb3d97d220843a56f59a832ddd4e19a3a717d8ca4f71",
  "assertions": [
    {
      "id": "required.post_hash_character_present",
      "invariants": [
        "root.post_hash_character_present"
      ],
      "kind": "required",
      "at": "root_check",
      "check": [
        "ne",
        "$root_check.post_hash_char",
        "$root_check.zero_literal"
      ],
      "protects": "escape_read"
    },
    {
      "id": "transition.root_check_to_escape_read",
      "invariants": [
        "edge.root_check_to_escape_read",
        "node.escape_read_state"
      ],
      "kind": "transition",
      "from": "root_check",
      "at": "escape_read",
      "check": [
        "eq",
        "$root_check.fmt_after_missing_guard",
        "$escape_read.fmt_before_ch"
      ]
    },
    {
      "id": "transition.escape_read_to_default_continue",
      "invariants": [
        "edge.escape_read_to_default_continue",
        "node.default_continue_state"
      ],
      "kind": "transition",
      "from": "escape_read",
      "at": "default_continue",
      "check": [
        "eq",
        "$escape_read.fmt_after_ch",
        "$default_continue.fmt_before_continue"
      ]
    },
    {
      "id": "transition.default_continue_to_sink_loop",
      "invariants": [
        "edge.default_continue_to_sink_loop",
        "node.sink_loop_state"
      ],
      "kind": "transition",
      "from": "default_continue",
      "at": "sink_loop",
      "check": [
        "eq",
        "$default_continue.fmt_after_continue",
        "$sink_loop.fmt_deref"
      ]
    }
  ]
}
