        "cipherSuiteStartOffset + sizeof(uint16_t) * (index + 1)",
        "m_DataLen"
      ],
      "relation": {
        "op": "le",
        "left": "cipherSuiteStartOffset + sizeof(uint16_t) * (index + 1)",
        "right": "m_DataLen"
      },
      "verified": true,
      "verified_by": "a_requested_cipher_suite_entry_must_fit_message",
      "fine_trace_step": 8,
      "description": "Root cause. This guard checks only that the first 2-byte cipher-suite slot is inside `m_DataLen`; it does not include `index`, so it does not prove that the requested `index`th entry is in bounds. The staged patch adds `sizeof(uint16_t) * (index + 1)` to enforce the missing per-index extent check."
    },
