      "at": "relocs_return",
      "check": [
        "ne",
        "$relocs_return.cached_list",
        "$relocs_return.returned_list"
      ],
      "protects": "list_sink"
    },
    {
      "id": "A-FREE",
      "invariants": [
        "I-CALLER-FREE"
      ],
      "kind": "observed",
      "at": "caller_free",
      "check": [
        "ne",
        "$caller_free.free_arg",
        "$caller_free.null_ptr"
      ]
    },
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK"
      ],
      "kind": "observed",
      "at": "list_sink",
      "check": [
        "ne",
        "$list_sink.list_arg",
        "$list_sink.null_ptr"
      ]
    },
    {
      "id": "A-RETURN-TO-FREE",
      "invariants": [
        "I-RETURN-TO-FREE"
      ],
      "kind": "transition",
      "from": "relocs_return",
