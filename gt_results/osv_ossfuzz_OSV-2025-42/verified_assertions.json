        "$caller_free.free_arg",
        "$destroy_free.stale_list"
      ]
    },
    {
      "id": "A-DESTROY-TO-SINK",
      "invariants": [
        "I-DESTROY-TO-SINK"
      ],
      "kind": "transition",
      "from": "destroy_free",
      "at": "list_sink",
      "check": [
        "eq",
        "$destroy_free.stale_list",
        "$list_sink.list_arg"
      ]
    }
  ]
