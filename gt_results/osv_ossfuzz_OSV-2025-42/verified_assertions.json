{
  "sample_id": "osv_ossfuzz_OSV-2025-42",
  "content_hash": "sha256:c2d11370218e44e33b3b2a1252c745c9262bf13bd0048eaa6b278a1b9f239964",
  "assertions": [
    {
      "id": "A-ROOT",
      "invariants": [
        "I-ROOT-OBLIGATION"
      ],
      "kind": "required",
      "at": "relocs_return",
      "check": [
        "ne",
        "$relocs_return.cached_list",
        "$relocs_return.returned_list"
      ],
      "protects": "list_sink"
    },
    {
      "id": "A-FREE",
      "invariants": [
        "I-CALLER-FREE"
      ],
      "kind": "observed",
      "at": "caller_free",
      "check": [
        "ne",
        "$caller_free.free_arg",
        "$caller_free.null_ptr"
      ]
    },
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK"
      ],
      "kind": "observed",
      "at": "list_sink",
      "check": [
        "ne",
        "$list_sink.list_arg",
        "$list_sink.null_ptr"
      ]
    },
    {
      "id": "A-RETURN-TO-FREE",
      "invariants": [
        "I-RETURN-TO-FREE",
        "N_EVENT_relocs_return"
      ],
      "kind": "transition",
      "from": "relocs_return",
      "at": "caller_free",
      "check": [
        "eq",
        "$relocs_return.returned_list",
        "$caller_free.free_arg"
      ]
    },
    {
      "id": "A-FREE-TO-DESTROY",
      "invariants": [
        "I-FREE-TO-DESTROY",
        "N_EVENT_destroy_free"
      ],
      "kind": "transition",
      "from": "caller_free",
      "at": "destroy_free",
      "check": [
        "eq",
        "$caller_free.free_arg",
        "$destroy_free.stale_list"
      ]
    },
    {
      "id": "A-DESTROY-TO-SINK",
      "invariants": [
        "I-DESTROY-TO-SINK"
      ],
      "kind": "transition",
      "from": "destroy_free",
      "at": "list_sink",
      "check": [
        "eq",
        "$destroy_free.stale_list",
        "$list_sink.list_arg"
      ]
    }
  ]
}
