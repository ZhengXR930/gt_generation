{
  "sample_id": "arvo_14141",
  "content_hash": "sha256:46836e8c4bbbe3875a7deaef867b2a2ca57eda2107bad40c33de86f9e27cf8e5",
  "assertions": [
    {
      "id": "A-ROOT-EMPTY-ENTRY-NAME-MUST-BE-REJECTED",
      "invariants": [
        "I-ROOT-EMPTY-ENTRY-NAME-MUST-BE-REJECTED"
      ],
      "kind": "required",
      "at": "empty_entry_guard",
      "check": [
        "eq",
        "$empty_entry_guard.entry_name_empty",
        0
      ],
      "protects": "reused_zero_file_continue"
    },
    {
      "id": "A-REMOVED-NESTED-ENTRY-STAYS-IN-DUPLICATE-LOOKUP",
      "invariants": [
        "I-REPLACE-EMPTY-FILE-TARGETS-NESTED-ZERO-FILE",
        "I-DUPLICATE-BRANCH-DELETES-REPLACEMENT-DIR",
        "I-STALE-NESTED-ENTRY-REACHES-DUPLICATE-LOOKUP"
      ],
      "kind": "transition",
      "from": "replace_empty_file",
      "at": "replacement_delete",
      "check": [
        "eq",
        "$replace_empty_file.removed_entry_ptr",
        "$replacement_delete.existing_entry_ptr"
      ]
    },
    {
      "id": "A-FREED-REPLACEMENT-DIR-IS-RETURNED-AS-PARENT",
      "invariants": [
        "I-DUPLICATE-BRANCH-DELETES-REPLACEMENT-DIR",
        "I-DANGLING-PARENT-RETURNED",
        "I-FREED-REPLACEMENT-DIR-REACHES-RETURNED-PARENT"
      ],
      "kind": "transition",
      "from": "replacement_delete",
      "at": "return_dangling_parent",
      "check": [
        "eq",
        "$replacement_delete.entry_ptr",
        "$return_dangling_parent.parent_ptr"
      ]
    },
    {
      "id": "A-RETURNED-DANGLING-PARENT-REACHES-ADDENTRY-SINK",
      "invariants": [
        "I-DANGLING-PARENT-RETURNED",
        "I-SINK-ADDENTRY-DEREFERENCES-DANGLING-PARENT",
        "I-RETURNED-DANGLING-PARENT-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "return_dangling_parent",
      "at": "add_entry_sink",
      "check": [
        "eq",
        "$return_dangling_parent.parent_ptr",
        "$add_entry_sink.dir_this_ptr"
      ]
    }
  ]
}
