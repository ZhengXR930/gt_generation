  "assertions": [
    {
      "id": "A-ROOT",
      "invariants": [
        "I-ROOT-OBLIGATION"
      ],
      "kind": "required",
      "at": "tok_decl",
      "check": [
        "eq",
        "$tok_decl.zero_init",
        1
      ],
      "protects": "beginbfchar_cmp"
    },
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK"
      ],
      "kind": "observed",
      "at": "beginbfchar_cmp",
      "check": [
        "gt",
        "$beginbfchar_cmp.cmp_len",
        "$beginbfchar_cmp.init_len"
      ]
    },
    {
      "id": "A-DECL-TO-TOKEN",
      "invariants": [
        "I-DECL-TO-TOKEN"
      ],
      "kind": "transition",
      "from": "tok_decl",
      "at": "outer_token",
      "check": [
        "gt",
        "$tok_decl.sizeof_tok2",
        "$outer_token.init_len"
      ]
    },
    {
      "id": "A-TOKEN-TO-SINK",
      "invariants": [
        "I-TOKEN-TO-SINK"
      ],
      "kind": "transition",
      "from": "outer_token",
      "at": "beginbfchar_cmp",
      "check": [
        "eq",
        "$outer_token.tok2_ptr",
        "$beginbfchar_cmp.tok2_ptr"
      ]
    }
  ]
