{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42521507",
  "content_hash": "sha256:657e9f7129dc85ef0bd362225733335dd9f293d9de9b4f36578f3e40d23874b9",
  "assertions": [
    {
      "id": "A-ROOT-IDENTIFIER-LENGTH-MUST-BE-NONNEGATIVE",
      "invariants": [
        "R-IDENTIFIER-LENGTH-MUST-BE-NONNEGATIVE"
      ],
      "kind": "required",
      "at": "identifier_guard",
      "check": [
        "ge",
        "$identifier_guard.length",
        0
      ],
      "protects": "cursor_rewind"
    },
    {
      "id": "A-CURSOR-REWIND-MOVES-BACKWARD",
      "invariants": [
        "N-CURSOR-REWIND-MOVES-BACKWARD"
      ],
      "kind": "observed",
      "at": "cursor_rewind",
      "check": [
        "lt",
        "$cursor_rewind.cursor_after",
        "$cursor_rewind.cursor_before"
      ]
    },
    {
      "id": "A-GUARD-LENGTH-FLOWS-TO-CURSOR-REWIND",
      "invariants": [
        "E-GUARD-LENGTH-FLOWS-TO-CURSOR-REWIND"
      ],
      "kind": "transition",
      "from": "identifier_guard",
      "at": "cursor_rewind",
      "check": [
        "eq",
        "$identifier_guard.length",
        "$cursor_rewind.length"
      ]
    },
    {
      "id": "A-REWOUND-CURSOR-REACHES-ABI-TAG-PROBE",
      "invariants": [
        "E-REWOUND-CURSOR-REACHES-ABI-TAG-PROBE",
        "N-ABI-TAG-PROBE-USES-REWOUND-CURSOR"
      ],
      "kind": "transition",
      "from": "cursor_rewind",
      "at": "abi_tag_probe",
      "check": [
        "eq",
        "$cursor_rewind.cursor_after",
        "$abi_tag_probe.probe_cursor"
      ]
    }
  ]
}
