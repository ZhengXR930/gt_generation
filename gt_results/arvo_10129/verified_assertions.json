{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_10129",
  "content_hash": "sha256:658b9577957d8e9c86ff90393d23f18efb0d6ed333101150fd59673ae09b86f7",
  "assertions": [
    {
      "id": "A-ROOT",
      "invariants": [
        "I-ROOT-OBLIGATION"
      ],
      "kind": "required",
      "at": "buf_decl",
      "check": [
        "eq",
        "$buf_decl.zero_init",
        1
      ],
      "protects": "buf_strcmp"
    },
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK"
      ],
      "kind": "observed",
      "at": "buf_strcmp",
      "check": [
        "gt",
        "$buf_strcmp.read_len",
        "$buf_strcmp.init_len"
      ]
    },
    {
      "id": "A-DECL-TO-FILL",
      "invariants": [
        "I-DECL-TO-FILL"
      ],
      "kind": "transition",
      "from": "buf_decl",
      "at": "buf_null_term",
      "check": [
        "gt",
        "$buf_decl.sizeof_buf",
        "$buf_null_term.init_count"
      ]
    },
    {
      "id": "A-FILL-TO-SINK",
      "invariants": [
        "I-FILL-TO-SINK"
      ],
      "kind": "transition",
      "from": "buf_null_term",
      "at": "buf_strcmp",
      "check": [
        "eq",
        "$buf_null_term.buf_used",
        "$buf_strcmp.buf_used"
      ]
    }
  ]
}
