{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42473836",
  "content_hash": "sha256:e12c2041ddd56bd3f0fece0d90a558654e1ebb8bf60ad77869ff4513e6d7a072",
  "assertions": [
    {
      "id": "A-ROOT-OP1-SIZE-SET-BEFORE-X86OPSIZE-FALLBACK",
      "invariants": [
        "I-ROOT-OP1-SIZE-SET-BEFORE-X86OPSIZE-FALLBACK"
      ],
      "kind": "required",
      "at": "copy_guard",
      "check": [
        "gt",
        "$copy_guard.op1_size",
        "$copy_guard.zero_literal"
      ],
      "protects": "copy_guard"
    },
    {
      "id": "A-SINK-READS-UNINITIALIZED-OP1-SIZE",
      "invariants": [
        "I-SINK-READS-UNINITIALIZED-OP1-SIZE"
      ],
      "kind": "observed",
      "at": "op1_size_sink",
      "check": [
        "lt",
        "$op1_size_sink.op1_size_initialized_prefix_len",
        "$op1_size_sink.op1_size_read_bytes"
      ]
    },
    {
      "id": "A-GUARD-FIELD-REACHES-COPY",
      "invariants": [
        "I-GUARD-FIELD-REACHES-COPY"
      ],
      "kind": "transition",
      "from": "copy_guard",
      "at": "op1_size_copy",
      "check": [
        "eq",
        "$copy_guard.op1_size_field_addr",
        "$op1_size_copy.op1_size_field_addr"
      ]
    },
    {
      "id": "A-COPY-FIELD-REACHES-SINK",
      "invariants": [
        "I-COPY-FIELD-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "op1_size_copy",
      "at": "op1_size_sink",
      "check": [
        "eq",
        "$op1_size_copy.op1_size_field_addr",
        "$op1_size_sink.op1_size_field_addr"
      ]
    },
    {
      "id": "A-COPY-STORES-UNINITIALIZED-OP1-SIZE",
      "invariants": [
        "I-COPY-STORES-UNINITIALIZED-OP1-SIZE"
      ],
      "kind": "observed",
      "at": "op1_size_copy",
      "check": [
        "lt",
        "$op1_size_copy.op1_size_initialized_prefix_len",
        "$op1_size_copy.op1_size_store_bytes"
      ]
    }
  ]
}
