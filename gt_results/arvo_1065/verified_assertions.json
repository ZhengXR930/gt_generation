        "I-USE-SEARCH-UPDATE"
      ],
      "kind": "transition",
      "from": "regex_call",
      "at": "search_update",
      "check": [
        "eq",
        "$regex_call.pmatch_arg",
        "$search_update.pmatch_addr"
      ]
    },
    {
      "id": "A-SEARCH-RM-LEN-TO-SINK",
      "invariants": [
        "I-SEARCH-RM-LEN-TO-SINK",
        "I-SINK-SEARCH-RM-LEN"
      ],
      "kind": "transition",
      "from": "search_update",
      "at": "sink_print",
      "check": [
        "eq",
        "$search_update.search_rm_len_after",
        "$sink_print.search_rm_len"
      ]
    }
