      "kind": "required",
      "at": "regex_call",
      "check": [
        "eq",
        "$regex_call.pmatch_initialized_bytes",
        "$regex_call.pmatch_bytes"
      ],
      "protects": "search_update"
    },
    {
      "id": "A-PMATCH-BUFFER-TO-USE",
      "invariants": [
