      "relation": {
        "op": "same_object",
        "left": "codeptr",
        "right": "codeptr",
        "description": "Source identity relation for the vulnerability-relevant value."
      },
      "verified": true,
      "fine_trace_step": 2,
      "description": "First project-code statement on the crashing path that materializes attacker-controlled PostScript tokens into the heap-backed interpreter stack. Repeated `scan_ps()` calls over the witness prefix `1/// 1// 1/` push three numbers and six empty-name objects into `st->objs`."
    },
    {
      "invariant_id": "r_push_stack_argument_must_not_alias_stack_slot",
      "role": "root_cause",
      "file": "cups/raster-interpret.c",
      "function": "copy_stack",
      "line": 730,
      "operands": [
        "st->objs + n"
      ],
      "relation": {
        "op": "ne",
        "left": "st->objs + n",
        "right": "st->objs + n"
      },
      "verified": true,
      "verified_by": "a_push_stack_argument_must_not_alias_stack_slot",
      "fine_trace_step": 12,
      "description": "Root cause. `copy_stack()` passes a pointer to an element inside the mutable `st->objs` array back into `push_stack()`. If `push_stack()` must grow that array, its internal `realloc()` can free `st->objs` before the aliased element is copied. The fix breaks this alias by copying `st->objs[n]` into a local temporary first."
    },
    {
      "invariant_id": "n_memcpy_sink_reads_tracked_argument",
      "role": "sink",
      "file": "cups/raster-interpret.c",
      "function": "push_stack",
      "line": 955,
      "operands": [
        "obj"
      ],
      "relation": {
        "op": "eq",
        "left": "obj",
        "right": "obj"
      },
      "verified": true,
      "verified_by": "a_stale_argument_reaches_memcpy_sink",
      "fine_trace_step": 15,
      "description": "AddressSanitizer crash site. After `realloc()` frees the old 32-object stack buffer, this `memcpy` reads one 72-byte `_cups_ps_obj_t` through the stale `obj` pointer that still aliases the freed `st->objs[14]` element."
    },
    {
      "invariant_id": "n_realloc_grows_stack_with_tracked_argument",
      "verified": true,
      "verified_by": "a_tracked_push_argument_reaches_realloc",
      "role": "intermediate",
      "file": "cups/raster-interpret.c",
      "function": "push_stack",
      "line": 944,
      "fine_trace_step": 14,
      "state": "`push_stack()` reaches the growth-path `realloc(st->objs, ...)` while its tracked `obj` argument from `copy_stack()` is still live, so the call invalidates that old stack-backed source pointer before later use.",
      "operands": [
