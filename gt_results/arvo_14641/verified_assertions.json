  "content_hash": "sha256:d8040e297076837cabf7143c9f997e67dfff0befd1dbb1e459d30b8805b60e3d",
  "assertions": [
    {
      "id": "A-ROOT-NAME-RECORDS-SANITIZED",
      "invariants": [
        "r_name_records_must_sanitize_before_packing"
      ],
      "kind": "required",
      "at": "name_sanitize",
      "check": [
        "eq",
        "$name_sanitize.records_valid",
        1
      ],
      "protects": "pack_set_any"
    },
    {
      "id": "A-SELECTED-NAME-COPY-SOURCE-REACHES-U8-COPY",
      "invariants": [
        "n_name_copy_uses_first_invalid_record_source",
        "e_name_copy_source_reaches_u8_copy"
      ],
      "kind": "transition",
      "from": "name_copy_selected",
      "at": "u8_copy_selected",
      "check": [
        "eq",
        "$name_copy_selected.source_ptr",
        "$u8_copy_selected.source_ptr"
      ]
    },
    {
      "id": "A-SELECTED-U8-COPY-BUFFER-REACHES-PACK-SET",
      "invariants": [
        "n_u8_copy_reads_selected_name_source",
        "n_pack_set_consumes_selected_object_buffer",
        "e_u8_copy_buffer_reaches_pack_set"
      ],
      "kind": "transition",
      "from": "u8_copy_selected",
      "at": "pack_set_selected",
      "check": [
        "eq",
        "$u8_copy_selected.dest_ptr",
        "$pack_set_selected.obj_head_ptr"
      ]
    }
  ]
}
