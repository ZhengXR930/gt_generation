  "assertions": [
    {
      "id": "a_parse_end_must_stay_within_true_input",
      "invariants": [
        "r_parse_end_must_stay_within_true_input"
      ],
      "kind": "required",
      "at": "parse_bounds",
      "check": [
        "le",
        "$parse_bounds.parse_end_ptr",
        "$parse_bounds.true_end_ptr"
      ],
      "protects": "reader_span"
    },
    {
      "id": "a_reader_span_end_exceeds_true_input",
      "invariants": [
        "n_reader_span_end_exceeds_true_input"
      ],
      "kind": "observed",
      "at": "reader_span",
      "check": [
        "gt",
        "$reader_span.end_ptr",
        "$reader_span.true_end_ptr"
      ]
    },
    {
      "id": "a_parse_end_carries_into_reader_span",
      "invariants": [
        "e_parse_end_carries_into_reader_span"
      ],
      "kind": "transition",
      "from": "parse_bounds",
      "at": "reader_span",
      "check": [
        "eq",
        "$parse_bounds.parse_end_ptr",
        "$reader_span.end_ptr"
      ]
    },
    {
      "id": "a_stale_reader_end_reaches_getnextchar",
      "invariants": [
        "e_stale_reader_end_reaches_getnextchar"
      ],
      "kind": "transition",
      "from": "reader_span",
      "at": "getnextchar_sink",
      "check": [
        "eq",
        "$reader_span.end_ptr",
        "$getnextchar_sink.end_ptr"
      ]
    },
    {
      "id": "a_getnextchar_reads_at_true_input_end",
      "invariants": [
        "n_getnextchar_reads_at_true_input_end"
      ],
      "kind": "observed",
      "at": "getnextchar_sink",
      "check": [
        "eq",
        "$getnextchar_sink.current_ptr",
        "$getnextchar_sink.true_end_ptr"
      ]
    }
  ]
}
