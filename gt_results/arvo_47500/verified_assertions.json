      "invariants": [
        "I-SINK-CLASSIC-CLEAR-EXCEEDS-STALE-HT-CAPACITY"
      ],
      "kind": "observed",
      "at": "classic_clear",
      "check": [
        "gt",
        "$classic_clear.clear_bytes",
        "$classic_clear.prior_capacity_units"
      ]
    },
    {
      "id": "A-HT-FLAGS-POINTER-REUSED-AT-CLASSIC-CLEAR",
      "invariants": [
        "I-HT-FLAGS-POINTER-REUSED-AT-CLASSIC-CLEAR"
      ],
      "kind": "transition",
      "from": "ht_flag_alloc",
      "at": "classic_clear",
      "check": [
