        "$ht_flag_alloc.flags_ptr",
        "$classic_clear.flags_ptr"
      ]
    },
    {
      "id": "A-HT-ALLOC-BYTES-REACH-CLASSIC-CAPACITY-STATE",
      "invariants": [
