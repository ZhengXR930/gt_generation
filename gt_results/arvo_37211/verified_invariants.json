      "verified": true,
      "verified_by": "a_apple_identify_compares_short_makernote",
      "fine_trace_step": 5,
      "description": "AddressSanitizer crash site. `strcmp` treats the short MakerNote heap buffer as a NUL-terminated string and reads past its 2-byte extent while matching the `\"Apple iOS\"` literal."
