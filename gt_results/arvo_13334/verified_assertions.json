{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_13334",
  "content_hash": "sha256:f32eda8cdb8ad974482ea787612fc4f403a71f11827aa61b803100fcbd722294",
  "assertions": [
    {
      "id": "A-ROOT-PREFIX-BYTES-FIT-IP6-ADDRESS",
      "invariants": [
        "I-ROOT-PREFIX-BYTES-FIT-IP6-ADDRESS"
      ],
      "kind": "required",
      "at": "prefix_bound_check",
      "check": [
        "le",
        "$prefix_bound_check.prefix_bytes",
        "$prefix_bound_check.address_capacity"
      ],
      "protects": "prefix_copy_sink"
    },
    {
      "id": "A-PREFIX-BYTES-PERSIST-TO-STORED-PREFIX",
      "invariants": [
        "I-PREFIX-BYTES-PERSIST-TO-STORED-PREFIX"
      ],
      "kind": "transition",
      "from": "prefix_bound_check",
      "at": "stored_prefix",
      "check": [
        "eq",
        "$prefix_bound_check.prefix_bytes",
        "$stored_prefix.stored_prefix_bytes"
      ]
    },
    {
      "id": "A-STORED-PREFIX-BYTES-FLOW-TO-SINK",
      "invariants": [
        "I-STORED-PREFIX-BYTES-FLOW-TO-SINK"
      ],
      "kind": "transition",
      "from": "stored_prefix",
      "at": "prefix_copy_sink",
      "check": [
        "eq",
        "$stored_prefix.stored_prefix_bytes",
        "$prefix_copy_sink.copy_bytes"
      ]
    },
    {
      "id": "A-SINK-COPY-EXCEEDS-PREFIX-CAPACITY",
      "invariants": [
        "I-SINK-COPY-EXCEEDS-PREFIX-CAPACITY"
      ],
      "kind": "observed",
      "at": "prefix_copy_sink",
      "check": [
        "gt",
        "$prefix_copy_sink.copy_bytes",
        "$prefix_copy_sink.prefix_capacity"
      ]
    }
  ]
}
