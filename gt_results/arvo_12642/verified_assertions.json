{
  "sample_id": "arvo_12642",
  "content_hash": "sha256:18b96964b590071d6da4cabf5d986ca87e9968247a0b2fb617d96cd723f60556",
  "assertions": [
    {
      "id": "A-ROOT-SERVER-DATA-FITS-BUFFER",
      "invariants": [
        "I-ROOT-SERVER-DATA-FITS-BUFFER"
      ],
      "kind": "required",
      "at": "server_data_bound_check",
      "check": [
        "le",
        "$server_data_bound_check.server_data_length",
        "$server_data_bound_check.server_data_capacity"
      ],
      "protects": "server_data_copy"
    },
    {
      "id": "A-SINK-SERVER-DATA-COPY-OVERFLOWS",
      "invariants": [
        "I-SINK-SERVER-DATA-COPY-OVERFLOWS"
      ],
      "kind": "observed",
      "at": "server_data_copy",
      "check": [
        "gt",
        "$server_data_copy.server_data_length",
        "$server_data_copy.server_data_capacity"
      ]
    },
    {
      "id": "A-LENGTH-FLOWS-TO-SERVER-DATA-COPY",
      "invariants": [
        "I-LENGTH-FLOWS-TO-SERVER-DATA-COPY"
      ],
      "kind": "transition",
      "from": "server_data_bound_check",
      "at": "server_data_copy",
      "check": [
        "eq",
        "$server_data_bound_check.server_data_length",
        "$server_data_copy.server_data_length"
      ]
    }
  ]
}
