  "assertions": [
    {
      "id": "A-ROOT-OPTIONAL-ANCESTOR-USES-SAFE-TRACE-SOURCE",
      "invariants": [
        "r_optional_ancestor_uses_safe_trace_source"
      ],
      "kind": "required",
      "at": "ancestor_guard",
      "check": [
        "eq",
        "$ancestor_guard.block_source_is_blockinherit_safe",
        1
      ],
      "protects": "ancestor_trace_recorded"
    },
    {
      "id": "A-OPTIONAL-NAME-ALIASES-MISCAST-BLOCK-PTR",
      "invariants": [
        "n_optional_name_reinterpreted_as_block_ptr"
      ],
      "kind": "observed",
      "at": "ancestor_guard",
      "check": [
        "eq",
        "$ancestor_guard.miscast_block_ptr",
        "$ancestor_guard.optional_name_ptr"
      ]
    },
    {
      "id": "A-OPTIONAL-NAME-PTR-REACHES-NODE-DEREF",
      "invariants": [
        "e_optional_name_ptr_reaches_node_deref",
        "n_node_deref_sink_uses_miscast_ptr"
      ],
      "kind": "transition",
      "from": "ancestor_guard",
