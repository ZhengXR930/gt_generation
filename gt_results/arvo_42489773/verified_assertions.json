{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42489773",
  "content_hash": "sha256:7cb88d46a8f42e687d5a850285572378034c08f5a0f3844f5a8c81e283630fa7",
  "assertions": [
    {
      "id": "a_trailer_offset_must_fit_usermeta_len_read",
      "invariants": [
        "r_trailer_offset_must_fit_usermeta_len_read"
      ],
      "kind": "required",
      "at": "trailer_offset_guard",
      "check": [
        "le",
        "$trailer_offset_guard.read_offset",
        "$trailer_offset_guard.frame_len"
      ],
      "protects": "usermeta_len_read"
    },
    {
      "id": "a_reparsed_cbytes_is_zero",
      "invariants": [
        "n_reparsed_cbytes_is_zero"
      ],
      "kind": "observed",
      "at": "usermeta_header_info",
      "check": [
        "eq",
        "$usermeta_header_info.cbytes",
        "$usermeta_header_info.zero_literal"
      ]
    },
    {
      "id": "a_header_len_propagates_to_trailer_offset",
      "invariants": [
        "e_header_len_to_trailer_offset"
      ],
      "kind": "transition",
      "from": "usermeta_header_info",
      "at": "trailer_offset_guard",
      "check": [
        "eq",
        "$usermeta_header_info.header_len",
        "$trailer_offset_guard.trailer_offset"
      ]
    },
    {
      "id": "a_trailer_offset_reaches_usermeta_len_read",
      "invariants": [
        "e_trailer_offset_reaches_usermeta_len_read",
        "n_usermeta_len_read_uses_unchecked_trailer_offset"
      ],
      "kind": "transition",
      "from": "trailer_offset_guard",
      "at": "usermeta_len_read",
      "check": [
        "eq",
        "$trailer_offset_guard.trailer_offset",
        "$usermeta_len_read.trailer_offset"
      ]
    }
  ]
}
