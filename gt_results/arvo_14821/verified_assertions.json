{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_14821",
  "content_hash": "sha256:b4d7cad9a4c4ac88979e4ca07df937bd2f728a7d5d56a3acc070d166103dc008",
  "assertions": [
    {
      "id": "a_root_ipv4_tail_reserve_preserves_compaction_bound",
      "invariants": [
        "r_ipv4_tail_reserve_preserves_compaction_bound"
      ],
      "kind": "required",
      "at": "post_ipv4_guard",
      "check": [
        "le",
        "$post_ipv4_guard.dst_after_ipv4_reserve",
        "$post_ipv4_guard.endp_after_ipv4_reserve"
      ],
      "protects": "compact_store"
    },
    {
      "id": "a_sink_compaction_store_starts_before_address_buffer",
      "invariants": [
        "n_compaction_store_starts_before_address_buffer"
      ],
      "kind": "observed",
      "at": "compact_underflow_write",
      "check": [
        "lt",
        "$compact_underflow_write.endp_before_store",
        "$compact_underflow_write.base_ptr"
      ]
    },
    {
      "id": "a_reserved_ipv4_tail_limit_reaches_compaction_entry",
      "invariants": [
        "e_reserved_ipv4_tail_limit_reaches_compaction_entry",
        "n_compaction_entry_uses_reserved_tail_limit"
      ],
      "kind": "transition",
      "from": "post_ipv4_guard",
      "at": "compact_entry",
      "check": [
        "eq",
        "$post_ipv4_guard.endp_after_ipv4_reserve",
        "$compact_entry.endp_before_compact"
      ]
    },
    {
      "id": "a_prebuffer_compaction_bound_reaches_underflowing_store",
      "invariants": [
        "e_prebuffer_compaction_bound_reaches_underflowing_store"
      ],
      "kind": "transition",
      "from": "compact_entry",
      "at": "compact_underflow_write",
      "check": [
        "eq",
        "$compact_entry.colonp_before_compact",
        "$compact_underflow_write.colonp_before_store"
      ]
    },
    {
      "id": "a_compaction_entry_bound_starts_before_address_buffer",
      "invariants": [
        "n_compaction_entry_bound_starts_before_address_buffer"
      ],
      "kind": "observed",
      "at": "compact_entry",
      "check": [
        "lt",
        "$compact_entry.colonp_before_compact",
        "$compact_entry.base_ptr"
      ]
    }
  ]
}
