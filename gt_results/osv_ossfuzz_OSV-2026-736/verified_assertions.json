  "assertions": [
    {
      "id": "a_init_alloc_must_reserve_token_probe",
      "invariants": [
        "r_min_token_probe_reserve"
      ],
      "kind": "required",
      "at": "init_alloc",
      "check": [
        "ge",
        "$init_alloc.allocated_total_bytes",
        "$init_alloc.token_probe_end_offset"
      ],
      "protects": "sink_ext_token"
    },
    {
      "id": "a_sink_probe_reads_at_or_past_alloc_end",
      "invariants": [
        "n_sink_probe_reads_at_or_past_alloc_end"
      ],
      "kind": "observed",
      "at": "sink_ext_token",
      "check": [
        "ge",
        "$sink_ext_token.token_read_ptr",
        "$sink_ext_token.alloc_end_ptr"
      ]
    },
    {
      "id": "a_token_base_reaches_sink_probe",
      "invariants": [
        "e_token_base_reaches_sink_probe"
      ],
      "kind": "transition",
      "from": "init_alloc",
      "at": "sink_ext_token",
      "check": [
        "eq",
        "$init_alloc.token_base_ptr",
        "$sink_ext_token.token_read_ptr"
      ]
    }
  ]
}
