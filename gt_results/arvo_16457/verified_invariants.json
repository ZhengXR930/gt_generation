      ],
      "relation": {
        "op": "lt",
        "left": "br->crc16_offset",
        "right": "br->consumed_words"
      },
      "verified": true,
      "verified_by": "A-ROOT-CONSUMED-WORDS-EXCEED-CRC16-OFFSET",
      "fine_trace_step": 6,
      "description": "Missing wraparound guard. This bulk CRC call assumes `consumed_words >= crc16_offset`, but `FLAC__bitreader_clear()` can zero `consumed_words` without resetting `crc16_offset`. When the current resync scan later consumes only a smaller number of words, the unsigned subtraction underflows and the CRC helper reads out of bounds. The fix adds the missing predicate `if (br->consumed_words > br->crc16_offset)` around this call."
    },
