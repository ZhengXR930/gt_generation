{
  "sample_id": "arvo_42535009",
  "content_hash": "sha256:6aab603a8fb354ae5225360ea806e64c1d78fca9553e9ccef10c38891b92f60f",
  "assertions": [
    {
      "id": "A-ROOT-DPOS-USE-REQUIRES-DECODE-POSITION",
      "invariants": [
        "I-ROOT-DPOS-USE-REQUIRES-DECODE-POSITION"
      ],
      "kind": "required",
      "at": "dpos_root_guard",
      "check": [
        "le",
        "$dpos_root_guard.dpos_use_enabled",
        "$dpos_root_guard.decode_position_query_ok"
      ],
      "protects": "analyze_frame_sink"
    },
    {
      "id": "A-SINK-ANALYZE-FRAME-USES-UNINITIALIZED-FRAME-BYTES",
      "invariants": [
        "I-SINK-ANALYZE-FRAME-USES-UNINITIALIZED-FRAME-BYTES"
      ],
      "kind": "observed",
      "at": "analyze_frame_sink",
      "check": [
        "lt",
        "$analyze_frame_sink.frame_bytes_initialized_prefix_len",
        "$analyze_frame_sink.frame_bytes_bytes"
      ]
    },
    {
      "id": "A-DPOS-STATE-TO-FRAME-BYTES",
      "invariants": [
        "I-DPOS-STATE-TO-FRAME-BYTES"
      ],
      "kind": "transition",
      "from": "dpos_root_guard",
      "at": "frame_bytes_update",
      "check": [
        "eq",
        "$dpos_root_guard.dpos_initialized_prefix_len",
        "$frame_bytes_update.frame_bytes_initialized_prefix_len"
      ]
    },
    {
      "id": "A-FRAME-BYTES-TO-ANALYZE-SINK",
      "invariants": [
        "I-FRAME-BYTES-TO-ANALYZE-SINK"
      ],
      "kind": "transition",
      "from": "frame_bytes_update",
      "at": "analyze_frame_sink",
      "check": [
        "eq",
        "$frame_bytes_update.frame_bytes_initialized_prefix_len",
        "$analyze_frame_sink.frame_bytes_initialized_prefix_len"
      ]
    },
    {
      "id": "A-FRAME-BYTES-LOADS-UNINITIALIZED-DPOS",
      "invariants": [
        "I-FRAME-BYTES-LOADS-UNINITIALIZED-DPOS"
      ],
      "kind": "observed",
      "at": "frame_bytes_update",
      "check": [
        "lt",
        "$frame_bytes_update.frame_bytes_initialized_prefix_len",
        "$frame_bytes_update.frame_bytes_bytes"
      ]
    }
  ]
}
