{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_17330",
  "content_hash": "sha256:14a8e2979174ce221416d7fdd84898238dcf4c3a4a4b0a626649619a20183859",
  "assertions": [
    {
      "id": "A-ROOT-COPY-LENGTH-FITS-TLVS",
      "invariants": [
        "I-ROOT-COPY-LENGTH-FITS-TLVS"
      ],
      "kind": "required",
      "at": "commissioning_get_copy",
      "check": [
        "le",
        "$commissioning_get_copy.copy_length",
        "$commissioning_get_copy.tlvs_capacity"
      ],
      "protects": "commissioning_get_response_filter"
    },
    {
      "id": "A-SINK-COPY-LENGTH-EXCEEDS-TLVS",
      "invariants": [
        "I-SINK-COPY-LENGTH-EXCEEDS-TLVS"
      ],
      "kind": "observed",
      "at": "commissioning_get_copy",
      "check": [
        "gt",
        "$commissioning_get_copy.copy_length",
        "$commissioning_get_copy.tlvs_capacity"
      ]
    },
    {
      "id": "A-LENGTH-FLOWS-TO-COPY-CALL",
      "invariants": [
        "I-LENGTH-FLOWS-TO-COPY-CALL"
      ],
      "kind": "transition",
      "from": "commissioning_get_length",
      "at": "commissioning_get_copy",
      "check": [
        "eq",
        "$commissioning_get_length.materialized_length",
        "$commissioning_get_copy.copy_length"
      ]
    }
  ]
}
