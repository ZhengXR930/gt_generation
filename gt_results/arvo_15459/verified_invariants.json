      "fine_trace_step": 1,
      "description": "Reads the attacker-controlled answer RR count from the DNS response header. This determines how many answer resource records the parser will process, controlling the number of address nodes created and ultimately the overflow extent in ares_parse_a_reply."
    },
    {
      "invariant_id": "missing_bounds_check_i_lt_naddrttls",
      "role": "root_cause",
      "file": "ares_parse_a_reply.c",
      "function": "ares_parse_a_reply",
      "line": 155,
      "operands": [
        "i",
        "*naddrttls"
      ],
      "relation": {
        "op": "lt",
        "left": "i",
        "right": "*naddrttls"
      },
      "verified": true,
      "verified_by": "A2",
      "fine_trace_step": 4,
      "description": "The guard if (naddrttls) checks only that the pointer is non-NULL, omitting the bounds check i < *naddrttls. This allows the loop body to write to addrttls[i] for i values that exceed the caller's buffer capacity. The fix adds && i < *naddrttls to the condition."
    },
    {
      "invariant_id": "oob_write_to_addrttls",
      "role": "sink",
      "file": "ares_parse_a_reply.c",
      "function": "ares_parse_a_reply",
      "line": 158,
      "operands": [
        "*naddrttls",
        "i"
      ],
      "relation": {
        "op": "le",
        "left": "*naddrttls",
        "right": "i"
      },
      "verified": true,
      "verified_by": "A3",
      "fine_trace_step": 5,
      "description": "Writes addrttls[i].ttl when i >= 5, overflowing the caller's 5-element stack-allocated struct ares_addrttl array. ASAN detects a 4-byte stack-buffer-overflow write at stack frame offset 108, which is info[5].ttl (the struct's second field, past the info array boundary at offset 104)."
    },
    {
