{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42470405",
  "content_hash": "sha256:c2a09437706b3953412ff4a1446deb1e0c8920211a4e5fdc00a760be2f84b9cb",
  "assertions": [
    {
      "id": "REQ-resourcesZ-offset-must-not-be-neutered",
      "invariants": [
        "R-resourcesZ-offset-preserved-across-sanitize"
      ],
      "kind": "required",
      "at": "resource_array_sanitize",
      "check": [
        "eq",
        "$resource_array_sanitize.resource_list_offset_before",
        "$resource_array_sanitize.resource_list_offset_after"
      ],
      "protects": "resource_array_sanitize"
    },
    {
      "id": "OBS-cmp-reads-uninitialized-tag",
      "invariants": [
        "N-cmp-reads-uninitialized-tag"
      ],
      "kind": "observed",
      "at": "cmp_sink",
      "check": [
        "gt",
        "$cmp_sink.cmp_read_bytes",
        "$cmp_sink.cmp_initialized_prefix_len"
      ]
    },
    {
      "id": "TRANS-resource-list-pointer-to-selected-record",
      "invariants": [
        "E-resource-list-pointer-to-selected-record"
      ],
      "kind": "transition",
      "from": "resource_array_sanitize",
      "at": "fake_face_materialization",
      "check": [
        "eq",
        "$resource_array_sanitize.resource_list_ptr_after",
        "$fake_face_materialization.selected_resource_record_ptr"
      ]
    },
    {
      "id": "TRANS-fake-face-table-count-to-bsearch-count",
      "invariants": [
        "E-fake-face-table-count-to-bsearch-count"
      ],
      "kind": "transition",
      "from": "fake_face_materialization",
      "at": "bsearch_probe",
      "check": [
        "eq",
        "$fake_face_materialization.fake_face_table_count",
        "$bsearch_probe.search_table_count"
      ]
    },
    {
      "id": "TRANS-probe-tag-storage-to-cmp-storage",
      "invariants": [
        "E-probe-tag-storage-to-cmp-storage"
      ],
      "kind": "transition",
      "from": "bsearch_probe",
      "at": "cmp_sink",
      "check": [
        "eq",
        "$bsearch_probe.probe_tag_storage",
        "$cmp_sink.cmp_tag_storage"
      ]
    }
  ]
}
