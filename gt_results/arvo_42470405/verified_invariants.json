    {
      "invariant_id": "R-resourcesZ-offset-preserved-across-sanitize",
      "role": "root_cause",
      "file": "src/hb-open-file.hh",
      "function": "OT::ResourceTypeRecord",
      "line": 351,
      "operands": [
        "resourcesZ"
