        "right": "sizeof (a)"
      },
      "verified": true,
      "verified_by": "OBS-cmp-reads-uninitialized-tag",
      "fine_trace_step": 11,
      "description": "MemorySanitizer crash site. `cmp()` branches on local `b`, which was loaded from `arr[mid].tag` after `bsearch()` stepped past the copied blob into adjacent uninitialized heap bytes."
