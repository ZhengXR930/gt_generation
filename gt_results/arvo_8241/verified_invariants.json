        "right": "ret"
      },
      "verified": true,
      "verified_by": "a_published_session_reaches_ssl_version_sink",
      "fine_trace_step": 13,
      "description": "ASan crash site. `ssl_get_prev_session()` treats the dangling `ret` returned from `tls_get_ticket_from_client()` as a live resumed session and reads `ret->ssl_version` from freed `SSL_SESSION` storage."
    },
