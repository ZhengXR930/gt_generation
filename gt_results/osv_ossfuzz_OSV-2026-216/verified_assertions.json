{
  "sample_id": "osv_ossfuzz_OSV-2026-216",
  "content_hash": "sha256:1ed149eac7c56b0b58400392789de9670afad270e8b86f4bf5d9cd101bff2911",
  "assertions": [
    {
      "id": "A-ROOT",
      "invariants": [
        "I-ROOT-OBLIGATION"
      ],
      "kind": "required",
      "at": "binary_prop",
      "check": [
        "lt",
        "$binary_prop.payload_end",
        "$binary_prop.packet_end"
      ],
      "protects": "crc_sink"
    },
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK"
      ],
      "kind": "observed",
      "at": "crc_sink",
      "check": [
        "gt",
        "$crc_sink.crc_len",
        "$crc_sink.bytes_available"
      ]
    },
    {
      "id": "A-LEN-TO-SINK",
      "invariants": [
        "I-LEN-TO-SINK"
      ],
      "kind": "transition",
      "from": "binary_prop",
      "at": "crc_sink",
      "check": [
        "eq",
        "$binary_prop.prop_len",
        "$crc_sink.crc_len"
      ]
    },
    {
      "id": "A-BUF-TO-SINK",
      "invariants": [
        "I-BUF-TO-SINK"
      ],
      "kind": "transition",
      "from": "binary_prop",
      "at": "crc_sink",
      "check": [
        "eq",
        "$binary_prop.prop_buf",
        "$crc_sink.crc_buf"
      ]
    }
  ]
}
