        "right": "role"
      },
      "verified": true,
      "verified_by": "a_capacity_filling_role_reaches_sink_scan",
      "fine_trace_step": 12,
      "description": "Project-side sink. Evaluating this loop condition on the stored six-value role array reads `entity->roles[6]` past the 40-byte `FuCoswidFirmwareEntity` allocation."
    },
