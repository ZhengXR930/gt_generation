{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42534761",
  "content_hash": "sha256:207c373cf04da324c455c378057dc20ab03267cb63fef07b7b72aae3aa73ad12",
  "assertions": [
    {
      "id": "a_role_array_must_reserve_unknown_terminator",
      "invariants": [
        "r_role_array_must_reserve_unknown_terminator"
      ],
      "kind": "required",
      "at": "role_array_guard",
      "check": [
        "lt",
        "$role_array_guard.role_count",
        6
      ],
      "protects": "role_scan_start"
    },
    {
      "id": "a_capacity_filling_store_writes_nonzero_role",
      "invariants": [
        "n_capacity_filling_store_writes_nonzero_role"
      ],
      "kind": "observed",
      "at": "final_role_store",
      "check": [
        "ne",
        "$final_role_store.stored_role",
        "$final_role_store.zero_literal"
      ]
    },
    {
      "id": "a_role_count_reaches_capacity_filling_store",
      "invariants": [
        "e_role_count_reaches_capacity_filling_store"
      ],
      "kind": "transition",
      "from": "role_array_guard",
      "at": "final_role_store",
      "check": [
        "eq",
        "$role_array_guard.role_count",
        "$final_role_store.entity_role_cnt_after"
      ]
    },
    {
      "id": "a_capacity_filling_role_reaches_sink_scan",
      "invariants": [
        "e_capacity_filling_role_reaches_sink_scan",
        "n_sink_scan_reads_capacity_filling_role"
      ],
      "kind": "transition",
      "from": "final_role_store",
      "at": "role_scan_start",
      "check": [
        "eq",
        "$final_role_store.stored_role",
        "$role_scan_start.last_slot_value"
      ]
    }
  ]
}
