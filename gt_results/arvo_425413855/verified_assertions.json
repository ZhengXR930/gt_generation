  "assertions": [
    {
      "id": "A-ROOT-FIFTH-BYTE-IN-RANGE-BEFORE-BOOL-PROBE",
      "invariants": [
        "I-ROOT-FIFTH-BYTE-IN-RANGE-BEFORE-BOOL-PROBE"
      ],
      "kind": "required",
      "at": "bool_fifth_byte_guard",
      "check": [
        "lt",
        "$bool_fifth_byte_guard.fifth_byte_ptr",
        "$bool_fifth_byte_guard.end_ptr"
      ],
      "protects": "bool_fifth_byte_probe"
    },
    {
      "id": "A-SINK-FIRST-INVALID-BYTE-IS-END",
      "invariants": [
        "I-SINK-FIRST-INVALID-BYTE-IS-END"
      ],
      "kind": "observed",
      "at": "bool_memcpy_sink",
      "check": [
        "eq",
        "$bool_memcpy_sink.first_invalid_ptr",
        "$bool_memcpy_sink.end_ptr"
      ]
    },
    {
      "id": "A-FIFTH-BYTE-PROBE-POINTER-FLOWS-TO-MEMCPY-SINK",
      "invariants": [
        "I-FIFTH-BYTE-PROBE-POINTER-FLOWS-TO-MEMCPY-SINK"
      ],
      "kind": "transition",
      "from": "bool_fifth_byte_probe",
      "at": "bool_memcpy_sink",
      "check": [
        "eq",
        "$bool_fifth_byte_probe.fifth_byte_ptr",
        "$bool_memcpy_sink.first_invalid_ptr"
      ]
    }
  ]
}
