  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_25530",
  "content_hash": "sha256:f5631d5b100fe6597e9d5649a4130774484454a113ba523f3ccb25902a3f856c",
  "assertions": [
    {
      "id": "A-ROOT-PIMASIZE-COVERS-ROUNDED-DECODE-SCRATCH",
      "invariants": [
        "I-ROOT-PIMASIZE-COVERS-ROUNDED-DECODE-SCRATCH"
      ],
      "kind": "required",
      "at": "alloc_budget",
      "check": [
        "ge",
        "$alloc_budget.pimasize",
        "$alloc_budget.required_pimasize"
      ],
      "protects": "decode_store"
    },
    {
      "id": "A-SINK-DECODE-STORE-EXCEEDS-VULNERABLE-TAIL-BUDGET",
      "invariants": [
        "I-SINK-DECODE-STORE-EXCEEDS-VULNERABLE-TAIL-BUDGET"
      ],
      "kind": "observed",
      "at": "decode_store",
      "check": [
        "gt",
        "$decode_store.write_end_bytes",
        "$decode_store.vulnerable_tail_bytes"
      ]
    },
    {
      "id": "A-VULNERABLE-TAIL-BUDGET-REACHES-DECODE-STORE",
      "invariants": [
        "E-VULNERABLE-TAIL-BUDGET-REACHES-DECODE-STORE"
      ],
      "kind": "transition",
      "from": "alloc_budget",
      "at": "decode_store",
      "check": [
        "eq",
        "$alloc_budget.vulnerable_tail_bytes",
        "$decode_store.vulnerable_tail_bytes"
      ]
    }
  ]
}
