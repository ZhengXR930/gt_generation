      "verified": true,
      "verified_by": "A-ROOT-SPACE-FAILURE-CLEARS-EDGES",
      "fine_trace_step": 10,
      "description": "Root cause. When the large `space` allocation fails, this error path frees the already allocated `opt_state->edges` array but does not clear that field before `opt_error()` longjmps to the generic cleanup handler. `opt_state->edges` therefore becomes a dangling pointer that `opt_cleanup()` frees again."
    },
    {
      "invariant_id": "n_opt_cleanup_edges_free_sink",
      "role": "sink",
      "file": "optimize.c",
      "function": "opt_cleanup",
      "line": 2034,
