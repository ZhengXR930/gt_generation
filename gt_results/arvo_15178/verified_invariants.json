        "opt_state.edges"
      ],
      "relation": {
        "op": "eq",
        "left": "opt_state->edges",
        "right": "opt_state.edges"
      },
      "verified": true,
      "verified_by": "A-ERROR-HANDLER-EDGES-REACH-CLEANUP-FREE",
      "fine_trace_step": 12,
      "description": "ASan sink. After `opt_init()` already freed `opt_state->edges` on the `space == NULL` error path, `bpf_optimize()`'s setjmp error handler calls `opt_cleanup()`, and this second `free` hits the same heap region again."
    },
    {
      "invariant_id": "n_bpf_optimize_error_handler_carries_edges_field",
