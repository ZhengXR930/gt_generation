{
  "sample_id": "arvo_14625",
  "content_hash": "sha256:076318dc976c239ca948125fe8d955edb2a6c16edc0d2eb9e9ee8473087b5530",
  "assertions": [
    {
      "id": "a_unbase64_must_initialize_published_bytes",
      "invariants": [
        "r_unbase64_must_initialize_published_bytes"
      ],
      "kind": "required",
      "at": "unbase64_publish",
      "check": [
        "eq",
        "$unbase64_publish.initialized_prefix_len",
        "$unbase64_publish.published_len"
      ],
      "protects": "base64_tail_read"
    },
    {
      "id": "a_unbase64_publishes_partial_init_state",
      "invariants": [
        "n_unbase64_publishes_partial_init_state"
      ],
      "kind": "observed",
      "at": "unbase64_publish",
      "check": [
        "gt",
        "$unbase64_publish.published_len",
        "$unbase64_publish.initialized_prefix_len"
      ]
    },
    {
      "id": "a_unbase64_buffer_published_to_bytestring",
      "invariants": [
        "e_unbase64_buffer_published_to_bytestring",
        "N_EVENT_bytestring_decode_publish"
      ],
      "kind": "transition",
      "from": "unbase64_publish",
      "at": "bytestring_decode_publish",
      "check": [
        "eq",
        "$unbase64_publish.raw_buffer",
        "$bytestring_decode_publish.decoded_data_ptr"
      ]
    },
    {
      "id": "a_unbase64_length_published_to_bytestring",
      "invariants": [
        "e_unbase64_length_published_to_bytestring"
      ],
      "kind": "transition",
      "from": "unbase64_publish",
      "at": "bytestring_decode_publish",
      "check": [
        "eq",
        "$unbase64_publish.published_len",
        "$bytestring_decode_publish.decoded_len"
      ]
    },
    {
      "id": "a_bytestring_buffer_reaches_encoder",
      "invariants": [
        "e_bytestring_buffer_reaches_encoder",
        "N_EVENT_bytestring_encode_call"
      ],
      "kind": "transition",
      "from": "bytestring_decode_publish",
      "at": "bytestring_encode_call",
      "check": [
        "eq",
        "$bytestring_decode_publish.decoded_data_ptr",
        "$bytestring_encode_call.encoded_data_ptr"
      ]
    },
    {
      "id": "a_bytestring_length_reaches_encoder",
      "invariants": [
        "e_bytestring_length_reaches_encoder"
      ],
      "kind": "transition",
      "from": "bytestring_decode_publish",
      "at": "bytestring_encode_call",
      "check": [
        "eq",
        "$bytestring_decode_publish.decoded_len",
        "$bytestring_encode_call.encoded_len"
      ]
    },
    {
      "id": "a_encoder_buffer_reaches_base64_tail_read",
      "invariants": [
        "e_encoder_buffer_reaches_base64_tail_read",
        "n_base64_tail_read_uses_carried_bytes"
      ],
      "kind": "transition",
      "from": "bytestring_encode_call",
      "at": "base64_tail_read",
      "check": [
        "eq",
        "$bytestring_encode_call.encoded_data_ptr",
        "$base64_tail_read.raw_buffer"
      ]
    },
    {
      "id": "a_encoder_length_reaches_base64_tail_read",
      "invariants": [
        "e_encoder_length_reaches_base64_tail_read"
      ],
      "kind": "transition",
      "from": "bytestring_encode_call",
      "at": "base64_tail_read",
      "check": [
        "eq",
        "$bytestring_encode_call.encoded_len",
        "$base64_tail_read.input_len"
      ]
    }
  ]
}
