  "root_cause_criterion": {
    "invariant_id": "r_unbase64_must_initialize_published_bytes",
    "type": "missing_initialization",
    "verified": true,
    "verified_by": "a_unbase64_must_initialize_published_bytes",
    "file": "deps/base64.c",
    "function": "UA_unbase64",
    "line": 148,
    "fine_trace_step": 11,
    "variable": "cb",
    "missing_conjunct": "cb == *flen",
    "criterion": "Before `UA_unbase64()` returns the decoded heap buffer, the number of bytes it actually writes into `bin` (`cb`) must equal the published decoded length `*flen`, so every byte the caller is told to consume is initialized.",
    "description": "The vulnerable `len == 2, pad == 0` path allocates `*flen` bytes but skips both the 4-character loop and the padding tails, leaving `cb == 0` while still publishing a nonzero decoded length. The fixed implementation still accepts the same body token, but it writes exactly as many bytes as it publishes before returning."
  },
  "nodes": [
    {
      "invariant_id": "n_unbase64_publishes_partial_init_state",
      "verified": true,
      "verified_by": "a_unbase64_publishes_partial_init_state",
      "role": "mechanism",
      "file": "deps/base64.c",
      "function": "UA_unbase64",
      "line": 148,
      "fine_trace_step": 11,
      "variable": "cb, *flen",
      "state": "At the vulnerable `UA_unbase64()` return, the function publishes a decoded length of 1 while the initialized prefix length `cb` is still 0, so the returned one-byte heap buffer is entirely unwritten."
    },
    {
      "invariant_id": "n_base64_tail_read_uses_carried_bytes",
      "verified": true,
      "verified_by": "a_encoder_buffer_reaches_base64_tail_read",
      "role": "sink",
      "file": "deps/base64.c",
      "function": "UA_base64",
      "line": 103,
      "fine_trace_step": 17,
      "variable": "bin[byteNo]",
      "state": "The `UA_base64()` tail path reaches the first `bin[byteNo]` read with the same raw ByteString buffer carried in from `ByteString_encodeJson`; on the crashing vulnerable execution this is the published-but-unwritten buffer from `UA_unbase64()`."
    }
  ],
