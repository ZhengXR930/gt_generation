{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_48910",
  "content_hash": "sha256:085bc14f8f1411d173ffe45a33fdfa8eb1becf9c622edd2bede78ff129900bc0",
  "assertions": [
    {
      "id": "A-ROOT-UNCOMPRESSED-UPDATE-REQUIRES-INITIALIZED-SEGMENT",
      "invariants": [
        "R-UNCOMPRESSED-SEGMENT-INITIALIZED-BEFORE-UPDATE"
      ],
      "kind": "required",
      "at": "uncompressed_update_call",
      "check": [
        "ge",
        "$uncompressed_update_call.segment_initialized_prefix_len",
        "$uncompressed_update_call.segment_size"
      ],
      "protects": "tmpin_copy"
    },
    {
      "id": "A-TMPIN-COPY-PRESERVES-SEGMENT-DEFINEDNESS",
      "invariants": [
        "N-TMPIN-COPY-PRESERVES-SEGMENT-DEFINEDNESS"
      ],
      "kind": "observed",
      "at": "tmpin_copy",
      "check": [
        "eq",
        "$tmpin_copy.src_initialized_prefix_len",
        "$tmpin_copy.tmpin_initialized_prefix_len"
      ]
    },
    {
      "id": "A-SINK-HC-HASH-READS-UNINITIALIZED-IP",
      "invariants": [
        "N-SINK-HC-HASH-READS-UNINITIALIZED-IP"
      ],
      "kind": "observed",
      "at": "hc_hash_sink",
      "check": [
        "gt",
        "$hc_hash_sink.ip_read_bytes",
        "$hc_hash_sink.ip_initialized_prefix_len"
      ]
    },
    {
      "id": "A-UNCOMPRESSED-SEGMENT-FLOWS-TO-TMPIN-COPY",
      "invariants": [
        "E-UNCOMPRESSED-SEGMENT-FLOWS-TO-TMPIN-COPY"
      ],
      "kind": "transition",
      "from": "uncompressed_update_call",
      "at": "tmpin_copy",
      "check": [
        "eq",
        "$uncompressed_update_call.segment_ptr",
        "$tmpin_copy.src_ptr"
      ]
    },
    {
      "id": "A-TMPIN-BUFFER-FLOWS-TO-HC-HASH-SINK",
      "invariants": [
        "E-TMPIN-BUFFER-FLOWS-TO-HC-HASH-SINK"
      ],
      "kind": "transition",
      "from": "tmpin_copy",
      "at": "hc_hash_sink",
      "check": [
        "eq",
        "$tmpin_copy.tmpin_ptr",
        "$hc_hash_sink.ip_ptr"
      ]
    }
  ]
}
