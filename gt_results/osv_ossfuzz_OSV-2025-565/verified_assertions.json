{
  "sample_id": "osv_ossfuzz_OSV-2025-565",
  "content_hash": "sha256:c4388bbe413060c2d2b052b510ccc67933dc61272631a0bdb432648a46d28bb6",
  "assertions": [
    {
      "id": "A_ROOT_IPV6_OPTION_EXTENT_REQUIRED",
      "kind": "required",
      "at": "sink",
      "protects": "sink",
      "invariants": [
        "N_ROOT"
      ],
      "check": [
        "ge",
        "$sink.available_bytes",
        "$sink.ipv6_option_size"
      ]
    },
    {
      "id": "A_OBS_ADMISSION_SEES_DECLARED_OPTIONS",
      "kind": "observed",
      "at": "source",
      "invariants": [
        "N_SOURCE"
      ],
      "check": [
        "ge",
        "$source.data_len",
        "$source.declared_options_len"
      ]
    },
    {
      "id": "A_OBS_SINK_READ_EXCEEDS_AVAILABLE_BYTES",
      "kind": "observed",
      "at": "sink",
      "invariants": [
        "N_SINK"
      ],
      "check": [
        "gt",
        "$sink.ipv6_option_size",
        "$sink.available_bytes"
      ]
    },
    {
      "id": "A_TRANS_OPTION_OFFSET_ROOT_TO_SINK",
      "kind": "transition",
      "from": "root",
      "at": "sink",
      "invariants": [
        "E_ROOT_TO_SINK_OFFSET"
      ],
      "check": [
        "eq",
        "$root.option_offset",
        "$sink.option_offset"
      ]
    },
    {
      "id": "A_TRANS_DATA_PTR_ROOT_TO_SINK",
      "kind": "transition",
      "from": "root",
      "at": "sink",
      "invariants": [
        "E_ROOT_TO_SINK_DATA_PTR"
      ],
      "check": [
        "eq",
        "$root.data_base",
        "$sink.data_base"
      ]
    }
  ]
}
