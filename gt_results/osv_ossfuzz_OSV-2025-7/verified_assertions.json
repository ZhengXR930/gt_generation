{
  "sample_id": "osv_ossfuzz_OSV-2025-7",
  "content_hash": "sha256:e2855bde26964b13e552695353cdd2ccc38564ff53dbb937af59b35f021eeda6",
  "assertions": [
    {
      "id": "required.root_escape_delta_not_underestimated",
      "kind": "required",
      "at": "root",
      "protects": "sink",
      "check": [
        "ge",
        "$root.estimated_delta",
        "$root.actual_delta"
      ],
      "invariants": [
        "N_ROOT"
      ]
    },
    {
      "id": "transition.allocated_size_reaches_sink",
      "kind": "transition",
      "from": "alloc",
      "at": "sink",
      "check": [
        "eq",
        "$alloc.allocated_size",
        "$sink.allocated_size"
      ],
      "invariants": [
        "E_ALLOC_TO_SINK"
      ]
    },
    {
      "id": "observed.write_end_exceeds_allocation",
      "kind": "observed",
      "at": "sink",
      "check": [
        "gt",
        "$sink.write_end",
        "$sink.allocated_size"
      ],
      "invariants": [
        "N_SINK"
      ]
    },
    {
      "id": "observed.allocation_size_matches_estimate",
      "kind": "observed",
      "at": "alloc",
      "check": [
        "eq",
        "$alloc.estimated_escape_size",
        "$alloc.allocated_size"
      ],
      "invariants": [
        "N_ALLOC"
      ]
    }
  ]
}
