{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_13837",
  "content_hash": "sha256:9de0087e4029e579336c0b4a793ff430a569782a27dbb19bc3fb44b9223fc83b",
  "assertions": [
    {
      "id": "required.inner_sequence_end_covers_parameter_cursor",
      "invariants": [
        "root.inner_sequence_end_covers_parameter_cursor"
      ],
      "kind": "required",
      "at": "parameters_guard",
      "check": [
        "ge",
        "$parameters_guard.last_byte1",
        "$parameters_guard.byte_index"
      ],
      "protects": "parameters_parse"
    },
    {
      "id": "observed.parameters_span_wraps_past_inner_sequence_end",
      "invariants": [
        "node.parameters_span_wraps_past_inner_sequence_end"
      ],
      "kind": "observed",
      "at": "parameters_parse",
      "check": [
        "gt",
        "$parameters_parse.validation_span",
        "$parameters_parse.inner_seq_end"
      ]
    },
    {
      "id": "transition.parameter_cursor_reaches_parameters_parse",
      "invariants": [
        "edge.parameter_cursor_reaches_parameters_parse"
      ],
      "kind": "transition",
      "from": "parameters_guard",
      "at": "parameters_parse",
      "check": [
        "eq",
        "$parameters_guard.byte_index",
        "$parameters_parse.parameter_offset"
      ]
    },
    {
      "id": "transition.inner_sequence_end_reaches_parameters_parse",
      "invariants": [
        "edge.inner_sequence_end_reaches_parameters_parse"
      ],
      "kind": "transition",
      "from": "parameters_guard",
      "at": "parameters_parse",
      "check": [
        "eq",
        "$parameters_guard.last_byte1",
        "$parameters_parse.inner_seq_end"
      ]
    },
    {
      "id": "transition.underflowed_parameters_span_reaches_outer_length_decode",
      "invariants": [
        "edge.underflowed_parameters_span_reaches_outer_length_decode"
      ],
      "kind": "transition",
      "from": "parameters_parse",
      "at": "outer_object_length",
      "check": [
        "eq",
        "$parameters_parse.validation_span",
        "$outer_object_length.bytes_max"
      ]
    },
    {
      "id": "observed.outer_parameters_object_is_constructed",
      "invariants": [
        "node.outer_parameters_object_is_constructed"
      ],
      "kind": "observed",
      "at": "outer_object_length",
      "check": [
        "eq",
        "$outer_object_length.structure_bit",
        "$outer_object_length.true_literal"
      ]
    },
    {
      "id": "transition.forged_outer_last_byte_reaches_parent_loop",
      "invariants": [
        "edge.forged_outer_last_byte_reaches_parent_loop"
      ],
      "kind": "transition",
      "from": "outer_object_length",
      "at": "post_child_loop",
      "check": [
        "eq",
        "$outer_object_length.last_byte",
        "$post_child_loop.last_byte"
      ]
    },
    {
      "id": "observed.parent_loop_schedules_next_recursive_parse",
      "invariants": [
        "node.parent_loop_schedules_next_recursive_parse"
      ],
      "kind": "observed",
      "at": "post_child_loop",
      "check": [
        "lt",
        "$post_child_loop.next_offset",
        "$post_child_loop.last_byte"
      ]
    },
    {
      "id": "transition.parent_remaining_span_reaches_sink_read_type",
      "invariants": [
        "edge.parent_remaining_span_reaches_sink_read_type"
      ],
      "kind": "transition",
      "from": "post_child_loop",
      "at": "sink_read_type",
      "check": [
        "eq",
        "$post_child_loop.next_span",
        "$sink_read_type.bytes_max"
      ]
    },
    {
      "id": "observed.sink_read_type_claims_one_byte_available",
      "invariants": [
        "node.sink_read_type_claims_one_byte_available"
      ],
      "kind": "observed",
      "at": "sink_read_type",
      "check": [
        "ge",
        "$sink_read_type.bytes_max",
        "$sink_read_type.type_read_width"
      ]
    }
  ]
}
