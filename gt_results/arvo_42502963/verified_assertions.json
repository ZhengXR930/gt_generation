  "assertions": [
    {
      "id": "A-ROOT-COMPRESSED-POINTER-TARGET-BACKWARD",
      "invariants": [
        "R-COMPRESSED-POINTER-TARGET-BACKWARD"
      ],
      "kind": "required",
      "at": "pointer_target_guard",
      "check": [
        "lt",
        "$pointer_target_guard.label_after_ptr",
        "$pointer_target_guard.label_before_ptr"
      ],
      "protects": "dns_label_sink"
    },
    {
      "id": "A-SINK-DEREF-USES-FORWARD-RESOLVED-POINTER",
      "invariants": [
        "N-SINK-DEREF-USES-FORWARD-RESOLVED-POINTER"
      ],
      "kind": "observed",
      "at": "dns_label_sink",
      "check": [
        "gt",
        "$dns_label_sink.label_after_ptr",
        "$dns_label_sink.label_before_ptr"
      ]
    },
    {
      "id": "A-RESOLVED-POINTER-REACHES-SINK-DEREF",
      "invariants": [
        "E-RESOLVED-POINTER-REACHES-SINK-DEREF"
      ],
      "kind": "transition",
      "from": "pointer_target_guard",
      "at": "dns_label_sink",
      "check": [
        "eq",
        "$pointer_target_guard.label_after_ptr",
        "$dns_label_sink.label_after_ptr"
      ]
    },
    {
      "id": "A-LOOP-CURRENT-REACHES-POINTER-TARGET-GUARD",
      "invariants": [
        "E-LOOP-CURRENT-REACHES-POINTER-TARGET-GUARD"
      ],
      "kind": "transition",
      "from": "loop_advance",
      "at": "pointer_target_guard",
      "check": [
        "eq",
        "$loop_advance.current_label_ptr",
        "$pointer_target_guard.label_before_ptr"
      ]
    },
    {
      "id": "A-FIRST-DECODE-NEXT-REACHES-LOOP-CURRENT",
      "invariants": [
        "E-FIRST-DECODE-NEXT-REACHES-LOOP-CURRENT"
      ],
      "kind": "transition",
      "from": "first_decode_result",
      "at": "loop_advance",
      "check": [
        "eq",
        "$first_decode_result.next_label_ptr",
        "$loop_advance.current_label_ptr"
      ]
    }
  ]
