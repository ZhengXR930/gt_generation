      "verified": true,
      "verified_by": "a_loadlabel_eof_must_preserve_label_refcount",
      "fine_trace_step": 4,
      "description": "Premature invalidation of an owner-managed object. When `loadLabel()` hits `EOF`, it frees the embedded `scalebar->label` in place even though ownership still belongs to the partially built `mapObj`, so the later map teardown walks the same label again."
    },
