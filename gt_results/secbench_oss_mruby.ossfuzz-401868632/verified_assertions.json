{
  "schema_version": "verified-assertions-v3",
  "sample_id": "secbench_oss_mruby.ossfuzz-401868632",
  "content_hash": "sha256:e6e19d8d25cba065a914cb32a956f4704577335a1ebc6aaf219ac0191e03eae9",
  "assertions": [
    {
      "id": "A-ROOT",
      "invariants": [
        "I-ROOT-OBLIGATION"
      ],
      "kind": "required",
      "at": "root_progress",
      "check": [
        "eq",
        "$root_progress.step_advances",
        "$root_progress.true_literal"
      ],
      "protects": "store_path"
    },
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK"
      ],
      "kind": "observed",
      "at": "overflow_store",
      "check": [
        "ge",
        "$overflow_store.write_index",
        "$overflow_store.reserved_slots"
      ]
    },
    {
      "id": "A-ROOT-TO-SINK",
      "invariants": [
        "I-ROOT-TO-SINK-VALUE"
      ],
      "kind": "transition",
      "from": "root_progress",
      "at": "overflow_store",
      "check": [
        "eq",
        "$root_progress.begin_int_value",
        "$overflow_store.current_int_value"
      ]
    },
    {
      "id": "A-PTR-TO-SINK",
      "invariants": [
        "I-PTR-TO-SINK"
      ],
      "kind": "transition",
      "from": "capacity_alloc",
      "at": "overflow_store",
      "check": [
        "eq",
        "$capacity_alloc.array_ptr",
        "$overflow_store.write_ptr"
      ]
    },
    {
      "id": "A-CAP-TO-SINK",
      "invariants": [
        "I-CAP-TO-SINK"
      ],
      "kind": "transition",
      "from": "capacity_alloc",
      "at": "overflow_store",
      "check": [
        "eq",
        "$capacity_alloc.reserved_slots",
        "$overflow_store.reserved_slots"
      ]
    }
  ]
}
