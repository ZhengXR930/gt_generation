{
  "sample_id": "osv_ossfuzz_OSV-2025-230",
  "content_hash": "sha256:fb657eb5e733bd397062327309655e0898583b11a9b38232f9adbec54b74ccf2",
  "assertions": [
    {
      "id": "required.frame_offset_stays_at_or_above_bottom_after_real_param_pop",
      "invariants": [
        "root.frame_offset_stays_at_or_above_bottom_after_real_param_pop"
      ],
      "kind": "required",
      "at": "block_param_underflow",
      "check": [
        "ge",
        "$block_param_underflow.frame_offset_ptr",
        "$block_param_underflow.frame_offset_bottom_ptr"
      ],
      "protects": "dummy_param_write"
    },
    {
      "id": "transition.available_param_pass_moves_underflowed_frame_offset_upward",
      "invariants": [
        "edge.available_param_pass_moves_underflowed_frame_offset_upward"
      ],
      "kind": "transition",
      "from": "block_param_underflow",
      "at": "available_param_pass",
      "check": [
        "lt",
        "$block_param_underflow.frame_offset_ptr",
        "$available_param_pass.frame_offset_ptr"
      ]
    },
    {
      "id": "observed.available_param_pass_still_leaves_frame_offset_below_bottom",
      "invariants": [
        "node.available_param_pass_still_leaves_frame_offset_below_bottom"
      ],
      "kind": "observed",
      "at": "available_param_pass",
      "check": [
        "lt",
        "$available_param_pass.frame_offset_ptr",
        "$available_param_pass.frame_offset_bottom_ptr"
      ]
    },
    {
      "id": "transition.adjusted_frame_offset_reaches_dummy_write_sink",
      "invariants": [
        "edge.adjusted_frame_offset_reaches_dummy_write_sink"
      ],
      "kind": "transition",
      "from": "available_param_pass",
      "at": "dummy_param_write",
      "check": [
        "eq",
        "$available_param_pass.frame_offset_ptr",
        "$dummy_param_write.write_ptr"
      ]
    },
    {
      "id": "observed.dummy_write_starts_below_frame_offset_bottom",
      "invariants": [
        "node.dummy_write_starts_below_frame_offset_bottom"
      ],
      "kind": "observed",
      "at": "dummy_param_write",
      "check": [
        "lt",
        "$dummy_param_write.write_ptr",
        "$dummy_param_write.frame_offset_bottom_ptr"
      ]
    }
  ]
}
