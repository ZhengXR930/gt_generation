      "invariants": [
        "I-SINK-CLASS-SENTINEL-READ-PAST-END"
      ],
      "kind": "observed",
      "at": "class_sentinel_probe",
      "check": [
        "gt",
        "$class_sentinel_probe.class_sentinel_end",
        "$class_sentinel_probe.input_size"
      ]
    },
    {
      "id": "A-CLASSES-DESCRIPTOR-TO-CLASS-START",
      "invariants": [
