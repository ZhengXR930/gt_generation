        "$classes_descriptor.class_address",
        "$classes_guard.class_start"
      ]
    },
    {
      "id": "A-CLASS-START-TO-SENTINEL-PROBE",
      "invariants": [
        "E-CLASS-START-TO-SENTINEL-PROBE"
      ],
      "kind": "transition",
      "from": "classes_guard",
      "at": "class_sentinel_probe",
      "check": [
