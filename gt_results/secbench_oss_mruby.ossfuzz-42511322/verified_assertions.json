      ],
      "kind": "required",
      "at": "post_stack_extend",
      "protects": "stack_copy_entry",
      "check": [
        "eq",
        "$post_stack_extend.local_argv",
        "$post_stack_extend.rebased_argv_after"
      ]
    },
    {
      "id": "observed.argv_alias_matches_recorded_stack_offset",
      "invariants": [
        "node.argv_alias_matches_recorded_stack_offset"
      ],
      "kind": "observed",
      "at": "argv_stack_alias",
      "check": [
        "eq",
        "$argv_stack_alias.local_argv",
        "$argv_stack_alias.rebased_argv_before"
      ]
    },
    {
      "id": "observed.stack_extend_moves_vm_stack_base",
      "invariants": [
        "node.stack_extend_moves_vm_stack_base"
      ],
      "kind": "observed",
      "at": "post_stack_extend",
      "check": [
        "ne",
        "$post_stack_extend.stbase_before",
        "$post_stack_extend.stbase_after"
      ]
    },
    {
      "id": "transition.stack_backed_argv_survives_extend_unadjusted",
      "invariants": [
        "edge.stack_backed_argv_survives_extend_unadjusted"
      ],
      "kind": "transition",
      "from": "argv_stack_alias",
      "at": "post_stack_extend",
      "check": [
        "eq",
        "$argv_stack_alias.local_argv",
        "$post_stack_extend.local_argv"
      ]
    },
    {
      "id": "transition.stale_argv_reaches_stack_copy_src",
      "invariants": [
        "edge.stale_argv_reaches_stack_copy_src",
        "node.stack_copy_reads_stale_argv"
      ],
      "kind": "transition",
      "from": "post_stack_extend",
      "at": "stack_copy_entry",
      "check": [
        "eq",
        "$post_stack_extend.local_argv",
        "$stack_copy_entry.src"
      ]
    }
  ]
}
