        "$arg_decode_gate.decode_allowed",
        "$arg_decode_gate.table_fits"
      ],
      "protects": "arg_decode_gate"
    },
    {
      "id": "a_malformed_table_still_reaches_hex_decode",
      "invariants": [
        "e_malformed_table_still_reaches_hex_decode"
      ],
      "kind": "transition",
      "from": "arg_decode_gate",
      "at": "hex_decode_call",
      "check": [
