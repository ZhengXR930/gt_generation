        "$arg_decode_gate.decode_allowed",
        "$hex_decode_call.hex_call_executed"
      ]
    },
    {
      "id": "a_hex_input_base_reaches_base16_decode",
      "invariants": [
        "e_hex_input_base_reaches_base16_decode"
      ],
      "kind": "transition",
      "from": "hex_decode_call",
      "at": "base16_decode_step",
      "check": [
        "eq",
        "$hex_decode_call.hex_input_base_ptr",
        "$base16_decode_step.input_base_ptr"
      ]
    },
    {
      "id": "a_base16_current_byte_reaches_sink",
      "invariants": [
