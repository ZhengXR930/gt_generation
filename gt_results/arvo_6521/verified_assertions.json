{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_6521",
  "content_hash": "sha256:4de453a28b3d811cbd25dde83fca11afcd99449864f3781fe508829b35fdc6d8",
  "assertions": [
    {
      "id": "A-ROOT-INPUT-CHANNELS-WITHIN-LIMIT",
      "invariants": [
        "I-ROOT-INPUT-CHANNELS-WITHIN-LIMIT"
      ],
      "kind": "required",
      "at": "grid_points_guard",
      "check": [
        "le",
        "$grid_points_guard.input_channels",
        "$grid_points_guard.input_channel_limit"
      ],
      "protects": "grid_points_store"
    },
    {
      "id": "A-SINK-GRID-POINT-STORE-INDEX-EXCEEDS-CAPACITY",
      "invariants": [
        "I-SINK-GRID-POINT-STORE-INDEX-EXCEEDS-CAPACITY"
      ],
      "kind": "observed",
      "at": "grid_points_store",
      "check": [
        "ge",
        "$grid_points_store.store_index",
        "$grid_points_store.grid_points_capacity"
      ]
    },
    {
      "id": "A-GUARD-BOUND-ALLOWS-INVALID-STORE",
      "invariants": [
        "I-GUARD-BOUND-ALLOWS-INVALID-STORE"
      ],
      "kind": "transition",
      "from": "grid_points_guard",
      "at": "grid_points_invalid_store",
      "check": [
        "gt",
        "$grid_points_guard.input_channels",
        "$grid_points_invalid_store.store_index"
      ]
    },
    {
      "id": "A-HEADER-BYTE-FLOWS-TO-LOOP-BOUND",
      "invariants": [
        "I-HEADER-BYTE-FLOWS-TO-LOOP-BOUND"
      ],
      "kind": "transition",
      "from": "input_channels_load",
      "at": "grid_points_guard",
      "check": [
        "eq",
        "$input_channels_load.header_input_channels",
        "$grid_points_guard.input_channels"
      ]
    }
  ]
}
