{
  "sample_id": "arvo_42537879",
  "content_hash": "sha256:12f706344408e4efa61dff9b53d584513638b30e3e96275022527af27644e915",
  "assertions": [
    {
      "id": "A-ROOT-CASIC-PACKET-SPAN-FITS-BUFFER",
      "invariants": [
        "I-ROOT-CASIC-PACKET-SPAN-FITS-BUFFER"
      ],
      "kind": "required",
      "at": "casic_length_guard",
      "check": [
        "ge",
        "$casic_length_guard.inbuflen",
        "$casic_length_guard.required_packet_bytes"
      ],
      "protects": "casic_checksum_walk"
    },
    {
      "id": "A-SINK-BRANCH-READS-UNINITIALIZED-CRC_COMPUTED",
      "invariants": [
        "I-SINK-BRANCH-READS-UNINITIALIZED-CRC_COMPUTED"
      ],
      "kind": "observed",
      "at": "casic_branch_sink",
      "check": [
        "gt",
        "$casic_branch_sink.crc_computed_read_bytes",
        "$casic_branch_sink.crc_computed_initialized_prefix_len"
      ]
    },
    {
      "id": "A-CHECKSUM-WALK-REACHES-BRANCH-SINK",
      "invariants": [
        "I-CHECKSUM-WALK-REACHES-BRANCH-SINK"
      ],
      "kind": "transition",
      "from": "casic_checksum_walk",
      "at": "casic_branch_sink",
      "check": [
        "eq",
        "$casic_checksum_walk.crc_computed_slot",
        "$casic_branch_sink.crc_computed_slot"
      ]
    }
  ]
}
