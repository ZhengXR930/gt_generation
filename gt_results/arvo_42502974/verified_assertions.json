{
  "sample_id": "arvo_42502974",
  "content_hash": "sha256:4593c24c0c11219714ac31321bc4d1791aadffadf04c6b439e21811df103a4a2",
  "assertions": [
    {
      "id": "A-ROOT-GENERIC-PARSE-SKIPS-OCTETS",
      "invariants": [
        "I-ROOT-GENERIC-PARSE-SKIPS-OCTETS"
      ],
      "kind": "required",
      "at": "tacacs_parse_gate",
      "check": [
        "ne",
        "$tacacs_parse_gate.da_type",
        "$tacacs_parse_gate.octets_type_literal"
      ],
      "protects": "tacacs_generic_parse_call"
    },
    {
      "id": "A-SINK-BASE16-TABLE-INDEX-OUT-OF-RANGE",
      "invariants": [
        "I-SINK-BASE16-TABLE-INDEX-OUT-OF-RANGE"
      ],
      "kind": "observed",
      "at": "base16_table_sink",
      "check": [
        "ge",
        "$base16_table_sink.table_index",
        "$base16_table_sink.alphabet_valid_entries"
      ]
    },
    {
      "id": "A-RAW-TACACS-VALUE-FLOWS-INTO-OCTETS-PARSER",
      "invariants": [
        "I-RAW-TACACS-VALUE-FLOWS-INTO-OCTETS-PARSER"
      ],
      "kind": "transition",
      "from": "tacacs_parse_gate",
      "at": "octets_hex_dispatch",
      "check": [
        "eq",
        "$tacacs_parse_gate.raw_value_ptr",
        "$octets_hex_dispatch.parser_input_ptr"
      ]
    },
    {
      "id": "A-HEX-PAYLOAD-START-FLOWS-INTO-BASE16-DECODER",
      "invariants": [
        "I-HEX-PAYLOAD-START-FLOWS-INTO-BASE16-DECODER"
      ],
      "kind": "transition",
      "from": "octets_hex_dispatch",
      "at": "base16_pair_state",
      "check": [
        "eq",
        "$octets_hex_dispatch.base16_payload_ptr",
        "$base16_pair_state.input_start_ptr"
      ]
    },
    {
      "id": "A-PAIR-SECOND-BYTE-FLOWS-INTO-BASE16-TABLE-INDEX",
      "invariants": [
        "I-PAIR-SECOND-BYTE-FLOWS-INTO-BASE16-TABLE-INDEX"
      ],
      "kind": "transition",
      "from": "base16_pair_state",
      "at": "base16_table_sink",
      "check": [
        "eq",
        "$base16_pair_state.pair_second_index",
        "$base16_table_sink.table_index"
      ]
    },
    {
      "id": "A-OCTETS-VALUE-TAKES-HEX-DECODE-PATH",
      "invariants": [
        "I-OCTETS-VALUE-TAKES-HEX-DECODE-PATH"
      ],
      "kind": "observed",
      "at": "octets_hex_dispatch",
      "check": [
        "eq",
        "$octets_hex_dispatch.hex_prefix_matches",
        "$octets_hex_dispatch.true_literal"
      ]
    },
    {
      "id": "A-BASE16-PAIR-SECOND-BYTE-OUT-OF-RANGE",
      "invariants": [
        "I-BASE16-PAIR-SECOND-BYTE-OUT-OF-RANGE"
      ],
      "kind": "observed",
      "at": "base16_pair_state",
      "check": [
        "ge",
        "$base16_pair_state.pair_second_index",
        "$base16_pair_state.alphabet_valid_entries"
      ]
    }
  ]
}
