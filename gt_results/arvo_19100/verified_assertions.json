{
  "sample_id": "arvo_19100",
  "content_hash": "sha256:b99b98e3a7490a290cb234620ead6145791bbfffbfaa43d6e70e08c39ea551ec",
  "assertions": [
    {
      "id": "A-ROOT-PAYLOAD-LENGTH-COVERS-TCP-SIGNATURE",
      "invariants": [
        "I-ROOT-PAYLOAD-LENGTH-COVERS-TCP-SIGNATURE"
      ],
      "kind": "required",
      "at": "tcp_signature_guard",
      "check": [
        "gt",
        "$tcp_signature_guard.payload_packet_len",
        4
      ],
      "protects": "tcp_signature_second_byte"
    },
    {
      "id": "A-SINK-SECOND-BYTE-READ-EXCEEDS-PAYLOAD-LENGTH",
      "invariants": [
        "I-SINK-SECOND-BYTE-READ-EXCEEDS-PAYLOAD-LENGTH"
      ],
      "kind": "observed",
      "at": "tcp_signature_second_byte",
      "check": [
        "le",
        "$tcp_signature_second_byte.payload_packet_len",
        "$tcp_signature_second_byte.second_byte_index"
      ]
    },
    {
      "id": "A-GUARD-PAYLOAD-LEN-REACHES-SINK",
      "invariants": [
        "I-GUARD-PAYLOAD-LEN-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "tcp_signature_guard",
      "at": "tcp_signature_second_byte",
      "check": [
        "eq",
        "$tcp_signature_guard.payload_packet_len",
        "$tcp_signature_second_byte.payload_packet_len"
      ]
    },
    {
      "id": "A-FIRST-BYTE-MATCH-ENABLES-SECOND-BYTE-CHECK",
      "invariants": [
        "I-FIRST-BYTE-MATCH-ENABLES-SECOND-BYTE-CHECK"
      ],
      "kind": "transition",
      "from": "tcp_signature_first_byte",
      "at": "tcp_signature_second_byte",
      "check": [
        "eq",
        "$tcp_signature_first_byte.first_signature_byte",
        "$tcp_signature_second_byte.first_signature_byte"
      ]
    },
    {
      "id": "A-PARSER-PAYLOAD-LEN-REACHES-GUARD",
      "invariants": [
        "I-PARSER-PAYLOAD-LEN-REACHES-GUARD"
      ],
      "kind": "transition",
      "from": "payload_len_computed",
      "at": "tcp_signature_guard",
      "check": [
        "eq",
        "$payload_len_computed.payload_packet_len",
        "$tcp_signature_guard.payload_packet_len"
      ]
    },
    {
      "id": "A-FIRST-SIGNATURE-BYTE-MATCHES",
      "invariants": [
        "I-FIRST-SIGNATURE-BYTE-MATCHES"
      ],
      "kind": "observed",
      "at": "tcp_signature_first_byte",
      "check": [
        "eq",
        "$tcp_signature_first_byte.first_signature_byte",
        "$tcp_signature_first_byte.expected_first_signature_byte"
      ]
    }
  ]
}
