{
  "sample_id": "arvo_24528",
  "content_hash": "sha256:8d648df56f23d1cd036a1d69d92b418dd3210b53e00c7e7dbb9e5d92af50f709",
  "assertions": [
    {
      "id": "A-ROOT-MESSAGE-HEADER-LEN-EXACT-BEFORE-MATERIALIZATION",
      "invariants": [
        "I-ROOT-MESSAGE-HEADER-LEN-EXACT"
      ],
      "kind": "required",
      "at": "armor_type_check",
      "check": [
        "eq",
        "$armor_type_check.header_name_len",
        "$armor_type_check.message_literal_len"
      ],
      "protects": "armorhdr_materialized"
    },
    {
      "id": "A-ADMITTED-HEADER-LEN-MATERIALIZES-IN-ARMORHDR",
      "invariants": [
        "I-EDGE-HEADER-LEN-TO-MATERIALIZED",
        "I-NODE-MATERIALIZED-HEADER-LEN"
      ],
      "kind": "transition",
      "from": "armor_type_check",
      "at": "armorhdr_materialized",
      "check": [
        "eq",
        "$armor_type_check.header_name_len",
        "$armorhdr_materialized.header_name_len"
      ]
    },
    {
      "id": "A-MATERIALIZED-HEADER-LEN-REACHES-TRAILER-COPY",
      "invariants": [
        "I-EDGE-MATERIALIZED-HEADER-LEN-TO-TRAILER"
      ],
      "kind": "transition",
      "from": "armorhdr_materialized",
      "at": "trailer_copy",
      "check": [
        "eq",
        "$armorhdr_materialized.header_name_len",
        "$trailer_copy.header_name_len"
      ]
    },
    {
      "id": "A-SINK-TRAILER-COPY-LEN-WRAPS-PAST-HEADER",
      "invariants": [
        "I-SINK-TRAILER-COPY-LEN-WRAPS-PAST-HEADER"
      ],
      "kind": "observed",
      "at": "trailer_copy",
      "check": [
        "gt",
        "$trailer_copy.copy_len",
        "$trailer_copy.header_name_len"
      ]
    }
  ]
}
