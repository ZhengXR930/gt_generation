{
  "sample_id": "arvo_42485335",
  "content_hash": "sha256:9760c0bba5380bf30da51ceaff71f7936e921535f3cfc65e8056750e3df46a5d",
  "assertions": [
    {
      "id": "A-ROOT-TWO-HEX-BYTES-BEFORE-PERCENT-DECODE",
      "invariants": [
        "I-ROOT-TWO-HEX-BYTES-BEFORE-PERCENT-DECODE"
      ],
      "kind": "required",
      "at": "percent_guard",
      "check": [
        "lt",
        "$percent_guard.second_hex_digit_ptr",
        "$percent_guard.end"
      ],
      "protects": "hex_lookahead"
    },
    {
      "id": "A-SINK-FIRST-HEX-LOOKAHEAD-AT-OR-PAST-END",
      "invariants": [
        "I-SINK-FIRST-HEX-LOOKAHEAD-AT-OR-PAST-END"
      ],
      "kind": "observed",
      "at": "hex_lookahead",
      "check": [
        "ge",
        "$hex_lookahead.first_hex_digit_ptr",
        "$hex_lookahead.end"
      ]
    },
    {
      "id": "A-ROOT-FIRST-HEX-LOOKAHEAD-REACHES-SINK",
      "invariants": [
        "I-ROOT-FIRST-HEX-LOOKAHEAD-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "percent_guard",
      "at": "hex_lookahead",
      "check": [
        "eq",
        "$percent_guard.first_hex_digit_ptr",
        "$hex_lookahead.first_hex_digit_ptr"
      ]
    }
  ]
}
