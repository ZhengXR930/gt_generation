{
  "sample_id": "arvo_13359",
  "content_hash": "sha256:8a917ceb8649ca4c25a8fe4f685c33132dc748b0dbc4a7126b18ddbb28dbee2f",
  "assertions": [
    {
      "id": "assert_payload_to_acelen",
      "invariants": [
        "inv_source_zero_payload"
      ],
      "kind": "observed",
      "at": "evt_u32_to_u8_result",
      "check": [
        "eq",
        "$payload_codepoint_count",
        "$ace_len"
      ]
    },
    {
      "id": "assert_acelen_propagation",
      "invariants": [
        "inv_acelen_to_inputlen",
        "inv_acelen_to_inputlen_edge"
      ],
      "kind": "transition",
      "from": "evt_u32_to_u8_result",
      "at": "evt_decode_state",
      "check": [
        "eq",
        "$evt_u32_to_u8_result.ace_len",
        "$evt_decode_state.input_length"
      ]
    },
    {
      "id": "assert_length_guard",
      "invariants": [
        "inv_missing_length_guard"
      ],
      "kind": "required",
      "at": "evt_decode_state",
      "check": [
        "gt",
        "$input_length",
        0
      ],
      "protects": "evt_delim_read"
    }
  ]
}
