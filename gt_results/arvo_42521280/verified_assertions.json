{
  "sample_id": "arvo_42521280",
  "content_hash": "sha256:b70e464d2db8e760ed47e973f44a388b6f805cc876440be70ad6e95607673675",
  "assertions": [
    {
      "id": "a_gnuhash_output_fully_initialized_before_tail_scan",
      "invariants": [
        "r_gnuhash_output_fully_initialized_before_publish"
      ],
      "kind": "required",
      "at": "gnuhash_tail_state",
      "check": [
        "ge",
        "$gnuhash_tail_state.dest_initialized_prefix_len",
        "$gnuhash_tail_state.converted_size"
      ],
      "protects": "string_tail_scan"
    },
    {
      "id": "a_string_tail_scan_reads_past_initialized_prefix",
      "invariants": [
        "n_string_tail_scan_reads_past_initialized_prefix"
      ],
      "kind": "observed",
      "at": "string_tail_scan",
      "check": [
        "gt",
        "$string_tail_scan.required_prefix_len",
        "$string_tail_scan.scan_initialized_prefix_len"
      ]
    },
    {
      "id": "a_gnuhash_output_published_as_data_buf",
      "invariants": [
        "e_gnuhash_output_published_as_data_buf",
        "n_published_converted_gnuhash_buffer"
      ],
      "kind": "transition",
      "from": "gnuhash_tail_state",
      "at": "publish_converted_data",
      "check": [
        "eq",
        "$gnuhash_tail_state.dest_ptr",
        "$publish_converted_data.published_buf"
      ]
    },
    {
      "id": "a_published_data_buf_reaches_string_tail_scan",
      "invariants": [
        "e_published_data_buf_reaches_string_tail_scan"
      ],
      "kind": "transition",
      "from": "publish_converted_data",
      "at": "string_tail_scan",
      "check": [
        "eq",
        "$publish_converted_data.published_buf",
        "$string_tail_scan.scan_buf"
      ]
    }
  ]
}
