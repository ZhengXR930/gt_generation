{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42483783",
  "content_hash": "sha256:3fd2b87c9a65bb5c022e50f23122a8dac49627f7bfdbbab3890385f5dffcc2b2",
  "assertions": [
    {
      "id": "A-ROOT-REGEX-OFFSET-IN-RANGE",
      "invariants": [
        "I-ROOT-REGEX-OFFSET-IN-RANGE"
      ],
      "kind": "required",
      "at": "regex_guard",
      "check": [
        "ge",
        "$regex_guard.nbytes",
        "$regex_guard.offset"
      ],
      "protects": "regex_memchr_sink"
    },
    {
      "id": "A-SINK-MEMCHR-READS-UNINITIALIZED-REGION",
      "invariants": [
        "I-SINK-MEMCHR-READS-UNINITIALIZED-REGION"
      ],
      "kind": "observed",
      "at": "regex_memchr_sink",
      "check": [
        "gt",
        "$regex_memchr_sink.scan_remaining_bytes",
        "$regex_memchr_sink.scan_initialized_prefix_len"
      ]
    },
    {
      "id": "A-OFFSET-REACHES-REGEX-WINDOW",
      "invariants": [
        "I-OFFSET-REACHES-REGEX-WINDOW"
      ],
      "kind": "transition",
      "from": "regex_guard",
      "at": "regex_window",
      "check": [
        "eq",
        "$regex_guard.offset",
        "$regex_window.offset"
      ]
    },
    {
      "id": "A-OUT-OF-RANGE-WINDOW-REACHES-MEMCHR",
      "invariants": [
        "I-OUT-OF-RANGE-WINDOW-REACHES-MEMCHR"
      ],
      "kind": "transition",
      "from": "regex_window",
      "at": "regex_memchr_sink",
      "check": [
        "eq",
        "$regex_window.window_start_ptr",
        "$regex_memchr_sink.scan_start_ptr"
      ]
    },
    {
      "id": "A-REGEX-WINDOW-STARTS-PAST-INPUT-END",
      "invariants": [
        "I-REGEX-WINDOW-STARTS-PAST-INPUT-END"
      ],
      "kind": "observed",
      "at": "regex_window",
      "check": [
        "gt",
        "$regex_window.window_start_ptr",
        "$regex_window.input_end_ptr"
      ]
    }
  ]
}
