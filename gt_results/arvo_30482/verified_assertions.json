        "I-ROOT-A1-ALLOC-COVERS-HIGH-HALF"
      ],
      "kind": "required",
      "at": "a1_high_half_state",
      "check": [
        "ge",
        "$a1_high_half_state.a1_alloc",
        "$a1_high_half_state.a1_used"
      ],
      "protects": "trim_top_digit_sink"
    },
    {
      "id": "A-SINK-TRIM-READS-UNINITIALIZED-TOP-DIGIT",
      "invariants": [
        "I-SINK-TRIM-READS-UNINITIALIZED-TOP-DIGIT"
      ],
      "kind": "observed",
      "at": "trim_top_digit_sink",
      "check": [
        "gt",
        "$trim_top_digit_sink.top_digit_bytes",
        "$trim_top_digit_sink.top_digit_init_prefix_len"
      ]
    },
    {
      "id": "A-A1-OBJECT-TO-GROW-OBJECT",
      "invariants": [
        "I-A1-OBJECT-TO-GROW-OBJECT"
      ],
      "kind": "transition",
      "from": "a1_high_half_state",
      "at": "grow_top_digit_state",
      "check": [
        "eq",
        "$a1_high_half_state.a1_bn",
        "$grow_top_digit_state.result_bn"
      ]
    },
    {
      "id": "A-HIGH-HALF-LEN-TO-GROW-REQUEST",
      "invariants": [
        "I-HIGH-HALF-LEN-TO-GROW-REQUEST"
      ],
      "kind": "transition",
      "from": "a1_high_half_state",
      "at": "grow_top_digit_state",
      "check": [
        "eq",
        "$a1_high_half_state.a1_used",
        "$grow_top_digit_state.grow_digits"
      ]
    },
    {
      "id": "A-GROWN-TOP-DIGIT-TO-TAIL-COPY",
      "invariants": [
        "I-GROWN-TOP-DIGIT-TO-TAIL-COPY"
      ],
      "kind": "transition",
      "from": "grow_top_digit_state",
      "at": "tail_copy_top_digit",
      "check": [
        "eq",
        "$grow_top_digit_state.top_digit_ptr",
        "$tail_copy_top_digit.tail_src_ptr"
      ]
    },
    {
      "id": "A-TAIL-COPY-TO-TRIM-SINK",
      "invariants": [
        "I-TAIL-COPY-TO-TRIM-SINK"
      ],
      "kind": "transition",
      "from": "tail_copy_top_digit",
