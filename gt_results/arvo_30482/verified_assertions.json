      "check": [
        "eq",
        "$tail_copy_top_digit.tail_dst_ptr",
        "$trim_top_digit_sink.top_digit_ptr"
      ]
    },
    {
      "id": "A-GROW-TOP-DIGIT-UNINITIALIZED",
      "invariants": [
        "I-GROW-TOP-DIGIT-UNINITIALIZED"
      ],
      "kind": "observed",
      "at": "grow_top_digit_state",
      "check": [
        "gt",
        "$grow_top_digit_state.top_digit_bytes",
        "$grow_top_digit_state.top_digit_init_prefix_len"
      ]
    },
    {
      "id": "A-TAIL-COPY-ALIASES-GROWN-TOP-DIGIT",
      "invariants": [
        "I-TAIL-COPY-ALIASES-GROWN-TOP-DIGIT"
      ],
      "kind": "observed",
      "at": "tail_copy_top_digit",
      "check": [
        "eq",
        "$tail_copy_top_digit.tail_src_ptr",
        "$tail_copy_top_digit.tail_dst_ptr"
      ]
    }
  ]
