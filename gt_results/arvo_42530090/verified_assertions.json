{
  "sample_id": "arvo_42530090",
  "content_hash": "sha256:46af100006fd672489dc315a53a0d0a366293fe264bb1b69cd458be4003d0a33",
  "assertions": [
    {
      "id": "A-ROOT-GREV1-CONSTRUCT-REQUIRES-FULL-HEADER",
      "invariants": [
        "R-GREV1-CONSTRUCT-REQUIRES-FULL-HEADER"
      ],
      "kind": "required",
      "at": "grev1_guard",
      "check": [
        "ge",
        "$grev1_guard.payload_len",
        "$grev1_guard.gre1_header_size"
      ],
      "protects": "grev1_payloadlength_store"
    },
    {
      "id": "A-SINK-PAYLOADLENGTH-STORE-EXCEEDS-AVAILABLE-TAIL",
      "invariants": [
        "N-SINK-PAYLOADLENGTH-STORE-EXCEEDS-AVAILABLE-TAIL"
      ],
      "kind": "observed",
      "at": "grev1_payloadlength_store",
      "check": [
        "gt",
        "$grev1_payloadlength_store.payload_length_field_size",
        "$grev1_payloadlength_store.available_tail_len"
      ]
    },
    {
      "id": "A-GREV1-CONSTRUCT-LEN-REACHES-PAYLOADLENGTH-STORE",
      "invariants": [
        "E-GREV1-CONSTRUCT-LEN-REACHES-PAYLOADLENGTH-STORE"
      ],
      "kind": "transition",
      "from": "grev1_guard",
      "at": "grev1_payloadlength_store",
      "check": [
        "eq",
        "$grev1_guard.payload_len",
        "$grev1_payloadlength_store.layer_data_len"
      ]
    }
  ]
}
