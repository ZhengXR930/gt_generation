      ],
      "kind": "required",
      "at": "socket_sendvec_vla",
      "check": [
        "gt",
        "$socket_sendvec_vla.cnt",
        "$socket_sendvec_vla.zero_literal"
      ]
    },
    {
      "id": "A-SINK-SENDVEC-VLA-USES-ZERO-COUNT",
      "invariants": [
        "I-SINK-SENDVEC-VLA-USES-ZERO-COUNT"
      ],
      "kind": "observed",
      "at": "socket_sendvec_vla",
      "check": [
        "eq",
        "$socket_sendvec_vla.cnt",
        "$socket_sendvec_vla.zero_literal"
      ]
    },
    {
      "id": "A-HTTP1-ZERO-BUFCNT-REACHES-SENDVEC-COUNT",
      "invariants": [
        "I-HTTP1-ZERO-BUFCNT-TO-SENDVEC-COUNT"
      ],
      "kind": "transition",
      "from": "http1_sendvec_call",
      "at": "socket_sendvec_vla",
      "check": [
        "eq",
        "$http1_sendvec_call.bufcnt",
        "$socket_sendvec_vla.cnt"
      ]
    },
    {
      "id": "A-PROXY-ZERO-VECCNT-REACHES-HTTP1-INBUFCNT",
