      "check": [
        "eq",
        "$proxy_do_send.veccnt",
        "$http1_sendvec_call.inbufcnt"
      ]
    },
    {
      "id": "A-HTTP1-FINALOSTREAM-CALLS-SENDVEC-WITH-ZERO-BUFCNT",
      "invariants": [
        "I-HTTP1-FINALOSTREAM-CALLS-SENDVEC-WITH-ZERO-BUFCNT"
      ],
      "kind": "observed",
      "at": "http1_sendvec_call",
      "check": [
        "eq",
        "$http1_sendvec_call.bufcnt",
        "$http1_sendvec_call.zero_literal"
      ]
    },
    {
      "id": "A-PROXY-FINAL-SEND-DERIVES-ZERO-VECCNT",
      "invariants": [
        "I-PROXY-FINAL-SEND-DERIVES-ZERO-VECCNT"
      ],
      "kind": "observed",
      "at": "proxy_do_send",
      "check": [
