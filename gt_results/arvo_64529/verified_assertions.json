  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_64529",
  "content_hash": "sha256:ca6f0c042a7512ba65f5182a5b788c075bbb399c9908824fff2857177ea0f00e",
  "assertions": [
    {
      "id": "A-ROOT-LIST-ENTRY-READ-LEN-FITS-STACK-ENTRY",
      "invariants": [
        "I-ROOT-LIST-ENTRY-READ-LEN-FITS-STACK-ENTRY"
      ],
      "kind": "required",
      "at": "list_entry_read",
      "check": [
        "le",
        "$list_entry_read.read_len",
        "$list_entry_read.entry_bytes"
      ],
      "protects": "io_memory_prefill"
    },
    {
      "id": "A-READ-LEN-TO-PREFILL-LEN",
      "invariants": [
        "I-READ-LEN-TO-PREFILL-LEN",
        "I-SINK-IO-MEMORY-PREFILL"
      ],
      "kind": "transition",
      "from": "list_entry_read",
      "at": "io_memory_prefill",
      "check": [
        "eq",
        "$list_entry_read.read_len",
        "$io_memory_prefill.prefill_len"
      ]
    },
    {
      "id": "A-ENTRY-BUFFER-TO-BUF-ARG",
      "invariants": [
        "I-ENTRY-BUFFER-TO-BUF-ARG"
      ],
      "kind": "transition",
      "from": "list_entry_read",
      "at": "io_memory_prefill",
      "check": [
        "eq",
        "$list_entry_read.entry_buf",
        "$io_memory_prefill.buf_arg"
      ]
    }
  ]
}
