    },
    {
      "id": "A-SECOND-NIBBLE-SIGN-EXTENDS",
      "invariants": [
        "I-SECOND-NIBBLE-SIGN-EXTENDS"
      ],
      "kind": "observed",
      "at": "percent_decode_second_nibble",
      "check": [
