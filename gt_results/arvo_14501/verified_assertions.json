      ],
      "kind": "required",
      "at": "hex_lookup",
      "check": [
        "lt",
        "$hex_lookup.lookup_index",
        "$hex_lookup.table_size"
      ],
      "protects": "hex_lookup"
    },
    {
      "id": "A-SINK-HEX-LOOKUP-INDEX-OUT-OF-RANGE",
      "invariants": [
        "I-SINK-HEX-LOOKUP-INDEX-OUT-OF-RANGE"
      ],
      "kind": "observed",
      "at": "hex_lookup",
      "check": [
        "ge",
        "$hex_lookup.lookup_index",
        "$hex_lookup.table_size"
      ]
    },
    {
      "id": "A-SECOND-NIBBLE-BYTE-REACHES-HEX-LOOKUP",
      "invariants": [
        "I-SECOND-NIBBLE-BYTE-REACHES-HEX-LOOKUP"
      ],
      "kind": "transition",
      "from": "percent_decode_second_nibble",
      "at": "hex_lookup",
      "check": [
