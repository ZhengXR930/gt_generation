  "assertions": [
    {
      "id": "a_unicode_escape_must_fit_remaining_space",
      "invariants": [
        "r_unicode_escape_must_fit_remaining_space"
      ],
      "kind": "required",
      "at": "unicode_escape_guard",
      "check": [
        "ge",
        "$unicode_escape_guard.remaining_before_unicode_escape",
        "$unicode_escape_guard.unicode_escape_len"
      ],
      "protects": "control_escape_sink"
    },
    {
      "id": "a_unicode_copy_offset_becomes_written_budget",
      "invariants": [
        "e_unicode_copy_offset_becomes_written_budget",
        "n_overlong_unicode_escape_copy",
        "n_written_exceeds_available_after_unicode_escape"
      ],
      "kind": "transition",
      "from": "unicode_escape_copy",
      "at": "post_unicode_escape_budget",
      "check": [
        "eq",
        "$unicode_escape_copy.cursor_offset_after_unicode_escape",
        "$post_unicode_escape_budget.written_after_unicode_escape"
      ]
    },
    {
      "id": "a_overrun_written_reaches_control_escape_sink",
      "invariants": [
        "e_overrun_written_reaches_control_escape_sink",
        "n_control_escape_copy_sink"
      ],
      "kind": "transition",
      "from": "post_unicode_escape_budget",
      "at": "control_escape_sink",
      "check": [
        "eq",
        "$post_unicode_escape_budget.written_after_unicode_escape",
        "$control_escape_sink.written_before_control_escape"
      ]
    }
  ]
