{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_31332",
  "content_hash": "sha256:1e849bb05fa6c97c5257981b5b35bff42b67ea74ceff06df3a2d8ed2bb00a38c",
  "assertions": [
    {
      "id": "a_ordered_digit_scan_reaches_text_end",
      "invariants": [
        "n_ordered_digit_scan_reaches_text_end"
      ],
      "kind": "observed",
      "at": "ordered_digit_scan",
      "check": [
        "eq",
        "$ordered_digit_scan.off_after_digits",
        "$ordered_digit_scan.text_size"
      ]
    },
    {
      "id": "a_ordered_digit_scan_off_reaches_root_guard",
      "invariants": [
        "e_ordered_digit_scan_off_reaches_root_guard"
      ],
      "kind": "transition",
      "from": "ordered_digit_scan",
      "at": "ordered_delimiter_guard",
      "check": [
        "eq",
        "$ordered_digit_scan.off_after_digits",
        "$ordered_delimiter_guard.off"
      ]
    },
    {
      "id": "a_root_off_stays_below_text_size",
      "invariants": [
        "r_off_stays_below_text_size_before_delimiter_probe"
      ],
      "kind": "required",
      "at": "ordered_delimiter_guard",
      "check": [
        "lt",
        "$ordered_delimiter_guard.off",
        "$ordered_delimiter_guard.text_size"
      ],
      "protects": "ordered_delimiter_probe"
    },
    {
      "id": "a_root_guard_off_reaches_sink_probe",
      "invariants": [
        "e_root_guard_off_reaches_sink_probe"
      ],
      "kind": "transition",
      "from": "ordered_delimiter_guard",
      "at": "ordered_delimiter_probe",
      "check": [
        "eq",
        "$ordered_delimiter_guard.off",
        "$ordered_delimiter_probe.access_index"
      ]
    },
    {
      "id": "a_sink_probe_reads_at_or_past_text_end",
      "invariants": [
        "n_sink_probe_reads_at_or_past_text_end"
      ],
      "kind": "observed",
      "at": "ordered_delimiter_probe",
      "check": [
        "ge",
        "$ordered_delimiter_probe.access_index",
        "$ordered_delimiter_probe.text_size"
      ]
    }
  ]
}
