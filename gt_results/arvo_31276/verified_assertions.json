      ],
      "kind": "required",
      "at": "outer_attr_guard",
      "check": [
        "eq",
        "$outer_attr_guard.array_attr_masked",
        0
      ],
      "protects": "outer_attr_redecode"
    },
    {
      "id": "a_ff_filled_first_nested_pvalue_reaches_nested_dispatch",
      "invariants": [
        "e_ff_filled_first_nested_pvalue_reaches_nested_dispatch",
        "n_outer_redecode_first_nested_pvalue_ff_filled"
      ],
      "kind": "transition",
      "from": "outer_attr_redecode",
      "at": "nested_attr_dispatch",
      "check": [
        "eq",
        "$outer_attr_redecode.first_nested_pvalue",
        "$nested_attr_dispatch.inner_pvalue"
      ]
    },
    {
      "id": "a_nested_dispatch_pointer_reaches_byte_write_sink",
      "invariants": [
        "e_nested_dispatch_pointer_reaches_byte_write_sink",
        "n_nested_attr_dispatch_uses_corrupted_pvalue",
