  "assertions": [
    {
      "id": "A-SINK-STRCMP-READS-PAST-INITIALIZED-PREFIX",
      "invariants": [
        "N-SINK-STRCMP-READS-PAST-INITIALIZED-PREFIX"
      ],
      "kind": "observed",
      "at": "choice_name_dispatch",
      "check": [
        "gt",
        "$choice_name_dispatch.cmp_bytes",
        "$choice_name_dispatch.init_prefix_len"
      ]
    },
    {
      "id": "A-DECL-TO-STATE-PARTIAL-INITIALIZATION",
      "invariants": [
        "R-MISSING-STR-INITIALIZATION",
        "E-DECL-TO-STATE-PARTIAL-INITIALIZATION"
      ],
      "kind": "transition",
      "from": "choice_name_decl",
      "at": "choice_name_state",
      "check": [
        "gt",
        "$choice_name_decl.sizeof_str",
        "$choice_name_state.init_prefix_len"
      ]
    },
    {
      "id": "A-STATE-TO-DISPATCH-SAME-STR-STORAGE",
      "invariants": [
        "E-STATE-TO-DISPATCH-SAME-STR-STORAGE"
      ],
      "kind": "transition",
      "from": "choice_name_state",
      "at": "choice_name_dispatch",
      "check": [
        "eq",
        "$choice_name_state.choice_name_ptr",
        "$choice_name_dispatch.choice_name_ptr"
      ]
    }
  ]
