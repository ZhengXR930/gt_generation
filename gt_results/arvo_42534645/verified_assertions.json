{
  "sample_id": "arvo_42534645",
  "content_hash": "sha256:e7ceaf518929558d393b600ed05960090a2b3a669a65ff5ea65629469fe0342d",
  "assertions": [
    {
      "id": "A-ROOT-STREAM-TYPE-GUID-FITS-REMAINING-PAYLOAD",
      "invariants": [
        "I-ROOT-STREAM-TYPE-GUID-FITS-REMAINING-PAYLOAD"
      ],
      "kind": "required",
      "at": "stream_type_root_guard",
      "check": [
        "ge",
        "$stream_type_root_guard.remaining_payload_bytes",
        "$stream_type_root_guard.guid_bytes"
      ],
      "protects": "stream_type_guid_parse"
    },
    {
      "id": "A-SINK-GUID-PARSE-USES-SHORT-BUFFER",
      "invariants": [
        "I-SINK-GUID-PARSE-USES-SHORT-BUFFER"
      ],
      "kind": "observed",
      "at": "stream_type_guid_parse",
      "check": [
        "gt",
        "$stream_type_guid_parse.guid_bytes",
        "$stream_type_guid_parse.stream_type_bytes"
      ]
    },
    {
      "id": "A-SHORT-GUID-READ-TO-GUID-PARSE",
      "invariants": [
        "I-SHORT-GUID-READ-TO-GUID-PARSE"
      ],
      "kind": "transition",
      "from": "stream_type_short_read",
      "at": "stream_type_guid_parse",
      "check": [
        "eq",
        "$stream_type_short_read.stream_type_ptr",
        "$stream_type_guid_parse.guid_argument_ptr"
      ]
    },
    {
      "id": "A-SHORT-GUID-READ-RETURNS-TRUNCATED-DATABUF",
      "invariants": [
        "I-SHORT-GUID-READ-RETURNS-TRUNCATED-DATABUF"
      ],
      "kind": "observed",
      "at": "stream_type_short_read",
      "check": [
        "gt",
        "$stream_type_short_read.guid_bytes",
        "$stream_type_short_read.stream_type_bytes"
      ]
    },
    {
      "id": "A-REMAINING-BYTES-TO-SHORT-GUID-READ",
      "invariants": [
        "I-REMAINING-BYTES-TO-SHORT-GUID-READ"
      ],
      "kind": "transition",
      "from": "stream_type_root_guard",
      "at": "stream_type_short_read",
      "check": [
        "eq",
        "$stream_type_root_guard.remaining_payload_bytes",
        "$stream_type_short_read.stream_type_bytes"
      ]
    }
  ]
}
