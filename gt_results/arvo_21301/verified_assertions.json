{
  "sample_id": "arvo_21301",
  "content_hash": "sha256:3a1dd6ba7791744ecc7f59a757251b17f8fe433d2f025634f6740529348aff5c",
  "assertions": [
    {
      "id": "A-ROOT-FREAD-READS-FULL-MAGIC",
      "invariants": [
        "I-ROOT-FREAD-READS-FULL-MAGIC"
      ],
      "kind": "required",
      "at": "doseps_magic_guard",
      "check": [
        "eq",
        "$doseps_magic_guard.read_count",
        "$doseps_magic_guard.magic_bytes"
      ],
      "protects": "doseps_second_byte_compare"
    },
    {
      "id": "A-SINK-SECOND-BYTE-COMPARE-RUNS-AFTER-SHORT-READ",
      "invariants": [
        "I-SINK-SECOND-BYTE-COMPARE-RUNS-AFTER-SHORT-READ"
      ],
      "kind": "observed",
      "at": "doseps_second_byte_compare",
      "check": [
        "gt",
        "$doseps_second_byte_compare.magic_bytes",
        "$doseps_second_byte_compare.read_count"
      ]
    },
    {
      "id": "A-SHORT-READ-COUNT-REACHES-SECOND-BYTE-COMPARE",
      "invariants": [
        "I-SHORT-READ-COUNT-REACHES-SECOND-BYTE-COMPARE"
      ],
      "kind": "transition",
      "from": "doseps_magic_guard",
      "at": "doseps_second_byte_compare",
      "check": [
        "eq",
        "$doseps_magic_guard.read_count",
        "$doseps_second_byte_compare.read_count"
      ]
    }
  ]
}
