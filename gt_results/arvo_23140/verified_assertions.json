{
  "sample_id": "arvo_23140",
  "content_hash": "sha256:ecd84138ead345ba76e44e615103dde8c655e3b877ef6c130feb00ae8d3e601f",
  "assertions": [
    {
      "id": "A-ROOT-ARGV1-TYPE-MUST-BE-UNDEF",
      "invariants": [
        "I-ROOT-ARGV1-TYPE-MUST-BE-UNDEF"
      ],
      "kind": "required",
      "at": "attr_alloc",
      "check": [
        "eq",
        "$attr_alloc.argv1_type_info",
        "$attr_alloc.undef_type_literal"
      ],
      "protects": "slot_cleanup"
    },
    {
      "id": "A-CLEANUP-USES-NONUNDEF-ARGV1",
      "invariants": [
        "I-CLEANUP-USES-NONUNDEF-ARGV1"
      ],
      "kind": "observed",
      "at": "slot_cleanup",
      "check": [
        "ne",
        "$slot_cleanup.slot_type_info",
        "$slot_cleanup.undef_type_literal"
      ]
    },
    {
      "id": "A-ARGV1-SLOT-REACHES-CLEANUP",
      "invariants": [
        "I-ARGV1-SLOT-REACHES-CLEANUP"
      ],
      "kind": "transition",
      "from": "attr_alloc",
      "at": "slot_cleanup",
      "check": [
        "eq",
        "$attr_alloc.argv1_addr",
        "$slot_cleanup.slot_addr"
      ]
    },
    {
      "id": "A-REF-ARGUMENT-REACHES-GC-DELREF",
      "invariants": [
        "I-REF-ARGUMENT-REACHES-GC-DELREF",
        "I-SINK-GC-DELREF-USES-ARGV1-REF"
      ],
      "kind": "transition",
      "from": "slot_cleanup",
      "at": "gc_delref_sink",
      "check": [
        "eq",
        "$slot_cleanup.ref_argument",
        "$gc_delref_sink.gc_argument"
      ]
    }
  ]
}
