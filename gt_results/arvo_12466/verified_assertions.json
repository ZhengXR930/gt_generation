{
  "sample_id": "arvo_12466",
  "content_hash": "sha256:bdf4be935b0edd6b48120e6973d030cf82a314066dbe22b75bf6045c4e24189f",
  "assertions": [
    {
      "id": "A-ROOT-ZERO-FILL-WRITE-INDEX-IN-BOUNDS",
      "invariants": [
        "I-ROOT-ZERO-FILL-WRITE-INDEX-IN-BOUNDS"
      ],
      "kind": "required",
      "at": "zero_fill_guard",
      "check": [
        "lt",
        "$zero_fill_guard.write_index_before",
        "$zero_fill_guard.bit_length_capacity"
      ],
      "protects": "zero_fill_sink"
    },
    {
      "id": "A-ZERO-FILL-RUN-EXCEEDS-REMAINING-SLOTS",
      "invariants": [
        "I-ZERO-FILL-RUN-EXCEEDS-REMAINING-SLOTS"
      ],
      "kind": "observed",
      "at": "zero_fill_guard",
      "check": [
        "gt",
        "$zero_fill_guard.zero_run_length",
        "$zero_fill_guard.remaining_slots_before_write"
      ]
    },
    {
      "id": "A-ZERO-FILL-WRITE-INDEX-REACHES-SINK",
      "invariants": [
        "E-ZERO-FILL-WRITE-INDEX-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "zero_fill_guard",
      "at": "zero_fill_sink",
      "check": [
        "eq",
        "$zero_fill_guard.write_index_before",
        "$zero_fill_sink.store_index_before"
      ]
    },
    {
      "id": "A-SINK-ZERO-FILL-STORE-PAST-BIT-LENGTH-END",
      "invariants": [
        "I-SINK-ZERO-FILL-STORE-PAST-BIT-LENGTH-END"
      ],
      "kind": "observed",
      "at": "zero_fill_sink",
      "check": [
        "ge",
        "$zero_fill_sink.store_index_before",
        "$zero_fill_sink.bit_length_capacity"
      ]
    }
  ]
}
