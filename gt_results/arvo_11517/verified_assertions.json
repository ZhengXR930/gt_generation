{
  "sample_id": "arvo_11517",
  "content_hash": "sha256:054d82ef0673b6a0aa70f7657d3cc0161d12bb24a4215cd494ae7219dcbaabde",
  "assertions": [
    {
      "id": "A-ROOT-CHUNK-GUARD-MATCHES-NONPOSITIVE-REQUIREMENT",
      "invariants": [
        "I-ROOT-NONPOSITIVE-MDIF-MUST-CLAMP"
      ],
      "kind": "required",
      "at": "mdif_guard",
      "check": [
        "eq",
        "$mdif_guard.actual_clamp_condition",
        "$mdif_guard.required_clamp_condition"
      ],
      "protects": "mdif_guard"
    },
    {
      "id": "A-SINK-LOAD-INDEX-EXCEEDS-AVAILABLE-TOP-RANGE",
      "invariants": [
        "I-SINK-UNCHECKED-LOAD-USES-OUT-OF-RANGE-INDEX"
      ],
      "kind": "observed",
      "at": "unchecked_load_pair",
      "check": [
        "gt",
        "$unchecked_load_pair.load_start_index",
        "$unchecked_load_pair.max_base_x"
      ]
    },
    {
      "id": "A-ROOT-CHUNK-INDEX-REACHES-UNCHECKED-LOAD",
      "invariants": [
        "E-ROOT-CHUNK-INDEX-REACHES-UNCHECKED-LOAD"
      ],
      "kind": "transition",
      "from": "mdif_guard",
      "at": "unchecked_load_pair",
      "check": [
        "eq",
        "$mdif_guard.load_start_index",
        "$unchecked_load_pair.load_start_index"
      ]
    },
    {
      "id": "A-ABOVE-ROW-ALIAS-REACHES-UNCHECKED-LOAD",
      "invariants": [
        "E-ABOVE-ROW-ALIAS-REACHES-UNCHECKED-LOAD",
        "N_EVENT_above_row_dispatch"
      ],
      "kind": "transition",
      "from": "above_row_dispatch",
      "at": "unchecked_load_pair",
      "check": [
        "eq",
        "$above_row_dispatch.above_row_ptr",
        "$unchecked_load_pair.above_ptr"
      ]
    }
  ]
}
