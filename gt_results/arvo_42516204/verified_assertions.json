{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42516204",
  "content_hash": "sha256:c4283042d09c2ad4faf9706f67d9bd2839cb7a9338346f223707796b8818e429",
  "assertions": [
    {
      "id": "A-ROOT-GZIP-FLAG-ACCESS-REQUIRES-IN-BOUNDS-INDEX",
      "invariants": [
        "R-GZIP-FLAG-ACCESS-REQUIRES-IN-BOUNDS-INDEX"
      ],
      "kind": "required",
      "at": "gzip_flag_guard",
      "check": [
        "lt",
        "$gzip_flag_guard.flag_index",
        "$gzip_flag_guard.input_len"
      ],
      "protects": "gzip_flag_read"
    },
    {
      "id": "A-SINK-GZIP-FLAG-INDEX-EXCEEDS-INPUT-LEN",
      "invariants": [
        "N-SINK-GZIP-FLAG-INDEX-EXCEEDS-INPUT-LEN"
      ],
      "kind": "observed",
      "at": "gzip_flag_read",
      "check": [
        "ge",
        "$gzip_flag_read.flag_index",
        "$gzip_flag_read.input_len"
      ]
    },
    {
      "id": "A-ZMAGIC-LEN-FLOWS-INTO-FROZEN-DISPATCH",
      "invariants": [
        "E-ZMAGIC-LEN-FLOWS-INTO-FROZEN-DISPATCH"
      ],
      "kind": "transition",
      "from": "zmagic_gzip_call",
      "at": "frozen_dispatch",
      "check": [
        "eq",
        "$zmagic_gzip_call.input_len",
        "$frozen_dispatch.input_len"
      ]
    },
    {
      "id": "A-FROZEN-DISPATCH-LEN-FLOWS-INTO-GZIP-GUARD",
      "invariants": [
        "E-FROZEN-DISPATCH-LEN-FLOWS-INTO-GZIP-GUARD"
      ],
      "kind": "transition",
      "from": "frozen_dispatch",
      "at": "gzip_flag_guard",
      "check": [
        "eq",
        "$frozen_dispatch.input_len",
        "$gzip_flag_guard.input_len"
      ]
    },
    {
      "id": "A-GZIP-GUARD-HEADER-PTR-FLOWS-INTO-FLAG-READ",
      "invariants": [
        "E-GZIP-GUARD-HEADER-PTR-FLOWS-INTO-FLAG-READ"
      ],
      "kind": "transition",
      "from": "gzip_flag_guard",
      "at": "gzip_flag_read",
      "check": [
        "eq",
        "$gzip_flag_guard.header_ptr",
        "$gzip_flag_read.header_ptr"
      ]
    }
  ]
}
