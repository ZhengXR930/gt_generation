{
  "sample_id": "arvo_48362",
  "content_hash": "sha256:0bd4213717106a04c8ad5932513c0a0c12cd50dfd5203409069ca71d4696ac03",
  "assertions": [
    {
      "id": "a_root_proxy_uri_len_must_be_positive_before_path_probe",
      "invariants": [
        "r_proxy_uri_len_must_be_positive_before_path_probe"
      ],
      "kind": "required",
      "at": "proxy_uri_root",
      "check": [
        "gt",
        "$proxy_uri_root.input_len",
        "$proxy_uri_root.zero_literal"
      ],
      "protects": "uri_path_probe"
    },
    {
      "id": "a_uri_path_probe_executes_with_zero_len",
      "invariants": [
        "n_uri_path_probe_executes_with_zero_len"
      ],
      "kind": "observed",
      "at": "uri_path_probe",
      "check": [
        "eq",
        "$uri_path_probe.remaining_len",
        "$uri_path_probe.zero_literal"
      ]
    },
    {
      "id": "a_forwarded_proxy_uri_len_reaches_path_probe",
      "invariants": [
        "e_forwarded_proxy_uri_len_reaches_path_probe",
        "N_EVENT_proxy_uri_forward"
      ],
      "kind": "transition",
      "from": "proxy_uri_forward",
      "at": "uri_path_probe",
      "check": [
        "eq",
        "$proxy_uri_forward.proxy_uri_len",
        "$uri_path_probe.remaining_len"
      ]
    },
    {
      "id": "a_forwarded_proxy_uri_ptr_reaches_path_probe",
      "invariants": [
        "e_forwarded_proxy_uri_ptr_reaches_path_probe"
      ],
      "kind": "transition",
      "from": "proxy_uri_forward",
      "at": "uri_path_probe",
      "check": [
        "eq",
        "$proxy_uri_forward.proxy_uri_ptr",
        "$uri_path_probe.probe_ptr"
      ]
    }
  ]
}
