{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_17147",
  "content_hash": "sha256:95680adec38fd6029a561167ea09c632c9b515841f7f086413dd1935b2400b33",
  "assertions": [
    {
      "id": "A-ROOT-NETWORK-DATA-LENGTH-FITS-BASE-TLV",
      "invariants": [
        "I-ROOT-NETWORK-DATA-LENGTH-FITS-BASE-TLV"
      ],
      "kind": "required",
      "at": "fill_network_data_bound",
      "check": [
        "le",
        "$fill_network_data_bound.network_data_length",
        "$fill_network_data_bound.base_tlv_max_length"
      ],
      "protects": "append_network_data_size"
    },
    {
      "id": "A-LENGTH-REACHES-APPEND-SIZE",
      "invariants": [
        "I-LENGTH-REACHES-APPEND-SIZE"
      ],
      "kind": "transition",
      "from": "fill_network_data_bound",
      "at": "append_network_data_size",
      "check": [
        "eq",
        "$fill_network_data_bound.network_data_length",
        "$append_network_data_size.stored_length"
      ]
    },
    {
      "id": "A-APPEND-SIZE-EXCEEDS-TLV-OBJECT",
      "invariants": [
        "I-APPEND-SIZE-EXCEEDS-TLV-OBJECT"
      ],
      "kind": "observed",
      "at": "append_network_data_size",
      "check": [
        "gt",
        "$append_network_data_size.append_size",
        "$append_network_data_size.tlv_object_size"
      ]
    },
    {
      "id": "A-INFLATED-APPEND-SIZE-REACHES-WRITE",
      "invariants": [
        "I-INFLATED-APPEND-SIZE-REACHES-WRITE"
      ],
      "kind": "transition",
      "from": "append_network_data_size",
      "at": "message_write_sink",
      "check": [
        "eq",
        "$append_network_data_size.append_size",
        "$message_write_sink.tracked_append_size"
      ]
    },
    {
      "id": "A-SINK-WRITE-READ-END-EXCEEDS-TLV-END",
      "invariants": [
        "I-SINK-WRITE-READ-END-EXCEEDS-TLV-END"
      ],
      "kind": "observed",
      "at": "message_write_sink",
      "check": [
        "gt",
        "$message_write_sink.copy_end_ptr",
        "$message_write_sink.tlv_end_ptr"
      ]
    }
  ]
}
