{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_58786",
  "content_hash": "sha256:59a42fcf9801a647a4bd4323b8341f078b258a7059e90c329b9ecb3c4f3dc1ee",
  "assertions": [
    {
      "id": "A-ROOT-NOTE-SIZE-COVERS-DESC-START",
      "invariants": [
        "I-ROOT-NOTE-SIZE-COVERS-DESC-START"
      ],
      "kind": "required",
      "at": "geometry_guard",
      "check": [
        "ge",
        "$geometry_guard.size",
        "$geometry_guard.desc_start"
      ],
      "protects": "build_id_name_compare"
    },
    {
      "id": "A-NOTE-NAME-STARTS-AT-NOTE-END",
      "invariants": [
        "I-NOTE-NAME-STARTS-AT-NOTE-END"
      ],
      "kind": "observed",
      "at": "note_name_materialized",
      "check": [
        "eq",
        "$note_name_materialized.note_name",
        "$note_name_materialized.last"
      ]
    },
    {
      "id": "A-GUARD-ADMITTED-WRAPPED-SIZE-REACHES-NOTE-NAME",
      "invariants": [
        "I-GUARD-ADMITTED-WRAPPED-SIZE-REACHES-NOTE-NAME"
      ],
      "kind": "transition",
      "from": "geometry_guard",
      "at": "note_name_materialized",
      "check": [
        "eq",
        "$geometry_guard.size",
        "$note_name_materialized.size"
      ]
    },
    {
      "id": "A-NOTE-NAME-POINTER-FLOWS-TO-MEMCMP",
      "invariants": [
        "I-NOTE-NAME-POINTER-FLOWS-TO-MEMCMP",
        "I-SINK-MEMCMP-READS-MATERIALIZED-NOTE-NAME"
      ],
      "kind": "transition",
      "from": "note_name_materialized",
      "at": "build_id_name_compare",
      "check": [
        "eq",
        "$note_name_materialized.note_name",
        "$build_id_name_compare.note_name"
      ]
    }
  ]
}
