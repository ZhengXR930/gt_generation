{
  "sample_id": "osv_ossfuzz_OSV-2026-703",
  "content_hash": "sha256:02b8befa39df3eafd53e52f98dc1b55aa4d17ad93bd7003ebbdf08f6b47518bf",
  "assertions": [
    {
      "id": "required.ptr_recomputed_after_coercion",
      "kind": "required",
      "at": "sink_write",
      "check": [
        "eq",
        "$sink_write.ptr",
        "$sink_write.current_ptr"
      ],
      "protects": "sink_write",
      "invariants": [
        "N_ROOT"
      ]
    },
    {
      "id": "observed.updated_typed_array_base",
      "kind": "observed",
      "at": "typed_array_update",
      "check": [
        "eq",
        "$typed_array_update.updated_ptr",
        "$typed_array_update.current_data_offset"
      ],
      "invariants": [
        "N_UPDATE"
      ]
    },
    {
      "id": "observed.stale_ptr_used_at_sink",
      "kind": "observed",
      "at": "sink_write",
      "check": [
        "ne",
        "$sink_write.ptr",
        "$sink_write.current_ptr"
      ],
      "invariants": [
        "N_SINK"
      ]
    },
    {
      "id": "transition.updated_base_to_sink_current_ptr",
      "kind": "transition",
      "from": "typed_array_update",
      "at": "sink_write",
      "check": [
        "eq",
        "$typed_array_update.updated_ptr",
        "$sink_write.current_ptr"
      ],
      "invariants": [
        "E_UPDATE_TO_SINK"
      ]
    }
  ]
}
