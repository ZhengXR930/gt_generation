    {
      "invariant_id": "r_version_scheme_accessor_width_within_item_width",
      "role": "root_cause",
      "file": "libfwupdplugin/fu-coswid-common.c",
      "function": "fu_coswid_read_version_scheme",
      "line": 108,
      "operands": [
        "cbor_get_uint16(item)",
        "cbor_int_get_width(item)"
      ],
      "relation": {
        "op": "le",
        "left": "cbor_get_uint16(item)",
        "right": "cbor_int_get_width(item)"
      },
      "verified": true,
      "verified_by": "a_version_scheme_accessor_width_within_item_width",
      "fine_trace_step": 14,
      "description": "The version-scheme reader enforces only the coarse predicate `cbor_isa_uint(item)` and then unconditionally chooses the 16-bit accessor. It never checks that the decoded CBOR integer actually has `width == CBOR_INT_16`, so one-byte integers still reach `cbor_get_uint16`."
    },
    {
      "invariant_id": "n_uint16_sink_reads_wider_than_item",
      "role": "sink",
      "file": "libcbor/src/cbor/ints.c",
      "function": "cbor_get_uint16",
      "line": 24,
      "operands": [
        "cbor_int_get_width(item)",
        "cbor_get_uint16(item)"
      ],
      "relation": {
        "op": "lt",
        "left": "cbor_int_get_width(item)",
        "right": "cbor_get_uint16(item)"
      },
      "verified": true,
      "verified_by": "a_uint16_sink_reads_wider_than_item",
      "fine_trace_step": 15,
      "description": "ASan crash site. `cbor_get_uint16` reads two bytes from `item->data` even though the value object created for the witness was allocated by `cbor_new_int8()` with only one byte of integer storage."
    },
    {
