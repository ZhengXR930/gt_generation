{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42490511",
  "content_hash": "sha256:b2aeea8783a94aca215b4a77be4f038d5b889563ebae035cbbfd9fd30a7c19ef",
  "assertions": [
    {
      "id": "a_parsed_seconds_must_be_finite_before_days_in_year_lookup",
      "invariants": [
        "r_parsed_seconds_must_be_finite_before_days_in_year_lookup"
      ],
      "kind": "required",
      "at": "seconds_materialize",
      "check": [
        "eq",
        "$seconds_materialize.seconds_isfinite",
        1
      ],
      "protects": "days_in_year_sink"
    },
    {
      "id": "a_parsed_seconds_reach_constructor_state",
      "invariants": [
        "e_parsed_seconds_reach_constructor_state",
        "n_constructor_state_uses_parsed_seconds"
      ],
      "kind": "transition",
      "from": "seconds_materialize",
      "at": "constructor_state",
      "check": [
        "eq",
        "$seconds_materialize.seconds_repr",
        "$constructor_state.seconds_repr"
      ]
    },
    {
      "id": "a_constructor_days_reach_ordinal_wrapper",
      "invariants": [
        "e_constructor_days_reach_ordinal_wrapper",
        "n_ordinal_wrapper_receives_constructor_days"
      ],
      "kind": "transition",
      "from": "constructor_state",
      "at": "ordinal_adjust",
      "check": [
        "eq",
        "$constructor_state.days_after_ctor",
        "$ordinal_adjust.days_before_ordinal"
      ]
    },
    {
      "id": "a_post_ordinal_days_reach_days_in_year_lookup",
      "invariants": [
        "e_post_ordinal_days_reach_days_in_year_lookup",
        "n_post_ordinal_days_reach_days_in_year_lookup"
      ],
      "kind": "transition",
      "from": "ordinal_adjust",
      "at": "days_in_year_sink",
      "check": [
        "eq",
        "$ordinal_adjust.days_after_ordinal",
        "$days_in_year_sink.datetime_days"
      ]
    },
    {
      "id": "a_days_in_year_sink_uses_negative_month_index",
      "invariants": [
        "n_days_in_year_sink_uses_negative_month_index"
      ],
      "kind": "observed",
      "at": "days_in_year_sink",
      "check": [
        "lt",
        "$days_in_year_sink.month_index",
        "$days_in_year_sink.zero_literal"
      ]
    }
  ]
}
