  "assertions": [
    {
      "id": "A_ROOT_TYPE_TAG",
      "kind": "required",
      "at": "root",
      "protects": "sink",
      "mechanism": "other",
      "invariants": [
        "N_ROOT"
      ],
      "description": "Before comparing the chromaticities union payloads, the looked-up base-part and current-part attributes must both carry the EXR_ATTR_CHROMATICITIES type tag.",
      "check": [
        "eq",
        "$root.types_match_chromaticities",
        "$root.true_literal"
      ]
    },
    {
      "id": "A_SINK_LOOKUPS_SUCCEEDED",
      "kind": "observed",
      "at": "sink",
      "invariants": [
        "N_SINK"
      ],
      "description": "In the vulnerable crashing execution, the memcmp sink is only reached after both chromaticities name lookups have succeeded.",
      "check": [
        "eq",
        "$sink.rv",
        "$sink.rv1"
      ]
    }
  ]
}
