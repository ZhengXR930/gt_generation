      },
      "verified": true,
      "verified_by": "a_property_buffer_ptr_flows_to_debug_print",
      "fine_trace_step": 12,
      "description": "ASan sink. The active debug print passes raw SummaryInformation property bytes to `%s`, so `printf` reads past the 253-byte payload and continues through the 8704-byte heap-backed stream buffer until it reaches the redzone."
    }
