{
  "sample_id": "arvo_21998",
  "content_hash": "sha256:340af52448fbb3cafed62ab54423ca6d524e3785e4c32784028bc6a00daca15b",
  "assertions": [
    {
      "id": "A-ROOT-REFERENCED-CAPTURE-MUST-MARK-USED",
      "invariants": [
        "I-ROOT-REFERENCED-CAPTURE-MUST-MARK-USED"
      ],
      "kind": "required",
      "at": "look_behind_used_check",
      "check": [
        "ge",
        "$look_behind_used_check.used_after_check",
        "$look_behind_used_check.node_is_referenced"
      ],
      "protects": "look_behind_used_check"
    },
    {
      "id": "A-ROOT-CAPTURE-REACHES-FREE",
      "invariants": [
        "I-ROOT-CAPTURE-REACHES-FREE",
        "I-REFERENCED-CAPTURE-FREED"
      ],
      "kind": "transition",
      "from": "look_behind_used_check",
      "at": "free_referenced_capture",
      "check": [
        "eq",
        "$look_behind_used_check.capture_ptr",
        "$free_referenced_capture.freed_capture_ptr"
      ]
    },
    {
      "id": "A-FREED-CAPTURE-REACHES-CALL-BODY-LOAD",
      "invariants": [
        "I-FREED-CAPTURE-REACHES-CALL-BODY-LOAD",
        "I-STALE-CALL-BODY-LOAD"
      ],
      "kind": "transition",
      "from": "free_referenced_capture",
      "at": "stale_call_body_load",
      "check": [
        "eq",
        "$free_referenced_capture.freed_capture_ptr",
        "$stale_call_body_load.call_body_ptr"
      ]
    },
    {
      "id": "A-CALL-BODY-POINTER-REACHES-SINK",
      "invariants": [
        "I-CALL-BODY-POINTER-REACHES-SINK",
        "I-SINK-TYPE-READ"
      ],
      "kind": "transition",
      "from": "stale_call_body_load",
      "at": "sink_type_read",
      "check": [
        "eq",
        "$stale_call_body_load.call_body_ptr",
        "$sink_type_read.node_ptr"
      ]
    }
  ]
}
