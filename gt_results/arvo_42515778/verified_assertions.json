  "assertions": [
    {
      "id": "A-ROOT-LEFT-NEIGHBOR-LOOKUP-SUCCEEDS",
      "invariants": [
        "I-ROOT-LEFT-NEIGHBOR-LOOKUP-SUCCEEDS"
      ],
      "kind": "required",
      "at": "left_neighbor_lookup",
      "check": [
        "eq",
        "$left_neighbor_lookup.lookup_error",
        "$left_neighbor_lookup.zero_literal"
      ],
      "protects": "left_neighbor_owner_cmp"
    },
    {
      "id": "A-SINK-COMPARE-RUNS-AFTER-FAILED-LEFT-LOOKUP",
      "invariants": [
        "I-SINK-COMPARE-RUNS-AFTER-FAILED-LEFT-LOOKUP"
      ],
      "kind": "observed",
      "at": "left_neighbor_owner_cmp",
      "check": [
        "ne",
        "$left_neighbor_owner_cmp.lookup_error",
        "$left_neighbor_owner_cmp.zero_literal"
      ]
    },
    {
      "id": "A-LEFT-NEIGHBOR-OUT-SLOT-REACHES-COMPARE",
      "invariants": [
        "I-LEFT-NEIGHBOR-OUT-SLOT-REACHES-COMPARE"
      ],
      "kind": "transition",
      "from": "left_neighbor_lookup",
      "at": "left_neighbor_owner_cmp",
      "check": [
        "eq",
        "$left_neighbor_lookup.out_slot",
        "$left_neighbor_owner_cmp.compared_slot"
      ]
    }
  ]
}
