{
  "backend": "local_workspace",
  "image": "gt-memory-env:latest",
  "workdir": "/gt/_work/src",
  "executable": "/gt/_work/out/libicalvcard_fuzzer",
  "arguments": [
    "{poc}"
  ],
  "environment": {
    "MSAN_OPTIONS": "halt_on_error=1:exitcode=1"
  },
  "input_placeholder": "{poc}",
  "source": "runtime_spec.json",
  "build_workdir": "/gt/_work/src",
  "source_repo": "https://github.com/libical/libical",
  "source_commit": "276b8bd4449add4e6a6192cb554299b69069a7e8",
  "run_timeout": 45,
  "build_commands": [
    "mkdir -p /gt/_work/src/build /gt/_work/out",
    "cd /gt/_work/src/build && cmake .. -DCMAKE_BUILD_TYPE=Debug -DLIBICAL_STATIC=ON -DLIBICAL_GLIB=False -DLIBICAL_GLIB_BUILD_DOCS=False -DLIBICAL_GOBJECT_INTROSPECTION=False -DLIBICAL_JAVA_BINDINGS=False -DLIBICAL_BUILD_TESTING=False -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ -DCMAKE_C_FLAGS=\"-O1 -gline-tables-only -DFUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION -fsanitize=memory -fsanitize-memory-track-origins=2 -fno-omit-frame-pointer\" -DCMAKE_CXX_FLAGS=\"-O1 -gline-tables-only -DFUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION -fsanitize=memory -fsanitize-memory-track-origins=2 -fno-omit-frame-pointer\" -DCMAKE_EXE_LINKER_FLAGS=\"-fsanitize=memory -fsanitize-memory-track-origins=2\" -DCMAKE_SHARED_LINKER_FLAGS=\"-fsanitize=memory -fsanitize-memory-track-origins=2\" >/tmp/libical_cmake.log && cmake --build . -j2 >/tmp/libical_build.log",
    "clang++ -O1 -gline-tables-only -DFUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION -fsanitize=memory -fsanitize-memory-track-origins=2 -fno-omit-frame-pointer -I/gt/_work/src/src -I/gt/_work/src/build/src -I/gt/_work/src/src/libical -I/gt/_work/src/src/libicalvcard -I/gt/_work/src/build/src/libical -I/gt/_work/src/build/src/libicalvcard /gt/runtime_support/libicalvcard_repro.cc /gt/_work/src/build/lib/libicalvcard.a /gt/_work/src/build/lib/libical.a -licui18n -licuuc -licudata -o /gt/_work/out/libicalvcard_fuzzer"
  ]
}
