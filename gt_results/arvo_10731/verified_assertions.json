{
  "sample_id": "arvo_10731",
  "content_hash": "sha256:0da924616be43a9e4c63515a177acd59c36be6edc61f3f5b84ad5d04ed5008eb",
  "assertions": [
    {
      "id": "A-ROOT-NONEMPTY-SET",
      "invariants": [
        "I-ROOT-NONEMPTY-BEFORE-MASKED-READ"
      ],
      "kind": "required",
      "at": "non_eq_guard",
      "check": [
        "gt",
        "$non_eq_guard.n_values",
        "$non_eq_guard.zero_literal"
      ],
      "protects": "masked_flag_read"
    },
    {
      "id": "A-SINK-EMPTY-SET-READ",
      "invariants": [
        "I-SINK-EMPTY-SET-AT-MASKED-READ"
      ],
      "kind": "observed",
      "at": "masked_flag_read",
      "check": [
        "eq",
        "$masked_flag_read.n_values",
        "$masked_flag_read.zero_literal"
      ]
    },
    {
      "id": "A-GUARD-COUNT-TO-SINK",
      "invariants": [
        "I-GUARD-COUNT-REACHES-MASKED-READ"
      ],
      "kind": "transition",
      "from": "non_eq_guard",
      "at": "masked_flag_read",
      "check": [
        "eq",
        "$non_eq_guard.n_values",
        "$masked_flag_read.n_values"
      ]
    },
    {
      "id": "A-MACRO-MEMBER-COUNT-TO-GUARD",
      "invariants": [
        "I-MACRO-MEMBER-COUNT-REACHES-GUARD",
        "N_EVENT_addr_set_expand"
      ],
      "kind": "transition",
      "from": "addr_set_expand",
      "at": "non_eq_guard",
      "check": [
        "eq",
        "$addr_set_expand.addr_set_member_count",
        "$non_eq_guard.n_values"
      ]
    }
  ]
}
