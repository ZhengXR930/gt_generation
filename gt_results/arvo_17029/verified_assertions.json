{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_17029",
  "content_hash": "sha256:3d0335a9a254fb3e8ec9dc52422d513735f646b898e15782792799ad09105e38",
  "assertions": [
    {
      "id": "A-ROOT",
      "invariants": [
        "I-ROOT-OBLIGATION"
      ],
      "kind": "required",
      "at": "slice_slot_acquire",
      "check": [
        "eq",
        "$slice_slot_acquire.header_cleared",
        1
      ],
      "protects": "slice_refresh_gate"
    },
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK"
      ],
      "kind": "observed",
      "at": "st_foll_store",
      "check": [
        "ge",
        "$st_foll_store.write_index",
        "$st_foll_store.max_dpb_size"
      ]
    },
    {
      "id": "A-REFRESH-TO-REFLIST",
      "invariants": [
        "I-REFRESH-TO-REFLIST"
      ],
      "kind": "transition",
      "from": "slice_refresh_gate",
      "at": "ref_tuple_select",
      "check": [
        "eq",
        "$slice_refresh_gate.short_term_ref_pic_set_sps_flag",
        "$ref_tuple_select.short_term_ref_pic_set_sps_flag"
      ]
    },
    {
      "id": "A-REFLIST-TO-LOOP",
      "invariants": [
        "I-REFLIST-TO-LOOP"
      ],
      "kind": "transition",
      "from": "ref_tuple_select",
      "at": "positive_loop_entry",
      "check": [
        "eq",
        "$ref_tuple_select.total_short_refs",
        "$positive_loop_entry.total_short_refs"
      ]
    },
    {
      "id": "A-LOOP-TO-SINK",
      "invariants": [
        "I-LOOP-TO-SINK"
      ],
      "kind": "transition",
      "from": "positive_loop_entry",
      "at": "st_foll_store",
      "check": [
        "eq",
        "$positive_loop_entry.write_index",
        "$st_foll_store.write_index"
      ]
    }
  ]
}
