+static bool arch_checkWait(run_t* run) {
+    /* All queued wait events must be tested when SIGCHLD was delivered */
+    for (;;) {
+        int status;
+        pid_t pid = TEMP_FAILURE_RETRY(wait4(run->pid, &status, WNOHANG, NULL));
