{
  "sample_id": "arvo_19509",
  "content_hash": "sha256:1ef7c2858db6390e2d6c336705974bfe45afd4910c842bfbb7d914edcff22ddf",
  "assertions": [
    {
      "id": "A-ROOT-MULTIVOLUME-WINDOW-UPDATE-GUARDED",
      "invariants": [
        "I-ROOT-MULTIVOLUME-WINDOW-UPDATE-GUARDED"
      ],
      "kind": "required",
      "at": "window_update",
      "check": [
        "eq",
        "$window_update.switch_multivolume",
        0
      ],
      "protects": "window_update"
    },
    {
      "id": "A-CONTINUATION-WINDOW-MASK-REACHES-COPY-STRING",
      "invariants": [
        "I-CONTINUATION-WINDOW-MASK-REACHES-COPY-STRING",
        "I-SINK-COPY-STRING-USES-CONTINUATION-WINDOW-MASK"
      ],
      "kind": "transition",
      "from": "window_update",
      "at": "copy_string_window_use",
      "check": [
        "eq",
        "$window_update.window_mask_after_update",
        "$copy_string_window_use.current_window_mask"
      ]
    },
    {
      "id": "A-INITIAL-WINDOW-BUF-PERSISTS-TO-COPY-STRING",
      "invariants": [
        "I-INITIAL-WINDOW-BUF-PERSISTS-TO-COPY-STRING",
        "N_EVENT_window_alloc"
      ],
      "kind": "transition",
      "from": "window_alloc",
      "at": "copy_string_window_use",
      "check": [
        "eq",
        "$window_alloc.window_buf_ptr",
        "$copy_string_window_use.window_buf_ptr"
      ]
    },
    {
      "id": "A-INITIAL-WINDOW-SIZE-TO-OOB-READ-IDX",
      "invariants": [
        "I-INITIAL-WINDOW-SIZE-TO-OOB-READ-IDX",
        "I-SINK-READ-IDX-EXCEEDS-INITIAL-WINDOW-SIZE"
      ],
      "kind": "transition",
      "from": "window_alloc",
      "at": "copy_string_indexed_read",
      "check": [
        "lt",
        "$window_alloc.allocated_window_size",
        "$copy_string_indexed_read.read_idx"
      ]
    }
  ]
}
