{
  "sample_id": "arvo_17006",
  "content_hash": "sha256:c5e1adf947140b5934d37c0d16bc07790ce6d8ba7da82aa400e625ea0910a415",
  "assertions": [
    {
      "id": "A-ROOT",
      "invariants": [
        "I-ROOT-ZERO-INITIALIZE-AI1-OFFSET-Y"
      ],
      "kind": "required",
      "at": "offset_decl",
      "check": [
        "eq",
        "$offset_decl.zero_init",
        1
      ],
      "protects": "class2_load"
    },
    {
      "id": "A-SINK",
      "invariants": [
        "I-SINK-CLASS2-FULL-WIDTH-LOAD"
      ],
      "kind": "observed",
      "at": "class2_load",
      "check": [
        "gt",
        "$class2_load.load_bytes",
        "$class2_load.written_bytes"
      ]
    },
    {
      "id": "A-DECL-TO-MATERIALIZE",
      "invariants": [
        "I-DECL-TO-MATERIALIZE-TAIL-REMAINS-UNWRITTEN"
      ],
      "kind": "transition",
      "from": "offset_decl",
      "at": "offset_materialize",
      "check": [
        "gt",
        "$offset_decl.table_bytes",
        "$offset_materialize.written_bytes"
      ]
    },
    {
      "id": "A-MATERIALIZE-TO-DISPATCH",
      "invariants": [
        "I-MATERIALIZE-TO-DISPATCH-TABLE-POINTER",
        "N_EVENT_luma_dispatch"
      ],
      "kind": "transition",
      "from": "offset_materialize",
      "at": "luma_dispatch",
      "check": [
        "eq",
        "$offset_materialize.offset_table",
        "$luma_dispatch.offset_argument"
      ]
    },
    {
      "id": "A-DISPATCH-TO-SINK",
      "invariants": [
        "I-DISPATCH-TO-SINK-HELPER-ARG-ALIAS"
      ],
      "kind": "transition",
      "from": "luma_dispatch",
      "at": "class2_load",
      "check": [
        "eq",
        "$luma_dispatch.offset_argument",
        "$class2_load.load_argument"
      ]
    }
  ]
}
