{
  "schema_version": "assertion-spec-v3",
  "sample_id": "arvo_16081",
  "original_case": "original",
  "content_hash": "sha256:98f4341e568a5396e2732e1b741b567aba32d0e551f5060c758ce7eb1d42b301",
  "assertions": [
    {
      "id": "A_root",
      "invariants": ["root_data_refresh"],
      "kind": "required",
      "at": "post_rcb",
      "protects": "sink",
      "check": ["eq", "$post_rcb.data_ptr", "$post_rcb.ctx_data_ptr"]
    },
    {
      "id": "A_realloc_mutation",
      "invariants": ["N_realloc"],
      "kind": "observed",
      "at": "realloc",
      "check": ["ne", "$realloc.ctx_data_before", "$realloc.ctx_data_after"]
    },
    {
      "id": "A_capture_to_realloc",
      "invariants": ["E_capture_to_realloc"],
      "kind": "transition",
      "from": "capture",
      "at": "realloc",
      "check": ["eq", "$capture.data_ptr", "$realloc.ctx_data_before"]
    },
    {
      "id": "A_realloc_to_sink",
      "invariants": ["E_realloc_to_sink"],
      "kind": "transition",
      "from": "realloc",
      "at": "sink",
      "check": ["eq", "$realloc.ctx_data_before", "$sink.data_ptr"]
    }
  ]
}
