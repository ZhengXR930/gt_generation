{
  "sample_id": "arvo_42475665",
  "content_hash": "sha256:21d3ae6d9e7be54e4b5789c4668ef4abbb9db9752fae2e1f2f89cedfac208f78",
  "assertions": [
    {
      "id": "REQ_index_uses_groups_count",
      "invariants": [
        "root_obligation"
      ],
      "kind": "required",
      "at": "second_group_assign",
      "check": [
        "eq",
        "$second_group_assign.write_index",
        "$second_group_assign.groups_count_before"
      ],
      "protects": "second_group_assign"
    },
    {
      "id": "OBS_groups_count_reaches_two",
      "invariants": [
        "corruption_state"
      ],
      "kind": "observed",
      "at": "after_second_group_assign",
      "check": [
        "eq",
        "$after_second_group_assign.groups_count",
        "$after_second_group_assign.expected_groups_count"
      ]
    },
    {
      "id": "TRANS_wrong_index_leaves_groups1_unwritten",
      "invariants": [
        "root_to_corruption"
      ],
      "kind": "transition",
      "from": "second_group_assign",
      "at": "after_second_group_assign",
      "check": [
        "eq",
        "$second_group_assign.write_index",
        "$after_second_group_assign.actual_write_target"
      ]
    },
    {
      "id": "OBS_uninitialized_id_at_sink",
      "invariants": [
        "sink_state"
      ],
      "kind": "observed",
      "at": "sink_use",
      "check": [
        "ne",
        "$sink_use.id_value",
        "$sink_use.valid_group_sentinel"
      ]
    },
    {
      "id": "TRANS_unwritten_slot_propagates_to_sink",
      "invariants": [
        "corruption_to_sink"
      ],
      "kind": "transition",
      "from": "after_second_group_assign",
      "at": "sink_use",
      "check": [
        "eq",
        "$after_second_group_assign.groups1_value",
        "$sink_use.id_value"
      ]
    }
  ]
}
