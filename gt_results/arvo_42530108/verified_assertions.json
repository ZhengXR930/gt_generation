{
  "sample_id": "arvo_42530108",
  "content_hash": "sha256:76992006954d94192ca281afb1b22185cbd5c59427c41bf4de20a5ce429c1a6e",
  "assertions": [
    {
      "id": "a_full_sd_extent_must_fit_payload_before_entry_parse",
      "invariants": [
        "r_full_sd_extent_must_fit_payload_before_entry_parse"
      ],
      "kind": "required",
      "at": "sd_extent_guard",
      "check": [
        "ge",
        "$sd_extent_guard.dataLen",
        "$sd_extent_guard.required_extent"
      ],
      "protects": "entry_parse_begin"
    },
    {
      "id": "a_second_ttl_read_end_exceeds_sd_layer_len",
      "invariants": [
        "n_second_ttl_read_end_exceeds_sd_layer_len"
      ],
      "kind": "observed",
      "at": "ttl_sink",
      "check": [
        "gt",
        "$ttl_sink.ttl_read_end",
        "$ttl_sink.layer_data_len"
      ]
    },
    {
      "id": "a_wrapped_next_entry_pointer_reaches_ttl_read",
      "invariants": [
        "e_wrapped_next_entry_pointer_reaches_ttl_read"
      ],
      "kind": "transition",
      "from": "first_entry_advance",
      "at": "ttl_sink",
      "check": [
        "eq",
        "$first_entry_advance.entry_ptr_after",
        "$ttl_sink.entry_ptr"
      ]
    },
    {
      "id": "a_declared_entries_len_reaches_first_remaining_len",
      "invariants": [
        "e_declared_entries_len_reaches_first_remaining_len"
      ],
      "kind": "transition",
      "from": "sd_extent_guard",
      "at": "first_entry_advance",
      "check": [
        "eq",
        "$sd_extent_guard.lenEntries",
        "$first_entry_advance.remainingLen_before"
      ]
    },
    {
      "id": "a_first_entry_advance_wraps_remaining_len",
      "invariants": [
        "n_first_entry_advance_wraps_remaining_len"
      ],
      "kind": "observed",
      "at": "first_entry_advance",
      "check": [
        "gt",
        "$first_entry_advance.remainingLen_after",
        "$first_entry_advance.remainingLen_before"
      ]
    }
  ]
}
