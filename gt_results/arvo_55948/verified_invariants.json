    {
      "invariant_id": "r_zero_store_index_within_tmp_extent",
      "role": "root_cause",
      "file": "lib/util_mosq.c",
      "function": "mosquitto__hex2bin",
      "line": 181,
      "operands": [
        "start",
        "bin_max_len"
      ],
      "relation": {
        "op": "lt",
        "left": "start",
        "right": "bin_max_len"
      },
      "verified": true,
      "verified_by": "A-ROOT-START-WITHIN-BIN-MAX-LEN",
      "fine_trace_step": 7,
      "description": "Root cause. The leading-zero loop writes one output byte for every matching `\"00\"` pair but never checks that those in-loop writes stay within `bin_max_len`, so more than 20 leading zero bytes overflow the fixed SHA1 scratch buffer before the later BIGNUM-size guard executes."
    },
    {
      "invariant_id": "n_overflowing_zero_store_uses_out_of_bounds_index",
      "role": "sink",
      "file": "lib/util_mosq.c",
      "function": "mosquitto__hex2bin",
      "line": 185,
      "operands": [
        "bin_max_len",
        "start"
      ],
      "relation": {
        "op": "le",
        "left": "bin_max_len",
        "right": "start"
      },
      "verified": true,
      "verified_by": "A-SINK-ZERO-STORE-INDEX-OUT-OF-BOUNDS",
      "fine_trace_step": 8,
      "description": "AddressSanitizer sink. On the 21st matching leading-zero pair, this store writes one byte past the 20-byte stack buffer `tmp` provided by `mosquitto__hex2bin_sha1()`."
    },
    {
      "invariant_id": "n_sha1_wrapper_passes_tmp_as_bin",
      "role": "intermediate",
      "file": "lib/util_mosq.c",
      "function": "mosquitto__hex2bin_sha1",
      "line": 159,
      "fine_trace_step": 5,
      "description": "`mosquitto__hex2bin_sha1()` passes stack buffer `tmp` as the `bin` argument to `mosquitto__hex2bin()`, so the in-loop stores operate on the same 20-byte object AddressSanitizer names as the overflow target.",
      "verified": true,
      "verified_by": "A-TMP-POINTER-FLOWS-TO-ZERO-STORE",
      "operands": [
        "bin",
        "tmp"
      ],
      "relation": {
        "op": "eq",
        "left": "bin",
        "right": "tmp"
      }
    }
  ],
