{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_55948",
  "content_hash": "sha256:05b2b8fe140ce0a0984759026226679ddb6ecd704e17af8eb2d8a55e3839c6c5",
  "assertions": [
    {
      "id": "A-ROOT-START-WITHIN-BIN-MAX-LEN",
      "invariants": [
        "r_zero_store_index_within_tmp_extent"
      ],
      "kind": "required",
      "at": "zero_store_pre",
      "check": [
        "lt",
        "$zero_store_pre.start_index",
        "$zero_store_pre.bin_max_len"
      ],
      "protects": "zero_store"
    },
    {
      "id": "A-SINK-ZERO-STORE-INDEX-OUT-OF-BOUNDS",
      "invariants": [
        "n_overflowing_zero_store_uses_out_of_bounds_index"
      ],
      "kind": "observed",
      "at": "zero_store",
      "check": [
        "ge",
        "$zero_store.store_index",
        "$zero_store.bin_max_len"
      ]
    },
    {
      "id": "A-STORE-INDEX-PROPAGATES-TO-SINK",
      "invariants": [
        "e_store_index_carries_to_sink_write"
      ],
      "kind": "transition",
      "from": "zero_store_pre",
      "at": "zero_store",
      "check": [
        "eq",
        "$zero_store_pre.start_index",
        "$zero_store.store_index"
      ]
    },
    {
      "id": "A-TMP-POINTER-FLOWS-TO-ZERO-STORE",
      "invariants": [
        "n_sha1_wrapper_passes_tmp_as_bin",
        "e_tmp_pointer_flows_to_zero_store"
      ],
      "kind": "transition",
      "from": "sha1_call",
      "at": "zero_store",
      "check": [
        "eq",
        "$sha1_call.tmp_ptr",
        "$zero_store.bin_ptr"
      ]
    }
  ]
}
