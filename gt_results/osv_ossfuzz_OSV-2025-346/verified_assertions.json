{
  "sample_id": "osv_ossfuzz_OSV-2025-346",
  "content_hash": "sha256:ad4299cd81b3a2fde7f491635fa13b6625f554715eea0b600c951c8a092a5d31",
  "assertions": [
    {
      "id": "a_for_in_operand_must_be_object_before_unchecked_cast",
      "invariants": [
        "inv_root_for_in_operand_is_object"
      ],
      "kind": "required",
      "at": "build_for_in_root",
      "check": [
        "eq",
        "$build_for_in_root.obj_is_object",
        "$build_for_in_root.required_object_value"
      ]
    },
    {
      "id": "a_emitted_for_in_opcode_reaches_dispatch",
      "invariants": [
        "inv_edge_emit_to_dispatch_opcode",
        "N_EVENT_parse_emit_for_in_start",
        "N_EVENT_callinternal_for_in_dispatch"
      ],
      "kind": "transition",
      "from": "parse_emit_for_in_start",
      "at": "callinternal_for_in_dispatch",
      "check": [
        "eq",
        "$parse_emit_for_in_start.emitted_opcode",
        "$callinternal_for_in_dispatch.dispatched_opcode"
      ]
    },
    {
      "id": "a_unchecked_cast_result_reaches_fast_array_read",
      "invariants": [
        "inv_edge_root_to_sink_pointer",
        "inv_edge_root_to_sink_pointer_edge"
      ],
      "kind": "transition",
      "from": "build_for_in_root",
      "at": "build_for_in_sink",
      "check": [
        "eq",
        "$build_for_in_root.cast_pointer",
        "$build_for_in_sink.fast_array_base"
      ]
    },
    {
      "id": "a_fast_array_read_uses_non_object_cast_result",
      "invariants": [
        "inv_sink_fast_array_read_on_non_object"
      ],
      "kind": "observed",
      "at": "build_for_in_sink",
      "check": [
        "eq",
        "$build_for_in_sink.obj_is_object",
        "$build_for_in_sink.expected_non_object_value"
      ]
    }
  ]
}
