{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42530184",
  "content_hash": "sha256:c18198d053f2f2d1f8f451819fb98278144040efa6b82ddebf6b16f72db72da2",
  "assertions": [
    {
      "id": "A-ROOT-PPP-CONSTRUCT-REQUIRES-FULL-HEADER",
      "invariants": [
        "R-PPP-CONSTRUCT-REQUIRES-FULL-HEADER"
      ],
      "kind": "required",
      "at": "ppp_guard",
      "check": [
        "ge",
        "$ppp_guard.payload_len",
        "$ppp_guard.ppp_header_size"
      ],
      "protects": "ppp_protocol_store"
    },
    {
      "id": "A-SINK-PROTOCOL-STORE-END-OFFSET-EXCEEDS-LAYER-LEN",
      "invariants": [
        "N-SINK-PROTOCOL-STORE-END-OFFSET-EXCEEDS-LAYER-LEN"
      ],
      "kind": "observed",
      "at": "ppp_protocol_store",
      "check": [
        "gt",
        "$ppp_protocol_store.protocol_write_end_offset",
        "$ppp_protocol_store.layer_data_len"
      ]
    },
    {
      "id": "A-PPP-CONSTRUCT-LEN-REACHES-PROTOCOL-STORE",
      "invariants": [
        "E-PPP-CONSTRUCT-LEN-REACHES-PROTOCOL-STORE"
      ],
      "kind": "transition",
      "from": "ppp_guard",
      "at": "ppp_protocol_store",
      "check": [
        "eq",
        "$ppp_guard.payload_len",
        "$ppp_protocol_store.layer_data_len"
      ]
    }
  ]
}
