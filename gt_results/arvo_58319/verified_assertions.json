{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_58319",
  "content_hash": "sha256:76e5e0203498b2b9f8b790222f4e74fba5c36572bf371c43aeb6cce54c31ba2f",
  "assertions": [
    {
      "id": "A-ROOT-PROPERTIES-VARINT-COMPLETE-BEFORE-ACCEPT",
      "invariants": [
        "I-ROOT-PROPERTIES-VARINT-COMPLETE-BEFORE-ACCEPT"
      ],
      "kind": "required",
      "at": "properties_varint_guard",
      "check": [
        "gt",
        "$properties_varint_guard.validated_varint_len",
        0
      ],
      "protects": "properties_varint_read"
    },
    {
      "id": "A-SINK-PROPERTIES-VARINT-READ-RUNS-AT-SUFFIX-BOUND",
      "invariants": [
        "I-SINK-PROPERTIES-VARINT-READ-RUNS-AT-SUFFIX-BOUND"
      ],
      "kind": "observed",
      "at": "properties_varint_read",
      "check": [
        "ge",
        "$properties_varint_read.read_offset",
        "$properties_varint_read.remaining_bytes"
      ]
    },
    {
      "id": "A-PROPERTIES-CURSOR-FLOWS-TO-DECODER-BASE",
      "invariants": [
        "I-PROPERTIES-CURSOR-FLOWS-TO-DECODER-BASE"
      ],
      "kind": "transition",
      "from": "properties_varint_guard",
      "at": "properties_varint_read",
      "check": [
        "eq",
        "$properties_varint_guard.properties_ptr",
        "$properties_varint_read.decode_base_ptr"
      ]
    },
    {
      "id": "A-PROPERTIES-SUFFIX-LENGTH-FLOWS-TO-DECODER-READ",
      "invariants": [
        "I-PROPERTIES-SUFFIX-LENGTH-FLOWS-TO-DECODER-READ"
      ],
      "kind": "transition",
      "from": "properties_varint_guard",
      "at": "properties_varint_read",
      "check": [
        "eq",
        "$properties_varint_guard.remaining_bytes",
        "$properties_varint_read.remaining_bytes"
      ]
    }
  ]
}
