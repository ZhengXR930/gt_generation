{
  "sample_id": "secbench_oss_libxml2.ossfuzz-42509369",
  "content_hash": "sha256:aaf6b35e0b1ef8674e653829d2e1e662f1f0d09f449b44068189aad9025fe53e",
  "assertions": [
    {
      "id": "A_ROOT_NAME_NOT_DICT_OWNED",
      "kind": "required",
      "at": "root",
      "protects": "sink",
      "mechanism": "invalid_free",
      "description": "Before freeing cur->name through DICT_FREE, the name must not be owned by the current document dictionary. The crashing witness violates this because ASan reports the freed pointer lies inside a dictionary allocation.",
      "check": [
        "eq",
        "$root.name_owned",
        "$root.false_literal"
      ],
      "invariants": [
        "N_ROOT"
      ]
    },
    {
      "id": "A_ROOT_TO_SINK_NAME_OWNERSHIP",
      "kind": "transition",
      "from": "root",
      "at": "sink",
      "description": "The ownership predicate measured for cur->name at the root event is the same predicate at the protected free site.",
      "check": [
        "eq",
        "$root.name_owned",
        "$sink.name_owned"
      ],
      "invariants": [
        "E_ROOT_TO_SINK"
      ]
    },
    {
      "id": "A_ROOT_TO_SINK_NAME_PTR",
      "kind": "transition",
      "from": "root",
      "at": "sink",
      "description": "The same node-name pointer flows from the pre-free root observation to the protected free operation.",
      "check": [
        "eq",
        "$root.name",
        "$sink.name"
      ],
      "invariants": [
        "N_SINK"
      ]
    },
    {
      "id": "A_ROOT_TO_SINK_DICT_PTR",
      "kind": "transition",
      "from": "root",
      "at": "sink",
      "description": "The same dictionary pointer is used for the ownership decision and the protected DICT_FREE call.",
      "check": [
        "eq",
        "$root.dict",
        "$sink.dict"
      ],
      "invariants": [
        "N_SINK"
      ]
    }
  ]
}
