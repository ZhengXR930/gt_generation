{
  "schema_version": "gt-runtime-build-v1",
  "sample_id": "osv_ossfuzz_OSV-2026-308",
  "description": "Evaluator-private deterministic commands for rebuilding the runtime target in gt-memory-env. These commands build artifacts only; PoC execution is described by runtime_spec.json.",
  "commands": [
    {
      "source": "runtime_spec.build_commands[1]",
      "command": "mkdir -p /gt/_work/src/build /gt/_out",
      "run_as_root": false,
      "environment": {
        "GT_BUILD_JOBS": "1"
      }
    },
    {
      "source": "runtime_spec.build_commands[2]",
      "command": "cd /gt/_work/src/build && cmake .. -DCMAKE_BUILD_TYPE=Debug -DLIBICAL_STATIC=ON -DLIBICAL_GLIB=False -DLIBICAL_GLIB_BUILD_DOCS=False -DLIBICAL_GOBJECT_INTROSPECTION=False -DLIBICAL_JAVA_BINDINGS=False -DLIBICAL_BUILD_TESTING=False -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ -DCMAKE_C_FLAGS=\"-O1 -gline-tables-only -DFUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION -fsanitize=address -fno-omit-frame-pointer\" -DCMAKE_CXX_FLAGS=\"-O1 -gline-tables-only -DFUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION -fsanitize=address -fno-omit-frame-pointer\" -DCMAKE_EXE_LINKER_FLAGS=\"-fsanitize=address\" -DCMAKE_SHARED_LINKER_FLAGS=\"-fsanitize=address\" >/tmp/libical_cmake.log && cmake --build . -j2 >/tmp/libical_build.log",
      "run_as_root": false,
      "environment": {
        "GT_BUILD_JOBS": "1"
      }
    },
    {
      "source": "runtime_spec.build_commands[3]",
      "command": "clang++ -O1 -gline-tables-only -DFUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION -fsanitize=address -fno-omit-frame-pointer -I/gt/_work/src/src -I/gt/_work/src/build/src -I/gt/_work/src/src/libical -I/gt/_work/src/src/libicalvcard -I/gt/_work/src/build/src/libical -I/gt/_work/src/build/src/libicalvcard /gt/runtime_support/libicalvcard_repro.cc /gt/_work/src/build/lib/libicalvcard.a /gt/_work/src/build/lib/libical.a -licui18n -licuuc -licudata -o /gt/_out/libicalvcard_fuzzer",
      "run_as_root": false,
      "environment": {
        "GT_BUILD_JOBS": "1"
      }
    }
  ]
}
