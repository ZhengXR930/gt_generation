{
  "sample_id": "osv_ossfuzz_OSV-2026-308",
  "content_hash": "sha256:362323473c61ccb25ed4887296127199312b06258b89c59179d817e92f96abb4",
  "assertions": [
    {
      "id": "observed.structured_input_reaches_constructor",
      "invariants": [
        "N_SOURCE"
      ],
      "kind": "observed",
      "at": "structured_call",
      "check": [
        "eq",
        "$structured_call.val",
        "$structured_call.structured_input"
      ]
    },
    {
      "id": "transition.structured_input_flows_to_constructor",
      "invariants": [
        "E_SOURCE_TO_CALL"
      ],
      "kind": "transition",
      "from": "param_value",
      "at": "structured_call",
      "check": [
        "eq",
        "$param_value.structured_input",
        "$structured_call.val"
      ]
    },
    {
      "id": "transition.field_index_reaches_sink_write",
      "invariants": [
        "N_SINK",
        "E_ROOT_TO_SINK"
      ],
      "kind": "transition",
      "from": "root_write",
      "at": "sink_write",
      "check": [
        "eq",
        "$root_write.num_fields_before_store",
        "$sink_write.num_fields_before_store"
      ]
    },
    {
      "id": "required.field_index_within_structured_capacity",
      "invariants": [
        "N_ROOT"
      ],
      "kind": "required",
      "at": "sink_write",
      "protects": "sink_write",
      "check": [
        "lt",
        "$sink_write.num_fields_before_store",
        "$sink_write.max_structured_fields"
      ]
    }
  ]
}
