{
  "sample_id": "arvo_51735",
  "content_hash": "sha256:7f70d5768af9ce2997e47d9f6363ed78113008ceea4b4282c3d921788cde10f4",
  "assertions": [
    {
      "id": "a_cbuffers_must_fit_descriptor_table",
      "invariants": [
        "r_cbuffers_must_fit_descriptor_table"
      ],
      "kind": "required",
      "at": "header_descriptor_guard",
      "check": [
        "le",
        "$header_descriptor_guard.cbuffers",
        "$header_descriptor_guard.descriptor_capacity"
      ],
      "protects": "cb_buffer_size_read"
    },
    {
      "id": "a_cbuffers_reaches_heap_count",
      "invariants": [
        "e_cbuffers_to_heap_count",
        "N_EVENT_buffer_count_store"
      ],
      "kind": "transition",
      "from": "header_descriptor_guard",
      "at": "buffer_count_store",
      "check": [
        "eq",
        "$header_descriptor_guard.cbuffers",
        "$buffer_count_store.stored_cbuffers"
      ]
    },
    {
      "id": "a_heap_count_controls_first_descriptor_entry",
      "invariants": [
        "e_heap_count_to_first_descriptor_entry"
      ],
      "kind": "transition",
      "from": "buffer_count_store",
      "at": "first_descriptor_entry",
      "check": [
        "eq",
        "$buffer_count_store.stored_cbuffers",
        "$first_descriptor_entry.loop_bound"
      ]
    },
    {
      "id": "a_descriptor_cursor_reaches_cb_buffer_size_read",
      "invariants": [
        "e_p_after_ul_type_to_cb_buffer_size_read"
      ],
      "kind": "transition",
      "from": "first_descriptor_entry",
      "at": "cb_buffer_size_read",
      "check": [
        "eq",
        "$first_descriptor_entry.p_after_ul_type",
        "$cb_buffer_size_read.p_before_cb_buffer_size"
      ]
    },
    {
      "id": "a_cb_buffer_size_read_exceeds_remaining_input",
      "invariants": [
        "n_cb_buffer_size_read_exceeds_remaining_input"
      ],
      "kind": "observed",
      "at": "cb_buffer_size_read",
      "check": [
        "gt",
        "$cb_buffer_size_read.read_width",
        "$cb_buffer_size_read.remaining_input_bytes"
      ]
    }
  ]
}
