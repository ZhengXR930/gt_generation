      ],
      "relation": {
        "op": "lt",
        "left": "len - (size_t)(p - (const unsigned char *)ptr)",
        "right": "sizeof(krb5_ui_4)"
      },
      "verified": true,
      "verified_by": "a_cb_buffer_size_read_exceeds_remaining_input",
      "fine_trace_step": 8,
      "description": "AddressSanitizer sink callsite. The parser requests a 4-byte read for `cbBufferSize` from `p == ptr + 12` even though only three logical input bytes remain."
    },
