      "description": "First non-harness project statement that materializes attacker-controlled PAC state. It parses the fuzz bytes into the buffer-count field that later overflows the header-length calculation and controls the PAC buffer loop bound."
    },
    {
      "invariant_id": "r_cbuffers_must_fit_descriptor_table",
      "role": "root_cause",
      "file": "src/lib/krb5/krb/pac.c",
      "function": "krb5_pac_parse",
      "line": 320,
      "operands": [
        "cbuffers",
        "(len - PACTYPE_LENGTH) / PAC_INFO_BUFFER_LENGTH"
      ],
      "relation": {
        "op": "le",
        "left": "cbuffers",
        "right": "(len - PACTYPE_LENGTH) / PAC_INFO_BUFFER_LENGTH"
      },
      "verified": true,
      "verified_by": "a_cbuffers_must_fit_descriptor_table",
      "fine_trace_step": 3,
      "description": "Root cause. The parser multiplies the attacker-controlled 32-bit `cbuffers` count by 16 before any upper-bound check. For the witness value `0x10000000`, that 32-bit multiply wraps to zero, so `header_len` becomes `8` and the later length check validates only the fixed PACTYPE header instead of the required `PAC_INFO_BUFFER` descriptors."
    },
    {
      "invariant_id": "n_cb_buffer_size_read_exceeds_remaining_input",
      "role": "sink",
      "file": "src/lib/krb5/krb/pac.c",
