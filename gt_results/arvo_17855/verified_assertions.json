        "$second_plane_refill.input_size"
      ]
    },
    {
      "id": "a_second_plane_refill_word_state_reaches_dispatch",
      "invariants": [
        "e_second_plane_refill_word_state_reaches_dispatch"
      ],
      "kind": "transition",
      "from": "second_plane_refill",
      "at": "second_plane_dispatch",
      "check": [
        "eq",
        "$second_plane_refill.word_initialized_prefix_len",
        "$second_plane_dispatch.word_initialized_prefix_len"
      ]
    },
    {
      "id": "a_second_plane_refill_word_has_uninitialized_bits",
      "invariants": [
        "n_second_plane_refill_word_has_uninitialized_bits"
      ],
      "kind": "observed",
      "at": "second_plane_refill",
      "check": [
        "gt",
        "$second_plane_refill.word_bytes",
        "$second_plane_refill.word_initialized_prefix_len"
      ]
    }
  ]
