        "n_second_plane_dispatch_uses_uninitialized_word"
      ],
      "kind": "observed",
      "at": "second_plane_dispatch",
      "check": [
        "gt",
        "$second_plane_dispatch.word_bytes",
        "$second_plane_dispatch.word_initialized_prefix_len"
      ]
    },
    {
      "id": "a_second_plane_call_data_ptr_reaches_refill",
      "invariants": [
        "e_second_plane_call_data_ptr_reaches_refill"
      ],
      "kind": "transition",
      "from": "second_plane_call",
      "at": "second_plane_refill",
      "check": [
        "eq",
        "$second_plane_call.data_ptr",
        "$second_plane_refill.data_base"
      ]
    },
    {
      "id": "a_second_plane_call_remaining_size_reaches_refill",
      "invariants": [
        "e_second_plane_call_remaining_size_reaches_refill"
      ],
      "kind": "transition",
      "from": "second_plane_call",
      "at": "second_plane_refill",
      "check": [
