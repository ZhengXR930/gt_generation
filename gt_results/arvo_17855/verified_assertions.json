      ],
      "kind": "required",
      "at": "second_plane_call",
      "check": [
        "le",
        "$second_plane_call.consumed_bytes",
        "$second_plane_call.input_size"
      ]
    },
    {
      "id": "a_second_plane_dispatch_uses_uninitialized_word",
