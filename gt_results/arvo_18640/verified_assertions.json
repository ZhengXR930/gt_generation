{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_18640",
  "content_hash": "sha256:4d622f66c1b0177be83a5bf0bab2dc599d138ee3f9f24eff5fe4f6b6eb75edb6",
  "assertions": [
    {
      "id": "A-SINK-COPY-LEN-EXCEEDS-STACK-BUF",
      "invariants": [
        "I-SINK-COPY-LEN-EXCEEDS-STACK-BUF"
      ],
      "kind": "observed",
      "at": "copy_sink",
      "check": [
        "gt",
        "$copy_sink.copy_len",
        "$copy_sink.stack_buf_size"
      ]
    },
    {
      "id": "A-REQUEST-LEN-TO-BREAK-SUBTRACT",
      "invariants": [
        "I-REQUEST-LEN-TO-BREAK-SUBTRACT",
        "I-BREAK-SUBTRACT-USES-DISPATCHED-LEN"
      ],
      "kind": "transition",
      "from": "request_len_dispatch",
      "at": "break_subtract",
      "check": [
        "eq",
        "$request_len_dispatch.request_len",
        "$break_subtract.subtracted_len"
      ]
    },
    {
      "id": "A-BREAK-LEFT-TO-COPY-LENGTH-COMPUTE",
      "invariants": [
        "I-BREAK-LEFT-TO-COPY-LENGTH-COMPUTE",
        "I-COPY-LENGTH-COMPUTE-USES-BREAK-LEFT"
      ],
      "kind": "transition",
      "from": "break_subtract",
      "at": "copy_length_compute",
      "check": [
        "eq",
        "$break_subtract.remaining_after_subtract",
        "$copy_length_compute.remaining_after_subtract"
      ]
    },
    {
      "id": "A-COPY-LEN-TO-SINK",
      "invariants": [
        "I-COPY-LEN-TO-SINK"
      ],
      "kind": "transition",
      "from": "copy_length_compute",
      "at": "copy_sink",
      "check": [
        "eq",
        "$copy_length_compute.copy_len",
        "$copy_sink.copy_len"
      ]
    }
  ]
}
