{
  "sample_id": "arvo_14297",
  "content_hash": "sha256:312d2866f83100e3ec3a39a6fb977ddfde281ba141fd66bda2fcb67b04eebdb2",
  "assertions": [
    {
      "id": "A-ROOT-IF-MODIFIED-SINCE-HAS-RFC1123-LENGTH",
      "invariants": [
        "I-ROOT-IF-MODIFIED-SINCE-HAS-RFC1123-LENGTH"
      ],
      "kind": "required",
      "at": "if_modified_since_guard",
      "check": [
        "eq",
        "$if_modified_since_guard.raw_len",
        "$if_modified_since_guard.required_len"
      ],
      "protects": "parse_time_call"
    },
    {
      "id": "A-SINK-GMT-PROBE-READ-END-EXCEEDS-BUFFER-END",
      "invariants": [
        "E-BUFFER-END-TO-GMT-PROBE-OVERFLOW",
        "I-SINK-GMT-PROBE-READ-END-EXCEEDS-BUFFER-END"
      ],
      "kind": "transition",
      "from": "if_modified_since_guard",
      "at": "gmt_probe",
      "check": [
        "gt",
        "$gmt_probe.read_end_ptr",
        "$if_modified_since_guard.buffer_end_ptr"
      ]
    },
    {
      "id": "A-RAW-VALUE-REACHES-RFC-TIME-CALL",
      "invariants": [
        "E-RAW-VALUE-REACHES-RFC-TIME-CALL"
      ],
      "kind": "transition",
      "from": "if_modified_since_guard",
      "at": "parse_time_call",
      "check": [
        "eq",
        "$if_modified_since_guard.raw_value_ptr",
        "$parse_time_call.parse_input_ptr"
      ]
    },
    {
      "id": "A-RFC-TIME-CALL-INPUT-REACHES-GMT-PROBE",
      "invariants": [
        "E-RFC-TIME-CALL-INPUT-REACHES-GMT-PROBE"
      ],
      "kind": "transition",
      "from": "parse_time_call",
      "at": "gmt_probe",
      "check": [
        "eq",
        "$parse_time_call.parse_input_ptr",
        "$gmt_probe.input_ptr"
      ]
    }
  ]
}
