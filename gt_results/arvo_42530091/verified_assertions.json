  "assertions": [
    {
      "id": "a_root_update_withdrawn_length_field_fits_message",
      "invariants": [
        "r_update_withdrawn_length_field_fits_message"
      ],
      "kind": "required",
      "at": "update_guard",
      "check": [
        "le",
        "$update_guard.withdrawn_len_field_end",
        "$update_guard.data_len"
      ],
      "protects": "update_after_restore"
    },
    {
      "id": "a_restored_update_below_nlri_minimum",
      "invariants": [
        "n_update_restored_below_nlri_minimum"
      ],
      "kind": "observed",
      "at": "update_after_restore",
      "check": [
        "lt",
        "$update_after_restore.header_len_after_restore",
        "$update_after_restore.nlri_insert_min"
      ]
    },
    {
      "id": "a_nlri_insert_offset_exceeds_current_update_length",
      "invariants": [
        "n_nlri_insert_offset_exceeds_current_update_length"
      ],
      "kind": "observed",
      "at": "nlri_extend_request",
      "check": [
        "gt",
        "$nlri_extend_request.insert_offset_in_layer",
        "$nlri_extend_request.header_len_before"
      ]
    },
    {
      "id": "a_insert_data_index_exceeds_raw_packet_length",
      "invariants": [
        "n_insert_data_index_exceeds_raw_packet_length"
      ],
      "kind": "observed",
      "at": "insert_data_sink",
      "check": [
        "gt",
        "$insert_data_sink.at_index",
        "$insert_data_sink.raw_data_len_before"
      ]
    },
    {
      "id": "a_last_update_object_reaches_restore_state",
      "invariants": [
        "e_last_update_object_reaches_restore_state"
      ],
      "kind": "transition",
      "from": "update_guard",
      "at": "update_after_restore",
      "check": [
        "eq",
        "$update_guard.update_layer_ptr",
        "$update_after_restore.update_layer_ptr"
      ]
    },
    {
      "id": "a_short_update_length_reaches_nlri_setter",
      "invariants": [
        "e_short_update_length_reaches_nlri_setter"
      ],
      "kind": "transition",
      "from": "update_after_restore",
      "at": "nlri_extend_request",
      "check": [
        "eq",
        "$update_after_restore.header_len_after_restore",
        "$nlri_extend_request.header_len_before"
      ]
    },
    {
      "id": "a_nlri_insert_offset_reaches_packet_extend",
      "invariants": [
        "e_nlri_insert_offset_reaches_packet_extend"
      ],
      "kind": "transition",
      "from": "nlri_extend_request",
      "at": "packet_extend",
      "check": [
        "eq",
        "$nlri_extend_request.insert_offset_in_layer",
        "$packet_extend.offset_in_layer"
      ]
    },
    {
      "id": "a_packet_insert_index_reaches_raw_insert",
      "invariants": [
        "e_packet_insert_index_reaches_raw_insert"
      ],
      "kind": "transition",
      "from": "packet_extend",
      "at": "insert_data_sink",
      "check": [
        "eq",
        "$packet_extend.index_to_insert_data",
        "$insert_data_sink.at_index"
      ]
    }
  ]
}
