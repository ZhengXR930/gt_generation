{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42502085",
  "content_hash": "sha256:858e44a2456116b3db0a74003f8e0069d4f7440d91f65b70af3f19dc247f1dcc",
  "assertions": [
    {
      "id": "A-ROOT-PRINT-BOUND-MATCHES-SLICE-LEN",
      "invariants": [
        "I-ROOT-PRINT-BOUND-MATCHES-SLICE-LEN"
      ],
      "kind": "required",
      "at": "cdf_string_debug_sink",
      "check": [
        "eq",
        "$cdf_string_debug_sink.print_bound",
        "$cdf_string_debug_sink.slice_len"
      ],
      "protects": "cdf_string_debug_sink"
    },
    {
      "id": "A-ACCEPTED-SLICE-FITS-PROPERTY-WINDOW",
      "invariants": [
        "I-ACCEPTED-SLICE-FITS-PROPERTY-WINDOW"
      ],
      "kind": "observed",
      "at": "cdf_string_accept",
      "check": [
        "le",
        "$cdf_string_accept.slice_consumed_bytes",
        "$cdf_string_accept.record_remaining_bytes"
      ]
    },
    {
      "id": "A-SINK-RAW-PRINT-OUTRUNS-SLICE",
      "invariants": [
        "I-SINK-RAW-PRINT-OUTRUNS-SLICE"
      ],
      "kind": "observed",
      "at": "cdf_string_debug_sink",
      "check": [
        "gt",
        "$cdf_string_debug_sink.first_nul_offset_or_end",
        "$cdf_string_debug_sink.slice_len"
      ]
    },
    {
      "id": "A-SLICE-BUFFER-REACHES-SINK",
      "invariants": [
        "I-SLICE-BUFFER-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "cdf_string_accept",
      "at": "cdf_string_debug_sink",
      "check": [
        "eq",
        "$cdf_string_accept.slice_buf",
        "$cdf_string_debug_sink.slice_buf"
      ]
    },
    {
      "id": "A-SLICE-LEN-REACHES-SINK",
      "invariants": [
        "I-SLICE-LEN-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "cdf_string_accept",
      "at": "cdf_string_debug_sink",
      "check": [
        "eq",
        "$cdf_string_accept.slice_len",
        "$cdf_string_debug_sink.slice_len"
      ]
    }
  ]
}
