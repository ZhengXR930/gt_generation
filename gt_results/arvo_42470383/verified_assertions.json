{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42470383",
  "content_hash": "sha256:df4a595b4a30cc3ba779d172604293bc44998dde217b627ddee409d7640668b8",
  "assertions": [
    {
      "id": "a_resource_list_sanitize_must_fail_invalid_mandatory_offset",
      "invariants": [
        "r_resource_list_sanitize_must_fail_invalid_mandatory_offset"
      ],
      "kind": "required",
      "at": "resource_list_sanitize",
      "check": [
        "eq",
        "$resource_list_sanitize.resource_list_sanitize_ok",
        0
      ]
    },
    {
      "id": "a_face_cast_uses_zero_resource_offset",
      "invariants": [
        "n_face_cast_uses_zero_resource_offset"
      ],
      "kind": "observed",
      "at": "resource_record_face",
      "check": [
        "eq",
        "$resource_record_face.resource_data_offset",
        "$resource_record_face.zero_literal"
      ]
    },
    {
      "id": "a_neutered_resource_list_offset_reaches_lookup",
      "invariants": [
        "e_neutered_resource_list_offset_reaches_lookup"
      ],
      "kind": "transition",
      "from": "resource_list_sanitize",
      "at": "resource_record_lookup",
      "check": [
        "eq",
        "$resource_list_sanitize.resource_list_offset_after",
        "$resource_record_lookup.resource_list_offset"
      ]
    },
    {
      "id": "a_resource_record_reaches_face_cast",
      "invariants": [
        "e_resource_record_reaches_face_cast"
      ],
      "kind": "transition",
      "from": "resource_record_lookup",
      "at": "resource_record_face",
      "check": [
        "eq",
        "$resource_record_lookup.resource_record",
        "$resource_record_face.resource_record"
      ]
    },
    {
      "id": "a_fake_face_table_count_reaches_bsearch",
      "invariants": [
        "e_fake_face_table_count_reaches_bsearch"
      ],
      "kind": "transition",
      "from": "resource_record_face",
      "at": "table_record_bsearch",
      "check": [
        "eq",
        "$resource_record_face.fake_table_count",
        "$table_record_bsearch.search_table_count"
      ]
    },
    {
      "id": "a_resource_fork_data_len_bounds_bsearch",
      "invariants": [
        "e_resource_fork_data_len_bounds_bsearch"
      ],
      "kind": "transition",
      "from": "resource_fork_sanitize",
      "at": "table_record_bsearch",
      "check": [
        "gt",
        "$table_record_bsearch.search_table_count",
        "$resource_fork_sanitize.data_block_bytes"
      ]
    },
    {
      "id": "a_bsearch_candidate_reaches_table_record_cmp",
      "invariants": [
        "e_bsearch_candidate_reaches_table_record_cmp",
        "n_table_record_cmp_consumes_bsearch_candidate"
      ],
      "kind": "transition",
      "from": "table_record_bsearch",
      "at": "table_record_cmp",
      "check": [
        "eq",
        "$table_record_bsearch.candidate_record",
        "$table_record_cmp.table_record"
      ]
    }
  ]
}
