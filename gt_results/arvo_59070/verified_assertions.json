{
  "sample_id": "arvo_59070",
  "content_hash": "sha256:727cffd873fe06daf7d1966e2b922cbbfa0b82a972c54857ac100e558bccd23b",
  "assertions": [
    {
      "id": "A-ROOT-SUFFIX-LEN-MUST-NOT-EQUAL-STACK-CAPACITY",
      "invariants": [
        "I-ROOT-SUFFIX-LEN-MUST-NOT-EQUAL-STACK-CAPACITY"
      ],
      "kind": "required",
      "at": "classifier_root",
      "check": [
        "ne",
        "$classifier_root.len_before_guard",
        "$classifier_root.suffix_capacity"
      ],
      "protects": "classifier_memcpy"
    },
    {
      "id": "A-SINK-MEMCPY-COPY-LEN-EXCEEDS-SUFFIX-CAPACITY",
      "invariants": [
        "I-SINK-MEMCPY-COPY-LEN-EXCEEDS-SUFFIX-CAPACITY"
      ],
      "kind": "observed",
      "at": "classifier_memcpy",
      "check": [
        "gt",
        "$classifier_memcpy.copy_len",
        "$classifier_memcpy.suffix_capacity"
      ]
    },
    {
      "id": "A-LEN-PLUS-NUL-REACHES-MEMCPY-LEN",
      "invariants": [
        "I-LEN-PLUS-NUL-REACHES-MEMCPY-LEN"
      ],
      "kind": "transition",
      "from": "classifier_root",
      "at": "classifier_memcpy",
      "check": [
        "eq",
        "$classifier_root.copy_len_after_increment",
        "$classifier_memcpy.copy_len"
      ]
    },
    {
      "id": "A-SUFFIX-STACK-BUFFER-REACHES-MEMCPY-SOURCE",
      "invariants": [
        "I-SUFFIX-STACK-BUFFER-REACHES-MEMCPY-SOURCE"
      ],
      "kind": "transition",
      "from": "classifier_root",
      "at": "classifier_memcpy",
      "check": [
        "eq",
        "$classifier_root.suffix_buffer",
        "$classifier_memcpy.suffix_buffer"
      ]
    }
  ]
}
