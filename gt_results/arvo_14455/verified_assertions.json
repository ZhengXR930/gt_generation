{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_14455",
  "content_hash": "sha256:0c753496c27c6cd9ffecbcdb8be96ef7725d63b656fa8f740fc600ac8eed901a",
  "assertions": [
    {
      "id": "A-ROOT-PROXY-V2-HEADER-SIZE-FITS-REQUEST-LEN",
      "invariants": [
        "I-ROOT-PROXY-V2-HEADER-SIZE-FITS-REQUEST-LEN"
      ],
      "kind": "required",
      "at": "proxy_v2_guard",
      "check": [
        "lt",
        "$proxy_v2_guard.claimed_size",
        "$proxy_v2_guard.request_len"
      ],
      "protects": "proxy_v2_memmem_sink"
    },
    {
      "id": "A-PROXY-V2-CLAIMED-SIZE-BECOMES-SEARCH-START-OFFSET",
      "invariants": [
        "I-CLAIMED-SIZE-BECOMES-SEARCH-START-OFFSET"
      ],
      "kind": "transition",
      "from": "proxy_v2_guard",
      "at": "proxy_v2_search_window",
      "check": [
        "eq",
        "$proxy_v2_guard.claimed_size",
        "$proxy_v2_search_window.start_offset"
      ]
    },
    {
      "id": "A-PROXY-V2-REMAINING-WINDOW-UNDERFLOWS",
      "invariants": [
        "I-SEARCH-WINDOW-UNDERFLOWS-AFTER-HEADER-ADVANCE"
      ],
      "kind": "observed",
      "at": "proxy_v2_search_window",
      "check": [
        "gt",
        "$proxy_v2_search_window.window_len",
        "$proxy_v2_search_window.request_len"
      ]
    },
    {
      "id": "A-UNDERFLOWED-WINDOW-REACHES-MEMMEM-SINK",
      "invariants": [
        "I-UNDERFLOWED-WINDOW-REACHES-MEMMEM-SINK",
        "I-SINK-MEMMEM-RECEIVES-UNDERFLOWED-WINDOW"
      ],
      "kind": "transition",
      "from": "proxy_v2_search_window",
      "at": "proxy_v2_memmem_sink",
      "check": [
        "eq",
        "$proxy_v2_search_window.window_len",
        "$proxy_v2_memmem_sink.window_len"
      ]
    }
  ]
}
