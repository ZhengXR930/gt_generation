      "invariants": [
        "I-SINK-MEMCMP-READ-EXCEEDS-PREFIX-FIELD"
      ],
      "kind": "observed",
      "at": "mesh_prefix_memcmp",
      "check": [
        "gt",
        "$mesh_prefix_memcmp.compare_len",
        "$mesh_prefix_memcmp.prefix_field_len"
      ]
    },
    {
      "id": "A-COMPARE-LEN-FLOWS-TO-MEMCMP",
      "invariants": [
        "I-COMPARE-LEN-FLOWS-TO-MEMCMP"
      ],
      "kind": "transition",
      "from": "mesh_prefix_bound",
      "at": "mesh_prefix_memcmp",
      "check": [
