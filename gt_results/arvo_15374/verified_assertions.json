      ],
      "kind": "required",
      "at": "mesh_prefix_bound",
      "check": [
        "le",
        "$mesh_prefix_bound.compare_len",
        "$mesh_prefix_bound.prefix_field_len"
      ],
      "protects": "mesh_prefix_memcmp"
    },
    {
