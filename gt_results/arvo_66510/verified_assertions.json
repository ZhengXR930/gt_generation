{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_66510",
  "content_hash": "sha256:eee965a3e3fee375b0d74bbafb8b2eb03bd9538f976f14220e8802663aa9da7e",
  "assertions": [
    {
      "id": "A-ROOT-LOOKAHEAD-IN-BOUNDS",
      "invariants": [
        "I-ROOT-LOOKAHEAD-IN-BOUNDS"
      ],
      "kind": "required",
      "at": "lookahead_guard",
      "check": [
        "lt",
        "$lookahead_guard.lookahead_ptr",
        "$lookahead_guard.block_end"
      ],
      "protects": "literal_read_sink"
    },
    {
      "id": "A-SINK-LOOKAHEAD-READS-UNINITIALIZED-BYTE",
      "invariants": [
        "I-SINK-LOOKAHEAD-READS-UNINITIALIZED-BYTE"
      ],
      "kind": "observed",
      "at": "literal_read_sink",
      "check": [
        "lt",
        "$literal_read_sink.literal_initialized_prefix_len",
        "$literal_read_sink.read_len"
      ]
    },
    {
      "id": "A-LOOKAHEAD-POINTER-TO-SINK",
      "invariants": [
        "I-LOOKAHEAD-POINTER-TO-SINK"
      ],
      "kind": "transition",
      "from": "lookahead_guard",
      "at": "literal_read_sink",
      "check": [
        "eq",
        "$lookahead_guard.lookahead_ptr",
        "$literal_read_sink.literals_ptr"
      ]
    }
  ]
}
