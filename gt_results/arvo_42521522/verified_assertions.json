{
  "sample_id": "arvo_42521522",
  "content_hash": "sha256:23acffa054ba3ef5be06f627fecd2dab149aaebc21309729338c5b2ac3b80c1a",
  "assertions": [
    {
      "id": "a_status_flags_fit_uint8",
      "invariants": [
        "r_legacy_status_flags_fit_uint8"
      ],
      "kind": "required",
      "at": "legacy_status_guard",
      "check": [
        "le",
        "$legacy_status_guard.raw_status_flags",
        "$legacy_status_guard.status_flags_max"
      ],
      "protects": "load_size_wrap"
    },
    {
      "id": "a_wrapped_load_size_below_checksum_width",
      "invariants": [
        "n_wrapped_load_size_below_checksum_width"
      ],
      "kind": "observed",
      "at": "load_size_wrap",
      "check": [
        "lt",
        "$load_size_wrap.actual_len",
        "$load_size_wrap.checksum_width"
      ]
    },
    {
      "id": "a_wrapped_load_size_reaches_realloc",
      "invariants": [
        "e_wrapped_load_size_reaches_realloc",
        "n_header_image_reallocated_to_wrapped_size"
      ],
      "kind": "transition",
      "from": "load_size_wrap",
      "at": "load_entry_realloc",
      "check": [
        "eq",
        "$load_size_wrap.actual_len",
        "$load_entry_realloc.actual_len"
      ]
    },
    {
      "id": "a_realloc_size_reaches_checksum_verify",
      "invariants": [
        "e_realloc_size_reaches_checksum_verify",
        "N_EVENT_checksum_verify_call"
      ],
      "kind": "transition",
      "from": "load_entry_realloc",
      "at": "checksum_verify_call",
      "check": [
        "eq",
        "$load_entry_realloc.actual_len",
        "$checksum_verify_call.verify_len"
      ]
    },
    {
      "id": "a_verify_len_reaches_checksum_decode",
      "invariants": [
        "e_verify_len_reaches_checksum_decode"
      ],
      "kind": "transition",
      "from": "checksum_verify_call",
      "at": "checksum_decode_sink",
      "check": [
        "eq",
        "$checksum_verify_call.verify_len",
        "$checksum_decode_sink.buf_size"
      ]
    },
    {
      "id": "a_checksum_decode_starts_before_buffer",
      "invariants": [
        "n_checksum_decode_starts_before_buffer"
      ],
      "kind": "observed",
      "at": "checksum_decode_sink",
      "check": [
        "lt",
        "$checksum_decode_sink.chk_p",
        "$checksum_decode_sink.buf"
      ]
    }
  ]
}
