  "assertions": [
    {
      "id": "a_op_limit_must_anchor_to_output_slice",
      "invariants": [
        "r_op_limit_must_anchor_to_output_slice"
      ],
      "kind": "required",
      "at": "op_limit_root",
      "check": [
        "eq",
        "$op_limit_root.op_limit_ptr",
        "$op_limit_root.output_limit_ptr"
      ],
      "protects": "leftover_guard"
    },
    {
      "id": "a_leftover_guard_exceeds_real_output_slice",
      "invariants": [
        "n_leftover_guard_exceeds_real_output_slice"
      ],
      "kind": "observed",
      "at": "leftover_guard",
      "check": [
        "gt",
        "$leftover_guard.guard_required_end_ptr",
        "$leftover_guard.output_limit_ptr"
      ]
    },
    {
      "id": "a_overflow_sink_write_exceeds_output_slice",
      "invariants": [
        "n_overflow_sink_write_exceeds_output_slice"
      ],
      "kind": "observed",
      "at": "overflow_sink",
      "check": [
        "gt",
        "$overflow_sink.write_end_ptr",
        "$overflow_sink.output_limit_ptr"
      ]
    },
    {
      "id": "a_root_op_limit_reaches_leftover_guard",
      "invariants": [
        "e_root_op_limit_reaches_leftover_guard"
      ],
      "kind": "transition",
      "from": "op_limit_root",
      "at": "leftover_guard",
      "check": [
        "eq",
        "$op_limit_root.op_limit_ptr",
        "$leftover_guard.op_limit_ptr"
      ]
    },
    {
      "id": "a_leftover_guard_cursor_reaches_overflow_sink",
      "invariants": [
        "e_leftover_guard_cursor_reaches_overflow_sink"
      ],
      "kind": "transition",
      "from": "leftover_guard",
      "at": "overflow_sink",
      "check": [
        "eq",
        "$leftover_guard.op_ptr",
        "$overflow_sink.op_ptr"
      ]
    }
  ]
}
