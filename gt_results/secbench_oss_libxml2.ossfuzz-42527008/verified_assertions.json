  "assertions": [
    {
      "id": "required.guess_argument_must_not_be_freed_before_error",
      "invariants": [
        "root.guess_argument_must_not_be_freed_before_error"
      ],
      "kind": "required",
      "at": "unsupported_encoding_error",
      "check": [
        "ne",
        "$unsupported_encoding_error.guess_argument",
        "$unsupported_encoding_error.last_freed_guess_ptr"
      ],
      "protects": "sink_formatter"
    },
    {
      "id": "transition.freed_guess_reaches_unsupported_error",
      "invariants": [
        "edge.freed_guess_reaches_unsupported_error",
        "node.guess_free_releases_error_argument"
      ],
      "kind": "transition",
      "from": "guess_free",
      "at": "unsupported_encoding_error",
      "check": [
        "eq",
        "$guess_free.free_argument",
        "$unsupported_encoding_error.guess_argument"
      ]
    },
    {
      "id": "transition.error_argument_reaches_html_error_forward",
      "invariants": [
        "edge.error_argument_reaches_html_error_forward"
      ],
      "kind": "transition",
      "from": "unsupported_encoding_error",
      "at": "html_error_forward",
      "check": [
        "eq",
        "$unsupported_encoding_error.guess_argument",
        "$html_error_forward.str1_argument"
      ]
    },
    {
      "id": "transition.forwarded_str1_reaches_sink_formatter",
      "invariants": [
        "edge.forwarded_str1_reaches_sink_formatter",
        "node.sink_formatter_uses_forwarded_str1"
      ],
      "kind": "transition",
      "from": "html_error_forward",
      "at": "sink_formatter",
      "check": [
        "eq",
        "$html_error_forward.str1_argument",
        "$sink_formatter.str1_argument"
      ]
    }
  ]
}
