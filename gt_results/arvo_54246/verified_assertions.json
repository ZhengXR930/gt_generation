  "assertions": [
    {
      "id": "a_read_error_log_must_not_consume_previously_freed_err_message",
      "invariants": [
        "r_read_error_log_must_not_consume_previously_freed_err_message"
      ],
      "kind": "required",
      "at": "read_error_log",
      "check": [
        "ne",
        "$read_error_log.message_ptr",
        "$read_error_log.previous_freed_message_ptr"
      ],
      "protects": "read_error_log"
    },
    {
      "id": "a_freed_err_message_reaches_read_error_log",
      "invariants": [
        "e_freed_err_message_reaches_read_error_log",
        "n_read_error_cleanup_frees_err_message_alias",
        "n_read_error_log_reads_err_message"
      ],
      "kind": "transition",
      "from": "read_error_cleanup",
      "at": "read_error_log",
      "check": [
        "eq",
        "$read_error_cleanup.freed_message_ptr",
        "$read_error_log.message_ptr"
      ]
    }
  ]
}
