{
  "sample_id": "arvo_42538854",
  "content_hash": "sha256:a80b9469a7c92408857f36e00c4112d2c7b8b1b043c9cf4731ce4a9abe5b6fe2",
  "assertions": [
    {
      "id": "a_cff_suppression_does_not_reduce_named_instance_count_on_truetype_path",
      "invariants": [
        "r_cff_suppression_does_not_reduce_named_instance_count_on_truetype_path"
      ],
      "kind": "required",
      "at": "named_instance_cache_store",
      "check": [
        "ge",
        "$named_instance_cache_store.num_instances_after_cff",
        "$named_instance_cache_store.num_instances_before_cff"
      ],
      "protects": "named_instance_cache_store"
    },
    {
      "id": "a_cached_named_instance_count_reaches_mmvar_capacity",
      "invariants": [
        "e_cached_named_instance_count_reaches_mmvar_capacity"
      ],
      "kind": "transition",
      "from": "named_instance_cache_store",
      "at": "mmvar_capacity_setup",
      "check": [
        "eq",
        "$named_instance_cache_store.cached_named_instance_count",
        "$mmvar_capacity_setup.mmvar_namedstyle_capacity"
      ]
    },
    {
      "id": "a_mmvar_capacity_is_smaller_than_fvar_instance_count",
      "invariants": [
        "n_mmvar_capacity_is_smaller_than_fvar_instance_count"
      ],
      "kind": "observed",
      "at": "mmvar_capacity_setup",
      "check": [
        "lt",
        "$mmvar_capacity_setup.mmvar_namedstyle_capacity",
        "$mmvar_capacity_setup.fvar_instance_count"
      ]
    },
    {
      "id": "a_mmvar_capacity_reaches_coords_write_sink",
      "invariants": [
        "e_mmvar_capacity_reaches_coords_write_sink"
      ],
      "kind": "transition",
      "from": "mmvar_capacity_setup",
      "at": "coords_write_sink",
      "check": [
        "eq",
        "$mmvar_capacity_setup.mmvar_namedstyle_capacity",
        "$coords_write_sink.mmvar_namedstyle_capacity"
      ]
    },
    {
      "id": "a_namedstyle_coords_pointer_reaches_coords_write_sink",
      "invariants": [
        "e_namedstyle_coords_pointer_reaches_coords_write_sink"
      ],
      "kind": "transition",
      "from": "namedstyle_coords_read",
      "at": "coords_write_sink",
      "check": [
        "eq",
        "$namedstyle_coords_read.ns_coords_ptr",
        "$coords_write_sink.write_target_ptr"
      ]
    },
    {
      "id": "a_coords_write_sink_uses_discarded_namedstyle",
      "invariants": [
        "n_coords_write_sink_uses_discarded_namedstyle"
      ],
      "kind": "observed",
      "at": "coords_write_sink",
      "check": [
        "ge",
        "$coords_write_sink.write_instance_index",
        "$coords_write_sink.mmvar_namedstyle_capacity"
      ]
    }
  ]
}
