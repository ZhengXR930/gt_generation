      "relation": {
        "op": "le",
        "left": "num_instances",
        "right": "num_instances"
      },
      "verified": true,
      "verified_by": "a_cff_suppression_does_not_reduce_named_instance_count_on_truetype_path",
      "fine_trace_step": 2,
      "description": "Root cause. The vulnerable code treats the mere presence of a `CFF ` table as grounds to discard the parsed `fvar` named-instance count, even when the same font also contains `glyf` and should still use the TrueType variation path. The fix changes this condition to zero the count only when `glyf` is absent and `CFF ` is present, and it moves the check after the default-instance synthesis block."
    },
