      ],
      "kind": "required",
      "at": "terminator_guard",
      "check": [
        "ge",
        "$terminator_guard.remaining_bytes",
        "$terminator_guard.probe_width"
      ],
      "protects": "terminator_probe"
    },
    {
      "id": "a_sink_terminator_probe_exceeds_remaining_span",
      "invariants": [
        "n_terminator_probe_exceeds_remaining_span"
      ],
      "kind": "observed",
      "at": "terminator_probe",
      "check": [
        "gt",
        "$terminator_probe.probe_width",
        "$terminator_probe.remaining_bytes"
      ]
    },
    {
      "id": "a_parser_end_reaches_terminator_guard",
      "invariants": [
        "e_parser_end_reaches_terminator_guard"
      ],
      "kind": "transition",
      "from": "lexer_span_init",
      "at": "terminator_guard",
      "check": [
        "eq",
        "$lexer_span_init.lexer_end",
        "$terminator_guard.lexer_end"
      ]
    },
    {
      "id": "a_guard_cursor_reaches_terminator_probe",
      "invariants": [
        "e_guard_cursor_reaches_terminator_probe"
      ],
      "kind": "transition",
      "from": "terminator_guard",
      "at": "terminator_probe",
      "check": [
