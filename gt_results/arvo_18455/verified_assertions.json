  "assertions": [
    {
      "id": "A-ROOT-FUZZ-SPAN-RESERVES-TRAILING-BYTE",
      "invariants": [
        "I-ROOT-FUZZ-SPAN-RESERVES-TRAILING-BYTE"
      ],
      "kind": "required",
      "at": "fuzz_span_ready",
      "check": [
        "lt",
        "$fuzz_span_ready.lexer_end",
        "$fuzz_span_ready.data_limit"
      ],
      "protects": "multiline_probe"
    },
    {
      "id": "A-SINK-MULTILINE-PROBE-USES-EXCLUSIVE-END",
      "invariants": [
        "I-SINK-MULTILINE-PROBE-USES-EXCLUSIVE-END"
      ],
      "kind": "observed",
      "at": "multiline_probe",
      "check": [
        "eq",
        "$multiline_probe.strncmp_pos",
        "$multiline_probe.lexer_end"
      ]
    },
    {
      "id": "A-END-BOUND-CARRIES-TO-MULTILINE-PROBE",
      "invariants": [
        "I-END-BOUND-CARRIES-TO-MULTILINE-PROBE",
        "N_EVENT_fuzz_span_ready"
      ],
      "kind": "transition",
      "from": "fuzz_span_ready",
      "at": "multiline_probe",
      "check": [
        "eq",
        "$fuzz_span_ready.lexer_end",
        "$multiline_probe.lexer_end"
      ]
    },
    {
      "id": "A-NEXT-ADVANCED-CURSOR-REACHES-MULTILINE-PROBE",
      "invariants": [
        "I-NEXT-ADVANCED-CURSOR-REACHES-MULTILINE-PROBE",
        "N_EVENT_loop_condition_advance"
      ],
      "kind": "transition",
      "from": "loop_condition_advance",
      "at": "multiline_probe",
      "check": [
        "eq",
        "$loop_condition_advance.pos_after_next",
        "$multiline_probe.strncmp_pos"
      ]
    }
  ]
}
