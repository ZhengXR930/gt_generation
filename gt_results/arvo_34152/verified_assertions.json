  "assertions": [
    {
      "id": "a_cleanup_requires_owned_main_input",
      "invariants": [
        "r_cleanup_requires_owned_main_input"
      ],
      "kind": "required",
      "at": "cleanup_guard",
      "check": [
        "eq",
        "$cleanup_guard.owns_current_input",
        1
      ],
      "protects": "cleanup_free"
    },
    {
      "id": "a_cleanup_free_reaches_stale_reload",
      "invariants": [
        "n_cleanup_free_uses_global_data_input"
      ],
      "kind": "transition",
      "from": "cleanup_free",
      "at": "stale_reload",
      "check": [
        "eq",
        "$cleanup_free.free_argument",
        "$stale_reload.reloaded_input"
      ]
    },
    {
      "id": "a_stale_reload_reaches_istream_read",
      "invariants": [
        "n_istream_read_uses_reloaded_stream"
      ],
      "kind": "transition",
      "from": "stale_reload",
      "at": "istream_read_sink",
      "check": [
        "eq",
        "$stale_reload.reloaded_input",
        "$istream_read_sink.stream_argument"
      ]
    }
  ]
