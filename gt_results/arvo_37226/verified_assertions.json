{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_37226",
  "content_hash": "sha256:34a422cf4dabfc427c66d749f366f5003658a9baeae7a60f876998efef350d3c",
  "assertions": [
    {
      "id": "A-ROOT-APPLE-ENTRY-TABLE-FITS-BUFFER",
      "invariants": [
        "I-ROOT-APPLE-ENTRY-TABLE-FITS-BUFFER"
      ],
      "kind": "required",
      "at": "apple_bounds_guard",
      "check": [
        "le",
        "$apple_bounds_guard.required_size_bytes",
        "$apple_bounds_guard.buf_size"
      ],
      "protects": "apple_tag_read"
    },
    {
      "id": "A-SINK-APPLE-TAG-READ-SECOND-BYTE-PAST-END",
      "invariants": [
        "I-SINK-APPLE-TAG-READ-SECOND-BYTE-PAST-END"
      ],
      "kind": "observed",
      "at": "apple_tag_read",
      "check": [
        "ge",
        "$apple_tag_read.second_byte_ptr",
        "$apple_tag_read.source_end_ptr"
      ]
    },
    {
      "id": "A-APPLE-MNOTE-OFFSET-REACHES-TAG-READ",
      "invariants": [
        "I-APPLE-MNOTE-OFFSET-REACHES-TAG-READ"
      ],
      "kind": "transition",
      "from": "apple_bounds_guard",
      "at": "apple_tag_read",
      "check": [
        "eq",
        "$apple_bounds_guard.mnote_base_offset",
        "$apple_tag_read.mnote_base_offset"
      ]
    },
    {
      "id": "A-APPLE-ENTRY-COUNT-REACHES-TAG-READ",
      "invariants": [
        "I-APPLE-ENTRY-COUNT-REACHES-TAG-READ"
      ],
      "kind": "transition",
      "from": "apple_bounds_guard",
      "at": "apple_tag_read",
      "check": [
        "eq",
        "$apple_bounds_guard.entry_count",
        "$apple_tag_read.entry_count"
      ]
    }
  ]
}
