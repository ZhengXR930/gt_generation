{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_40674",
  "content_hash": "sha256:ce70c0f5cb7bab19174c0364acd47111725e22047c61b0b73624a95ac211a58e",
  "assertions": [
    {
      "id": "a_first_group_member_index_must_be_strictly_less_than_section_count",
      "invariants": [
        "r_first_group_member_index_in_bounds"
      ],
      "kind": "required",
      "at": "first_group_member_guard",
      "check": [
        "lt",
        "$first_group_member_guard.member_sec_index",
        "$first_group_member_guard.section_count"
      ],
      "protects": "first_group_member_sink"
    },
    {
      "id": "a_unchecked_first_group_member_index_reaches_target_pointer",
      "invariants": [
        "e_unchecked_first_group_member_index_reaches_target_pointer"
      ],
      "kind": "transition",
      "from": "first_group_member_guard",
      "at": "first_group_member_target_ptr",
      "check": [
        "eq",
        "$first_group_member_guard.member_sec_index",
        "$first_group_member_target_ptr.member_sec_index"
      ]
    },
    {
      "id": "a_first_group_member_target_pointer_is_one_past_end",
      "invariants": [
        "n_first_group_member_target_pointer_is_one_past_end"
      ],
      "kind": "observed",
      "at": "first_group_member_target_ptr",
      "check": [
        "eq",
        "$first_group_member_target_ptr.target_shdr_ptr",
        "$first_group_member_target_ptr.section_array_end_ptr"
      ]
    },
    {
      "id": "a_one_past_end_target_pointer_reaches_section_group_number_read",
      "invariants": [
        "e_one_past_end_target_pointer_reaches_sink",
        "n_first_group_member_section_group_number_read_sink"
      ],
      "kind": "transition",
      "from": "first_group_member_target_ptr",
      "at": "first_group_member_sink",
      "check": [
        "eq",
        "$first_group_member_target_ptr.target_shdr_ptr",
        "$first_group_member_sink.deref_target_shdr_ptr"
      ]
    }
  ]
}
