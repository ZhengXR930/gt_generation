{
  "sample_id": "arvo_63314",
  "content_hash": "sha256:7cb63efbf2459f454a2eac0bc95ce8d4b8707eb8f68b167848a3a0ba257904c9",
  "assertions": [
    {
      "id": "required.empty_allocation_covers_aligned_width",
      "invariants": [
        "root.empty_allocation_covers_aligned_width"
      ],
      "kind": "required",
      "at": "empty_alloc",
      "check": [
        "ge",
        "$empty_alloc.empty_size",
        "$empty_alloc.aligned_width"
      ],
      "protects": "raw_submit"
    },
    {
      "id": "transition.empty_to_first_dummy_row",
      "invariants": [
        "edge.empty_to_first_dummy_row",
        "N_EVENT_direct_dummy_row"
      ],
      "kind": "transition",
      "from": "empty_alloc",
      "at": "direct_dummy_row",
      "check": [
        "eq",
        "$empty_alloc.empty_ptr",
        "$direct_dummy_row.row_ptr"
      ]
    },
    {
      "id": "transition.first_dummy_row_to_raw_submit",
      "invariants": [
        "edge.first_dummy_row_to_raw_submit",
        "N_EVENT_raw_submit"
      ],
      "kind": "transition",
      "from": "direct_dummy_row",
      "at": "raw_submit",
      "check": [
        "eq",
        "$direct_dummy_row.row_ptr",
        "$raw_submit.row_ptr"
      ]
    },
    {
      "id": "transition.empty_extent_to_raw_submit_window",
      "invariants": [
        "edge.empty_extent_to_raw_submit_window",
        "node.raw_submit_window_overruns_empty"
      ],
      "kind": "transition",
      "from": "empty_alloc",
      "at": "raw_submit",
      "check": [
        "lt",
        "$empty_alloc.empty_size",
        "$raw_submit.read_end_offset"
      ]
    }
  ]
}
