{
  "sample_id": "arvo_53046",
  "content_hash": "sha256:1e79a2cfb3e04ccbd8817be5ffd5409dd5b7bb9d5d3bea4fab8576a05655987f",
  "assertions": [
    {
      "id": "A-ROOT-DATA-PATTERN-VALID-BEFORE-SEARCH",
      "invariants": [
        "R-ROOT-DATA-PATTERN-VALID-BEFORE-SEARCH"
      ],
      "kind": "required",
      "at": "data_pattern_guard",
      "check": [
        "eq",
        "$data_pattern_guard.data_pattern_valid",
        "$data_pattern_guard.true_literal"
      ],
      "protects": "data_pattern_search"
    },
    {
      "id": "A-DATA-PATTERN-TAIL-BYTE-REACHES-WORD-BOUNDARY",
      "invariants": [
        "E-DATA-PATTERN-TAIL-BYTE-REACHES-WORD-BOUNDARY",
        "N-DATA-PATTERN-TAIL-BYTE"
      ],
      "kind": "transition",
      "from": "data_pattern_tail",
      "at": "word_boundary_tail",
      "check": [
        "eq",
        "$data_pattern_tail.tail_byte",
        "$word_boundary_tail.current_byte"
      ]
    },
    {
      "id": "A-SEARCH-END-REACHES-WORD-BOUNDARY-TAIL",
      "invariants": [
        "E-SEARCH-END-REACHES-WORD-BOUNDARY-TAIL",
        "N-WORD-BOUNDARY-DECODES-FINAL-BYTE"
      ],
      "kind": "transition",
      "from": "data_pattern_search",
      "at": "word_boundary_tail",
      "check": [
        "eq",
        "$data_pattern_search.search_end_ptr",
        "$word_boundary_tail.current_ptr_plus_one"
      ]
    },
    {
      "id": "A-WORD-BOUNDARY-PTR-REACHES-GB18030-LEAD-CHECK",
      "invariants": [
        "E-WORD-BOUNDARY-PTR-REACHES-GB18030-LEAD-CHECK"
      ],
      "kind": "transition",
      "from": "word_boundary_tail",
      "at": "gb18030_lead_check",
      "check": [
        "eq",
        "$word_boundary_tail.current_ptr",
        "$gb18030_lead_check.lead_ptr"
      ]
    },
    {
      "id": "A-SINK-GB18030-LEAD-BYTE-REQUIRES-SECOND-BYTE",
      "invariants": [
        "N-SINK-GB18030-LEAD-BYTE-REQUIRES-SECOND-BYTE"
      ],
      "kind": "observed",
      "at": "gb18030_lead_check",
      "check": [
        "eq",
        "$gb18030_lead_check.lead_is_cm",
        "$gb18030_lead_check.true_literal"
      ]
    }
  ]
}
