{
  "sample_id": "arvo_38359",
  "content_hash": "sha256:510efa4f8a857a89abc03296e18afbe7500359d059a75d7c6e81cefba8b25be5",
  "assertions": [
    {
      "id": "a_null_cipher_policy_uses_full_key_length",
      "invariants": [
        "r_null_cipher_policy_uses_full_key_length"
      ],
      "kind": "required",
      "at": "null_cipher_policy",
      "check": [
        "eq",
        "$null_cipher_policy.cipher_key_len",
        "$null_cipher_policy.expected_key_len"
      ],
      "protects": "extract_key_alloc"
    },
    {
      "id": "a_stream_key_copy_input_len_exceeds_cipher_key_len",
      "invariants": [
        "n_stream_key_copy_input_len_exceeds_cipher_key_len"
      ],
      "kind": "observed",
      "at": "stream_key_copy",
      "check": [
        "gt",
        "$stream_key_copy.input_keylen",
        "$stream_key_copy.rtp_keylen"
      ]
    },
    {
      "id": "a_policy_cipher_key_len_reaches_extract_key_size",
      "invariants": [
        "e_policy_cipher_key_len_reaches_extract_key_size",
        "n_extract_key_allocates_policy_key_buffer"
      ],
      "kind": "transition",
      "from": "null_cipher_policy",
      "at": "extract_key_alloc",
      "check": [
        "eq",
        "$null_cipher_policy.cipher_key_len",
        "$extract_key_alloc.key_size"
      ]
    },
    {
      "id": "a_extract_key_buffer_reaches_stream_init_alias",
      "invariants": [
        "e_extract_key_buffer_reaches_stream_init_alias",
        "n_stream_init_alias_uses_policy_key_buffer"
      ],
      "kind": "transition",
      "from": "extract_key_alloc",
      "at": "stream_key_alias",
      "check": [
        "eq",
        "$extract_key_alloc.key_ptr",
        "$stream_key_alias.master_key_ptr"
      ]
    },
    {
      "id": "a_extract_key_size_reaches_stream_key_copy_cipher_len",
      "invariants": [
        "e_extract_key_size_reaches_stream_key_copy_cipher_len"
      ],
      "kind": "transition",
      "from": "extract_key_alloc",
      "at": "stream_key_copy",
      "check": [
        "eq",
        "$extract_key_alloc.key_size",
        "$stream_key_copy.rtp_keylen"
      ]
    },
    {
      "id": "a_stream_init_alias_reaches_stream_key_copy_source",
      "invariants": [
        "e_stream_init_alias_reaches_stream_key_copy_source"
      ],
      "kind": "transition",
      "from": "stream_key_alias",
      "at": "stream_key_copy",
      "check": [
        "eq",
        "$stream_key_alias.master_key_ptr",
        "$stream_key_copy.key_ptr"
      ]
    }
  ]
}
