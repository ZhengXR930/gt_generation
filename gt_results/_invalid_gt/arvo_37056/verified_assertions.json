        "edge_resolve_editor_free_to_gc_sink_same_pointer_edge"
      ],
      "kind": "transition",
      "from": "resolve_editor_free_editor",
      "at": "gc_sink_second_free",
      "check": [
        "eq",
        "$resolve_editor_free_editor.free_argument",
        "$gc_sink_second_free.free_argument"
      ]
    },
    {
      "id": "a_sink_executes_free",
