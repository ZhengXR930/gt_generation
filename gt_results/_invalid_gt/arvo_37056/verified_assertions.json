      "at": "resolve_editor_free_editor",
      "protects": "gc_sink_second_free",
      "check": [
        "eq",
        "$resolve_editor_free_editor.gc_entry_removed_before_free",
        "$resolve_editor_free_editor.editor_is_gc_tracked"
      ]
    },
    {
      "id": "a_reg_transition_editor_into_gc",
      "invariants": [
        "edge_copy_arg_to_resolve_editor_editor_alias",
        "N_EVENT_copy_arg_register_editor"
      ],
      "kind": "transition",
      "from": "copy_arg_register_editor",
