{
  "sample_id": "arvo_6626",
  "content_hash": "sha256:c225163dd8a12fd26e9dc5b1d9d1b7a297f06435c56591a9a1c841e21e4ab8d6",
  "assertions": [
    {
      "id": "A-ROOT-Z-BUFFER-INITIALIZED-BEFORE-SELECT",
      "invariants": [
        "I-ROOT-Z-BUFFER-INITIALIZED-BEFORE-SELECT"
      ],
      "kind": "required",
      "at": "sub_tmp_decl",
      "check": [
        "ge",
        "$sub_tmp_decl.z_initialized_prefix_len",
        "$sub_tmp_decl.z_buffer_bytes"
      ],
      "protects": "sub_select_read"
    },
    {
      "id": "A-SELECT-READ-CONSUMES-UNINITIALIZED-Z",
      "invariants": [
        "I-SELECT-READ-CONSUMES-UNINITIALIZED-Z"
      ],
      "kind": "observed",
      "at": "sub_select_read",
      "check": [
        "gt",
        "$sub_select_read.z_buffer_bytes",
        "$sub_select_read.z_initialized_prefix_len"
      ]
    },
    {
      "id": "A-Z-BUFFER-REACHES-SELECT",
      "invariants": [
        "I-Z-BUFFER-REACHES-SELECT"
      ],
      "kind": "transition",
      "from": "sub_tmp_decl",
      "at": "sub_select_read",
      "check": [
        "eq",
        "$sub_tmp_decl.z_buffer_ptr",
        "$sub_select_read.z_buffer_ptr"
      ]
    },
    {
      "id": "A-ABS-READ-CONSUMES-SELECTED-LIMB",
      "invariants": [
        "I-ABS-READ-CONSUMES-SELECTED-LIMB"
      ],
      "kind": "observed",
      "at": "abs_limb_read",
      "check": [
        "gt",
        "$abs_limb_read.abs_limb_bytes",
        "$abs_limb_read.abs_limb_initialized_prefix_len"
      ]
    },
    {
      "id": "A-SELECTED-LIMB-REACHES-ABS-READ",
      "invariants": [
        "I-SELECTED-LIMB-REACHES-ABS-READ"
      ],
      "kind": "transition",
      "from": "sub_select_read",
      "at": "abs_limb_read",
      "check": [
        "eq",
        "$sub_select_read.selected_limb_ptr",
        "$abs_limb_read.abs_limb_ptr"
      ]
    },
    {
      "id": "A-WORD-ADD-SINK-READS-UNINITIALIZED-ARG",
      "invariants": [
        "I-WORD-ADD-SINK-READS-UNINITIALIZED-ARG"
      ],
      "kind": "observed",
      "at": "word_add_sink",
      "check": [
        "gt",
        "$word_add_sink.x_read_bytes",
        "$word_add_sink.x_initialized_prefix_len"
      ]
    },
    {
      "id": "A-ABS-ARG-REACHES-WORD-ADD",
      "invariants": [
        "I-ABS-ARG-REACHES-WORD-ADD"
      ],
      "kind": "transition",
      "from": "abs_limb_read",
      "at": "word_add_sink",
      "check": [
        "eq",
        "$abs_limb_read.word_add_x_bits",
        "$word_add_sink.x_bits"
      ]
    }
  ]
}
