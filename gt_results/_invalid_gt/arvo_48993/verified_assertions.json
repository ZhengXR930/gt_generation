{
  "sample_id": "arvo_48993",
  "content_hash": "sha256:8dbe7ee3a38124c4f7cc2138f65e55d571bd906eb5effc81c488480d668df223",
  "assertions": [
    {
      "id": "A-ROOT-UNCOMPRESSED-BYTES-INITIALIZED",
      "invariants": [
        "I-ROOT-UNCOMPRESSED-BYTES-INITIALIZED"
      ],
      "kind": "required",
      "at": "uncompressed_update_root",
      "check": [
        "ge",
        "$uncompressed_update_root.uncompressed_initialized_prefix_len",
        "$uncompressed_update_root.uncompressed_size"
      ],
      "protects": "uncompressed_update_root"
    },
    {
      "id": "A-AUTOFLUSH-DISPATCHES-SHORT-UNCOMPRESSED-BLOCK",
      "invariants": [
        "I-AUTOFLUSH-DISPATCHES-SHORT-UNCOMPRESSED-BLOCK"
      ],
      "kind": "observed",
      "at": "auto_flush_dispatch",
      "check": [
        "lt",
        "$auto_flush_dispatch.src_remaining",
        "$auto_flush_dispatch.block_size"
      ]
    },
    {
      "id": "A-SINK-HASH-READS-PAST-INITIALIZED-PREFIX",
      "invariants": [
        "I-SINK-HASH-READS-PAST-INITIALIZED-PREFIX"
      ],
      "kind": "observed",
      "at": "hash_position_sink",
      "check": [
        "gt",
        "$hash_position_sink.hash_read_width",
        "$hash_position_sink.hash_initialized_prefix_len"
      ]
    },
    {
      "id": "A-ROOT-BUFFER-TO-AUTOFLUSH-DISPATCH",
      "invariants": [
        "I-ROOT-BUFFER-TO-AUTOFLUSH-DISPATCH"
      ],
      "kind": "transition",
      "from": "uncompressed_update_root",
      "at": "auto_flush_dispatch",
      "check": [
        "eq",
        "$uncompressed_update_root.uncompressed_data_ptr",
        "$auto_flush_dispatch.src_buffer_ptr"
      ]
    },
    {
      "id": "A-AUTOFLUSH-BUFFER-TO-HASH-SINK",
      "invariants": [
        "I-AUTOFLUSH-BUFFER-TO-HASH-SINK"
      ],
      "kind": "transition",
      "from": "auto_flush_dispatch",
      "at": "hash_position_sink",
      "check": [
        "eq",
        "$auto_flush_dispatch.src_buffer_ptr",
        "$hash_position_sink.hash_input_ptr"
      ]
    }
  ]
}
