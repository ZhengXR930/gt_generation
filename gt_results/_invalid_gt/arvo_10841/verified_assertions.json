{
  "sample_id": "arvo_10841",
  "content_hash": "sha256:3209217ecdef36afb052853a2877d07e3e7b99b4fbe9b18645c11175f18952db",
  "assertions": [
    {
      "id": "A-ROOT-COVERAGE",
      "invariants": [
        "I-ROOT-ROW-COVERAGE"
      ],
      "kind": "required",
      "at": "strip_guard",
      "check": [
        "eq",
        "$strip_guard.rows_covered",
        "$strip_guard.expected_rows"
      ],
      "protects": "sink_row_check"
    },
    {
      "id": "A-SINK-UNWRITTEN",
      "invariants": [
        "I-SINK-UNWRITTEN-ROW"
      ],
      "kind": "observed",
      "at": "sink_row_check",
      "check": [
        "gt",
        "$sink_row_check.row_size",
        "$sink_row_check.written_bytes"
      ]
    },
    {
      "id": "A-FIRST-MISSING-TO-SINK",
      "invariants": [
        "I-FIRST-MISSING-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "strip_guard",
      "at": "sink_row_check",
      "check": [
        "eq",
        "$strip_guard.first_missing_row",
        "$sink_row_check.row"
      ]
    }
  ]
}
