  "assertions": [
    {
      "id": "a_read_begin_requires_initialized_notes_obstack",
      "invariants": [
        "r_notes_obstack_initialized_before_pobegin"
      ],
      "kind": "required",
      "at": "read_begin_entry",
      "check": [
        "ne",
        "$read_begin_entry.notes_chunkfun_plain",
        "$read_begin_entry.null_literal"
      ],
      "protects": "call_chunkfun_sink"
    },
    {
      "id": "a_call_chunkfun_uses_null_allocator",
      "invariants": [
        "n_call_chunkfun_null_allocator_sink"
      ],
      "kind": "observed",
      "at": "call_chunkfun_sink",
      "check": [
        "eq",
        "$call_chunkfun_sink.chunkfun_plain",
        "$call_chunkfun_sink.null_literal"
      ]
    },
    {
      "id": "a_notes_chunkfun_state_reaches_notes_alloc",
      "invariants": [
        "e_read_begin_state_persists_to_notes_alloc",
        "n_notes_alloc_consumes_same_notes_state"
      ],
      "kind": "transition",
      "from": "read_begin_entry",
      "at": "notes_alloc_call",
      "check": [
        "eq",
        "$read_begin_entry.notes_chunkfun_plain",
        "$notes_alloc_call.notes_chunkfun_plain"
      ]
    },
    {
      "id": "a_notes_obstack_alias_reaches_call_chunkfun",
      "invariants": [
        "e_notes_obstack_alias_reaches_call_chunkfun"
      ],
      "kind": "transition",
      "from": "notes_alloc_call",
      "at": "call_chunkfun_sink",
      "check": [
        "eq",
        "$notes_alloc_call.notes_addr",
        "$call_chunkfun_sink.obstack_ptr"
      ]
    }
  ]
}
