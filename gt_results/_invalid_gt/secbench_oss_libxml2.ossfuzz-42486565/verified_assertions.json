{
  "sample_id": "secbench_oss_libxml2.ossfuzz-42486565",
  "content_hash": "sha256:7e8b54372e67baaf89676caa9399ae89098fa6e02611bcaafaf073a8c0ea5e2f",
  "assertions": [
    {
      "id": "A-ROOT-FALLBACK-REPROCESS-MUST-USE-FALLBACK-SUBTREE",
      "invariants": [
        "I-ROOT-FALLBACK-REPROCESS-MUST-USE-FALLBACK-SUBTREE"
      ],
      "kind": "required",
      "at": "fallback_dispatch",
      "check": [
        "eq",
        "$fallback_dispatch.process_root",
        "$fallback_dispatch.fallback_root"
      ],
      "protects": "fallback_reprocess_entry"
    },
    {
      "id": "A-SINK-RELOAD-READS-THE-RETAINED-INCLUDE-REF",
      "invariants": [
        "I-SINK-RELOAD-READS-THE-RETAINED-INCLUDE-REF"
      ],
      "kind": "observed",
      "at": "stale_ref_sink",
      "check": [
        "eq",
        "$stale_ref_sink.loaded_cur",
        "$stale_ref_sink.slot_ref"
      ]
    },
    {
      "id": "A-EMPTY-FALLBACK-FLAG-REQUALIFIES-THE-STALE-SLOT",
      "invariants": [
        "I-EMPTY-FALLBACK-FLAG-REQUALIFIES-THE-STALE-SLOT"
      ],
      "kind": "observed",
      "at": "stale_slot_rescan_gate",
      "check": [
        "ne",
        "$stale_slot_rescan_gate.slot_empty_fb",
        "$stale_slot_rescan_gate.zero_literal"
      ]
    },
    {
      "id": "A-REUSED-FALLBACK-CONTEXT-REACHES-NESTED-INCLUDE-REGISTRATION",
      "invariants": [
        "I-REUSED-FALLBACK-CONTEXT-REACHES-NESTED-INCLUDE-REGISTRATION",
        "N_EVENT_nested_ref_store"
      ],
      "kind": "transition",
      "from": "fallback_dispatch",
      "at": "nested_ref_store",
      "check": [
        "eq",
        "$fallback_dispatch.reused_ctxt",
        "$nested_ref_store.ctxt_arg"
      ]
    },
    {
      "id": "A-REGISTERED-NESTED-INCLUDE-REF-REACHES-THE-FREE",
      "invariants": [
        "I-REGISTERED-NESTED-INCLUDE-REF-REACHES-THE-FREE",
        "N_EVENT_free_include_node"
      ],
      "kind": "transition",
      "from": "nested_ref_store",
      "at": "free_include_node",
      "check": [
        "eq",
        "$nested_ref_store.stored_ref",
        "$free_include_node.free_argument"
      ]
    },
    {
      "id": "A-EMPTY-FALLBACK-MARK-SURVIVES-TO-LATER-RESCAN",
      "invariants": [
        "I-EMPTY-FALLBACK-MARK-SURVIVES-TO-LATER-RESCAN"
      ],
      "kind": "transition",
      "from": "empty_fallback_mark",
      "at": "stale_slot_rescan_gate",
      "check": [
        "eq",
        "$empty_fallback_mark.slot_empty_fb",
        "$stale_slot_rescan_gate.slot_empty_fb"
      ]
    },
    {
      "id": "A-FREED-NESTED-INCLUDE-NODE-REACHES-THE-SINK",
      "invariants": [
        "I-FREED-NESTED-INCLUDE-NODE-REACHES-THE-SINK"
      ],
      "kind": "transition",
      "from": "free_include_node",
      "at": "stale_ref_sink",
      "check": [
        "eq",
        "$free_include_node.free_argument",
        "$stale_ref_sink.loaded_cur"
      ]
    }
  ]
}
