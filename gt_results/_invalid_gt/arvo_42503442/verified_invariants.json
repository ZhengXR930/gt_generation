      ],
      "relation": {
        "op": "le",
        "left": "sizeof(month_yday) / sizeof(month_yday[0])",
        "right": "tm->tm_mon"
      },
      "verified": true,
      "verified_by": "a_month_yday_index_exceeds_table_length",
      "fine_trace_step": 8,
      "description": "ASan sink. `fr_unix_time_from_tm()` uses `tm_mon == 12` as an index into the 12-element global `month_yday` array with no bounds check, so the read goes one element past the array."
    },
