      "verified": true,
      "verified_by": "a_month_value_must_be_at_most_12",
      "fine_trace_step": 5,
      "description": "Root cause. The RFC3339 month parser uses an off-by-one upper bound of 13, so it accepts the singular invalid month `13` instead of rejecting it before `tm_mon` is derived."
    },
    {
      "invariant_id": "n_month_yday_index_out_of_bounds",
