{
  "sample_id": "arvo_66063",
  "content_hash": "sha256:efa11b70c5b7417d15f56a4edd8875cc17a7ff34123e65e3088094c883f03cef",
  "assertions": [
    {
      "id": "A-ROOT-TAIL-SAFETY-MARGIN-SCANS-EIGHT-LEADING-BYTES",
      "invariants": [
        "R-UTF8-TO-UTF32-TAIL-SCAN-COVERS-EIGHT-LEADING-BYTES"
      ],
      "kind": "required",
      "at": "tail_margin_scan",
      "check": [
        "ge",
        "$tail_margin_scan.leading_byte",
        8
      ],
      "protects": "tail_simd_loop"
    },
    {
      "id": "A-ASCII-STORE-CROSSES-UTF32-OUTPUT-END",
      "invariants": [
        "N-ASCII-STORE-CROSSES-UTF32-OUTPUT-END"
      ],
      "kind": "observed",
      "at": "ascii_store_sink",
      "check": [
        "gt",
        "$ascii_store_sink.store_end",
        "$ascii_store_sink.output_buffer_end"
      ]
    },
    {
      "id": "A-TAIL-SAFETY-MARGIN-REACHES-MASKED-HELPER-OVERSTORE",
      "invariants": [
        "E-TAIL-SAFETY-MARGIN-REACHES-MASKED-HELPER-OVERSTORE"
      ],
      "kind": "transition",
      "from": "tail_margin_scan",
      "at": "masked_helper_overstore",
      "check": [
        "eq",
        "$tail_margin_scan.safety_margin",
        "$masked_helper_overstore.safety_margin"
      ]
    },
    {
      "id": "A-MASKED-HELPER-PHYSICAL-WRITE-EXCEEDS-LOGICAL-ADVANCE",
      "invariants": [
        "N-MASKED-HELPER-PHYSICAL-WRITE-EXCEEDS-LOGICAL-ADVANCE"
      ],
      "kind": "observed",
      "at": "masked_helper_overstore",
      "check": [
        "gt",
        "$masked_helper_overstore.physical_store_bytes",
        "$masked_helper_overstore.logical_advance_bytes"
      ]
    },
    {
      "id": "A-MASKED-HELPER-OUTPUT-POINTER-REACHES-ASCII-SINK",
      "invariants": [
        "E-MASKED-HELPER-OUTPUT-POINTER-REACHES-ASCII-SINK"
      ],
      "kind": "transition",
      "from": "masked_helper_overstore",
      "at": "ascii_store_sink",
      "check": [
        "eq",
        "$masked_helper_overstore.utf32_output_after",
        "$ascii_store_sink.ptr"
      ]
    }
  ]
}
