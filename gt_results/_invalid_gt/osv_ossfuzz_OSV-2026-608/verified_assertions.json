  "assertions": [
    {
      "id": "required.http_post_prefix_probe_stays_within_blen",
      "invariants": [
        "root.http_post_prefix_probe_stays_within_blen"
      ],
      "kind": "required",
      "at": "http_post_probe",
      "check": [
        "le",
        "$http_post_probe.post_search_required_bytes",
        "$http_post_probe.blen"
      ],
      "protects": "http_post_probe"
    },
    {
      "id": "observed.source_copy_leaves_no_nul_within_extent",
      "invariants": [
        "node.source_copy_leaves_no_nul_within_extent"
      ],
      "kind": "observed",
      "at": "source_copy",
      "check": [
        "eq",
        "$source_copy.nul_within_copy",
        "$source_copy.zero_literal"
      ]
    },
    {
      "id": "observed.raw_post_prefix_search_runs_past_blen",
      "invariants": [
        "node.raw_post_prefix_search_runs_past_blen"
      ],
      "kind": "observed",
      "at": "raw_http_post_sink",
      "check": [
        "gt",
        "$raw_http_post_sink.post_search_required_bytes",
        "$raw_http_post_sink.blen"
      ]
    },
    {
      "id": "transition.source_copy_buffer_reaches_http_post_probe",
      "invariants": [
        "edge.source_copy_buffer_reaches_http_post_probe"
      ],
      "kind": "transition",
      "from": "source_copy",
      "at": "http_post_probe",
      "check": [
        "eq",
        "$source_copy.copied_buf_ptr",
        "$http_post_probe.s_ptr"
      ]
    },
    {
      "id": "transition.source_copy_length_reaches_http_post_probe",
      "invariants": [
        "edge.source_copy_length_reaches_http_post_probe"
      ],
      "kind": "transition",
      "from": "source_copy",
      "at": "http_post_probe",
      "check": [
        "eq",
        "$source_copy.copy_len",
        "$http_post_probe.blen"
      ]
    },
    {
      "id": "transition.http_post_probe_argument_reaches_raw_post_sink",
      "invariants": [
        "edge.http_post_probe_argument_reaches_raw_post_sink"
      ],
      "kind": "transition",
      "from": "http_post_probe",
      "at": "raw_http_post_sink",
      "check": [
        "eq",
        "$http_post_probe.s_ptr",
        "$raw_http_post_sink.s_ptr"
      ]
    }
  ]
