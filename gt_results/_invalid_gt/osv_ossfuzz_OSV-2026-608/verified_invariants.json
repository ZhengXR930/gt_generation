      },
      "verified": true,
      "verified_by": "observed.raw_post_prefix_search_runs_past_blen",
      "fine_trace_step": 6,
      "description": "Unsafe memory read site in project code. Evaluating these `strstr()` prefix checks on the full 8192-byte non-NUL-terminated stack buffer causes libc to scan past `buf[8191]`, matching the saved ASan stack-buffer-overflow read in `is_http()`."
    }
