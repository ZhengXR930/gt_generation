        "left": "month_yday",
        "right": "tm->tm_mon"
      },
      "verified": true,
      "verified_by": "a_month_index_overruns_month_yday",
      "fine_trace_step": 7,
      "description": "ASan crash site. `fr_unix_time_from_tm()` indexes the 12-element global `month_yday` table with `tm->tm_mon == 12`, so the read steps 2 bytes past the end of the array."
    },
