  "sample_id": "arvo_42508631",
  "content_hash": "sha256:475b5ee6fe783141dc6992412eacd5892486bb1559b44713c62461f741d43a00",
  "assertions": [
    {
      "id": "A-ROOT-SHOWPOINT-SIZE-INCREASES-FOR-DECIMAL-POINT",
      "invariants": [
        "I-ROOT-SHOWPOINT-SIZE-INCREASES-FOR-DECIMAL-POINT"
      ],
      "kind": "required",
      "at": "showpoint_size_root",
      "check": [
        "gt",
        "$showpoint_size_root.size_after_showpoint",
        "$showpoint_size_root.size_before_showpoint"
      ],
      "protects": "decimal_point_sink"
    },
    {
      "id": "A-SINK-DECIMAL-STORE-REACHES-RESERVED-PAYLOAD-END",
      "invariants": [
        "I-SINK-DECIMAL-STORE-REACHES-RESERVED-PAYLOAD-END"
      ],
      "kind": "observed",
      "at": "decimal_point_sink",
      "check": [
        "eq",
        "$decimal_point_sink.decimal_store_index",
        "$decimal_point_sink.reserved_chars"
      ]
    },
    {
      "id": "A-SHOWPOINT-SIZE-FLOWS-TO-WRITE-PADDED-REQUEST",
      "invariants": [
        "I-SHOWPOINT-SIZE-FLOWS-TO-WRITE-PADDED-REQUEST",
        "N_EVENT_write_padded_reserve"
      ],
      "kind": "transition",
      "from": "showpoint_size_root",
      "at": "write_padded_reserve",
      "check": [
        "eq",
        "$showpoint_size_root.size_to_reserve",
        "$write_padded_reserve.requested_chars"
      ]
    },
    {
      "id": "A-RESERVED-PAYLOAD-SIZE-FLOWS-TO-DECIMAL-SINK",
      "invariants": [
        "I-RESERVED-PAYLOAD-SIZE-FLOWS-TO-DECIMAL-SINK"
      ],
      "kind": "transition",
      "from": "write_padded_reserve",
      "at": "decimal_point_sink",
      "check": [
        "eq",
        "$write_padded_reserve.requested_chars",
        "$decimal_point_sink.reserved_chars"
      ]
    }
  ]
}
