{
  "schema_version": "verified-assertions-v3",
  "sample_id": "osv_ossfuzz_OSV-2025-148",
  "content_hash": "sha256:ac048e111c756deab06ae5a1aac8c30b6d458360525abc2a6c0507a879aaf32e",
  "assertions": [
    {
      "id": "a_oldengineid_length_propagates_to_setup_len",
      "invariants": [
        "inv_edge_oldlen_to_setup_len"
      ],
      "kind": "transition",
      "from": "oldengineid_conf_root",
      "at": "setup_engineid_len_from_old",
      "check": [
        "eq",
        "$oldengineid_conf_root.old_engine_id_length",
        "$setup_engineid_len_from_old.len_from_old_engine_id"
      ]
    },
    {
      "id": "a_setup_len_propagates_to_allocation_size",
      "invariants": [
        "inv_edge_setup_len_to_alloc"
      ],
      "kind": "transition",
      "from": "setup_engineid_len_from_old",
      "at": "setup_engineid_alloc",
      "check": [
        "eq",
        "$setup_engineid_len_from_old.len_from_old_engine_id",
        "$setup_engineid_alloc.allocation_length"
      ]
    },
    {
      "id": "a_allocation_is_smaller_than_enterprise_prefix_write",
      "invariants": [
        "inv_alloc_smaller_than_prefix_write"
      ],
      "kind": "observed",
      "at": "setup_engineid_alloc",
      "check": [
        "lt",
        "$setup_engineid_alloc.allocation_length",
        "$setup_engineid_alloc.enterprise_prefix_write_size"
      ]
    },
    {
      "id": "a_allocated_buffer_reaches_memcpy_sink",
      "invariants": [
        "inv_edge_alloc_to_sink_bufp"
      ],
      "kind": "transition",
      "from": "setup_engineid_alloc",
      "at": "setup_engineid_sink",
      "check": [
        "eq",
        "$setup_engineid_alloc.allocated_buffer",
        "$setup_engineid_sink.memcpy_destination"
      ]
    }
  ]
}
