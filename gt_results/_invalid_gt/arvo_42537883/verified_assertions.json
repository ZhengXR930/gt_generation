  "assertions": [
    {
      "id": "observed.crc_expected_feeds_checksum_compare",
      "invariants": [
        "node.crc_compare_consumes_crc_expected"
      ],
      "kind": "observed",
      "at": "crc_compare",
      "check": [
        "eq",
        "$crc_compare.crc_expected_branch_operand",
        "$crc_compare.crc_expected_value"
      ]
    },
    {
      "id": "transition.recognized_state_reaches_checksum_reload",
      "invariants": [
        "edge.recognized_state_to_checksum_reload"
      ],
      "kind": "transition",
      "from": "casic_recognized",
      "at": "data_len_reload",
      "check": [
        "eq",
        "$casic_recognized.state_after",
        "$data_len_reload.state_before"
      ]
    },
    {
      "id": "transition.data_len_reaches_crc_expected_load",
      "invariants": [
        "edge.data_len_to_crc_expected_load"
      ],
      "kind": "transition",
      "from": "data_len_reload",
      "at": "crc_expected_load",
      "check": [
        "eq",
        "$data_len_reload.data_len",
        "$crc_expected_load.data_len"
      ]
    },
    {
      "id": "transition.loaded_crc_expected_reaches_compare",
      "invariants": [
        "edge.crc_expected_load_to_compare"
      ],
      "kind": "transition",
      "from": "crc_expected_load",
      "at": "crc_compare",
      "check": [
        "eq",
        "$crc_expected_load.crc_expected_value",
        "$crc_compare.crc_expected_branch_operand"
      ]
    }
  ]
