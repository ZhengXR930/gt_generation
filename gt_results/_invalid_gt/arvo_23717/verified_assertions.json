{
  "sample_id": "arvo_23717",
  "content_hash": "sha256:5786a6c137b171a8ab80f7506d52e65880bc6d165f298906307d01c8cb4ca571",
  "assertions": [
    {
      "id": "A-ROOT-SIGNED-NBYTES-POSITIVE",
      "invariants": [
        "I-ROOT-SIGNED-NBYTES-POSITIVE"
      ],
      "kind": "required",
      "at": "decompress_gate",
      "check": [
        "gt",
        "$decompress_gate.signed_nbytes",
        "$decompress_gate.zero_literal"
      ],
      "protects": "decompress_call"
    },
    {
      "id": "A-SINK-DICT-ENTRY-PTR-BEFORE-SRC",
      "invariants": [
        "I-SINK-DICT-ENTRY-PTR-BEFORE-SRC"
      ],
      "kind": "observed",
      "at": "dict_size_load",
      "check": [
        "lt",
        "$dict_size_load.dict_entry_ptr",
        "$dict_size_load.src_base"
      ]
    },
    {
      "id": "A-SIGNED-NBYTES-REACHES-CONTEXT-SOURCESIZE",
      "invariants": [
        "I-SIGNED-NBYTES-REACHES-CONTEXT-SOURCESIZE"
      ],
      "kind": "transition",
      "from": "decompress_gate",
      "at": "nblocks_computed",
      "check": [
        "eq",
        "$decompress_gate.signed_nbytes",
        "$nblocks_computed.sourcesize"
      ]
    },
    {
      "id": "A-NBLOCKS-REACHES-DICT-SIZE-INDEX",
      "invariants": [
        "I-NBLOCKS-REACHES-DICT-SIZE-INDEX",
        "N_EVENT_dict_size_load"
      ],
      "kind": "transition",
      "from": "nblocks_computed",
      "at": "dict_size_load",
      "check": [
        "eq",
        "$nblocks_computed.nblocks",
        "$dict_size_load.nblocks_used"
      ]
    },
    {
      "id": "A-NBLOCKS-STAYS-NEGATIVE",
      "invariants": [
        "I-NBLOCKS-STAYS-NEGATIVE"
      ],
      "kind": "observed",
      "at": "nblocks_computed",
      "check": [
        "lt",
        "$nblocks_computed.nblocks",
        "$nblocks_computed.zero_literal"
      ]
    }
  ]
}
