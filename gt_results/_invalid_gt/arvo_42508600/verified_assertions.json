{
  "sample_id": "arvo_42508600",
  "content_hash": "sha256:5ab405e21010444acb0c298521e6eebe2b1474b320800774110b7efd621bfe2e",
  "assertions": [
    {
      "id": "A-ROOT-MOVED-FROM-SIZE-RESET",
      "invariants": [
        "I-ROOT-MOVED-FROM-SIZE-RESET"
      ],
      "kind": "required",
      "at": "move_after_inline_rewire",
      "check": [
        "eq",
        "$move_after_inline_rewire.moved_from_size",
        0
      ],
      "protects": "grow_copy_from_inline_store"
    },
    {
      "id": "A-SINK-GROW-COPY-COUNT-EXCEEDS-INLINE-CAPACITY",
      "invariants": [
        "I-SINK-GROW-COPY-COUNT-EXCEEDS-INLINE-CAPACITY"
      ],
      "kind": "observed",
      "at": "grow_copy_from_inline_store",
      "check": [
        "gt",
        "$grow_copy_from_inline_store.copy_count",
        "$grow_copy_from_inline_store.inline_capacity"
      ]
    },
    {
      "id": "A-MOVED-FROM-SIZE-REACHES-GROW-COPY-COUNT",
      "invariants": [
        "I-MOVED-FROM-SIZE-REACHES-GROW-COPY-COUNT"
      ],
      "kind": "transition",
      "from": "move_after_inline_rewire",
      "at": "grow_copy_from_inline_store",
      "check": [
        "eq",
        "$move_after_inline_rewire.moved_from_size",
        "$grow_copy_from_inline_store.copy_count"
      ]
    },
    {
      "id": "A-INLINE-STORE-POINTER-REACHES-GROW-COPY-SOURCE",
      "invariants": [
        "I-INLINE-STORE-POINTER-REACHES-GROW-COPY-SOURCE"
      ],
      "kind": "transition",
      "from": "move_after_inline_rewire",
      "at": "grow_copy_from_inline_store",
      "check": [
        "eq",
        "$move_after_inline_rewire.inline_store_ptr",
        "$grow_copy_from_inline_store.copy_source_ptr"
      ]
    }
  ]
}
