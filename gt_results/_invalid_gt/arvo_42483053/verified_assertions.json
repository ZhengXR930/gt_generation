  "assertions": [
    {
      "id": "a_argname_buffer_has_terminator_capacity",
      "invariants": [
        "r_argname_buffer_has_terminator_capacity"
      ],
      "kind": "required",
      "at": "argname_materialized",
      "check": [
        "gt",
        "$argname_materialized.argname_buffer_size",
        "$argname_materialized.explicit_name_len"
      ],
      "protects": "named_lookup_compare"
    },
    {
      "id": "a_named_arg_table_pointer_reaches_named_lookup_compare",
      "invariants": [
        "e_named_arg_table_to_named_lookup_compare",
        "n_named_lookup_compare_uses_stored_name_pointer"
      ],
      "kind": "transition",
      "from": "named_arg_table_store",
      "at": "named_lookup_compare",
      "check": [
        "eq",
        "$named_arg_table_store.stored_name_ptr",
        "$named_lookup_compare.table_name_ptr"
      ]
    },
    {
      "id": "a_named_arg_pointer_is_stored_raw_in_table",
      "invariants": [
        "e_named_arg_to_named_arg_table",
        "n_named_arg_table_stores_raw_name_pointer"
      ],
      "kind": "transition",
      "from": "named_arg_constructed",
      "at": "named_arg_table_store",
      "check": [
        "eq",
        "$named_arg_constructed.named_name_ptr",
        "$named_arg_table_store.stored_name_ptr"
      ]
    },
    {
      "id": "a_source_name_buffer_reaches_named_arg",
      "invariants": [
        "e_argname_buffer_to_named_arg",
        "n_named_arg_aliases_source_name_buffer"
      ],
      "kind": "transition",
      "from": "argname_materialized",
      "at": "named_arg_constructed",
      "check": [
        "eq",
        "$argname_materialized.argname_buffer_ptr",
        "$named_arg_constructed.named_name_ptr"
      ]
    }
  ]
}
