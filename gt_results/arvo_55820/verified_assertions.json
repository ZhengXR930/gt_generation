{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_55820",
  "content_hash": "sha256:2ab62e29b0bd8ba4f5feac84b90f9c0031ce1566e17737b9333b75470157f5c1",
  "assertions": [
    {
      "id": "a_bridge_address_store_must_duplicate_raw_token",
      "invariants": [
        "r_bridge_address_store_must_not_alias_raw_token"
      ],
      "kind": "required",
      "at": "bridge_address_store",
      "check": [
        "ne",
        "$bridge_address_store.stored_address",
        "$bridge_address_store.raw_token"
      ]
    },
    {
      "id": "a_stored_bridge_address_survives_to_line_buffer_free",
      "invariants": [
        "e_stored_bridge_address_survives_to_line_buffer_free",
        "n_line_buffer_free_leaves_stale_bridge_address"
      ],
      "kind": "transition",
      "from": "bridge_address_store",
      "at": "line_buffer_free",
      "check": [
        "eq",
        "$bridge_address_store.stored_address",
        "$line_buffer_free.bridge_address_alias"
      ]
    },
    {
      "id": "a_stale_bridge_address_reaches_cleanup_bad_free",
      "invariants": [
        "e_stale_bridge_address_reaches_cleanup_bad_free",
        "n_cleanup_bad_free_sink"
      ],
      "kind": "transition",
      "from": "line_buffer_free",
      "at": "cleanup_bad_free",
      "check": [
        "eq",
        "$line_buffer_free.bridge_address_alias",
        "$cleanup_bad_free.free_argument"
      ]
    },
    {
      "id": "a_invalid_port_return_reaches_line_buffer_free_unwind",
      "invariants": [
        "e_invalid_port_return_reaches_line_buffer_free_unwind"
      ],
      "kind": "transition",
      "from": "invalid_port_return",
      "at": "line_buffer_free",
      "check": [
        "eq",
        "$invalid_port_return.return_code",
        "$line_buffer_free.core_rc"
      ]
    }
  ]
}
