{
  "sample_id": "arvo_42520218",
  "content_hash": "sha256:df406742e321bc69179f192d4a634cc2f9ee38e1f73e55c41c7ed6a9a9a413fa",
  "assertions": [
    {
      "id": "A-ROOT-STATUS-FLAGS-FIT-ONE-BYTE",
      "invariants": [
        "I-ROOT-STATUS-FLAGS-FIT-ONE-BYTE"
      ],
      "kind": "required",
      "at": "status_flag_decode",
      "check": [
        "le",
        "$status_flag_decode.status_flags",
        255
      ],
      "protects": "address_state_materialized"
    },
    {
      "id": "A-ADDRESS-BLOCK-MATERIALIZES-UNDEFINED-BASE-ADDR",
      "invariants": [
        "I-ADDRESS-BLOCK-MATERIALIZES-UNDEFINED-BASE-ADDR"
      ],
      "kind": "observed",
      "at": "address_state_materialized",
      "check": [
        "eq",
        "$address_state_materialized.base_addr",
        "$address_state_materialized.haddr_undef_literal"
      ]
    },
    {
      "id": "A-UNDEFINED-BASE-ADDR-WRAPS-DEFAULT-EOA",
      "invariants": [
        "I-UNDEFINED-BASE-ADDR-WRAPS-DEFAULT-EOA",
        "I-WRAPPED-DEFAULT-EOA"
      ],
      "kind": "transition",
      "from": "address_state_materialized",
      "at": "wrapped_default_eoa",
      "check": [
        "lt",
        "$address_state_materialized.stored_eof_before_adjust",
        "$wrapped_default_eoa.eoa_argument"
      ]
    },
    {
      "id": "A-WRAPPED-EOA-REACHES-SHORT-OBJECT-HEADER-TRIM",
      "invariants": [
        "I-WRAPPED-EOA-REACHES-SHORT-OBJECT-HEADER-TRIM"
      ],
      "kind": "transition",
      "from": "wrapped_default_eoa",
      "at": "trimmed_object_header_read",
      "check": [
        "eq",
        "$wrapped_default_eoa.eoa_argument",
        "$trimmed_object_header_read.eoa"
      ]
    },
    {
      "id": "A-SHORT-OBJECT-HEADER-READ-LT-MAGIC",
      "invariants": [
        "I-SHORT-OBJECT-HEADER-READ-LT-MAGIC"
      ],
      "kind": "observed",
      "at": "trimmed_object_header_read",
      "check": [
        "lt",
        "$trimmed_object_header_read.trimmed_len",
        "$trimmed_object_header_read.magic_bytes_needed"
      ]
    },
    {
      "id": "A-SHORT-TRIM-LEN-ALLOCATES-TINY-OBJECT-HEADER-IMAGE",
      "invariants": [
        "I-SHORT-TRIM-LEN-ALLOCATES-TINY-OBJECT-HEADER-IMAGE",
        "I-TINY-OBJECT-HEADER-IMAGE-ALLOC"
      ],
      "kind": "transition",
      "from": "trimmed_object_header_read",
      "at": "tiny_object_header_image_alloc",
      "check": [
        "eq",
        "$trimmed_object_header_read.trimmed_len",
        "$tiny_object_header_image_alloc.image_len"
      ]
    },
    {
      "id": "A-TINY-OBJECT-HEADER-IMAGE-REACHES-MAGIC-MEMCMP",
      "invariants": [
        "I-TINY-OBJECT-HEADER-IMAGE-REACHES-MAGIC-MEMCMP",
        "I-SINK-MAGIC-MEMCMP-USES-TINY-IMAGE"
      ],
      "kind": "transition",
      "from": "tiny_object_header_image_alloc",
      "at": "object_header_magic_memcmp",
      "check": [
        "eq",
        "$tiny_object_header_image_alloc.image_ptr",
        "$object_header_magic_memcmp.image_ptr"
      ]
    }
  ]
}
