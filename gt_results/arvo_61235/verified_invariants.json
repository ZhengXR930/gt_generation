    {
      "invariant_id": "r_ctx_digits_must_fit_int32_compare_span",
      "role": "root_cause",
      "file": "src/jv.c",
      "function": "tsd_dec_ctx_get",
      "line": 539,
      "operands": [
        "ctx->digits",
        "INT32_MAX - (ctx->emax - ctx->emin - 1)"
      ],
      "relation": {
        "op": "le",
        "left": "ctx->digits",
        "right": "INT32_MAX - (ctx->emax - ctx->emin - 1)"
      },
      "verified": true,
      "verified_by": "a_ctx_digits_must_fit_int32_compare_span",
      "fine_trace_step": 1,
      "description": "jq widens the DEC_INIT_BASE decimal context to `DEC_MAX_DIGITS` without preserving decNumber's 32-bit compare invariant. With `ctx->emax = 999999999` and `ctx->emin = -999999999`, this makes the minimum subnormal exponent `ctx->emin - ctx->digits + 1 = -1999999997`, so a later exponent delta can exceed `INT32_MAX`. The fix replaces this assignment with `INT32_MAX - (ctx->emax - ctx->emin - 1)`."
    },
    {
