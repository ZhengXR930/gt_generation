{
  "sample_id": "arvo_61235",
  "content_hash": "sha256:e5c54f20152f498a237185efc6993614b4cfcc1883c2ccebdbeaf1bedfb9c3d0",
  "assertions": [
    {
      "id": "a_ctx_digits_must_fit_int32_compare_span",
      "invariants": [
        "r_ctx_digits_must_fit_int32_compare_span"
      ],
      "kind": "required",
      "at": "dec_ctx_init",
      "check": [
        "le",
        "$dec_ctx_init.ctx_digits",
        "$dec_ctx_init.digits_limit"
      ],
      "protects": "literal_compare_operands"
    },
    {
      "id": "a_root_min_subnormal_boundary_reaches_compare_lhs",
      "invariants": [
        "e_root_min_subnormal_boundary_reaches_compare_operands",
        "n_compare_operands_capture_literal_exponents"
      ],
      "kind": "transition",
      "from": "dec_ctx_init",
      "at": "literal_compare_operands",
      "check": [
        "eq",
        "$dec_ctx_init.min_subnormal_exponent",
        "$literal_compare_operands.lhs_exponent"
      ]
    },
    {
      "id": "a_lhs_exponent_flows_into_deccompare",
      "invariants": [
        "e_lhs_exponent_flows_into_deccompare"
      ],
      "kind": "transition",
      "from": "literal_compare_operands",
      "at": "dec_compare_delta",
      "check": [
        "eq",
        "$literal_compare_operands.lhs_exponent",
        "$dec_compare_delta.lhs_exponent"
      ]
    },
    {
      "id": "a_rhs_exponent_flows_into_deccompare",
      "invariants": [
        "e_rhs_exponent_flows_into_deccompare"
      ],
      "kind": "transition",
      "from": "literal_compare_operands",
      "at": "dec_compare_delta",
      "check": [
        "eq",
        "$literal_compare_operands.rhs_exponent",
        "$dec_compare_delta.rhs_exponent"
      ]
    },
    {
      "id": "a_deccompare_delta_wraps_negative",
      "invariants": [
        "n_overflowed_compare_delta"
      ],
      "kind": "observed",
      "at": "dec_compare_delta",
      "check": [
        "lt",
        "$dec_compare_delta.exp_delta",
        "$dec_compare_delta.zero_literal"
      ]
    },
    {
      "id": "a_negative_delta_reaches_d2u_sink",
      "invariants": [
        "e_overflowed_delta_reaches_d2u_sink"
      ],
      "kind": "transition",
      "from": "dec_compare_delta",
      "at": "dec_unit_compare_sink",
      "check": [
        "eq",
        "$dec_compare_delta.exp_delta",
        "$dec_unit_compare_sink.exp"
      ]
    },
    {
      "id": "a_d2u_sink_consumes_negative_exp",
      "invariants": [
        "n_d2u_negative_exp_sink"
      ],
      "kind": "observed",
      "at": "dec_unit_compare_sink",
      "check": [
        "lt",
        "$dec_unit_compare_sink.exp",
        "$dec_unit_compare_sink.zero_literal"
      ]
    }
  ]
}
