{
  "sample_id": "arvo_28064",
  "content_hash": "sha256:e28b161c4ef9311f0369529336ff02b5f8962cd813b7c62c711c4af5109c366e",
  "assertions": [
    {
      "id": "a_root_prev_coef_window_initialized_before_latch_copy",
      "invariants": [
        "r_prev_coef_window_initialized_before_latch_copy"
      ],
      "kind": "required",
      "at": "first_scan_prev_coef_state",
      "check": [
        "eq",
        "$first_scan_prev_coef_state.prev_coef_bits_initialized_prefix_len",
        "$first_scan_prev_coef_state.prev_coef_bits_read_bytes"
      ],
      "protects": "prev_latch_store"
    },
    {
      "id": "a_change_dc_reads_uninitialized_prev_latch",
      "invariants": [
        "n_change_dc_reads_uninitialized_prev_latch"
      ],
      "kind": "observed",
      "at": "change_dc_read",
      "check": [
        "gt",
        "$change_dc_read.coef_bits_read_bytes",
        "$change_dc_read.coef_bits_initialized_prefix_len"
      ]
    },
    {
      "id": "a_prev_coef_window_reaches_latch_store",
      "invariants": [
        "e_prev_coef_window_reaches_latch_store"
      ],
      "kind": "transition",
      "from": "first_scan_prev_coef_state",
      "at": "prev_latch_store",
      "check": [
        "eq",
        "$first_scan_prev_coef_state.prev_coef_bits_ptr",
        "$prev_latch_store.source_prev_coef_bits_ptr"
      ]
    },
    {
      "id": "a_prev_latch_window_reaches_change_dc",
      "invariants": [
        "e_prev_latch_window_reaches_change_dc"
      ],
      "kind": "transition",
      "from": "prev_latch_store",
      "at": "change_dc_read",
      "check": [
        "eq",
        "$prev_latch_store.stored_prev_latch_ptr",
        "$change_dc_read.coef_bits_ptr"
      ]
    },
    {
      "id": "a_prev_latch_store_copies_stale_prev_coef_window",
      "invariants": [
        "n_prev_latch_store_copies_stale_prev_coef_window"
      ],
      "kind": "observed",
      "at": "prev_latch_store",
      "check": [
        "eq",
        "$prev_latch_store.source_prev_coef_bits_initialized_prefix_len",
        "$prev_latch_store.stored_prev_latch_initialized_prefix_len"
      ]
    }
  ]
}
