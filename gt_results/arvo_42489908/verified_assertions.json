{
  "sample_id": "arvo_42489908",
  "content_hash": "sha256:29fc3e7f8e5411b8f568743dee695a2e5b3b1b5d98b0ac42adfebf6ae5910d3b",
  "assertions": [
    {
      "id": "A-ROOT-NONZERO-BACKREF-DISTANCE",
      "invariants": [
        "R-NONZERO-BACKREF-DISTANCE-BEFORE-COPY"
      ],
      "kind": "required",
      "at": "nonwrapping_guard",
      "check": [
        "gt",
        "$nonwrapping_guard.dist",
        0
      ],
      "protects": "backref_copy"
    },
    {
      "id": "A-SINK-ADLER32-SCANS-UNINITIALIZED-OUTPUT",
      "invariants": [
        "N-SINK-ADLER32-SCANS-UNINITIALIZED-OUTPUT"
      ],
      "kind": "observed",
      "at": "adler32_sink",
      "check": [
        "gt",
        "$adler32_sink.buf_len",
        "$adler32_sink.initialized_prefix_len"
      ]
    },
    {
      "id": "A-GUARD-DISTANCE-REACHES-BACKREF-COPY",
      "invariants": [
        "E-GUARD-DISTANCE-REACHES-BACKREF-COPY"
      ],
      "kind": "transition",
      "from": "nonwrapping_guard",
      "at": "backref_copy",
      "check": [
        "eq",
        "$nonwrapping_guard.dist",
        "$backref_copy.dist"
      ]
    },
    {
      "id": "A-OUTPUT-BASE-REACHES-ADLER32-SINK",
      "invariants": [
        "E-OUTPUT-BASE-REACHES-ADLER32-SINK"
      ],
      "kind": "transition",
      "from": "backref_copy",
      "at": "adler32_sink",
      "check": [
        "eq",
        "$backref_copy.output_base",
        "$adler32_sink.buf_base"
      ]
    },
    {
      "id": "A-BACKREF-COPY-READS-CURRENT-OUTPUT-CURSOR",
      "invariants": [
        "N-BACKREF-COPY-READS-CURRENT-OUTPUT-CURSOR"
      ],
      "kind": "observed",
      "at": "backref_copy",
      "check": [
        "eq",
        "$backref_copy.copy_src",
        "$backref_copy.copy_dest"
      ]
    }
  ]
}
