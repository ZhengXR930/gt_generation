{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42510080",
  "content_hash": "sha256:f451e41c30d474a0c925b2530350e224cb3eab76a2caf5bcbd90d77eea3715e1",
  "assertions": [
    {
      "id": "A-ROOT-MOVE-CONVERSION-INITIALIZES-DEST-BUFFER",
      "invariants": [
        "I-ROOT-MOVE-CONVERSION-INITIALIZES-DEST-BUFFER"
      ],
      "kind": "required",
      "at": "move_conversion_tail",
      "check": [
        "ge",
        "$move_conversion_tail.dest_initialized_prefix_len",
        "$move_conversion_tail.dest_total_len"
      ],
      "protects": "gnu_memcmp_probe"
    },
    {
      "id": "A-SINK-MEMCMP-READS-UNINITIALIZED-PREFIX",
      "invariants": [
        "I-SINK-MEMCMP-READS-UNINITIALIZED-PREFIX"
      ],
      "kind": "observed",
      "at": "gnu_memcmp_probe",
      "check": [
        "gt",
        "$gnu_memcmp_probe.memcmp_read_bytes",
        "$gnu_memcmp_probe.sink_initialized_prefix_len"
      ]
    },
    {
      "id": "A-PUBLISHED-DATA-BUFFER-REMAINS-UNINITIALIZED",
      "invariants": [
        "I-PUBLISHED-DATA-BUFFER-REMAINS-UNINITIALIZED"
      ],
      "kind": "observed",
      "at": "published_move_data",
      "check": [
        "lt",
        "$published_move_data.published_initialized_prefix_len",
        "$published_move_data.published_size"
      ]
    },
    {
      "id": "A-ROOT-DEST-BUFFER-REACHES-PUBLISHED-DATA",
      "invariants": [
        "I-ROOT-DEST-BUFFER-REACHES-PUBLISHED-DATA"
      ],
      "kind": "transition",
      "from": "move_conversion_tail",
      "at": "published_move_data",
      "check": [
        "eq",
        "$move_conversion_tail.dest_buf_ptr",
        "$published_move_data.published_buf_ptr"
      ]
    },
    {
      "id": "A-PUBLISHED-DATA-BUFFER-REACHES-SINK",
      "invariants": [
        "I-PUBLISHED-DATA-BUFFER-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "published_move_data",
      "at": "gnu_memcmp_probe",
      "check": [
        "eq",
        "$published_move_data.published_buf_ptr",
        "$gnu_memcmp_probe.sink_buf_ptr"
      ]
    }
  ]
}
