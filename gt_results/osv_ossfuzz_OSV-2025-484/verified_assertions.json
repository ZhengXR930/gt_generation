      ],
      "kind": "required",
      "at": "root_guard",
      "check": [
        "lt",
        "$root_guard.proto_id",
        "$root_guard.proto_defaults_num_allocated"
      ],
      "protects": "sink_tcp_read"
    },
    {
      "id": "observed.realloc_failure_returns_null",
      "invariants": [
        "node.realloc_failure_returns_null"
      ],
      "kind": "observed",
      "at": "realloc_failure",
      "check": [
        "eq",
        "$realloc_failure.new_ptr",
        "$realloc_failure.null_literal"
      ]
    },
    {
      "id": "observed.root_alias_points_past_last_valid_slot",
      "invariants": [
        "node.root_alias_points_past_last_valid_slot"
      ],
      "kind": "observed",
      "at": "root_alias",
      "check": [
        "gt",
        "$root_alias.def_ptr",
        "$root_alias.last_valid_ptr"
      ]
    },
    {
      "id": "transition.proto_id_selected_flows_to_root",
      "invariants": [
        "edge.proto_id_selected_flows_to_root"
      ],
      "kind": "transition",
      "from": "proto_slot_select",
      "at": "root_guard",
      "check": [
        "eq",
        "$proto_slot_select.proto_id",
        "$root_guard.proto_id"
      ]
    },
    {
      "id": "transition.alloc_bound_stays_old_after_failed_growth",
      "invariants": [
        "edge.alloc_bound_stays_old_after_failed_growth"
      ],
      "kind": "transition",
      "from": "realloc_failure",
      "at": "root_guard",
      "check": [
        "eq",
        "$realloc_failure.proto_defaults_num_allocated_before",
        "$root_guard.proto_defaults_num_allocated"
      ]
    },
    {
      "id": "transition.root_alias_reaches_tcp_sink",
      "invariants": [
        "edge.root_alias_reaches_tcp_sink",
        "node.sink_reads_root_alias"
      ],
      "kind": "transition",
      "from": "root_alias",
      "at": "sink_tcp_read",
      "check": [
        "eq",
        "$root_alias.def_ptr",
        "$sink_tcp_read.def_ptr"
      ]
    }
  ]
