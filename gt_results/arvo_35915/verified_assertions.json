  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_35915",
  "content_hash": "sha256:3ea84252b83141ac1545e54b35789a67e421cd451bbb629221e23907dc66dc90",
  "assertions": [
    {
      "id": "observed.folder_cnid_read_crosses_node",
      "invariants": [
        "node.folder_cnid_read_crosses_node"
      ],
      "kind": "observed",
      "at": "folder_cnid_read",
      "check": [
        "gt",
        "$folder_cnid_read.cnid_end_offset_in_node",
        "$folder_cnid_read.node_size"
      ]
    },
    {
      "id": "transition.alias_cnid_ptr_to_sink",
      "invariants": [
        "edge.folder_cnid_ptr_to_sink"
      ],
      "kind": "transition",
      "from": "folder_alias",
      "at": "folder_cnid_read",
      "check": [
        "eq",
        "$folder_alias.folder_cnid_ptr",
        "$folder_cnid_read.cnid_ptr"
      ]
    },
    {
      "id": "transition.guard_base_to_folder_alias",
      "invariants": [
        "edge.folder_base_to_alias",
        "node.folder_alias"
      ],
      "kind": "transition",
      "from": "folder_guard",
      "at": "folder_alias",
      "check": [
        "eq",
        "$folder_guard.folder_base_ptr",
        "$folder_alias.folder_ptr"
      ]
    }
  ]
}
