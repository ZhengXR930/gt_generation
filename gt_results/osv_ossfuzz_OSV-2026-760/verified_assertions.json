{
  "sample_id": "osv_ossfuzz_OSV-2026-760",
  "content_hash": "sha256:1469af66819ca4ca20d3b73728e2e4951beb866c3cddaef4dcb9a5e2966bdc99",
  "assertions": [
    {
      "id": "required.hash_label_size_not_wrapped",
      "invariants": [
        "N_ROOT_LABEL_SIZE_BOUND"
      ],
      "kind": "required",
      "at": "hash_call",
      "check": [
        "lt",
        "$hash_call.label_size",
        1000000
      ]
    },
    {
      "id": "transition.lookup_label_into_hash",
      "invariants": [
        "E_SOURCE_TO_HASH_CALL"
      ],
      "kind": "transition",
      "from": "source_label_materialized",
      "at": "hash_call",
      "check": [
        "eq",
        "$source_label_materialized.label_size",
        "$hash_call.label_size"
      ]
    },
    {
      "id": "observed.hash_call_uses_label_size",
      "invariants": [
        "N_HASH_CALL_LABEL_SIZE"
      ],
      "kind": "observed",
      "at": "hash_call",
      "check": [
        "eq",
        "$hash_call.label_size",
        "$hash_call.label_size"
      ]
    },
    {
      "id": "transition.hash_call_into_root_offset_domain",
      "invariants": [
        "E_HASH_CALL_TO_ROOT"
      ],
      "kind": "transition",
      "from": "hash_call",
      "at": "root_pre_decode",
      "check": [
        "eq",
        "$hash_call.label_size",
        "$root_pre_decode.size"
      ]
    },
    {
      "id": "observed.sink_utf8_huge_suffix",
      "invariants": [
        "N_SINK_UTF8_HUGE_SUFFIX"
      ],
      "kind": "observed",
      "at": "sink_utf8_read",
      "check": [
        "gt",
        "$sink_utf8_read.str_size",
        "$root_pre_decode.off"
      ]
    }
  ]
}
