{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_51757",
  "content_hash": "sha256:26d8eecdd248d51053473fe61c20389fccdd3f7ea63cd95d22f7c3500dee975e",
  "assertions": [
    {
      "id": "A-ROOT-ICMP-COPY-LEN-FITS-TX-PAYLOAD-CAPACITY",
      "invariants": [
        "I-ROOT-ICMP-COPY-LEN-FITS-TX-PAYLOAD-CAPACITY"
      ],
      "kind": "required",
      "at": "icmp_copy_guard",
      "check": [
        "le",
        "$icmp_copy_guard.effective_copy_len",
        "$icmp_copy_guard.tx_payload_capacity"
      ],
      "protects": "icmp_copy_sink"
    },
    {
      "id": "A-SINK-ICMP-MEMCPY-EXCEEDS-TX-PAYLOAD-CAPACITY",
      "invariants": [
        "I-SINK-ICMP-MEMCPY-EXCEEDS-TX-PAYLOAD-CAPACITY"
      ],
      "kind": "observed",
      "at": "icmp_copy_sink",
      "check": [
        "gt",
        "$icmp_copy_sink.copy_len",
        "$icmp_copy_sink.tx_payload_capacity"
      ]
    },
    {
      "id": "A-ICMP-COPY-LEN-REACHES-MEMCPY",
      "invariants": [
        "E-ICMP-COPY-LEN-REACHES-MEMCPY"
      ],
      "kind": "transition",
      "from": "icmp_copy_guard",
      "at": "icmp_copy_sink",
      "check": [
        "eq",
        "$icmp_copy_guard.effective_copy_len",
        "$icmp_copy_sink.copy_len"
      ]
    }
  ]
}
