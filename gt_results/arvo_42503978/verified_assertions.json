{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42503978",
  "content_hash": "sha256:7e7fab3e0a8841bc6b4170d2a67a193172d8abaa14ab6c4fd013add98e09ab67",
  "assertions": [
    {
      "id": "a_month_token_must_be_at_most_12",
      "invariants": [
        "r_month_token_must_be_at_most_12"
      ],
      "kind": "required",
      "at": "month_range_guard",
      "check": [
        "le",
        "$month_range_guard.month_token",
        12
      ],
      "protects": "month_yday_sink"
    },
    {
      "id": "a_month_index_overruns_month_yday",
      "invariants": [
        "n_month_index_overruns_month_yday"
      ],
      "kind": "observed",
      "at": "month_yday_sink",
      "check": [
        "ge",
        "$month_yday_sink.month_index",
        "$month_yday_sink.month_yday_entry_count"
      ]
    },
    {
      "id": "a_month_token_materializes_into_s_tm_mon",
      "invariants": [
        "e_month_token_materializes_into_s_tm_mon",
        "n_invalid_month_materialized_in_s_tm_mon"
      ],
      "kind": "transition",
      "from": "month_range_guard",
      "at": "month_accepted",
      "check": [
        "eq",
        "$month_range_guard.month_token",
        "$month_accepted.month_one_based"
      ]
    },
    {
      "id": "a_materialized_month_decrements_to_zero_based_index",
      "invariants": [
        "e_materialized_month_decrements_to_zero_based_index",
        "n_zero_based_month_index_is_out_of_bounds"
      ],
      "kind": "transition",
      "from": "month_accepted",
      "at": "month_zero_based",
      "check": [
        "gt",
        "$month_accepted.month_one_based",
        "$month_zero_based.month_index"
      ]
    },
    {
      "id": "a_zero_based_month_reaches_month_yday_index",
      "invariants": [
        "e_zero_based_month_reaches_month_yday_index"
      ],
      "kind": "transition",
      "from": "month_zero_based",
      "at": "month_yday_sink",
      "check": [
        "eq",
        "$month_zero_based.month_index",
        "$month_yday_sink.month_index"
      ]
    }
  ]
}
