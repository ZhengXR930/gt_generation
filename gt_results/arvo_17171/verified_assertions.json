{
  "sample_id": "arvo_17171",
  "content_hash": "sha256:f896a52e0d7744304360cad353dd7ccc17f1912feefd08f5aa3895b554acf7c5",
  "assertions": [
    {
      "id": "A-ROOT-RETURNED-DECRYPT-BUFFER-MUST-BE-UTF8",
      "invariants": [
        "I-ROOT-DECRYPTED-STRING-UTF8-BEFORE-XPATH-RETURN"
      ],
      "kind": "required",
      "at": "ret_utf8_guard",
      "check": [
        "ne",
        "$ret_utf8_guard.utf8_valid",
        "$ret_utf8_guard.zero_literal"
      ],
      "protects": "return_wrapped_string"
    },
    {
      "id": "A-SINK-PREFIX-EMISSION-SPAN-EXCEEDS-DECRYPTED-STORAGE",
      "invariants": [
        "I-SINK-PREFIX-EMISSION-SPAN-EXCEEDS-DECRYPTED-STORAGE"
      ],
      "kind": "observed",
      "at": "prefix_emit_window",
      "check": [
        "gt",
        "$prefix_emit_window.prefix_length",
        "$prefix_emit_window.format_storage_bytes"
      ]
    },
    {
      "id": "A-RET-POINTER-REACHES-FORMAT-NUMBER-CALL",
      "invariants": [
        "I-RET-POINTER-REACHES-FORMAT-ARG",
        "N_EVENT_format_number_call"
      ],
      "kind": "transition",
      "from": "return_wrapped_string",
      "at": "format_number_call",
      "check": [
        "eq",
        "$return_wrapped_string.ret_ptr",
        "$format_number_call.format_string_ptr"
      ]
    },
    {
      "id": "A-FORMAT-ARG-POINTER-REACHES-PREFIX-EMISSION",
      "invariants": [
        "I-FORMAT-ARG-POINTER-REACHES-PREFIX-LOOP"
      ],
      "kind": "transition",
      "from": "format_number_call",
      "at": "prefix_emit_window",
      "check": [
        "eq",
        "$format_number_call.format_string_ptr",
        "$prefix_emit_window.prefix_ptr"
      ]
    }
  ]
}
