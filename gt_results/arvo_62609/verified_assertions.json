{
  "sample_id": "arvo_62609",
  "content_hash": "sha256:7c5f13aa39d28f8e0839169bcc8cca1ad8bca3ea3a1f5538d67fa89048a5a168",
  "assertions": [
    {
      "id": "a_root_hex_validation",
      "invariants": [
        "r_missing_hex_digit_validation",
        "n_prefix_includes_nonhex"
      ],
      "kind": "required",
      "at": "prefix_scan",
      "check": [
        "eq",
        "$prefix_len",
        "$hex_prefix_len"
      ],
      "protects": "unhexn_result"
    },
    {
      "id": "a_prefix_len_feeds_unhexn",
      "invariants": [
        "e_prefix_len_determines_unhexn_span"
      ],
      "kind": "transition",
      "from": "prefix_scan",
      "at": "unhexn_result",
      "check": [
        "eq",
        "$prefix_scan.prefix_len",
        "$unhexn_result.prefix_len"
      ]
    },
    {
      "id": "a_n_exceeds_buffer",
      "invariants": [
        "n_guard_bypassed_by_overflow"
      ],
      "kind": "observed",
      "at": "guard_check",
      "check": [
        "gt",
        "$n",
        "$s_len"
      ]
    },
    {
      "id": "a_n_reaches_memmove_dl",
      "invariants": [
        "e_overflowed_n_reaches_memmove_dl",
        "n_sink_memmove_uses_overflowed_dl"
      ],
      "kind": "transition",
      "from": "unhexn_result",
      "at": "memmove_sink",
      "check": [
        "eq",
        "$unhexn_result.n",
        "$memmove_sink.dl"
      ]
    }
  ]
}
