{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42526893",
  "content_hash": "sha256:dc3f93ac4ed21056356fd7050d7a002e3430715918cf0304bafa41dac4b58341",
  "assertions": [
    {
      "id": "a_payload_lookup_must_reject_malformed_payload_tlv",
      "invariants": [
        "r_payload_lookup_must_reject_malformed_payload_tlv"
      ],
      "kind": "required",
      "at": "payload_lookup",
      "check": [
        "eq",
        "$payload_lookup.payload_is_null",
        1
      ],
      "protects": "payload_lookup"
    },
    {
      "id": "a_ipv4_dst_field_read_past_backing_layer_end",
      "invariants": [
        "n_ipv4_dst_field_read_past_backing_layer_end"
      ],
      "kind": "observed",
      "at": "ipv4_dst_read",
      "check": [
        "gt",
        "$ipv4_dst_read.dst_field_end_ptr",
        "$ipv4_dst_read.backing_layer_end_ptr"
      ]
    },
    {
      "id": "a_payload_ipv4_header_end_reaches_dst_field_end",
      "invariants": [
        "e_payload_ipv4_header_end_reaches_dst_field_end"
      ],
      "kind": "transition",
      "from": "payload_info",
      "at": "ipv4_dst_read",
      "check": [
        "eq",
        "$payload_info.payload_ipv4_header_end_ptr",
        "$ipv4_dst_read.dst_field_end_ptr"
      ]
    },
    {
      "id": "a_nflog_data_end_reaches_backing_layer_end",
      "invariants": [
        "e_nflog_data_end_reaches_backing_layer_end"
      ],
      "kind": "transition",
      "from": "payload_info",
      "at": "ipv4_dst_read",
      "check": [
        "eq",
        "$payload_info.nflog_data_end_ptr",
        "$ipv4_dst_read.backing_layer_end_ptr"
      ]
    },
    {
      "id": "a_payload_ipv4_header_exceeds_nflog_bytes",
      "invariants": [
        "n_payload_ipv4_header_exceeds_nflog_bytes"
      ],
      "kind": "observed",
      "at": "payload_info",
      "check": [
        "gt",
        "$payload_info.payload_ipv4_header_end_ptr",
        "$payload_info.nflog_data_end_ptr"
      ]
    }
  ]
}
