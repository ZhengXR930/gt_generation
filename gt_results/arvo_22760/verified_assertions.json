{
  "sample_id": "arvo_22760",
  "content_hash": "sha256:cc1bed8158472bac5bb5eef689620c06da5d18d1a559339a2e7acd3938b6d7b8",
  "assertions": [
    {
      "id": "a_barcode_crop_must_satisfy_size_gate",
      "invariants": [
        "r_barcode_crop_must_satisfy_size_gate"
      ],
      "kind": "required",
      "at": "barcode_size_gate",
      "check": [
        "eq",
        "$barcode_size_gate.size_gate_ok",
        1
      ],
      "protects": "scan_window_state"
    },
    {
      "id": "a_undersized_crop_reaches_scan_window",
      "invariants": [
        "e_undersized_crop_reaches_scan_window",
        "N_EVENT_barcode_size_gate"
      ],
      "kind": "transition",
      "from": "barcode_size_gate",
      "at": "scan_window_state",
      "check": [
        "eq",
        "$barcode_size_gate.crop_pix_ptr",
        "$scan_window_state.crop_pix_ptr"
      ]
    },
    {
      "id": "a_first_row_bound_reaches_first_read",
      "invariants": [
        "e_first_row_bound_reaches_first_read"
      ],
      "kind": "transition",
      "from": "scan_window_state",
      "at": "raster_first_row_read",
      "check": [
        "eq",
        "$scan_window_state.first_row",
        "$raster_first_row_read.row_index"
      ]
    },
    {
      "id": "a_first_read_runs_before_crop_start",
      "invariants": [
        "n_first_read_runs_before_crop_start"
      ],
      "kind": "observed",
      "at": "raster_first_row_read",
      "check": [
        "lt",
        "$raster_first_row_read.row_index",
        "$raster_first_row_read.zero_literal"
      ]
    }
  ]
}
