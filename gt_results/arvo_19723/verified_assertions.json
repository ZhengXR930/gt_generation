{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_19723",
  "content_hash": "sha256:4c99ea2c6fd66ad38a045238a042dd30f8771968a398b2007a64f6c3a47ce096",
  "assertions": [
    {
      "id": "REQ_ihbytes_valid",
      "invariants": [
        "N1_ihbytes_invalid"
      ],
      "kind": "required",
      "at": "ihbytes_parsed",
      "check": [
        "eq",
        "$ihbytes_valid",
        1
      ],
      "protects": "memcpy_colormap"
    },
    {
      "id": "OBS_ihbytes_negative",
      "invariants": [
        "N1_ihbytes_invalid"
      ],
      "kind": "observed",
      "at": "ihbytes_parsed",
      "check": [
        "lt",
        "$ihbytes",
        "$valid_ihbytes_min"
      ]
    },
    {
      "id": "TRANS_ihbytes_to_cmapbytes",
      "invariants": [
        "E1_ihbytes_propagation"
      ],
      "kind": "transition",
      "from": "ihbytes_parsed",
      "at": "cmapbytes_computed",
      "check": [
        "eq",
        "$cmapbytes_computed.ihbytes_used",
        "$ihbytes_parsed.ihbytes"
      ]
    },
    {
      "id": "OBS_cmapbytes_inflated",
      "invariants": [
        "N2_cmapbytes_corrupted"
      ],
      "kind": "observed",
      "at": "cmapbytes_computed",
      "check": [
        "gt",
        "$cmapbytes",
        "$expected_cmapbytes_for_valid_ih"
      ]
    },
    {
      "id": "TRANS_cmapbytes_to_memcpy",
      "invariants": [
        "E2_cmapbytes_to_memcpy"
      ],
      "kind": "transition",
      "from": "cmapbytes_computed",
      "at": "memcpy_colormap",
      "check": [
        "eq",
        "$memcpy_colormap.cmapEntries",
        "$cmapbytes_computed.cmapEntries"
      ]
    },
    {
      "id": "OBS_memcpy_src_underflow",
      "invariants": [
        "N3_sink_oob_read"
      ],
      "kind": "observed",
      "at": "memcpy_colormap",
      "check": [
        "lt",
        "$src_offset",
        "$buffer_start_offset"
      ]
    }
  ]
}
