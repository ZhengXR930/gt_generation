{
  "sample_id": "arvo_42475442",
  "content_hash": "sha256:9fa1cb087e1d4aa041b6465ffeb3cb2b4ae2ccc95213f7f8bd9813ef06791b92",
  "assertions": [
    {
      "id": "A-ROOT-SLOT1-IMMVAL-INITIALIZED",
      "invariants": [
        "I-ROOT-SLOT1-IMMVAL-INITIALIZED"
      ],
      "kind": "required",
      "at": "mcinst_init_slot1",
      "check": [
        "ge",
        "$mcinst_init_slot1.slot1_initialized_prefix_len",
        "$mcinst_init_slot1.slot1_read_bytes"
      ],
      "protects": "u1_imm_read"
    },
    {
      "id": "A-SINK-PRINTUINT32-BRANCH-USES-UNINITIALIZED-VAL",
      "invariants": [
        "I-SINK-PRINTUINT32-BRANCH-USES-UNINITIALIZED-VAL"
      ],
      "kind": "observed",
      "at": "printuint32_branch",
      "check": [
        "lt",
        "$printuint32_branch.val_initialized_prefix_len",
        "$printuint32_branch.val_access_bytes"
      ]
    },
    {
      "id": "A-ROOT-SLOT-REACHES-U1-READ",
      "invariants": [
        "I-ROOT-SLOT-REACHES-U1-READ"
      ],
      "kind": "transition",
      "from": "mcinst_init_slot1",
      "at": "u1_imm_read",
      "check": [
        "eq",
        "$mcinst_init_slot1.slot_ptr",
        "$u1_imm_read.slot_ptr"
      ]
    },
    {
      "id": "A-U1-VALUE-REACHES-PRINTUINT32",
      "invariants": [
        "I-U1-VALUE-REACHES-PRINTUINT32"
      ],
      "kind": "transition",
      "from": "u1_imm_read",
      "at": "printuint32_branch",
      "check": [
        "eq",
        "$u1_imm_read.value_bits",
        "$printuint32_branch.value_bits"
      ]
    },
    {
      "id": "A-U1-READ-LOADS-UNINITIALIZED-VALUE",
      "invariants": [
        "I-U1-READ-LOADS-UNINITIALIZED-VALUE"
      ],
      "kind": "observed",
      "at": "u1_imm_read",
      "check": [
        "lt",
        "$u1_imm_read.value_initialized_prefix_len",
        "$u1_imm_read.value_access_bytes"
      ]
    }
  ]
}
