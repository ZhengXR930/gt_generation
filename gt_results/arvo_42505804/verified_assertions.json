{
  "sample_id": "arvo_42505804",
  "content_hash": "sha256:da2da8a65f9846ea597456d43a98f0957411b1bac2ad4a8b14a265ff4b66c21a",
  "assertions": [
    {
      "id": "a_reused_string_lengths_must_match",
      "invariants": [
        "r_reused_string_lengths_must_match"
      ],
      "kind": "required",
      "at": "string_length_compare",
      "check": [
        "eq",
        "$string_length_compare.a_second",
        "$string_length_compare.b_second"
      ],
      "protects": "string_offset_reuse"
    },
    {
      "id": "a_reused_offset_points_to_shorter_string",
      "invariants": [
        "n_reused_offset_points_to_shorter_string"
      ],
      "kind": "observed",
      "at": "string_offset_reuse",
      "check": [
        "gt",
        "$string_offset_reuse.candidate_len",
        "$string_offset_reuse.reused_len"
      ]
    },
    {
      "id": "a_reused_short_string_reconstructs_longer_length",
      "invariants": [
        "e_reused_short_string_reconstructs_longer_length",
        "N_EVENT_stale_size_read"
      ],
      "kind": "transition",
      "from": "string_offset_reuse",
      "at": "stale_size_read",
      "check": [
        "gt",
        "$stale_size_read.reconstructed_length",
        "$string_offset_reuse.reused_len"
      ]
    },
    {
      "id": "a_reconstructed_length_reaches_escape_string",
      "invariants": [
        "e_reconstructed_length_reaches_escape_string",
        "n_escape_string_sink"
      ],
      "kind": "transition",
      "from": "stale_size_read",
      "at": "escape_string_sink",
      "check": [
        "eq",
        "$stale_size_read.reconstructed_length",
        "$escape_string_sink.length"
      ]
    }
  ]
}
