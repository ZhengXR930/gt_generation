  "sample_id": "arvo_11078",
  "content_hash": "sha256:fcacbc426743b60fbf15d5fbca543d54c5c26c393f100f788e90d06aa4ea852c",
  "assertions": [
    {
      "id": "A-ROOT-SUBBAND-INITIALIZED-BEFORE-LARGECODEBLOCK",
      "invariants": [
        "I-ROOT-SUBBAND-INITIALIZED-BEFORE-LARGECODEBLOCK"
      ],
      "kind": "required",
      "at": "large_codeblock_dispatch",
      "check": [
        "ge",
        "$large_codeblock_dispatch.subband_initialized_prefix_len",
        "$large_codeblock_dispatch.subband_read_bytes"
      ],
      "protects": "subband_index_read"
    },
    {
      "id": "A-SINK-SUBBAND-INDEX-READS-UNINITIALIZED-VALUE",
      "invariants": [
        "I-SINK-SUBBAND-INDEX-READS-UNINITIALIZED-VALUE"
      ],
      "kind": "observed",
      "at": "subband_index_read",
      "check": [
        "gt",
        "$subband_index_read.subband_read_bytes",
        "$subband_index_read.subband_initialized_prefix_len"
      ]
    },
    {
      "id": "A-DISPATCH-TO-SINK-SUBBAND-INITIALIZATION-STATE",
      "invariants": [
        "I-DISPATCH-TO-SINK-SUBBAND-INITIALIZATION-STATE"
      ],
      "kind": "transition",
      "from": "large_codeblock_dispatch",
      "at": "subband_index_read",
      "check": [
        "eq",
        "$large_codeblock_dispatch.subband_initialized_prefix_len",
        "$subband_index_read.subband_initialized_prefix_len"
      ]
    }
  ]
}
