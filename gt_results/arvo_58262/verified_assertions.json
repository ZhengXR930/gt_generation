{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_58262",
  "content_hash": "sha256:81e3cd3152ddfb48e17f953a2d0b68166ab9b90ffa279c9a9c1004e08531c22c",
  "assertions": [
    {
      "id": "A-ROOT-NFIELDS-COVERS-ATTRIBUTE-POINTS",
      "invariants": [
        "I-ROOT-NFIELDS-COVERS-ATTRIBUTE-POINTS"
      ],
      "kind": "required",
      "at": "fieldnames_dims_read",
      "check": [
        "ge",
        "$fieldnames_dims_read.nfields_after_dims",
        "$fieldnames_dims_read.attr_points"
      ],
      "protects": "fieldnames_attr_read"
    },
    {
      "id": "A-ALLOC-BYTES-SMALLER-THAN-ATTRIBUTE-READ",
      "invariants": [
        "I-ALLOC-BYTES-SMALLER-THAN-ATTRIBUTE-READ"
      ],
      "kind": "observed",
      "at": "fieldnames_alloc",
      "check": [
        "lt",
        "$fieldnames_alloc.alloc_bytes",
        "$fieldnames_alloc.required_bytes"
      ]
    },
    {
      "id": "A-SINK-H5AREAD-USES-UNDERSIZED-FIELD-SLOT-COUNT",
      "invariants": [
        "I-SINK-H5AREAD-USES-UNDERSIZED-FIELD-SLOT-COUNT"
      ],
      "kind": "observed",
      "at": "fieldnames_attr_read",
      "check": [
        "lt",
        "$fieldnames_attr_read.sink_slot_count",
        "$fieldnames_attr_read.attr_points"
      ]
    },
    {
      "id": "A-NFIELDS-PROPAGATES-INTO-ALLOC-SLOT-COUNT",
      "invariants": [
        "I-NFIELDS-TO-ALLOC-SLOT-COUNT"
      ],
      "kind": "transition",
      "from": "fieldnames_dims_read",
      "at": "fieldnames_alloc",
      "check": [
        "eq",
        "$fieldnames_dims_read.nfields_after_dims",
        "$fieldnames_alloc.allocated_slot_count"
      ]
    },
    {
      "id": "A-ALLOC-SLOT-COUNT-REACHES-H5AREAD-SINK",
      "invariants": [
        "I-ALLOC-SLOT-COUNT-TO-H5AREAD-SINK"
      ],
      "kind": "transition",
      "from": "fieldnames_alloc",
      "at": "fieldnames_attr_read",
      "check": [
        "eq",
        "$fieldnames_alloc.allocated_slot_count",
        "$fieldnames_attr_read.sink_slot_count"
      ]
    }
  ]
}
