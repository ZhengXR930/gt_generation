{
  "sample_id": "arvo_10955",
  "content_hash": "sha256:f681837ab3eb6ee93c6d066ad0935b42f106f122699a0ad2a4feb2b4f64e65b1",
  "assertions": [
    {
      "id": "A-ROOT-COPY-REQUIRES-LIVE-CURRENT",
      "invariants": [
        "I-ROOT-COPY-REQUIRES-LIVE-CURRENT"
      ],
      "kind": "required",
      "at": "current_insert_guard",
      "check": [
        "eq",
        "$current_insert_guard.actual_copy_condition",
        "$current_insert_guard.required_copy_condition"
      ],
      "protects": "advance_sink_reached"
    },
    {
      "id": "A-SINK-READS-UNINITIALIZED-GLYPH",
      "invariants": [
        "I-SINK-READS-UNINITIALIZED-GLYPH"
      ],
      "kind": "observed",
      "at": "advance_sink",
      "check": [
        "gt",
        "$advance_sink.glyph_size",
        "$advance_sink.glyph_initialized_prefix_len"
      ]
    },
    {
      "id": "A-COPY-TO-PRESERVE",
      "invariants": [
        "E-COPY-TO-PRESERVE",
        "N_EVENT_preserve_copy"
      ],
      "kind": "transition",
      "from": "copy_tail_glyph",
      "at": "preserve_copy",
      "check": [
        "eq",
        "$copy_tail_glyph.copied_slot_index",
        "$preserve_copy.preserved_slot_index"
      ]
    },
    {
      "id": "A-PRESERVE-TO-ADVANCE-CALL",
      "invariants": [
        "E-PRESERVE-TO-ADVANCE-CALL",
        "N_EVENT_advance_call"
      ],
      "kind": "transition",
      "from": "preserve_copy",
      "at": "advance_call",
      "check": [
        "eq",
        "$preserve_copy.preserved_slot_index",
        "$advance_call.loop_index"
      ]
    },
    {
      "id": "A-COPY-READS-END-SLOT",
      "invariants": [
        "I-COPY-READS-END-SLOT"
      ],
      "kind": "observed",
      "at": "copy_tail_glyph",
      "check": [
        "eq",
        "$copy_tail_glyph.idx_before_copy",
        "$copy_tail_glyph.len_before_copy"
      ]
    }
  ]
}
