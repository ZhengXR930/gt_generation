  "sample_id": "arvo_38943",
  "content_hash": "sha256:0eef27a63256727f50fe39fc53947cd91a37a40241900b51fee975318a69b468",
  "assertions": [
    {
      "id": "a_bucket_index_must_stay_in_directory",
      "invariants": [
        "r_bucket_index_must_stay_in_directory"
      ],
      "kind": "required",
      "at": "key_verify_guard",
      "check": [
        "lt",
        "$key_verify_guard.bucket",
        "$key_verify_guard.dir_count"
      ],
      "protects": "dir_index_read"
    },
    {
      "id": "a_dir_read_uses_out_of_range_bucket",
      "invariants": [
        "n_dir_read_uses_out_of_range_bucket"
      ],
      "kind": "observed",
      "at": "dir_index_read",
      "check": [
        "ge",
        "$dir_index_read.bucket",
        "$dir_index_read.dir_count"
      ]
    },
    {
      "id": "a_invalid_bucket_reaches_dir_read",
      "invariants": [
        "e_invalid_bucket_reaches_dir_read"
      ],
      "kind": "transition",
      "from": "key_verify_guard",
      "at": "dir_index_read",
      "check": [
        "eq",
        "$key_verify_guard.bucket",
        "$dir_index_read.bucket"
      ]
    }
  ]
}
