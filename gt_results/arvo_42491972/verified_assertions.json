{
  "sample_id": "arvo_42491972",
  "content_hash": "sha256:ab01a931af45e27730e7ed976e7dbe19ba8af8cfe7339a0e5c76f51563bac837",
  "assertions": [
    {
      "id": "A-ROOT-STRIPED-N-READ-HAS-REMAINING-BYTE",
      "invariants": [
        "R-STRIPED-N-READ-HAS-REMAINING-BYTE"
      ],
      "kind": "required",
      "at": "striped_n_guard",
      "check": [
        "lt",
        "$striped_n_guard.read_index",
        "$striped_n_guard.input_len"
      ],
      "protects": "striped_n_read"
    },
    {
      "id": "A-SINK-STRIPED-N-READ-INDEX-IS-OUT-OF-BOUNDS",
      "invariants": [
        "N-STRIPED-N-READ-INDEX-IS-OUT-OF-BOUNDS"
      ],
      "kind": "observed",
      "at": "striped_n_read",
      "check": [
        "ge",
        "$striped_n_read.read_index",
        "$striped_n_read.input_len"
      ]
    },
    {
      "id": "A-COMPRESSED-BLOCK-LENGTH-REACHES-STRIPED-N-GUARD",
      "invariants": [
        "E-COMPRESSED-BLOCK-LENGTH-REACHES-STRIPED-N-GUARD",
        "N-COMPRESSED-BLOCK-ALLOCATES-ARITH-INPUT-EXTENT"
      ],
      "kind": "transition",
      "from": "compressed_block_alloc",
      "at": "striped_n_guard",
      "check": [
        "eq",
        "$compressed_block_alloc.block_len",
        "$striped_n_guard.input_len"
      ]
    },
    {
      "id": "A-POST-VARINT-INDEX-REACHES-STRIPED-N-READ",
      "invariants": [
        "E-POST-VARINT-INDEX-REACHES-STRIPED-N-READ"
      ],
      "kind": "transition",
      "from": "striped_n_guard",
      "at": "striped_n_read",
      "check": [
        "eq",
        "$striped_n_guard.read_index",
        "$striped_n_read.read_index"
      ]
    }
  ]
}
