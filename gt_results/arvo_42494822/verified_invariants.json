  "root_cause_criterion": {
    "invariant_id": "r_wave_child_must_fit_remaining_payload",
    "type": "missing_obligation",
    "verified": true,
    "verified_by": "a_wave_child_must_fit_remaining_payload",
    "file": "src/isomedia/box_funcs.c",
    "function": "gf_isom_box_array_read_ex",
    "line": 1706,
    "fine_trace_step": 5,
    "variable": "parent->size",
    "missing_conjunct": "parent->size >= a->size",
    "criterion": "Before `gf_isom_box_array_read_ex()` registers a parsed child in `parent->child_boxes`, the remaining container payload must still cover that child (`parent->size >= a->size`). Oversized children must be rejected instead of falling through into the registration block.",
    "description": "On the crashing path, the inner `esds` under `wave` reaches this size check with `parent->size = 0x18` and `a->size = 0x73`, but vulnerable code only logs and keeps executing until the same child is registered. The fixed program aborts the oversize path before registration, so the malformed child never enters any ownership list."
  },
  "nodes": [
    {
