{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42494822",
  "content_hash": "sha256:af1f5d5d7926e793cbc08f983a1276242107cf4d2fda412cb23adc831d94fe31",
  "assertions": [
    {
      "id": "a_wave_child_must_fit_remaining_payload",
      "invariants": [
        "r_wave_child_must_fit_remaining_payload"
      ],
      "kind": "required",
      "at": "wave_child_size_check",
      "check": [
        "ge",
        "$wave_child_size_check.parent_payload_size",
        "$wave_child_size_check.child_box_size"
      ],
      "protects": "wave_child_registered"
    },
    {
      "id": "a_oversized_child_still_reaches_wave_registration",
      "invariants": [
        "e_oversize_fallthrough_registers_child",
        "n_oversized_child_registered"
      ],
      "kind": "transition",
      "from": "wave_child_size_check",
      "at": "wave_child_registered",
      "check": [
        "eq",
        "$wave_child_size_check.child_box_ptr",
        "$wave_child_registered.registered_box_ptr"
      ]
    },
    {
      "id": "a_registered_wave_child_becomes_ptr_esd",
      "invariants": [
        "e_wave_registration_aliases_ptr_esd",
        "n_ptr_esd_aliases_wave_child"
      ],
      "kind": "transition",
      "from": "wave_child_registered",
      "at": "wave_alias_bound",
      "check": [
        "eq",
        "$wave_child_registered.registered_box_ptr",
        "$wave_alias_bound.ptr_esd_ptr"
      ]
    },
    {
      "id": "a_ptr_esd_reaches_wrong_parent_free",
      "invariants": [
        "e_ptr_esd_is_freed_by_outer_cleanup",
        "n_outer_cleanup_frees_ptr_esd"
      ],
      "kind": "transition",
      "from": "wave_alias_bound",
      "at": "wrong_parent_free",
      "check": [
        "eq",
        "$wave_alias_bound.ptr_esd_ptr",
        "$wrong_parent_free.freed_box_ptr"
      ]
    },
    {
      "id": "a_freed_esds_pointer_reaches_box_del_sink",
      "invariants": [
        "e_freed_esds_pointer_reaches_box_del",
        "n_box_del_reads_freed_esds"
      ],
      "kind": "transition",
      "from": "wrong_parent_free",
      "at": "box_del_sink",
      "check": [
        "eq",
        "$wrong_parent_free.freed_box_ptr",
        "$box_del_sink.box_ptr"
      ]
    }
  ]
}
