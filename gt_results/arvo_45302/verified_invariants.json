      },
      "verified": true,
      "verified_by": "a_locateirb_probe_reaches_memcmp_sink",
      "fine_trace_step": 9,
      "description": "AddressSanitizer crash site. `memcmp` reads 4 bytes from the out-of-bounds pointer supplied after the wrapped remaining-length calculation."
    },
