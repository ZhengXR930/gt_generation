  "sample_id": "arvo_11248",
  "content_hash": "sha256:0752361fb0af9f05bb72e94373b3f83e0b3a3f282d1f239827e8a6f3c93bee00",
  "assertions": [
    {
      "id": "A-ROOT-PARSE-FAILURE-MUST-NOT-RETURN-FAILED-SLOT",
      "invariants": [
        "R-PARSE-FAILURE-MUST-NOT-RETURN-FAILED-SLOT"
      ],
      "kind": "required",
      "at": "getentry_parse_fail_return",
      "check": [
        "ne",
        "$getentry_parse_fail_return.returned_entry_ptr",
        "$getentry_parse_fail_return.failed_slot_ptr"
      ],
      "protects": "makestream_flag_read"
    },
    {
      "id": "A-GETENTRY-RESULT-REACHES-MAKESTREAM-FLAG-READ",
      "invariants": [
        "E-GETENTRY-RESULT-REACHES-MAKESTREAM-FLAG-READ",
        "N-MAKESTREAM-FLAG-READ-USES-GETENTRY-RESULT"
      ],
      "kind": "transition",
      "from": "getentry_parse_fail_return",
      "at": "makestream_flag_read",
      "check": [
        "eq",
        "$getentry_parse_fail_return.returned_entry_ptr",
        "$makestream_flag_read.entry_ptr"
      ]
    },
    {
      "id": "A-FAILED-SLOT-BEYOND-LOGICAL-SIZE",
      "invariants": [
        "N-FAILED-SLOT-BEYOND-LOGICAL-SIZE"
      ],
      "kind": "observed",
      "at": "getentry_parse_fail_return",
      "check": [
        "lt",
        "$getentry_parse_fail_return.logical_size",
        "$getentry_parse_fail_return.slot_index_plus_one"
      ]
    }
  ]
}
