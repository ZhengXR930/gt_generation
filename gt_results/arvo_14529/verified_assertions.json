      "invariants": [
        "r_header_count_below_capacity"
      ],
      "kind": "required",
      "at": "final_header_capacity_check",
      "protects": "final_header_store",
      "check": [
        "lt",
        "$final_header_capacity_check.n_headers",
        "$final_header_capacity_check.header_capacity"
      ]
    },
    {
      "id": "observed.store_index_reaches_capacity",
      "invariants": [
        "n_store_index_reaches_capacity"
      ],
      "kind": "observed",
      "at": "final_header_store",
      "check": [
        "eq",
        "$final_header_store.store_index",
        "$final_header_store.header_capacity"
      ]
    },
    {
      "id": "transition.full_count_to_store_index",
      "invariants": [
        "e_full_count_to_store_index"
      ],
      "kind": "transition",
      "from": "final_header_capacity_check",
      "at": "final_header_store",
      "check": [
        "eq",
        "$final_header_capacity_check.n_headers",
        "$final_header_store.store_index"
      ]
    },
    {
      "id": "observed.final_fragment_nonempty",
      "invariants": [
        "n_final_fragment_nonempty"
      ],
      "kind": "observed",
      "at": "final_header_fragment",
      "check": [
        "ne",
        "$final_header_fragment.next_chr",
        "$final_header_fragment.next_hdr"
      ]
    },
    {
      "id": "transition.guard_cursor_to_final_fragment",
      "invariants": [
        "e_guard_cursor_to_final_fragment"
      ],
      "kind": "transition",
      "from": "final_header_capacity_check",
      "at": "final_header_fragment",
      "check": [
        "eq",
        "$final_header_capacity_check.scan_cursor",
        "$final_header_fragment.next_chr"
      ]
    }
  ]
