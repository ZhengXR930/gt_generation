  "assertions": [
    {
      "id": "a_empty_arg_warning_must_use_empty_arg_source_offset",
      "invariants": [
        "r_empty_arg_warning_must_repair_errptr_position"
      ],
      "kind": "required",
      "at": "empty_arg_warning_guard",
      "check": [
        "eq",
        "$empty_arg_warning_guard.sanitize_pos",
        "$empty_arg_warning_guard.empty_arg_source_offset"
      ],
      "protects": "sanitize_sink"
    },
    {
      "id": "a_sanitize_pos_reaches_shift_branch",
      "invariants": [
        "e_unrepaired_errptr_position_reaches_sanitize_shift"
      ],
      "kind": "transition",
      "from": "empty_arg_warning_guard",
      "at": "sanitize_shift",
      "check": [
        "eq",
        "$empty_arg_warning_guard.sanitize_pos",
        "$sanitize_shift.pos"
      ]
    },
    {
      "id": "a_shift_branch_moves_input_beyond_line_end",
      "invariants": [
        "n_sanitize_shift_moves_input_beyond_line_end"
      ],
      "kind": "observed",
      "at": "sanitize_shift",
      "check": [
        "gt",
        "$sanitize_shift.shifted_in_ptr",
        "$sanitize_shift.line_end_ptr"
      ]
    },
    {
      "id": "a_shifted_input_reaches_sanitize_sink",
      "invariants": [
        "e_shifted_input_pointer_reaches_sanitize_sink",
        "n_sanitize_sink_reads_shifted_input"
      ],
      "kind": "transition",
      "from": "sanitize_shift",
      "at": "sanitize_sink",
      "check": [
        "eq",
        "$sanitize_shift.shifted_in_ptr",
        "$sanitize_sink.sink_in_ptr"
      ]
    }
  ]
