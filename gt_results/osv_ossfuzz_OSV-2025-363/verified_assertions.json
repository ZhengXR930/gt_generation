  "assertions": [
    {
      "id": "required.empty_string_has_terminator_byte",
      "invariants": [
        "root.empty_string_has_terminator_byte"
      ],
      "kind": "required",
      "at": "empty_string_root",
      "check": [
        "eq",
        "$empty_string_root.terminator_byte",
        "$empty_string_root.zero_literal"
      ],
      "protects": "format_sink"
    },
    {
      "id": "observed.implode_length_is_zero",
      "invariants": [
        "node.implode_length_is_zero"
      ],
      "kind": "observed",
      "at": "implode_length_zero",
      "check": [
        "eq",
        "$implode_length_zero.implode_length",
        "$implode_length_zero.zero_literal"
      ]
    },
    {
      "id": "observed.short_string_error_branch_taken",
      "invariants": [
        "node.short_string_error_branch_taken"
      ],
      "kind": "observed",
      "at": "short_string_msg",
      "check": [
        "lt",
        "$short_string_msg.key_length_bytes",
        "$short_string_msg.short_limit"
      ]
    },
    {
      "id": "observed.format_sink_reads_nonzero_first_byte",
      "invariants": [
        "node.format_sink_reads_nonzero_first_byte"
      ],
      "kind": "observed",
      "at": "format_sink",
      "check": [
        "ne",
        "$format_sink.string_arg_byte0",
        "$format_sink.zero_literal"
      ]
    },
    {
      "id": "transition.implode_length_flows_into_empty_string_constructor",
      "invariants": [
        "edge.implode_length_flows_into_empty_string_constructor"
      ],
      "kind": "transition",
      "from": "implode_length_zero",
      "at": "empty_string_root",
      "check": [
        "eq",
        "$implode_length_zero.implode_length",
        "$empty_string_root.length"
      ]
    },
    {
      "id": "transition.empty_string_data_reaches_implode_return",
      "invariants": [
        "edge.empty_string_data_reaches_implode_return",
        "N_EVENT_implode_return"
      ],
      "kind": "transition",
      "from": "empty_string_root",
      "at": "implode_return",
      "check": [
        "eq",
        "$empty_string_root.data_ptr",
        "$implode_return.string_data_ptr"
      ]
    },
    {
      "id": "transition.implode_return_data_becomes_index_key",
      "invariants": [
        "edge.implode_return_data_becomes_index_key"
      ],
      "kind": "transition",
      "from": "implode_return",
      "at": "short_string_msg",
      "check": [
        "eq",
        "$implode_return.string_data_ptr",
        "$short_string_msg.key_data_ptr"
      ]
    },
    {
      "id": "transition.index_key_data_reaches_format_sink",
      "invariants": [
        "edge.index_key_data_reaches_format_sink"
      ],
      "kind": "transition",
      "from": "short_string_msg",
      "at": "format_sink",
      "check": [
        "eq",
        "$short_string_msg.key_data_ptr",
        "$format_sink.string_arg_ptr"
      ]
    }
  ]
