{
  "sample_id": "secbench_oss_libxml2.ossfuzz-42522712",
  "content_hash": "sha256:858a706c45e7759c8e0d2dca4ee4d36693b58fd02851e9e54a781bdfa0afec0f",
  "assertions": [
    {
      "id": "A_ROOT_BOUNDS",
      "kind": "required",
      "at": "root",
      "protects": "sink",
      "mechanism": "bounds",
      "description": "Before calling xmlStrndup on the parsed SYSTEM literal, the copied extent must stay within the current input buffer: startPosition + len must not exceed ctxt->input->end - BASE_PTR.",
      "check": [
        "le",
        "$root.end_off",
        "$root.limit_off"
      ],
      "invariants": [
        "N_ROOT"
      ]
    },
    {
      "id": "A_SOURCE_TO_ROOT_START",
      "kind": "transition",
      "from": "source",
      "at": "root",
      "protects": "sink",
      "description": "The start offset captured when the quoted literal begins is the same offset used to form the xmlStrndup source pointer.",
      "check": [
        "eq",
        "$source.start_off",
        "$root.start_off"
      ],
      "invariants": [
        "E_SOURCE_TO_ROOT"
      ]
    },
    {
      "id": "A_ROOT_TO_SINK_PTR",
      "kind": "transition",
      "from": "root",
      "at": "sink",
      "protects": "sink",
      "description": "The pointer passed from htmlParseSystemLiteral is the same pointer consumed by xmlStrndup.",
      "check": [
        "eq",
        "$root.ptr",
        "$sink.ptr"
      ],
      "invariants": [
        "E_ROOT_TO_SINK_PTR"
      ]
    },
    {
      "id": "A_ROOT_TO_SINK_LEN",
      "kind": "transition",
      "from": "root",
      "at": "sink",
      "protects": "sink",
      "description": "The length counted in htmlParseSystemLiteral is the same length consumed by xmlStrndup.",
      "check": [
        "eq",
        "$root.len",
        "$sink.len"
      ],
      "invariants": [
        "E_ROOT_TO_SINK_LEN"
      ]
    },
    {
      "id": "A_SINK_REMAIN_LT_LEN",
      "kind": "observed",
      "at": "sink",
      "protects": "sink",
      "description": "In the crashing vulnerable execution, the remaining bytes from cur to the current input end are smaller than the length xmlStrndup tries to copy.",
      "check": [
        "lt",
        "$sink.remain",
        "$sink.len"
      ],
      "invariants": [
        "N_SINK"
      ]
    }
  ]
}
