{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_58108",
  "content_hash": "sha256:0be0cd2ec2094e8555048866e5bfd7b41db5425022957498f828d962e58f8fb8",
  "assertions": [
    {
      "id": "A-ROOT-UNIQUE-USERNAME-BEFORE-HASH-ADD",
      "invariants": [
        "I-ROOT-UNIQUE-USERNAME-BEFORE-HASH-ADD"
      ],
      "kind": "required",
      "at": "duplicate_guard",
      "check": [
        "eq",
        "$duplicate_guard.existing_client_ptr",
        "$duplicate_guard.null_literal"
      ],
      "protects": "subsequent_insert_post"
    },
    {
      "id": "A-SUBSEQUENT-INSERT-POINTER-REACHES-CLEANUP-LOOKUP",
      "invariants": [
        "I-SUBSEQUENT-INSERT-POINTER-REACHES-CLEANUP-LOOKUP"
      ],
      "kind": "transition",
      "from": "subsequent_insert_post",
      "at": "cleanup_lookup",
      "check": [
        "eq",
        "$subsequent_insert_post.inserted_client_ptr",
        "$cleanup_lookup.client_found_ptr"
      ]
    },
    {
      "id": "A-CLEANUP-LOOKUP-RETURNS-DIFFERENT-CLIENT",
      "invariants": [
        "I-CLEANUP-LOOKUP-RETURNS-DIFFERENT-CLIENT"
      ],
      "kind": "observed",
      "at": "cleanup_lookup",
      "check": [
        "ne",
        "$cleanup_lookup.current_client_ptr",
        "$cleanup_lookup.client_found_ptr"
      ]
    },
    {
      "id": "A-CURRENT-CLIENT-POINTER-BECOMES-DANGLING-HEAD",
      "invariants": [
        "I-CURRENT-CLIENT-POINTER-BECOMES-DANGLING-HEAD",
        "I-DANGLING-CLIENTS-HEAD-CREATED-BY-FREE"
      ],
      "kind": "transition",
      "from": "cleanup_lookup",
      "at": "free_head_post",
      "check": [
        "eq",
        "$cleanup_lookup.current_client_ptr",
        "$free_head_post.clients_head_after_free"
      ]
    },
    {
      "id": "A-DANGLING-HEAD-REACHES-HASH-FIND",
      "invariants": [
        "I-DANGLING-HEAD-REACHES-HASH-FIND",
        "I-SINK-HASH-FIND-USES-DANGLING-HEAD"
      ],
      "kind": "transition",
      "from": "free_head_post",
      "at": "find_sink",
      "check": [
        "eq",
        "$free_head_post.clients_head_after_free",
        "$find_sink.clients_head_before_find"
      ]
    }
  ]
}
