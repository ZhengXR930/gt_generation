{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42491502",
  "content_hash": "sha256:ec2968db8bf6fa1096f229a012666cca688bec4edffd6f0e3a0796c33c83c0ad",
  "assertions": [
    {
      "id": "A-ROOT-LAZYCHUNK-CBYTES-FITS-FRAME",
      "invariants": [
        "R-LAZYCHUNK-CBYTES-FITS-FRAME"
      ],
      "kind": "required",
      "at": "lazychunk_bounds",
      "check": [
        "ge",
        "$lazychunk_bounds.frame_remaining_bytes_from_chunk",
        "$lazychunk_bounds.chunk_cbytes"
      ],
      "protects": "dict_context_setup"
    },
    {
      "id": "A-SINK-DDICT-COPY-EXCEEDS-REMAINING-FRAME-BYTES",
      "invariants": [
        "N-SINK-DDICT-COPY-EXCEEDS-REMAINING-FRAME-BYTES"
      ],
      "kind": "observed",
      "at": "ddict_memcpy_sink",
      "check": [
        "gt",
        "$ddict_memcpy_sink.dict_size",
        "$frame_chunk_window.frame_remaining_bytes_from_dict"
      ]
    },
    {
      "id": "A-LAZYCHUNK-CBYTES-REACH-DICT-SRCSIZE",
      "invariants": [
        "E-LAZYCHUNK-CBYTES-REACH-DICT-SRCSIZE"
      ],
      "kind": "transition",
      "from": "lazychunk_bounds",
      "at": "dict_context_setup",
      "check": [
        "eq",
        "$lazychunk_bounds.chunk_cbytes",
        "$dict_context_setup.srcsize_arg"
      ]
    },
    {
      "id": "A-DICT-PAYLOAD-PTR-REACH-DDICT-SINK",
      "invariants": [
        "E-DICT-PAYLOAD-PTR-REACH-DDICT-SINK"
      ],
      "kind": "transition",
      "from": "frame_chunk_window",
      "at": "ddict_memcpy_sink",
      "check": [
        "eq",
        "$frame_chunk_window.candidate_dict_ptr",
        "$ddict_memcpy_sink.dict_ptr"
      ]
    },
    {
      "id": "A-DICT-SIZE-REACH-DDICT-SINK",
      "invariants": [
        "E-DICT-SIZE-REACH-DDICT-SINK"
      ],
      "kind": "transition",
      "from": "dict_context_setup",
      "at": "ddict_memcpy_sink",
      "check": [
        "eq",
        "$dict_context_setup.dict_size",
        "$ddict_memcpy_sink.dict_size"
      ]
    }
  ]
}
