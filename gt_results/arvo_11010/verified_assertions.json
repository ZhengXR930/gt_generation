{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_11010",
  "content_hash": "sha256:954955839c0c1ccec9d7056c03e6c896087f216e7799e4331c0350cfd3c63d75",
  "assertions": [
    {
      "id": "REQ-contextual-lookup-offset-nonzero",
      "invariants": [
        "r_contextual_lookup_offset_nonzero"
      ],
      "kind": "required",
      "at": "contextual_lookup_offset",
      "check": [
        "ne",
        "$contextual_lookup_offset.lookup_offset",
        "$contextual_lookup_offset.zero_literal"
      ],
      "protects": "contextual_lookup_offset"
    },
    {
      "id": "OBS-null-derived-lookup-dispatches-format0",
      "invariants": [
        "n_null_lookup_dispatches_as_format0"
      ],
      "kind": "observed",
      "at": "lookup_dispatch",
      "check": [
        "eq",
        "$lookup_dispatch.lookup_format",
        "$lookup_dispatch.format0_literal"
      ]
    },
    {
      "id": "OBS-current-replacement-pointer-nonnull",
      "invariants": [
        "n_current_replacement_sink_uses_nonnull_pointer"
      ],
      "kind": "observed",
      "at": "current_replacement_sink",
      "check": [
        "ne",
        "$current_replacement_sink.replacement_ptr",
        "$current_replacement_sink.null_literal"
      ]
    },
    {
      "id": "TRANS-contextual-offset-reaches-selected-lookup",
      "invariants": [
        "e_contextual_offset_reaches_selected_lookup"
      ],
      "kind": "transition",
      "from": "contextual_lookup_offset",
      "at": "selected_lookup",
      "check": [
        "eq",
        "$contextual_lookup_offset.lookup_offset",
        "$selected_lookup.selected_lookup_offset"
      ]
    },
    {
      "id": "TRANS-selected-lookup-object-reaches-dispatch",
      "invariants": [
        "e_selected_lookup_object_reaches_dispatch"
      ],
      "kind": "transition",
      "from": "selected_lookup",
      "at": "lookup_dispatch",
      "check": [
        "eq",
        "$selected_lookup.lookup_ref_ptr",
        "$lookup_dispatch.lookup_this_ptr"
      ]
    },
    {
      "id": "TRANS-dispatched-lookup-object-reaches-format0-compute",
      "invariants": [
        "e_dispatched_lookup_object_reaches_format0_compute"
      ],
      "kind": "transition",
      "from": "lookup_dispatch",
      "at": "replacement_compute",
      "check": [
        "eq",
        "$lookup_dispatch.lookup_this_ptr",
        "$replacement_compute.lookup_this_ptr"
      ]
    },
    {
      "id": "TRANS-format0-replacement-pointer-reaches-sink",
      "invariants": [
        "e_format0_replacement_pointer_reaches_sink"
      ],
      "kind": "transition",
      "from": "replacement_compute",
      "at": "current_replacement_sink",
      "check": [
        "eq",
        "$replacement_compute.replacement_ptr",
        "$current_replacement_sink.replacement_ptr"
      ]
    }
  ]
}
