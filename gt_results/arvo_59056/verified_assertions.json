      "kind": "transition",
      "from": "eof_cleanup_guard",
      "at": "bad_free_sink",
      "check": [
        "eq",
        "$eof_cleanup_guard.cleanup_argument",
        "$bad_free_sink.free_argument"
      ]
    }
  ]
