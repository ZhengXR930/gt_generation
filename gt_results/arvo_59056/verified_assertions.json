      ],
      "kind": "observed",
      "at": "stack_element_alloc",
      "check": [
        "eq",
        "$stack_element_alloc.allocator_owns_element",
        "$stack_element_alloc.true_literal"
      ]
    },
    {
      "id": "a_non_toplevel_eof_cleanup_plain_delete_matches_element_ownership",
      "invariants": [
        "r_non_toplevel_eof_cleanup_plain_delete_matches_element_ownership"
      ],
      "kind": "required",
      "at": "eof_cleanup_guard",
      "check": [
        "eq",
        "$eof_cleanup_guard.plain_delete_enabled",
        "$eof_cleanup_guard.plain_delete_allowed"
      ]
    },
    {
      "id": "a_stack_element_reaches_eof_cleanup",
      "invariants": [
        "e_stack_element_reaches_eof_cleanup"
      ],
      "kind": "transition",
      "from": "stack_element_alloc",
      "at": "eof_cleanup_guard",
      "check": [
        "eq",
        "$stack_element_alloc.element_ptr",
        "$eof_cleanup_guard.cleanup_argument"
      ]
    },
    {
      "id": "a_eof_cleanup_argument_reaches_bad_free_sink",
      "invariants": [
        "e_eof_cleanup_argument_reaches_bad_free_sink",
        "n_bad_free_sink_argument"
