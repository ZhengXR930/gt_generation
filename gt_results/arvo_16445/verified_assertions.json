  "content_hash": "sha256:d46897bc67bee0598fc8fe7ddcd41347573c05ce0804df9031b58e37fe475c3d",
  "assertions": [
    {
      "id": "a_lit_size_must_fit_block_before_raw_copy",
      "invariants": [
        "r_lit_size_must_fit_block_before_raw_copy"
      ],
      "kind": "required",
      "at": "raw_copy_guard",
      "check": [
        "le",
        "$raw_copy_guard.lit_size",
        "$raw_copy_guard.block_limit"
      ],
      "protects": "raw_copy_sink"
    },
    {
      "id": "a_raw_copy_size_exceeds_litbuffer_capacity",
      "invariants": [
        "n_raw_copy_size_exceeds_litbuffer_capacity"
      ],
      "kind": "observed",
      "at": "raw_copy_sink",
      "check": [
        "gt",
        "$raw_copy_sink.copy_size",
        "$raw_copy_sink.litbuffer_capacity"
      ]
    },
    {
      "id": "a_unchecked_lit_size_reaches_raw_copy",
      "invariants": [
        "e_unchecked_lit_size_reaches_raw_copy"
      ],
      "kind": "transition",
      "from": "raw_copy_guard",
      "at": "raw_copy_sink",
      "check": [
        "eq",
        "$raw_copy_guard.lit_size",
        "$raw_copy_sink.copy_size"
      ]
    }
  ]
}
