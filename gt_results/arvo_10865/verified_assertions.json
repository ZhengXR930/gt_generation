{
  "sample_id": "arvo_10865",
  "content_hash": "sha256:df68cb9f3798eecd8b194d5c4885fde70fced7cb7707be4e075f49b15d30fc04",
  "assertions": [
    {
      "id": "A-ROOT-MD2-FITS-STACK",
      "invariants": [
        "r_md2_size_fits_stack_metadata"
      ],
      "kind": "required",
      "at": "md2_guard",
      "check": [
        "le",
        "$md2_guard.md_size",
        "$md2_guard.metadata_extent"
      ],
      "protects": "memcpy_sink"
    },
    {
      "id": "A-STALE-MD2-BUFFER-SPILLED-OFF-STACK",
      "invariants": [
        "n_current_md2_buffer_no_longer_aliases_stack_metadata"
      ],
      "kind": "observed",
      "at": "md2_guard",
      "check": [
        "ne",
        "$md2_guard.current_md2_ptr",
        "$md2_guard.metadata_ptr"
      ]
    },
    {
      "id": "A-STACK-METADATA-POINTER-REACHES-SINK",
      "invariants": [
        "e_stack_metadata_pointer_reaches_memcpy_src",
        "e_stack_metadata_pointer_reaches_memcpy_src_edge"
      ],
      "kind": "transition",
      "from": "md2_guard",
      "at": "memcpy_sink",
      "check": [
        "eq",
        "$md2_guard.metadata_ptr",
        "$memcpy_sink.src_ptr"
      ]
    },
    {
      "id": "A-MD-SIZE-REACHES-SINK",
      "invariants": [
        "e_md_size_reaches_memcpy_len"
      ],
      "kind": "transition",
      "from": "md2_guard",
      "at": "memcpy_sink",
      "check": [
        "eq",
        "$md2_guard.md_size",
        "$memcpy_sink.copy_size"
      ]
    }
  ]
}
