      "verified": true,
      "verified_by": "a_freed_merged_run_reaches_sink_prev_isolate",
      "fine_trace_step": 12,
      "description": "AddressSanitizer crash site. The later `compact_list()` merge reaches a run whose `prev_isolate` still aliases a `FriBidiRun` freed by the immediately preceding merge, so this write stores through a dangling pointer."
    },
