  "assertions": [
    {
      "id": "required.rtcm3_data_len_fits_10_bits",
      "invariants": [
        "root.rtcm3_data_len_fits_10_bits"
      ],
      "kind": "required",
      "at": "rtcm3_length_extract",
      "check": [
        "le",
        "$rtcm3_length_extract.data_len",
        1023
      ],
      "protects": "rtcm3_length_extract"
    },
    {
      "id": "observed.rescan_breaks_at_buffer_start",
      "invariants": [
        "node.rescan_breaks_at_buffer_start"
      ],
      "kind": "observed",
      "at": "rtcm3_rescan",
      "check": [
        "eq",
        "$rtcm3_rescan.selected_idx",
        "$rtcm3_rescan.zero_literal"
      ]
    },
    {
      "id": "observed.crc_claim_exceeds_buffered_bytes",
      "invariants": [
        "node.crc_claim_exceeds_buffered_bytes"
      ],
      "kind": "observed",
      "at": "crc_span_call",
      "check": [
        "gt",
        "$crc_span_call.claimed_packet_bytes",
        "$crc_span_call.buffered_bytes"
      ]
    },
    {
      "id": "transition.rescan_idx_carries_into_length_extract",
      "invariants": [
        "edge.rescan_idx_carries_into_length_extract"
      ],
      "kind": "transition",
      "from": "rtcm3_rescan",
      "at": "rtcm3_length_extract",
      "check": [
        "eq",
        "$rtcm3_rescan.selected_idx",
        "$rtcm3_length_extract.selected_idx"
      ]
    },
    {
      "id": "transition.data_len_carries_to_crc_span_call",
      "invariants": [
        "edge.data_len_carries_to_crc_span_call",
        "N_EVENT_crc_span_call"
      ],
      "kind": "transition",
      "from": "rtcm3_length_extract",
      "at": "crc_span_call",
      "check": [
        "eq",
        "$rtcm3_length_extract.data_len",
        "$crc_span_call.data_len"
      ]
    }
  ]
