      ],
      "kind": "required",
      "at": "look_behind_guard",
      "check": [
        "eq",
        "$look_behind_guard.used_capture",
        0
      ],
      "protects": "capture_node_free"
    },
    {
      "id": "a_root_capture_reaches_free",
      "invariants": [
        "e_root_capture_reaches_free",
        "n_capture_node_freed"
      ],
      "kind": "transition",
      "from": "look_behind_guard",
      "at": "capture_node_free",
      "check": [
        "eq",
        "$look_behind_guard.capture_node_ptr",
        "$capture_node_free.capture_node_ptr"
      ]
    },
    {
      "id": "a_freed_capture_reloads_from_mem_env",
      "invariants": [
        "e_freed_capture_reloads_from_mem_env",
        "n_stale_capture_reloaded_from_mem_env"
      ],
      "kind": "transition",
      "from": "capture_node_free",
      "at": "stale_mem_env_reload",
      "check": [
        "eq",
        "$capture_node_free.capture_node_ptr",
        "$stale_mem_env_reload.mem_node_ptr"
      ]
    },
    {
      "id": "a_reloaded_capture_reaches_node_type_read",
      "invariants": [
        "e_reloaded_capture_reaches_node_type_read",
        "n_node_type_read_uses_reloaded_capture"
