      "kind": "observed",
      "at": "fallback_empty_state",
      "check": [
        "eq",
        "$fallback_empty_state.fallback_copy_ptr",
        "$fallback_empty_state.null_literal"
      ]
    },
    {
      "id": "a_reader_cleanup_runs_outside_in_xinclude",
      "invariants": [
        "n_reader_cleanup_runs_outside_in_xinclude"
      ],
      "kind": "observed",
      "at": "reader_cleanup",
      "check": [
        "eq",
        "$reader_cleanup.in_xinclude_before_free",
        "$reader_cleanup.zero_literal"
      ]
    },
    {
