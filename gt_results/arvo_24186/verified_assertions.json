{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_24186",
  "content_hash": "sha256:a8f2611b15f9e4d7727091961e050321f4c79c2608c363781d5251b5bdda52f2",
  "assertions": [
    {
      "id": "a_root_distance_symbol_below_30",
      "invariants": [
        "r_distance_symbol_below_30_before_lookup"
      ],
      "kind": "required",
      "at": "distance_guard",
      "check": [
        "lt",
        "$distance_guard.distance_symbol",
        30
      ],
      "protects": "distance_lookup"
    },
    {
      "id": "a_sink_reads_uninitialized_rgb16",
      "invariants": [
        "n_transparency16_reads_uninitialized_rgb"
      ],
      "kind": "observed",
      "at": "transparency_sink",
      "check": [
        "gt",
        "$transparency_sink.rgb_read_bytes",
        "$transparency_sink.rgb_initialized_prefix_len"
      ]
    },
    {
      "id": "a_distance_symbol_reaches_copy_loop",
      "invariants": [
        "e_distance_symbol_reaches_copy_loop"
      ],
      "kind": "transition",
      "from": "distance_guard",
      "at": "backref_copy",
      "check": [
        "eq",
        "$distance_guard.distance_symbol",
        "$backref_copy.distance_symbol"
      ]
    },
    {
      "id": "a_decompressed_row_buffer_reaches_png_pass",
      "invariants": [
        "e_decompressed_row_buffer_reaches_png_pass"
      ],
      "kind": "transition",
      "from": "backref_copy",
      "at": "image_raw_copy",
      "check": [
        "eq",
        "$backref_copy.zlib_output_ptr",
        "$image_raw_copy.row_buffer_ptr"
      ]
    },
    {
      "id": "a_uninitialized_pass_rgb_reaches_transparency_sink",
      "invariants": [
        "e_uninitialized_pass_rgb_reaches_transparency_sink"
      ],
      "kind": "transition",
      "from": "image_raw_copy",
      "at": "transparency_sink",
      "check": [
        "le",
        "$transparency_sink.rgb_initialized_prefix_len",
        "$image_raw_copy.cur_rgb_initialized_prefix_len"
      ]
    },
    {
      "id": "a_copy_reads_current_output_cursor",
      "invariants": [
        "n_copy_reads_current_output_cursor"
      ],
      "kind": "observed",
      "at": "backref_copy",
      "check": [
        "eq",
        "$backref_copy.copy_source_ptr",
        "$backref_copy.copy_dest_ptr"
      ]
    },
    {
      "id": "a_png_pass_buffer_contains_uninitialized_rgb",
      "invariants": [
        "n_png_pass_buffer_contains_uninitialized_rgb"
      ],
      "kind": "observed",
      "at": "image_raw_copy",
      "check": [
        "gt",
        "$image_raw_copy.rgb_read_bytes",
        "$image_raw_copy.cur_rgb_initialized_prefix_len"
      ]
    }
  ]
}
