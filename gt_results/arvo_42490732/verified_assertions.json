{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42490732",
  "content_hash": "sha256:1f61db8f6e536f28692740e6bde98f561a8116d382d95aba5a3384fd2e87c43e",
  "assertions": [
    {
      "id": "A-ROOT-REMAINING-LENGTH-READ-MUST-WRITE-BYTE",
      "invariants": [
        "R-REMAINING-LENGTH-READ-MUST-WRITE-BYTE"
      ],
      "kind": "required",
      "at": "remaining_length_guard",
      "check": [
        "ne",
        "$remaining_length_guard.nread",
        "$remaining_length_guard.zero_literal"
      ],
      "protects": "remaining_length_store"
    },
    {
      "id": "A-SINK-BRANCH-READS-BYTE-WITHOUT-INITIALIZED-PREFIX",
      "invariants": [
        "N-SINK-BRANCH-READS-BYTE-WITHOUT-INITIALIZED-PREFIX"
      ],
      "kind": "observed",
      "at": "remaining_length_sink",
      "check": [
        "lt",
        "$remaining_length_sink.byte_initialized_prefix_len",
        "$remaining_length_sink.byte_read_bytes"
      ]
    },
    {
      "id": "A-GUARD-BYTE-SLOT-REACHES-STORE",
      "invariants": [
        "E-GUARD-BYTE-SLOT-REACHES-STORE"
      ],
      "kind": "transition",
      "from": "remaining_length_guard",
      "at": "remaining_length_store",
      "check": [
        "eq",
        "$remaining_length_guard.byte_addr",
        "$remaining_length_store.byte_addr"
      ]
    },
    {
      "id": "A-STORE-BYTE-SLOT-REACHES-SINK",
      "invariants": [
        "E-STORE-BYTE-SLOT-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "remaining_length_store",
      "at": "remaining_length_sink",
      "check": [
        "eq",
        "$remaining_length_store.byte_addr",
        "$remaining_length_sink.byte_addr"
      ]
    },
    {
      "id": "A-STORE-COPIES-BYTE-WITHOUT-INITIALIZED-PREFIX",
      "invariants": [
        "N-STORE-COPIES-BYTE-WITHOUT-INITIALIZED-PREFIX"
      ],
      "kind": "observed",
      "at": "remaining_length_store",
      "check": [
        "lt",
        "$remaining_length_store.byte_initialized_prefix_len",
        "$remaining_length_store.byte_store_bytes"
      ]
    }
  ]
}
