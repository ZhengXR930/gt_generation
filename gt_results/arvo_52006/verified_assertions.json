{
  "sample_id": "arvo_52006",
  "content_hash": "sha256:736a9bed7c207090590ebd222c20a27b7cc0eec48a9aa2a7079559ba2bb287d6",
  "assertions": [
    {
      "id": "A-ROOT-ADDRESS-BODY-DISCARD-KEEPS-COUNTERS-SYNC",
      "invariants": [
        "I-ROOT-ADDRESSES-LEN-SYNC-AFTER-BODY-DISCARD"
      ],
      "kind": "required",
      "at": "address_body_discard_accounting",
      "check": [
        "eq",
        "$address_body_discard_accounting.addresses_len_after_body_discard",
        "$address_body_discard_accounting.length_after_body_discard"
      ],
      "protects": "second_protocol_length_guard"
    },
    {
      "id": "A-ROOT-COUNTER-REACHES-SECOND-GUARD",
      "invariants": [
        "I-ROOT-COUNTER-REACHES-SECOND-GUARD"
      ],
      "kind": "transition",
      "from": "address_body_discard_accounting",
      "at": "second_protocol_length_guard",
      "check": [
        "eq",
        "$address_body_discard_accounting.addresses_len_after_body_discard",
        "$second_protocol_length_guard.addresses_len_before_header_reads"
      ]
    },
    {
      "id": "A-SECOND-GUARD-COUNTER-EXCEEDS-LENGTH",
      "invariants": [
        "I-SECOND-GUARD-STALE-COUNTER-EXCEEDS-REAL-LENGTH"
      ],
      "kind": "observed",
      "at": "second_protocol_length_guard",
      "check": [
        "gt",
        "$second_protocol_length_guard.addresses_len_before_guard",
        "$second_protocol_length_guard.length_before_guard"
      ]
    },
    {
      "id": "A-SECOND-GUARD-LENGTH-FLOWS-INTO-DISCARD",
      "invariants": [
        "I-SECOND-GUARD-ADMITTED-LENGTH-REACHES-SECOND-DISCARD"
      ],
      "kind": "transition",
      "from": "second_protocol_length_guard",
      "at": "second_protocol_len_discard",
      "check": [
        "eq",
        "$second_protocol_length_guard.address_len_for_discard",
        "$second_protocol_len_discard.discard_len"
      ]
    },
    {
      "id": "A-SECOND-DISCARD-OVERRUNS-FRAME",
      "invariants": [
        "I-SECOND-PROTOCOL-DISCARD-ADVANCES-PAST-FRAME-END"
      ],
      "kind": "observed",
      "at": "second_protocol_len_discard",
      "check": [
        "gt",
        "$second_protocol_len_discard.pos_after_discard",
        "$second_protocol_len_discard.frame_end"
      ]
    },
    {
      "id": "A-OVERRUN-POS-REACHES-SINK",
      "invariants": [
        "I-SECOND-DISCARD-OVERRUN-POS-REACHES-SINK",
        "I-SINK-READ-USES-OVERRUN-POS"
      ],
      "kind": "transition",
      "from": "second_protocol_len_discard",
      "at": "second_address_length_read",
      "check": [
        "eq",
        "$second_protocol_len_discard.pos_after_discard",
        "$second_address_length_read.read_ptr"
      ]
    }
  ]
}
