{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42507999",
  "content_hash": "sha256:24ef9c30f5ad98da48a30d341139b66470ada7dbd0176124285ab17f97849967",
  "assertions": [
    {
      "id": "A-ROOT-DIST-WRITE-INDEX-WITHIN-DEST-CAPACITY",
      "invariants": [
        "R-DIST-WRITE-INDEX-WITHIN-DEST-CAPACITY"
      ],
      "kind": "required",
      "at": "dist_write_guard",
      "check": [
        "lt",
        "$dist_write_guard.write_index",
        "$dist_write_guard.destination_capacity"
      ],
      "protects": "dist_write_sink"
    },
    {
      "id": "A-SINK-DIST-WRITE-INDEX-AT-OR-PAST-CAPACITY",
      "invariants": [
        "N-DIST-WRITE-INDEX-AT-OR-PAST-CAPACITY"
      ],
      "kind": "observed",
      "at": "dist_write_sink",
      "check": [
        "ge",
        "$dist_write_sink.write_index",
        "$dist_write_sink.destination_capacity"
      ]
    },
    {
      "id": "A-DIST-WRITE-INDEX-FLOWS-TO-SINK",
      "invariants": [
        "E-DIST-WRITE-INDEX-FLOWS-TO-SINK"
      ],
      "kind": "transition",
      "from": "dist_write_guard",
      "at": "dist_write_sink",
      "check": [
        "eq",
        "$dist_write_guard.write_index",
        "$dist_write_sink.write_index"
      ]
    }
  ]
}
