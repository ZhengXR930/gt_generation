{
  "sample_id": "secbench_oss_libxml2.ossfuzz-42487785",
  "content_hash": "sha256:7741f0e439f5f31d5241e98156663b724f237e7fd861b090b1065b629d135f2e",
  "assertions": [
    {
      "id": "A_ROOT_LIFETIME",
      "kind": "required",
      "at": "root",
      "protects": "sink",
      "mechanism": "lifetime",
      "description": "The cached text node must not have been freed before xmlStaticCopyNode reads from it.",
      "invariants": [
        "N_ROOT"
      ],
      "check": [
        "eq",
        "$root.free_before_use",
        "$root.safe_literal"
      ]
    },
    {
      "id": "A_SOURCE_TO_SINK_NODE",
      "kind": "transition",
      "from": "source",
      "at": "sink",
      "description": "The node passed into xmlStaticCopyNode is the cached node materialized by xmlXIncludeLoadTxt.",
      "invariants": [
        "E_SOURCE_TO_SINK"
      ],
      "check": [
        "eq",
        "$source.node",
        "$sink.node"
      ]
    },
    {
      "id": "A_ROOT_TO_SINK_ORDER",
      "kind": "transition",
      "from": "root",
      "at": "sink",
      "description": "The lifetime ordering flag computed at reader cleanup is the same condition protecting the later sink use.",
      "invariants": [
        "E_ROOT_TO_SINK"
      ],
      "check": [
        "eq",
        "$root.free_before_use",
        "$sink.free_before_use"
      ]
    },
    {
      "id": "A_SINK_NON_NULL",
      "kind": "observed",
      "at": "sink",
      "description": "The vulnerable execution reaches xmlStaticCopyNode with a non-NULL node pointer.",
      "invariants": [
        "N_SINK"
      ],
      "check": [
        "ne",
        "$sink.node",
        "$sink.node_not_null"
      ]
    }
  ]
}
