  "assertions": [
    {
      "id": "A-ROOT-TERMINATOR-PROBE-REQUIRES-THREE-BYTES",
      "invariants": [
        "I-ROOT-TERMINATOR-PROBE-REQUIRES-THREE-BYTES"
      ],
      "kind": "required",
      "at": "terminator_probe_bound",
      "check": [
        "ge",
        "$terminator_probe_bound.remaining_bytes",
        "$terminator_probe_bound.compare_len"
      ],
      "protects": "terminator_probe_sink"
    },
    {
      "id": "A-SINK-TERMINATOR-PROBE-EXCEEDS-REMAINING-BYTES",
      "invariants": [
        "I-SINK-TERMINATOR-PROBE-EXCEEDS-REMAINING-BYTES"
      ],
      "kind": "observed",
      "at": "terminator_probe_sink",
      "check": [
        "gt",
        "$terminator_probe_sink.compare_len",
        "$terminator_probe_sink.remaining_bytes"
      ]
    },
    {
      "id": "A-LEXER-END-BOUND-REACHES-TERMINATOR-PROBE",
      "invariants": [
        "I-LEXER-END-BOUND-REACHES-TERMINATOR-PROBE"
      ],
      "kind": "transition",
      "from": "lexer_span_init",
      "at": "terminator_probe_bound",
      "check": [
        "eq",
        "$lexer_span_init.lexer_end_ptr",
        "$terminator_probe_bound.lexer_end_ptr"
      ]
    },
    {
      "id": "A-ADVANCED-POS-REACHES-TERMINATOR-PROBE",
      "invariants": [
        "I-ADVANCED-POS-REACHES-TERMINATOR-PROBE"
      ],
      "kind": "transition",
      "from": "tail_opening_advanced",
      "at": "terminator_probe_bound",
      "check": [
        "eq",
        "$tail_opening_advanced.probe_pos",
        "$terminator_probe_bound.probe_pos"
      ]
    }
  ]
}
