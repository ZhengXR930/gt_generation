{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42487241",
  "content_hash": "sha256:587c4bd207f0b6297169c48e5c3b5449de12bf9095162f9d9d01791e2db23c6c",
  "assertions": [
    {
      "id": "A-ROOT-INT32-PAYLOAD-WIDTH-WITHIN-REMAINING-BYTES",
      "invariants": [
        "R-INT32-PAYLOAD-WIDTH-WITHIN-REMAINING-BYTES"
      ],
      "kind": "required",
      "at": "typed_int_bound",
      "check": [
        "le",
        "$typed_int_bound.required_bytes",
        "$typed_int_bound.remaining_bytes"
      ],
      "protects": "int32_decode_sink"
    },
    {
      "id": "A-ROOT-GUARD-CHECKS-SHIFT-EXPONENT",
      "invariants": [
        "N-ROOT-GUARD-CHECKS-SHIFT-EXPONENT"
      ],
      "kind": "observed",
      "at": "typed_int_bound",
      "check": [
        "eq",
        "$typed_int_bound.checked_bytes",
        "$typed_int_bound.remaining_bytes"
      ]
    },
    {
      "id": "A-SINK-READ-END-EXCEEDS-LOGICAL-END",
      "invariants": [
        "N-SINK-READ-END-EXCEEDS-LOGICAL-END"
      ],
      "kind": "observed",
      "at": "int32_decode_sink",
      "check": [
        "gt",
        "$int32_decode_sink.read_end_ptr",
        "$int32_decode_sink.logical_end_ptr"
      ]
    },
    {
      "id": "A-ROOT-REQUIRED-WIDTH-REACHES-SINK-READ-WIDTH",
      "invariants": [
        "E-ROOT-REQUIRED-WIDTH-REACHES-SINK-READ-WIDTH"
      ],
      "kind": "transition",
      "from": "typed_int_bound",
      "at": "int32_decode_sink",
      "check": [
        "eq",
        "$typed_int_bound.required_bytes",
        "$int32_decode_sink.read_width"
      ]
    },
    {
      "id": "A-ROOT-TYPED-INT-POINTER-REACHES-SINK-READ",
      "invariants": [
        "E-ROOT-TYPED-INT-POINTER-REACHES-SINK-READ"
      ],
      "kind": "transition",
      "from": "typed_int_bound",
      "at": "int32_decode_sink",
      "check": [
        "eq",
        "$typed_int_bound.typed_int_ptr",
        "$int32_decode_sink.read_ptr"
      ]
    }
  ]
}
