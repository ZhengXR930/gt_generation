      "verified": true,
      "verified_by": "A-SINK-READ-END-EXCEEDS-LOGICAL-END",
      "fine_trace_step": 13,
      "description": "Exact ASan crash site. The inlined little-endian helper performs the 4-byte load after `bcf_dec_typed_int1_safe()` has already admitted a truncated INT32 payload."
