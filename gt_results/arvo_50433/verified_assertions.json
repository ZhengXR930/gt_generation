{
  "sample_id": "arvo_50433",
  "content_hash": "sha256:db95c1f1557f91761cb98c2ec79fc2d2d90e3cc261bd43d8ed024130a7794ed6",
  "assertions": [
    {
      "id": "a_small_buffer_must_set_memcpyed",
      "invariants": [
        "r_small_buffer_must_set_memcpyed"
      ],
      "kind": "required",
      "at": "small_buffer_memcpy_guard",
      "check": [
        "eq",
        "$small_buffer_memcpy_guard.memcpyed_flag",
        1
      ],
      "protects": "small_buffer_memcpy_guard"
    },
    {
      "id": "a_chunk_allocation_is_smaller_than_header_layout",
      "invariants": [
        "e_chunk_allocation_is_smaller_than_header_layout",
        "n_chunk_allocation_extent",
        "n_header_layout_exceeds_chunk_extent"
      ],
      "kind": "transition",
      "from": "chunk_alloc",
      "at": "header_bstarts_layout",
      "check": [
        "gt",
        "$header_bstarts_layout.output_bytes",
        "$chunk_alloc.chunk_bytes"
      ]
    },
    {
      "id": "a_unmet_memcpy_flag_reaches_header_layout",
      "invariants": [
        "e_unmet_memcpy_flag_reaches_header_layout"
      ],
      "kind": "transition",
      "from": "small_buffer_memcpy_guard",
      "at": "header_bstarts_layout",
      "check": [
        "eq",
        "$small_buffer_memcpy_guard.memcpyed_flag",
        "$header_bstarts_layout.memcpyed_flag"
      ]
    },
    {
      "id": "a_header_bstarts_pointer_reaches_sw32_sink",
      "invariants": [
        "e_header_bstarts_pointer_reaches_sw32_sink",
        "n_sw32_bstarts_write_sink"
      ],
      "kind": "transition",
      "from": "header_bstarts_layout",
      "at": "sw32_sink",
      "check": [
        "eq",
        "$header_bstarts_layout.bstarts_ptr",
        "$sw32_sink.dest_ptr"
      ]
    }
  ]
}
