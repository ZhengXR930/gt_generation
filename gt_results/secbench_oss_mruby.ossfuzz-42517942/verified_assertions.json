  "assertions": [
    {
      "id": "a_root_parsed_count_within_int_range",
      "invariants": [
        "r_parsed_count_must_not_exceed_int_max_before_narrow"
      ],
      "kind": "required",
      "at": "root_guard",
      "check": [
        "le",
        "$root_guard.parsed_n",
        "$root_guard.int_max"
      ],
      "protects": "count_narrow"
    },
    {
      "id": "a_count_narrow_wraps_to_negative",
      "invariants": [
        "n_count_narrow_wraps_to_negative"
      ],
      "kind": "observed",
      "at": "count_narrow",
      "check": [
        "lt",
        "$count_narrow.narrowed_count",
        "$count_narrow.zero_literal"
      ]
    },
    {
      "id": "a_unpacked_count_reaches_embed_write_address",
      "invariants": [
        "n_embed_sink_writes_before_embed_base"
      ],
      "kind": "observed",
      "at": "str_init_embed_sink",
      "check": [
        "lt",
        "$str_init_embed_sink.write_ptr",
        "$str_init_embed_sink.embed_base_ptr"
      ]
    },
    {
      "id": "a_parsed_n_flows_to_narrowing_site",
      "invariants": [
        "e_parsed_n_flows_to_narrowing_site"
      ],
      "kind": "transition",
      "from": "root_guard",
      "at": "count_narrow",
      "check": [
        "eq",
        "$root_guard.parsed_n",
        "$count_narrow.parsed_n_before_narrow"
      ]
    },
    {
      "id": "a_narrowed_count_flows_to_unpack_hex",
      "invariants": [
        "e_narrowed_count_flows_to_unpack_hex"
      ],
      "kind": "transition",
      "from": "count_narrow",
      "at": "unpack_hex_call",
      "check": [
        "eq",
        "$count_narrow.narrowed_count",
        "$unpack_hex_call.requested_count"
      ]
    },
    {
      "id": "a_unpack_hex_count_reaches_embed_len",
      "invariants": [
        "e_unpacked_count_reaches_embed_len"
      ],
      "kind": "transition",
      "from": "unpack_hex_call",
      "at": "str_init_embed_sink",
      "check": [
        "eq",
        "$unpack_hex_call.requested_count",
        "$str_init_embed_sink.len_argument"
      ]
    }
  ]
