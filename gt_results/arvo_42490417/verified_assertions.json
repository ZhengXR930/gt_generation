{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42490417",
  "content_hash": "sha256:a26fbca2c0a1041cbe785b50e274e8dbea9764a1691b6c38aff467128a78edc3",
  "assertions": [
    {
      "id": "A-LAZYCHUNK-BASE-BEFORE-FRAME-DATA",
      "invariants": [
        "I-LAZYCHUNK-BASE-PRECEDES-FRAME-DATA"
      ],
      "kind": "observed",
      "at": "lazychunk_base",
      "check": [
        "lt",
        "$lazychunk_base.chunk_ptr",
        "$lazychunk_base.frame_data_ptr"
      ]
    },
    {
      "id": "A-COFFSET-ERROR-TO-LAZYCHUNK-OFFSET",
      "invariants": [
        "I-COFFSET-ERROR-RETURNS-NEGATIVE-SENTINEL",
        "I-COFFSET-ERROR-RETURN-REACHES-LAZYCHUNK-OFFSET"
      ],
      "kind": "transition",
      "from": "coffset_error_return",
      "at": "lazychunk_base",
      "check": [
        "eq",
        "$coffset_error_return.offset_return",
        "$lazychunk_base.offset_used"
      ]
    },
    {
      "id": "A-LAZYCHUNK-BASE-TO-VERSION-SINK",
      "invariants": [
        "I-LAZYCHUNK-BASE-REACHES-VERSION-SINK",
        "I-SINK-VERSION-READ-USES-LAZYCHUNK-BASE"
      ],
      "kind": "transition",
      "from": "lazychunk_base",
      "at": "version_read_sink",
      "check": [
        "eq",
        "$lazychunk_base.chunk_ptr",
        "$version_read_sink.src_ptr"
      ]
    }
  ]
}
