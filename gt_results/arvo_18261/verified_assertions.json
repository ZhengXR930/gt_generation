      "at": "zero_label_break",
      "check": [
        "eq",
        "$label_call_entry.name_ptr",
        "$zero_label_break.name_ptr"
      ]
    },
    {
      "id": "A-CACHE-COMMIT-NEXT-NAME-PTR-REACHES-CALL-ENTRY",
      "invariants": [
        "I-CACHE-COMMIT-NEXT-NAME-PTR-REACHES-CALL-ENTRY",
        "N_EVENT_label_cache_commit"
      ],
      "kind": "transition",
      "from": "label_cache_commit",
