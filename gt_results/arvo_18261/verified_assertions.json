      ],
      "protects": "label_terminator_sink"
    },
    {
      "id": "A-SINK-TERMINATOR-WRITE-AT-PACKET-END",
      "invariants": [
        "I-SINK-TERMINATOR-WRITE-AT-PACKET-END"
      ],
      "kind": "observed",
      "at": "label_terminator_sink",
      "check": [
        "ge",
        "$label_terminator_sink.name_ptr",
        "$label_terminator_sink.packet_end"
      ]
    },
    {
      "id": "A-ZERO-LABEL-BREAK-TO-TERMINATOR-SINK",
      "invariants": [
