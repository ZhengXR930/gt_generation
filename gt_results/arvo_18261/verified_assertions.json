      "check": [
        "eq",
        "$zero_label_break.name_ptr",
        "$label_terminator_sink.name_ptr"
      ]
    },
    {
      "id": "A-CALL-ENTRY-NAME-PTR-SURVIVES-ZERO-LABEL-BREAK",
      "invariants": [
