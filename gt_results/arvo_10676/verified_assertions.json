{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_10676",
  "content_hash": "sha256:caa819a0092890b2f587404f9ac1b5d2a91c6c15c3a9b7e634d67514df175e27",
  "assertions": [
    {
      "id": "a_session_cleanup_queued_without_live_subscriptions",
      "invariants": [
        "r_session_cleanup_queued_without_live_subscriptions"
      ],
      "kind": "required",
      "at": "queue_session_cleanup",
      "check": [
        "eq",
        "$queue_session_cleanup.subscription_head_ptr",
        null
      ],
      "protects": "queue_session_cleanup"
    },
    {
      "id": "a_live_subscription_reaches_delayed_free_enqueue",
      "invariants": [
        "e_live_subscription_reaches_delayed_free_enqueue"
      ],
      "kind": "transition",
      "from": "queue_session_cleanup",
      "at": "enqueue_subscription_delayed_free",
      "check": [
        "eq",
        "$queue_session_cleanup.subscription_head_ptr",
        "$enqueue_subscription_delayed_free.sub_ptr"
      ]
    },
    {
      "id": "a_delayed_free_becomes_queue_head",
      "invariants": [
        "n_subscription_delayed_free_becomes_queue_head"
      ],
      "kind": "observed",
      "at": "enqueue_subscription_delayed_free",
      "check": [
        "eq",
        "$enqueue_subscription_delayed_free.subscription_delayed_free_ptr",
        "$enqueue_subscription_delayed_free.delayed_queue_head_after_enqueue_ptr"
      ]
    },
    {
      "id": "a_inserted_subscription_head_reaches_stale_session_free",
      "invariants": [
        "e_inserted_subscription_head_reaches_stale_session_free"
      ],
      "kind": "transition",
      "from": "enqueue_subscription_delayed_free",
      "at": "free_stale_linked_session_callback",
      "check": [
        "eq",
        "$enqueue_subscription_delayed_free.delayed_queue_head_after_enqueue_ptr",
        "$free_stale_linked_session_callback.head_before_remove_ptr"
      ]
    },
    {
      "id": "a_freed_session_callback_stays_linked",
      "invariants": [
        "n_freed_session_callback_stays_linked"
      ],
      "kind": "observed",
      "at": "free_stale_linked_session_callback",
      "check": [
        "eq",
        "$free_stale_linked_session_callback.dc_ptr",
        "$free_stale_linked_session_callback.head_after_remove_ptr"
      ]
    },
    {
      "id": "a_freed_session_callback_reaches_second_cleanup_read",
      "invariants": [
        "e_freed_session_callback_reaches_second_cleanup_read",
        "n_reread_freed_session_callback"
      ],
      "kind": "transition",
      "from": "free_stale_linked_session_callback",
      "at": "reread_freed_session_callback",
      "check": [
        "eq",
        "$free_stale_linked_session_callback.dc_ptr",
        "$reread_freed_session_callback.dc_ptr"
      ]
    }
  ]
}
