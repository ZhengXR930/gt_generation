  "assertions": [
    {
      "id": "a_root_border_router_lengths_match",
      "invariants": [
        "r_border_router_lengths_match_before_memcmp"
      ],
      "kind": "required",
      "at": "border_router_guard",
      "check": [
        "eq",
        "$border_router_guard.stored_border_router_length",
        "$border_router_guard.current_border_router_length"
      ],
      "protects": "border_router_memcmp"
    },
    {
      "id": "a_sink_memcmp_reads_past_current_border_router",
      "invariants": [
        "n_memcmp_reads_past_current_border_router_tlv"
      ],
      "kind": "observed",
      "at": "border_router_memcmp",
      "check": [
        "gt",
        "$border_router_memcmp.compare_length",
        "$border_router_memcmp.current_border_router_length"
      ]
    },
    {
      "id": "a_current_network_data_reaches_second_isstableupdated_base",
      "invariants": [
        "e_current_network_data_reaches_second_isstableupdated_base"
      ],
      "kind": "transition",
      "from": "current_network_data_forward",
      "at": "border_router_operands_selected",
      "check": [
        "eq",
        "$current_network_data_forward.current_tlvs_ptr",
        "$border_router_operands_selected.aTlvsBase_ptr"
      ]
    },
    {
      "id": "a_current_border_router_base_reaches_memcmp",
      "invariants": [
        "e_current_border_router_base_reaches_memcmp"
      ],
      "kind": "transition",
      "from": "border_router_operands_selected",
      "at": "border_router_memcmp",
      "check": [
        "eq",
        "$border_router_operands_selected.current_border_router_ptr",
        "$border_router_memcmp.current_border_router_ptr"
      ]
    },
    {
      "id": "a_stored_border_router_reaches_memcmp",
      "invariants": [
        "e_stored_border_router_reaches_memcmp"
      ],
      "kind": "transition",
      "from": "border_router_operands_selected",
      "at": "border_router_memcmp",
      "check": [
        "eq",
        "$border_router_operands_selected.stored_border_router_ptr",
        "$border_router_memcmp.stored_border_router_ptr"
      ]
    }
  ]
