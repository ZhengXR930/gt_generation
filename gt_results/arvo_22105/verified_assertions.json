{
  "sample_id": "arvo_22105",
  "content_hash": "sha256:1dbde0adf153e09badf4af8059b797b28ed0cbdb3a891667b4e350368abc21db",
  "assertions": [
    {
      "id": "a_open_linktype_must_not_exceed_defined_enum_max",
      "invariants": [
        "r_open_linktype_must_not_exceed_defined_enum_max"
      ],
      "kind": "required",
      "at": "open_linktype_guard",
      "check": [
        "le",
        "$open_linktype_guard.link_type_value",
        "$open_linktype_guard.max_defined_link_type"
      ],
      "protects": "extension_len_sink"
    },
    {
      "id": "a_open_linktype_reaches_raw_packet_tag_call",
      "invariants": [
        "e_open_linktype_reaches_raw_packet_tag_call",
        "N_EVENT_raw_packet_tag_call"
      ],
      "kind": "transition",
      "from": "open_linktype_guard",
      "at": "raw_packet_tag_call",
      "check": [
        "eq",
        "$open_linktype_guard.link_type_value",
        "$raw_packet_tag_call.link_type_value"
      ]
    },
    {
      "id": "a_raw_packet_tag_value_reaches_packet_dispatch",
      "invariants": [
        "e_raw_packet_tag_value_reaches_packet_dispatch",
        "N_EVENT_packet_dispatch_entry"
      ],
      "kind": "transition",
      "from": "raw_packet_tag_call",
      "at": "packet_dispatch_entry",
      "check": [
        "eq",
        "$raw_packet_tag_call.link_type_value",
        "$packet_dispatch_entry.link_type_value"
      ]
    },
    {
      "id": "a_dispatch_value_reaches_unknown_linktype_fallback",
      "invariants": [
        "e_dispatch_value_reaches_unknown_linktype_fallback",
        "N_EVENT_unknown_linktype_fallback"
      ],
      "kind": "transition",
      "from": "packet_dispatch_entry",
      "at": "unknown_linktype_fallback",
      "check": [
        "eq",
        "$packet_dispatch_entry.link_type_value",
        "$unknown_linktype_fallback.link_type_value"
      ]
    },
    {
      "id": "a_unknown_eth_view_reaches_ipv6_dispatch",
      "invariants": [
        "e_unknown_eth_view_reaches_ipv6_dispatch",
        "N_EVENT_ipv6_payload_dispatch"
      ],
      "kind": "transition",
      "from": "unknown_linktype_fallback",
      "at": "ipv6_payload_dispatch",
      "check": [
        "eq",
        "$unknown_linktype_fallback.raw_data_base",
        "$ipv6_payload_dispatch.eth_layer_data"
      ]
    },
    {
      "id": "a_ipv6_payload_reaches_data_end_extension",
      "invariants": [
        "e_ipv6_payload_reaches_data_end_extension"
      ],
      "kind": "transition",
      "from": "ipv6_payload_dispatch",
      "at": "extension_at_data_end",
      "check": [
        "eq",
        "$ipv6_payload_dispatch.payload_ptr",
        "$extension_at_data_end.ipv6_buffer_base"
      ]
    },
    {
      "id": "a_extension_constructed_at_ipv6_data_end",
      "invariants": [
        "n_extension_constructed_at_ipv6_data_end"
      ],
      "kind": "observed",
      "at": "extension_at_data_end",
      "check": [
        "eq",
        "$extension_at_data_end.constructed_offset",
        "$extension_at_data_end.data_len"
      ]
    },
    {
      "id": "a_data_end_extension_reaches_headerlen_sink",
      "invariants": [
        "e_data_end_extension_reaches_headerlen_sink",
        "n_headerlen_read_on_data_end_extension"
      ],
      "kind": "transition",
      "from": "extension_at_data_end",
      "at": "extension_len_sink",
      "check": [
        "eq",
        "$extension_at_data_end.new_ext_ptr",
        "$extension_len_sink.extension_this"
      ]
    }
  ]
}
