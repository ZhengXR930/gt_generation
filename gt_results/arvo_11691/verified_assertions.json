{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_11691",
  "content_hash": "sha256:cdc59b614cb6b043818d580d35a4b26069b8222b015a6a13d97bb05187016eeb",
  "assertions": [
    {
      "id": "A-ROOT-BLEND-REQUIRES-ENOUGH-OPERANDS",
      "invariants": [
        "I-ROOT-BLEND-STACK-SATISFIES-OPERAND-FOOTPRINT"
      ],
      "kind": "required",
      "at": "blend_guard",
      "check": [
        "ge",
        "$blend_guard.stack_count_after_pop",
        "$blend_guard.required_operands"
      ],
      "protects": "blend_sink"
    },
    {
      "id": "A-BLEND-DELTA-INDEX-OUT-OF-RANGE",
      "invariants": [
        "I-BLEND-DELTA-INDEX-OUT-OF-RANGE"
      ],
      "kind": "observed",
      "at": "blend_delta_arg",
      "check": [
        "ge",
        "$blend_delta_arg.delta_index",
        "$blend_delta_arg.stack_count_at_use"
      ]
    },
    {
      "id": "A-UNDERFLOWED-START-REACHES-BLEND-DELTA",
      "invariants": [
        "E-UNDERFLOWED-START-REACHES-BLEND-DELTA"
      ],
      "kind": "transition",
      "from": "blend_guard",
      "at": "blend_delta_arg",
      "check": [
        "eq",
        "$blend_guard.start_index",
        "$blend_delta_arg.start_index"
      ]
    },
    {
      "id": "A-BLENDS-ARGUMENT-REACHES-SINK",
      "invariants": [
        "E-BLENDS-ARGUMENT-REACHES-SINK"
      ],
      "kind": "transition",
      "from": "blend_delta_arg",
      "at": "blend_sink",
      "check": [
        "eq",
        "$blend_delta_arg.blends_argument",
        "$blend_sink.blends_argument"
      ]
    },
    {
      "id": "A-SINK-BLENDS-ARGUMENT-ALIASES-CRAPPOOL",
      "invariants": [
        "I-SINK-BLENDS-ARGUMENT-ALIASES-CRAPPOOL"
      ],
      "kind": "observed",
      "at": "blend_sink",
      "check": [
        "eq",
        "$blend_sink.blends_argument",
        "$blend_sink.crap_pool_ptr"
      ]
    }
  ]
}
