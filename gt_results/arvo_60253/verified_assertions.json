{
  "sample_id": "arvo_60253",
  "content_hash": "sha256:39729b80e47bbbcb806c64c335468ee4fd26a40659989f23aeaeb35b9f83f3bf",
  "assertions": [
    {
      "id": "a_ac_nbits_within_max_coef_bits",
      "invariants": [
        "r_ac_nbits_must_not_exceed_max_coef_bits"
      ],
      "kind": "required",
      "at": "ac_nbits_decision",
      "check": [
        "le",
        "$ac_nbits_decision.nbits",
        "$ac_nbits_decision.max_coef_bits"
      ],
      "protects": "ac_huffman_lookup"
    },
    {
      "id": "a_unchecked_nbits_reaches_ac_symbol_index",
      "invariants": [
        "e_unchecked_nbits_reaches_ac_symbol_index"
      ],
      "kind": "transition",
      "from": "ac_nbits_decision",
      "at": "ac_symbol_index",
      "check": [
        "eq",
        "$ac_nbits_decision.nbits",
        "$ac_symbol_index.nbits_component"
      ]
    },
    {
      "id": "a_ac_symbol_index_hits_ehufsi_limit",
      "invariants": [
        "n_ac_symbol_index_hits_ehufsi_limit"
      ],
      "kind": "observed",
      "at": "ac_symbol_index",
      "check": [
        "eq",
        "$ac_symbol_index.symbol_index",
        "$ac_symbol_index.ehufsi_entries"
      ]
    },
    {
      "id": "a_overflowed_symbol_index_reaches_huffman_lookup",
      "invariants": [
        "e_overflowed_symbol_index_reaches_huffman_lookup",
        "n_huffman_lookup_uses_overflowed_symbol_index"
      ],
      "kind": "transition",
      "from": "ac_symbol_index",
      "at": "ac_huffman_lookup",
      "check": [
        "eq",
        "$ac_symbol_index.symbol_index",
        "$ac_huffman_lookup.lookup_index"
      ]
    }
  ]
}
