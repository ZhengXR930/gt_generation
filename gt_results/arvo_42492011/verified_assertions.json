  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42492011",
  "content_hash": "sha256:5169c16d1e4827aadbad093f4aa78c471aff07d2f5205e55e926abf3a4e48747",
  "assertions": [
    {
      "id": "A-ROOT-XPACK-NVAL-FITS-RMAP-CAPACITY",
      "invariants": [
        "R-XPACK-NVAL-FITS-RMAP-CAPACITY"
      ],
      "kind": "required",
      "at": "xpack_nval_guard",
      "check": [
        "le",
        "$xpack_nval_guard.nval",
        "$xpack_nval_guard.rmap_capacity"
      ],
      "protects": "xpack_rmap_write"
    },
    {
      "id": "A-SINK-XPACK-RMAP-WRITE-INDEX-OUT-OF-BOUNDS",
      "invariants": [
        "N-XPACK-RMAP-WRITE-INDEX-OUT-OF-BOUNDS"
      ],
      "kind": "observed",
      "at": "xpack_rmap_write",
      "check": [
        "ge",
        "$xpack_rmap_write.write_index",
        "$xpack_rmap_write.rmap_capacity"
      ]
    },
    {
      "id": "A-XPACK-NVAL-REACHES-RMAP-WRITE-BOUND",
      "invariants": [
        "E-XPACK-NVAL-REACHES-RMAP-WRITE-BOUND"
      ],
      "kind": "transition",
      "from": "xpack_nval_guard",
      "at": "xpack_rmap_write",
      "check": [
        "eq",
        "$xpack_nval_guard.nval",
        "$xpack_rmap_write.loop_bound"
      ]
    }
  ]
}
