{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_18464",
  "content_hash": "sha256:820164557b2f860afb3b21e726ab9fdf9f71c2b30dd4d8051b2329d5db8d36ef",
  "assertions": [
    {
      "id": "A-ROOT-PARSER-LEN-RESERVES-EOF-SLACK",
      "invariants": [
        "I-ROOT-PARSER-LEN-RESERVES-EOF-SLACK"
      ],
      "kind": "required",
      "at": "fuzz_open",
      "check": [
        "lt",
        "$fuzz_open.parser_len",
        "$fuzz_open.input_len"
      ],
      "protects": "next_eof"
    },
    {
      "id": "A-SINK-BACKUP-READS-AT-LEXER-END",
      "invariants": [
        "I-SINK-BACKUP-READS-AT-LEXER-END"
      ],
      "kind": "observed",
      "at": "backup_deref",
      "check": [
        "eq",
        "$backup_deref.read_offset",
        "$backup_deref.end_offset"
      ]
    },
    {
      "id": "A-PARSER-LEN-SETS-LEXER-END",
      "invariants": [
        "I-PARSER-LEN-SETS-LEXER-END"
      ],
      "kind": "transition",
      "from": "fuzz_open",
      "at": "next_eof",
      "check": [
        "eq",
        "$fuzz_open.parser_len",
        "$next_eof.end_offset"
      ]
    },
    {
      "id": "A-EOF-POS-CARRIES-INTO-BACKUP",
      "invariants": [
        "I-EOF-POS-CARRIES-INTO-BACKUP"
      ],
      "kind": "transition",
      "from": "next_eof",
      "at": "backup_deref",
      "check": [
        "eq",
        "$next_eof.pos_after_next_offset",
        "$backup_deref.pos_before_offset"
      ]
    },
    {
      "id": "A-NEXT-ADVANCES-PAST-LEXER-END",
      "invariants": [
        "I-NEXT-ADVANCES-PAST-LEXER-END"
      ],
      "kind": "observed",
      "at": "next_eof",
      "check": [
        "gt",
        "$next_eof.pos_after_next_offset",
        "$next_eof.end_offset"
      ]
    }
  ]
}
