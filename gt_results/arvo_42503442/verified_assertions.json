{
  "schema_version": "verified-assertions-v3",
  "sample_id": "arvo_42503442",
  "content_hash": "sha256:9d2c731dda19245ec27dc799cd5e2536d62c30897c88a4b50b64779fb5213f70",
  "assertions": [
    {
      "id": "a_month_value_must_be_at_most_12",
      "invariants": [
        "r_month_must_not_exceed_12_before_tm_conversion"
      ],
      "kind": "required",
      "at": "month_parse_guard",
      "check": [
        "le",
        "$month_parse_guard.accepted_month",
        12
      ],
      "protects": "month_yday_sink"
    },
    {
      "id": "a_month_yday_index_exceeds_table_length",
      "invariants": [
        "n_month_yday_index_out_of_bounds"
      ],
      "kind": "observed",
      "at": "month_yday_sink",
      "check": [
        "ge",
        "$month_yday_sink.tm_mon_index",
        "$month_yday_sink.month_slot_count"
      ]
    },
    {
      "id": "a_admitted_month_minus_one_reaches_zero_based_month",
      "invariants": [
        "e_admitted_month_minus_one_reaches_zero_based_month",
        "n_zero_based_month_after_decrement"
      ],
      "kind": "transition",
      "from": "month_parse_guard",
      "at": "month_to_index",
      "check": [
        "eq",
        "$month_parse_guard.accepted_month_minus_one",
        "$month_to_index.zero_based_month"
      ]
    },
    {
      "id": "a_zero_based_month_reaches_tm_call",
      "invariants": [
        "e_zero_based_month_reaches_tm_call",
        "n_tm_call_receives_zero_based_month"
      ],
      "kind": "transition",
      "from": "month_to_index",
      "at": "tm_call",
      "check": [
        "eq",
        "$month_to_index.zero_based_month",
        "$tm_call.tm_mon_argument"
      ]
    },
    {
      "id": "a_tm_call_argument_reaches_month_yday_index",
      "invariants": [
        "e_tm_call_argument_reaches_month_yday_index",
        "n_sink_uses_tm_mon_index"
      ],
      "kind": "transition",
      "from": "tm_call",
      "at": "month_yday_sink",
      "check": [
        "eq",
        "$tm_call.tm_mon_argument",
        "$month_yday_sink.tm_mon_index"
      ]
    }
  ]
}
