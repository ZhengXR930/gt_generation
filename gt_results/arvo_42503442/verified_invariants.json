  "root_cause_criterion": {
    "invariant_id": "r_month_must_not_exceed_12_before_tm_conversion",
    "type": "missing_guard",
    "verified": true,
    "verified_by": "a_month_value_must_be_at_most_12",
    "file": "src/lib/util/misc.c",
    "function": "fr_unix_time_from_str",
    "line": 620,
    "fine_trace_step": 5,
    "variable": "s_tm.tm_mon",
    "missing_conjunct": "After the RFC3339 month field is parsed into `s_tm.tm_mon`, the admitted month must satisfy `s_tm.tm_mon <= 12` before the parser continues.",
    "criterion": "At the `get_part(&p, &s_tm.tm_mon, 1, ..., '-', \"month\")` site, a correct parser rejects any admitted month above 12 before `s_tm.tm_mon--` derives the zero-based `struct tm` month that later reaches `month_yday[tm->tm_mon]`.",
    "description": "The vulnerable original uses `max == 13`, so the singular invalid month `13` is admitted and later decremented to `tm_mon == 12`; the fixed image tightens the bound to 12 at this site."
  },
  "nodes": [
    {
      "invariant_id": "n_zero_based_month_after_decrement",
      "verified": true,
      "verified_by": "a_admitted_month_minus_one_reaches_zero_based_month",
      "role": "corrupted_state",
      "file": "src/lib/util/misc.c",
      "function": "fr_unix_time_from_str",
      "line": 621,
      "fine_trace_step": 6,
      "variable": "s_tm.tm_mon",
      "state": "Immediately after `s_tm.tm_mon--`, the zero-based `struct tm` month equals the admitted month minus one; on the witness this yields `s_tm.tm_mon == 12`."
    },
    {
