      "variable": "tm->tm_mon",
      "state": "The call to `fr_unix_time_from_tm(tm)` forwards the already-normalized zero-based month in `tm->tm_mon` without revalidating it."
    },
    {
      "invariant_id": "n_sink_uses_tm_mon_index",
