{
  "sample_id": "arvo_14620",
  "content_hash": "sha256:41d47a3740bc3e44d65f1c3787c7145f43401d1ef1f524422198fee1a9d9ff6f",
  "assertions": [
    {
      "id": "A_root",
      "invariants": [
        "inv_bounds_check_after_increment"
      ],
      "kind": "required",
      "at": "evt_key_match_increment",
      "check": [
        "lt",
        "$evt_key_match_increment.index_after_incr",
        "$evt_key_match_increment.tokenCount"
      ],
      "protects": "evt_sink_variant_decode"
    },
    {
      "id": "A_sink",
      "invariants": [
        "inv_oob_read_at_sink"
      ],
      "kind": "observed",
      "at": "evt_sink_variant_decode",
      "check": [
        "ge",
        "$evt_sink_variant_decode.searchResultType",
        "$evt_sink_variant_decode.tokenCount"
      ]
    },
    {
      "id": "A_E1_size_to_objectCount",
      "invariants": [
        "inv_token_size_propagates_to_objectCount",
        "N_EVENT_evt_objectCount"
      ],
      "kind": "transition",
      "from": "evt_tokenize",
      "at": "evt_objectCount",
      "check": [
        "eq",
        "$evt_tokenize.token0_size",
        "$evt_objectCount.objectCount"
      ]
    },
    {
      "id": "A_E2_objectCount_to_match",
      "invariants": [
        "inv_objectCount_controls_iteration_reaching_match"
      ],
      "kind": "transition",
      "from": "evt_objectCount",
      "at": "evt_key_match_increment",
      "check": [
        "gt",
        "$evt_objectCount.objectCount",
        "$evt_key_match_increment.loop_index"
      ]
    },
    {
      "id": "A_E3_index_to_searchResult",
      "invariants": [
        "inv_incremented_index_becomes_searchResultType"
      ],
      "kind": "transition",
      "from": "evt_key_match_increment",
      "at": "evt_sink_variant_decode",
      "check": [
        "eq",
        "$evt_key_match_increment.index_after_incr",
        "$evt_sink_variant_decode.searchResultType"
      ]
    }
  ]
}
